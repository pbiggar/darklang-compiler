// __HttpsService.dark - RFC 9460 HTTPS RDATA validation and explicitly advertised HTTP/3 endpoints.
module Darklang.Stdlib.__HttpsService

type Service = { priority: Int64, host: String, port: Int64, ipv4: List<List<Int64>>, ipv6: List<List<Int64>> }
type Record = Alias of String | Service of Stdlib.__HttpsService.Service
type Parameters = {
  seen: List<Int64>, mandatory: List<Int64>, h3: Bool, port: Int64,
  ipv4: List<List<Int64>>, ipv6: List<List<Int64>>
}

// TargetName is never compressed, including when it is the root name.
let __target (data: Blob) (position: Int64) (parts: List<String>) (length: Int64)
  : Stdlib.Result.Result<(String * Int64), String> =
  if position >= Stdlib.Blob.__byteLength data || length > 253L then Error "Invalid HTTPS target name"
  else
    let size = Stdlib.Blob.__getByte data position in
    if size == 0L then Ok ((Stdlib.String.join (Stdlib.List.reverse parts) ".", position + 1L))
    else if size > 63L || size > Stdlib.Blob.__byteLength data - position - 1L then Error "Invalid HTTPS target name"
    else
      match Stdlib.Blob.toString (Stdlib.__Http2Wire.__slice data (position + 1L) size) with
      | Error _ -> Error "Invalid HTTPS target name"
      | Ok label ->
        if Stdlib.Bool.not (Stdlib.__DnsWire.__validLabel label 0L size) then Error "Invalid HTTPS target name"
        else Stdlib.__HttpsService.__target data (position + 1L + size) (Stdlib.List.push parts (Stdlib.String.toLowercase label)) (length + size + (if parts == [] then 0L else 1L))

let __alpn (data: Blob) (position: Int64) (h3: Bool) : Stdlib.Result.Result<Bool, String> =
  if position == Stdlib.Blob.__byteLength data then Ok h3
  else
    let size = Stdlib.Blob.__getByte data position in
    if size == 0L || size > Stdlib.Blob.__byteLength data - position - 1L then Error "Invalid HTTPS ALPN list"
    else
      let selected = if size != 2L then false else
        Stdlib.Blob.__getByte data (position + 1L) == 104L && Stdlib.Blob.__getByte data (position + 2L) == 51L in
      Stdlib.__HttpsService.__alpn data (position + 1L + size) (h3 || selected)

let __mandatory (data: Blob) (position: Int64) (previous: Int64) (keys: List<Int64>)
  : Stdlib.Result.Result<List<Int64>, String> =
  if position == Stdlib.Blob.__byteLength data then Ok (Stdlib.List.reverse keys)
  else
    let key = Stdlib.__DnsWire.__u16 data position in
    if key <= previous then Error "Invalid HTTPS mandatory keys"
    else Stdlib.__HttpsService.__mandatory data (position + 2L) key (Stdlib.List.push keys key)

let __addresses (data: Blob) (position: Int64) (width: Int64) (addresses: List<List<Int64>>)
  : List<List<Int64>> =
  if position == Stdlib.Blob.__byteLength data then Stdlib.List.reverse addresses
  else Stdlib.__HttpsService.__addresses data (position + width) width (Stdlib.List.push addresses (Stdlib.Blob.__toInt64List (Stdlib.__Http2Wire.__slice data position width)))

let __parameter (state: Stdlib.__HttpsService.Parameters) (key: Int64) (data: Blob)
  : Stdlib.Result.Result<Stdlib.__HttpsService.Parameters, String> =
  let size = Stdlib.Blob.__byteLength data in
  if key == 0L then
    if size == 0L || size % 2L != 0L || size > 128L then Error "Invalid HTTPS mandatory keys"
    else Stdlib.__HttpsService.__mandatory data 0L 0L [] |> Stdlib.Result.map (fun keys -> { state with mandatory = keys })
  else if key == 1L then
    if size == 0L then Error "Invalid HTTPS ALPN list"
    else Stdlib.__HttpsService.__alpn data 0L false |> Stdlib.Result.map (fun h3 -> { state with h3 = h3 })
  else if key == 2L then
    if size != 0L then Error "Invalid HTTPS no-default-alpn value" else Ok state
  else if key == 3L then
    if size != 2L then Error "Invalid HTTPS port value" else Ok { state with port = Stdlib.__DnsWire.__u16 data 0L }
  else if key == 4L || key == 6L then
    let width = if key == 4L then 4L else 16L in
    if size == 0L || size % width != 0L || size / width > 16L then Error "Invalid HTTPS address hints"
    else
      let addresses = Stdlib.__HttpsService.__addresses data 0L width [] in
      if key == 4L then Ok { state with ipv4 = addresses } else Ok { state with ipv6 = addresses }
  else Ok state

let __parameters (data: Blob) (position: Int64) (previous: Int64) (state: Stdlib.__HttpsService.Parameters)
  : Stdlib.Result.Result<Stdlib.__HttpsService.Parameters, String> =
  if position == Stdlib.Blob.__byteLength data then Ok state
  else if Stdlib.List.length state.seen >= 64 then Error "Too many HTTPS service parameters"
  else if Stdlib.Blob.__byteLength data - position < 4L then Error "Truncated HTTPS service parameter"
  else
    let key = Stdlib.__DnsWire.__u16 data position in
    let size = Stdlib.__DnsWire.__u16 data (position + 2L) in
    if key <= previous then Error "Unordered HTTPS service parameters"
    else if size > Stdlib.Blob.__byteLength data - position - 4L then Error "Truncated HTTPS service parameter"
    else
      let next = { state with seen = Stdlib.List.push state.seen key } in
      Stdlib.__HttpsService.__parameter next key (Stdlib.__Http2Wire.__slice data (position + 4L) size)
        |> Stdlib.Result.andThen (fun parameters -> Stdlib.__HttpsService.__parameters data (position + 4L + size) key parameters)

// Malformed RDATA rejects the RRset; unknown mandatory keys only make this RR incompatible.
// An absent ALPN or one advertising h2/http1 alone never triggers a QUIC probe.
let parse (owner: String) (port: Int64) (data: Blob)
  : Stdlib.Result.Result<Stdlib.Option.Option<Stdlib.__HttpsService.Record>, String> =
  if port < 1L || port > 65535L || owner == "" then Error "Invalid HTTPS service origin"
  else if Stdlib.Blob.__byteLength data < 3L || Stdlib.Blob.__byteLength data > 4096L then Error "Invalid HTTPS service record size"
  else
    let priority = Stdlib.__DnsWire.__u16 data 0L in
    Stdlib.__HttpsService.__target data 2L [] 0L |> Stdlib.Result.andThen (fun target ->
      let (host, position) = target in
      if priority == 0L then
        if host == "" then Ok None else Ok (Some (Alias host))
      else
        let initial = Stdlib.__HttpsService.Parameters { seen = [], mandatory = [], h3 = false,
          port = port, ipv4 = [], ipv6 = [] } in
        Stdlib.__HttpsService.__parameters data position -1L initial |> Stdlib.Result.andThen (fun parameters ->
          if Stdlib.List.any parameters.mandatory (fun key -> Stdlib.Bool.not (Stdlib.List.member parameters.seen key)) then
            Error "Missing mandatory HTTPS service parameter"
          else if Stdlib.List.member parameters.seen 2L && Stdlib.Bool.not (Stdlib.List.member parameters.seen 1L) then
            Error "HTTPS no-default-alpn without ALPN"
          else if parameters.h3 == false || parameters.port == 0L ||
            Stdlib.List.any parameters.mandatory (fun key -> key != 1L && key != 2L && key != 3L && key != 4L && key != 6L) then Ok None
          else Ok (Some (Service (Stdlib.__HttpsService.Service { priority = priority,
            host = if host == "" then owner else host, port = parameters.port,
            ipv4 = parameters.ipv4, ipv6 = parameters.ipv6 })))))
