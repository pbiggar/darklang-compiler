// __Http3Wire.dark - RFC 9114 frame and SETTINGS codecs; no transport side effects.
module Darklang.Stdlib.__Http3Wire

type Frame = { kind: Int64, payload: Blob, remaining: Blob }

let __forbidden (kind: Int64) : Bool = kind == 2L || kind == 6L || kind == 8L || kind == 9L

let serialize (kind: Int64) (payload: Blob) : Stdlib.Result.Result<Blob, String> =
  if Stdlib.__Http3Wire.__forbidden kind then Error "Forbidden HTTP/3 frame type"
  else
    match Stdlib.__QuicWire.integer kind, Stdlib.__QuicWire.integer (Stdlib.Blob.__byteLength payload) with
    | Ok encodedKind, Ok encodedSize -> Ok (Stdlib.Blob.concat [encodedKind, encodedSize, payload])
    | _, _ -> Error "HTTP/3 frame integer out of range"

let parse (maximum: Int64) (data: Blob) : Stdlib.Result.Result<Stdlib.__Http3Wire.Frame, Stdlib.__QuicWire.ParseError> =
  if maximum < 0L || maximum > 104857600L then Error (Invalid "Invalid HTTP/3 frame limit")
  else
    match Stdlib.__QuicWire.parseInteger data 0L with
    | Error error -> Error error
    | Ok kind ->
      if Stdlib.__Http3Wire.__forbidden kind.value then Error (Invalid "Forbidden HTTP/3 frame type")
      else
        match Stdlib.__QuicWire.parseInteger data kind.next with
        | Error error -> Error error
        | Ok size ->
          if size.value > maximum then Error (Invalid "HTTP/3 frame exceeds limit")
          else if size.value > Stdlib.Blob.__byteLength data - size.next then Error Incomplete
          else Ok (Stdlib.__Http3Wire.Frame { kind = kind.value,
            payload = Stdlib.__Http2Wire.__slice data size.next size.value,
            remaining = Stdlib.__Http2Wire.__slice data (size.next + size.value) (Stdlib.Blob.__byteLength data - size.next - size.value) })

let __settings (data: Blob) (position: Int64) (seen: List<Int64>) (settings: List<(Int64 * Int64)>)
  : Stdlib.Result.Result<List<(Int64 * Int64)>, String> =
  if position == Stdlib.Blob.__byteLength data then Ok (Stdlib.List.reverse settings)
  else if Stdlib.List.length seen >= 64 then Error "Too many HTTP/3 settings"
  else
    match Stdlib.__QuicWire.parseInteger data position with
    | Error _ -> Error "Truncated HTTP/3 setting"
    | Ok id ->
      if Stdlib.List.any seen (fun previous -> previous == id.value) then Error "Duplicate HTTP/3 setting"
      else if id.value >= 2L && id.value <= 5L then Error "Forbidden HTTP/3 setting"
      else
        match Stdlib.__QuicWire.parseInteger data id.next with
        | Error _ -> Error "Truncated HTTP/3 setting"
        | Ok value ->
          if (id.value == 7L && value.value > 65535L) || (id.value == 8L && value.value > 1L) then Error "Invalid HTTP/3 setting value"
          else Stdlib.__Http3Wire.__settings data value.next (Stdlib.List.push seen id.value) (Stdlib.List.push settings (id.value, value.value))

let parseSettings (payload: Blob) : Stdlib.Result.Result<List<(Int64 * Int64)>, String> =
  if Stdlib.Blob.__byteLength payload > 4096L then Error "HTTP/3 settings too large"
  else Stdlib.__Http3Wire.__settings payload 0L [] []

// No dynamic-table references or blocked header streams in the initial profile.
let settings () : Blob = Stdlib.Blob.__fromInt64List [1L, 0L, 7L, 0L, 6L, 128L, 1L, 0L, 0L]

let settingsWithQpack (capacity: Int64) (blocked: Int64) : Stdlib.Result.Result<Blob, String> =
  if capacity < 0L || capacity > 65536L || blocked < 0L || blocked > 256L then Error "Invalid local QPACK settings"
  else
    Stdlib.List.fold [(1L, capacity), (7L, blocked), (6L, 65536L)] (Ok []) (fun result setting ->
      let (id, value) = setting in
      result |> Stdlib.Result.andThen (fun blocks ->
        Stdlib.__QuicWire.integer id |> Stdlib.Result.andThen (fun name ->
          Stdlib.__QuicWire.integer value |> Stdlib.Result.map (fun bytes -> Stdlib.List.push blocks (Stdlib.Blob.concat [name, bytes])))))
      |> Stdlib.Result.map (fun blocks -> Stdlib.Blob.concat (Stdlib.List.reverse blocks))
