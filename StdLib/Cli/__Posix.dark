// __Posix.dark - Native POSIX primitive bridge; policy is implemented in Dark.
module Darklang.Stdlib.Cli.__Posix

let __openAt (a0: Int64) (a1: RawPtr) (a2: Int64) (a3: Int64) : Int64 = -38L
let __read (a0: Int64) (a1: RawPtr) (a2: Int64) : Int64 = -38L
let __write (a0: Int64) (a1: RawPtr) (a2: Int64) : Int64 = -38L
let __close (a0: Int64) : Int64 = -38L
let __ioctl (fd: Int64) (request: Int64) (buffer: RawPtr) : Int64 = -38L
let __seek (a0: Int64) (a1: Int64) (a2: Int64) : Int64 = -38L
let __statAt (a0: Int64) (a1: RawPtr) (a2: RawPtr) (a3: Int64) : Int64 = -38L
let __getCwd (a0: RawPtr) (a1: Int64) : Int64 = -38L
let __chdir (a0: Int64) : Int64 = -38L
let __mkdirAt (a0: Int64) (a1: RawPtr) (a2: Int64) : Int64 = -38L
let __unlinkAt (a0: Int64) (a1: RawPtr) (a2: Int64) : Int64 = -38L
let __renameAt (a0: Int64) (a1: RawPtr) (a2: Int64) (a3: RawPtr) : Int64 = -38L
let __chmodAt (a0: Int64) (a1: RawPtr) (a2: Int64) (a3: Int64) : Int64 = -38L
let __chmodAt2 (a0: Int64) (a1: RawPtr) (a2: Int64) (a3: Int64) : Int64 = -38L
let __utimesAt (a0: Int64) (a1: RawPtr) (a2: RawPtr) (a3: Int64) : Int64 = -38L
let __setAttributesAt (a0: Int64) (a1: RawPtr) (a2: RawPtr) (a3: RawPtr) (a4: Int64) (a5: Int64) : Int64 = -38L
let __symlinkAt (a0: RawPtr) (a1: Int64) (a2: RawPtr) : Int64 = -38L
let __readlinkAt (a0: Int64) (a1: RawPtr) (a2: RawPtr) (a3: Int64) : Int64 = -38L
let __flock (a0: Int64) (a1: Int64) : Int64 = -38L
let __getDents (a0: Int64) (a1: RawPtr) (a2: Int64) (a3: RawPtr) : Int64 = -38L

let __mac () : Bool = Stdlib.Cli.__hostOSCode () == 2L
let __x64 () : Bool = Stdlib.Cli.__hostArchitectureCode () == 1L
let __cwdFd () : Int64 = if Stdlib.Cli.__Posix.__mac () then -2L else -100L
let __nofollow () : Int64 = if Stdlib.Cli.__Posix.__mac () then 256L else if Stdlib.Cli.__Posix.__x64 () then 131072L else 32768L
let __directory () : Int64 = if Stdlib.Cli.__Posix.__mac () then 1048576L else if Stdlib.Cli.__Posix.__x64 () then 65536L else 16384L
let __nofollowAt () : Int64 = if Stdlib.Cli.__Posix.__mac () then 32L else 256L

let __copyString (text: String) (ptr: RawPtr) (offset: Int64) : Unit =
    if offset == Stdlib.String.__byteLength text then __raw_write_byte ptr offset 0L
    else
        let _ = __raw_write_byte ptr offset (Stdlib.String.__byteAtUnchecked text offset) in
        Stdlib.Cli.__Posix.__copyString text ptr (offset + 1L)

let __withCString (text: String) (fn: RawPtr -> 'a) : 'a =
    let ptr = __mapped_alloc (Stdlib.String.__byteLength text + 1L) in
    let _ = Stdlib.Cli.__Posix.__copyString text ptr 0L in
    let result = fn ptr in
    let _ = __mapped_free ptr in
    result

let __bufferBytes (ptr: RawPtr) (offset: Int64) (end_: Int64) (bytes: List<Int64>) : Blob =
    if offset >= end_ then Stdlib.Blob.__fromInt64List (Stdlib.List.reverse bytes)
    else Stdlib.Cli.__Posix.__bufferBytes ptr (offset + 1L) end_ (Stdlib.List.push bytes (__raw_get_byte ptr offset))

let __bufferString (ptr: RawPtr) (start: Int64) (end_: Int64) : String =
    Stdlib.String.fromBlobWithReplacement (Stdlib.Cli.__Posix.__bufferBytes ptr start end_ [])

let __nullEnd (ptr: RawPtr) (offset: Int64) (limit: Int64) : Int64 =
    if offset >= limit then limit
    else if __raw_get_byte ptr offset == 0L then offset
    else Stdlib.Cli.__Posix.__nullEnd ptr (offset + 1L) limit

let __unsigned (ptr: RawPtr) (offset: Int64) (width: Int64) : Int64 =
    if width == 0L then 0L
    else __raw_get_byte ptr offset + 256L * Stdlib.Cli.__Posix.__unsigned ptr (offset + 1L) (width - 1L)

let __macError (errno: Int64) : String =
    if errno == 1L then "Operation not permitted"
    else if errno == 2L then "No such file or directory"
    else if errno == 3L then "No such process"
    else if errno == 4L then "Interrupted system call"
    else if errno == 5L then "Input/output error"
    else if errno == 6L then "Device not configured"
    else if errno == 7L then "Argument list too long"
    else if errno == 8L then "Exec format error"
    else if errno == 9L then "Bad file descriptor"
    else if errno == 10L then "No child processes"
    else if errno == 11L then "Resource deadlock avoided"
    else if errno == 12L then "Cannot allocate memory"
    else if errno == 13L then "Permission denied"
    else if errno == 14L then "Bad address"
    else if errno == 15L then "Block device required"
    else if errno == 16L then "Device / Resource busy"
    else if errno == 17L then "File exists"
    else if errno == 18L then "Cross-device link"
    else if errno == 19L then "Operation not supported by device"
    else if errno == 20L then "Not a directory"
    else if errno == 21L then "Is a directory"
    else if errno == 22L then "Invalid argument"
    else if errno == 23L then "Too many open files in system"
    else if errno == 24L then "Too many open files"
    else if errno == 25L then "Inappropriate ioctl for device"
    else if errno == 26L then "Text file busy"
    else if errno == 27L then "File too large"
    else if errno == 28L then "No space left on device"
    else if errno == 29L then "Illegal seek"
    else if errno == 30L then "Read-only file system"
    else if errno == 31L then "Too many links"
    else if errno == 32L then "Broken pipe"
    else if errno == 33L then "Numerical argument out of domain"
    else if errno == 34L then "Result too large"
    else if errno == 35L then "Resource temporarily unavailable"
    else if errno == 36L then "Operation now in progress"
    else if errno == 37L then "Operation already in progress"
    else if errno == 38L then "Socket operation on non-socket"
    else if errno == 39L then "Destination address required"
    else if errno == 40L then "Message too long"
    else if errno == 41L then "Protocol wrong type for socket"
    else if errno == 42L then "Protocol not available"
    else if errno == 43L then "Protocol not supported"
    else if errno == 44L then "Socket type not supported"
    else if errno == 45L then "Operation not supported"
    else if errno == 46L then "Protocol family not supported"
    else if errno == 47L then "Address family not supported by protocol family"
    else if errno == 48L then "Address already in use"
    else if errno == 49L then "Can't assign requested address"
    else if errno == 50L then "Network is down"
    else if errno == 51L then "Network is unreachable"
    else if errno == 52L then "Network dropped connection on reset"
    else if errno == 53L then "Software caused connection abort"
    else if errno == 54L then "Connection reset by peer"
    else if errno == 55L then "No buffer space available"
    else if errno == 56L then "Socket is already connected"
    else if errno == 57L then "Socket is not connected"
    else if errno == 58L then "Can't send after socket shutdown"
    else if errno == 59L then "Too many references: can't splice"
    else if errno == 60L then "Operation timed out"
    else if errno == 61L then "Connection refused"
    else if errno == 62L then "Too many levels of symbolic links"
    else if errno == 63L then "File name too long"
    else if errno == 64L then "Host is down"
    else if errno == 65L then "No route to host"
    else if errno == 66L then "Directory not empty"
    else if errno == 67L then "Too many processes"
    else if errno == 68L then "Too many users"
    else if errno == 69L then "Disc quota exceeded"
    else if errno == 70L then "Stale NFS file handle"
    else if errno == 71L then "Too many levels of remote in path"
    else if errno == 72L then "RPC struct is bad"
    else if errno == 73L then "RPC version wrong"
    else if errno == 74L then "RPC prog. not avail"
    else if errno == 75L then "Program version wrong"
    else if errno == 76L then "Bad procedure for program"
    else if errno == 77L then "No locks available"
    else if errno == 78L then "Function not implemented"
    else if errno == 79L then "Inappropriate file type or format"
    else if errno == 80L then "Authentication error"
    else if errno == 81L then "Need authenticator"
    else if errno == 82L then "Device power is off"
    else if errno == 83L then "Device error, e.g. paper out"
    else if errno == 84L then "Value too large to be stored in data type"
    else if errno == 85L then "Bad executable"
    else if errno == 86L then "Bad CPU type in executable"
    else if errno == 87L then "Shared library version mismatch"
    else if errno == 88L then "Malformed Macho file"
    else if errno == 89L then "Operation canceled"
    else if errno == 90L then "Identifier removed"
    else if errno == 91L then "No message of desired type"
    else if errno == 92L then "Illegal byte sequence"
    else if errno == 93L then "Attribute not found"
    else if errno == 94L then "Bad message"
    else if errno == 95L then "Reserved"
    else if errno == 96L then "No message available on STREAM"
    else if errno == 97L then "Reserved"
    else if errno == 98L then "No STREAM resources"
    else if errno == 99L then "Not a STREAM"
    else if errno == 100L then "Protocol error"
    else if errno == 101L then "STREAM ioctl timeout"
    else if errno == 102L then "Operation not supported on socket"
    else if errno == 103L then "No such policy registered"
    else if errno == 104L then "State not recoverable"
    else if errno == 105L then "Previous owner died"
    else if errno == 106L then "Interface output queue is full"
    else if errno == 107L then "Capabilities insufficient"
    else if errno == 107L then "Must be equal largest errno"
    else "Unknown error: " ++ Stdlib.Int64.toString errno

let __error (errno: Int64) : Stdlib.Cli.Posix.Error =
    let message =
        if Stdlib.Cli.__Posix.__mac () then Stdlib.Cli.__Posix.__macError errno
        else if errno == 1L then "Operation not permitted"
        else if errno == 2L then "No such file or directory"
        else if errno == 3L then "No such process"
        else if errno == 4L then "Interrupted system call"
        else if errno == 5L then "Input/output error"
        else if errno == 6L then "No such device or address"
        else if errno == 7L then "Argument list too long"
        else if errno == 8L then "Exec format error"
        else if errno == 9L then "Bad file descriptor"
        else if errno == 10L then "No child processes"
        else if errno == 11L then "Resource temporarily unavailable"
        else if errno == 12L then "Cannot allocate memory"
        else if errno == 13L then "Permission denied"
        else if errno == 14L then "Bad address"
        else if errno == 15L then "Block device required"
        else if errno == 16L then "Device or resource busy"
        else if errno == 17L then "File exists"
        else if errno == 18L then "Invalid cross-device link"
        else if errno == 19L then "No such device"
        else if errno == 20L then "Not a directory"
        else if errno == 21L then "Is a directory"
        else if errno == 22L then "Invalid argument"
        else if errno == 23L then "Too many open files in system"
        else if errno == 24L then "Too many open files"
        else if errno == 25L then "Inappropriate ioctl for device"
        else if errno == 26L then "Text file busy"
        else if errno == 27L then "File too large"
        else if errno == 28L then "No space left on device"
        else if errno == 29L then "Illegal seek"
        else if errno == 30L then "Read-only file system"
        else if errno == 31L then "Too many links"
        else if errno == 32L then "Broken pipe"
        else if errno == 33L then "Numerical argument out of domain"
        else if errno == 34L then "Numerical result out of range"
        else if errno == 35L then "Resource deadlock avoided"
        else if errno == 36L then "File name too long"
        else if errno == 37L then "No locks available"
        else if errno == 38L then "Function not implemented"
        else if errno == 39L then "Directory not empty"
        else if errno == 40L then "Too many levels of symbolic links"
        else if errno == 42L then "No message of desired type"
        else if errno == 43L then "Identifier removed"
        else if errno == 44L then "Channel number out of range"
        else if errno == 45L then "Level 2 not synchronized"
        else if errno == 46L then "Level 3 halted"
        else if errno == 47L then "Level 3 reset"
        else if errno == 48L then "Link number out of range"
        else if errno == 49L then "Protocol driver not attached"
        else if errno == 50L then "No CSI structure available"
        else if errno == 51L then "Level 2 halted"
        else if errno == 52L then "Invalid exchange"
        else if errno == 53L then "Invalid request descriptor"
        else if errno == 54L then "Exchange full"
        else if errno == 55L then "No anode"
        else if errno == 56L then "Invalid request code"
        else if errno == 57L then "Invalid slot"
        else if errno == 59L then "Bad font file format"
        else if errno == 60L then "Device not a stream"
        else if errno == 61L then "No data available"
        else if errno == 62L then "Timer expired"
        else if errno == 63L then "Out of streams resources"
        else if errno == 64L then "Machine is not on the network"
        else if errno == 65L then "Package not installed"
        else if errno == 66L then "Object is remote"
        else if errno == 67L then "Link has been severed"
        else if errno == 68L then "Advertise error"
        else if errno == 69L then "Srmount error"
        else if errno == 70L then "Communication error on send"
        else if errno == 71L then "Protocol error"
        else if errno == 72L then "Multihop attempted"
        else if errno == 73L then "RFS specific error"
        else if errno == 74L then "Bad message"
        else if errno == 75L then "Value too large for defined data type"
        else if errno == 76L then "Name not unique on network"
        else if errno == 77L then "File descriptor in bad state"
        else if errno == 78L then "Remote address changed"
        else if errno == 79L then "Can not access a needed shared library"
        else if errno == 80L then "Accessing a corrupted shared library"
        else if errno == 81L then ".lib section in a.out corrupted"
        else if errno == 82L then "Attempting to link in too many shared libraries"
        else if errno == 83L then "Cannot exec a shared library directly"
        else if errno == 84L then "Invalid or incomplete multibyte or wide character"
        else if errno == 85L then "Interrupted system call should be restarted"
        else if errno == 86L then "Streams pipe error"
        else if errno == 87L then "Too many users"
        else if errno == 88L then "Socket operation on non-socket"
        else if errno == 89L then "Destination address required"
        else if errno == 90L then "Message too long"
        else if errno == 91L then "Protocol wrong type for socket"
        else if errno == 92L then "Protocol not available"
        else if errno == 93L then "Protocol not supported"
        else if errno == 94L then "Socket type not supported"
        else if errno == 95L then "Operation not supported"
        else if errno == 96L then "Protocol family not supported"
        else if errno == 97L then "Address family not supported by protocol"
        else if errno == 98L then "Address already in use"
        else if errno == 99L then "Cannot assign requested address"
        else if errno == 100L then "Network is down"
        else if errno == 101L then "Network is unreachable"
        else if errno == 102L then "Network dropped connection on reset"
        else if errno == 103L then "Software caused connection abort"
        else if errno == 104L then "Connection reset by peer"
        else if errno == 105L then "No buffer space available"
        else if errno == 106L then "Transport endpoint is already connected"
        else if errno == 107L then "Transport endpoint is not connected"
        else if errno == 108L then "Cannot send after transport endpoint shutdown"
        else if errno == 109L then "Too many references: cannot splice"
        else if errno == 110L then "Connection timed out"
        else if errno == 111L then "Connection refused"
        else if errno == 112L then "Host is down"
        else if errno == 113L then "No route to host"
        else if errno == 114L then "Operation already in progress"
        else if errno == 115L then "Operation now in progress"
        else if errno == 116L then "Stale file handle"
        else if errno == 117L then "Structure needs cleaning"
        else if errno == 118L then "Not a XENIX named type file"
        else if errno == 119L then "No XENIX semaphores available"
        else if errno == 120L then "Is a named type file"
        else if errno == 121L then "Remote I/O error"
        else if errno == 122L then "Disk quota exceeded"
        else if errno == 123L then "No medium found"
        else if errno == 124L then "Wrong medium type"
        else if errno == 125L then "Operation canceled"
        else if errno == 126L then "Required key not available"
        else if errno == 127L then "Key has expired"
        else if errno == 128L then "Key has been revoked"
        else if errno == 129L then "Key was rejected by service"
        else if errno == 130L then "Owner died"
        else if errno == 131L then "State not recoverable"
        else if errno == 132L then "Operation not possible due to RF-kill"
        else if errno == 133L then "Memory page has hardware error"
        else "Unknown error " ++ Stdlib.Int64.toString errno in
    Stdlib.Cli.Posix.Error { errno = Stdlib.Int.fromInt64 errno, message = message }

let __unitResult (rc: Int64) : Stdlib.Result.Result<Unit, Stdlib.Cli.Posix.Error> =
    if rc < 0L then Error (Stdlib.Cli.__Posix.__error (0L - rc)) else Ok ()

let __intResult (rc: Int64) : Stdlib.Result.Result<Int, Stdlib.Cli.Posix.Error> =
    if rc < 0L then Error (Stdlib.Cli.__Posix.__error (0L - rc)) else Ok (Stdlib.Int.fromInt64 rc)

let __getCurrentDirectory () : Stdlib.Result.Result<String, Stdlib.Cli.Posix.Error> =
    let ptr = __mapped_alloc 4096L in
    let rc = Stdlib.Cli.__Posix.__getCwd ptr 4096L in
    let result =
        if rc < 0L then Error (Stdlib.Cli.__Posix.__error (0L - rc))
        else Ok (Stdlib.Cli.__Posix.__bufferString ptr 0L (Stdlib.Cli.__Posix.__nullEnd ptr 0L 4096L)) in
    let _ = __mapped_free ptr in
    result

let __absolute (path: String) : Stdlib.Result.Result<String, Stdlib.Cli.Posix.Error> =
    if Stdlib.String.contains path "\0" then Error (Stdlib.Cli.__Posix.__error 22L)
    else if Stdlib.String.startsWith path "/" then Ok path
    else
        match Stdlib.Cli.__Posix.__getCurrentDirectory () with
        | Error e -> Error e
        | Ok cwd -> Ok (cwd ++ "/" ++ path)

// The walk owns its descriptor and closes each ancestor before continuing.
let __walkParent (fd: Int64) (parts: List<String>) (fn: Int64 -> String -> Stdlib.Result.Result<'a, Stdlib.Cli.Posix.Error>) : Stdlib.Result.Result<'a, Stdlib.Cli.Posix.Error> =
    match parts with
    | [] ->
        let _ = Stdlib.Cli.__Posix.__close fd in
        Error (Stdlib.Cli.Posix.Error { errno = 22, message = "path has no final component" })
    | name :: rest ->
        if Stdlib.List.length rest == 0 then
            let result = fn fd name in
            let _ = Stdlib.Cli.__Posix.__close fd in
            result
        else
            let next = Stdlib.Cli.__Posix.__withCString name (fun ptr -> Stdlib.Cli.__Posix.__openAt fd ptr (Stdlib.Cli.__Posix.__directory () + Stdlib.Cli.__Posix.__nofollow ()) 0L) in
            let _ = Stdlib.Cli.__Posix.__close fd in
            if next < 0L then Error (Stdlib.Cli.__Posix.__error (0L - next))
            else Stdlib.Cli.__Posix.__walkParent next rest fn

let __withParent (path: String) (fn: Int64 -> String -> Stdlib.Result.Result<'a, Stdlib.Cli.Posix.Error>) : Stdlib.Result.Result<'a, Stdlib.Cli.Posix.Error> =
    if path == "" then Error (Stdlib.Cli.__Posix.__error 2L)
    else
        match Stdlib.Cli.__Posix.__absolute path with
        | Error e -> Error e
        | Ok absolute ->
            let parts = Stdlib.List.filter (Stdlib.String.split absolute "/") (fun s -> s != "") in
            let root = Stdlib.Cli.__Posix.__withCString "/" (fun ptr -> Stdlib.Cli.__Posix.__openAt (Stdlib.Cli.__Posix.__cwdFd ()) ptr (Stdlib.Cli.__Posix.__directory ()) 0L) in
            if root < 0L then Error (Stdlib.Cli.__Posix.__error (0L - root))
            else
                Stdlib.Cli.__Posix.__walkParent root parts fn

let __withEntry (path: String) (fn: Int64 -> RawPtr -> Stdlib.Result.Result<'a, Stdlib.Cli.Posix.Error>) : Stdlib.Result.Result<'a, Stdlib.Cli.Posix.Error> =
    Stdlib.Cli.__Posix.__withParent path (fun fd name -> Stdlib.Cli.__Posix.__withCString name (fun ptr -> fn fd ptr))

let __withDirectory (path: String) (fn: Int64 -> Stdlib.Result.Result<'a, Stdlib.Cli.Posix.Error>) : Stdlib.Result.Result<'a, Stdlib.Cli.Posix.Error> =
    let openDirectory = fun parent name ->
        let fd = Stdlib.Cli.__Posix.__openAt parent name (Stdlib.Cli.__Posix.__directory () + Stdlib.Cli.__Posix.__nofollow ()) 0L in
        if fd < 0L then Error (Stdlib.Cli.__Posix.__error (0L - fd))
        else
            let result = fn fd in
            let _ = Stdlib.Cli.__Posix.__close fd in
            result in
    if path != "" && Stdlib.String.replaceAll path "/" "" == "" then
        Stdlib.Cli.__Posix.__withCString "/" (fun ptr -> openDirectory (Stdlib.Cli.__Posix.__cwdFd ()) ptr)
    else Stdlib.Cli.__Posix.__withEntry path openDirectory

let __withStat (path: String) (fn: RawPtr -> 'a) : Stdlib.Result.Result<'a, Stdlib.Cli.Posix.Error> =
    let statEntry = fun fd name ->
        let ptr = __mapped_alloc 256L in
        let rc = Stdlib.Cli.__Posix.__statAt fd name ptr (Stdlib.Cli.__Posix.__nofollowAt ()) in
        let result = if rc < 0L then Error (Stdlib.Cli.__Posix.__error (0L - rc)) else Ok (fn ptr) in
        let _ = __mapped_free ptr in
        result in
    if path != "" && Stdlib.String.replaceAll path "/" "" == "" then
        Stdlib.Cli.__Posix.__withCString "/" (fun ptr -> statEntry (Stdlib.Cli.__Posix.__cwdFd ()) ptr)
    else Stdlib.Cli.__Posix.__withEntry path statEntry

let __statMode (ptr: RawPtr) : Int64 =
    if Stdlib.Cli.__Posix.__mac () then Stdlib.Cli.__Posix.__unsigned ptr 4L 2L
    else Stdlib.Cli.__Posix.__unsigned ptr (if Stdlib.Cli.__Posix.__x64 () then 24L else 16L) 4L

let __statValues (ptr: RawPtr) : (Int * Int * Int) =
    let size = __raw_get<Int64> ptr (if Stdlib.Cli.__Posix.__mac () then 96L else 48L) in
    let mtime = __raw_get<Int64> ptr (if Stdlib.Cli.__Posix.__mac () then 48L else 88L) in
    (Stdlib.Int.fromInt64 (Stdlib.Cli.__Posix.__statMode ptr), Stdlib.Int.fromInt64 size, Stdlib.Int.fromInt64 mtime)

let __writeBytes (blob: Blob) (ptr: RawPtr) (index: Int64) : Unit =
    if index >= Stdlib.Blob.__byteLength blob then ()
    else
        let _ = __raw_write_byte ptr index (Stdlib.Blob.__getByte blob index) in
        Stdlib.Cli.__Posix.__writeBytes blob ptr (index + 1L)

let __writeFully (fd: Int64) (ptr: RawPtr) (blob: Blob) (offset: Int64) : Stdlib.Result.Result<Int, Stdlib.Cli.Posix.Error> =
    let length = Stdlib.Blob.__byteLength blob in
    if offset == length then Ok (Stdlib.Int.fromInt64 offset)
    else
        // Copy the remaining bytes into the same buffer before each partial write.
        let remaining = Stdlib.Blob.slice blob (Stdlib.Int.fromInt64 offset) (Stdlib.Int.fromInt64 (length - offset)) in
        let _ = Stdlib.Cli.__Posix.__writeBytes remaining ptr 0L in
        let rc = Stdlib.Cli.__Posix.__write fd ptr (length - offset) in
        if rc < 0L then Error (Stdlib.Cli.__Posix.__error (0L - rc))
        else if rc == 0L then Error (Stdlib.Cli.Posix.Error { errno = 0, message = "write returned 0" })
        else Stdlib.Cli.__Posix.__writeFully fd ptr blob (offset + rc)

let __parseEntries (ptr: RawPtr) (offset: Int64) (length: Int64) (entries: List<String>) : List<String> =
    if offset >= length then entries
    else
        let recordLength = Stdlib.Cli.__Posix.__unsigned ptr (offset + 16L) 2L in
        let start = offset + (if Stdlib.Cli.__Posix.__mac () then 21L else 19L) in
        let end_ = Stdlib.Cli.__Posix.__nullEnd ptr start (offset + recordLength) in
        let name = Stdlib.Cli.__Posix.__bufferString ptr start end_ in
        let next = if name == "." || name == ".." then entries else Stdlib.List.push entries name in
        Stdlib.Cli.__Posix.__parseEntries ptr (offset + recordLength) length next

let __listEntries (fd: Int64) (ptr: RawPtr) (position: RawPtr) (entries: List<String>) : Stdlib.Result.Result<List<String>, Stdlib.Cli.Posix.Error> =
    let rc = Stdlib.Cli.__Posix.__getDents fd ptr 32768L position in
    if rc < 0L then Error (Stdlib.Cli.__Posix.__error (0L - rc))
    else if rc == 0L then Ok (Stdlib.List.reverse entries)
    else Stdlib.Cli.__Posix.__listEntries fd ptr position (Stdlib.Cli.__Posix.__parseEntries ptr 0L rc entries)

let __suffix (word: Int64) (remaining: Int64) : String =
    if remaining == 0L then ""
    else
        let alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789" in
        Stdlib.String.__byteSlice alphabet (word % 62L) (word % 62L + 1L) ++ Stdlib.Cli.__Posix.__suffix (word / 62L) (remaining - 1L)

let __createUnique (prefix: String) (remaining: Int64) (directory: Bool) : Stdlib.Result.Result<(Int * String), Stdlib.Cli.Posix.Error> =
    let suffix = Stdlib.Cli.__Posix.__suffix (Stdlib.Int64.bitwiseAnd (Stdlib.Int.__randomInt64Word ()) 9223372036854775807L) 6L in
    let path = prefix ++ suffix in
    let result = Stdlib.Cli.__Posix.__withEntry path (fun parent name ->
        let rc = if directory then Stdlib.Cli.__Posix.__mkdirAt parent name 448L
                 else Stdlib.Cli.__Posix.__openAt parent name ((if Stdlib.Cli.__Posix.__mac () then 2562L else 194L) + Stdlib.Cli.__Posix.__nofollow ()) 384L in
        if rc < 0L then Error (Stdlib.Cli.__Posix.__error (0L - rc))
        else Ok ((Stdlib.Int.fromInt64 rc, path))) in
    match result with
    | Error e -> if e.errno == 17 && remaining > 0L then Stdlib.Cli.__Posix.__createUnique prefix (remaining - 1L) directory else Error e
    | Ok value -> Ok value

let __owner (lines: List<String>) (uid: String) : String =
    match lines with
    | [] -> uid
    | line :: rest ->
        let fields = Stdlib.String.split line ":" in
        match (Stdlib.List.getAt fields 0, Stdlib.List.getAt fields 2) with
        | (Some name, Some ownerUid) -> if ownerUid == uid then name else Stdlib.Cli.__Posix.__owner rest uid
        | _ -> Stdlib.Cli.__Posix.__owner rest uid

let __metadataPath (path: String) (fn: Int64 -> String -> Stdlib.Result.Result<Unit, Stdlib.Cli.Posix.Error>) : Stdlib.Result.Result<Unit, Stdlib.Cli.Posix.Error> =
    Stdlib.Cli.__Posix.__withEntry path (fun parent name ->
        let fd = Stdlib.Cli.__Posix.__openAt parent name (2097152L + Stdlib.Cli.__Posix.__nofollow ()) 0L in
        if fd < 0L then Error (Stdlib.Cli.__Posix.__error (0L - fd))
        else
            let ptr = __mapped_alloc 256L in
            let rc = Stdlib.Cli.__Posix.__withCString "" (fun empty -> Stdlib.Cli.__Posix.__statAt fd empty ptr 4096L) in
            let result =
                if rc < 0L then Error (Stdlib.Cli.__Posix.__error (0L - rc))
                else if Stdlib.Int64.bitwiseAnd (Stdlib.Cli.__Posix.__statMode ptr) 61440L == 40960L then Error (Stdlib.Cli.__Posix.__error 40L)
                else fn fd ("/proc/self/fd/" ++ Stdlib.Int64.toString fd) in
            let _ = __mapped_free ptr in
            let _ = Stdlib.Cli.__Posix.__close fd in
            result)
