module Darklang.Stdlib.Cli.Architecture

type Architecture =
  | X86_64
  | Aarch64
  | Arm
  | Arm64
  | Armv7l

let getArchitecture () : Stdlib.Result.Result<Architecture, String> =
  match Runtime.targetArchitecture () with
  | "x64" -> Ok Architecture.X86_64
  | "arm64" ->
    if Runtime.targetOS () == "darwin" then Ok Architecture.Arm64
    else Ok Architecture.Aarch64
  | "arm" -> Ok Architecture.Arm
  | _ -> Error "Unsupported architecture"
