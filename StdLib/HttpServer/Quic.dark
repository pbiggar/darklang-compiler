// HttpServerQuic.dark - Sequential HTTP/3 UDP listener with Retry, replay suppression and shutdown ownership.
module Darklang.Stdlib.HttpServer.Quic

type Recent = { source: Blob, expires: Int64, closing: Option<Stdlib.__QuicConnection.Closing> }
type Context = { config: Stdlib.HttpServer.Config.Config, identity: Stdlib.TlsServerIdentity.Identity, signals: Stdlib.__Network.ShutdownSignals, socket: Stdlib.__Datagram.Socket, secret: Blob, limit: Int64 }
type Step = { recent: List<Stdlib.HttpServer.Quic.Recent>, stopped: Bool }

let __socket (parent: Stdlib.__Datagram.Socket) : Stdlib.__Datagram.Socket =
  let lifecycle = Stdlib.Stream.__new (fun _unit -> Some ()) (fun _unit -> ()) in
  Stdlib.__Datagram.Socket { lifecycle = lifecycle,
    watch = Stdlib.Option.map parent.watch (fun watch -> { watch with lifecycle = lifecycle }),
    send = fun peer bytes timeout -> match Stdlib.Stream.next lifecycle with | None -> Error 9L | Some () -> Stdlib.__Datagram.send parent peer bytes timeout,
    receive = fun timeout -> match Stdlib.Stream.next lifecycle with | None -> Error 9L | Some () -> Stdlib.__Datagram.receive parent timeout }

let __connection (config: Stdlib.HttpServer.Config.Config) (identity: Stdlib.TlsServerIdentity.Identity) (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (signals: Stdlib.__Network.ShutdownSignals) (socket: Stdlib.__Datagram.Socket) (flight: Stdlib.__QuicServer.Flight) (peer: Stdlib.__Datagram.Endpoint) (limit: Int64) : Stdlib.__QuicConnection.Finished =
  let child = Stdlib.HttpServer.Quic.__socket socket in
  let result = match Stdlib.__Network.monotonicMillis () with
    | Error _ -> Error "HTTP/3 server clock failed"
    | Ok now -> Stdlib.__QuicServer.accept child peer signals flight (now + 10000L) 4096L |> Stdlib.Result.andThen (fun ready ->
        Stdlib.__Http3Server.serve ready signals config (fun request -> Stdlib.HttpServer.__http2Handler config handler request) limit) in
  let finished = match result with
    | Error message -> Stdlib.__QuicConnection.Finished { closing = None, stopped = message == "HTTP server shutting down" }
    | Ok state -> Stdlib.__QuicConnection.finishServer state.connection in
  Stdlib.__Datagram.close child
  finished

let __retry (socket: Stdlib.__Datagram.Socket) (secret: Blob) (peer: Stdlib.__Datagram.Endpoint) (packet: Stdlib.__QuicPacket.Protected) (now: Int64) : Unit =
  if Stdlib.Blob.__byteLength packet.destination < 8L then ()
  else match Stdlib.Crypto.__secureRandomBytes 8L with
  | Error _ -> ()
  | Ok source -> match Stdlib.__QuicServerRetry.create secret peer packet.destination packet.source source now with
    | Error _ -> ()
    | Ok retry -> let _ = Stdlib.__Datagram.send socket peer retry 1000L in ()

let __admit (context: Stdlib.HttpServer.Quic.Context) (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (recent: List<Stdlib.HttpServer.Quic.Recent>) (timeout: Int64) : Stdlib.Result.Result<Stdlib.HttpServer.Quic.Step, String> =
  match Stdlib.__Network.shutdownRequested context.signals with
  | Error _ -> Error "HTTP/3 server shutdown check failed"
  | Ok true -> Ok (Stdlib.HttpServer.Quic.Step { recent = recent, stopped = true })
  | Ok false ->
    match Stdlib.__Datagram.receive context.socket timeout with
    | Error code -> if code == 4L || code == 11L || code == 35L || code == 90L then Ok (Stdlib.HttpServer.Quic.Step { recent = recent, stopped = false }) else Error "HTTP/3 listener receive failed"
    | Ok datagram ->
      match Stdlib.__Network.monotonicMillis () with
      | Error _ -> Error "HTTP/3 server clock failed"
      | Ok now ->
        let recent = Stdlib.List.filter recent (fun entry -> entry.expires > now) in
        let again = fun recent -> Ok (Stdlib.HttpServer.Quic.Step { recent = recent, stopped = false }) in
        match Stdlib.__QuicPacket.parse 8L datagram.payload with
        | Ok (Protected packet) ->
          if Stdlib.List.any recent (fun entry -> Stdlib.__QuicClient.__same entry.source packet.destination && Stdlib.Option.isSome entry.closing) then
            let recent = Stdlib.List.map recent (fun entry ->
              match entry.closing with
              | Some closing ->
                if Stdlib.__QuicClient.__same closing.source packet.destination && closing.peer == datagram.peer then
                  (match Stdlib.__QuicConnection.repeatClose context.socket closing now with
                  | Ok next -> { entry with closing = Some next }
                  | Error _ -> { entry with closing = None })
                else entry
              | None -> entry) in
            again recent
          else if packet.kind != Stdlib.__QuicPacket.Kind.Initial || Stdlib.Blob.__byteLength datagram.payload < 1200L ||
             Stdlib.List.any recent (fun entry -> Stdlib.__QuicClient.__same entry.source packet.destination) then again recent
          else if Stdlib.Blob.__byteLength packet.token == 0L then
            Stdlib.HttpServer.Quic.__retry context.socket context.secret datagram.peer packet now
            again recent
          else if Stdlib.List.length recent >= 256 then again recent
          else
            (match Stdlib.__QuicServerRetry.validate context.secret datagram.peer packet now with
            | Error _ -> again recent
            | Ok _ ->
              // Consume a validated CID before any flight is emitted. Failed
              // handshakes must not reuse Initial key/packet-number pairs either.
              // Never evict a live entry merely to admit another connection.
              let recent = Stdlib.List.push recent (Stdlib.HttpServer.Quic.Recent { source = packet.destination, expires = now + 30000L, closing = None }) in
              match Stdlib.__QuicServer.start context.identity context.secret datagram now with
              | Error _ -> again recent
              | Ok flight ->
                let finished = Stdlib.HttpServer.Quic.__connection context.config context.identity handler context.signals context.socket flight datagram.peer context.limit in
                let recent = Stdlib.List.map recent (fun entry ->
                  if Stdlib.__QuicClient.__same entry.source packet.destination then
                    let expires = match finished.closing with | Some closing -> if closing.deadline > entry.expires then closing.deadline else entry.expires | None -> entry.expires in
                    { entry with expires = expires, closing = finished.closing }
                  else entry) in
                Ok (Stdlib.HttpServer.Quic.Step { recent = recent, stopped = finished.stopped }))
        | _ -> again recent

// Prune closing keys even while idle. Retain consumed CIDs through both the
// Retry-token lifetime and any longer closing interval, without body buffers.
let __step (context: Stdlib.HttpServer.Quic.Context) (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (recent: List<Stdlib.HttpServer.Quic.Recent>) (timeout: Int64) : Stdlib.Result.Result<Stdlib.HttpServer.Quic.Step, String> =
  match Stdlib.__Network.monotonicMillis () with
  | Error _ -> Error "HTTP/3 server clock failed"
  | Ok now ->
    let recent = Stdlib.List.filter recent (fun entry -> entry.expires > now) |> Stdlib.List.map (fun entry ->
      match entry.closing with | Some closing -> if closing.deadline <= now then { entry with closing = None } else entry | None -> entry) in
    Stdlib.HttpServer.Quic.__admit context handler recent timeout


let __loop (context: Stdlib.HttpServer.Quic.Context) (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (recent: List<Stdlib.HttpServer.Quic.Recent>) : Stdlib.Result.Result<Unit, String> =
  match Stdlib.HttpServer.Quic.__step context handler recent 100L with
  | Error message -> Error message
  | Ok step -> if step.stopped then Ok () else Stdlib.HttpServer.Quic.__loop context handler step.recent

/// Serve one HTTPS request per authenticated QUIC v1 connection. Import the
/// certificate chain and private key with TlsServerIdentity.create. Every new
/// connection proves its source address with Retry before a certificate flight.
/// The shared UDP listener returns normally on SIGINT or SIGTERM.
let serveOn (address: List<Int64>) (config: Stdlib.HttpServer.Config.Config) (identity: Stdlib.TlsServerIdentity.Identity) (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (onListening: Unit -> Unit) : Stdlib.Result.Result<Unit, String> =
  match Stdlib.Int.toInt64 config.port, Stdlib.Int.toInt64 config.maxBodyBytes with
  | Some port, Some limit ->
    if port <= 0L || port > 65535L || limit < 0L || limit > 104857600L then Error "Invalid HTTP/3 server configuration"
    else match Stdlib.__Network.shutdownSignals () with
    | Error _ -> Error "HTTP/3 shutdown setup failed"
    | Ok signals ->
      let result = match Stdlib.Crypto.__secureRandomBytes 32L with
        | Error _ -> Error "HTTP/3 Retry key generation failed"
        | Ok secret -> match (if Stdlib.List.length address == 16 then Stdlib.__Datagram.bind6 address port else Stdlib.__Datagram.bind4 address port) with
          | Error _ -> Error "Cannot bind HTTP/3 server"
          | Ok socket ->
            onListening ()
            let context = Stdlib.HttpServer.Quic.Context { config = config, identity = identity, signals = signals, socket = socket, secret = secret, limit = limit } in
            let result = Stdlib.HttpServer.Quic.__loop context handler [] in
            Stdlib.__Datagram.close socket
            result in
      Stdlib.__Network.closeShutdownSignals signals
      result
  | _, _ -> Error "Invalid HTTP/3 server configuration"

/// Serve on the default IPv4 wildcard address. Use serveOn for IPv6 or an explicit interface.
let serve (config: Stdlib.HttpServer.Config.Config) (identity: Stdlib.TlsServerIdentity.Identity) (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (onListening: Unit -> Unit) : Stdlib.Result.Result<Unit, String> =
  Stdlib.HttpServer.Quic.serveOn [0L, 0L, 0L, 0L] config identity handler onListening
