// __Hpack.dark - Bounded RFC 7541 decoding, static header references and Huffman encoding.
// Static and Huffman tables are the protocol constants in RFC 7541 appendices A/B.
module Darklang.Stdlib.__Hpack

type State = { entries: List<(String * String)>, limit: Int64 }
type Decoded = { headers: List<(String * String)>, state: Stdlib.__Hpack.State }
type Number = { value: Int64, next: Int64 }
type Text = { value: String, next: Int64 }

let initial () : Stdlib.__Hpack.State = Stdlib.__Hpack.State { entries = [], limit = 4096L }

let __static (index: Int64) : Stdlib.Option.Option<(String * String)> =
  match index with
  | 1L -> Some ((":authority", ""))
  | 2L -> Some ((":method", "GET"))
  | 3L -> Some ((":method", "POST"))
  | 4L -> Some ((":path", "/"))
  | 5L -> Some ((":path", "/index.html"))
  | 6L -> Some ((":scheme", "http"))
  | 7L -> Some ((":scheme", "https"))
  | 8L -> Some ((":status", "200"))
  | 9L -> Some ((":status", "204"))
  | 10L -> Some ((":status", "206"))
  | 11L -> Some ((":status", "304"))
  | 12L -> Some ((":status", "400"))
  | 13L -> Some ((":status", "404"))
  | 14L -> Some ((":status", "500"))
  | 15L -> Some (("accept-charset", ""))
  | 16L -> Some (("accept-encoding", "gzip, deflate"))
  | 17L -> Some (("accept-language", ""))
  | 18L -> Some (("accept-ranges", ""))
  | 19L -> Some (("accept", ""))
  | 20L -> Some (("access-control-allow-origin", ""))
  | 21L -> Some (("age", ""))
  | 22L -> Some (("allow", ""))
  | 23L -> Some (("authorization", ""))
  | 24L -> Some (("cache-control", ""))
  | 25L -> Some (("content-disposition", ""))
  | 26L -> Some (("content-encoding", ""))
  | 27L -> Some (("content-language", ""))
  | 28L -> Some (("content-length", ""))
  | 29L -> Some (("content-location", ""))
  | 30L -> Some (("content-range", ""))
  | 31L -> Some (("content-type", ""))
  | 32L -> Some (("cookie", ""))
  | 33L -> Some (("date", ""))
  | 34L -> Some (("etag", ""))
  | 35L -> Some (("expect", ""))
  | 36L -> Some (("expires", ""))
  | 37L -> Some (("from", ""))
  | 38L -> Some (("host", ""))
  | 39L -> Some (("if-match", ""))
  | 40L -> Some (("if-modified-since", ""))
  | 41L -> Some (("if-none-match", ""))
  | 42L -> Some (("if-range", ""))
  | 43L -> Some (("if-unmodified-since", ""))
  | 44L -> Some (("last-modified", ""))
  | 45L -> Some (("link", ""))
  | 46L -> Some (("location", ""))
  | 47L -> Some (("max-forwards", ""))
  | 48L -> Some (("proxy-authenticate", ""))
  | 49L -> Some (("proxy-authorization", ""))
  | 50L -> Some (("range", ""))
  | 51L -> Some (("referer", ""))
  | 52L -> Some (("refresh", ""))
  | 53L -> Some (("retry-after", ""))
  | 54L -> Some (("server", ""))
  | 55L -> Some (("set-cookie", ""))
  | 56L -> Some (("strict-transport-security", ""))
  | 57L -> Some (("transfer-encoding", ""))
  | 58L -> Some (("user-agent", ""))
  | 59L -> Some (("vary", ""))
  | 60L -> Some (("via", ""))
  | 61L -> Some (("www-authenticate", ""))
  | _ -> None

let __dynamic (entries: List<(String * String)>) (index: Int64) : Stdlib.Option.Option<(String * String)> =
  match entries with
  | [] -> None
  | entry :: rest -> if index == 0L then Some entry else Stdlib.__Hpack.__dynamic rest (index - 1L)

let __lookup (state: Stdlib.__Hpack.State) (index: Int64) : Stdlib.Option.Option<(String * String)> =
  if index <= 0L then None
  else if index <= 61L then Stdlib.__Hpack.__static index
  else Stdlib.__Hpack.__dynamic state.entries (index - 62L)

let __pow2 (exponent: Int64) : Int64 =
  if exponent == 0L then 1L else 2L * Stdlib.__Hpack.__pow2 (exponent - 1L)

let __integerRest (data: Blob) (position: Int64) (value: Int64) (factor: Int64)
  : Stdlib.Result.Result<Stdlib.__Hpack.Number, String> =
  if position >= Stdlib.Blob.__byteLength data then Error "Truncated HPACK integer"
  else if factor > 268435456L then Error "HPACK integer overflow"
  else
    let byte = Stdlib.Blob.__getByte data position in
    let nextValue = value + (byte % 128L) * factor in
    if nextValue > 2147483647L then Error "HPACK integer overflow"
    else if byte < 128L then Ok (Stdlib.__Hpack.Number { value = nextValue, next = position + 1L })
    else Stdlib.__Hpack.__integerRest data (position + 1L) nextValue (factor * 128L)

let integer (data: Blob) (position: Int64) (prefix: Int64)
  : Stdlib.Result.Result<Stdlib.__Hpack.Number, String> =
  if prefix < 1L || prefix > 8L then Error "Invalid HPACK integer prefix"
  else if position < 0L || position >= Stdlib.Blob.__byteLength data then Error "Truncated HPACK integer"
  else
    let mask = Stdlib.__Hpack.__pow2 prefix - 1L in
    let value = Stdlib.Int64.bitwiseAnd (Stdlib.Blob.__getByte data position) mask in
    if value < mask then Ok (Stdlib.__Hpack.Number { value = value, next = position + 1L })
    else Stdlib.__Hpack.__integerRest data (position + 1L) value 1L

