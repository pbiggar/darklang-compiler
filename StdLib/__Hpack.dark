let __emitHuffman (bits: Int64) (length: Int64) (output: List<Int64>) : (Int64 * Int64 * List<Int64>) =
  if length < 8L then (bits, length, output)
  else
    let factor = Stdlib.__Hpack.__pow2 (length - 8L) in
    Stdlib.__Hpack.__emitHuffman (bits % factor) (length - 8L) (Stdlib.List.push output (bits / factor))

let __encodeHuffman (bytes: Blob) (position: Int64) (bits: Int64) (length: Int64) (output: List<Int64>) : Blob =
  if position == Stdlib.Blob.__byteLength bytes then
    let output = if length == 0L then output else
      let padding = Stdlib.__Hpack.__pow2 (8L - length) in
      Stdlib.List.push output (bits * padding + padding - 1L) in
    Stdlib.Blob.__fromInt64List (Stdlib.List.reverse output)
  else
    let (code, width) = Stdlib.__Hpack.__huffmanCode (Stdlib.Blob.__getByte bytes position) in
    let (nextBits, nextLength, nextOutput) = Stdlib.__Hpack.__emitHuffman (bits * Stdlib.__Hpack.__pow2 width + code) (length + width) output in
    Stdlib.__Hpack.__encodeHuffman bytes (position + 1L) nextBits nextLength nextOutput

let __sensitive (name: String) : Bool =
  name == "authorization" || name == "proxy-authorization" || name == "cookie" || name == "set-cookie"

let __staticIndex (name: String) (value: String) (exact: Bool) (index: Int64) : Stdlib.Option.Option<Int64> =
  match Stdlib.__Hpack.__static index with
  | None -> None
  | Some entry ->
    let (entryName, entryValue) = entry in
    if entryName == name && (Stdlib.Bool.not exact || entryValue == value) then Some index
    else Stdlib.__Hpack.__staticIndex name value exact (index + 1L)

let encodeText (value: String) : Blob =
  let raw = Stdlib.String.toBlob value in
  let compressed = Stdlib.__Hpack.__encodeHuffman raw 0L 0L 0L [] in
  let huffman = Stdlib.Blob.__byteLength compressed < Stdlib.Blob.__byteLength raw in
  let bytes = if huffman then compressed else raw in
  Stdlib.Blob.concat [Stdlib.__Hpack.encodeInteger 7L (if huffman then 128L else 0L) (Stdlib.Blob.__byteLength bytes), bytes]

let __encode (headers: List<(String * String)>) (size: Int64) (count: Int64)
  (blocks: List<Blob>) : Stdlib.Result.Result<Blob, String> =
  match headers with
  | [] -> Ok (Stdlib.Blob.concat (Stdlib.List.reverse blocks))
  | entry :: rest ->
    let (name, value) = entry in
    let nextSize = size + Stdlib.__Hpack.__entrySize entry in
    if count >= 256L || nextSize > 65536L then Error "HPACK header list too large"
    else if name == "" then Error "Empty HTTP header name"
    else
      let exact = if Stdlib.__Hpack.__sensitive name then None else Stdlib.__Hpack.__staticIndex name value true 1L in
      let encoded = match exact with
      | Some index -> Stdlib.__Hpack.encodeInteger 7L 128L index
      | None ->
        // Name references still carry never-indexed values for sensitive fields.
        let reference = match Stdlib.__Hpack.__staticIndex name value false 1L with
        | Some index -> Stdlib.__Hpack.encodeInteger 4L 16L index
        | None -> Stdlib.Blob.concat [Stdlib.Blob.__fromInt64List [16L], Stdlib.__Hpack.encodeText name] in
        Stdlib.Blob.concat [reference, Stdlib.__Hpack.encodeText value] in
      Stdlib.__Hpack.__encode rest nextSize (count + 1L) (Stdlib.List.push blocks encoded)

let encode (headers: List<(String * String)>) : Stdlib.Result.Result<Blob, String> =
  Stdlib.__Hpack.__encode headers 0L 0L []

