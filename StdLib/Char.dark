// Stdlib.Char - operations on one NFC-normalized extended grapheme cluster.

module Darklang.Stdlib.Char

let toString (char: Char) : String =
    Builtin.charToString char

let __asChar (value: String) : Char = value

let toUppercase (char: Char) : Char =
    Builtin.charToUppercase char

let toLowercase (char: Char) : Char =
    Builtin.charToLowercase char

let isLowercase (char: Char) : Bool =
    Stdlib.Char.toLowercase char == char && Stdlib.Char.toUppercase char != char

let isUppercase (char: Char) : Bool =
    Stdlib.Char.toLowercase char != char && Stdlib.Char.toUppercase char == char

let __firstCodepoint (char: Char) : Stdlib.Option.Option<Int64> =
    Stdlib.List.head (Stdlib.String.__toCodepoints (Stdlib.Char.toString char))

let isDigit (char: Char) : Bool =
    match Stdlib.Char.__firstCodepoint char with
    | Some codepoint -> codepoint >= 48L && codepoint <= 57L
    | None -> false

let isASCIILetter (char: Char) : Bool =
    match Stdlib.Char.__firstCodepoint char with
    | Some codepoint -> (codepoint >= 65L && codepoint <= 90L) || (codepoint >= 97L && codepoint <= 122L)
    | None -> false

let isLetter (char: Char) : Bool =
    Builtin.charIsLetter char

let isAlphanumeric (char: Char) : Bool =
    Builtin.charIsAlphanumeric char

let isWhitespace (char: Char) : Bool =
    Builtin.charIsWhitespace char

let toCodepoint (char: Char) : Stdlib.Option.Option<Int> =
    Builtin.charToCodepoint char

let toAsciiCode (char: Char) : Stdlib.Option.Option<Int> =
    Builtin.charToAsciiCode char

let isASCII (char: Char) : Bool =
    match Stdlib.Char.toAsciiCode char with
    | Some code -> code <= Stdlib.Int.fromInt64 127L
    | None -> false

let __utf16Units (codepoints: List<Int64>) (acc: List<Int64>) : List<Int64> =
    match codepoints with
    | [] -> Stdlib.List.reverse acc
    | codepoint :: rest ->
        if codepoint <= 65535L then Stdlib.Char.__utf16Units rest (Stdlib.List.push acc codepoint)
        else
            let adjusted = codepoint - 65536L in
            let high = 55296L + Stdlib.Int64.shiftRight adjusted 10L in
            let low = 56320L + Stdlib.Int64.bitwiseAnd adjusted 1023L in
            Stdlib.Char.__utf16Units rest (Stdlib.List.push (Stdlib.List.push acc high) low)

let __compareUnits (left: List<Int64>) (right: List<Int64>) : Int64 =
    match (left, right) with
    | ([], []) -> 0L
    | ([], _) -> -1L
    | (_, []) -> 1L
    | (leftHead :: leftRest, rightHead :: rightRest) ->
        if leftHead < rightHead then -1L
        else if leftHead > rightHead then 1L
        else Stdlib.Char.__compareUnits leftRest rightRest

let __compare (left: Char) (right: Char) : Int64 =
    Stdlib.Char.__compareUnits (Stdlib.Char.__utf16Units (Stdlib.String.__toCodepoints (Stdlib.Char.toString left)) []) (Stdlib.Char.__utf16Units (Stdlib.String.__toCodepoints (Stdlib.Char.toString right)) [])

let isLessThan (left: Char) (right: Char) : Bool =
    Builtin.charIsLessThan left right

let isLessThanOrEqualTo (left: Char) (right: Char) : Bool =
    Builtin.charIsLessThanOrEqualTo left right

let isGreaterThan (left: Char) (right: Char) : Bool =
    Builtin.charIsGreaterThan left right

let isGreaterThanOrEqualTo (left: Char) (right: Char) : Bool =
    Builtin.charIsGreaterThanOrEqualTo left right

let fromCodepoint (codepoint: Int) : Stdlib.Option.Option<Char> =
    Builtin.charFromCodepoint codepoint
