// Stdlib.Blob.dark - immutable binary values and interpreter-compatible codecs.

module Darklang.Stdlib.Blob

val empty = Builtin.blobEmpty

// The native Blob layout is [refcount:8][length:8][data:N][padding to 8].
// These Int64-based helpers are the private storage boundary beneath the
// interpreter-compatible UInt8/Int public API.
let __alignedDataSize (size: Int64) : Int64 =
    ((size + 7L) / 8L) * 8L

let __byteLength (blob: Blob) : Int64 =
    __raw_get<Int64> (__blob_to_rawptr blob) 8L

let __getByte (blob: Blob) (index: Int64) : Int64 =
    __raw_get_byte (__blob_to_rawptr blob) (index + 16L)

let __copyBytes (src: RawPtr) (dest: RawPtr) (offset: Int64) (remaining: Int64) : Unit =
    if remaining <= 0L then ()
    else
        let byte = __raw_get_byte src offset in
        let _ = __raw_write_byte dest offset byte in
        Stdlib.Blob.__copyBytes src dest (offset + 1L) (remaining - 1L)

let __zeroBytes (ptr: RawPtr) (offset: Int64) (remaining: Int64) : Unit =
    if remaining <= 0L then ()
    else
        let _ = __raw_write_byte ptr offset 0L in
        Stdlib.Blob.__zeroBytes ptr (offset + 1L) (remaining - 1L)

let __createZeroed (size: Int64) : Blob =
    let length = if size <= 0L then 0L else size in
    let dataSize = Stdlib.Blob.__alignedDataSize length in
    let ptr = __raw_alloc (16L + dataSize) in
    let _ = __raw_write_word ptr 0L 1L in
    let _ = __raw_write_word ptr 8L length in
    let _ = Stdlib.Blob.__zeroBytes ptr 16L length in
    __rawptr_to_blob ptr

let __writeInt64List (ptr: RawPtr) (bytes: List<Int64>) (offset: Int64) : Int64 =
    match bytes with
    | [] -> offset
    | byte :: rest ->
        let _ = __raw_write_byte ptr offset byte in
        Stdlib.Blob.__writeInt64List ptr rest (offset + 1L)

let __fromInt64List (bytes: List<Int64>) : Blob =
    let length = Stdlib.List.__length bytes in
    if length == 0L then Stdlib.Blob.__createZeroed 0L
    else
        let dataSize = Stdlib.Blob.__alignedDataSize length in
        let ptr = __raw_alloc (16L + dataSize) in
        let _ = __raw_write_word ptr 0L 1L in
        let _ = __raw_write_word ptr 8L length in
        let _ = Stdlib.Blob.__writeInt64List ptr bytes 16L in
        __rawptr_to_blob ptr

let __toInt64ListHelper (blob: Blob) (index: Int64) (acc: List<Int64>) : List<Int64> =
    if index < 0L then acc
    else
        Stdlib.Blob.__toInt64ListHelper blob (index - 1L) (Stdlib.List.push acc (Stdlib.Blob.__getByte blob index))

let __toInt64List (blob: Blob) : List<Int64> =
    Stdlib.Blob.__toInt64ListHelper blob (Stdlib.Blob.__byteLength blob - (1L)) []

let __hexDigit (value: Int64) : String =
    Stdlib.String.__byteSlice "0123456789ABCDEF" value (value + 1L)

let __byteToHex (byte: Int64) : String =
    Stdlib.Blob.__hexDigit (byte / 16L) ++ Stdlib.Blob.__hexDigit (byte % 16L)

let __hexEncode (blob: Blob) (index: Int64) (length: Int64) (acc: String) : String =
    if index >= length then acc
    else
        Stdlib.Blob.__hexEncode blob (index + 1L) length (acc ++ Stdlib.Blob.__byteToHex (Stdlib.Blob.__getByte blob index))

let __int64ToUInt8 (value: Int64) : UInt8 =
    match Stdlib.Int.toUInt8 (Stdlib.Int.fromInt64 value) with
    | Some converted -> converted
    | None -> Builtin.testRuntimeError "Blob byte did not fit UInt8"

let __uint8ToInt64 (value: UInt8) : Int64 =
    match Stdlib.Int.toInt64 (Stdlib.Int.fromUInt8 value) with
    | Some converted -> converted
    | None -> Builtin.testRuntimeError "UInt8 did not fit Int64"

let __intToInt64 (value: Int) : Int64 =
    match Stdlib.Int.toInt64 value with
    | Some converted -> converted
    | None -> Builtin.testRuntimeError "Clamped Blob index did not fit Int64"

let length (blob: Blob) : Int =
    Stdlib.Int.fromInt64 (Stdlib.Blob.__byteLength blob)

let __toList (blob: Blob) (index: Int64) (acc: List<UInt8>) : List<UInt8> =
    if index < 0L then acc
    else
        Stdlib.Blob.__toList blob (index - 1L) (Stdlib.List.push acc (Stdlib.Blob.__int64ToUInt8 (Stdlib.Blob.__getByte blob index)))

let toList (blob: Blob) : List<UInt8> =
    Stdlib.Blob.__toList blob (Stdlib.Blob.__byteLength blob - (1L)) []

let __fromList (bytes: List<UInt8>) (acc: List<Int64>) : Blob =
    match bytes with
    | [] -> Stdlib.Blob.__fromInt64List (Stdlib.List.reverse acc)
    | byte :: rest ->
        Stdlib.Blob.__fromList rest (Stdlib.List.push acc (Stdlib.Blob.__uint8ToInt64 byte))

let fromList (bytes: List<UInt8>) : Blob =
    Stdlib.Blob.__fromList bytes []

let __appendBlob (blob: Blob) (index: Int64) (acc: List<Int64>) : List<Int64> =
    if index >= Stdlib.Blob.__byteLength blob then acc
    else Stdlib.Blob.__appendBlob blob (index + 1L) (Stdlib.List.push acc (Stdlib.Blob.__getByte blob index))

let __concat (blobs: List<Blob>) (acc: List<Int64>) : Blob =
    match blobs with
    | [] -> Stdlib.Blob.__fromInt64List (Stdlib.List.reverse acc)
    | blob :: rest ->
        Stdlib.Blob.__concat rest (Stdlib.Blob.__appendBlob blob 0L acc)

let concat (blobs: List<Blob>) : Blob =
    Stdlib.Blob.__concat blobs []

let slice (blob: Blob) (start: Int) (length: Int) : Blob =
    let zero = Stdlib.Int.fromInt64 0L in
    let blobLength = Stdlib.Blob.length blob in
    let safeStart = if start < zero then zero else if start > blobLength then blobLength else start in
    let remaining = blobLength - safeStart in
    let safeLength = if length < zero then zero else if length > remaining then remaining else length in
    Stdlib.Blob.__fromInt64List (
        Stdlib.List.take (Stdlib.List.drop (Stdlib.Blob.__toInt64List blob) safeStart) safeLength)

let toHex (blob: Blob) : String =
    Stdlib.Blob.__hexEncode blob 0L (Stdlib.Blob.__byteLength blob) ""

let __hexValue (byte: Int64) : Int64 =
    if byte >= 48L && byte <= 57L then byte - 48L
    else if byte >= 65L && byte <= 70L then byte - 55L
    else if byte >= 97L && byte <= 102L then byte - 87L
    else -1L

let __fromHex (value: String) (index: Int64) (acc: List<Int64>) : Stdlib.Result.Result<Blob, String> =
    if index >= Stdlib.String.__byteLength value then
        Ok (Stdlib.Blob.__fromInt64List (Stdlib.List.reverse acc))
    else
        let high = Stdlib.Blob.__hexValue (Stdlib.String.__byteAtUnchecked value index) in
        let low = Stdlib.Blob.__hexValue (Stdlib.String.__byteAtUnchecked value (index + 1L)) in
        if high < 0L || low < 0L then
            Error "Invalid hex string: The input is not a valid hex string as it contains a non-hex character."
        else Stdlib.Blob.__fromHex value (index + 2L) (Stdlib.List.push acc (high * 16L + low))

let fromHex (value: String) : Stdlib.Result.Result<Blob, String> =
    if Stdlib.String.__byteLength value % 2L != 0L then
        Error "Invalid hex string: The input is not a valid hex string as its length is not a multiple of 2."
    else Stdlib.Blob.__fromHex value 0L []

let toBase64 (blob: Blob) : String =
    Stdlib.Base64.encode blob

let __removeBase64Whitespace (value: String) : String =
    Stdlib.String.replaceAll (Stdlib.String.replaceAll (Stdlib.String.replaceAll (Stdlib.String.replaceAll value " " "") "\t" "") "\r" "") "\n" ""

let fromBase64 (value: String) : Stdlib.Result.Result<Blob, String> =
    // Match the interpreter's ordering: normalize the URL alphabet and infer
    // padding before Convert-style whitespace removal.
    let alphabetNormalized =
        Stdlib.String.replaceAll (Stdlib.String.replaceAll value "-" "+") "_" "/" in
    let remainder = Stdlib.String.__byteLength alphabetNormalized % 4L in
    let padded =
        if remainder == 2L then alphabetNormalized ++ "=="
        else if remainder == 3L then alphabetNormalized ++ "="
        else alphabetNormalized in
    let normalized = Stdlib.Blob.__removeBase64Whitespace padded in
    match Stdlib.Base64.__decodeHelper normalized 0L (Stdlib.String.__byteLength normalized) [] with
    | Ok bytes -> Ok (Stdlib.Blob.__fromInt64List bytes)
    | Error _ ->
        Error "Invalid base64 string: The input is not a valid Base-64 string as it contains a non-base 64 character, more than two padding characters, or an illegal character among the padding characters."

let __stringBytes (value: String) (index: Int64) (acc: List<Int64>) : List<Int64> =
    if index >= Stdlib.String.__byteLength value then Stdlib.List.reverse acc
    else Stdlib.Blob.__stringBytes value (index + 1L) (Stdlib.List.push acc (Stdlib.String.__byteAtUnchecked value index))

let fromString (value: String) : Blob =
    Stdlib.Blob.__fromInt64List (Stdlib.Blob.__stringBytes value 0L [])

let __isContinuation (byte: Int64) : Bool =
    byte >= 128L && byte <= 191L

let __invalidUtf8 (byte: Int64) (index: Int64) : String =
    "Invalid UTF-8: Unable to translate bytes [" ++
    Stdlib.Blob.__byteToHex byte ++
    "] at index " ++
    Stdlib.Int64.toString index ++
    " from specified code page to Unicode."

// Returns the first invalid byte index, or -1 when the complete Blob is valid UTF-8.
let __validateUtf8 (blob: Blob) (index: Int64) (length: Int64) : Int64 =
    if index >= length then -1L
    else
        let b0 = Stdlib.Blob.__getByte blob index in
        if b0 <= 127L then Stdlib.Blob.__validateUtf8 blob (index + 1L) length
        else if b0 >= 194L && b0 <= 223L then
            if index + 1L >= length || Stdlib.Bool.not (Stdlib.Blob.__isContinuation (Stdlib.Blob.__getByte blob (index + 1L))) then index
            else Stdlib.Blob.__validateUtf8 blob (index + 2L) length
        else if b0 >= 224L && b0 <= 239L then
            if index + 2L >= length then index
            else
                let b1 = Stdlib.Blob.__getByte blob (index + 1L) in
                let b2 = Stdlib.Blob.__getByte blob (index + 2L) in
                if Stdlib.Bool.not (Stdlib.Blob.__isContinuation b1) || Stdlib.Bool.not (Stdlib.Blob.__isContinuation b2) then index
                else if b0 == 224L && b1 < 160L then index
                else if b0 == 237L && b1 >= 160L then index
                else Stdlib.Blob.__validateUtf8 blob (index + 3L) length
        else if b0 >= 240L && b0 <= 244L then
            if index + 3L >= length then index
            else
                let b1 = Stdlib.Blob.__getByte blob (index + 1L) in
                let b2 = Stdlib.Blob.__getByte blob (index + 2L) in
                let b3 = Stdlib.Blob.__getByte blob (index + 3L) in
                if Stdlib.Bool.not (Stdlib.Blob.__isContinuation b1)
                   || Stdlib.Bool.not (Stdlib.Blob.__isContinuation b2)
                   || Stdlib.Bool.not (Stdlib.Blob.__isContinuation b3) then index
                else if b0 == 240L && b1 < 144L then index
                else if b0 == 244L && b1 >= 144L then index
                else Stdlib.Blob.__validateUtf8 blob (index + 4L) length
        else index

let __copyToString (blob: Blob) : String =
    let length = Stdlib.Blob.__byteLength blob in
    if length == 0L then ""
    else
        let dataSize = Stdlib.Blob.__alignedDataSize length in
        let ptr = __raw_alloc (16L + dataSize) in
        let _ = __raw_write_word ptr 0L 1L in
        let _ = __raw_write_word ptr 8L length in
        let _ = Stdlib.Blob.__copyBytes (__blob_to_rawptr blob) ptr 16L length in
        __rawptr_to_string ptr

let toString (blob: Blob) : Stdlib.Result.Result<String, String> =
    let invalidIndex = Stdlib.Blob.__validateUtf8 blob 0L (Stdlib.Blob.__byteLength blob) in
    if invalidIndex < 0L then Ok (Stdlib.Blob.__copyToString blob)
    else Error (Stdlib.Blob.__invalidUtf8 (Stdlib.Blob.__getByte blob invalidIndex) invalidIndex)
