// __Tls13Handshake.dark - TLS 1.3 handshake secrets, server Finished, and bounded reassembly.

module Darklang.Stdlib.__Tls13Handshake

type HandshakeSecrets = {
  client: Blob,
  server: Blob,
  transcript: Blob
}

type HandshakeFrame = { kind: Int64, body: Blob, raw: Blob, remaining: Blob }

type FlightPhase =
  | AwaitExtensions
  | AwaitCertificate
  | AwaitCertificateVerify
  | AwaitFinished
  | ServerFinished

// Certificate and CertificateVerify are retained as untrusted handshake bytes.
// ServerFinished proves transcript integrity, not the server's identity.
type ServerFlight = {
  cipherSuite: Int64,
  serverKeys: Stdlib.__Tls13.TrafficKeys,
  clientHandshakeSecret: Blob,
  serverHandshakeSecret: Blob,
  transcript: Blob,
  pending: Blob,
  phase: Stdlib.__Tls13Handshake.FlightPhase,
  unverifiedCertificate: Stdlib.Option.Option<Blob>,
  unverifiedCertificateVerify: Stdlib.Option.Option<Blob>
}

let __wholeHandshake (message: Blob) (kind: Int64) : Bool =
  let length = Stdlib.Blob.__byteLength message in
  length >= 4L && Stdlib.Blob.__getByte message 0L == kind &&
  Stdlib.__Tls13.__read24 message 1L == length - 4L

let __or32 (bytes: Blob) (index: Int64) (acc: Int64) : Int64 =
  if index == 32L then acc
  else Stdlib.__Tls13Handshake.__or32 bytes (index + 1L)
         (Stdlib.Int64.bitwiseOr acc (Stdlib.Blob.__getByte bytes index))

// RFC 8446, §7.1: early_secret -> derived -> handshake_secret.
let deriveHandshakeSecrets (sharedSecret: Blob) (clientHello: Blob) (serverHello: Blob)
  : Stdlib.Result.Result<Stdlib.__Tls13Handshake.HandshakeSecrets, String> =
  if Stdlib.Blob.__byteLength sharedSecret != 32L then
    Error "TLS X25519 shared secret must be 32 bytes"
  else if Stdlib.__Tls13Handshake.__or32 sharedSecret 0L 0L == 0L then
    Error "TLS X25519 shared secret is zero"
  else if Stdlib.Bool.not (Stdlib.__Tls13Handshake.__wholeHandshake clientHello 1L) ||
          Stdlib.Bool.not (Stdlib.__Tls13Handshake.__wholeHandshake serverHello 2L) then
    Error "TLS handshake transcript requires complete ClientHello and ServerHello"
  else
    let zero = Stdlib.Blob.__fromInt64List (Stdlib.List.repeatUnsafe 32 0L) in
    let emptyHash = Stdlib.Crypto.sha256 Stdlib.Blob.empty in
    let early = Stdlib.__Tls13.hkdfExtract zero zero in
    match Stdlib.__Tls13.hkdfExpandLabel early "derived" emptyHash 32L with
    | Error message -> Error message
    | Ok derived ->
        let handshake = Stdlib.__Tls13.hkdfExtract derived sharedSecret in
        let transcript = Stdlib.Blob.concat [clientHello, serverHello] in
        let transcriptHash = Stdlib.Crypto.sha256 transcript in
        match Stdlib.__Tls13.hkdfExpandLabel handshake "c hs traffic" transcriptHash 32L with
        | Error message -> Error message
        | Ok client ->
            match Stdlib.__Tls13.hkdfExpandLabel handshake "s hs traffic" transcriptHash 32L with
            | Error message -> Error message
            | Ok server ->
                Ok (Stdlib.__Tls13Handshake.HandshakeSecrets {
                  client = client, server = server, transcript = transcript })

let deriveHandshakeSecrets384 (sharedSecret: Blob) (clientHello: Blob) (serverHello: Blob)
  : Stdlib.Result.Result<Stdlib.__Tls13Handshake.HandshakeSecrets, String> =
  if Stdlib.Blob.__byteLength sharedSecret != 32L then
    Error "TLS X25519 shared secret must be 32 bytes"
  else if Stdlib.__Tls13Handshake.__or32 sharedSecret 0L 0L == 0L then
    Error "TLS X25519 shared secret is zero"
  else if Stdlib.Bool.not (Stdlib.__Tls13Handshake.__wholeHandshake clientHello 1L) ||
          Stdlib.Bool.not (Stdlib.__Tls13Handshake.__wholeHandshake serverHello 2L) then
    Error "TLS handshake transcript requires complete ClientHello and ServerHello"
  else
    let zero = Stdlib.Blob.__fromInt64List (Stdlib.List.repeatUnsafe 48 0L) in
    let emptyHash = Stdlib.Crypto.sha384 Stdlib.Blob.empty in
    let early = Stdlib.__Tls13.hkdfExtract384 zero zero in
    match Stdlib.__Tls13.hkdfExpandLabel384 early "derived" emptyHash 48L with
    | Error message -> Error message
    | Ok derived ->
        let handshake = Stdlib.__Tls13.hkdfExtract384 derived sharedSecret in
        let transcript = Stdlib.Blob.concat [clientHello, serverHello] in
        let transcriptHash = Stdlib.Crypto.sha384 transcript in
        match Stdlib.__Tls13.hkdfExpandLabel384 handshake "c hs traffic" transcriptHash 48L with
        | Error message -> Error message
        | Ok client ->
            match Stdlib.__Tls13.hkdfExpandLabel384 handshake "s hs traffic" transcriptHash 48L with
            | Error message -> Error message
            | Ok server ->
                Ok (Stdlib.__Tls13Handshake.HandshakeSecrets {
                  client = client, server = server, transcript = transcript })

let finishedVerifyData (trafficSecret: Blob) (transcript: Blob)
  : Stdlib.Result.Result<Blob, String> =
  if Stdlib.Blob.__byteLength trafficSecret != 32L then
    Error "TLS handshake traffic secret must be 32 bytes"
  else
    match Stdlib.__Tls13.hkdfExpandLabel trafficSecret "finished" Stdlib.Blob.empty 32L with
    | Error message -> Error message
    | Ok key ->
        Ok (Stdlib.Crypto.sha256hmac key (Stdlib.Crypto.sha256 transcript))

let finishedVerifyData384 (trafficSecret: Blob) (transcript: Blob)
  : Stdlib.Result.Result<Blob, String> =
  if Stdlib.Blob.__byteLength trafficSecret != 48L then
    Error "TLS SHA-384 handshake traffic secret must be 48 bytes"
  else
    match Stdlib.__Tls13.hkdfExpandLabel384 trafficSecret "finished" Stdlib.Blob.empty 48L with
    | Error message -> Error message
    | Ok key ->
        Ok (Stdlib.Crypto.__sha384hmac key (Stdlib.Crypto.sha384 transcript))

let __sameBytes (a: Blob) (b: Blob) (index: Int64) (difference: Int64) : Bool =
  if index == Stdlib.Blob.__byteLength a then difference == 0L
  else Stdlib.__Tls13Handshake.__sameBytes a b (index + 1L)
         (Stdlib.Int64.bitwiseOr difference
           (Stdlib.Int64.bitwiseXor (Stdlib.Blob.__getByte a index)
             (Stdlib.Blob.__getByte b index)))

let parseHandshakeFrame (data: Blob)
  : Stdlib.Result.Result<Stdlib.__Tls13Handshake.HandshakeFrame, Stdlib.__Tls13.RecordError> =
  let length = Stdlib.Blob.__byteLength data in
  if length < 4L then Error Stdlib.__Tls13.RecordError.Incomplete
  else
    let bodyLength = Stdlib.__Tls13.__read24 data 1L in
    if bodyLength > 1048576L then
      Error (Stdlib.__Tls13.RecordError.Invalid "TLS handshake message exceeds size limit")
    else if length < bodyLength + 4L then Error Stdlib.__Tls13.RecordError.Incomplete
    else
      Ok (Stdlib.__Tls13Handshake.HandshakeFrame {
        kind = Stdlib.Blob.__getByte data 0L,
        body = Stdlib.Blob.slice data 4 (Stdlib.Int.fromInt64 bodyLength),
        raw = Stdlib.Blob.slice data 0 (Stdlib.Int.fromInt64 (bodyLength + 4L)),
        remaining = Stdlib.Blob.slice data (Stdlib.Int.fromInt64 (bodyLength + 4L))
                      (Stdlib.Int.fromInt64 (length - bodyLength - 4L)) })

let startServerFlightForSuite (sharedSecret: Blob) (clientHello: Blob) (serverHello: Blob)
  (cipherSuite: Int64)
  : Stdlib.Result.Result<Stdlib.__Tls13Handshake.ServerFlight, String> =
  let secrets =
    if cipherSuite == 4865L || cipherSuite == 4867L then
      Stdlib.__Tls13Handshake.deriveHandshakeSecrets sharedSecret clientHello serverHello
    else if cipherSuite == 4866L then
      Stdlib.__Tls13Handshake.deriveHandshakeSecrets384 sharedSecret clientHello serverHello
    else Error "Unsupported TLS cipher suite" in
  match secrets with
  | Error message -> Error message
  | Ok secrets ->
      let keys = if cipherSuite == 4866L then Stdlib.__Tls13.trafficKeys384 secrets.server
                 else if cipherSuite == 4867L then Stdlib.__Tls13.trafficKeysChaCha secrets.server
                 else Stdlib.__Tls13.trafficKeys secrets.server in
      match keys with
      | Error message -> Error message
      | Ok keys ->
          Ok (Stdlib.__Tls13Handshake.ServerFlight {
            cipherSuite = cipherSuite,
            serverKeys = keys,
            clientHandshakeSecret = secrets.client,
            serverHandshakeSecret = secrets.server,
            transcript = secrets.transcript,
            pending = Stdlib.Blob.empty,
            phase = Stdlib.__Tls13Handshake.FlightPhase.AwaitExtensions,
            unverifiedCertificate = None,
            unverifiedCertificateVerify = None })

let startServerFlight (sharedSecret: Blob) (clientHello: Blob) (serverHello: Blob)
  : Stdlib.Result.Result<Stdlib.__Tls13Handshake.ServerFlight, String> =
  Stdlib.__Tls13Handshake.startServerFlightForSuite sharedSecret clientHello serverHello 4865L

let __advance (state: Stdlib.__Tls13Handshake.ServerFlight)
  (phase: Stdlib.__Tls13Handshake.FlightPhase) (message: Stdlib.__Tls13Handshake.HandshakeFrame)
  (certificate: Stdlib.Option.Option<Blob>)
  (certificateVerify: Stdlib.Option.Option<Blob>) : Stdlib.__Tls13Handshake.ServerFlight =
  Stdlib.__Tls13Handshake.ServerFlight {
    cipherSuite = state.cipherSuite,
    serverKeys = state.serverKeys,
    clientHandshakeSecret = state.clientHandshakeSecret,
    serverHandshakeSecret = state.serverHandshakeSecret,
    transcript = Stdlib.Blob.concat [state.transcript, message.raw],
    pending = Stdlib.Blob.empty,
    phase = phase,
    unverifiedCertificate = certificate,
    unverifiedCertificateVerify = certificateVerify }

let __processFrame (state: Stdlib.__Tls13Handshake.ServerFlight)
  (frame: Stdlib.__Tls13Handshake.HandshakeFrame)
  : Stdlib.Result.Result<Stdlib.__Tls13Handshake.ServerFlight, String> =
  match state.phase with
  | AwaitExtensions ->
      let length = Stdlib.Blob.__byteLength frame.body in
      if frame.kind != 8L || length < 2L ||
         Stdlib.__Tls13.__read16 frame.body 0L != length - 2L then
        Error "Invalid TLS EncryptedExtensions"
      else Ok (Stdlib.__Tls13Handshake.__advance state
                 Stdlib.__Tls13Handshake.FlightPhase.AwaitCertificate frame
                 state.unverifiedCertificate state.unverifiedCertificateVerify)
  | AwaitCertificate ->
      let length = Stdlib.Blob.__byteLength frame.body in
      if frame.kind != 11L || length < 5L ||
         Stdlib.Blob.__getByte frame.body 0L != 0L ||
         Stdlib.__Tls13.__read24 frame.body 1L != length - 4L then
        Error "Invalid TLS Certificate message"
      else Ok (Stdlib.__Tls13Handshake.__advance state
                 Stdlib.__Tls13Handshake.FlightPhase.AwaitCertificateVerify frame
                 (Some frame.raw) state.unverifiedCertificateVerify)
  | AwaitCertificateVerify ->
      let length = Stdlib.Blob.__byteLength frame.body in
      if frame.kind != 15L || length < 5L ||
         Stdlib.__Tls13.__read16 frame.body 2L != length - 4L then
        Error "Invalid TLS CertificateVerify message"
      else Ok (Stdlib.__Tls13Handshake.__advance state
                 Stdlib.__Tls13Handshake.FlightPhase.AwaitFinished frame
                 state.unverifiedCertificate (Some frame.raw))
  | AwaitFinished ->
      if frame.kind != 20L || Stdlib.Blob.__byteLength frame.body !=
           (if state.cipherSuite == 4866L then 48L else 32L) then
        Error "Invalid TLS Finished message"
      else
        let expected = if state.cipherSuite == 4866L then
                         Stdlib.__Tls13Handshake.finishedVerifyData384
                           state.serverHandshakeSecret state.transcript
                       else Stdlib.__Tls13Handshake.finishedVerifyData
                              state.serverHandshakeSecret state.transcript in
        match expected with
        | Error message -> Error message
        | Ok expected ->
            if Stdlib.Bool.not (Stdlib.__Tls13Handshake.__sameBytes expected frame.body 0L 0L) then
              Error "TLS Finished verification failed"
            else Ok (Stdlib.__Tls13Handshake.__advance state
                       Stdlib.__Tls13Handshake.FlightPhase.ServerFinished frame
                       state.unverifiedCertificate state.unverifiedCertificateVerify)
  | ServerFinished ->
      Error "Unexpected TLS handshake message after Finished"

let __withPending (state: Stdlib.__Tls13Handshake.ServerFlight) (pending: Blob)
  : Stdlib.__Tls13Handshake.ServerFlight =
  Stdlib.__Tls13Handshake.ServerFlight {
    cipherSuite = state.cipherSuite,
    serverKeys = state.serverKeys,
    clientHandshakeSecret = state.clientHandshakeSecret,
    serverHandshakeSecret = state.serverHandshakeSecret,
    transcript = state.transcript,
    pending = pending,
    phase = state.phase,
    unverifiedCertificate = state.unverifiedCertificate,
    unverifiedCertificateVerify = state.unverifiedCertificateVerify }

let __withKeys (state: Stdlib.__Tls13Handshake.ServerFlight)
  (keys: Stdlib.__Tls13.TrafficKeys) : Stdlib.__Tls13Handshake.ServerFlight =
  Stdlib.__Tls13Handshake.ServerFlight {
    cipherSuite = state.cipherSuite,
    serverKeys = keys,
    clientHandshakeSecret = state.clientHandshakeSecret,
    serverHandshakeSecret = state.serverHandshakeSecret,
    transcript = state.transcript,
    pending = state.pending,
    phase = state.phase,
    unverifiedCertificate = state.unverifiedCertificate,
    unverifiedCertificateVerify = state.unverifiedCertificateVerify }

let __consumeFrames (state: Stdlib.__Tls13Handshake.ServerFlight) (buffer: Blob)
  : Stdlib.Result.Result<Stdlib.__Tls13Handshake.ServerFlight, String> =
  if Stdlib.Blob.__byteLength buffer > 1048580L then
    Error "TLS handshake buffer exceeds size limit"
  else if Stdlib.Blob.__byteLength buffer == 0L then Ok state
  else
    match Stdlib.__Tls13Handshake.parseHandshakeFrame buffer with
    | Error Incomplete ->
        Ok (Stdlib.__Tls13Handshake.__withPending state buffer)
    | Error (Invalid message) -> Error message
    | Ok frame ->
        match Stdlib.__Tls13Handshake.__processFrame state frame with
        | Error message -> Error message
        | Ok next ->
            if next.phase == Stdlib.__Tls13Handshake.FlightPhase.ServerFinished &&
               Stdlib.Blob.__byteLength frame.remaining != 0L then
              Error "Unexpected TLS handshake bytes after Finished"
            else Stdlib.__Tls13Handshake.__consumeFrames next frame.remaining

let consumeServerRecord (state: Stdlib.__Tls13Handshake.ServerFlight)
  (record: Stdlib.__Tls13.Record)
  : Stdlib.Result.Result<Stdlib.__Tls13Handshake.ServerFlight, String> =
  if state.phase == Stdlib.__Tls13Handshake.FlightPhase.ServerFinished then
    Error "TLS server handshake already finished"
  else
    match Stdlib.__Tls13.openRecord state.serverKeys record with
    | Error message -> Error message
    | Ok opened ->
        if opened.contentType != 22L then Error "Expected encrypted TLS handshake record"
        else
          let buffered = Stdlib.Blob.concat [state.pending, opened.content] in
          Stdlib.__Tls13Handshake.__consumeFrames
            (Stdlib.__Tls13Handshake.__withKeys
              (Stdlib.__Tls13Handshake.__withPending state Stdlib.Blob.empty)
              opened.nextKeys) buffered

// Reassemble plaintext or authenticated handshake fragments across records.
type Message = { kind: Int64, bytes: Blob, body: Blob }
type Decoder = { pending: Blob }
type Feed = { messages: List<Stdlib.__Tls13Handshake.Message>, next: Stdlib.__Tls13Handshake.Decoder }

val empty =
  Stdlib.__Tls13Handshake.Decoder { pending = Stdlib.Blob.empty }

let __read24 (data: Blob) (offset: Int64) : Int64 =
  Stdlib.Blob.__getByte data offset * 65536L
  + Stdlib.Blob.__getByte data (offset + 1L) * 256L
  + Stdlib.Blob.__getByte data (offset + 2L)

let __scan (data: Blob) (position: Int64) (count: Int64)
           (acc: List<Stdlib.__Tls13Handshake.Message>)
           : Stdlib.Result.Result<Stdlib.__Tls13Handshake.Feed, String> =
  let remaining = Stdlib.Blob.__byteLength data - position in
  if remaining == 0L then
    Ok (Stdlib.__Tls13Handshake.Feed {
      messages = Stdlib.List.reverse acc, next = Stdlib.__Tls13Handshake.empty })
  else if count == 64L then Error "Too many TLS handshake messages in one record"
  else if remaining < 4L then
    Ok (Stdlib.__Tls13Handshake.Feed {
      messages = Stdlib.List.reverse acc,
      next = Stdlib.__Tls13Handshake.Decoder {
        pending = Stdlib.Blob.slice data (Stdlib.Int.fromInt64 position)
                    (Stdlib.Int.fromInt64 remaining) } })
  else
    let bodyLength = Stdlib.__Tls13Handshake.__read24 data (position + 1L) in
    if bodyLength > 524288L then Error "TLS handshake message exceeds size limit"
    else if remaining < bodyLength + 4L then
      Ok (Stdlib.__Tls13Handshake.Feed {
        messages = Stdlib.List.reverse acc,
        next = Stdlib.__Tls13Handshake.Decoder {
          pending = Stdlib.Blob.slice data (Stdlib.Int.fromInt64 position)
                      (Stdlib.Int.fromInt64 remaining) } })
    else
      let message = Stdlib.__Tls13Handshake.Message {
        kind = Stdlib.Blob.__getByte data position,
        bytes = Stdlib.Blob.slice data (Stdlib.Int.fromInt64 position)
                  (Stdlib.Int.fromInt64 (bodyLength + 4L)),
        body = Stdlib.Blob.slice data (Stdlib.Int.fromInt64 (position + 4L))
                 (Stdlib.Int.fromInt64 bodyLength) } in
      Stdlib.__Tls13Handshake.__scan data (position + bodyLength + 4L)
        (count + 1L) (Stdlib.List.push acc message)

// Feed only the handshake payload of a plaintext or authenticated TLS record.
// The caller validates record content type and decides when to add raw message
// bytes to the transcript; unverified messages must not advance authentication.
let feed (decoder: Stdlib.__Tls13Handshake.Decoder) (fragment: Blob)
         : Stdlib.Result.Result<Stdlib.__Tls13Handshake.Feed, String> =
  let fragmentLength = Stdlib.Blob.__byteLength fragment in
  let pendingLength = Stdlib.Blob.__byteLength decoder.pending in
  if fragmentLength > 16384L || pendingLength > 524291L then
    Error "TLS handshake fragment exceeds size limit"
  else
    Stdlib.__Tls13Handshake.__scan
      (Stdlib.Blob.concat [decoder.pending, fragment]) 0L 0L []

let finish (decoder: Stdlib.__Tls13Handshake.Decoder) : Stdlib.Result.Result<Unit, String> =
  if Stdlib.Blob.__byteLength decoder.pending == 0L then Ok ()
  else Error "TLS handshake truncated"
