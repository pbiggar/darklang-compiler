// Stdlib.Tuple3.dark - Stdlib.Tuple3 definitions
//
// Split from stdlib.dark for modular stdlib loading.

module Darklang.Stdlib.Tuple3

// Stdlib.Tuple3 - 3-tuple operations

let create<'a, 'b, 'c> (first: a) (second: b) (third: c) : (a * b * c) = (first, second, third)

let first<'a, 'b, 'c> (t: (a * b * c)) : a = match t with | (x, y, z) -> x

let second<'a, 'b, 'c> (t: (a * b * c)) : b = match t with | (x, y, z) -> y

let third<'a, 'b, 'c> (t: (a * b * c)) : c = match t with | (x, y, z) -> z

let mapFirst<'a, 'b, 'c, 'd> (t: (a * b * c)) (fn: a -> d) : (d * b * c) =
    match t with | (x, y, z) -> (fn x, y, z)

let mapSecond<'a, 'b, 'c, 'd> (t: (a * b * c)) (fn: b -> d) : (a * d * c) =
    match t with | (x, y, z) -> (x, fn y, z)

let mapThird<'a, 'b, 'c, 'd> (t: (a * b * c)) (fn: c -> d) : (a * b * d) =
    match t with | (x, y, z) -> (x, y, fn z)

let mapAllThree<'a, 'b, 'c, 'd, 'e, 'f> (t: (a * b * c)) (fnFirst: a -> d) (fnSecond: b -> e) (fnThird: c -> f) : (d * e * f) =
    match t with | (x, y, z) -> (fnFirst x, fnSecond y, fnThird z)

