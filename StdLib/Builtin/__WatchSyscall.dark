// One-call event-queue/poll ABI adapters; event decoding and watch policy are Dark.
module Builtin

let syscallInotifyInit1 (flags: Int) : Stdlib.Result.Result<Int, Int> =
    Builtin.__syscallIntResult (Stdlib.Cli.__Posix.__inotifyInit1 (Builtin.__posixInt32 flags))

let syscallInotifyAddWatch (fd: Int) (path: String) (mask: Int) : Stdlib.Result.Result<Int, Int> =
    let fd = Builtin.__posixInt32 fd in
    let mask = Stdlib.Int64.bitwiseAnd (Builtin.__posixInt32 mask) (-33554433L) in
    if Stdlib.Cli.__Posix.__mac () then Error 78
    else
        Stdlib.Cli.__Posix.__metadataPath path (fun _ held ->
            let rc = Stdlib.Cli.__Posix.__withCString held (fun ptr -> Stdlib.Cli.__Posix.__inotifyAddWatch fd ptr mask) in
            if rc < 0L then Error (Stdlib.Cli.__Posix.__error (0L - rc))
            else Ok (Stdlib.Int.fromInt64 rc))
        |> Stdlib.Result.mapError (fun error -> error.errno)

let __writePollDescriptors (ptr: RawPtr) (offset: Int64) (fds: List<(Int * Int)>) : Unit =
    match fds with
    | [] -> ()
    | pair :: rest ->
        let (fd, events) = pair in
        let fd = Stdlib.Int64.bitwiseAnd (Builtin.__posixInt32 fd) 4294967295L in
        let events = Builtin.__posixInt32 events in
        let _ = __raw_write_word ptr offset (fd + events * 4294967296L) in
        Builtin.__writePollDescriptors ptr (offset + 8L) rest

let __pollRecords (darwin: Bool) (fds: List<(Int * Int)>) (timeoutMs: Int) : Stdlib.Result.Result<Blob, Int> =
    let timeoutMs = Builtin.__posixInt32 timeoutMs in
    let count = Stdlib.List.length fds in
    if timeoutMs < 0L || count > 1024 || Stdlib.List.any fds (fun pair -> let (_, events) = pair in events < 0 || events > 32767) then Error 22
    else
        let length = Builtin.__posixInt64 (count * 8) in
        let ptr = __mapped_alloc (if length == 0L then 1L else length) in
        let timeout = __mapped_alloc 16L in
        let _ = Builtin.__writePollDescriptors ptr 0L fds in
        let _ = __raw_write_word timeout 0L (timeoutMs / 1000L) in
        let _ = __raw_write_word timeout 8L ((timeoutMs % 1000L) * 1000000L) in
        let rc = if darwin then Stdlib.Cli.__Posix.__pollDarwin ptr (Builtin.__posixInt64 count) timeoutMs
                 else Stdlib.Cli.__Posix.__ppoll ptr (Builtin.__posixInt64 count) timeout (__word_to_rawptr 0L) 8L in
        let result = if rc < 0L then Error (Stdlib.Int.fromInt64 (0L - rc))
                     else Ok (Stdlib.Cli.__Posix.__bufferBytes ptr 0L length []) in
        let _ = __mapped_free timeout in
        let _ = __mapped_free ptr in
        result

let syscallPpoll (fds: List<(Int * Int)>) (timeoutMs: Int) : Stdlib.Result.Result<Blob, Int> =
    Builtin.__pollRecords false fds timeoutMs

let syscallPollDarwin (fds: List<(Int * Int)>) (timeoutMs: Int) : Stdlib.Result.Result<Blob, Int> =
    Builtin.__pollRecords true fds timeoutMs
