// __Task.dark - Native tasks, promise parking, timers and socket readiness.
// Context and scheduler pointers are borrowed; owned lists retain task lifetimes.
// This private explicit scheduler is not yet the automatic program entry point.
module Darklang.Stdlib.__Task

type __Task = { context: RawPtr, lifecycle: Stream<Unit> }
type __Timer = { deadline: Int64, complete: Unit -> Unit }
type __IO = {
    interest: Stdlib.__Network.Interest,
    complete: Stdlib.Result.Result<Stdlib.__Network.Ready, Int64> -> Unit
}

let __STACK_BYTES () : Int64 = 8388608L
let __CONTEXT_BYTES () : Int64 = 208L
let __TASKS () : Int64 = 208L
let __FRONT () : Int64 = 216L
let __BACK () : Int64 = 224L
let __TIMERS () : Int64 = 232L
let __IO_QUEUE () : Int64 = 240L
let __IO_COUNT () : Int64 = 248L
let __ACTIVE () : Int64 = 256L

let __set<'a> (cell: RawPtr) (offset: Int64) (value: a) : Unit =
    let previous = __raw_take<a> cell offset in
    let _ = __raw_slot_init<a> cell offset value in
    ()

let __state (context: RawPtr) : Int64 = __raw_get<Int64> context 64L
let __scheduler (context: RawPtr) : RawPtr = __raw_get<RawPtr> context 56L

let __disposeTask (context: RawPtr) : Unit =
    let state = Stdlib.__Task.__state context in
    if state == 0L || state == 4L then
        let entry = __raw_take<RawPtr -> Unit> context 40L in
        let mapping = __raw_get<RawPtr> context 48L in
        let _ = __fiber_stack_free mapping (Stdlib.__Task.__STACK_BYTES ()) in
        let _ = __raw_free context in
        ()
    else Builtin.crash "Cannot discard a live native task stack"

let __new (scheduler: RawPtr) (entry: RawPtr -> Unit) : Stdlib.__Task.__Task =
    let context = __raw_alloc (Stdlib.__Task.__CONTEXT_BYTES ()) in
    let mapping = __fiber_stack_alloc (Stdlib.__Task.__STACK_BYTES ()) in
    let _ = __raw_slot_init<RawPtr -> Unit> context 40L entry in
    let _ = __raw_slot_init<RawPtr> context 48L mapping in
    let _ = __raw_slot_init<RawPtr> context 56L scheduler in
    let _ = __raw_write_word context 64L 0L in
    let _ = __fiber_prepare context mapping (Stdlib.__Task.__STACK_BYTES ()) in
    let lifecycle = Stdlib.Stream.__new (fun _unit -> None) (fun _unit -> Stdlib.__Task.__disposeTask context) in
    Stdlib.__Task.__Task { context = context; lifecycle = lifecycle }

let __enqueue (scheduler: RawPtr) (task: Stdlib.__Task.__Task) : Unit =
    let back = __raw_get<List<Stdlib.__Task.__Task>> scheduler (Stdlib.__Task.__BACK ()) in
    Stdlib.__Task.__set scheduler (Stdlib.__Task.__BACK ()) (Stdlib.List.push back task)

let __dequeueFront (scheduler: RawPtr) : Stdlib.Option.Option<Stdlib.__Task.__Task> =
    match __raw_get<List<Stdlib.__Task.__Task>> scheduler (Stdlib.__Task.__FRONT ()) with
    | [] -> None
    | head :: tail ->
        let _ = Stdlib.__Task.__set scheduler (Stdlib.__Task.__FRONT ()) tail in
        Some head

let __dequeue (scheduler: RawPtr) : Stdlib.Option.Option<Stdlib.__Task.__Task> =
    match Stdlib.__Task.__dequeueFront scheduler with
    | Some task -> Some task
    | None ->
        let back = __raw_take<List<Stdlib.__Task.__Task>> scheduler (Stdlib.__Task.__BACK ()) in
        let _ = __raw_write_word scheduler (Stdlib.__Task.__BACK ()) 0L in
        let _ = Stdlib.__Task.__set scheduler (Stdlib.__Task.__FRONT ()) (Stdlib.List.reverse back) in
        Stdlib.__Task.__dequeueFront scheduler

let __find (tasks: List<Stdlib.__Task.__Task>) (id: Int64) : Stdlib.__Task.__Task =
    match tasks with
    | [] -> Builtin.crash "Unknown native task waiter"
    | task :: tail ->
        if __rawptr_to_word task.context == id then task
        else Stdlib.__Task.__find tail id

let __wakeOne (scheduler: RawPtr) (task: Stdlib.__Task.__Task) : Unit =
    if Stdlib.__Task.__state task.context == 3L then
        let _ = __raw_write_word task.context 64L 1L in
        Stdlib.__Task.__enqueue scheduler task
    else ()

let __wake (scheduler: RawPtr) (waiters: List<Int64>) : Unit =
    match waiters with
    | [] -> ()
    | id :: tail ->
        let tasks = __raw_get<List<Stdlib.__Task.__Task>> scheduler (Stdlib.__Task.__TASKS ()) in
        let task = Stdlib.__Task.__find tasks id in
        let _ = Stdlib.__Task.__wakeOne scheduler task in
        Stdlib.__Task.__wake scheduler tail

let __yield (context: RawPtr) : Unit =
    let _ = __raw_write_word context 64L 1L in
    let _ = __fiber_switch context (Stdlib.__Task.__scheduler context) in
    ()

let __park<'a> (context: RawPtr) (promise: Stdlib.__Async.__Promise<a>) : Unit =
    if __rawptr_to_word context == 0L then Builtin.crash "Cannot force a pending value outside a native task"
    else if Stdlib.__Async.__wait promise (__rawptr_to_word context) then
        let _ = __raw_write_word context 64L 3L in
        let _ = __fiber_switch context (Stdlib.__Task.__scheduler context) in
        ()
    else ()

let __force<'a> (context: RawPtr) (value: Stdlib.__Async.__Value<a>) : a =
    match value with
    | ValueReady result -> result
    | ValueDeferred follow -> Stdlib.__Task.__force context (follow ())
    | ValuePending promise ->
        match Stdlib.__Async.__poll promise with
        | Some result -> result
        | None ->
            let _ = Stdlib.__Task.__park context promise in
            Stdlib.__Task.__force context value

let __resolve<'a> (context: RawPtr) (promise: Stdlib.__Async.__Promise<a>) (value: a) : Unit =
    Stdlib.__Task.__wake (Stdlib.__Task.__scheduler context) (Stdlib.__Async.__resolve promise value)

// Compiler-inserted demands use the current task instead of changing the
// argument list of ordinary calls. Already-ready values need no task context.
let __forceCurrent<'a> (value: Stdlib.__Async.__Value<a>) : a =
    match Stdlib.__Async.__pollValue value with
    | Some result -> result
    | None -> Stdlib.__Task.__force (__fiber_current ()) value

let __joinCurrent<'a> (value: Stdlib.__Async.__Value<Stdlib.__Async.__Value<a>>) : Stdlib.__Async.__Value<a> =
    match Stdlib.__Async.__pollValue value with
    | Some inner -> inner
    | None -> Stdlib.__Async.__deferred (fun _unit -> Stdlib.__Task.__forceCurrent value)

let __now () : Int64 =
    match Stdlib.__Network.monotonicMillis () with
    | Ok value -> value
    | Error _ -> Builtin.crash "Native task clock failed"

let __completePromise<'a> (scheduler: RawPtr) (promise: Stdlib.__Async.__Promise<a>) (value: a) : Unit =
    Stdlib.__Task.__wake scheduler (Stdlib.__Async.__resolve promise value)

let __registerTimer (scheduler: RawPtr) (timer: Stdlib.__Task.__Timer) : Unit =
    let timers = __raw_get<List<Stdlib.__Task.__Timer>> scheduler (Stdlib.__Task.__TIMERS ()) in
    Stdlib.__Task.__set scheduler (Stdlib.__Task.__TIMERS ()) (Stdlib.List.push timers timer)

let __delay<'a> (context: RawPtr) (delay: Int64) (value: a) : Stdlib.__Async.__Value<a> =
    let now = Stdlib.__Task.__now () in
    if delay < 0L || now + delay < now then Builtin.crash "Invalid native task timer delay"
    else
        let scheduler = Stdlib.__Task.__scheduler context in
        let promise = Stdlib.__Async.__new<a> () in
        let timer = Stdlib.__Task.__Timer { deadline = now + delay; complete = (fun _unit -> Stdlib.__Task.__completePromise scheduler promise value) } in
        let _ = Stdlib.__Task.__registerTimer scheduler timer in
        Stdlib.__Async.__pending promise

let __delayCurrent<'a> (delay: Int64) (value: a) : Stdlib.__Async.__Value<a> =
    let context = __fiber_current () in
    if __rawptr_to_word context == 0L then Builtin.crash "Cannot start a timer outside a native task"
    else Stdlib.__Task.__delay context delay value

let __delayValueCurrent<'a> (delay: Int64) (value: Stdlib.__Async.__Value<a>) : Stdlib.__Async.__Value<a> =
    Stdlib.__Task.__joinCurrent (Stdlib.__Task.__delayCurrent delay value)

let __landTimers (now: Int64) (timers: List<Stdlib.__Task.__Timer>) (keep: List<Stdlib.__Task.__Timer>) : List<Stdlib.__Task.__Timer> =
    match timers with
    | [] -> Stdlib.List.reverse keep
    | timer :: tail ->
        if timer.deadline <= now then
            let _ = timer.complete () in
            Stdlib.__Task.__landTimers now tail keep
        else Stdlib.__Task.__landTimers now tail (Stdlib.List.push keep timer)

let __pollTimers (scheduler: RawPtr) : Unit =
    let timers = __raw_take<List<Stdlib.__Task.__Timer>> scheduler (Stdlib.__Task.__TIMERS ()) in
    let _ = __raw_write_word scheduler (Stdlib.__Task.__TIMERS ()) 0L in
    if Stdlib.List.isEmpty timers then ()
    else
        let keep = Stdlib.__Task.__landTimers (Stdlib.__Task.__now ()) timers [] in
        // Completion callbacks and managed-payload cleanup may register
        // another producer while this batch is detached.
        let registered = __raw_get<List<Stdlib.__Task.__Timer>> scheduler (Stdlib.__Task.__TIMERS ()) in
        Stdlib.__Task.__set scheduler (Stdlib.__Task.__TIMERS ()) (Stdlib.List.append keep registered)

let __earliest (timers: List<Stdlib.__Task.__Timer>) (earliest: Int64) : Int64 =
    match timers with
    | [] -> earliest
    | timer :: tail -> Stdlib.__Task.__earliest tail (if timer.deadline < earliest then timer.deadline else earliest)

// Registrations retain both the descriptor owner and the completion's promise.
// Discarding a consumer does not cancel an operation already registered here.
let __registerIO (scheduler: RawPtr) (entry: Stdlib.__Task.__IO) : Unit =
    let count = __raw_get<Int64> scheduler (Stdlib.__Task.__IO_COUNT ()) in
    let entries = __raw_get<List<Stdlib.__Task.__IO>> scheduler (Stdlib.__Task.__IO_QUEUE ()) in
    if count >= 1024L then entry.complete (Error 22L)
    else
        let _ = __raw_write_word scheduler (Stdlib.__Task.__IO_COUNT ()) (count + 1L) in
        Stdlib.__Task.__set scheduler (Stdlib.__Task.__IO_QUEUE ()) (Stdlib.List.append entries [entry])

let __completeIO (scheduler: RawPtr) (entry: Stdlib.__Task.__IO) (result: Stdlib.Result.Result<Stdlib.__Network.Ready, Int64>) : Unit =
    let count = __raw_get<Int64> scheduler (Stdlib.__Task.__IO_COUNT ()) in
    if count <= 0L then Builtin.crash "Invalid native readiness registration count"
    else
        let _ = __raw_write_word scheduler (Stdlib.__Task.__IO_COUNT ()) (count - 1L) in
        entry.complete result

let __watchCurrent (interest: Stdlib.__Network.Interest) : Stdlib.__Async.__Value<Stdlib.Result.Result<Stdlib.__Network.Ready, Int64>> =
    let context = __fiber_current () in
    if __rawptr_to_word context == 0L then Builtin.crash "Cannot watch a socket outside a native task"
    else
        let scheduler = Stdlib.__Task.__scheduler context in
        if interest.watch.descriptor < 0L || interest.watch.descriptor > 2147483647L then
            Stdlib.__Async.__ready (Error 22L)
        else
            let promise = Stdlib.__Async.__new<Stdlib.Result.Result<Stdlib.__Network.Ready, Int64>> () in
            let entry = Stdlib.__Task.__IO { interest = interest; complete = (fun result -> Stdlib.__Task.__wake scheduler (Stdlib.__Async.__resolve promise result)) } in
            let _ = Stdlib.__Task.__registerIO scheduler entry in
            Stdlib.__Async.__pending promise

// The initiating call attempts recv immediately. EAGAIN registers a producer,
// not a new task or a blocked native call. Readiness retries recv because an OS
// readiness event is advisory, and EOF is an ordinary empty Blob payload.
let __readTcpStart (scheduler: RawPtr) (connection: Stdlib.__Network.TcpConnection) (promise: Stdlib.__Async.__Promise<Stdlib.Result.Result<Blob, Int64>>) : Unit =
    match Stdlib.__Network.pollReadTcp connection with
    | Error code -> Stdlib.__Task.__completePromise scheduler promise (Error code)
    | Ok available ->
        match available with
        | Some bytes -> Stdlib.__Task.__completePromise scheduler promise (Ok bytes)
        | None ->
            match connection.watch with
            | None -> Stdlib.__Task.__completePromise scheduler promise (Error 22L)
            | Some watch ->
                let entry = Stdlib.__Task.__IO {
                    interest = Stdlib.__Network.Interest { watch = watch; readable = true; writable = false },
                    complete = (fun result ->
                        match result with
                        | Error code -> Stdlib.__Task.__completePromise scheduler promise (Error code)
                        | Ok _ -> Stdlib.__Task.__readTcpStart scheduler connection promise)
                } in
                Stdlib.__Task.__registerIO scheduler entry

let __readTcpCurrent (connection: Stdlib.__Network.TcpConnection) : Stdlib.__Async.__Value<Stdlib.Result.Result<Blob, Int64>> =
    let context = __fiber_current () in
    if __rawptr_to_word context == 0L then Builtin.crash "Cannot start a socket read outside a native task"
    else
        let promise = Stdlib.__Async.__new<Stdlib.Result.Result<Blob, Int64>> () in
        let _ = Stdlib.__Task.__readTcpStart (Stdlib.__Task.__scheduler context) connection promise in
        Stdlib.__Async.__pending promise

// Only operation boundaries allocate tasks. The entry and every ordinary call
// below it keep a normal native stack. Enter now, allowing the caller to resume
// once the operation parks, yields or finishes; do not wait for its result.
let __startCurrent<'a> (entry: Unit -> a) : Stdlib.__Async.__Value<a> =
    let context = __fiber_current () in
    if __rawptr_to_word context == 0L then Builtin.crash "Cannot start an operation outside a native task"
    else
        let scheduler = Stdlib.__Task.__scheduler context in
        let promise = Stdlib.__Async.__new<a> () in
        let task = Stdlib.__Task.__new scheduler (fun _context -> Stdlib.__Task.__completePromise scheduler promise (entry ())) in
        let tasks = __raw_get<List<Stdlib.__Task.__Task>> scheduler (Stdlib.__Task.__TASKS ()) in
        let parent = Stdlib.__Task.__find tasks (__rawptr_to_word context) in
        let _ = Stdlib.__Task.__set scheduler (Stdlib.__Task.__TASKS ()) (Stdlib.List.push tasks task) in
        let active = __raw_get<Int64> scheduler (Stdlib.__Task.__ACTIVE ()) in
        let _ = __raw_write_word scheduler (Stdlib.__Task.__ACTIVE ()) (active + 1L) in
        let _ = __raw_write_word context 64L 1L in
        let _ = Stdlib.__Task.__enqueue scheduler parent in
        let _ = __raw_write_word task.context 64L 2L in
        let _ = __fiber_switch context task.context in
        Stdlib.__Async.__pending promise

let __startValueCurrent<'a> (entry: Unit -> Stdlib.__Async.__Value<a>) : Stdlib.__Async.__Value<a> =
    Stdlib.__Task.__joinCurrent (Stdlib.__Task.__startCurrent entry)

let __landIO (scheduler: RawPtr) (entries: List<Stdlib.__Task.__IO>) (events: List<Stdlib.__Network.Ready>) (index: Int64) (keep: List<Stdlib.__Task.__IO>) : List<Stdlib.__Task.__IO> =
    match entries with
    | [] -> Stdlib.List.reverse keep
    | entry :: tail ->
        match events with
        | [] -> Stdlib.List.append (Stdlib.List.reverse keep) entries
        | event :: rest ->
            if event.index == index then
                let _ = Stdlib.__Task.__completeIO scheduler entry (Ok event) in
                Stdlib.__Task.__landIO scheduler tail rest (index + 1L) keep
            else Stdlib.__Task.__landIO scheduler tail events (index + 1L) (Stdlib.List.push keep entry)

let __failIO (scheduler: RawPtr) (entries: List<Stdlib.__Task.__IO>) (code: Int64) : Unit =
    match entries with
    | [] -> ()
    | entry :: tail ->
        let _ = Stdlib.__Task.__completeIO scheduler entry (Error code) in
        Stdlib.__Task.__failIO scheduler tail code

let __pollIO (scheduler: RawPtr) (milliseconds: Int64) : Unit =
    let entries = __raw_take<List<Stdlib.__Task.__IO>> scheduler (Stdlib.__Task.__IO_QUEUE ()) in
    let _ = __raw_write_word scheduler (Stdlib.__Task.__IO_QUEUE ()) 0L in
    if Stdlib.List.isEmpty entries then ()
    else
        let keep =
            match Stdlib.__Network.waitSockets (Stdlib.List.map entries (fun entry -> entry.interest)) milliseconds with
            | Ok events -> Stdlib.__Task.__landIO scheduler entries events 0L []
            | Error code ->
                if code == 4L then entries
                else let _ = Stdlib.__Task.__failIO scheduler entries code in [] in
        // Callbacks may register additional watches while this batch is detached.
        let registered = __raw_get<List<Stdlib.__Task.__IO>> scheduler (Stdlib.__Task.__IO_QUEUE ()) in
        Stdlib.__Task.__set scheduler (Stdlib.__Task.__IO_QUEUE ()) (Stdlib.List.append keep registered)

let __waitEvent (scheduler: RawPtr) : Unit =
    let timers = __raw_get<List<Stdlib.__Task.__Timer>> scheduler (Stdlib.__Task.__TIMERS ()) in
    let entries = __raw_get<List<Stdlib.__Task.__IO>> scheduler (Stdlib.__Task.__IO_QUEUE ()) in
    if Stdlib.List.isEmpty timers && Stdlib.List.isEmpty entries then Builtin.crash "Native tasks deadlocked without an event source"
    else
        let delay =
            match timers with
            | [] -> 60000L
            | head :: tail -> Stdlib.__Task.__earliest tail head.deadline - Stdlib.__Task.__now () in
        let delay = if delay < 0L then 0L else if delay > 60000L then 60000L else delay in
        if Stdlib.List.isEmpty entries then
            if delay > 0L then Stdlib.Cli.__sleep (Stdlib.Int64.toFloat delay) else ()
        else Stdlib.__Task.__pollIO scheduler delay

let __loop (scheduler: RawPtr) : Unit =
    let _ = Stdlib.__Task.__pollTimers scheduler in
    let _ = Stdlib.__Task.__pollIO scheduler 0L in
    match Stdlib.__Task.__dequeue scheduler with
    | None ->
        if __raw_get<Int64> scheduler (Stdlib.__Task.__ACTIVE ()) == 0L then
            if Stdlib.List.isEmpty (__raw_get<List<Stdlib.__Task.__Timer>> scheduler (Stdlib.__Task.__TIMERS ())) && Stdlib.List.isEmpty (__raw_get<List<Stdlib.__Task.__IO>> scheduler (Stdlib.__Task.__IO_QUEUE ())) then ()
            else
                let _ = Stdlib.__Task.__waitEvent scheduler in
                Stdlib.__Task.__loop scheduler
        else
            let _ = Stdlib.__Task.__waitEvent scheduler in
            Stdlib.__Task.__loop scheduler
    | Some task ->
        let _ = __raw_write_word task.context 64L 2L in
        let _ = __fiber_switch scheduler task.context in
        let returned = __raw_get<RawPtr> scheduler 40L in
        let tasks = __raw_get<List<Stdlib.__Task.__Task>> scheduler (Stdlib.__Task.__TASKS ()) in
        let task = Stdlib.__Task.__find tasks (__rawptr_to_word returned) in
        let state = Stdlib.__Task.__state task.context in
        if state == 4L then
            let active = __raw_get<Int64> scheduler (Stdlib.__Task.__ACTIVE ()) in
            if active <= 0L then Builtin.crash "Invalid native active task count"
            else
                let _ = __raw_write_word scheduler (Stdlib.__Task.__ACTIVE ()) (active - 1L) in
                Stdlib.__Task.__loop scheduler
        else if state == 3L then Stdlib.__Task.__loop scheduler
        else if state == 1L then
            let _ = Stdlib.__Task.__enqueue scheduler task in
            Stdlib.__Task.__loop scheduler
        else Builtin.crash "Invalid native task state after suspension"

let __disposeScheduler (scheduler: RawPtr) : Unit =
    let tasks = __raw_take<List<Stdlib.__Task.__Task>> scheduler (Stdlib.__Task.__TASKS ()) in
    let front = __raw_take<List<Stdlib.__Task.__Task>> scheduler (Stdlib.__Task.__FRONT ()) in
    let back = __raw_take<List<Stdlib.__Task.__Task>> scheduler (Stdlib.__Task.__BACK ()) in
    let timers = __raw_take<List<Stdlib.__Task.__Timer>> scheduler (Stdlib.__Task.__TIMERS ()) in
    let entries = __raw_take<List<Stdlib.__Task.__IO>> scheduler (Stdlib.__Task.__IO_QUEUE ()) in
    let _ = __raw_free scheduler in
    ()

// This explicit private scope drains its registered tasks and timer producers.
// It does not decide the lifetime policy of an automatically compiled program.
let __run (entries: List<RawPtr -> Unit>) : Unit =
    let previous = __fiber_current () in
    let scheduler = __raw_alloc 264L in
    let _ = __raw_write_word scheduler 56L 0L in
    let _ = __raw_slot_init<List<Stdlib.__Task.__Task>> scheduler (Stdlib.__Task.__TASKS ()) [] in
    let _ = __raw_slot_init<List<Stdlib.__Task.__Task>> scheduler (Stdlib.__Task.__FRONT ()) [] in
    let _ = __raw_slot_init<List<Stdlib.__Task.__Task>> scheduler (Stdlib.__Task.__BACK ()) [] in
    let _ = __raw_slot_init<List<Stdlib.__Task.__Timer>> scheduler (Stdlib.__Task.__TIMERS ()) [] in
    let _ = __raw_slot_init<List<Stdlib.__Task.__IO>> scheduler (Stdlib.__Task.__IO_QUEUE ()) [] in
    let _ = __raw_write_word scheduler (Stdlib.__Task.__IO_COUNT ()) 0L in
    let tasks = Stdlib.List.map entries (fun entry -> Stdlib.__Task.__new scheduler entry) in
    let _ = Stdlib.__Task.__set scheduler (Stdlib.__Task.__TASKS ()) tasks in
    let _ = Stdlib.__Task.__set scheduler (Stdlib.__Task.__FRONT ()) tasks in
    let _ = __raw_write_word scheduler (Stdlib.__Task.__ACTIVE ()) (Stdlib.List.__length tasks) in
    let _ = Stdlib.__Task.__loop scheduler in
    let _ = __fiber_set_current previous in
    Stdlib.__Task.__disposeScheduler scheduler

// Typed result ownership outlives the root's native stack. This explicit scope
// retains __run's drain policy; automatic CLI entry remains a separate boundary.
let __runMain<'a> (entry: Unit -> a) : a =
    let result = Stdlib.__Async.__new<a> () in
    let _ = Stdlib.__Task.__run [(fun context -> Stdlib.__Task.__resolve context result (entry ()))] in
    match Stdlib.__Async.__poll result with
    | Some value -> value
    | None -> Builtin.crash "Native task entry returned without a result"
