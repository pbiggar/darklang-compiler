// Stdlib.__RsaSpki.dark - strict DER rsaEncryption SubjectPublicKeyInfo parsing.

module Darklang.Stdlib.__RsaSpki

type PublicKey = { modulus: Blob, exponent: Blob }

let __lengthBytes (data: Blob) (index: Int64) (remaining: Int64)
                  (limit: Int64) (value: Int64) : Stdlib.Option.Option<(Int64 * Int64)> =
  if remaining == 0L then Some ((index, value))
  else if index >= limit || value > 1048576L then None
  else Stdlib.__RsaSpki.__lengthBytes data (index + 1L) (remaining - 1L)
         limit (value * 256L + Stdlib.Blob.__getByte data index)

// Returns the content start and exclusive end, bounded by the containing TLV.
let __tlv (data: Blob) (offset: Int64) (limit: Int64) (tag: Int64)
          : Stdlib.Option.Option<(Int64 * Int64)> =
  if offset < 0L || limit > Stdlib.Blob.__byteLength data
     || offset + 2L > limit || Stdlib.Blob.__getByte data offset != tag then None
  else
    let first = Stdlib.Blob.__getByte data (offset + 1L) in
    let parsed =
      if first < 128L then Some ((offset + 2L, first))
      else
        let count = first - 128L in
        if count == 0L || count > 4L || offset + 2L + count > limit
           || Stdlib.Blob.__getByte data (offset + 2L) == 0L then None
        else Stdlib.__RsaSpki.__lengthBytes data (offset + 2L) count limit 0L in
    match parsed with
    | None -> None
    | Some ((start, length)) ->
      if length < 0L || length > 1048576L || length > limit - start
         || (first >= 128L && length < 128L) then None
      else Some ((start, start + length))

let __algorithm (data: Blob) (start: Int64) (end_: Int64) : Bool =
  match Stdlib.__RsaSpki.__tlv data start end_ 6L with
  | None -> false
  | Some ((oidStart, oidEnd)) ->
    let oid = Stdlib.Blob.slice data (Stdlib.Int.fromInt64 oidStart)
                (Stdlib.Int.fromInt64 (oidEnd - oidStart)) in
    if Stdlib.Blob.toHex oid != "2A864886F70D010101" then false
    else
      match Stdlib.__RsaSpki.__tlv data oidEnd end_ 5L with
      | Some ((nullStart, nullEnd)) -> nullStart == nullEnd && nullEnd == end_
      | None -> false

let __positiveInteger (data: Blob) (offset: Int64) (limit: Int64)
                      : Stdlib.Option.Option<(Blob * Int64)> =
  match Stdlib.__RsaSpki.__tlv data offset limit 2L with
  | None -> None
  | Some ((start, end_)) ->
    if start == end_ then None
    else
      let first = Stdlib.Blob.__getByte data start in
      let contentStart =
        if first == 0L then
          if start + 1L == end_ || Stdlib.Blob.__getByte data (start + 1L) < 128L
          then -1L else start + 1L
        else if first >= 128L then -1L
        else start in
      if contentStart < 0L then None
      else Some ((Stdlib.Blob.slice data (Stdlib.Int.fromInt64 contentStart)
                    (Stdlib.Int.fromInt64 (end_ - contentStart)), end_))

let __rsaKey (data: Blob) (offset: Int64) (limit: Int64)
             : Stdlib.Option.Option<Stdlib.__RsaSpki.PublicKey> =
  match Stdlib.__RsaSpki.__tlv data offset limit 48L with
  | None -> None
  | Some ((start, end_)) ->
    if end_ != limit then None
    else
      match Stdlib.__RsaSpki.__positiveInteger data start end_ with
      | None -> None
      | Some ((modulus, exponentStart)) ->
        match Stdlib.__RsaSpki.__positiveInteger data exponentStart end_ with
        | None -> None
        | Some ((exponent, keyEnd)) ->
          let nLength = Stdlib.Blob.__byteLength modulus in
          let eLength = Stdlib.Blob.__byteLength exponent in
          if keyEnd != end_ || nLength < 256L || nLength > 1024L
             || Stdlib.Blob.__getByte modulus 0L < 128L
             || Stdlib.Blob.__getByte modulus (nLength - 1L) % 2L == 0L
             || eLength == 0L || eLength > 4L
             || Stdlib.Blob.__getByte exponent 0L == 0L
             || Stdlib.Blob.__getByte exponent (eLength - 1L) % 2L == 0L
             || (eLength == 1L && Stdlib.Blob.__getByte exponent 0L < 3L) then None
          else Some (Stdlib.__RsaSpki.PublicKey { modulus = modulus, exponent = exponent })

let parse (spki: Blob) : Stdlib.Result.Result<Stdlib.__RsaSpki.PublicKey, String> =
  let length = Stdlib.Blob.__byteLength spki in
  if length > 1100L then Error "Invalid RSA SubjectPublicKeyInfo"
  else
    match Stdlib.__RsaSpki.__tlv spki 0L length 48L with
    | None -> Error "Invalid RSA SubjectPublicKeyInfo"
    | Some ((start, end_)) ->
      if end_ != length then Error "Invalid RSA SubjectPublicKeyInfo"
      else
        match Stdlib.__RsaSpki.__tlv spki start end_ 48L with
        | None -> Error "Invalid RSA SubjectPublicKeyInfo"
        | Some ((algorithmStart, algorithmEnd)) ->
          if Stdlib.Bool.not (Stdlib.__RsaSpki.__algorithm spki algorithmStart algorithmEnd) then
            Error "Invalid RSA SubjectPublicKeyInfo"
          else
            match Stdlib.__RsaSpki.__tlv spki algorithmEnd end_ 3L with
            | None -> Error "Invalid RSA SubjectPublicKeyInfo"
            | Some ((bitStart, bitEnd)) ->
              if bitEnd != end_ || bitStart >= bitEnd
                 || Stdlib.Blob.__getByte spki bitStart != 0L then
                Error "Invalid RSA SubjectPublicKeyInfo"
              else
                match Stdlib.__RsaSpki.__rsaKey spki (bitStart + 1L) bitEnd with
                | None -> Error "Invalid RSA SubjectPublicKeyInfo"
                | Some key -> Ok key
