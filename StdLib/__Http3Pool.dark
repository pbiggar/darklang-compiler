// __Http3Pool.dark - Bounded persistent QUIC owners retaining connection-wide QPACK state.
module Darklang.Stdlib.__Http3Pool

type Entry = { origin: Stdlib.__HttpWire.Url, state: Stdlib.__Http3Connection.State, idle: Int64 }
type State = { entries: List<Stdlib.__Http3Pool.Entry> }
type Lease = { state: Stdlib.__Http3Pool.State, entry: Stdlib.Option.Option<Stdlib.__Http3Pool.Entry> }
type Completed = { response: Stdlib.HttpClient.Response, entry: Stdlib.Option.Option<Stdlib.__Http3Pool.Entry> }

val empty = Stdlib.__Http3Pool.State { entries = [] }

let __sameOrigin (left: Stdlib.__HttpWire.Url) (right: Stdlib.__HttpWire.Url) : Bool =
  left.scheme == right.scheme && left.host == right.host && left.port == right.port

let close (state: Stdlib.__Http3Pool.State) : Unit =
  Stdlib.List.fold state.entries () (fun _unit entry -> Stdlib.__Http3.close entry.state.wire)

let reusable (state: Stdlib.__Http3Connection.State) : Bool =
  // Bound final-size history without losing duplicate-frame validation.
  state.next < 4096L && Stdlib.Option.isNone state.wire.uni.control.goAway && Stdlib.Option.isNone state.wire.connection.meta.closed

let take (state: Stdlib.__Http3Pool.State) (origin: Stdlib.__HttpWire.Url) (now: Int64) : Stdlib.__Http3Pool.Lease =
  Stdlib.List.fold state.entries (Stdlib.__Http3Pool.Lease { state = Stdlib.__Http3Pool.empty, entry = None }) (fun lease entry ->
    if now < entry.idle || now - entry.idle >= 30000L || Stdlib.Bool.not (Stdlib.__Http3Pool.reusable entry.state) then
      let _ = Stdlib.__Http3.close entry.state.wire in lease
    else if Stdlib.__Http3Pool.__sameOrigin entry.origin origin then
      if Stdlib.Option.isSome lease.entry || Stdlib.Option.isNone (Stdlib.Stream.next entry.state.wire.connection.transport.socket.lifecycle) then
        let _ = Stdlib.__Http3.close entry.state.wire in lease
      else
        // Service received close/GOAWAY/decoder feedback before attempting a write.
        match Stdlib.__QuicConnection.poll entry.state.wire.connection 1L |> Stdlib.Result.andThen (fun connection -> Stdlib.__Http3.__controls { entry.state.wire with connection = connection }) with
        | Error _ -> let _ = Stdlib.__Http3.close entry.state.wire in lease
        | Ok state ->
          if Stdlib.__Http3Pool.reusable { entry.state with wire = state } then { lease with entry = Some { entry with state = { entry.state with wire = state } } }
          else let _ = Stdlib.__Http3.close state in lease
    else { lease with state = { lease.state with entries = lease.state.entries @ [entry] } })

let __retain (entries: List<Stdlib.__Http3Pool.Entry>) (count: Int64) : List<Stdlib.__Http3Pool.Entry> =
  match entries with
  | [] -> []
  | entry :: rest ->
    if count >= 8L then let _ = Stdlib.__Http3.close entry.state.wire in Stdlib.__Http3Pool.__retain rest count
    else Stdlib.List.push (Stdlib.__Http3Pool.__retain rest (count + 1L)) entry

let put (state: Stdlib.__Http3Pool.State) (entry: Stdlib.__Http3Pool.Entry) (now: Int64) : Stdlib.__Http3Pool.State =
  let remaining = Stdlib.List.filter state.entries (fun current ->
    if Stdlib.__Http3Pool.__sameOrigin entry.origin current.origin then let _ = Stdlib.__Http3.close current.state.wire in false else true) in
  Stdlib.__Http3Pool.State { entries = Stdlib.__Http3Pool.__retain (Stdlib.List.push remaining { entry with idle = now }) 0L }

let exchange (entry: Stdlib.__Http3Pool.Entry) (method: String) (url: Stdlib.__HttpWire.Url) (headers: List<(String * String)>) (body: Blob)
  : Stdlib.Result.Result<Stdlib.__Http3Pool.Completed, Stdlib.HttpClient.RequestError> =
  let result = Stdlib.__Http2Fields.requestFields method url headers body |> Stdlib.Result.andThen (fun fields ->
    Stdlib.__Http3Connection.requestMany entry.state [Stdlib.__Http3Connection.Request { method = method, fields = fields, body = body }]) in
  match result with
  | Error message ->
    // Failed I/O may have consumed a send nonce; abort instead of encrypted close or replay.
    let _ = Stdlib.__Http3.close entry.state.wire in
    Error (if Stdlib.String.contains message "timed out" then Stdlib.HttpClient.RequestError.Timeout else Stdlib.HttpClient.RequestError.NetworkError)
  | Ok batch ->
    match batch.responses with
    | [outcome] ->
      match outcome.response with
      | Error _ -> let _ = Stdlib.__Http3.close batch.state.wire in Error Stdlib.HttpClient.RequestError.NetworkError
      | Ok response ->
        if Stdlib.__Http3Pool.reusable batch.state then Ok (Stdlib.__Http3Pool.Completed { response = response, entry = Some { entry with state = batch.state } })
        else let _ = Stdlib.__Http3.close batch.state.wire in Ok (Stdlib.__Http3Pool.Completed { response = response, entry = None })
    | _ -> Builtin.crash "Singleton HTTP/3 exchange returned wrong response count"

let open (ready: Stdlib.__QuicClient.Ready) (method: String) (url: Stdlib.__HttpWire.Url) (headers: List<(String * String)>) (body: Blob)
  : Stdlib.Result.Result<Stdlib.__Http3Pool.Completed, Stdlib.HttpClient.RequestError> =
  match Stdlib.__Http3Connection.open ready with
  | Error _ -> let _ = Stdlib.__QuicClient.close ready in Error Stdlib.HttpClient.RequestError.NetworkError
  | Ok state -> Stdlib.__Http3Pool.exchange (Stdlib.__Http3Pool.Entry { origin = url, state = state, idle = 0L }) method url headers body
