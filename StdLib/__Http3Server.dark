// __Http3Server.dark - Single-request HTTP/3 serving with shared routing and bounded bodies.
module Darklang.Stdlib.__Http3Server

type Request = { state: Stdlib.__Http3.State, head: Stdlib.Option.Option<Stdlib.__Http2Fields.RequestHead>, chunks: List<Blob>, length: Int64, oversized: Bool }

let __events (request: Stdlib.__Http3Server.Request) (events: List<Stdlib.__Http3Message.Event>) (limit: Int64) : Stdlib.Result.Result<Stdlib.__Http3Server.Request, String> =
  match events with
  | [] -> Ok request
  | RequestHead head :: rest ->
    if Stdlib.Option.isSome request.head then Error "Duplicate HTTP/3 request head"
    else
      let oversized = match request.state.message.expected with | Some length -> length > limit | None -> false in
      Stdlib.__Http3Server.__events { request with head = Some head, oversized = oversized } rest limit
  | BodyChunk bytes :: rest ->
    let length = request.length + Stdlib.Blob.__byteLength bytes in
    let oversized = request.oversized || length > limit in
    let chunks = if oversized then [] else Stdlib.List.push request.chunks bytes in
    Stdlib.__Http3Server.__events { request with length = length, oversized = oversized, chunks = chunks } rest limit
  | TrailerFields _ :: rest -> Stdlib.__Http3Server.__events request rest limit
  | _ -> Error "Response event on HTTP/3 server request"

let __request (request: Stdlib.__Http3Server.Request) (limit: Int64) : Stdlib.Result.Result<Stdlib.__Http3Server.Request, String> =
  Stdlib.__Http3.receive request.state |> Stdlib.Result.andThen (fun received ->
    Stdlib.__Http3Server.__events { request with state = received.state } received.events limit |> Stdlib.Result.andThen (fun next ->
      if received.finished || next.oversized then
        if Stdlib.Option.isNone next.head then Error "HTTP/3 request finished without headers" else Ok next
      else Stdlib.__Http3Server.__request next limit))

let __write (state: Stdlib.__Http3.State) (bytes: Blob) (offset: Int64) : Stdlib.Result.Result<Stdlib.__Http3.State, String> =
  let length = Stdlib.Blob.__byteLength bytes in
  if offset == length then Stdlib.__Http3.write state Stdlib.Blob.empty true
  else
    let credit = Stdlib.__Http3.sendCredit state in
    if credit < 8L then Stdlib.__Http3.poll state |> Stdlib.Result.andThen (fun received -> Stdlib.__Http3Server.__write received.state bytes offset)
    else
      let size = if length - offset < credit - 8L then length - offset else credit - 8L in
      Stdlib.__Http3Wire.serialize 0L (Stdlib.__Http2Wire.__slice bytes offset size) |> Stdlib.Result.andThen (fun frame ->
        Stdlib.__Http3.write state frame false |> Stdlib.Result.andThen (fun next -> Stdlib.__Http3Server.__write next bytes (offset + size)))

let __respond (state: Stdlib.__Http3.State) (config: Stdlib.HttpServer.Config.Config) (method: String) (response: Stdlib.Http.Response) : Stdlib.Result.Result<Stdlib.__Http3.State, String> =
  match Stdlib.Int.toInt64 response.statusCode with
  | None -> Error "Invalid HTTP response status"
  | Some status ->
    if status < 200L || status > 599L then Error "Invalid HTTP response status"
    else
      let headers = Stdlib.List.filter (Stdlib.HttpServer.__standardHeaders config.injectStandardHeaders response.headers) (fun pair -> let (name, _) = pair in
        let lower = Stdlib.String.toLowercase name in
        Stdlib.Bool.not (Stdlib.__Http2Fields.__connectionSpecific lower) && lower != "content-length") in
      Stdlib.__Http2Fields.__outgoing headers |> Stdlib.Result.andThen (fun headers ->
        let length = if status == 204L then [] else [("content-length", Stdlib.Int64.toString (Stdlib.Blob.__byteLength response.body))] in
        let fields = [(":status", Stdlib.Int64.toString status)] @ headers @ length in
        let body = if method == "HEAD" || status == 204L || status == 304L then Stdlib.Blob.empty else response.body in
        Stdlib.__Http3Control.checkFields state.uni.control fields |> Stdlib.Result.andThen (fun _unit -> Stdlib.__Qpack.encode fields) |> Stdlib.Result.andThen (Stdlib.__Http3Wire.serialize 1L) |> Stdlib.Result.andThen (fun bytes ->
          // Only request stream zero is accepted in this sequential profile.
          Stdlib.__QuicWire.integer 4L |> Stdlib.Result.andThen (Stdlib.__Http3Wire.serialize 7L) |> Stdlib.Result.andThen (fun goaway ->
            Stdlib.__QuicConnection.write state.connection 3L goaway false |> Stdlib.Result.andThen (fun connection ->
              Stdlib.__Http3.write { state with connection = connection } bytes false |> Stdlib.Result.andThen (fun next -> Stdlib.__Http3Server.__write next body 0L)))))

let serve (ready: Stdlib.__QuicServer.Ready) (signals: Stdlib.__Network.ShutdownSignals) (config: Stdlib.HttpServer.Config.Config) (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (limit: Int64) : Stdlib.Result.Result<Stdlib.__Http3.State, String> =
  Stdlib.__Http3.initializeServer ready signals 10000L |> Stdlib.Result.andThen (fun state ->
    let request = Stdlib.__Http3Server.Request { state = state, head = None, chunks = [], length = 0L, oversized = false } in
    Stdlib.__Http3Server.__request request limit |> Stdlib.Result.andThen (fun request ->
      match request.head with
      | None -> Error "Missing HTTP/3 request headers"
      | Some head ->
        if request.oversized then
          Stdlib.__QuicApplication.streamLimit 5L 0L 268L |> Stdlib.Result.andThen (Stdlib.__QuicConnection.__queue request.state.connection) |> Stdlib.Result.andThen (fun connection ->
            Stdlib.__Http3Server.__respond { request.state with connection = connection } config head.method (Stdlib.Http.responseWithText "Request body too large" 413))
        else
          let response = if Stdlib.Bool.not (Stdlib.String.startsWith head.url "https://") then Stdlib.Http.badRequest "HTTP/3 requires an HTTPS URL" else handler (Stdlib.Http.Request { url = head.url, headers = Stdlib.List.push head.headers ("x-http-method", head.method), body = Stdlib.Blob.concat (Stdlib.List.reverse request.chunks) }) in
          Stdlib.__Http3Server.__respond request.state config head.method response))
