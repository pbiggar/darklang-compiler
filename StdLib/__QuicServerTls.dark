// __QuicServerTls.dark - QUIC server TLS keys and client transport binding gated by Finished.
module Darklang.Stdlib.__QuicServerTls

type Handshake = { flight: Stdlib.__Tls13ServerHandshake.Flight, send: Stdlib.__QuicCrypto.Keys, receive: Stdlib.__QuicCrypto.Keys, parameters: Stdlib.__QuicParameters.Parameters }
type Ready = { send: Stdlib.__QuicCrypto.Keys, receive: Stdlib.__QuicCrypto.Keys, sendSecret: Blob, receiveSecret: Blob, parameters: Stdlib.__QuicParameters.Parameters }

let __start (identity: Stdlib.TlsServerIdentity.Identity) (clientHello: Blob) (parameters: Blob) (clientSource: Blob) (retry: Stdlib.Option.Option<Stdlib.__Tls13ServerRetry.State>) : Stdlib.Result.Result<Stdlib.__QuicServerTls.Handshake, String> =
  Stdlib.__Tls13ServerHello.parse clientHello |> Stdlib.Result.andThen (fun hello ->
    Stdlib.__Tls13ServerHello.selectProtocol hello ["h3"] |> Stdlib.Result.andThen (fun protocol ->
      if protocol != "h3" then Error "QUIC TLS requires h3 ALPN"
      else match Stdlib.__Tls13ServerHello.__find hello.extensions 57L with
      | None -> Error "Missing QUIC client transport parameters"
      | Some client ->
        Stdlib.__QuicParameters.parseClient client clientSource |> Stdlib.Result.andThen (fun clientParameters ->
          Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Server parameters |> Stdlib.Result.andThen (fun _ ->
            let flight = match retry with
              | None -> Stdlib.__Tls13ServerHandshake.start identity clientHello ["h3"] (Some parameters)
              | Some retry -> Stdlib.__Tls13ServerHandshake.startAfterRetry identity retry clientHello ["h3"] (Some parameters) in
            flight |> Stdlib.Result.andThen (fun flight ->
              match Stdlib.__QuicCrypto.derive flight.secrets.handshakeServer, Stdlib.__QuicCrypto.derive flight.secrets.handshakeClient with
              | Ok send, Ok receive -> Ok (Stdlib.__QuicServerTls.Handshake { flight = flight, send = send, receive = receive, parameters = clientParameters })
              | _, _ -> Error "QUIC server handshake key derivation failed")))))

let start (identity: Stdlib.TlsServerIdentity.Identity) (clientHello: Blob) (parameters: Blob) (clientSource: Blob) : Stdlib.Result.Result<Stdlib.__QuicServerTls.Handshake, String> =
  Stdlib.__QuicServerTls.__start identity clientHello parameters clientSource None

let startAfterRetry (identity: Stdlib.TlsServerIdentity.Identity) (retry: Stdlib.__Tls13ServerRetry.State) (clientHello: Blob) (parameters: Blob) (clientSource: Blob) : Stdlib.Result.Result<Stdlib.__QuicServerTls.Handshake, String> =
  Stdlib.__QuicServerTls.__start identity clientHello parameters clientSource (Some retry)

let finish (handshake: Stdlib.__QuicServerTls.Handshake) (clientFinished: Blob) : Stdlib.Result.Result<Stdlib.__QuicServerTls.Ready, String> =
  Stdlib.__Tls13ServerHandshake.finish handshake.flight clientFinished |> Stdlib.Result.andThen (fun ready ->
    match Stdlib.__QuicCrypto.derive ready.sendSecret, Stdlib.__QuicCrypto.derive ready.receiveSecret with
    | Ok send, Ok receive -> Ok (Stdlib.__QuicServerTls.Ready { send = send, receive = receive, sendSecret = ready.sendSecret, receiveSecret = ready.receiveSecret, parameters = handshake.parameters })
    | _, _ -> Error "QUIC server application key derivation failed")
