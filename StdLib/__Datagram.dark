// __Datagram.dark - Owned, bounded UDP sockets preserving message and peer boundaries.
module Darklang.Stdlib.__Datagram

type Endpoint = { address: List<Int64>, port: Int64 }
type Message = { peer: Stdlib.__Datagram.Endpoint, payload: Blob }
type Socket = {
  lifecycle: Stream<Unit>,
  send: Stdlib.__Datagram.Endpoint -> Blob -> Int64 -> Stdlib.Result.Result<Unit, Int64>,
  receive: Int64 -> Stdlib.Result.Result<Stdlib.__Datagram.Message, Int64>
}

let __send (fd: Int64) (ipv6: Bool) (lifecycle: Stream<Unit>)
  (peer: Stdlib.__Datagram.Endpoint) (payload: Blob) (timeoutMs: Int64)
  : Stdlib.Result.Result<Unit, Int64> =
  match Stdlib.Stream.next lifecycle with
  | None -> Error 9L
  | Some _ ->
    if Stdlib.Bool.not (Stdlib.__Network.__validAddress ipv6 peer.address) ||
       peer.port <= 0L || peer.port > 65535L || timeoutMs <= 0L || timeoutMs > 10000L then Error 22L
    else if Stdlib.Blob.__byteLength payload > 4096L then Error 90L
    else
      match Stdlib.__Network.__setTimeout fd timeoutMs with
      | Error code -> Error code
      | Ok () ->
        let address = Stdlib.__Network.__socketAddress ipv6 peer.address peer.port in
        let sent = Stdlib.__Network.__sendTo fd payload address (if ipv6 then 28L else 16L) in
        let _ = __raw_free address in
        if sent < 0L then Error (0L - sent)
        else if sent != Stdlib.Blob.__byteLength payload then Error 90L
        else Ok ()

let __addressBytes (ptr: RawPtr) (index: Int64) (remaining: Int64) (acc: List<Int64>) : List<Int64> =
  if remaining == 0L then Stdlib.List.reverse acc
  else Stdlib.__Datagram.__addressBytes ptr (index + 1L) (remaining - 1L) (Stdlib.List.push acc (__raw_get_byte ptr index))

let __decode (ipv6: Bool) (peer: RawPtr) (buffer: RawPtr) (size: Int64)
  : Stdlib.Result.Result<Stdlib.__Datagram.Message, Int64> =
  let darwin = Stdlib.Cli.__hostOSCode () == 2L in
  let family = __raw_get_byte peer (if darwin then 9L else 8L) in
  if __raw_get<Int64> peer 0L != (if ipv6 then 28L else 16L) ||
     family != (if ipv6 then (if darwin then 30L else 10L) else 2L) then Error 22L
  else
    let address = Stdlib.__Datagram.__addressBytes peer (if ipv6 then 16L else 12L) (if ipv6 then 16L else 4L) [] in
    let port = (__raw_get_byte peer 10L) * 256L + __raw_get_byte peer 11L in
    let payload = Stdlib.__Network.__copyReceived buffer 0L size [] in
    Ok (Stdlib.__Datagram.Message { peer = Stdlib.__Datagram.Endpoint { address = address, port = port }, payload = payload })

let __receive (fd: Int64) (ipv6: Bool) (lifecycle: Stream<Unit>) (timeoutMs: Int64)
  : Stdlib.Result.Result<Stdlib.__Datagram.Message, Int64> =
  match Stdlib.Stream.next lifecycle with
  | None -> Error 9L
  | Some _ ->
    if timeoutMs <= 0L || timeoutMs > 10000L then Error 22L
    else
      match Stdlib.__Network.__setTimeout fd timeoutMs with
      | Error code -> Error code
      | Ok () ->
        let buffer = __raw_alloc 4097L in
        let peer = __raw_alloc 40L in
        let _ = __raw_write_word peer 0L (if ipv6 then 28L else 16L) in
        let _ = __raw_write_word peer 8L 0L in
        let _ = __raw_write_word peer 16L 0L in
        let _ = __raw_write_word peer 24L 0L in
        let _ = __raw_write_word peer 32L 0L in
        let received = Stdlib.__Network.__receiveFrom fd buffer 4097L peer in
        let result =
          if received < 0L then Error (0L - received)
          else if received > 4096L then Error 90L
          else Stdlib.__Datagram.__decode ipv6 peer buffer received in
        let _ = __raw_free peer in
        let _ = __raw_free buffer in
        result

let __bind (ipv6: Bool) (address: List<Int64>) (port: Int64)
  : Stdlib.Result.Result<Stdlib.__Datagram.Socket, Int64> =
  if Stdlib.Bool.not (Stdlib.__Network.__validAddress ipv6 address) || port < 0L || port > 65535L then Error 22L
  else
    let fd = if ipv6 then Stdlib.__Network.__udp6Socket () else Stdlib.__Network.__udp4Socket () in
    if fd < 0L then Error (0L - fd)
    else
      let lifecycle = Stdlib.Stream.__new (fun _unit -> Some ()) (fun _unit -> let _ = Stdlib.__Network.__close fd in ()) in
      let address = Stdlib.__Network.__socketAddress ipv6 address port in
      let marked = Stdlib.__Network.__cloexec fd in
      let bound = if marked < 0L then marked else if ipv6 then Stdlib.__Network.__bind6 fd address else Stdlib.__Network.__bind4 fd address in
      let _ = __raw_free address in
      if bound < 0L then
        let _ = Stdlib.Stream.close lifecycle in
        Error (0L - bound)
      else Ok (Stdlib.__Datagram.Socket {
        lifecycle = lifecycle,
        send = fun peer payload timeoutMs -> Stdlib.__Datagram.__send fd ipv6 lifecycle peer payload timeoutMs,
        receive = fun timeoutMs -> Stdlib.__Datagram.__receive fd ipv6 lifecycle timeoutMs })

let bind4 (address: List<Int64>) (port: Int64) : Stdlib.Result.Result<Stdlib.__Datagram.Socket, Int64> =
  Stdlib.__Datagram.__bind false address port

let bind6 (address: List<Int64>) (port: Int64) : Stdlib.Result.Result<Stdlib.__Datagram.Socket, Int64> =
  Stdlib.__Datagram.__bind true address port

let close (socket: Stdlib.__Datagram.Socket) : Unit =
  Stdlib.Stream.close socket.lifecycle

let send (socket: Stdlib.__Datagram.Socket) (peer: Stdlib.__Datagram.Endpoint) (payload: Blob) (timeoutMs: Int64)
  : Stdlib.Result.Result<Unit, Int64> =
  socket.send peer payload timeoutMs

let receive (socket: Stdlib.__Datagram.Socket) (timeoutMs: Int64)
  : Stdlib.Result.Result<Stdlib.__Datagram.Message, Int64> =
  socket.receive timeoutMs
