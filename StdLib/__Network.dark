// __Network.dark - Owned native TCP/UDP sockets, listeners, deadlines, and scoped shutdown signals.

module Darklang.Stdlib.__Network

// The Stream handle supplies shared, idempotent close and closes on last-owner
// release. The descriptor stays captured by its disposer, outside user values.
type Socket = { lifecycle: Stream<Unit> }

type UdpSocket = {
    lifecycle: Stream<Unit>,
    exchange4: List<Int64> -> Int64 -> Blob -> Int64 -> Stdlib.Result.Result<Blob, Int64>
}
type Udp6Socket = {
    lifecycle: Stream<Unit>,
    exchange6: List<Int64> -> Int64 -> Blob -> Int64 -> Stdlib.Result.Result<Blob, Int64>
}

type TcpConnection = {
    lifecycle: Stream<Unit>,
    read: Int64 -> Stdlib.Result.Result<Blob, Int64>,
    write: Blob -> Stdlib.Result.Result<Unit, Int64>
}

// Replaced by target-specific syscalls during native lowering. The fallback
// lets stdlib preparation typecheck without opening a socket.
let __tcp4Socket () : Int64 = -38L
let __udp4Socket () : Int64 = -38L
let __udp6Socket () : Int64 = -38L
let __tcp6Socket () : Int64 = -38L
let __connect4 (descriptor: Int64) (address: RawPtr) : Int64 = -38L
let __connect6 (descriptor: Int64) (address: RawPtr) : Int64 = -38L
let __send (descriptor: Int64) (payload: Blob) : Int64 = -38L
let __sendTo (descriptor: Int64) (payload: Blob) (address: RawPtr) (addressLength: Int64) : Int64 = -38L
// Peer storage holds a socklen word followed by the sockaddr at offset eight.
let __receiveFrom (descriptor: Int64) (buffer: RawPtr) (length: Int64) (peer: RawPtr) : Int64 = -38L
let __bind6 (descriptor: Int64) (address: RawPtr) : Int64 = -38L
let __receive (descriptor: Int64) (buffer: RawPtr) (length: Int64) : Int64 = -38L
let __receiveTimeout (descriptor: Int64) (timeval: RawPtr) : Int64 = -38L
let __sendTimeout (descriptor: Int64) (timeval: RawPtr) : Int64 = -38L
let __close (descriptor: Int64) : Int64 = -38L
let __bind4 (descriptor: Int64) (address: RawPtr) : Int64 = -38L
let __listen (descriptor: Int64) : Int64 = -38L
let __accept (descriptor: Int64) : Int64 = -38L
let __cloexec (descriptor: Int64) : Int64 = -38L
let __reuseAddress (descriptor: Int64) (enabled: RawPtr) : Int64 = -38L
let __poll (pollfd: RawPtr) (timeout: RawPtr) : Int64 = -38L
let __signalBlock (mask: RawPtr) (previous: RawPtr) : Int64 = -38L
let __signalRestore (previous: RawPtr) : Int64 = -38L
let __signalPending (mask: RawPtr) : Int64 = -38L
let __signalWait (mask: RawPtr) (info: RawPtr) : Int64 = -38L
let __monotonic (time: RawPtr) : Int64 = -38L

let openTcp4 () : Stdlib.Result.Result<Stdlib.__Network.Socket, Int64> =
    let descriptor = Stdlib.__Network.__tcp4Socket () in
    if descriptor < 0L then Error (0L - descriptor)
    else
        let lifecycle =
            Stdlib.Stream.__new
                (fun _unit -> None)
                (fun _unit -> let _ = Stdlib.__Network.__close descriptor in ()) in
        Ok (Stdlib.__Network.Socket { lifecycle = lifecycle })

let close (socket: Stdlib.__Network.Socket) : Unit =
    Stdlib.Stream.close socket.lifecycle

let __validBytes (bytes: List<Int64>) : Bool =
    match bytes with
    | [] -> true
    | byte :: rest ->
        byte >= 0L && byte <= 255L && Stdlib.__Network.__validBytes rest

let __validAddress (ipv6: Bool) (bytes: List<Int64>) : Bool =
    Stdlib.List.length bytes == (if ipv6 then 16 else 4) &&
    Stdlib.__Network.__validBytes bytes

let __writeAddress (ptr: RawPtr) (bytes: List<Int64>) (offset: Int64) : Unit =
    match bytes with
    | [] -> ()
    | byte :: rest ->
        let _ = __raw_write_byte ptr offset byte in
        Stdlib.__Network.__writeAddress ptr rest (offset + 1L)

let __copyReceived (ptr: RawPtr) (index: Int64) (length: Int64) (acc: List<Int64>) : Blob =
    if index >= length then Stdlib.Blob.__fromInt64List (Stdlib.List.reverse acc)
    else
        Stdlib.__Network.__copyReceived ptr (index + 1L) length
            (Stdlib.List.push acc (__raw_get_byte ptr index))

let __socketAddress (ipv6: Bool) (address: List<Int64>) (port: Int64) : RawPtr =
    let ptr = __raw_alloc (if ipv6 then 32L else 16L) in
    let _ = __raw_write_word ptr 0L 0L in
    let _ = __raw_write_word ptr 8L 0L in
    let _ = if ipv6 then __raw_write_word ptr 16L 0L else () in
    let _ = if ipv6 then __raw_write_word ptr 24L 0L else () in
    let _ =
        if Stdlib.Cli.__hostOSCode () == 2L then
            let _ = __raw_write_byte ptr 0L (if ipv6 then 28L else 16L) in
            __raw_write_byte ptr 1L (if ipv6 then 30L else 2L)
        else __raw_write_byte ptr 0L (if ipv6 then 10L else 2L) in
    let _ = __raw_write_byte ptr 2L (port / 256L) in
    let _ = __raw_write_byte ptr 3L (port % 256L) in
    let _ = Stdlib.__Network.__writeAddress ptr address (if ipv6 then 8L else 4L) in
    ptr

let __setTimeout (descriptor: Int64) (timeoutMs: Int64) : Stdlib.Result.Result<Unit, Int64> =
    let timeval = __raw_alloc 16L in
    let _ = __raw_write_word timeval 0L (timeoutMs / 1000L) in
    let _ = __raw_write_word timeval 8L ((timeoutMs % 1000L) * 1000L) in
    let receiveResult = Stdlib.__Network.__receiveTimeout descriptor timeval in
    let sendResult =
        if receiveResult < 0L then receiveResult
        else Stdlib.__Network.__sendTimeout descriptor timeval in
    let _ = __raw_free timeval in
    if sendResult < 0L then Error (0L - sendResult) else Ok ()

let __writeAll (descriptor: Int64) (lifecycle: Stream<Unit>) (payload: Blob) : Stdlib.Result.Result<Unit, Int64> =
    match Stdlib.Stream.next lifecycle with
    | None -> Error 9L
    | Some _ ->
        let length = Stdlib.Blob.__byteLength payload in
        if length == 0L then Ok ()
        else
            let sent = Stdlib.__Network.__send descriptor payload in
            if sent < 0L then Error (0L - sent)
            else if sent == 0L then Error 32L
            else if sent >= length then Ok ()
            else
                let remaining = Stdlib.Blob.slice payload (Stdlib.Int.fromInt64 sent)
                                    (Stdlib.Int.fromInt64 (length - sent)) in
                Stdlib.__Network.__writeAll descriptor lifecycle remaining

let __readChunk (descriptor: Int64) (lifecycle: Stream<Unit>) (length: Int64) : Stdlib.Result.Result<Blob, Int64> =
    if length <= 0L || length > 4096L then Error 22L
    else
        match Stdlib.Stream.next lifecycle with
        | None -> Error 9L
        | Some _ ->
            let buffer = __raw_alloc length in
            let received = Stdlib.__Network.__receive descriptor buffer length in
            let result =
                if received < 0L then Error (0L - received)
                else Ok (Stdlib.__Network.__copyReceived buffer 0L received []) in
            let _ = __raw_free buffer in
            result

let __connectTcp (ipv6: Bool) (address: List<Int64>) (port: Int64) (timeoutMs: Int64)
    : Stdlib.Result.Result<Stdlib.__Network.TcpConnection, Int64> =
    if Stdlib.Bool.not (Stdlib.__Network.__validAddress ipv6 address) ||
        port <= 0L || port > 65535L || timeoutMs <= 0L || timeoutMs > 10000L then Error 22L
    else
        let descriptor = if ipv6 then Stdlib.__Network.__tcp6Socket () else Stdlib.__Network.__tcp4Socket () in
        if descriptor < 0L then Error (0L - descriptor)
        else
            let lifecycle =
                Stdlib.Stream.__new
                    (fun _unit -> Some ())
                    (fun _unit -> let _ = Stdlib.__Network.__close descriptor in ()) in
            match Stdlib.__Network.__setTimeout descriptor timeoutMs with
            | Error code ->
                let _ = Stdlib.Stream.close lifecycle in
                Error code
            | Ok () ->
                let sockaddr = Stdlib.__Network.__socketAddress ipv6 address port in
                let connected =
                    if ipv6 then Stdlib.__Network.__connect6 descriptor sockaddr
                    else Stdlib.__Network.__connect4 descriptor sockaddr in
                let _ = __raw_free sockaddr in
                if connected < 0L then
                    let _ = Stdlib.Stream.close lifecycle in
                    Error (0L - connected)
                else
                    let read = Stdlib.__Network.__readChunk descriptor lifecycle in
                    let write = Stdlib.__Network.__writeAll descriptor lifecycle in
                    Ok (Stdlib.__Network.TcpConnection { lifecycle = lifecycle, read = read, write = write })

let connectTcp4 (address: List<Int64>) (port: Int64) (timeoutMs: Int64) : Stdlib.Result.Result<Stdlib.__Network.TcpConnection, Int64> =
    Stdlib.__Network.__connectTcp false address port timeoutMs

let connectTcp6 (address: List<Int64>) (port: Int64) (timeoutMs: Int64) : Stdlib.Result.Result<Stdlib.__Network.TcpConnection, Int64> =
    Stdlib.__Network.__connectTcp true address port timeoutMs

let closeTcp (connection: Stdlib.__Network.TcpConnection) : Unit =
    Stdlib.Stream.close connection.lifecycle

let writeTcp (connection: Stdlib.__Network.TcpConnection) (payload: Blob) : Stdlib.Result.Result<Unit, Int64> =
    connection.write payload

let readTcp (connection: Stdlib.__Network.TcpConnection) (length: Int64) : Stdlib.Result.Result<Blob, Int64> =
    connection.read length

let __word (buffer: RawPtr) (offset: Int64) : Int64 = __raw_get buffer offset

let monotonicMillis () : Stdlib.Result.Result<Int64, Int64> =
    let buffer = __raw_alloc 16L in
    let code = Stdlib.__Network.__monotonic buffer in
    let result =
        if code < 0L then Error (0L - code)
        else
            let seconds = Stdlib.__Network.__word buffer 0L in
            let nanos = Stdlib.__Network.__word buffer 8L in
            Ok (seconds * 1000L + nanos / 1000000L) in
    let _ = __raw_free buffer in
    result

// Signal masks belong to the serving scope and are restored on its last-owner
// release. Blocking rather than an async handler keeps shutdown state in Dark.
type ShutdownSignals = { lifecycle: Stream<Unit> }

let shutdownSignals () : Stdlib.Result.Result<Stdlib.__Network.ShutdownSignals, Int64> =
    let mask = __raw_alloc 8L in
    let previous = __raw_alloc 8L in
    let _ = __raw_write_word mask 0L 16386L in
    let _ = __raw_write_word previous 0L 0L in
    let code = Stdlib.__Network.__signalBlock mask previous in
    let _ = __raw_free mask in
    if code < 0L then
        let _ = __raw_free previous in
        Error (0L - code)
    else
        let lifecycle = Stdlib.Stream.__new (fun _ -> Some ()) (fun _ -> let _ = Stdlib.__Network.__consumeShutdown false in let _ = Stdlib.__Network.__signalRestore previous in __raw_free previous) in
        Ok (Stdlib.__Network.ShutdownSignals { lifecycle = lifecycle })

let __consumeShutdown (seen: Bool) : Stdlib.Result.Result<Bool, Int64> =
    let mask = __raw_alloc 8L in
    let _ = __raw_write_word mask 0L 0L in
    let code = Stdlib.__Network.__signalPending mask in
    let pending = Stdlib.__Network.__word mask 0L in
    let _ = __raw_write_word mask 0L 16386L in
    if code < 0L then
        let _ = __raw_free mask in
        Error (0L - code)
    else if Stdlib.Int64.bitwiseAnd pending 16386L == 0L then
        let _ = __raw_free mask in
        Ok seen
    else
        let info = __raw_alloc 128L in
        let waited = Stdlib.__Network.__signalWait mask info in
        let _ = __raw_free info in
        let _ = __raw_free mask in
        if waited < 0L then Error (0L - waited)
        else Stdlib.__Network.__consumeShutdown true

let shutdownRequested (signals: Stdlib.__Network.ShutdownSignals) : Stdlib.Result.Result<Bool, Int64> =
    match Stdlib.Stream.next signals.lifecycle with
    | None -> Error 9L
    | Some _ -> Stdlib.__Network.__consumeShutdown false

let closeShutdownSignals (signals: Stdlib.__Network.ShutdownSignals) : Unit =
    Stdlib.Stream.close signals.lifecycle

type TcpListener = {
    lifecycle: Stream<Unit>,
    accept: Int64 -> Stdlib.Result.Result<Stdlib.__Network.TcpConnection, Int64>,
    wait: Unit -> Stdlib.Result.Result<Bool, Int64>
}

let __waitReadable (descriptor: Int64) (lifecycle: Stream<Unit>) : Stdlib.Result.Result<Bool, Int64> =
    match Stdlib.Stream.next lifecycle with
    | None -> Error 9L
    | Some _ ->
        let pollfd = __raw_alloc 8L in
        let timeout = __raw_alloc 16L in
        let _ = __raw_write_word pollfd 0L (descriptor + 4294967296L) in
        let _ = __raw_write_word timeout 0L 0L in
        let _ = __raw_write_word timeout 8L 100000000L in
        let code = Stdlib.__Network.__poll pollfd timeout in
        let events = Stdlib.__Network.__word pollfd 0L in
        let _ = __raw_free pollfd in
        let _ = __raw_free timeout in
        if code < 0L then Error (0L - code)
        else if code == 0L then Ok false
        else if Stdlib.Int64.bitwiseAnd (Stdlib.Int64.shiftRight events 48L) 1L == 1L then Ok true
        else Error 9L

let __writeUntil (descriptor: Int64) (lifecycle: Stream<Unit>) (deadline: Int64) (payload: Blob)
    : Stdlib.Result.Result<Unit, Int64> =
    match Stdlib.Stream.next lifecycle with
    | None -> Error 9L
    | Some _ ->
        match Stdlib.__Network.monotonicMillis () with
        | Error code -> Error code
        | Ok now ->
            if now >= deadline then Error 110L
            else if Stdlib.Blob.__byteLength payload == 0L then Ok ()
            else
                let sent = Stdlib.__Network.__send descriptor payload in
                if sent == -4L || sent == -11L || sent == -35L then
                    Stdlib.__Network.__writeUntil descriptor lifecycle deadline payload
                else if sent < 0L then Error (0L - sent)
                else if sent == 0L then Error 32L
                else if sent >= Stdlib.Blob.__byteLength payload then Ok ()
                else
                    let remaining = Stdlib.Blob.slice payload (Stdlib.Int.fromInt64 sent) (Stdlib.Int.fromInt64 (Stdlib.Blob.__byteLength payload - sent)) in
                    Stdlib.__Network.__writeUntil descriptor lifecycle deadline remaining

let __writeAccepted (descriptor: Int64) (lifecycle: Stream<Unit>) (payload: Blob)
    : Stdlib.Result.Result<Unit, Int64> =
    match Stdlib.__Network.monotonicMillis () with
    | Error code -> Error code
    | Ok now -> Stdlib.__Network.__writeUntil descriptor lifecycle (now + 10000L) payload

let __acceptTcp (descriptor: Int64) (lifecycle: Stream<Unit>) (timeoutMs: Int64)
    : Stdlib.Result.Result<Stdlib.__Network.TcpConnection, Int64> =
    if timeoutMs <= 0L || timeoutMs > 10000L then Error 22L
    else
        match Stdlib.Stream.next lifecycle with
        | None -> Error 9L
        | Some _ ->
            match Stdlib.__Network.__setTimeout descriptor timeoutMs with
            | Error code -> Error code
            | Ok () ->
                let accepted = Stdlib.__Network.__accept descriptor in
                if accepted < 0L then Error (0L - accepted)
                else
                    let owner = Stdlib.Stream.__new (fun _ -> Some ()) (fun _ -> let _ = Stdlib.__Network.__close accepted in ()) in
                    let flags = Stdlib.__Network.__cloexec accepted in
                    let setup =
                        if flags < 0L then Error (0L - flags)
                        else Stdlib.__Network.__setTimeout accepted timeoutMs in
                    match setup with
                    | Error code -> let _ = Stdlib.Stream.close owner in Error code
                    | Ok () -> Ok (Stdlib.__Network.TcpConnection {
                        lifecycle = owner,
                        read = Stdlib.__Network.__readChunk accepted owner,
                        write = Stdlib.__Network.__writeAccepted accepted owner
                    })

let listenTcp4 (address: List<Int64>) (port: Int64) : Stdlib.Result.Result<Stdlib.__Network.TcpListener, Int64> =
    if Stdlib.Bool.not (Stdlib.__Network.__validAddress false address) || port < 0L || port > 65535L then Error 22L
    else
        let descriptor = Stdlib.__Network.__tcp4Socket () in
        if descriptor < 0L then Error (0L - descriptor)
        else
            let lifecycle = Stdlib.Stream.__new (fun _ -> Some ()) (fun _ -> let _ = Stdlib.__Network.__close descriptor in ()) in
            let enabled = __raw_alloc 8L in
            let _ = __raw_write_word enabled 0L 1L in
            let reused = Stdlib.__Network.__reuseAddress descriptor enabled in
            let _ = __raw_free enabled in
            let sockaddr = Stdlib.__Network.__socketAddress false address port in
            let bound = if reused < 0L then reused else Stdlib.__Network.__bind4 descriptor sockaddr in
            let _ = __raw_free sockaddr in
            let listening = if bound < 0L then bound else Stdlib.__Network.__listen descriptor in
            if listening < 0L then
                let _ = Stdlib.Stream.close lifecycle in
                Error (0L - listening)
            else Ok (Stdlib.__Network.TcpListener {
                lifecycle = lifecycle,
                accept = Stdlib.__Network.__acceptTcp descriptor lifecycle,
                wait = fun _ -> Stdlib.__Network.__waitReadable descriptor lifecycle
            })

let acceptTcp (listener: Stdlib.__Network.TcpListener) (timeoutMs: Int64)
    : Stdlib.Result.Result<Stdlib.__Network.TcpConnection, Int64> = listener.accept timeoutMs

let waitListener (listener: Stdlib.__Network.TcpListener) : Stdlib.Result.Result<Bool, Int64> = listener.wait ()

let closeListener (listener: Stdlib.__Network.TcpListener) : Unit = Stdlib.Stream.close listener.lifecycle

let __udpExchange (descriptor: Int64) (lifecycle: Stream<Unit>) (ipv6: Bool)
    (address: List<Int64>) (port: Int64) (payload: Blob) (timeoutMs: Int64)
    : Stdlib.Result.Result<Blob, Int64> =
    if Stdlib.Bool.not (Stdlib.__Network.__validAddress ipv6 address) ||
        port <= 0L || port > 65535L || timeoutMs <= 0L || timeoutMs > 10000L then Error 22L
    else if Stdlib.Blob.__byteLength payload == 0L || Stdlib.Blob.__byteLength payload > 4096L then Error 90L
    else
        match Stdlib.Stream.next lifecycle with
        | None -> Error 9L
        | Some _ ->
            let sockaddr = Stdlib.__Network.__socketAddress ipv6 address port in
            let connected =
                if ipv6 then Stdlib.__Network.__connect6 descriptor sockaddr
                else Stdlib.__Network.__connect4 descriptor sockaddr in
            let _ = __raw_free sockaddr in
            if connected < 0L then Error (0L - connected)
            else
                let timeval = __raw_alloc 16L in
                let _ = __raw_write_word timeval 0L (timeoutMs / 1000L) in
                let _ = __raw_write_word timeval 8L ((timeoutMs % 1000L) * 1000L) in
                let timed = Stdlib.__Network.__receiveTimeout descriptor timeval in
                let _ = __raw_free timeval in
                if timed < 0L then Error (0L - timed)
                else
                    let sent = Stdlib.__Network.__send descriptor payload in
                    if sent < 0L then Error (0L - sent)
                    else if sent != Stdlib.Blob.__byteLength payload then Error 90L
                    else
                        let buffer = __raw_alloc 4097L in
                        let received = Stdlib.__Network.__receive descriptor buffer 4097L in
                        let result =
                            if received < 0L then Error (0L - received)
                            else if received > 4096L then Error 90L
                            else Ok (Stdlib.__Network.__copyReceived buffer 0L received []) in
                        let _ = __raw_free buffer in
                        result

let openUdp4 () : Stdlib.Result.Result<Stdlib.__Network.UdpSocket, Int64> =
    let descriptor = Stdlib.__Network.__udp4Socket () in
    if descriptor < 0L then Error (0L - descriptor)
    else
        let lifecycle =
            Stdlib.Stream.__new
                (fun _unit -> Some ())
                (fun _unit -> let _ = Stdlib.__Network.__close descriptor in ()) in
        let exchange4 = Stdlib.__Network.__udpExchange descriptor lifecycle false in
        Ok (Stdlib.__Network.UdpSocket { lifecycle = lifecycle, exchange4 = exchange4 })

let closeUdp (socket: Stdlib.__Network.UdpSocket) : Unit =
    Stdlib.Stream.close socket.lifecycle

let exchangeUdp4 (socket: Stdlib.__Network.UdpSocket) (address: List<Int64>) (port: Int64)
    (payload: Blob) (timeoutMs: Int64) : Stdlib.Result.Result<Blob, Int64> =
    socket.exchange4 address port payload timeoutMs

let openUdp6 () : Stdlib.Result.Result<Stdlib.__Network.Udp6Socket, Int64> =
    let descriptor = Stdlib.__Network.__udp6Socket () in
    if descriptor < 0L then Error (0L - descriptor)
    else
        let lifecycle =
            Stdlib.Stream.__new
                (fun _unit -> Some ())
                (fun _unit -> let _ = Stdlib.__Network.__close descriptor in ()) in
        let exchange6 = Stdlib.__Network.__udpExchange descriptor lifecycle true in
        Ok (Stdlib.__Network.Udp6Socket { lifecycle = lifecycle, exchange6 = exchange6 })

let closeUdp6 (socket: Stdlib.__Network.Udp6Socket) : Unit =
    Stdlib.Stream.close socket.lifecycle

let exchangeUdp6 (socket: Stdlib.__Network.Udp6Socket) (address: List<Int64>) (port: Int64)
    (payload: Blob) (timeoutMs: Int64) : Stdlib.Result.Result<Blob, Int64> =
    socket.exchange6 address port payload timeoutMs
