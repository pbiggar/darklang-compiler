opam-version: "2.0"
synopsis: "Faithful native OCaml port of the Dark compiler"
maintainer: "Darklang"
authors: ["Darklang"]
license: "MIT"
build: [["dune" "build" "-p" name "-j" jobs]]
depends: [
  "ocaml" {= "5.5.1"}
  "dune" {= "3.24.2"}
  "ocamlformat" {= "0.29.0" & with-dev-setup}
  "yojson" {= "3.0.0"}
  "zarith" {= "1.14"}
  "uutf" {= "1.0.4"}
  "uucp" {= "16.0.0"}
  "uunf" {= "16.0.0"}
  "uuseg" {= "16.0.0"}
  "digestif" {= "1.3.1"}
  "mtime" {= "2.2.0"}
  "uri" {= "4.4.0"}
  "uuidm" {= "0.9.10"}
  "cohttp-lwt-unix" {= "6.3.0"}
  "tls-lwt" {= "2.1.3"}
  "ca-certs" {= "1.0.3"}
  "sqlite3" {= "5.4.2"}
  "spawn" {= "v0.17.0"}
  "bos" {= "0.3.0"}
]

depexts: [
  ["libgmp-dev" "libsqlite3-dev" "pkg-config"]
    {os-distribution = "ubuntu" | os-distribution = "debian"}
  ["gmp" "sqlite" "pkg-config"] {os = "macos"}
]
