opam-version: "2.0"
synopsis: "Faithful native OCaml port of the Dark compiler"
maintainer: "Darklang"
authors: ["Darklang"]
license: "MIT"
build: [["dune" "build" "-p" name "-j" jobs]]
depends: [
  "ocaml" {= "5.5.1"}
  "dune" {= "3.24.2"}
  "yojson" {= "3.0.0"}
  "zarith" {= "1.14"}
  "uutf" {= "1.0.4"}
  "uucp" {= "16.0.0"}
  "uunf" {= "16.0.0"}
  "uuseg" {= "16.0.0"}
  "digestif" {= "1.3.1"}
  "dtoa" {= "0.3.3"}
  "mtime" {= "2.2.0"}
  "uri" {= "4.4.0"}
  "uuidm" {= "0.9.10"}
]

depexts: [
  ["libicu-dev" "libgmp-dev" "libsqlite3-dev" "libcurl4-openssl-dev" "pkg-config"]
    {os-distribution = "ubuntu" | os-distribution = "debian"}
  ["icu4c" "gmp" "sqlite" "curl" "pkg-config"] {os = "macos"}
]
