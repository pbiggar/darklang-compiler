// HttpServer.dark - Routing and bounded sequential native HTTP/1.1 and HTTP/2 serving.

module Darklang.Stdlib.HttpServer

type Handler = { route: String, method: String, handler: Stdlib.Http.Request -> Stdlib.Http.Response }

let get (route: String) (fn: Stdlib.Http.Request -> Stdlib.Http.Response) : Stdlib.HttpServer.Handler =
    Stdlib.HttpServer.Handler { route = route; method = "GET"; handler = fn }

let post (route: String) (fn: Stdlib.Http.Request -> Stdlib.Http.Response) : Stdlib.HttpServer.Handler =
    Stdlib.HttpServer.Handler { route = route; method = "POST"; handler = fn }

type RouteMatch = { matched: Bool, vars: List<(String * String)> }
type RouteSegment =
    | Literal of String
    | Variable of String
    | Wildcard of String

let parseRouteSegments (route: String) : List<Stdlib.HttpServer.RouteSegment> =
    Stdlib.List.filterMap (Stdlib.String.split route "/") (fun segment ->
        if segment == "" then None
        else if Stdlib.String.startsWith segment ":" then
            Some (Stdlib.HttpServer.RouteSegment.Variable (Stdlib.String.dropFirst segment 1))
        else if Stdlib.String.startsWith segment "*" then
            Some (Stdlib.HttpServer.RouteSegment.Wildcard (Stdlib.String.dropFirst segment 1))
        else Some (Stdlib.HttpServer.RouteSegment.Literal segment))

let matchSegment (route: Stdlib.HttpServer.RouteSegment) (path: String) (remaining: List<String>)
    : Stdlib.Option.Option<List<(String * String)>> =
    match route with
    | Literal expected -> if expected == path then Some [] else None
    | Variable name -> Some [(name, path)]
    | Wildcard name -> Some [(name, Stdlib.String.join (Stdlib.List.append [path] remaining) "/")]

let splitPath (path: String) : List<String> =
    Stdlib.List.filter (Stdlib.String.split path "/") (fun segment -> segment != "")

let __matchSegments (routes: List<Stdlib.HttpServer.RouteSegment>) (paths: List<String>)
    (vars: List<(String * String)>) : Stdlib.HttpServer.RouteMatch =
    match routes, paths with
    | [], [] -> Stdlib.HttpServer.RouteMatch { matched = true; vars = vars }
    | route :: moreRoutes, path :: morePaths ->
        match Stdlib.HttpServer.matchSegment route path [] with
        | None -> Stdlib.HttpServer.RouteMatch { matched = false; vars = [] }
        | Some newVars -> Stdlib.HttpServer.__matchSegments moreRoutes morePaths (Stdlib.List.append vars newVars)
    | _, _ -> Stdlib.HttpServer.RouteMatch { matched = false; vars = [] }

// Upstream requires equal segment counts, including wildcard routes.
let matchRouteSegments (routes: List<Stdlib.HttpServer.RouteSegment>) (paths: List<String>) : Stdlib.HttpServer.RouteMatch =
    Stdlib.HttpServer.__matchSegments routes paths []

let matchRoute (route: String) (path: String) : Stdlib.HttpServer.RouteMatch =
    Stdlib.HttpServer.matchRouteSegments (Stdlib.HttpServer.parseRouteSegments route) (Stdlib.HttpServer.splitPath path)

let __findHandler (handlers: List<Stdlib.HttpServer.Handler>) (method: String) (paths: List<String>)
    : Stdlib.Option.Option<(Stdlib.HttpServer.Handler * Stdlib.HttpServer.RouteMatch)> =
    match handlers with
    | [] -> None
    | handler :: rest ->
        if handler.method == method || handler.method == "*" then
            let matched = Stdlib.HttpServer.matchRouteSegments (Stdlib.HttpServer.parseRouteSegments handler.route) paths in
            if matched.matched then Some ((handler, matched))
            else Stdlib.HttpServer.__findHandler rest method paths
        else Stdlib.HttpServer.__findHandler rest method paths

let findHandler (handlers: List<Stdlib.HttpServer.Handler>) (method: String) (path: String)
    : Stdlib.Option.Option<(Stdlib.HttpServer.Handler * Stdlib.HttpServer.RouteMatch)> =
    Stdlib.HttpServer.__findHandler handlers method (Stdlib.HttpServer.splitPath path)

let getMethod (req: Stdlib.Http.Request) : String =
    Stdlib.Http.Request.header req "x-http-method" |> Stdlib.Option.withDefault "GET"

let getPath (req: Stdlib.Http.Request) : String =
    let withoutProtocol =
        match Stdlib.String.split req.url "://" with
        | [_, rest] -> rest
        | _ -> req.url in
    match Stdlib.String.split withoutProtocol "/" with
    | [] -> "/"
    | [_] -> "/"
    | _ :: rest ->
        let path = Stdlib.String.join rest "/" in
        match Stdlib.String.splitFirst path "?" with
        | None -> "/" ++ path
        | Some ((before, _)) -> "/" ++ before

let routeRequest (handlers: List<Stdlib.HttpServer.Handler>) (req: Stdlib.Http.Request) : Stdlib.Http.Response =
    match Stdlib.HttpServer.findHandler handlers (Stdlib.HttpServer.getMethod req) (Stdlib.HttpServer.getPath req) with
    | Some ((handler, _)) -> handler.handler req
    | None -> Stdlib.Http.notFound ()

let getPathParam (req: Stdlib.Http.Request) (route: String) (name: String) : Stdlib.Option.Option<String> =
    let pairs = Stdlib.List.zipShortest (Stdlib.HttpServer.parseRouteSegments route) (Stdlib.HttpServer.splitPath (Stdlib.HttpServer.getPath req)) in
    match Stdlib.List.findFirst pairs (fun pair ->
        let (segment, _) = pair in
        match segment with
        | Variable variable -> variable == name
        | _ -> false) with
    | None -> None
    | Some ((_, value)) -> Some value

let __hasHeader (headers: List<(String * String)>) (name: String) : Bool =
    Stdlib.List.any headers (fun pair -> let (key, _) = pair in Stdlib.String.toLowercase key == name)

let __standardHeaders (inject: Bool) (headers: List<(String * String)>) : List<(String * String)> =
    if Stdlib.Bool.not inject then headers
    else
        let server = if Stdlib.HttpServer.__hasHeader headers "server" then [] else [("Server", "darklang")] in
        let hsts = if Stdlib.HttpServer.__hasHeader headers "strict-transport-security" then []
                   else [("Strict-Transport-Security", "max-age=31536000; includeSubDomains; preload")] in
        Stdlib.List.append headers (Stdlib.List.append server hsts)

let __request (config: Stdlib.HttpServer.Config.Config) (parsed: Stdlib.HttpWire.ParsedRequest)
    : Stdlib.Result.Result<Stdlib.Http.Request, String> =
    let headers = Stdlib.List.append [("x-http-method", parsed.method)] parsed.headers in
    let temporary = Stdlib.Http.Request { url = ""; headers = headers; body = parsed.body } in
    let authority = Stdlib.Http.Request.header temporary "host"
        |> Stdlib.Option.withDefault ("localhost:" ++ Stdlib.Int.toString config.port) in
    match Stdlib.HttpWire.parseUrl ("http://" ++ authority ++ "/") with
    | Error message -> Error message
    | Ok url ->
        let forwarded = config.canonicalizeFromForwardedProto &&
            Stdlib.List.any headers (fun pair -> let (key, value) = pair in
                Stdlib.String.toLowercase key == "x-forwarded-proto" && Stdlib.String.toLowercase value == "https") in
        let host = if Stdlib.String.contains url.host ":" then "[" ++ url.host ++ "]" else url.host in
        let prefix = if forwarded then "https://" ++ host else "http://" ++ authority in
        Ok (Stdlib.Http.Request { url = prefix ++ parsed.target; headers = headers; body = parsed.body })

let __responseBytes (method: String) (config: Stdlib.HttpServer.Config.Config) (response: Stdlib.Http.Response)
    : Stdlib.Result.Result<Blob, String> =
    let headers = Stdlib.List.filter (Stdlib.HttpServer.__standardHeaders config.injectStandardHeaders response.headers) (fun pair -> let (name, _) = pair in
            let lower = Stdlib.String.toLowercase name in
            lower != "content-length" && lower != "transfer-encoding" && lower != "connection") in
    match Stdlib.Int.toInt64 response.statusCode with
    | None -> Error "Invalid HTTP status"
    | Some status ->
        match Stdlib.HttpWire.serializeResponse status (Stdlib.List.append headers [("Connection", "close")]) response.body with
        | Error message -> Error message
        | Ok bytes ->
            if method != "HEAD" then Ok bytes
            else
                match Stdlib.HttpWire.parseResponseHead "HEAD" bytes with
                | Error _ -> Error "Invalid HTTP response headers"
                | Ok head -> Ok (Stdlib.Blob.slice bytes 0
                    (Stdlib.Int.fromInt64 (Stdlib.Blob.__byteLength bytes - Stdlib.Blob.__byteLength head.remaining)))

let __http2Handler (config: Stdlib.HttpServer.Config.Config)
    (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (request: Stdlib.Http.Request) : Stdlib.Http.Response =
    match Stdlib.HttpWire.parseUrl request.url with
    | Error _ -> Stdlib.Http.badRequest "Invalid HTTP request URL"
    | Ok url ->
        let headers = if Stdlib.HttpServer.__hasHeader request.headers "host" then request.headers
                      else Stdlib.List.append request.headers [("host", url.authority)] in
        let forwarded = config.canonicalizeFromForwardedProto &&
            Stdlib.List.any headers (fun pair -> let (key, value) = pair in
                key == "x-forwarded-proto" && Stdlib.String.toLowercase value == "https") in
        let host = if Stdlib.String.contains url.host ":" then "[" ++ url.host ++ "]" else url.host in
        let requestUrl = if forwarded then "https://" ++ host ++ url.target else request.url in
        let req = Stdlib.Http.Request { url = requestUrl, headers = headers, body = request.body } in
        let started = Stdlib.Network.monotonicMillis () in
        let response = handler req in
        let _ =
            if config.logRequests then
                match started, Stdlib.Network.monotonicMillis () with
                | Ok begin_, Ok end_ -> Stdlib.printLine ("[HttpServer] " ++ Stdlib.HttpServer.getMethod req ++ " " ++ url.target ++ " " ++
                    Stdlib.Int.toString response.statusCode ++ " " ++ Stdlib.Int64.toString (end_ - begin_) ++ "ms")
                | _, _ -> ()
            else () in
        response

type ReadError =
    | Status of (Int * Stdlib.Option.Option<String>)
    | Shutdown
    | Transport of Int64

// A valid start line can precede an invalid or oversized body. Keep its method
// so HEAD suppresses bodies even when request decoding cannot finish.
let __statusError (status: Int) (buffer: Blob) : Stdlib.HttpServer.ReadError =
    let method =
        match Stdlib.HttpWire.__line buffer 0L with
        | Error _ -> None
        | Ok ((line, _)) ->
            match Stdlib.HttpWire.__requestLine line with
            | Error _ -> None
            | Ok ((method, _, _)) -> Some method in
    Stdlib.HttpServer.ReadError.Status ((status, method))

let __expectContinue (buffer: Blob) : Stdlib.Result.Result<Bool, String> =
    match Stdlib.HttpWire.__line buffer 0L with
    | Error _ -> Ok false
    | Ok ((_, afterLine)) ->
        match Stdlib.HttpWire.__headers buffer afterLine 0L afterLine [] with
        | Error _ -> Ok false
        | Ok ((headers, _)) ->
            let expectations = Stdlib.List.filter headers (fun pair -> let (name, _) = pair in
                Stdlib.String.toLowercase name == "expect") in
            if Stdlib.List.any expectations (fun pair -> let (_, value) = pair in
                Stdlib.String.toLowercase value != "100-continue") then Error "Unsupported expectation"
            else Ok (Stdlib.List.length expectations > 0)

let __readRequest (connection: Stdlib.Network.TcpConnection) (signals: Stdlib.Network.ShutdownSignals)
    (limit: Int64) (deadline: Int64) (continued: Bool) (buffer: Blob) : Stdlib.Result.Result<Stdlib.HttpWire.ParsedRequest, Stdlib.HttpServer.ReadError> =
    match Stdlib.Network.shutdownRequested signals with
    | Error code -> Error (Stdlib.HttpServer.ReadError.Transport code)
    | Ok true -> Error Stdlib.HttpServer.ReadError.Shutdown
    | Ok false ->
        match Stdlib.Network.monotonicMillis () with
        | Error code -> Error (Stdlib.HttpServer.ReadError.Transport code)
        | Ok now ->
            if now >= deadline then Error (Stdlib.HttpServer.__statusError 408 buffer)
            else if Stdlib.Blob.__byteLength buffer > limit + 1048576L then Error (Stdlib.HttpServer.__statusError 413 buffer)
            else
                match Stdlib.HttpWire.parseRequestWithLimit limit buffer with
                | Ok parsed -> Ok parsed
                | Error (Invalid message) ->
                    if message == "HTTP body too large" then Error (Stdlib.HttpServer.__statusError 413 buffer)
                    else Error (Stdlib.HttpServer.__statusError 400 buffer)
                | Error Incomplete ->
                    match Stdlib.HttpServer.__expectContinue buffer with
                    | Error _ -> Error (Stdlib.HttpServer.__statusError 417 buffer)
                    | Ok expect ->
                        let acknowledged =
                            if expect && Stdlib.Bool.not continued then
                                Stdlib.Network.writeTcp connection (Stdlib.String.toBlob "HTTP/1.1 100 Continue\r\n\r\n")
                            else Ok () in
                        match acknowledged with
                        | Error code -> Error (Stdlib.HttpServer.ReadError.Transport code)
                        | Ok () ->
                            match Stdlib.Network.readTcp connection 4096L with
                            | Error code ->
                                if code == 4L || code == 11L || code == 35L then
                                    Stdlib.HttpServer.__readRequest connection signals limit deadline (continued || expect) buffer
                                else Error (Stdlib.HttpServer.ReadError.Transport code)
                            | Ok chunk ->
                                if Stdlib.Blob.__byteLength chunk == 0L then Error (Stdlib.HttpServer.__statusError 400 buffer)
                                else Stdlib.HttpServer.__readRequest connection signals limit deadline (continued || expect) (Stdlib.Blob.concat [buffer, chunk])

let __handleHttp1 (config: Stdlib.HttpServer.Config.Config) (handler: Stdlib.Http.Request -> Stdlib.Http.Response)
    (signals: Stdlib.Network.ShutdownSignals) (connection: Stdlib.Network.TcpConnection) (limit: Int64)
    (pending: Blob)
    : Stdlib.Result.Result<Bool, String> =
    match Stdlib.Network.monotonicMillis () with
    | Error code -> Error ("Monotonic clock failed: " ++ Stdlib.Int64.toString code)
    | Ok started ->
        let parsed = Stdlib.HttpServer.__readRequest connection signals limit (started + 10000L) false pending in
        match parsed with
        | Error Shutdown -> Ok true
        | Error (Transport _) -> Ok false
        | _ ->
            let method =
                match parsed with
                | Ok request -> request.method
                | Error (Status details) ->
                    let (_, method) = details in
                    method |> Stdlib.Option.withDefault "(unknown)"
                | Error _ -> "(unknown)" in
            let target = match parsed with | Ok request -> request.target | Error _ -> "(invalid request)" in
            let response =
                match parsed with
                | Error (Status details) ->
                    let (status, _) = details in
                    if status == 413 then Stdlib.Http.responseWithText "413 Payload Too Large" 413
                    else Stdlib.Http.responseWithText "Invalid HTTP request" status
                | Ok request ->
                    match Stdlib.HttpServer.__request config request with
                    | Error _ -> Stdlib.Http.badRequest "Invalid HTTP request"
                    | Ok req -> handler req
                | Error Shutdown -> Builtin.crash "HTTP dispatch reached a handled shutdown"
                | Error (Transport _) -> Builtin.crash "HTTP dispatch reached a handled transport failure" in
            let (bytes, status) =
                match Stdlib.HttpServer.__responseBytes method config response with
                | Ok wire -> (wire, response.statusCode)
                | Error _ ->
                    let head = "HTTP/1.1 500 Internal Server Error\r\nConnection: close\r\nContent-Length: 21\r\n\r\n" in
                    let message = if method == "HEAD" then head else head ++ "Internal server error" in
                    (Stdlib.String.toBlob message, 500) in
            let _ = Stdlib.Network.writeTcp connection bytes in
            let _ =
                if config.logRequests then
                    match Stdlib.Network.monotonicMillis () with
                    | Error _ -> ()
                    | Ok finished -> Stdlib.printLine ("[HttpServer] " ++ method ++ " " ++ target ++ " " ++
                        Stdlib.Int.toString status ++ " " ++ Stdlib.Int64.toString (finished - started) ++ "ms")
                else () in
            Ok false

// A response can finish before the request upload. Bounded draining avoids
// closing TCP with queued unread DATA, which can reset the delivered response.
// Accepted sockets have a short receive timeout; do not wait indefinitely for
// a peer that retains the connection after receiving GOAWAY.
let __drainHttp2 (connection: Stdlib.Network.TcpConnection) (signals: Stdlib.Network.ShutdownSignals)
    (deadline: Int64) (remaining: Int64) : Bool =
    if remaining <= 0L then false
    else
        match Stdlib.Network.shutdownRequested signals, Stdlib.Network.monotonicMillis () with
        | Ok true, _ -> true
        | Ok false, Ok now ->
            if now >= deadline then false
            else
                match Stdlib.Network.readTcp connection 4096L with
                | Error code ->
                    if code == 4L then Stdlib.HttpServer.__drainHttp2 connection signals deadline remaining else false
                | Ok bytes ->
                    let size = Stdlib.Blob.__byteLength bytes in
                    if size == 0L then false
                    else Stdlib.HttpServer.__drainHttp2 connection signals deadline (remaining - size)
        | _, _ -> false

let __dispatchPrelude (config: Stdlib.HttpServer.Config.Config) (handler: Stdlib.Http.Request -> Stdlib.Http.Response)
    (signals: Stdlib.Network.ShutdownSignals) (connection: Stdlib.Network.TcpConnection)
    (limit: Int64) (deadline: Int64) (pending: Blob) : Stdlib.Result.Result<Bool, String> =
    if Stdlib.Bool.not (Stdlib.Http2Wire.isPrefacePrefix pending 0L) then
        Stdlib.HttpServer.__handleHttp1 config handler signals connection limit pending
    else if Stdlib.Blob.__byteLength pending >= 24L then
        let transport = Stdlib.HttpTransport.plainWithShutdown connection signals in
        let served = Stdlib.Http2.serve transport pending config (fun request -> Stdlib.HttpServer.__http2Handler config handler request) in
        let stopped =
            match served, Stdlib.Network.monotonicMillis () with
            | Ok (), Ok now -> Stdlib.HttpServer.__drainHttp2 connection signals (now + 250L) 131072L
            | _, _ -> false in
        let _ = Stdlib.HttpTransport.close transport in
        match served with
        | Ok () -> Ok stopped
        | Error message -> Ok (message == "HTTP server shutting down")
    else
        match Stdlib.Network.shutdownRequested signals, Stdlib.Network.monotonicMillis () with
        | Ok true, _ -> Ok true
        | Ok false, Ok now ->
            if now >= deadline then Ok false
            else
                match Stdlib.Network.readTcp connection 4096L with
                | Error code ->
                    if code == 4L || code == 11L || code == 35L then
                        Stdlib.HttpServer.__dispatchPrelude config handler signals connection limit deadline pending
                    else Ok false
                | Ok bytes ->
                    if Stdlib.Blob.__byteLength bytes == 0L then Ok false
                    else Stdlib.HttpServer.__dispatchPrelude config handler signals connection limit deadline (Stdlib.Blob.concat [pending, bytes])
        | _, _ -> Error "HTTP server clock or shutdown check failed"

let __handleConnection (config: Stdlib.HttpServer.Config.Config) (handler: Stdlib.Http.Request -> Stdlib.Http.Response)
    (signals: Stdlib.Network.ShutdownSignals) (connection: Stdlib.Network.TcpConnection) (limit: Int64)
    : Stdlib.Result.Result<Bool, String> =
    match Stdlib.Network.monotonicMillis () with
    | Error _ -> Error "HTTP server clock failed"
    | Ok now -> Stdlib.HttpServer.__dispatchPrelude config handler signals connection limit (now + 10000L) Stdlib.Blob.empty

let __serveLoop (config: Stdlib.HttpServer.Config.Config) (handler: Stdlib.Http.Request -> Stdlib.Http.Response)
    (signals: Stdlib.Network.ShutdownSignals) (listener: Stdlib.Network.TcpListener) (limit: Int64)
    : Stdlib.Result.Result<Unit, String> =
    match Stdlib.Network.shutdownRequested signals with
    | Error code -> Error ("Shutdown check failed: " ++ Stdlib.Int64.toString code)
    | Ok true -> Ok ()
    | Ok false ->
        match Stdlib.Network.waitListener listener with
        | Error code ->
            if code == 4L then Stdlib.HttpServer.__serveLoop config handler signals listener limit
            else Error ("Listener failed: " ++ Stdlib.Int64.toString code)
        | Ok false -> Stdlib.HttpServer.__serveLoop config handler signals listener limit
        | Ok true ->
            match Stdlib.Network.acceptTcp listener 100L with
            | Error code ->
                if code == 4L || code == 11L || code == 35L then Stdlib.HttpServer.__serveLoop config handler signals listener limit
                else Error ("Accept failed: " ++ Stdlib.Int64.toString code)
            | Ok connection ->
                let handled = Stdlib.HttpServer.__handleConnection config handler signals connection limit in
                let _ = Stdlib.Network.closeTcp connection in
                match handled with
                | Error message -> Error message
                | Ok true -> Ok ()
                | Ok false -> Stdlib.HttpServer.__serveLoop config handler signals listener limit

/// Bind before announcing, serve one bounded HTTP/1.1 or HTTP/2 request per connection,
/// and return normally after SIGINT or SIGTERM. Routing remains ordinary Dark.
let serve (config: Stdlib.HttpServer.Config.Config) (handler: Stdlib.Http.Request -> Stdlib.Http.Response)
    (onListening: Unit -> Unit) : Stdlib.Result.Result<Unit, String> =
    match Stdlib.Int.toInt64 config.port, Stdlib.Int.toInt64 config.maxBodyBytes with
    | Some port, Some limit ->
        if port <= 0L || port > 65535L || limit < 0L || limit > 104857600L then Error "Invalid HTTP server configuration"
        else
            match Stdlib.Network.monotonicMillis () with
            | Error code -> Error ("Monotonic clock unavailable: " ++ Stdlib.Int64.toString code)
            | Ok _ ->
                match Stdlib.Network.shutdownSignals () with
                | Error code -> Error ("Shutdown setup failed: " ++ Stdlib.Int64.toString code)
                | Ok signals ->
                    let result =
                        match Stdlib.Network.listenTcp4 [0L, 0L, 0L, 0L] port with
                        | Error code -> Error ("Cannot bind HTTP server: " ++ Stdlib.Int64.toString code)
                        | Ok listener ->
                            let _ = onListening () in
                            let result = Stdlib.HttpServer.__serveLoop config handler signals listener limit in
                            let _ = Stdlib.Network.closeListener listener in
                            result in
                    let _ = Stdlib.Network.closeShutdownSignals signals in
                    result
    | _, _ -> Error "Invalid HTTP server configuration"
