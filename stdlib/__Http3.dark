// __Http3.dark - Single-exchange HTTP/3 owner joining QUIC, critical streams and message parsing.
module Darklang.Stdlib.Http3

type State = {
  connection: Stdlib.QuicConnection.State,
  uni: Stdlib.Http3Uni.State,
  message: Stdlib.Http3Message.State,
  deadline: Int64
}
type Received = { state: Stdlib.Http3.State, events: List<Stdlib.Http3Message.Event>, finished: Bool }

let __capacity (connection: Stdlib.QuicConnection.State) (deadline: Int64)
  : Stdlib.Result.Result<Stdlib.QuicConnection.State, String> =
  if connection.flow.peer.streamsUni >= 3L && connection.flow.peer.streamsBidi >= 1L &&
    connection.flow.peer.uni >= 12L && connection.flow.peer.data >= 14L then Ok connection
  else match Stdlib.Network.monotonicMillis () with
  | Error _ -> Error "HTTP/3 clock failed"
  | Ok now ->
    if now >= deadline then Error "HTTP/3 initial stream credit timed out"
    else Stdlib.QuicConnection.poll connection 10L |> Stdlib.Result.andThen (fun next -> Stdlib.Http3.__capacity next deadline)

let initialize (ready: Stdlib.QuicClient.Ready) (headOnly: Bool) (timeout: Int64)
  : Stdlib.Result.Result<Stdlib.Http3.State, String> =
  if timeout < 1L || timeout > 60000L then Error "Invalid HTTP/3 exchange timeout"
  else match Stdlib.Network.monotonicMillis () with
  | Error _ -> Error "HTTP/3 clock failed"
  | Ok now ->
    let deadline = now + timeout in
    Stdlib.QuicConnection.fromClient ready |> Stdlib.Result.andThen (fun connection ->
      Stdlib.Http3.__capacity connection deadline |> Stdlib.Result.andThen (fun connection ->
      Stdlib.QuicConnection.openStream connection 2L |> Stdlib.Result.andThen (fun connection ->
      Stdlib.QuicConnection.openStream connection 6L |> Stdlib.Result.andThen (fun connection ->
      Stdlib.QuicConnection.openStream connection 10L |> Stdlib.Result.andThen (fun connection ->
      Stdlib.QuicConnection.openStream connection 0L |> Stdlib.Result.andThen (fun connection ->
        Stdlib.Http3Wire.serialize 4L (Stdlib.Http3Wire.settings ()) |> Stdlib.Result.andThen (fun settings ->
          Stdlib.QuicConnection.write connection 2L (Stdlib.Blob.concat [Stdlib.Blob.__fromInt64List [0L], settings]) false
            |> Stdlib.Result.andThen (fun connection -> Stdlib.QuicConnection.write connection 6L (Stdlib.Blob.__fromInt64List [2L]) false)
            |> Stdlib.Result.andThen (fun connection -> Stdlib.QuicConnection.write connection 10L (Stdlib.Blob.__fromInt64List [3L]) false)
            |> Stdlib.Result.map (fun connection -> Stdlib.Http3.State { connection = connection,
              uni = Stdlib.Http3Uni.create true, message = Stdlib.Http3Message.create (Response headOnly), deadline = deadline }))))))))

let __controls (state: Stdlib.Http3.State) : Stdlib.Result.Result<Stdlib.Http3.State, String> =
  Stdlib.List.fold state.connection.flow.channels (Ok state) (fun result channel ->
    if channel.id % 4L != 3L then result
    else result |> Stdlib.Result.andThen (fun current ->
      Stdlib.QuicConnection.read current.connection channel.id |> Stdlib.Result.andThen (fun read ->
        Stdlib.Http3Uni.receive current.uni channel.id read.bytes read.finished (Stdlib.Option.isSome read.reset)
          |> Stdlib.Result.map (fun received -> { current with connection = read.state, uni = received.state }))))

// Drain before polling so response data and control credit already received cannot starve.
let __drain (state: Stdlib.Http3.State) : Stdlib.Result.Result<Stdlib.Http3.Received, String> =
  Stdlib.Http3.__controls state |> Stdlib.Result.andThen (fun current ->
    Stdlib.QuicConnection.read current.connection 0L |> Stdlib.Result.andThen (fun read ->
      if Stdlib.Option.isSome read.reset then Error "HTTP/3 response stream reset"
      else Stdlib.Http3Message.feed current.message read.bytes |> Stdlib.Result.andThen (fun received ->
        let next = { current with connection = read.state, message = received.state } in
        let complete = if read.finished then Stdlib.Http3Message.finish received.state else Ok () in
        complete |> Stdlib.Result.andThen (fun _unit ->
          Stdlib.QuicConnection.flush next.connection |> Stdlib.Result.map (fun connection ->
            Stdlib.Http3.Received { state = { next with connection = connection }, events = received.events, finished = read.finished })))))

// Return even without HTTP events: MAX_DATA/MAX_STREAM_DATA can unblock an upload.
let poll (state: Stdlib.Http3.State) : Stdlib.Result.Result<Stdlib.Http3.Received, String> =
  match Stdlib.Network.monotonicMillis () with
  | Error _ -> Error "HTTP/3 clock failed"
  | Ok now ->
    if now >= state.deadline then Error "HTTP/3 exchange timed out"
    else Stdlib.QuicConnection.poll state.connection 10L |> Stdlib.Result.andThen (fun connection ->
      Stdlib.Http3.__drain { state with connection = connection })

let receive (state: Stdlib.Http3.State) : Stdlib.Result.Result<Stdlib.Http3.Received, String> =
  Stdlib.Http3.__drain state |> Stdlib.Result.andThen (fun received ->
    if received.finished || received.events != [] then Ok received
    else Stdlib.Http3.poll received.state |> Stdlib.Result.andThen (fun polled ->
      if polled.finished || polled.events != [] then Ok polled else Stdlib.Http3.receive polled.state))

// The caller retains unsent bytes when credit is unavailable and drains the response.
let sendCredit (state: Stdlib.Http3.State) : Int64 =
  match Stdlib.QuicFlow.channel state.connection.flow 0L with
  | None -> 0L
  | Some channel ->
    if Stdlib.Option.isSome channel.stopped then 0L
    else match channel.send with
    | None -> 0L
    | Some sender ->
      if sender.finished then 0L
      else
        let stream = sender.credit - sender.offset in
        let connection = state.connection.flow.peer.data - state.connection.flow.sent in
        let available = if stream < connection then stream else connection in
        if available > 900L then 900L else available

let write (state: Stdlib.Http3.State) (bytes: Blob) (finished: Bool)
  : Stdlib.Result.Result<Stdlib.Http3.State, String> =
  if state.uni.control.goAway == Some 0L then Error "HTTP/3 request rejected by GOAWAY"
  else Stdlib.QuicConnection.write state.connection 0L bytes finished
    |> Stdlib.Result.andThen (fun connection -> Stdlib.QuicConnection.flush connection)
    |> Stdlib.Result.map (fun connection -> { state with connection = connection })

let close (state: Stdlib.Http3.State) : Unit = Stdlib.QuicConnection.close state.connection
