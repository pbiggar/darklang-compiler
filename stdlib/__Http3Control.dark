// __Http3Control.dark - Mandatory SETTINGS and role-aware HTTP/3 control-stream grammar.
module Darklang.Stdlib.Http3Control

type State = {
  framing: Stdlib.Http3Stream.State,
  fromServer: Bool,
  settings: Bool,
  goAway: Stdlib.Option.Option<Int64>,
  pushLimit: Stdlib.Option.Option<Int64>,
  pieces: List<Blob>,
  parts: Int64
}
type Event =
  | Settings of List<(Int64 * Int64)>
  | GoAway of Int64
  | PushLimit of Int64
type Received = { state: Stdlib.Http3Control.State, events: List<Stdlib.Http3Control.Event> }

let create (fromServer: Bool) : Stdlib.Http3Control.State =
  Stdlib.Http3Control.State { framing = Stdlib.Http3Stream.empty, fromServer = fromServer,
    settings = false, goAway = None, pushLimit = None, pieces = [], parts = 0L }

let __begin (state: Stdlib.Http3Control.State) (kind: Int64) (size: Int64)
  : Stdlib.Result.Result<Stdlib.Http3Control.State, String> =
  if state.settings == false && kind != 4L then Error "Missing initial HTTP/3 SETTINGS"
  else if kind == 4L then
    if state.settings then Error "Duplicate HTTP/3 SETTINGS frame"
    else if size > 4096L then Error "HTTP/3 settings too large"
    else Ok { state with pieces = [], parts = 0L }
  else if kind == 0L || kind == 1L || kind == 5L then Error "Unexpected HTTP/3 frame on control stream"
  else if kind == 3L then Error "HTTP/3 CANCEL_PUSH for unpromised push"
  else if kind == 7L || kind == 13L then
    if kind == 13L && state.fromServer then Error "Server sent HTTP/3 MAX_PUSH_ID"
    else if size == 0L || size > 8L then Error "Invalid HTTP/3 control integer size"
    else Ok { state with pieces = [], parts = 0L }
  else Ok state

let __integer (data: Blob) : Stdlib.Result.Result<Int64, String> =
  match Stdlib.QuicWire.parseInteger data 0L with
  | Error _ -> Error "Truncated HTTP/3 control integer"
  | Ok value ->
    if value.next != Stdlib.Blob.__byteLength data then Error "Trailing HTTP/3 control integer bytes"
    else Ok value.value

let __end (state: Stdlib.Http3Control.State) (kind: Int64)
  : Stdlib.Result.Result<(Stdlib.Http3Control.State * Stdlib.Option.Option<Stdlib.Http3Control.Event>), String> =
  if kind != 4L && kind != 7L && kind != 13L then Ok ((state, None))
  else
    let data = Stdlib.Blob.concat (Stdlib.List.reverse state.pieces) in
    let cleared = { state with pieces = [], parts = 0L } in
    if kind == 4L then
      match Stdlib.Http3Wire.parseSettings data with
      | Error message -> Error message
      | Ok settings -> Ok (({ cleared with settings = true }, Some (Settings settings)))
    else
      match Stdlib.Http3Control.__integer data with
      | Error message -> Error message
      | Ok value ->
        if kind == 7L then
          if state.fromServer && value % 4L != 0L then Error "Invalid HTTP/3 server GOAWAY identifier"
          else
            match state.goAway with
            | Some previous when value > previous -> Error "HTTP/3 GOAWAY identifier increased"
            | _ -> Ok (({ cleared with goAway = Some value }, Some (GoAway value)))
        else
          match state.pushLimit with
          | Some previous when value < previous -> Error "HTTP/3 MAX_PUSH_ID decreased"
          | _ -> Ok (({ cleared with pushLimit = Some value }, Some (PushLimit value)))

let __events (state: Stdlib.Http3Control.State) (input: List<Stdlib.Http3Stream.Event>)
  (events: List<Stdlib.Http3Control.Event>) : Stdlib.Result.Result<Stdlib.Http3Control.Received, String> =
  match input with
  | [] -> Ok (Stdlib.Http3Control.Received { state = state, events = Stdlib.List.reverse events })
  | event :: rest ->
    match event with
    | Begin ((kind, size)) ->
      (match Stdlib.Http3Control.__begin state kind size with
      | Error message -> Error message
      | Ok next -> Stdlib.Http3Control.__events next rest events)
    | Chunk ((kind, data)) ->
      if kind != 4L && kind != 7L && kind != 13L then Stdlib.Http3Control.__events state rest events
      else if state.parts >= 1024L then Error "Too many HTTP/3 control fragments"
      else Stdlib.Http3Control.__events { state with pieces = Stdlib.List.push state.pieces data, parts = state.parts + 1L } rest events
    | End kind ->
      match Stdlib.Http3Control.__end state kind with
      | Error message -> Error message
      | Ok ((next, None)) -> Stdlib.Http3Control.__events next rest events
      | Ok ((next, Some item)) -> Stdlib.Http3Control.__events next rest (Stdlib.List.push events item)

let feed (state: Stdlib.Http3Control.State) (data: Blob)
  : Stdlib.Result.Result<Stdlib.Http3Control.Received, String> =
  match Stdlib.Http3Stream.feed state.framing data with
  | Error message -> Error message
  | Ok received -> Stdlib.Http3Control.__events { state with framing = received.state } received.events []

// FIN or RESET of this stream is always fatal, even at a complete frame boundary.
let finish (state: Stdlib.Http3Control.State) : Stdlib.Result.Result<Unit, String> =
  Error "Closed critical HTTP/3 control stream"
