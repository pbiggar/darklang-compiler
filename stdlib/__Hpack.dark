let __huffman (data: Blob) (bit: Int64) (code: Int64) (length: Int64)
  (bytes: List<Int64>) (count: Int64) : Stdlib.Result.Result<Blob, String> =
  if bit == Stdlib.Blob.__byteLength data * 8L then
    if length == 0L || (length <= 7L && code == Stdlib.Hpack.__pow2 length - 1L) then
      Ok (Stdlib.Blob.__fromInt64List (Stdlib.List.reverse bytes))
    else Error "Invalid HPACK Huffman padding"
  else if length >= 30L then Error "Invalid HPACK Huffman code"
  else
    let byte = Stdlib.Blob.__getByte data (bit / 8L) in
    let nextCode = code * 2L + (byte / Stdlib.Hpack.__pow2 (7L - bit % 8L)) % 2L in
    let nextLength = length + 1L in
    match Stdlib.Hpack.__huffmanSymbol nextLength nextCode with
    | None -> Stdlib.Hpack.__huffman data (bit + 1L) nextCode nextLength bytes count
    | Some symbol ->
      if symbol == 256L then Error "HPACK Huffman EOS in string"
      else if count >= 65536L then Error "HPACK string too large"
      else Stdlib.Hpack.__huffman data (bit + 1L) 0L 0L (Stdlib.List.push bytes symbol) (count + 1L)

let text (data: Blob) (position: Int64) : Stdlib.Result.Result<Stdlib.Hpack.Text, String> =
  match Stdlib.Hpack.integer data position 7L with
  | Error message -> Error message
  | Ok number ->
    if number.value > 65536L then Error "HPACK string too large"
    else if number.next + number.value > Stdlib.Blob.__byteLength data then Error "Truncated HPACK string"
    else
      let encoded = Stdlib.Http2Wire.__slice data number.next number.value in
      let bytes = if Stdlib.Blob.__getByte data position >= 128L then
                    Stdlib.Hpack.__huffman encoded 0L 0L 0L [] 0L
                  else Ok encoded in
      match bytes with
      | Error message -> Error message
      | Ok decoded ->
        match Stdlib.Blob.toString decoded with
        | Error _ -> Error "Invalid UTF-8 in HTTP header"
        | Ok value -> Ok (Stdlib.Hpack.Text { value = value, next = number.next + number.value })

let __entrySize (entry: (String * String)) : Int64 =
  let (name, value) = entry in
  32L + Stdlib.String.__byteLength name + Stdlib.String.__byteLength value

let __retain (entries: List<(String * String)>) (remaining: Int64) : List<(String * String)> =
  match entries with
  | [] -> []
  | entry :: rest ->
    let size = Stdlib.Hpack.__entrySize entry in
    if size > remaining then []
    else Stdlib.List.push (Stdlib.Hpack.__retain rest (remaining - size)) entry

let __add (state: Stdlib.Hpack.State) (entry: (String * String)) : Stdlib.Hpack.State =
  Stdlib.Hpack.State { entries = Stdlib.Hpack.__retain (Stdlib.List.push state.entries entry) state.limit, limit = state.limit }

let __decode (state: Stdlib.Hpack.State) (data: Blob) (position: Int64)
  (headers: List<(String * String)>) (size: Int64) (count: Int64)
  : Stdlib.Result.Result<Stdlib.Hpack.Decoded, String> =
  if position == Stdlib.Blob.__byteLength data then
    Ok (Stdlib.Hpack.Decoded { headers = Stdlib.List.reverse headers, state = state })
  else if count >= 256L || size > 65536L then Error "HPACK header list too large"
  else
    let first = Stdlib.Blob.__getByte data position in
    if first >= 128L then
      match Stdlib.Hpack.integer data position 7L with
      | Error message -> Error message
      | Ok number ->
        match Stdlib.Hpack.__lookup state number.value with
        | None -> Error "Invalid HPACK index"
        | Some entry ->
          let nextSize = size + Stdlib.Hpack.__entrySize entry in
          if nextSize > 65536L then Error "HPACK header list too large"
          else Stdlib.Hpack.__decode state data number.next (Stdlib.List.push headers entry) nextSize (count + 1L)
    else if first >= 32L && first < 64L then
      if count != 0L then Error "HPACK table update after a header"
      else
        match Stdlib.Hpack.integer data position 5L with
        | Error message -> Error message
        | Ok number ->
          if number.value > 4096L then Error "HPACK table exceeds advertised limit"
          else
            let nextState = Stdlib.Hpack.State {
              entries = Stdlib.Hpack.__retain state.entries number.value, limit = number.value } in
            Stdlib.Hpack.__decode nextState data number.next headers size count
    else
      let indexed = first >= 64L in
      let prefix = if indexed then 6L else 4L in
      match Stdlib.Hpack.integer data position prefix with
      | Error message -> Error message
      | Ok number ->
        let name =
          if number.value == 0L then Stdlib.Hpack.text data number.next
          else
            match Stdlib.Hpack.__lookup state number.value with
            | None -> Error "Invalid HPACK index"
            | Some entry ->
              let (name, _) = entry in
              Ok (Stdlib.Hpack.Text { value = name, next = number.next }) in
        match name with
        | Error message -> Error message
        | Ok name ->
          match Stdlib.Hpack.text data name.next with
          | Error message -> Error message
          | Ok value ->
            let entry = (name.value, value.value) in
            let nextSize = size + Stdlib.Hpack.__entrySize entry in
            if nextSize > 65536L then Error "HPACK header list too large"
            else
              let nextState = if indexed then Stdlib.Hpack.__add state entry else state in
              Stdlib.Hpack.__decode nextState data value.next (Stdlib.List.push headers entry) nextSize (count + 1L)

let decode (state: Stdlib.Hpack.State) (data: Blob) : Stdlib.Result.Result<Stdlib.Hpack.Decoded, String> =
  if state.limit < 0L || state.limit > 4096L || Stdlib.Blob.__byteLength data > 65536L then
    Error "Invalid HPACK decoder bounds"
  else Stdlib.Hpack.__decode state data 0L [] 0L 0L

let __encodeRest (value: Int64) : List<Int64> =
  if value < 128L then [value]
  else Stdlib.List.push (Stdlib.Hpack.__encodeRest (value / 128L)) (128L + value % 128L)

let encodeInteger (prefix: Int64) (flags: Int64) (value: Int64) : Blob =
  let mask = Stdlib.Hpack.__pow2 prefix - 1L in
  if value < mask then Stdlib.Blob.__fromInt64List [flags + value]
  else Stdlib.Blob.__fromInt64List (Stdlib.List.push (Stdlib.Hpack.__encodeRest (value - mask)) (flags + mask))

let encodeText (value: String) : Blob =
  Stdlib.Blob.concat [Stdlib.Hpack.encodeInteger 7L 0L (Stdlib.String.__byteLength value),
                      Stdlib.String.toBlob value]

let __encode (headers: List<(String * String)>) (size: Int64) (count: Int64)
  (blocks: List<Blob>) : Stdlib.Result.Result<Blob, String> =
  match headers with
  | [] -> Ok (Stdlib.Blob.concat (Stdlib.List.reverse blocks))
  | entry :: rest ->
    let (name, value) = entry in
    let nextSize = size + Stdlib.Hpack.__entrySize entry in
    if count >= 256L || nextSize > 65536L then Error "HPACK header list too large"
    else if name == "" then Error "Empty HTTP header name"
    else
      // Never-indexed literals avoid persisting sensitive fields in a peer's table.
      let encoded = Stdlib.Blob.concat [Stdlib.Blob.__fromInt64List [16L],
        Stdlib.Hpack.encodeText name, Stdlib.Hpack.encodeText value] in
      Stdlib.Hpack.__encode rest nextSize (count + 1L) (Stdlib.List.push blocks encoded)

let encode (headers: List<(String * String)>) : Stdlib.Result.Result<Blob, String> =
  Stdlib.Hpack.__encode headers 0L 0L []

