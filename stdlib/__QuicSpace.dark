// __QuicSpace.dark - Pure per-encryption-level replay, CRYPTO, ACK and retransmission ownership.
module Darklang.Stdlib.QuicSpace

type Transmission = { token: Int64, payload: Blob, probe: Bool }
type State = {
  received: Stdlib.QuicAck.State, recovery: Stdlib.QuicRecovery.State,
  crypto: Stdlib.QuicReassembly.State, queued: List<Stdlib.QuicSpace.Transmission>,
  nextToken: Int64, ackPending: Bool
}
type Receipt = { state: Stdlib.QuicSpace.State, fresh: Bool }
type Plan = { payload: Blob, reliable: Blob, token: Int64, probe: Bool, queued: Bool, ackEliciting: Bool }

let __state (state: Stdlib.QuicSpace.State) (received: Stdlib.QuicAck.State)
  (recovery: Stdlib.QuicRecovery.State) (crypto: Stdlib.QuicReassembly.State)
  (queued: List<Stdlib.QuicSpace.Transmission>) (nextToken: Int64) (ackPending: Bool) : Stdlib.QuicSpace.State =
  Stdlib.QuicSpace.State { received = received, recovery = recovery, crypto = crypto,
    queued = queued, nextToken = nextToken, ackPending = ackPending }

let create () : Stdlib.Result.Result<Stdlib.QuicSpace.State, String> =
  match Stdlib.QuicRecovery.create 1200L, Stdlib.QuicReassembly.create 1048576L with
  | Ok recovery, Ok crypto -> Ok (Stdlib.QuicSpace.State {
      received = Stdlib.QuicAck.empty, recovery = recovery, crypto = crypto,
      queued = [], nextToken = 0L, ackPending = false })
  | _, _ -> Error "QUIC packet space creation failed"

let queue (state: Stdlib.QuicSpace.State) (payload: Blob) : Stdlib.Result.Result<Stdlib.QuicSpace.State, String> =
  if Stdlib.Blob.__byteLength payload == 0L || Stdlib.Blob.__byteLength payload > 1000L then Error "Invalid QUIC reliable frame size"
  else if Stdlib.List.length state.queued >= 2048 || state.nextToken == 4611686018427387903L then Error "QUIC send queue exhausted"
  else Ok (Stdlib.QuicSpace.__state state state.received state.recovery state.crypto
    (Stdlib.List.append state.queued [Stdlib.QuicSpace.Transmission { token = state.nextToken, payload = payload, probe = false }])
    (state.nextToken + 1L) state.ackPending)

let __retransmit (packets: List<Stdlib.QuicRecovery.Packet>) (items: List<Stdlib.QuicSpace.Transmission>) (probe: Bool)
  : List<Stdlib.QuicSpace.Transmission> =
  match packets with
  | [] -> items
  | packet :: rest ->
    let next = if Stdlib.List.any items (fun item -> item.token == packet.token) then items
               else Stdlib.List.append items [Stdlib.QuicSpace.Transmission { token = packet.token, payload = packet.payload, probe = probe }] in
    Stdlib.QuicSpace.__retransmit rest next probe

let __updated (state: Stdlib.QuicSpace.State) (update: Stdlib.QuicRecovery.Update) : Stdlib.Result.Result<Stdlib.QuicSpace.State, String> =
  let queued = Stdlib.List.filter state.queued (fun item -> Stdlib.Bool.not (Stdlib.List.member update.acknowledged item.token)) in
  let retransmit = Stdlib.QuicSpace.__retransmit update.retransmit [] update.probe in
  let queued = Stdlib.List.append retransmit (Stdlib.List.filter queued (fun item -> Stdlib.Bool.not (Stdlib.List.any retransmit (fun retry -> retry.token == item.token)))) in
  let queued = if update.probe then (match queued with | first :: rest -> Stdlib.List.push rest (Stdlib.QuicSpace.Transmission { token = first.token, payload = first.payload, probe = true }) | [] -> []) else queued in
  let next = Stdlib.QuicSpace.__state state state.received update.state state.crypto queued state.nextToken state.ackPending in
  if update.probe && Stdlib.List.isEmpty queued then
    Stdlib.QuicSpace.queue next (Stdlib.Blob.__fromInt64List [1L]) |> Stdlib.Result.map (fun probe ->
      Stdlib.QuicSpace.__state probe probe.received probe.recovery probe.crypto
        (Stdlib.List.map probe.queued (fun item -> Stdlib.QuicSpace.Transmission { token = item.token, payload = item.payload, probe = true }))
        probe.nextToken probe.ackPending)
  else if Stdlib.List.length queued > 2048 then Error "QUIC retransmission queue exhausted"
  else Ok next

let acknowledge (state: Stdlib.QuicSpace.State) (ack: Stdlib.QuicFrames.Ack) (now: Int64) (delay: Int64) (maxDelay: Int64)
  : Stdlib.Result.Result<Stdlib.QuicSpace.State, String> =
  Stdlib.QuicRecovery.acknowledge state.recovery ack now delay maxDelay |> Stdlib.Result.andThen (Stdlib.QuicSpace.__updated state)

let timeout (state: Stdlib.QuicSpace.State) (now: Int64) (maxDelay: Int64) : Stdlib.Result.Result<Stdlib.QuicSpace.State, String> =
  Stdlib.QuicRecovery.timeout state.recovery now maxDelay |> Stdlib.Result.andThen (Stdlib.QuicSpace.__updated state)

let receive (state: Stdlib.QuicSpace.State) (number: Int64) (ackEliciting: Bool) : Stdlib.Result.Result<Stdlib.QuicSpace.Receipt, String> =
  Stdlib.QuicAck.receive state.received number |> Stdlib.Result.map (fun receipt -> Stdlib.QuicSpace.Receipt {
    fresh = receipt.fresh, state = (Stdlib.QuicSpace.__state state receipt.state state.recovery state.crypto state.queued state.nextToken (state.ackPending || (ackEliciting && number >= receipt.state.floor))) })

let __frames (state: Stdlib.QuicSpace.State) (frames: List<Stdlib.QuicFrames.Frame>) (now: Int64)
  : Stdlib.Result.Result<Stdlib.QuicSpace.State, String> =
  match frames with
  | [] -> Ok state
  | Close _ :: _ -> Error "Peer closed QUIC during handshake"
  | Ack ack :: rest -> Stdlib.QuicSpace.acknowledge state ack now 0L 0L |> Stdlib.Result.andThen (fun next -> Stdlib.QuicSpace.__frames next rest now)
  | Crypto frame :: rest ->
    Stdlib.QuicReassembly.insert state.crypto frame.offset frame.bytes |> Stdlib.Result.andThen (fun crypto ->
      Stdlib.QuicSpace.__frames (Stdlib.QuicSpace.__state state state.received state.recovery crypto state.queued state.nextToken state.ackPending) rest now)
  | _ :: rest -> Stdlib.QuicSpace.__frames state rest now

let handshake (state: Stdlib.QuicSpace.State) (opened: Stdlib.QuicCrypto.Opened) (now: Int64)
  : Stdlib.Result.Result<Stdlib.QuicSpace.State, String> =
  Stdlib.QuicFrames.parseHandshake opened.payload |> Stdlib.Result.andThen (fun frames ->
    let eliciting = Stdlib.List.any frames (fun frame -> match frame with | Ping -> true | Crypto _ -> true | _ -> false) in
    Stdlib.QuicSpace.receive state opened.number eliciting |> Stdlib.Result.andThen (fun receipt ->
      if receipt.fresh then Stdlib.QuicSpace.__frames receipt.state frames now else Ok receipt.state))

let drainCrypto (state: Stdlib.QuicSpace.State) : Stdlib.QuicSpace.State =
  Stdlib.QuicSpace.__state state state.received state.recovery (Stdlib.QuicReassembly.drain state.crypto) state.queued state.nextToken state.ackPending

let __ackOnly (state: Stdlib.QuicSpace.State) (padded: Bool) : Stdlib.Result.Result<Stdlib.Option.Option<Stdlib.QuicSpace.Plan>, String> =
  if padded || Stdlib.Bool.not state.ackPending then Ok None
  else Stdlib.QuicAck.encode state.received |> Stdlib.Result.map (fun ack -> Some (Stdlib.QuicSpace.Plan {
    payload = ack, reliable = Stdlib.Blob.empty, token = state.nextToken, probe = false, queued = false, ackEliciting = false }))

// The owner supplies packet overhead and whether Initial padding is needed.
// A padded ACK carries PING so its congestion-accounted packet can elicit an
// ACK; ordinary ACK-only packets neither consume window nor start a PTO.
let prepare (state: Stdlib.QuicSpace.State) (now: Int64) (overhead: Int64) (padded: Bool)
  : Stdlib.Result.Result<Stdlib.Option.Option<Stdlib.QuicSpace.Plan>, String> =
  if overhead < 21L || overhead > 1199L then Error "Invalid QUIC packet overhead"
  else
    let ack = if state.ackPending then Stdlib.QuicAck.encode state.received else Ok Stdlib.Blob.empty in
    ack |> Stdlib.Result.andThen (fun ack ->
      let item = match state.queued with
        | first :: _ -> Some first
        | [] -> None in
      let reliable = match item with | Some first -> first.payload | None -> Stdlib.Blob.empty in
      let eliciting = Stdlib.Blob.__byteLength reliable > 0L || (padded && state.ackPending) in
      let probe = match item with | Some first -> first.probe | None -> false in
      let payload = Stdlib.Blob.concat [ack, reliable, if padded && state.ackPending && Stdlib.Blob.__byteLength reliable == 0L then Stdlib.Blob.__fromInt64List [1L] else Stdlib.Blob.empty] in
      let size = if padded then 1200L else overhead + Stdlib.Blob.__byteLength payload in
      if Stdlib.Blob.__byteLength payload == 0L then Ok None
      else if size > 1200L || overhead + Stdlib.Blob.__byteLength payload > 1200L then Error "QUIC frames exceed path datagram size"
      else if eliciting && Stdlib.Bool.not probe && size > state.recovery.congestion.window - state.recovery.congestion.inFlight then Stdlib.QuicSpace.__ackOnly state padded
      else
        Stdlib.QuicRecovery.pacingDelay state.recovery now size |> Stdlib.Result.andThen (fun delay ->
          if eliciting && delay > 0L then Stdlib.QuicSpace.__ackOnly state padded
          else Ok (Some (Stdlib.QuicSpace.Plan { payload = payload, reliable = reliable,
            token = (match item with | Some first -> first.token | None -> state.nextToken),
            probe = probe, queued = Stdlib.Blob.__byteLength reliable > 0L, ackEliciting = eliciting }))))

// A conservative common cap across live encryption levels prevents each
// packet space from independently spending a whole congestion window.
let prepareShared (state: Stdlib.QuicSpace.State) (now: Int64) (overhead: Int64) (padded: Bool) (budget: (Int64 * Int64))
  : Stdlib.Result.Result<Stdlib.Option.Option<Stdlib.QuicSpace.Plan>, String> =
  let (otherWindow, otherInFlight) = budget in
  if otherWindow < 2400L || otherInFlight < 0L then Error "Invalid QUIC shared congestion budget"
  else Stdlib.QuicSpace.prepare state now overhead padded |> Stdlib.Result.andThen (fun plan ->
    match plan with
    | None -> Stdlib.QuicSpace.__ackOnly state padded
    | Some plan ->
      let window = if state.recovery.congestion.window < otherWindow then state.recovery.congestion.window else otherWindow in
      let size = if padded then 1200L else overhead + Stdlib.Blob.__byteLength plan.payload in
      if plan.ackEliciting && Stdlib.Bool.not plan.probe && size > window - state.recovery.congestion.inFlight - otherInFlight then Stdlib.QuicSpace.__ackOnly state padded
      else Ok (Some plan))

let sent (state: Stdlib.QuicSpace.State) (plan: Stdlib.QuicSpace.Plan) (size: Int64) (now: Int64)
  : Stdlib.Result.Result<Stdlib.QuicSpace.State, String> =
  Stdlib.QuicRecovery.sent state.recovery (Stdlib.QuicRecovery.Packet {
    number = state.recovery.largestSent + 1L, at = now, size = size, token = plan.token, payload = plan.reliable })
    plan.ackEliciting plan.probe |> Stdlib.Result.map (fun recovery ->
      Stdlib.QuicSpace.__state state state.received recovery state.crypto
        (if plan.queued then Stdlib.List.drop state.queued 1 else state.queued)
        (if plan.ackEliciting && Stdlib.Bool.not plan.queued then state.nextToken + 1L else state.nextToken) false)
