// RsaPkcs1.dark - RSA PKCS#1 v1.5 SHA-256/384 certificate signature checks.

module Darklang.Stdlib.RsaPkcs1

let __same (a: Blob) (b: Blob) (index: Int64) (difference: Int64) : Bool =
  if index == Stdlib.Blob.__byteLength a then difference == 0L
  else Stdlib.RsaPkcs1.__same a b (index + 1L)
         (Stdlib.Int64.bitwiseOr difference
           (Stdlib.Int64.bitwiseXor (Stdlib.Blob.__getByte a index)
             (Stdlib.Blob.__getByte b index)))

let __padding (em: Blob) (index: Int64) (end_: Int64) : Bool =
  if index == end_ then true
  else if Stdlib.Blob.__getByte em index != 255L then false
  else Stdlib.RsaPkcs1.__padding em (index + 1L) end_

let __digestInfo (algorithm: Int64) (message: Blob) : Stdlib.Result.Result<Blob, String> =
  if algorithm == 256L then
    Ok (Stdlib.Blob.concat [
      Stdlib.Blob.__fromInt64List
        [48L, 49L, 48L, 13L, 6L, 9L, 96L, 134L, 72L, 1L,
         101L, 3L, 4L, 2L, 1L, 5L, 0L, 4L, 32L],
      Stdlib.Crypto.sha256 message])
  else if algorithm == 384L then
    Ok (Stdlib.Blob.concat [
      Stdlib.Blob.__fromInt64List
        [48L, 65L, 48L, 13L, 6L, 9L, 96L, 134L, 72L, 1L,
         101L, 3L, 4L, 2L, 2L, 5L, 0L, 4L, 48L],
      Stdlib.Crypto.sha384 message])
  else Error "Unsupported RSA certificate signature algorithm"

let verify (algorithm: Int64) (modulus: Blob) (exponent: Blob)
           (message: Blob) (signature: Blob) : Stdlib.Result.Result<Bool, String> =
  let length = Stdlib.Blob.__byteLength modulus in
  if length < 256L || length > 1024L ||
     Stdlib.Blob.__byteLength signature != length then Ok false
  else
    match Stdlib.RsaPkcs1.__digestInfo algorithm message with
    | Error error -> Error error
    | Ok digestInfo ->
      let n = Stdlib.RsaPss.__fromBytes modulus 0L (Stdlib.Int.fromInt64 0L) in
      let s = Stdlib.RsaPss.__fromBytes signature 0L (Stdlib.Int.fromInt64 0L) in
      if Stdlib.Int.greaterThanOrEqualTo s n then Ok false
      else
        Stdlib.RsaMontgomery.publicPow signature exponent modulus |> Stdlib.Result.map (fun em ->
        let digestLength = Stdlib.Blob.__byteLength digestInfo in
        let delimiter = length - digestLength - 1L in
        let actual = Stdlib.Blob.slice em (Stdlib.Int.fromInt64 (delimiter + 1L))
                       (Stdlib.Int.fromInt64 digestLength) in
        (delimiter >= 10L &&
            Stdlib.Blob.__getByte em 0L == 0L &&
            Stdlib.Blob.__getByte em 1L == 1L &&
            Stdlib.RsaPkcs1.__padding em 2L delimiter &&
            Stdlib.Blob.__getByte em delimiter == 0L &&
            Stdlib.RsaPkcs1.__same actual digestInfo 0L 0L))
