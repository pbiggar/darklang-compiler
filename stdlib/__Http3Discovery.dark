// __Http3Discovery.dark - Advertised HTTP/3 endpoint selection with original-origin TLS authentication.
module Darklang.Stdlib.Http3Discovery

let allowedHost (trusted: Bool) (host: String) : Bool =
  trusted || (host != "localhost" && host != "metadata" && host != "metadata.google.internal" &&
    (Stdlib.String.contains host "." || Stdlib.Option.isSome (Stdlib.DnsWire.ipv6 host)))

let allowedAddress (trusted: Bool) (address: List<Int64>) : Bool =
  let ipv6 = Stdlib.List.length address == 16 in
  let checked = if trusted then
                  if ipv6 then Stdlib.HttpConnect.checkTrusted6 address else Stdlib.HttpConnect.checkTrusted4 address
                else if ipv6 then Stdlib.HttpConnect.checkGuest6 address else Stdlib.HttpConnect.checkGuest4 address in
  Stdlib.Result.isOk checked

let __addresses (addresses: List<List<Int64>>) (port: Int64) (origin: String) (roots: List<Blob>)
  (trusted: Bool) (deadline: Int64) (remaining: Int64) : Stdlib.Option.Option<Stdlib.QuicClient.Ready> =
  match addresses with
  | [] -> None
  | address :: rest ->
    if remaining == 0L then None
    else if Stdlib.Bool.not (Stdlib.Http3Discovery.allowedAddress trusted address) then
      Stdlib.Http3Discovery.__addresses rest port origin roots trusted deadline (remaining - 1L)
    else match Stdlib.Network.monotonicMillis () with
    | Error _ -> None
    | Ok now ->
      if now >= deadline then None
      else
        let timeout = if deadline - now > 1500L then 1500L else deadline - now in
        match Stdlib.QuicClient.connect (Stdlib.Datagram.Endpoint { address = address, port = port }) origin roots timeout with
        | Ok ready -> Some ready
        | Error _ -> Stdlib.Http3Discovery.__addresses rest port origin roots trusted deadline (remaining - 1L)

let __resolved (host: String) (kind: Int64) : List<List<Int64>> =
  match Stdlib.DnsWire.resolve host kind with | Ok addresses -> addresses | Error _ -> []

let __services (services: List<Stdlib.HttpsService.Service>) (origin: String) (roots: List<Blob>)
  (trusted: Bool) (deadline: Int64) (remaining: Int64) : Stdlib.Option.Option<Stdlib.QuicClient.Ready> =
  match services with
  | [] -> None
  | service :: rest ->
    if remaining == 0L then None
    else if Stdlib.Bool.not (Stdlib.Http3Discovery.allowedHost trusted service.host) || service.port < 1L || service.port > 65535L then
      Stdlib.Http3Discovery.__services rest origin roots trusted deadline (remaining - 1L)
    else match Stdlib.Network.monotonicMillis () with
    | Error _ -> None
    | Ok now ->
      if now >= deadline then None
      else
        let hints = service.ipv4 @ service.ipv6 in
        match Stdlib.Http3Discovery.__addresses hints service.port origin roots trusted deadline 3L with
        | Some ready -> Some ready
        | None ->
          let addresses = Stdlib.Http3Discovery.__resolved service.host 1L @ Stdlib.Http3Discovery.__resolved service.host 28L in
          match Stdlib.Http3Discovery.__addresses addresses service.port origin roots trusted deadline 3L with
          | Some ready -> Some ready
          | None -> Stdlib.Http3Discovery.__services rest origin roots trusted deadline (remaining - 1L)

// Only parsed advertisements admit QUIC. TLS always uses the URL's host,
// even when the service target or port differs from the original authority.
let connect (services: List<Stdlib.HttpsService.Service>) (origin: String) (roots: List<Blob>)
  (trusted: Bool) : Stdlib.Option.Option<Stdlib.QuicClient.Ready> =
  if Stdlib.Bool.not (Stdlib.Http3Discovery.allowedHost trusted origin) then None
  else match Stdlib.Network.monotonicMillis () with
  | Error _ -> None
  | Ok now -> Stdlib.Http3Discovery.__services (Stdlib.List.sortBy services (fun service -> service.priority)) origin roots trusted (now + 5000L) 3L

let discover (url: Stdlib.HttpWire.Url) (roots: List<Blob>) (trusted: Bool) : Stdlib.Option.Option<Stdlib.QuicClient.Ready> =
  if url.scheme != "https" || Stdlib.Bool.not (Stdlib.Http3Discovery.allowedHost trusted url.host) ||
    Stdlib.Option.isSome (Stdlib.DnsWire.ipv4 url.host) || Stdlib.Option.isSome (Stdlib.DnsWire.ipv6 url.host) then None
  else match Stdlib.HttpsDns.discover url.host url.port with
  | Error _ -> None
  | Ok answer -> Stdlib.Http3Discovery.connect answer.services url.host roots trusted
