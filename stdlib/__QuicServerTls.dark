// __QuicServerTls.dark - QUIC server TLS keys and client transport binding gated by Finished.
module Darklang.Stdlib.QuicServerTls

type Handshake = { flight: Stdlib.Tls13ServerHandshake.Flight, send: Stdlib.QuicCrypto.Keys, receive: Stdlib.QuicCrypto.Keys, parameters: Stdlib.QuicParameters.Parameters }
type Ready = { send: Stdlib.QuicCrypto.Keys, receive: Stdlib.QuicCrypto.Keys, sendSecret: Blob, receiveSecret: Blob, parameters: Stdlib.QuicParameters.Parameters }

let start (identity: Stdlib.TlsServerIdentity.Identity) (clientHello: Blob) (parameters: Blob) (clientSource: Blob) : Stdlib.Result.Result<Stdlib.QuicServerTls.Handshake, String> =
  Stdlib.Tls13ServerHello.parse clientHello |> Stdlib.Result.andThen (fun hello ->
    Stdlib.Tls13ServerHello.selectProtocol hello ["h3"] |> Stdlib.Result.andThen (fun protocol ->
      if protocol != "h3" then Error "QUIC TLS requires h3 ALPN"
      else match Stdlib.Tls13ServerHello.__find hello.extensions 57L with
      | None -> Error "Missing QUIC client transport parameters"
      | Some client ->
        Stdlib.QuicParameters.parseClient client clientSource |> Stdlib.Result.andThen (fun clientParameters ->
          Stdlib.QuicParameters.parse Stdlib.QuicParameters.Sender.Server parameters |> Stdlib.Result.andThen (fun _ ->
            Stdlib.Tls13ServerHandshake.start identity clientHello ["h3"] (Some parameters) |> Stdlib.Result.andThen (fun flight ->
              match Stdlib.QuicCrypto.derive flight.secrets.handshakeServer, Stdlib.QuicCrypto.derive flight.secrets.handshakeClient with
              | Ok send, Ok receive -> Ok (Stdlib.QuicServerTls.Handshake { flight = flight, send = send, receive = receive, parameters = clientParameters })
              | _, _ -> Error "QUIC server handshake key derivation failed")))))

let finish (handshake: Stdlib.QuicServerTls.Handshake) (clientFinished: Blob) : Stdlib.Result.Result<Stdlib.QuicServerTls.Ready, String> =
  Stdlib.Tls13ServerHandshake.finish handshake.flight clientFinished |> Stdlib.Result.andThen (fun ready ->
    match Stdlib.QuicCrypto.derive ready.sendSecret, Stdlib.QuicCrypto.derive ready.receiveSecret with
    | Ok send, Ok receive -> Ok (Stdlib.QuicServerTls.Ready { send = send, receive = receive, sendSecret = ready.sendSecret, receiveSecret = ready.receiveSecret, parameters = handshake.parameters })
    | _, _ -> Error "QUIC server application key derivation failed")
