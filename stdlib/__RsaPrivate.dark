// __RsaPrivate.dark - Bounded, consistent RSA private-key import for server identities.
// Integer validation runs during local key import, before accepting connections.
module Darklang.Stdlib.RsaPrivate

type Key = { modulus: Blob, exponent: Blob, privateExponent: Blob }

let __integers (data: Blob) (position: Int64) (limit: Int64) (remaining: Int64) (values: List<Blob>) : Stdlib.Option.Option<List<Blob>> =
  if remaining == 0L then if position == limit then Some (Stdlib.List.reverse values) else None
  else match Stdlib.RsaSpki.__positiveInteger data position limit with
  | None -> None
  | Some ((value, next)) -> Stdlib.RsaPrivate.__integers data next limit (remaining - 1L) (Stdlib.List.push values value)

let __version (data: Blob) (position: Int64) (limit: Int64) : Stdlib.Option.Option<Int64> =
  match Stdlib.RsaSpki.__tlv data position limit 2L with
  | Some ((start, finish)) -> if finish == start + 1L && Stdlib.Blob.__getByte data start == 0L then Some finish else None
  | None -> None

let __validate (values: List<Blob>) : Stdlib.Result.Result<Stdlib.RsaPrivate.Key, String> =
  match values with
  | [modulus, exponent, privateExponent, prime1, prime2, reduced1, reduced2, coefficient] ->
    let exponentLength = Stdlib.Blob.__byteLength exponent in
    if Stdlib.Blob.__byteLength modulus != 256L || Stdlib.Blob.__getByte modulus 0L < 128L ||
      Stdlib.Blob.__getByte modulus 255L % 2L == 0L || exponentLength < 1L || exponentLength > 4L ||
      Stdlib.Blob.__byteLength privateExponent > 256L || Stdlib.Blob.__byteLength prime1 != 128L || Stdlib.Blob.__byteLength prime2 != 128L ||
      Stdlib.Blob.__byteLength reduced1 > 128L || Stdlib.Blob.__byteLength reduced2 > 128L || Stdlib.Blob.__byteLength coefficient > 128L then Error "Invalid RSA private key"
    else
      let n = Stdlib.RsaPss.__fromBytes modulus 0L 0 in
      let e = Stdlib.RsaPss.__fromBytes exponent 0L 0 in
      let d = Stdlib.RsaPss.__fromBytes privateExponent 0L 0 in
      let p = Stdlib.RsaPss.__fromBytes prime1 0L 0 in
      let q = Stdlib.RsaPss.__fromBytes prime2 0L 0 in
      let dp = Stdlib.RsaPss.__fromBytes reduced1 0L 0 in
      let dq = Stdlib.RsaPss.__fromBytes reduced2 0L 0 in
      let inverse = Stdlib.RsaPss.__fromBytes coefficient 0L 0 in
      if p <= 2 || q <= 2 || p == q || p % 2 != 1 || q % 2 != 1 || p * q != n ||
        e < 3 || e >= n || e % 2 != 1 || d <= 1 || d >= n ||
        d % (p - 1) != dp || d % (q - 1) != dq || d * e % (p - 1) != 1 || d * e % (q - 1) != 1 ||
        inverse <= 0 || inverse >= p || q * inverse % p != 1 then Error "Inconsistent RSA private key"
      else
        let padding = Stdlib.Blob.__fromInt64List (Stdlib.List.repeatUnsafe (Stdlib.Int.fromInt64 (256L - Stdlib.Blob.__byteLength privateExponent)) 0L) in
        Ok (Stdlib.RsaPrivate.Key { modulus = modulus, exponent = exponent, privateExponent = Stdlib.Blob.concat [padding, privateExponent] })
  | _ -> Error "Invalid RSA private key"

// Initial server signing profile: two-prime RSA-2048 with a 32-bit public exponent.
let parsePkcs1 (data: Blob) : Stdlib.Result.Result<Stdlib.RsaPrivate.Key, String> =
  let length = Stdlib.Blob.__byteLength data in
  if length > 2048L then Error "Invalid RSA private key"
  else match Stdlib.RsaSpki.__tlv data 0L length 48L with
  | None -> Error "Invalid RSA private key"
  | Some ((start, finish)) ->
    if finish != length then Error "Invalid RSA private key"
    else match Stdlib.RsaPrivate.__version data start finish with
    | None -> Error "Unsupported RSA private key version"
    | Some position ->
      match Stdlib.RsaPrivate.__integers data position finish 8L [] with
      | None -> Error "Invalid RSA private key"
      | Some values -> Stdlib.RsaPrivate.__validate values

let parsePkcs8 (data: Blob) : Stdlib.Result.Result<Stdlib.RsaPrivate.Key, String> =
  let length = Stdlib.Blob.__byteLength data in
  if length > 2100L then Error "Invalid PKCS8 private key"
  else match Stdlib.RsaSpki.__tlv data 0L length 48L with
  | None -> Error "Invalid PKCS8 private key"
  | Some ((start, finish)) ->
    if finish != length then Error "Invalid PKCS8 private key"
    else match Stdlib.RsaPrivate.__version data start finish with
    | None -> Error "Unsupported PKCS8 private key version"
    | Some position ->
      match Stdlib.RsaSpki.__tlv data position finish 48L with
      | None -> Error "Invalid PKCS8 private key algorithm"
      | Some ((algorithmStart, algorithmEnd)) ->
        if Stdlib.Bool.not (Stdlib.RsaSpki.__algorithm data algorithmStart algorithmEnd) then Error "Unsupported PKCS8 private key algorithm"
        else match Stdlib.RsaSpki.__tlv data algorithmEnd finish 4L with
        | None -> Error "Invalid PKCS8 private key"
        | Some ((keyStart, keyEnd)) ->
          if keyEnd != finish then Error "Unsupported PKCS8 private key attributes"
          else Stdlib.RsaPrivate.parsePkcs1 (Stdlib.Blob.slice data (Stdlib.Int.fromInt64 keyStart) (Stdlib.Int.fromInt64 (keyEnd - keyStart)))

let __pem (text: String) (label: String) (pkcs8: Bool) : Stdlib.Result.Result<Stdlib.RsaPrivate.Key, String> =
  let begin = "-----BEGIN " ++ label ++ "-----" in
  let endMarker = "-----END " ++ label ++ "-----" in
  if Stdlib.Bool.not (Stdlib.String.startsWith text begin) || Stdlib.Bool.not (Stdlib.String.endsWith text endMarker) then Error "Invalid PEM private key"
  else
    let encoded = Stdlib.String.__byteSlice text (Stdlib.String.__byteLength begin) (Stdlib.String.__byteLength text - Stdlib.String.__byteLength endMarker) in
    Stdlib.Base64.decode (Stdlib.Blob.__removeBase64Whitespace encoded) |> Stdlib.Result.mapError (fun _error -> "Invalid PEM private key") |> Stdlib.Result.andThen (fun der ->
      if pkcs8 then Stdlib.RsaPrivate.parsePkcs8 der else Stdlib.RsaPrivate.parsePkcs1 der)

let parsePem (contents: Blob) : Stdlib.Result.Result<Stdlib.RsaPrivate.Key, String> =
  if Stdlib.Blob.__byteLength contents > 8192L then Error "PEM private key exceeds size limit"
  else Stdlib.Blob.toString contents |> Stdlib.Result.andThen (fun text ->
    let text = Stdlib.String.trim text in
    if Stdlib.String.startsWith text "-----BEGIN RSA PRIVATE KEY-----" then Stdlib.RsaPrivate.__pem text "RSA PRIVATE KEY" false
    else if Stdlib.String.startsWith text "-----BEGIN PRIVATE KEY-----" then Stdlib.RsaPrivate.__pem text "PRIVATE KEY" true
    else Error "Unsupported PEM private key type")
