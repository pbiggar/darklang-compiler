// PackageManager.dark - canonical immutable location-selection rules.

module Darklang.LanguageTools.PackageManager

type PickContext = { currentModule: List<String> }

let countMatchingPrefix (a: List<String>) (b: List<String>) : Int =
    match (a, b) with
    | (aHead :: aTail, bHead :: bTail) ->
        if aHead == bHead then 1 + Darklang.LanguageTools.PackageManager.countMatchingPrefix aTail bTail
        else 0
    | _ -> 0

let pickLocation (ctx: Darklang.LanguageTools.PackageManager.PickContext) (locations: List<Darklang.LanguageTools.ProgramTypes.PackageLocation>) : Stdlib.Option.Option<Darklang.LanguageTools.ProgramTypes.PackageLocation> =
    match locations with
    | [] -> Stdlib.Option.Option.None
    | [single] -> Stdlib.Option.Option.Some single
    | first :: rest ->
        let firstPath = Stdlib.List.push first.modules first.owner in
        let firstScore = Darklang.LanguageTools.PackageManager.countMatchingPrefix ctx.currentModule firstPath in
        let firstLength = Stdlib.List.length firstPath in
        let (_bestScore, _bestLength, bestLocation) =
            Stdlib.List.fold rest ((firstScore, firstLength, first)) (fun acc location ->
                    let (bestScore, bestLength, best) = acc in
                    let locationPath = Stdlib.List.push location.modules location.owner in
                    let score = Darklang.LanguageTools.PackageManager.countMatchingPrefix ctx.currentModule locationPath in
                    let length = Stdlib.List.length locationPath in
                    if score > bestScore then (score, length, location)
                    else if score == bestScore && length < bestLength then (score, length, location)
                    else (bestScore, bestLength, best)) in
        Stdlib.Option.Option.Some bestLocation
