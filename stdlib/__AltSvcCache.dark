// __AltSvcCache.dark - Origin-bound, expiring alternatives with conservative response-age accounting.
module Darklang.Stdlib.AltSvcCache

type Entry = { origin: String, expires: Int64, service: Stdlib.HttpsService.Service }
type State = { entries: List<Stdlib.AltSvcCache.Entry> }
type Lookup = { state: Stdlib.AltSvcCache.State, services: List<Stdlib.HttpsService.Service> }

val empty = Stdlib.AltSvcCache.State { entries = [] }

let origin (url: Stdlib.HttpWire.Url) : String =
  url.scheme ++ "://" ++ Stdlib.String.toLowercase url.host ++ ":" ++ Stdlib.Int64.toString url.port

let __trim (entries: List<Stdlib.AltSvcCache.Entry>) (remaining: Int64) : List<Stdlib.AltSvcCache.Entry> =
  if remaining == 0L then []
  else match entries with | [] -> [] | entry :: rest -> Stdlib.List.push (Stdlib.AltSvcCache.__trim rest (remaining - 1L)) entry

let lookup (state: Stdlib.AltSvcCache.State) (url: Stdlib.HttpWire.Url) (now: Int64) : Stdlib.AltSvcCache.Lookup =
  let live = if now < 0L then [] else Stdlib.List.filter state.entries (fun entry -> entry.expires > now) in
  let key = Stdlib.AltSvcCache.origin url in
  let services = if url.scheme != "https" then [] else Stdlib.List.filterMap live (fun entry -> if entry.origin == key then Some entry.service else None) in
  Stdlib.AltSvcCache.Lookup { state = Stdlib.AltSvcCache.State { entries = live }, services = services }

let __httpDate (text: String) : Stdlib.Result.Result<Int64, String> =
  if Stdlib.String.__byteLength text != 29L || Stdlib.String.__byteSlice text 3L 5L != ", " ||
    Stdlib.String.__byteSlice text 7L 8L != " " || Stdlib.String.__byteSlice text 11L 12L != " " || Stdlib.String.__byteSlice text 16L 17L != " " ||
    Stdlib.String.__byteSlice text 25L 29L != " GMT" ||
    Stdlib.Bool.not (Stdlib.List.member ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"] (Stdlib.String.__byteSlice text 0L 3L)) then Error "Invalid response Date"
  else
    let months = [("Jan", "01"), ("Feb", "02"), ("Mar", "03"), ("Apr", "04"), ("May", "05"), ("Jun", "06"), ("Jul", "07"), ("Aug", "08"), ("Sep", "09"), ("Oct", "10"), ("Nov", "11"), ("Dec", "12")] in
    match Stdlib.List.findFirst months (fun pair -> let (name, _) = pair in name == Stdlib.String.__byteSlice text 8L 11L) with
    | None -> Error "Invalid response Date"
    | Some ((_, month)) ->
      let iso = Stdlib.String.__byteSlice text 12L 16L ++ "-" ++ month ++ "-" ++ Stdlib.String.__byteSlice text 5L 7L ++ "T" ++ Stdlib.String.__byteSlice text 17L 25L ++ "Z" in
      Stdlib.DateTime.parse iso |> Stdlib.Result.mapError (fun _error -> "Invalid response Date") |> Stdlib.Result.andThen (fun date ->
        match Stdlib.Int.toInt64 (Stdlib.DateTime.toSeconds date) with | None -> Error "Invalid response Date" | Some seconds -> Ok seconds)

let __age (headers: List<(String * String)>) (utc: Int64) : Stdlib.Result.Result<Int64, String> =
  let ages = Stdlib.List.filterMap headers (fun pair -> let (name, value) = pair in if Stdlib.String.toLowercase name == "age" then Some value else None) in
  let dates = Stdlib.List.filterMap headers (fun pair -> let (name, value) = pair in if Stdlib.String.toLowercase name == "date" then Some value else None) in
  let age = match ages with | [] -> Ok 0L | [age] -> Stdlib.AltSvc.__age age 0L 0L | _ -> Error "Duplicate response Age" in
  let apparent = match dates with
    | [] -> Ok 0L
    | [date] -> Stdlib.AltSvcCache.__httpDate date |> Stdlib.Result.map (fun at -> if utc <= at then 0L else if utc - at > 86400L then 86400L else utc - at)
    | _ -> Error "Duplicate response Date" in
  age |> Stdlib.Result.andThen (fun age -> apparent |> Stdlib.Result.map (fun apparent -> if age > apparent then age else apparent))

let __entries (endpoints: List<Stdlib.AltSvc.Endpoint>) (key: String) (now: Int64) (age: Int64) : List<Stdlib.AltSvcCache.Entry> =
  Stdlib.List.filterMap endpoints (fun endpoint ->
    if endpoint.lifetime <= age then None
    else Some (Stdlib.AltSvcCache.Entry { origin = key, service = endpoint.service,
      expires = now + (endpoint.lifetime - age) * 1000L }))

// A full request duration overestimates transit time for buffered responses,
// intentionally shortening freshness rather than extending an old advertisement.
let learn (state: Stdlib.AltSvcCache.State) (url: Stdlib.HttpWire.Url) (status: Int)
  (headers: List<(String * String)>) (started: Int64) (now: Int64) (utc: Int64) : Stdlib.AltSvcCache.State =
  let live = (Stdlib.AltSvcCache.lookup state url now).state.entries in
  let key = Stdlib.AltSvcCache.origin url in
  let others = Stdlib.List.filter live (fun entry -> entry.origin != key) in
  let fields = Stdlib.List.filterMap headers (fun pair -> let (name, value) = pair in if Stdlib.String.toLowercase name == "alt-svc" then Some value else None) in
  if url.scheme != "https" then Stdlib.AltSvcCache.State { entries = live }
  else if status == 421 then Stdlib.AltSvcCache.State { entries = others }
  else if fields == [] then Stdlib.AltSvcCache.State { entries = live }
  else if started < 0L || now < started || now > 9223372036768375807L || utc < 0L || utc > 253402300799L then Stdlib.AltSvcCache.State { entries = others }
  else
    match Stdlib.AltSvc.parse url.host (Stdlib.String.join fields ","), Stdlib.AltSvcCache.__age headers utc with
    | Ok (Services endpoints), Ok age ->
      let duration = now - started in
      let elapsed = if duration >= 86400000L then 86400L else (duration + 999L) / 1000L in
      let created = Stdlib.AltSvcCache.__entries endpoints key now (age + elapsed) in
      Stdlib.AltSvcCache.State { entries = Stdlib.AltSvcCache.__trim (created @ others) 32L }
    | _, _ -> Stdlib.AltSvcCache.State { entries = others }
