// __HttpTransport.dark - Owned bidirectional plaintext/TLS application transport.
module Darklang.Stdlib.HttpTransport

type Transport = {
  lifecycle: Stream<Unit>,
  read: Unit -> Stdlib.Result.Result<Blob, String>,
  write: Blob -> Stdlib.Result.Result<Unit, String>
}
type SecureState = {
  receive: Stdlib.Tls13Client.ApplicationState,
  send: Stdlib.Tls13.TrafficKeys
}

let __send (connection: Stdlib.Network.TcpConnection) (keys: Stdlib.Tls13.TrafficKeys)
  (bytes: Blob) (offset: Int64) : Stdlib.Result.Result<Stdlib.Tls13.TrafficKeys, String> =
  let remaining = Stdlib.Blob.__byteLength bytes - offset in
  if remaining == 0L then Ok keys
  else
    let size = if remaining > 2048L then 2048L else remaining in
    match Stdlib.Tls13.sealRecord keys 23L (Stdlib.Http2Wire.__slice bytes offset size) with
    | Error message -> Error message
    | Ok sealed ->
      match Stdlib.Network.writeTcp connection sealed.bytes with
      | Error _ -> Error "TLS application write failed"
      | Ok () -> Stdlib.HttpTransport.__send connection sealed.nextKeys bytes (offset + size)

let __readSecure (connection: Stdlib.Network.TcpConnection) (cell: RawPtr)
  (lifecycle: Stream<Unit>) : Stdlib.Result.Result<Blob, String> =
  match Stdlib.Stream.next lifecycle with
  | None -> Error "HTTP transport is closed"
  | Some _ ->
    let state = Stdlib.Stream.__cellGet<Stdlib.HttpTransport.SecureState> cell in
    match Stdlib.Tls13Client.readApplicationChunk connection state.receive with
    | Error message -> Error message
    | Ok None -> Ok Stdlib.Blob.empty
    | Ok (Some pair) ->
      let (bytes, receive) = pair in
      let next = Stdlib.HttpTransport.SecureState { receive = receive, send = state.send } in
      let _ = Stdlib.Stream.__cellSet cell next in
      Ok bytes

let __writeSecure (connection: Stdlib.Network.TcpConnection) (cell: RawPtr)
  (lifecycle: Stream<Unit>) (bytes: Blob) : Stdlib.Result.Result<Unit, String> =
  match Stdlib.Stream.next lifecycle with
  | None -> Error "HTTP transport is closed"
  | Some _ ->
    let state = Stdlib.Stream.__cellGet<Stdlib.HttpTransport.SecureState> cell in
    match Stdlib.HttpTransport.__send connection state.send bytes 0L with
    | Error message -> Error message
    | Ok send ->
      let next = Stdlib.HttpTransport.SecureState { receive = state.receive, send = send } in
      let _ = Stdlib.Stream.__cellSet cell next in
      Ok ()

let __disposeSecure (connection: Stdlib.Network.TcpConnection) (cell: RawPtr) : Unit =
  let _ = Stdlib.Network.closeTcp connection in
  Stdlib.Stream.__cellDispose<Stdlib.HttpTransport.SecureState> cell

// Each closure retains the lifecycle. Once closed, none may touch the freed cell.
let secure (connection: Stdlib.Network.TcpConnection) (receive: Stdlib.Tls13.TrafficKeys)
  (send: Stdlib.Tls13.TrafficKeys) (pending: Blob) : Stdlib.HttpTransport.Transport =
  let initial = Stdlib.HttpTransport.SecureState {
    receive = Stdlib.Tls13Client.ApplicationState { keys = receive, pending = pending, records = 0L },
    send = send } in
  let cell = Stdlib.Stream.__cellNew initial in
  let dispose = fun _unit -> Stdlib.HttpTransport.__disposeSecure connection cell in
  let lifecycle = Stdlib.Stream.__new (fun _unit -> Some ()) dispose in
  Stdlib.HttpTransport.Transport {
    lifecycle = lifecycle,
    read = fun _unit -> Stdlib.HttpTransport.__readSecure connection cell lifecycle,
    write = fun bytes -> Stdlib.HttpTransport.__writeSecure connection cell lifecycle bytes }

let __readPlain (connection: Stdlib.Network.TcpConnection)
  (signals: Stdlib.Option.Option<Stdlib.Network.ShutdownSignals>) (deadline: Int64)
  : Stdlib.Result.Result<Blob, String> =
  let shutdown = match signals with
                 | None -> Ok false
                 | Some value -> Stdlib.Network.shutdownRequested value in
  match shutdown, Stdlib.Network.monotonicMillis () with
  | Ok true, _ -> Error "HTTP server shutting down"
  | Ok false, Ok now ->
    if now >= deadline then Error "HTTP application read timed out"
    else
      match Stdlib.Network.readTcp connection 4096L with
      | Error code ->
        if code == 4L || code == 11L || code == 35L then Stdlib.HttpTransport.__readPlain connection signals deadline
        else Error "HTTP application read failed"
      | Ok bytes -> Ok bytes
  | _, _ -> Error "HTTP clock or shutdown check failed"

let __plainRead (connection: Stdlib.Network.TcpConnection)
  (signals: Stdlib.Option.Option<Stdlib.Network.ShutdownSignals>) : Stdlib.Result.Result<Blob, String> =
  match Stdlib.Network.monotonicMillis () with
  | Error _ -> Error "HTTP clock failed"
  | Ok now -> Stdlib.HttpTransport.__readPlain connection signals (now + 10000L)

let __plain (connection: Stdlib.Network.TcpConnection)
  (signals: Stdlib.Option.Option<Stdlib.Network.ShutdownSignals>) : Stdlib.HttpTransport.Transport =
  Stdlib.HttpTransport.Transport {
    lifecycle = connection.lifecycle,
    read = fun _unit -> Stdlib.HttpTransport.__plainRead connection signals,
    write = fun bytes ->
      match Stdlib.Network.writeTcp connection bytes with
      | Error _ -> Error "HTTP application write failed"
      | Ok () -> Ok () }

let plain (connection: Stdlib.Network.TcpConnection) : Stdlib.HttpTransport.Transport =
  Stdlib.HttpTransport.__plain connection None

let plainWithShutdown (connection: Stdlib.Network.TcpConnection) (signals: Stdlib.Network.ShutdownSignals)
  : Stdlib.HttpTransport.Transport = Stdlib.HttpTransport.__plain connection (Some signals)

let plainWithDeadline (connection: Stdlib.Network.TcpConnection) (signals: Stdlib.Network.ShutdownSignals) (deadline: Int64) : Stdlib.HttpTransport.Transport =
  Stdlib.HttpTransport.Transport { lifecycle = connection.lifecycle,
    read = fun _unit -> Stdlib.HttpTransport.__readPlain connection (Some signals) deadline,
    write = fun bytes -> match Stdlib.Network.writeTcp connection bytes with | Ok () -> Ok () | Error _ -> Error "HTTP application write failed" }

let close (transport: Stdlib.HttpTransport.Transport) : Unit =
  Stdlib.Stream.close transport.lifecycle
