// Integer type checking tests

// Integer literals
42L : int
0L : int
255L : int
-10L : int

// Arithmetic operations
2L + 3L : int
10L - 5L : int
7L * 6L : int
20L / 4L : int

// Negation
-42L : int
-(5L + 3L) : int

// Nested operations
2L + 3L * 4L : int  // precedence
(2L + 3L) * 4L : int
10L + 20L - 5L : int

// Complex expressions
(10L + 20L) * (30L - 15L) / 2L : int
