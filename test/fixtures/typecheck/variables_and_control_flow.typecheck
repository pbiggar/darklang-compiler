// Variable and control flow type checking tests

// Let bindings - integers
let x = 5L in x : int
let x = 2L in let y = 3L in x + y : int
let x = 10L in x * 2L : int

// Let bindings - booleans
let x = true in x : bool
let x = false in x : bool
let x = 1L == 1L in x : bool
let x = true in let y = false in x && y : bool

// Shadowing
let x = 5L in let x = 10L in x : int
let x = true in let x = false in x : bool

// If expressions - same type in both branches
if true then 42L else 0L : int
if false then 10L else 20L : int
if 5L > 3L then 1L else 2L : int

// If with booleans
if true then true else false : bool
if 1L == 2L then false else true : bool

// Nested if
if true then (if false then 1L else 2L) else 3L : int

// If with let bindings
let x = 10L in if x > 5L then 100L else 0L : int
let x = true in if x then 1L else 0L : int

// Complex control flow
let x = 5L in let y = 3L in if x > y then x + y else x - y : int
