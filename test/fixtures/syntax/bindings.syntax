// Public binding syntax acceptance, rejection, and roundtrip coverage.

---NAME---
public let without in is accepted
---SOURCE---
let x = 5
x + 1
---ROUNDTRIP---

---NAME---
nested tuple let pattern is accepted
---SOURCE---
let ((a, _), (b, ())) = ((1, 2), (3, ())) in a + b
---ROUNDTRIP---

---NAME---
public lambda binders are accepted
---SOURCE---
fun ((a, _), b) -> a + b
---ROUNDTRIP---

---NAME---
literal let pattern is rejected
---SOURCE---
let 5 = 5 in 6
---EXPECT-ERROR---
expected a pattern

---NAME---
parenthesized constructor let pattern is rejected
---SOURCE---
let Some (x) = value in x
---EXPECT-ERROR---
expected ':'

---NAME---
space-applied constructor let pattern is rejected
---SOURCE---
let Some x = value in x
---EXPECT-ERROR---
expected '=' in let binding

---NAME---
typed lambda binder is rejected
---SOURCE---
fun (x: Int64) -> x
---EXPECT-ERROR---
expected ')' to close the '('

---NAME---
fat arrow lambda is rejected
---SOURCE---
(x: Int64) => x
---EXPECT-ERROR---
expected an expression

---NAME---
local function annotations remain accepted
---SOURCE---
let add (x: Int64) (y: Int64) : Int64 = x + y
add 2L 3L
---ROUNDTRIP---

---NAME---
duplicate unsuffixed Int let binders are rejected
---SOURCE---
let (x, x) = (1, 2) in x
---EXPECT-ERROR---
Duplicate binding 'x' in the same pattern

---NAME---
duplicate Int64 let binders are rejected
---SOURCE---
let (x, x) = (1L, 2L) in x
---EXPECT-ERROR---
Duplicate binding 'x' in the same pattern

---NAME---
duplicates across lambda parameters are rejected
---SOURCE---
fun x (x, y) -> x + y
---EXPECT-ERROR---
Duplicate binding 'x' in the same pattern
