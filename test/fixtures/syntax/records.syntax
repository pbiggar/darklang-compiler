// Canonical record grammar acceptance, rejection, and roundtrip coverage.

---NAME---
canonical record separators are accepted
---SOURCE---
type Mixed = {
  first: Int64;
  second: String,
  third: Bool
}
Mixed {
  third = true;
  first = 1,
  second = "two"
}
---ROUNDTRIP---

---NAME---
qualified generic record construction is accepted
---SOURCE---
Package.Box<String> { value = "kept" }
---ROUNDTRIP---

---NAME---
anonymous record literal is rejected
---SOURCE---
{ value = 1 }
---EXPECT-ERROR---
Anonymous records are not supported

---NAME---
empty record update is rejected
---SOURCE---
{ value with }
---EXPECT-ERROR---
expected at least one 'field = value' in a record update

---NAME---
empty record declaration is rejected
---SOURCE---
type Empty = {}
---EXPECT-ERROR---
a record type needs at least one field

---NAME---
record pattern is rejected
---SOURCE---
match value with | Point { x = x } -> x | _ -> 0
---EXPECT-ERROR---
expected '->' in match case
