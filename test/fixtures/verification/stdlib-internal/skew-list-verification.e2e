// SkewList Verification Tests - Extensive correctness tests for SkewList implementation
//
// These tests are NOT run by default. Run with:
//   ./run-tests --ai --verification --filter=verification
//
// ===================================================================
// Helper Functions
// ===================================================================

// Build [1, 2, 3, ..., n] with O(1) prepend, then reverse once.
let buildTree (n: Int64) (count: Int64) (tree: List<Int64>): List<Int64> =
    if n > count then Stdlib.List.__reverse tree
    else buildTree (n + 1L) count (Stdlib.List.__push tree n)

// Build tree with push (front): [n, n-1, ..., 2, 1]
let buildTreeFront (n: Int64) (count: Int64) (tree: List<Int64>): List<Int64> =
    if n > count then tree else buildTreeFront (n + 1L) count (Stdlib.List.__push tree n)

// Verify all indices have correct values (for pushBack-built tree)
// Returns count of correct values
let verifyIndices (tree: List<Int64>) (idx: Int64) (count: Int64) (correct: Int64): Int64 =
    if idx >= count then correct
    else
        let expected = idx + 1L in
        let actual = Stdlib.Option.withDefault (Stdlib.List.__getAt tree idx) (-1L) in
        let newCorrect = if actual == expected then correct + 1L else correct in
        verifyIndices tree (idx + 1L) count newCorrect

// Sum all elements via getAt
let sumTree (tree: List<Int64>) (idx: Int64) (count: Int64) (acc: Int64): Int64 =
    if idx >= count then acc
    else
        let val = Stdlib.Option.withDefault (Stdlib.List.__getAt tree idx) 0L in
        sumTree tree (idx + 1L) count (acc + val)

// Build tree with mixed push/pushBack
let buildMixed (n: Int64) (count: Int64) (tree: List<Int64>): List<Int64> =
    if n > count then tree
    else
        let newTree = if n % 2L == 0L then Stdlib.List.__push tree n else Stdlib.List.__pushBack tree n in
        buildMixed (n + 1L) count newTree

// ===================================================================
// Scale Tests - Large Tree Construction
// ===================================================================

// Build 100 elements
Stdlib.List.__length (buildTree 1L 100L (Stdlib.List.__empty ())) = 100L

// Build 500 elements
Stdlib.List.__length (buildTree 1L 500L (Stdlib.List.__empty ())) = 500L

// Build 1000 elements
Stdlib.List.__length (buildTree 1L 1000L (Stdlib.List.__empty ())) = 1000L

// ===================================================================
// Index Verification - getAt returns correct values
// ===================================================================

// 100 elements: verify all indices
verifyIndices (buildTree 1L 100L (Stdlib.List.__empty ())) 0L 100L 0L = 100L

// 500 elements: verify all indices
verifyIndices (buildTree 1L 500L (Stdlib.List.__empty ())) 0L 500L 0L = 500L

// 1000 elements: verify all indices
verifyIndices (buildTree 1L 1000L (Stdlib.List.__empty ())) 0L 1000L 0L = 1000L

// ===================================================================
// Sum Verification - Mathematical correctness
// ===================================================================

// Sum of 1..100 = 5050
sumTree (buildTree 1L 100L (Stdlib.List.__empty ())) 0L 100L 0L = 5050L

// Sum of 1..500 = 125250
sumTree (buildTree 1L 500L (Stdlib.List.__empty ())) 0L 500L 0L = 125250L

// Sum of 1..1000 = 500500
sumTree (buildTree 1L 1000L (Stdlib.List.__empty ())) 0L 1000L 0L = 500500L

// ===================================================================
// Push/PushBack Consistency
// ===================================================================

// pushBack then head = first element
Stdlib.Option.withDefault (Stdlib.List.__head (buildTree 1L 100L (Stdlib.List.__empty ()))) (-1L) = 1L

// pushBack then last = last element pushed
Stdlib.Option.withDefault (Stdlib.List.__last (buildTree 1L 100L (Stdlib.List.__empty ()))) (-1L) = 100L

// push (front) then head = last element pushed
Stdlib.Option.withDefault (Stdlib.List.__head (buildTreeFront 1L 100L (Stdlib.List.__empty ()))) (-1L) = 100L

// push (front) then last = first element pushed
Stdlib.Option.withDefault (Stdlib.List.__last (buildTreeFront 1L 100L (Stdlib.List.__empty ()))) (-1L) = 1L

// ===================================================================
// setAt Preserves Other Elements
// ===================================================================

// setAt middle, check neighbors unchanged
let testSetAt (): Int64 =
    let t1 = buildTree 1L 100L (Stdlib.List.__empty ()) in
    let t2 = Stdlib.List.__setAt t1 50L 999L in
    let v49 = Stdlib.Option.withDefault (Stdlib.List.__getAt t2 49L) (-1L) in
    let v50 = Stdlib.Option.withDefault (Stdlib.List.__getAt t2 50L) (-1L) in
    let v51 = Stdlib.Option.withDefault (Stdlib.List.__getAt t2 51L) (-1L) in
    v49 * 10000L + v50 * 100L + v51

testSetAt () = 599952L

// setAt first element
let t = Stdlib.List.__setAt (buildTree 1L 10L (Stdlib.List.__empty ())) 0L 999L in Stdlib.Option.withDefault (Stdlib.List.__head t) (-1L) = 999L

// setAt last element
let t = Stdlib.List.__setAt (buildTree 1L 10L (Stdlib.List.__empty ())) 9L 999L in Stdlib.Option.withDefault (Stdlib.List.__last t) (-1L) = 999L

// ===================================================================
// Concat Verification
// ===================================================================

// Concat two 50-element trees = 100 elements
let t1 = buildTree 1L 50L (Stdlib.List.__empty ()) in let t2 = buildTree 51L 100L (Stdlib.List.__empty ()) in Stdlib.List.__length (Stdlib.List.__concat t1 t2) = 100L

// Concat preserves head from first tree
let t1 = buildTree 1L 50L (Stdlib.List.__empty ()) in let t2 = buildTree 51L 100L (Stdlib.List.__empty ()) in Stdlib.Option.withDefault (Stdlib.List.__head (Stdlib.List.__concat t1 t2)) (-1L) = 1L

// Concat preserves last from second tree
let t1 = buildTree 1L 50L (Stdlib.List.__empty ()) in let t2 = buildTree 51L 100L (Stdlib.List.__empty ()) in Stdlib.Option.withDefault (Stdlib.List.__last (Stdlib.List.__concat t1 t2)) (-1L) = 100L

// ===================================================================
// Property: Length Invariants
// ===================================================================

// push increases length by 1
let t = buildTree 1L 10L (Stdlib.List.__empty ()) in Stdlib.List.__length (Stdlib.List.__push t 0L) = 11L

// pushBack increases length by 1
let t = buildTree 1L 10L (Stdlib.List.__empty ()) in Stdlib.List.__length (Stdlib.List.__pushBack t 11L) = 11L

// tail decreases length by 1
let t = buildTree 1L 10L (Stdlib.List.__empty ()) in Stdlib.List.__length (Stdlib.List.__tail t) = 9L

// init decreases length by 1
let t = buildTree 1L 10L (Stdlib.List.__empty ()) in Stdlib.List.__length (Stdlib.List.__init t) = 9L

// ===================================================================
// Property: head/last Correctness
// ===================================================================

// head equals getAt(0)
let t = buildTree 1L 100L (Stdlib.List.__empty ()) in let h = Stdlib.Option.withDefault (Stdlib.List.__head t) (-1L) in let g = Stdlib.Option.withDefault (Stdlib.List.__getAt t 0L) (-2L) in h == g = true

// last equals getAt(length-1)
let t = buildTree 1L 100L (Stdlib.List.__empty ()) in let l = Stdlib.Option.withDefault (Stdlib.List.__last t) (-1L) in let len = Stdlib.List.__length t in let g = Stdlib.Option.withDefault (Stdlib.List.__getAt t (len - 1L)) (-2L) in l == g = true

// ===================================================================
// Property: pushBack-last and push-head
// ===================================================================

// pushBack then last returns pushed value
Stdlib.Option.withDefault (Stdlib.List.__last (Stdlib.List.__pushBack (buildTree 1L 10L (Stdlib.List.__empty ())) 999L)) (-1L) = 999L

// push then head returns pushed value
Stdlib.Option.withDefault (Stdlib.List.__head (Stdlib.List.__push (buildTree 1L 10L (Stdlib.List.__empty ())) 999L)) (-1L) = 999L

// ===================================================================
// Empty Tree Edge Cases
// ===================================================================

// isEmpty on empty
Stdlib.List.__isEmpty (Stdlib.List.__empty ()) = true

// isEmpty on non-empty
Stdlib.List.__isEmpty (Stdlib.List.__singleton 1L) = false

// head on empty returns None
Stdlib.Option.isNone (Stdlib.List.__head (Stdlib.List.__empty ())) = true

// last on empty returns None
Stdlib.Option.isNone (Stdlib.List.__last (Stdlib.List.__empty ())) = true

// getAt on empty returns None
Stdlib.Option.isNone (Stdlib.List.__getAt (Stdlib.List.__empty ()) 0L) = true

// ===================================================================
// Mixed Operations
// ===================================================================

// Mixed push/pushBack maintains length
Stdlib.List.__length (buildMixed 1L 100L (Stdlib.List.__empty ())) = 100L

// ===================================================================
// Deep operation chains formerly exposed a FingerTree-specific bug.
// ===================================================================

// 3 tails + headUnsafe
let nums = Stdlib.List.__pushBack (Stdlib.List.__pushBack (Stdlib.List.__pushBack (Stdlib.List.__pushBack (Stdlib.List.__pushBack (Stdlib.List.__empty ()) 1L) 2L) 3L) 4L) 5L in let rest0 = Stdlib.List.__tail nums in let rest1 = Stdlib.List.__tail rest0 in let rest2 = Stdlib.List.__tail rest1 in Stdlib.List.__headUnsafe rest2 = 4L

// Length after 4 tails
let nums = Stdlib.List.__pushBack (Stdlib.List.__pushBack (Stdlib.List.__pushBack (Stdlib.List.__pushBack (Stdlib.List.__pushBack (Stdlib.List.__empty ()) 1L) 2L) 3L) 4L) 5L in let rest0 = Stdlib.List.__tail nums in let rest1 = Stdlib.List.__tail rest0 in let rest2 = Stdlib.List.__tail rest1 in let rest3 = Stdlib.List.__tail rest2 in Stdlib.List.__length rest3 = 1L

// 4 tails + headUnsafe
let nums = Stdlib.List.__pushBack (Stdlib.List.__pushBack (Stdlib.List.__pushBack (Stdlib.List.__pushBack (Stdlib.List.__pushBack (Stdlib.List.__empty ()) 1L) 2L) 3L) 4L) 5L in let rest0 = Stdlib.List.__tail nums in let rest1 = Stdlib.List.__tail rest0 in let rest2 = Stdlib.List.__tail rest1 in let rest3 = Stdlib.List.__tail rest2 in Stdlib.List.__headUnsafe rest3 = 5L

// 6 element tree with 5 tails
let nums = Stdlib.List.__pushBack (Stdlib.List.__pushBack (Stdlib.List.__pushBack (Stdlib.List.__pushBack (Stdlib.List.__pushBack (Stdlib.List.__pushBack (Stdlib.List.__empty ()) 1L) 2L) 3L) 4L) 5L) 6L in let rest0 = Stdlib.List.__tail nums in let rest1 = Stdlib.List.__tail rest0 in let rest2 = Stdlib.List.__tail rest1 in let rest3 = Stdlib.List.__tail rest2 in let rest4 = Stdlib.List.__tail rest3 in Stdlib.List.__headUnsafe rest4 = 6L

// ===================================================================
// Spot Checks on Large Trees
// ===================================================================

// 10000 elements: verify length
Stdlib.List.__length (buildTree 1L 10000L (Stdlib.List.__empty ())) = 10000L

// 10000 elements: verify head
Stdlib.Option.withDefault (Stdlib.List.__head (buildTree 1L 10000L (Stdlib.List.__empty ()))) (-1L) = 1L

// 10000 elements: verify last
Stdlib.Option.withDefault (Stdlib.List.__last (buildTree 1L 10000L (Stdlib.List.__empty ()))) (-1L) = 10000L

// 10000 elements: verify middle element
Stdlib.Option.withDefault (Stdlib.List.__getAt (buildTree 1L 10000L (Stdlib.List.__empty ())) 4999L) (-1L) = 5000L
