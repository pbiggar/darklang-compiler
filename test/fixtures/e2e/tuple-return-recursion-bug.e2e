// E2E tests for tuple-returning functions
// BUG FIXED: "let t = (tuple) in t" pattern now works correctly
// Root cause: ANF optimization (beta reduction) was missing in the stdlib prebuilt test pipeline

// =====================================================
// FIXED: "let t = (a, b) in t" pattern now works
// =====================================================

let test (a: Int64) : (Int64 * Int64) = let t = (a, a * 2L) in t
let r = test 5L in let (first, _) = r in first = 5L

let makeNext (t: (Int64 * Int64)) : (Int64 * Int64) = let (first, second) = t in let next = (first+1L, second+2L) in next
let r2 = makeNext ((0L, 0L)) in let (first, _) = r2 in first = 1L

// =====================================================
// Direct tuple return without let binding
// =====================================================
let addToTupleDirect (t: (Int64 * Int64)) : (Int64 * Int64) = let (first, second) = t in (first + 1L, second + 2L)

let r3 = addToTupleDirect ((5L, 10L)) in let (first, second) = r3 in first + second = 18L

let r4 = addToTupleDirect ((0L, 0L)) in let (first, _) = r4 in first = 1L

let r5 = addToTupleDirect ((0L, 0L)) in let (_, second) = r5 in second = 2L

// =====================================================
// Accessing tuple elements inside the function
// =====================================================
let getFirst (a: Int64) : Int64 = let t = (a, a * 2L) in let (first, _) = t in first
getFirst 5L = 5L

let getSecond (a: Int64) : Int64 = let t = (a, a * 2L) in let (_, second) = t in second
getSecond 5L = 10L
