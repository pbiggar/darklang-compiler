// Upstream terminal-row normalization: plain fast path, clipping and controls.
Stdlib.Cli.Tui.Text.normalizeToWidth "hello" 10 = "hello"
Stdlib.Cli.Tui.Text.normalizeToWidth "hello" 5 = "hello"
Stdlib.Cli.Tui.Text.normalizeToWidth "hello" 3 = "hel"
Stdlib.Cli.Tui.Text.normalizeToWidth "hello" 0 = ""
Stdlib.Cli.Tui.Text.normalizeToWidth "hello" -1 = ""
Stdlib.Cli.Tui.Text.normalizeToWidth "" 0 = ""
Stdlib.Cli.Tui.Text.normalizeToWidth "a\r\nb" 10 = "ab"
Stdlib.Cli.Tui.Text.normalizeToWidth "\u001b[2Jabc" 10 = "abc"
Stdlib.Cli.Tui.Text.normalizeToWidth "\u001b[31mred\u001b[0m" 10 = "\u001b[31mred\u001b[0m"
Stdlib.Cli.Tui.Text.normalizeToWidth "\u001b[31mred\u001b[0m" 0 = ""
Stdlib.Cli.Tui.Text.normalizeToWidth "中ab" 3 = "中a"
Stdlib.Cli.Tui.Text.normalizeToWidth "中" 1 = ""
Stdlib.Cli.Tui.Text.normalizeToWidth "éb" 1 = "é"
Stdlib.Cli.Tui.Text.normalizeToWidth "👨‍👩‍👧‍👦x" 2 = "👨‍👩‍👧‍👦"
