// Duplicate-key rendering must survive concrete calls compiled in a preamble.
let duplicateStringKey () : Dict<String, String> = Stdlib.Dict.set (Dict { "key": "before" }) "key" "after"
let duplicateIntKey () : Dict<Int64, String> = Stdlib.Dict.set (Dict { 7L: "before" }) 7L "after"
duplicateStringKey () = exit=1 stderr="Uncaught exception: Cannot add two dictionary entries with the same key \"key\"\n"
duplicateIntKey () = exit=1 stderr="Uncaught exception: Cannot add two dictionary entries with the same key 7\n"
