// Selected unchanged named test from darklang/dark a9d93efc853486244630dad693fe79f6f4882cf6
// packages/darklang/tests/language/pipe.dark
module Darklang.Language.Tests.Pipe

module FnName =
  test pipeIntoBoundFn =
    Stdlib.Test.all
      [ (let fn = (fun x -> x + 1L)
         6L |> fn)
        |> Stdlib.Test.equal 7L
        (let fn = (+)
         3L |> fn 4L)
        |> Stdlib.Test.equal 7L
        (let fn = (-)
         11L |> fn 4L)
        |> Stdlib.Test.equal 7L
        (let fn = (fun a b -> Stdlib.max a b)
         3L |> fn 7L)
        |> Stdlib.Test.equal 7L ]
