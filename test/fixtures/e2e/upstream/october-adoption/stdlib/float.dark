module Darklang.Stdlib.Float.Tests

// Selected unchanged declarations from interpreter e76430be5.

let nan () : Float = 0.0 / 0.0

let infinity () : Float = 1.0 / 0.0

test toBits =
  Stdlib.Test.all
    [ Stdlib.Float.toBits 0.0 |> Stdlib.Test.equal 0UL
      Stdlib.Float.toBits 0.5 |> Stdlib.Test.equal 4602678819172646912UL
      Stdlib.Float.toBits 1.0 |> Stdlib.Test.equal 4607182418800017408UL
      Stdlib.Float.toBits 2.0 |> Stdlib.Test.equal 4611686018427387904UL
      Stdlib.Float.toBits (infinity ()) |> Stdlib.Test.equal 9218868437227405312UL
      Stdlib.Float.toBits -0.0 |> Stdlib.Test.equal 9223372036854775808UL
      Stdlib.Float.toBits -1.0 |> Stdlib.Test.equal 13830554455654793216UL ]

test toBitsDistinguishesSignedZero =
  Stdlib.Test.all
    [ (Stdlib.Float.toBits -0.0 == Stdlib.Float.toBits 0.0)
      |> Stdlib.Test.equal false
      (-0.0 == 0.0) |> Stdlib.Test.equal true
      (Stdlib.Float.toBits (nan ()) == Stdlib.Float.toBits (nan ()))
      |> Stdlib.Test.equal true ]
