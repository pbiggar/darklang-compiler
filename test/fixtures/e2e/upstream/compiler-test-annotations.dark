// Named package test annotation probes, using the fixture assertion adapter.
module CompilerAnnotationProbes

// @compiler blocked: test-counter
test blockedCounter =
  Stdlib.Test.incrementCounter 1L |> Stdlib.Test.equal 1L

// @compiler excluded: runtime-reflection
test excludedReflection =
  RuntimeReflection.lookup "anything" |> Stdlib.Test.equal 1L

// @compiler xfail compile: "Unknown function or value" class=missing-support reason=test-counter
test missingCounter =
  Stdlib.Test.incrementCounter 1L |> Stdlib.Test.equal 1L

// @compiler xfail runtime: "named annotation probe" class=missing-support reason=annotation-probe
test runtimeFailure =
  Builtin.crash "named annotation probe" |> Stdlib.Test.equal 1L

test ordinaryPass =
  42L |> Stdlib.Test.equal 42L

#compileerror="Unknown function or value"
// @compiler excluded: runtime-reflection
test overrideAndAnnotation =
  RuntimeReflection.lookup "anything"
  => raises "the original interpreter diagnostic"

// @compiler xfail compile: "Expected TBool, got TInt64" class=aot-rejection reason=aot-type-error
test staticallyInvalidBoolean =
  (true && 5L) |> Stdlib.Test.equal true
