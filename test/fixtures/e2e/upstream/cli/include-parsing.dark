// `--include=` names what a partial commit takes, so the parse decides which ops get sealed under
// somebody's message. It accepts repeats, commas, spaces and duplicates.
//
// Through `parseInclude` rather than `dark commit`: these are questions about a string, and a commit
// per case would need a draft per case.

module Include =
  let parse (args: List<String>) : List<String> =
    Darklang.Cli.Commit.parseInclude args

// One flag, one name.
// @compiler blocked: compiler-gap
Include.parse [ "--include=A.b" ] = [ "A.b" ]

// Comma-separated inside one flag.
// @compiler blocked: compiler-gap
Include.parse [ "--include=A.b,C.d" ] = [ "A.b", "C.d" ]

// Repeated flags, flattened in order. `--include=A,B --include=C` is three names.
// @compiler blocked: compiler-gap
Include.parse [ "--include=A.b,C.d", "--include=E.f" ] = [ "A.b", "C.d", "E.f" ]

// Spaces around a name are the shell's, not the user's intent.
// @compiler blocked: compiler-gap
Include.parse [ "--include=A.b, C.d" ] = [ "A.b", "C.d" ]

// An empty entry is dropped rather than becoming a name nothing matches. A trailing comma is the
// common way to produce one.
// @compiler blocked: compiler-gap
Include.parse [ "--include=A.b,,C.d," ] = [ "A.b", "C.d" ]

// Named twice is named once: the closure is computed per name, and a duplicate would report the same
// dependency being pulled in twice.
// @compiler blocked: compiler-gap
Include.parse [ "--include=A.b,A.b", "--include=A.b" ] = [ "A.b" ]

// Other flags are not includes.
// @compiler blocked: compiler-gap
Include.parse [ "-y", "--json", "--include=A.b", "--allow-type-errors" ] = [ "A.b" ]

// No flag, no names -- which is what makes a commit whole-draft rather than partial.
// @compiler blocked: compiler-gap
Include.parse [ "a message", "-y" ] = []
