// http2_server.e2e - Fragment-safe HTTP/2 prior-knowledge server dispatch.
Stdlib.Http2Wire.isPrefacePrefix (Stdlib.String.toBlob "PRI * HT") 0L = true
Stdlib.Http2Wire.isPrefacePrefix (Stdlib.String.toBlob "POST / HTTP/1.1") 0L = false
Stdlib.Http2Wire.isPrefacePrefix (Stdlib.String.toBlob "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\nextra") 0L = true
