// Dependency joins, correlated lookups, tuple membership and branch recursion.
(let db = "/tmp/dark-sqlite-joins.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t(id INTEGER PRIMARY KEY,name TEXT); CREATE TABLE u(tid INTEGER,flag INTEGER); INSERT INTO t VALUES (1,'a'),(2,'b'); INSERT INTO u VALUES (1,7)" in Stdlib.Sqlite.query db "SELECT t.name,coalesce(u.flag,0) AS flag FROM t LEFT JOIN u ON u.tid=t.id ORDER BY t.id" |> Stdlib.Result.map (fun rows -> Stdlib.List.map rows (fun row -> (Stdlib.Sqlite.textField row "name" |> Stdlib.Option.withDefault "") + ":" + Stdlib.Int64.toString (Stdlib.Sqlite.intField row "flag" |> Stdlib.Option.withDefault 0L)))) = Ok ["a:7","b:0"]
(let db = "/tmp/dark-sqlite-subqueries.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t(id INTEGER PRIMARY KEY,name TEXT); CREATE TABLE u(tid INTEGER,label TEXT); INSERT INTO t VALUES (1,'a'),(2,'b'); INSERT INTO u VALUES (1,'a')" in Stdlib.Sqlite.column db "SELECT name FROM t WHERE EXISTS (SELECT 1 FROM u WHERE u.tid=t.id) AND (id,name) IN (SELECT tid,label FROM u)" "name") = ["a"]
(let db = "/tmp/dark-sqlite-grouping.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t(owner TEXT,source TEXT); INSERT INTO t VALUES ('a','op'),('b','op'),('b','resolution')" in Stdlib.Sqlite.column db "SELECT owner FROM t GROUP BY owner ORDER BY MAX(CASE WHEN source='resolution' THEN 1 ELSE 0 END) DESC,owner" "owner") = ["b","a"]
(let db = "/tmp/dark-sqlite-recursion.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE branches(id TEXT PRIMARY KEY,parent_id TEXT); INSERT INTO branches VALUES ('a','b'),('b','a')" in Stdlib.Sqlite.columnP db "WITH RECURSIVE chain(bid) AS (SELECT @p0 UNION SELECT b.parent_id FROM branches b JOIN chain c ON b.id=c.bid) SELECT bid FROM chain ORDER BY bid" ["a"] "bid") = ["a","b"]
(let db = "/tmp/dark-sqlite-json-join.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t(name TEXT); INSERT INTO t VALUES ('a'),('b'),('c')" in Stdlib.Sqlite.columnP db "SELECT t.name FROM json_each(@p0) j JOIN t ON t.name=json_extract(j.value,'$[0]') ORDER BY t.name" ["[[\"b\"],[\"a\"]]"] "name") = ["a","b"]
