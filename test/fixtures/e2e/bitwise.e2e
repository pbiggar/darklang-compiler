// Named bitwise API and backend-lowering coverage.

Stdlib.Int64.shiftLeft 1L 8L = 256L
Stdlib.Int64.shiftRight 256L 8L = 1L
Stdlib.Int64.bitwiseAnd 12L 10L = 8L
Stdlib.Int64.bitwiseOr 12L 10L = 14L
Stdlib.Int64.bitwiseXor 12L 10L = 6L
Stdlib.Int64.bitwiseNot 0L = -1L

Stdlib.Int64.bitwiseXor 42L (Stdlib.Int64.bitwiseNot 42L) = -1L
Stdlib.Int64.bitwiseAnd 42L (Stdlib.Int64.bitwiseNot 42L) = 0L
Stdlib.Int64.bitwiseOr 42L (Stdlib.Int64.bitwiseNot 42L) = -1L

Stdlib.Int8.bitwiseAnd 1y 3y = 1y
Stdlib.Int8.bitwiseXor 1y 3y = 2y
Stdlib.Int8.shiftLeft 5y 1y = 10y
Stdlib.Int8.shiftRight 5y 1y = 2y
Stdlib.Int8.bitwiseNot 1y = -2y
Stdlib.UInt8.bitwiseNot 1uy = 254uy
Stdlib.UInt32.bitwiseNot 0ul = 4294967295ul

let x = 12L in Stdlib.Int64.bitwiseAnd x (0L - x) = 4L
let x = 12L in Stdlib.Int64.bitwiseAnd x (x - 1L) = 8L
