// Original imported package bodies compile and execute through ordinary source selection.
Darklang.GitHub.darklangRepoBaseUrl = "https://api.github.com/repos/darklang/dark"
Darklang.GitHub.Releases.assetUrlFor [Darklang.GitHub.Releases.Asset { name = "cli-linux-arm64.gz", browser_download_url = "arm64" }, Darklang.GitHub.Releases.Asset { name = "cli-linux-arm.gz", browser_download_url = "arm" }] "linux-arm" = Stdlib.Option.Option.Some "arm"
Darklang.GitHub.Releases.assetUrlFor [] "linux-arm" = Stdlib.Option.Option.None
Darklang.SCM.Constraints.kindToString Darklang.SCM.Constraints.Kind.StaleUsage = "stale-usage"
Darklang.SCM.Constraints.kindFromString "kind-changed" = Stdlib.Option.Option.Some Darklang.SCM.Constraints.Kind.KindChanged
Darklang.SCM.Constraints.kindFromString "unknown" = Stdlib.Option.Option.None
Darklang.SCM.Constraints.offersResolution Darklang.SCM.Constraints.Kind.StaleUsage "repoint" = true
Darklang.SCM.Constraints.offersResolution Darklang.SCM.Constraints.Kind.KindChanged "repoint" = false

// Inherited initializers retain their generic calls and transitive value dependencies.
module ImportedValueChecks =
  val prefix = "selected"
  val message = Stdlib.String.toUppercase prefix
  val names = Stdlib.List.map [1L, 2L] (fun n -> Stdlib.Int64.toString n)

ImportedValueChecks.message = "SELECTED"
ImportedValueChecks.names = ["1", "2"]
