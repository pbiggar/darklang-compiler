// Package projections copy rows and select affected op IDs through subqueries.
(let db = "/tmp/dark-sqlite-insert-select.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE source(id INTEGER PRIMARY KEY,label TEXT); CREATE TABLE target(id INTEGER PRIMARY KEY,name TEXT,n INTEGER DEFAULT 3); INSERT INTO source VALUES (1,'a'),(2,'b')" in (Stdlib.Sqlite.exec db "INSERT INTO target(id,name) SELECT id,label FROM source WHERE id>=1 ORDER BY id",Stdlib.Sqlite.column db "SELECT name FROM target ORDER BY id" "name",Stdlib.Sqlite.scalarInt db "SELECT n FROM target WHERE id=1" "n")) = (Ok 2,["a","b"],Some 3L)
(let db = "/tmp/dark-sqlite-update-subquery.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE source(id INTEGER PRIMARY KEY,label TEXT); CREATE TABLE target(id INTEGER PRIMARY KEY,name TEXT); INSERT INTO source VALUES (1,'new'); INSERT INTO target VALUES (1,'old'),(2,'keep')" in (Stdlib.Sqlite.execP db "UPDATE target SET name=(SELECT label FROM source WHERE source.id=target.id) WHERE id IN (SELECT value FROM json_each(@p0))" ["[1]"],Stdlib.Sqlite.column db "SELECT name FROM target ORDER BY id" "name")) = (Ok 1,["new","keep"])
(let db = "/tmp/dark-sqlite-delete-subquery.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t(id TEXT PRIMARY KEY); CREATE TABLE keep(id TEXT PRIMARY KEY); INSERT INTO t VALUES ('a'),('b'),('c'); INSERT INTO keep VALUES ('b')" in (Stdlib.Sqlite.execP db "DELETE FROM t WHERE id IN (SELECT value FROM json_each(@p0)) AND id NOT IN (SELECT id FROM keep)" ["[\"a\",\"b\"]"],Stdlib.Sqlite.column db "SELECT id FROM t ORDER BY id" "id")) = (Ok 1,["b","c"])
