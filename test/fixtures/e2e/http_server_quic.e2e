// http_server_quic.e2e - Invalid HTTP/3 configuration fails before sockets or private signing.
Stdlib.HttpServer.Quic.serve (Stdlib.HttpServer.Config.Config { port = 0, maxBodyBytes = 1024, injectStandardHeaders = false, canonicalizeFromForwardedProto = false, logRequests = false }) (Stdlib.TlsServerIdentity.Identity { certificates = [], key = Stdlib.RsaPrivate.Key { modulus = Stdlib.Blob.empty, exponent = Stdlib.Blob.empty, privateExponent = Stdlib.Blob.empty } }) (fun _request -> Stdlib.Http.responseWithText "unused" 200) (fun _unit -> ()) = Error "Invalid HTTP/3 server configuration"
