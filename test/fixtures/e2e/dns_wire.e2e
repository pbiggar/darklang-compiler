// dns_wire.e2e - DNS packets are encoded and validated in Dark.

Stdlib.DnsWire.query 4660L "example.com" 1L |> Stdlib.Result.map Stdlib.Blob.toHex = Ok "123401000001000000000000076578616D706C6503636F6D0000010001"
Stdlib.Blob.fromHex "123481800001000100000000076578616D706C6503636F6D0000010001C00C000100010000003C00045DB8D822" |> Stdlib.Result.map (fun wire -> Stdlib.Blob.toHex (Stdlib.Blob.slice wire 41 4)) = Ok "5DB8D822"
Stdlib.Blob.fromHex "123481800001000100000000076578616D706C6503636F6D0000010001C00C000100010000003C00045DB8D822" |> Stdlib.Result.andThen (fun wire -> Stdlib.DnsWire.answers wire 4660L "example.com" 1L) = Ok [[93L, 184L, 216L, 34L]]
Stdlib.DnsWire.hosts "# hosts\n127.0.0.1 localhost\n192.0.2.4 example.test alias.test # local\n" "ALIAS.test" 1L = [[192L, 0L, 2L, 4L]]
Stdlib.DnsWire.hosts "::1 localhost ip6-loopback\n" "localhost" 28L = [[0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 1L]]
Stdlib.DnsWire.nameservers "search example.test\nnameserver 192.0.2.53\n# comment\nnameserver 2001:db8::1\n" = ["192.0.2.53", "2001:db8::1"]
Stdlib.Blob.fromHex "123481800001000200000000076578616D706C6503636F6D0000010001C00C000500010000003C001406746172676574076578616D706C6503636F6D00C029000100010000003C000401020304" |> Stdlib.Result.andThen (fun wire -> Stdlib.DnsWire.answers wire 4660L "example.com" 1L) = Ok [[1L, 2L, 3L, 4L]]
Stdlib.Blob.fromHex "123481800001000100000000076578616D706C6503636F6D00001C0001C00C001C00010000003C00100102030405060708090A0B0C0D0E0F10" |> Stdlib.Result.andThen (fun wire -> Stdlib.DnsWire.answers wire 4660L "example.com" 28L) = Ok [[1L, 2L, 3L, 4L, 5L, 6L, 7L, 8L, 9L, 10L, 11L, 12L, 13L, 14L, 15L, 16L]]
Stdlib.Blob.fromHex "123481800001000100000000076578616D706C6503636F6D0000010001C029000100010000003C000401020304" |> Stdlib.Result.andThen (fun wire -> Stdlib.DnsWire.answers wire 4660L "example.com" 1L) = Error "Invalid DNS name compression"
Stdlib.Blob.fromHex "123481800001000100000000076578616D706C6503636F6D0000010001C00C000100010000003C00040102" |> Stdlib.Result.andThen (fun wire -> Stdlib.DnsWire.answers wire 4660L "example.com" 1L) = Error "Truncated DNS record"
Stdlib.DnsWire.queryUdp4 [127L, 0L, 0L, 1L] 53L "example.com" 15L 100L 1L = Error (Stdlib.DnsWire.ResolveError.InvalidQuery "Invalid DNS query")
Stdlib.DnsWire.queryUdp6 [0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 1L] 53L "example.com" 15L 100L 1L = Error (Stdlib.DnsWire.ResolveError.InvalidQuery "Invalid DNS query")
