// Package replay upserts, including conditional reactivation and fresh rowids.
(let db = "/tmp/dark-sqlite-upsert.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t (hash TEXT PRIMARY KEY, body TEXT, effective INTEGER DEFAULT 0); INSERT INTO t(hash,body) VALUES ('a','old')" in (Stdlib.Sqlite.exec db "INSERT INTO t VALUES ('a','new',1) ON CONFLICT(hash) DO UPDATE SET body=excluded.body,effective=1 WHERE t.effective=0",Stdlib.Sqlite.exec db "INSERT INTO t VALUES ('a','ignored',1) ON CONFLICT(hash) DO UPDATE SET body=excluded.body WHERE t.effective=0",Stdlib.Sqlite.column db "SELECT body FROM t" "body")) = (Ok 1,Ok 0,["new"])
(let db = "/tmp/dark-sqlite-upsert-ignore.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t (hash TEXT PRIMARY KEY); INSERT INTO t VALUES ('a')" in (Stdlib.Sqlite.exec db "INSERT INTO t VALUES ('a') ON CONFLICT(hash) DO NOTHING",Stdlib.Sqlite.exec db "INSERT INTO t VALUES ('b') ON CONFLICT(hash) DO NOTHING")) = (Ok 0,Ok 1)
(let db = "/tmp/dark-sqlite-replace.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t (hash TEXT PRIMARY KEY, body TEXT); INSERT INTO t VALUES ('a','old')" in (Stdlib.Sqlite.exec db "INSERT OR REPLACE INTO t VALUES ('a','new')",Stdlib.Sqlite.scalarInt db "SELECT rowid FROM t" "rowid",Stdlib.Sqlite.column db "SELECT body FROM t" "body")) = (Ok 1,Some 2L,["new"])
(let db = "/tmp/dark-sqlite-upsert-constraint.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t (hash TEXT PRIMARY KEY, body TEXT UNIQUE); INSERT INTO t VALUES ('a','first'),('b','second')" in (Stdlib.Result.isError (Stdlib.Sqlite.exec db "INSERT INTO t VALUES ('a','second') ON CONFLICT(hash) DO UPDATE SET body=excluded.body"),Stdlib.Sqlite.column db "SELECT body FROM t ORDER BY hash" "body")) = (true,["first","second"])
