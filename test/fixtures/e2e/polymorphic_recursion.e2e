// Finite polymorphic recursion changes types without creating infinitely many instances.
let resetType<'a> (_value: a) (n: Int64) : Int64 =
  if n <= 0L then 0L else 1L + resetType<Bool> true (n - 1L)
let inferredReset<'a> (_value: a) (n: Int64) : Int64 =
  if n <= 0L then 0L else 1L + inferredReset true (n - 1L)
let swapTypes<'a, 'b> (x: a) (y: b) (n: Int64) : Int64 =
  if n <= 0L then 0L else 1L + swapTypes y x (n - 1L)
let swapRoundTrip<'a, 'b> (x: a) (y: b) (n: Int64) : (a * b) =
  if n <= 0L then (x, y) else
    let (nextY, nextX) = swapRoundTrip y x (n - 1L) in (nextX, nextY)
let tailSwapEq<'a, 'b> (x: a) (otherX: a) (y: b) (otherY: b) (n: Int64) : Bool =
  if n <= 0L then x == otherX && y == otherY else tailSwapEq y otherY x otherX (n - 1L)
let settleTypes<'a, 'b> (_x: a) (y: b) (n: Int64) : Int64 =
  if n <= 0L then 0L else 1L + settleTypes [y] 1L (n - 1L)
let mutualLeft<'a> (_value: a) (n: Int64) : Int64 =
  if n <= 0L then 0L else 1L + mutualRight true (n - 1L)
let mutualRight<'a> (_value: a) (n: Int64) : Int64 =
  if n <= 0L then 0L else 1L + mutualLeft 1L (n - 1L)
let resetViaValue<'a> (_value: a) (n: Int64) : Int64 =
  if n <= 0L then 0L else let next = resetViaValue<Bool> in 1L + next true (n - 1L)
let resetViaPartial<'a> (_value: a) (n: Int64) : Int64 =
  if n <= 0L then 0L else let next = resetViaPartial<Bool> true in 1L + next (n - 1L)
let inferredPartialReset<'a> (_value: a) (n: Int64) : Int64 =
  if n <= 0L then 0L else let next = inferredPartialReset true in 1L + next (n - 1L)

resetType<Int64> 1L 3L = 3L
inferredReset 1L 3L = 3L
swapTypes 1L "hello" 3L = 3L
swapRoundTrip 1L (Stdlib.String.append "hel" "lo") 3L = (1L, "hello")
tailSwapEq 1L 1L (Stdlib.String.append "hel" "lo") (Stdlib.String.append "h" "ello") 1001L = true
tailSwapEq 1L 1L (Stdlib.String.append "hel" "lo") (Stdlib.String.append "world" "!") 1000L = false
settleTypes true "hello" 3L = 3L
mutualLeft 1L 3L = 3L
resetViaValue<Int64> 1L 3L = 3L
resetViaPartial 1L 3L = 3L
inferredPartialReset 1L 3L = 3L

// Even terminating executions need infinitely many native bodies for these definitions.
let grow<'a> (x: a) (n: Int64) : Int64 = if n <= 0L then 0L else 1L + grow [x] (n - 1L); grow 1L 3L = compileerror="Unbounded generic specialization"
let growLeft<'a> (x: a) (n: Int64) : Int64 = if n <= 0L then 0L else growRight [x] (n - 1L) let growRight<'a> (x: a) (n: Int64) : Int64 = if n <= 0L then 0L else growLeft x (n - 1L); growLeft 1L 3L = compileerror="Unbounded generic specialization"
let growValue<'a> (x: a) (n: Int64) : Int64 = if n <= 0L then 0L else let next = growValue<List<a>> in next [x] (n - 1L); growValue 1L 3L = compileerror="Unbounded generic specialization"
let growPartial<'a> (x: a) (n: Int64) : Int64 = if n <= 0L then 0L else let next = growPartial<List<a>> [x] in next (n - 1L); growPartial 1L 3L = compileerror="Unbounded generic specialization"
let growInferredPartial<'a> (x: a) (n: Int64) : Int64 = if n <= 0L then 0L else let next = growInferredPartial [x] in next (n - 1L); growInferredPartial 1L 3L = compileerror="Unbounded generic specialization"
let growSwap<'a, 'b> (x: a) (y: b) (n: Int64) : Int64 = if n <= 0L then 0L else growSwap y [x] (n - 1L); growSwap 1L true 3L = compileerror="Unbounded generic specialization"

// Unreachable generic bodies require no native instances. Ordinary type errors still reject.
let unusedGrowth<'a> (x: a) : Int64 = unusedGrowth [x]; 42L = 42L
let badReset<'a> (_x: a) (n: Int64) : Int64 = if n <= 0L then 0L else badReset<Bool> 1L (n - 1L); badReset 1L 3L = compileerror="Expected TBool, got TInt64"
