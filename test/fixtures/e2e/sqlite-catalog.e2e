// Package migrations query the catalog, then add virtual defaults to old records.
(let db = "/tmp/dark-sqlite-migration.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t (hash TEXT PRIMARY KEY); INSERT INTO t VALUES ('a'); ALTER TABLE t ADD COLUMN effective INTEGER NOT NULL DEFAULT 1" in (Stdlib.Sqlite.scalarInt db "SELECT effective FROM t WHERE hash='a'" "effective",Stdlib.Sqlite.scalarIntP db "SELECT 1 AS n FROM pragma_table_info('t') WHERE name=@p0" ["effective"] "n",Stdlib.Result.isError (Stdlib.Sqlite.exec db "ALTER TABLE t ADD COLUMN bad TEXT NOT NULL"))) = (Some 1L,Some 1L,true)
(let db = "/tmp/dark-sqlite-drop-index.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t (hash TEXT PRIMARY KEY, name TEXT); CREATE INDEX i ON t(name); DROP INDEX i; INSERT INTO t VALUES ('a','x')" in (Stdlib.Sqlite.exec db "DROP INDEX IF EXISTS missing",Stdlib.Result.isError (Stdlib.Sqlite.exec db "DROP INDEX sqlite_autoindex_t_1"),Stdlib.Sqlite.column db "SELECT name FROM t" "name")) = (Ok -1,true,["x"])
Stdlib.Sqlite.queryP "/tmp/dark-sqlite-json-each.db" "SELECT key, json_extract(value,'$[0]') AS name FROM json_each(@p0) ORDER BY key" ["[[\"a\"],[\"b\"]]"] |> Stdlib.Result.map (fun rows -> Stdlib.List.map rows (fun row -> Stdlib.Sqlite.textField row "name")) = Ok [Some "a",Some "b"]
Stdlib.Sqlite.queryP "/tmp/dark-sqlite-json-each.db" "SELECT value FROM json_each(@p0) ORDER BY key" ["[9007199254740993,null,true]"] |> Stdlib.Result.map (fun rows -> Stdlib.List.map rows (fun row -> Stdlib.Sqlite.intField row "value")) = Ok [Some 9007199254740993L,None,Some 1L]

// DESC changes INTEGER PRIMARY KEY alias semantics, so reject it before storage.
Stdlib.Sqlite.exec "/tmp/dark-sqlite-desc-pk.db" "CREATE TABLE unsupported(id INTEGER PRIMARY KEY DESC)" = Error "SQLite: descending primary keys are unsupported"
