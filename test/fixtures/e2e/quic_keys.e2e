// quic_keys.e2e - Authenticated application key phases, stable header keys and old-key expiry.
Stdlib.QuicKeys.create (Stdlib.String.toBlob "short") = Error "QUIC SHA-256 traffic secret must have 32 bytes"
Stdlib.QuicKeys.create (Stdlib.String.toBlob "01234567890123456789012345678901") |> Stdlib.Result.map (fun state -> (state.current.phase, state.next.phase, state.acked, Stdlib.Blob.toHex state.current.keys.hp == Stdlib.Blob.toHex state.next.keys.hp)) = Ok ((false, true, true, true))
Stdlib.QuicKeys.create (Stdlib.String.toBlob "01234567890123456789012345678901") |> Stdlib.Result.andThen (fun state -> Stdlib.QuicPacket.sealShort state.current.keys Stdlib.Blob.empty false (Stdlib.String.toBlob "ping") 0L |> Stdlib.Result.andThen (fun bytes -> Stdlib.QuicKeys.openPacket state bytes 1L 0L 100L false)) |> Stdlib.Result.map (fun opened -> (opened.updated, opened.packet.number, opened.state.current.phase, opened.state.count)) = Ok ((false, 0L, false, 1L))
Stdlib.QuicKeys.create (Stdlib.String.toBlob "01234567890123456789012345678901") |> Stdlib.Result.andThen (fun state -> Stdlib.QuicPacket.sealShort state.next.keys Stdlib.Blob.empty true (Stdlib.String.toBlob "ping") 1L |> Stdlib.Result.andThen (fun bytes -> Stdlib.QuicKeys.openPacket state bytes 1L 0L 100L false)) = Error "Invalid QUIC key update"
Stdlib.QuicKeys.create (Stdlib.String.toBlob "01234567890123456789012345678901") |> Stdlib.Result.andThen (fun state -> Stdlib.QuicPacket.sealShort state.next.keys Stdlib.Blob.empty true (Stdlib.String.toBlob "ping") 1L |> Stdlib.Result.andThen (fun bytes -> Stdlib.QuicKeys.openPacket state bytes 1L 0L 100L true)) |> Stdlib.Result.map (fun opened -> (opened.updated, opened.packet.number, opened.state.current.phase, opened.state.acked)) = Ok ((true, 1L, true, false))
Stdlib.QuicKeys.create (Stdlib.String.toBlob "01234567890123456789012345678901") |> Stdlib.Result.andThen (fun state -> Stdlib.QuicPacket.sealShort state.current.keys Stdlib.Blob.empty true (Stdlib.String.toBlob "ping") 0L |> Stdlib.Result.andThen (fun bytes -> Stdlib.QuicKeys.openPacket state bytes 1L 0L 100L true)) = Error "Invalid QUIC current key phase"
Stdlib.QuicKeys.create (Stdlib.String.toBlob "01234567890123456789012345678901") |> Stdlib.Result.andThen (fun state -> Stdlib.QuicKeys.openPacket state Stdlib.Blob.empty 1L 0L 100L true) = Error "QUIC application authentication failed"
