// Dict parity tests pinned to darklang/dark 04fbe9dcc995c6188757d583e273cbd30a3e2d3d.
// Historical compiler evidence started at 51093e0a8e31fe45a9aa79a317fbefd6b74fbcc3.
// Current compiler behavior was compared at rebased main 9cf0799fc485a2edc1eb19551826745705cf695e.

// Dict types state both their key and value types.
let dictIdentity<'a> (dict: Dict<String, a>): Dict<String, a> = dict
dictIdentity<Int64> (Dict { "answer": 42L }) = Dict { "answer": 42L }
Stdlib.Dict.singleton 1L "one" = Dict { 1L: "one" }

// Empty and non-empty literals are distinct from records. String keys can
// contain punctuation or be empty.
Dict { "answer": 42L } = Dict { "answer": 42L }
Dict { "Content-Length": "0"; "": "empty" } = Dict { "Content-Length": "0"; "": "empty" }
Dict { "duplicate": 1L; "duplicate": 2L } = compileerror="Duplicate dictionary key \"duplicate\""
Dict { "first": 1L; "second": "two" } = compileerror="Expected TInt64, got TString"

// Construction, lookup, update, removal, and merge match the interpreter.
Stdlib.Dict.isEmpty Stdlib.Dict.empty = true
Stdlib.Dict.isEmpty (Stdlib.Dict.singleton "a" 1L) = false
Stdlib.Dict.size (Dict { "a": 1L; "b": 2L }) = 2
Stdlib.Dict.get (Dict { "a": 1L }) "a" = Some 1L
Stdlib.Dict.get (Dict { "a": 1L }) "missing" = None
Stdlib.Dict.member (Dict { "a": 1L }) "a" = true
Stdlib.Dict.member (Dict { "a": 1L }) "missing" = false
Stdlib.Dict.remove (Dict { "a": 1L }) "missing" = Dict { "a": 1L }
Stdlib.Dict.remove (Dict { "a": 1L }) "a" = Dict { }
Stdlib.Dict.merge (Dict { "a": 1L; "shared": 2L }) (Dict { "shared": 3L; "z": 4L }) = Dict { "a": 1L; "shared": 3L; "z": 4L }
Stdlib.Dict.setOverridingDuplicates (Dict { "a": 1L }) "a" 2L = Dict { "a": 2L }

// Rejecting and overwriting paths are observably separate.
Stdlib.Dict.set (Dict { "a": 1L }) "a" 2L = exit=1 stderr="Uncaught exception: Cannot add two dictionary entries with the same key \"a\"\n"
let key = "d" ++ "ynamic" in Stdlib.Dict.set (Dict { "dynamic": 1L }) key 2L = exit=1 stderr="Uncaught exception: Cannot add two dictionary entries with the same key \"dynamic\"\n"
Stdlib.Dict.fromList ([("a", 1L), ("b", 2L)]) = Some (Dict { "a": 1L; "b": 2L })
Stdlib.Dict.fromList ([("a", 1L), ("a", 2L)]) = None
Stdlib.Dict.fromListOverwritingDuplicates ([("a", 1L), ("b", 2L), ("a", 3L)]) = Dict { "a": 3L; "b": 2L }

// All traversal-based operations use String ordering and key-then-value callbacks.
Stdlib.Dict.keys (Dict { "c": 3L; "a": 1L; "b": 2L }) = ["a", "b", "c"]
Stdlib.Dict.values (Dict { "c": 3L; "a": 1L; "b": 2L }) = [1L, 2L, 3L]
Stdlib.Dict.toList (Dict { "c": 3L; "a": 1L; "b": 2L }) = [("a", 1L), ("b", 2L), ("c", 3L)]
Stdlib.Dict.keys (Dict { "𐀀": 1L; "": 2L }) = ["𐀀", ""]
Stdlib.Dict.map (Dict { "b": 2L; "a": 1L }) (fun key value -> key ++ Stdlib.Int64.toString value) = Dict { "a": "a1"; "b": "b2" }
Stdlib.Dict.filter (Dict { "b": 2L; "a": 1L }) (fun key value -> key == "b") = Dict { "b": 2L }
Stdlib.Dict.filterMap (Dict { "b": 2L; "a": 1L }) (fun key value -> if key == "a" then Some (value + 10L) else None) = Dict { "a": 11L }
let observed = Stdlib.Dict.iter (Dict { "b": 2L; "a": 1L }) (fun key value -> ()) in observed = ()
Stdlib.Dict.iter (Dict { "b": 2L; "a": 1L }) (fun key value -> let ignored = Builtin.crash key in ()) = exit=1 stderr="Uncaught exception: a\n"

// Equality and rendering are content-based and independent of HAMT shape.
Stdlib.Dict.setOverridingDuplicates (Stdlib.Dict.singleton "b" 2L) "a" 1L == Dict { "a": 1L; "b": 2L } = true
Stdlib.Dict.fromList ([("b", 2L), ("a", 1L)]) == Some (Dict { "a": 1L; "b": 2L }) = true
Dict { "b": 2L; "a": 1L } != Dict { "a": 1L; "b": 2L } = false
Dict { "nested": Dict { "b": 2L; "a": 1L }; "not an identifier": Dict { } } = stdout="Dict { nested = Dict { a = 1; b = 2 }; ``not an identifier`` = Dict { } }\n" stderr=""
