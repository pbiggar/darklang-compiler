// Char and String remain distinct source types despite sharing buffer storage.

Stdlib.String.fromList ["a"] = compileerror="Expected TChar, got TString"
Stdlib.String.fromList ["ab"] = compileerror="Expected TChar, got TString"
Stdlib.String.length 'a' = compileerror="Expected TString, got TChar"
Stdlib.Char.toString "a" = compileerror="Expected TChar, got TString"
let takesChar (value: Char) : Char = value; takesChar "a" = compileerror="Expected TChar, got TString"
let takesString (value: String) : String = value; takesString 'a' = compileerror="Expected TString, got TChar"
let wrongReturn (value: String) : Char = value; wrongReturn "a" = compileerror="Expected TChar, got TString"
let wrongReturn (value: Char) : String = value; wrongReturn 'a' = compileerror="Expected TString, got TChar"
["a", 'a'] = compileerror="Expected TString, got TChar"
['a', "a"] = compileerror="Expected TChar, got TString"
if true then "a" else 'a' = compileerror="Expected TString, got TChar"
if true then 'a' else "a" = compileerror="Expected TChar, got TString"
let identity<'a> (value: a) : a = value; identity<String> 'a' = compileerror="Expected TString, got TChar"
let identity<'a> (value: a) : a = value; identity<Char> "a" = compileerror="Expected TChar, got TString"
$"{'a'}" = compileerror="Expected String in string interpolation, got TChar"
__char_to_string 'a' = compileerror="Internal identifier not allowed in user code"
__string_to_char_unchecked "ab" = compileerror="Internal identifier not allowed in user code"

Stdlib.String.fromList ['a', '👩‍👩‍👧‍👦'] = "a👩‍👩‍👧‍👦"
Stdlib.Char.toString '👩‍👩‍👧‍👦' = "👩‍👩‍👧‍👦"
Stdlib.String.toList "a👩‍👩‍👧‍👦" = ['a', '👩‍👩‍👧‍👦']
Stdlib.Char.toString (Stdlib.Char.toUppercase 'é') = "É"
let value = "a" ++ "b" in Stdlib.String.fromList (Stdlib.String.toList value) = "ab"
Stdlib.String.fromChar 'a' = "a"
'a' ++ "b" = "ab"
"a" ++ 'b' = "ab"
let value = Stdlib.String.head ("a" ++ "b") in match value with | Some char -> (Stdlib.Char.toString char, Stdlib.Char.toString char) | None -> ("", "") = ("a", "a")
