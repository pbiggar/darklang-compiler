// E2E tests for reconstructing tuples from tuple access expressions.
// Covers the ANF regression where tuple access inside a new tuple literal could
// lose the source tuple type and fail with "Cannot access index on non-tuple type".
// Keep the scenarios broad enough to exercise direct lets, function returns,
// returned tuples, and recursive reconstruction.

// =====================================================
// Basic tuple construction from access (no functions)
// =====================================================

// Simple 2-tuple construction from 3-tuple access
let t = (1L, 2L, 3L) in let (first, second, _) = t in let t2 = (first, second) in let (left, right) = t2 in left + right = 3L

// 3-tuple construction from 4-tuple access
let t = (1L, 2L, 3L, 4L) in let (first, second, third, _) = t in let t2 = (first, second, third) in let (a, b, c) = t2 in a + b + c = 6L

// Constructing tuple with reordered access
let t = (10L, 20L, 30L) in let (first, _, third) = t in let t2 = (third, first) in let (left, right) = t2 in left + right = 40L

// =====================================================
// Tuple construction from function return access
// =====================================================

// These functions have unique names to avoid collisions in the shared preamble
let makeTuple3 (x: Int64) : (Int64 * Int64 * Int64) = (x, x * 2L, x * 3L)

let r = makeTuple3 5L in let (first, second, _) = r in let t = (first, second) in let (left, right) = t in left + right = 15L

let makeTuple4 (x: Int64) : (Int64 * Int64 * Int64 * Int64) = (x, x + 1L, x + 2L, x + 3L)

let r = makeTuple4 10L in let (_, second, _, fourth) = r in let t = (second, fourth) in let (left, right) = t in left + right = 24L

// =====================================================
// Tuple construction in let chain
// =====================================================

let a = (1L, 2L, 3L) in let (aFirst, aSecond, aThird) = a in let b = (aFirst + 10L, aSecond + 10L) in let (bFirst, bSecond) = b in let c = (bFirst, bSecond, aThird) in let (cFirst, cSecond, cThird) = c in cFirst + cSecond + cThird = 26L

// =====================================================
// Tuple construction in function returning tuple
// =====================================================

let transformTuple (t: (Int64 * Int64 * Int64)) : (Int64 * Int64) = let (first, second, third) = t in (first + second, second + third)

let orig = (1L, 2L, 3L) in let result = transformTuple orig in let (first, second) = result in first + second = 8L

// =====================================================
// Recursive function using tuple construction from access
// =====================================================

let stepPair (x: Int64) (y: Int64) : (Int64 * Int64) = (x + 1L, y + 2L)

let recurseWithTuple (t: (Int64 * Int64)) (n: Int64) : Int64 =
    let (first, second) = t in
    if n <= 0L then first + second
    else
        let r = stepPair first second in
        let (nextFirst, nextSecond) = r in
        let t2 = (nextFirst, nextSecond) in
        recurseWithTuple t2 (n - 1L)

recurseWithTuple ((0L, 0L)) 5L = 15L
