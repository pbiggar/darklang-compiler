// E2E Test Suite - Basic language feature tests
//
// Format: source = expectations  // optional comment
//
// Expectations:
//   Simple format: value expression (e.g., "42 = 42", "\"hi\" = \"hi\"")
//     - Interprets as: assert(source == expectation)
//     - Uses value equality (binaries exit with 0 when equal)
//   Explicit format: [exit=N] [stdout="..."] [stderr="..."]
//     - For error cases or when you need non-zero exit codes
//
// Attributes (explicit format):
//   exit=N         - Expected exit code (default: 0)
//   stdout="..."   - Expected stdout with escape sequences: \n, \t, \\, \"
//   stderr="..."   - Expected stderr (same escape sequences)
//   disable_leak_check=true - Disable leak checking for this test (default: false)
//
// Examples:
//   42 = 42                           // value equality (simple format)
//   2 + 3 = 5                         // value equality (simple format)
//   "hi" = "hi"                       // value equality (simple format)
//   42 = stdout="42\n"                // explicit stdout (exit defaults to 0)
//   1/0 = exit=1 stderr="error\n"     // error case with non-zero exit
//
// Implementation note:
// The compiled binary prints the result to stdout and exits with code 0.
// Integer-to-string conversion is implemented in ARM64 using division by 10.
// Negative numbers are supported: checks sign bit, negates value, prints '-'.
//
// NOTE: Comprehensive integer tests (boundaries, overflow, etc.) are in integers.e2e


// ===================================================================
// Constants
// ===================================================================

42L = 42L
0L = 0L
-5L = -5L  // negative literal
-42L = -42L
-1L = -1L


// ===================================================================
// Basic Arithmetic
// ===================================================================

// Addition
2L + 3L = 5L
1L + 2L + 3L + 4L = 10L  // left associativity

// Subtraction
10L - 3L = 7L
5L - 2L = 3L  // ARM64 SUB_imm encoding bug regression test
20L - 5L - 3L = 12L  // left associativity

// Multiplication
6L * 7L = 42L
2L * 3L * 4L = 24L  // chained multiplication

// Division
15L / 3L = 5L
100L / 5L / 2L = 10L  // chained division (left associative)


// ===================================================================
// Operator Precedence and Grouping
// ===================================================================

// Precedence
2L + 3L * 4L = 14L  // multiplication before addition

// Parentheses
(2L + 3L) * 4L = 20L
((1L + 2L) * (3L + 4L)) = 21L  // nested parentheses

// Complex expressions (operator precedence)
10L + 20L / 2L - 3L * 4L = 8L  // 10 + (20/2) - (3*4) = 10 + 10 - 12 = 8
10L - 2L * 3L + 8L / 4L = 6L  // 10 - (2*3) + (8/4) = 10 - 6 + 2 = 6


// ===================================================================
// Edge Cases
// ===================================================================

123456789L = 123456789L  // large numbers print correctly


// ===================================================================
// Negative Number Tests
// ===================================================================

// Subtraction tests (negative results)
0L - 1L = -1L
0L - 2L = -2L
1L - 2L = -1L
1L - 10L = -9L
10L - 20L = -10L
0L - 255L = -255L
100L - 200L = -100L

// Mixed operations (negative results)
0L - 1L + 1L = 0L
5L - 10L + 3L = -2L
100L - 200L + 50L = -50L

// Operations with negative literals
-5L + 10L = 5L
-5L + 5L = 0L
-5L + 3L = -2L
10L + -5L = 5L
-10L + -5L = -15L
-5L * 3L = -15L
5L * -3L = -15L
-5L * -3L = 15L
-10L / 2L = -5L
10L / -2L = -5L
-10L / -2L = 5L
-(-5L) = 5L  // double negation
-(10L + 5L) = -15L  // negation of expression


// ===================================================================
// Explicit Format Examples
// ===================================================================

100L = 100L  // explicit stdout, exit defaults to 0
10L + 5L = 15L  // same as simple format "10 + 5 = 15"
