// Generic calls must preserve input constraints when a context constrains their result.
type Box<'a> = Box of 'a
let wrap (value: 'a) : Box<'a> = Box.Box value
let requireIntBox (value: Box<Int64>) : Int64 = 0L
let unbox (value: Box<'a>) : 'a = match value with | Box item -> item
let explicitWrap<'a> (value: 'a) : Box<'a> = Box.Box value
let first (left: 'a) (right: 'a) : 'a = left
let empty () : List<'a> = []
let countInts (values: List<Int64>) : Int64 = match values with | [] -> 0L | _ -> 1L

requireIntBox (wrap "one") = compileerror="conflicting inferences"
requireIntBox (wrap 1L) = 0L
unbox (wrap "one") = "one"
requireIntBox (explicitWrap "one") = compileerror="conflicting inferences"
first 1L "one" = compileerror="expected Int64, got String"
first "one" "two" = "one"
first [1L] ["one"] = compileerror="expected Int64, got String"
countInts (empty ()) = 0L
(unbox (wrap 1L), unbox (wrap "one")) = (1L, "one")
