// http3_uni.e2e - Critical stream uniqueness independent of QUIC stream numbers.
Stdlib.Http3Uni.receive (Stdlib.Http3Uni.create true) 2L Stdlib.Blob.empty false false = Error "Invalid peer HTTP/3 unidirectional stream"
Stdlib.Http3Uni.receive (Stdlib.Http3Uni.create true) 3L (Stdlib.Blob.fromHex "000400" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false |> Stdlib.Result.map (fun received -> (received.state.controlId, received.events)) = Ok ((Some 3L, [Settings []]))
Stdlib.Http3Uni.receive (Stdlib.Http3Uni.create true) 7L (Stdlib.Blob.fromHex "000400" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false |> Stdlib.Result.andThen (fun received -> Stdlib.Http3Uni.receive received.state 3L (Stdlib.Blob.fromHex "00" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false) = Error "Duplicate HTTP/3 control stream"
Stdlib.Http3Uni.receive (Stdlib.Http3Uni.create true) 3L (Stdlib.Blob.fromHex "02" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false |> Stdlib.Result.andThen (fun received -> Stdlib.Http3Uni.receive received.state 7L (Stdlib.Blob.fromHex "02" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false) = Error "Duplicate QPACK encoder stream"
Stdlib.Http3Uni.receive (Stdlib.Http3Uni.create true) 3L (Stdlib.Blob.fromHex "022020" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false |> Stdlib.Result.map (fun received -> received.state.encoderId) = Ok (Some 3L)
Stdlib.Http3Uni.receive (Stdlib.Http3Uni.create true) 3L (Stdlib.Blob.fromHex "0340" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false = Error "Unexpected QPACK decoder feedback"
Stdlib.Http3Uni.receive (Stdlib.Http3Uni.create true) 3L (Stdlib.Blob.fromHex "01" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false = Error "Unpermitted HTTP/3 push stream"
Stdlib.Http3Uni.receive (Stdlib.Http3Uni.create true) 3L (Stdlib.Blob.fromHex "000400" |> Stdlib.Result.withDefault Stdlib.Blob.empty) true false = Error "Closed critical HTTP/3 stream"
Stdlib.Http3Uni.receive (Stdlib.Http3Uni.create true) 3L (Stdlib.Blob.fromHex "02" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false true = Error "Closed critical HTTP/3 stream"
Stdlib.Http3Uni.receive (Stdlib.Http3Uni.create true) 3L (Stdlib.Blob.fromHex "4021" |> Stdlib.Result.withDefault Stdlib.Blob.empty) true false |> Stdlib.Result.map (fun received -> received.state.streams |> Stdlib.List.length) = Ok 1
Stdlib.Http3Uni.receive (Stdlib.Http3Uni.create true) 3L (Stdlib.Blob.fromHex "40" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false |> Stdlib.Result.andThen (fun received -> Stdlib.Http3Uni.receive received.state 3L (Stdlib.Blob.fromHex "000400" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false) |> Stdlib.Result.map (fun received -> received.state.controlId) = Ok (Some 3L)
