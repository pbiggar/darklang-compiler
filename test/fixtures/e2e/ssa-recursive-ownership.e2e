// Lifetime regressions formerly checked against the retired structured RC
// accumulator strategy. Exercise production compilation and observable values
// instead of requiring that strategy's particular retain/decrement placement.

// Empty and nonempty closure-producing maps, with the source still live.
let make (xs: List<Int64>) : List<Int64 -> Int64> = Stdlib.List.map xs (fun x -> fun y -> x + y) let fs = make [] in Stdlib.List.length fs = stdout="0\n" stderr="" disable_opt_inline=true
let xs = [1L, 2L, 3L] in let fs = Stdlib.List.map xs (fun x -> fun y -> x + y) in let result = Stdlib.List.fold fs 0L (fun acc f -> acc + f 10L) in result + Stdlib.List.fold xs 0L (fun acc x -> acc + x) = stdout="42\n" stderr="" disable_opt_inline=true
let xs = [1L, 2L, 3L] in let fs = Stdlib.List.map xs (fun x -> fun y -> x + y) in let result = Stdlib.List.fold fs 0L (fun acc f -> acc + f 10L) in result + Stdlib.List.fold xs 0L (fun acc x -> acc + x) = stdout="42\n" stderr="" disable_opt_inline=true disable_opt_freelist=true

// Replacing a closure-list accumulator must preserve its captured values.
let build (n: Int64) (acc: List<Int64 -> Int64>) : List<Int64 -> Int64> = if n <= 0L then acc else build (n - 1L) (Stdlib.List.push acc (fun x -> x + n)) let fs = build 50L [] in Stdlib.List.fold fs 0L (fun acc f -> acc + f 1L) = stdout="1325\n" stderr="" disable_opt_inline=true

// Project managed children from a fresh parent before recursive transfer.
let step (a: (Int64 * Int64 * Int64)) (b: (Int64 * Int64)) : ((Int64 * Int64 * Int64) * (Int64 * Int64)) = let (x, y, z) = a in let (p, q) = b in ((x + 1L, y + 1L, z + 1L), (p + 1L, q + 1L)) let loop (n: Int64) (a: (Int64 * Int64 * Int64)) (b: (Int64 * Int64)) : Int64 = if n <= 0L then let (x, y, z) = a in let (p, q) = b in x + y + z + p + q else let (nextA, nextB) = step a b in loop (n - 1L) nextA nextB loop 50L (1L, 2L, 3L) (4L, 5L) = stdout="265\n" stderr="" disable_opt_inline=true

// Non-tail recursion must keep the projected children alive during the call.
let step (a: (Int64 * Int64)) (b: (Int64 * Int64)) : ((Int64 * Int64) * (Int64 * Int64)) = let (x, y) = a in let (p, q) = b in ((x + 1L, y + 1L), (p + 1L, q + 1L)) let loop (n: Int64) (a: (Int64 * Int64)) (b: (Int64 * Int64)) : Int64 = if n <= 0L then let (x, y) = a in let (p, q) = b in x + y + p + q else let (nextA, nextB) = step a b in 1L + loop (n - 1L) nextA nextB loop 50L (1L, 2L) (3L, 4L) = stdout="260\n" stderr="" disable_opt_inline=true

// Aliased projections cross both sides of a conditional recursive path.
let step (a: (Int64 * Int64)) (b: (Int64 * Int64)) : ((Int64 * Int64) * (Int64 * Int64)) = let (x, y) = a in let (p, q) = b in ((x + 1L, y + 1L), (p + 1L, q + 1L)) let loop (n: Int64) (a: (Int64 * Int64)) (b: (Int64 * Int64)) : Int64 = if n <= 0L then let (x, y) = a in let (p, q) = b in x + y + p + q else let parent = step a b in let alias = parent in let (nextA, nextB) = alias in let aa = nextA in let bb = nextB in if n % 2L = 0L then loop (n - 1L) aa bb else loop (n - 1L) bb aa loop 50L (1L, 2L) (3L, 4L) = stdout="210\n" stderr="" disable_opt_inline=true
let step (a: (Int64 * Int64)) (b: (Int64 * Int64)) : ((Int64 * Int64) * (Int64 * Int64)) = let (x, y) = a in let (p, q) = b in ((x + 1L, y + 1L), (p + 1L, q + 1L)) let loop (n: Int64) (a: (Int64 * Int64)) (b: (Int64 * Int64)) : Int64 = if n <= 0L then let (x, y) = a in let (p, q) = b in x + y + p + q else let parent = step a b in let alias = parent in let (nextA, nextB) = alias in let aa = nextA in let bb = nextB in if n % 2L = 0L then loop (n - 1L) aa bb else loop (n - 1L) bb aa loop 50L (1L, 2L) (3L, 4L) = stdout="210\n" stderr="" disable_opt_inline=true disable_opt_freelist=true
