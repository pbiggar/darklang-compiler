// quic_handshake_frames.e2e - Bounded QUIC handshake frames and ordered CRYPTO bytes.
Stdlib.Blob.fromHex "0001060003616263" |> Stdlib.Result.andThen Stdlib.QuicFrames.parseHandshake |> Stdlib.Result.map (fun frames -> Stdlib.List.length frames) = Ok 3
Stdlib.Blob.fromHex "0200000000" |> Stdlib.Result.andThen Stdlib.QuicFrames.parseHandshake |> Stdlib.Result.map (fun frames -> Stdlib.List.length frames) = Ok 1
Stdlib.Blob.fromHex "0600056162" |> Stdlib.Result.andThen Stdlib.QuicFrames.parseHandshake = Error "Truncated QUIC CRYPTO frame"
Stdlib.Blob.fromHex "0200000001" |> Stdlib.Result.andThen Stdlib.QuicFrames.parseHandshake = Error "Invalid QUIC ACK range"
Stdlib.Blob.fromHex "4001" |> Stdlib.Result.andThen Stdlib.QuicFrames.parseHandshake = Error "Non-minimal QUIC frame type"
Stdlib.Blob.fromHex "08" |> Stdlib.Result.andThen Stdlib.QuicFrames.parseHandshake = Error "Frame is not permitted in QUIC handshake packets"
Stdlib.QuicReassembly.create 1024L |> Stdlib.Result.andThen (fun state -> Stdlib.QuicReassembly.insert state 3L (Stdlib.String.toBlob "def")) |> Stdlib.Result.andThen (fun state -> Stdlib.QuicReassembly.insert state 0L (Stdlib.String.toBlob "abc")) |> Stdlib.Result.map (fun state -> Stdlib.Blob.toHex (Stdlib.QuicReassembly.available state)) = Ok "616263646566"
Stdlib.QuicReassembly.create 1024L |> Stdlib.Result.andThen (fun state -> Stdlib.QuicReassembly.insert state 0L (Stdlib.String.toBlob "abc")) |> Stdlib.Result.andThen (fun state -> Stdlib.QuicReassembly.insert state 1L (Stdlib.String.toBlob "bcdef")) |> Stdlib.Result.map (fun state -> Stdlib.Blob.toHex (Stdlib.QuicReassembly.available state)) = Ok "616263646566"
Stdlib.Blob.fromHex "02030001000000" |> Stdlib.Result.andThen Stdlib.QuicFrames.parseHandshake |> Stdlib.Result.map (fun frames -> match frames with | Ack value :: _ -> Stdlib.List.map value.ranges (fun range -> (range.smallest, range.largest)) | _ -> []) = Ok [(3L, 3L), (1L, 1L)]
Stdlib.Blob.fromHex "02010001000000" |> Stdlib.Result.andThen Stdlib.QuicFrames.parseHandshake = Error "Invalid QUIC ACK range"
Stdlib.Blob.fromHex "0300000000010203" |> Stdlib.Result.andThen Stdlib.QuicFrames.parseHandshake |> Stdlib.Result.map (fun frames -> match frames with | Ack value :: _ -> (match value.ecn with | Some ecn -> ecn.ce | None -> -1L) | _ -> -1L) = Ok 3L
Stdlib.Blob.fromHex "06FFFFFFFFFFFFFFFF0161" |> Stdlib.Result.andThen Stdlib.QuicFrames.parseHandshake = Error "Invalid QUIC CRYPTO range"
Stdlib.QuicReassembly.create 1024L |> Stdlib.Result.andThen (fun state -> Stdlib.QuicReassembly.insert state 0L (Stdlib.String.toBlob "abc")) |> Stdlib.Result.andThen (fun state -> Stdlib.QuicReassembly.insert state 1L (Stdlib.String.toBlob "Xd")) = Error "Conflicting QUIC CRYPTO bytes"
Stdlib.QuicReassembly.create 4L |> Stdlib.Result.andThen (fun state -> Stdlib.QuicReassembly.insert state 3L (Stdlib.String.toBlob "ab")) = Error "QUIC CRYPTO buffer exceeds limit"
Stdlib.QuicReassembly.create 4L |> Stdlib.Result.andThen (fun state -> Stdlib.QuicReassembly.insert state 0L (Stdlib.String.toBlob "abcd")) |> Stdlib.Result.map Stdlib.QuicReassembly.drain |> Stdlib.Result.andThen (fun state -> Stdlib.QuicReassembly.insert state 2L (Stdlib.String.toBlob "cdef")) |> Stdlib.Result.map (fun state -> Stdlib.Blob.toHex (Stdlib.QuicReassembly.available state)) = Ok "6566"
Stdlib.QuicReassembly.create 4L |> Stdlib.Result.andThen (fun state -> Stdlib.QuicReassembly.insert state 4611686018427387903L Stdlib.Blob.empty) |> Stdlib.Result.map (fun state -> Stdlib.Blob.length (Stdlib.QuicReassembly.available state)) = Ok 0
