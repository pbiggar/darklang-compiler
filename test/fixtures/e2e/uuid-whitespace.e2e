// Guid X-format parsing removes whitespace codepoints anywhere in the input.

Stdlib.Uuid.toString (Builtin.unwrap (Stdlib.Uuid.parse "{0x0,\r\n0x0,0x0,{0x0,0x0,0x0,0x0,0x0,0x0,0x0,0x0}}")) = "00000000-0000-0000-0000-000000000000"
Stdlib.Uuid.toString (Builtin.unwrap (Stdlib.Uuid.parse "{0\r\nx1,0x2,0x3,{0x4,0x5,0x6,0x7,0x8,0x9,0xa,0xb}}")) = "00000001-0002-0003-0405-060708090a0b"
Stdlib.Uuid.toString (Builtin.unwrap (Stdlib.Uuid.parse "{0x3\r\n700adbc,0x7a46,0x4ff4,{0x81,0xd3,0x45,0xaf,0xb0,0x3f,0x6e,0x2d}}")) = "3700adbc-7a46-4ff4-81d3-45afb03f6e2d"
Stdlib.Uuid.toString (Builtin.unwrap (Stdlib.Uuid.parse "\u00a0\r\n{0x0,\t\n\u000b\u000c\r \u0085\u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u30000x0,0x0,{0x0,0x0,0x0,0x0,0x0,0x0,0x0,0x0}}\r\n\u00a0")) = "00000000-0000-0000-0000-000000000000"
Stdlib.Uuid.toString (Builtin.unwrap (Stdlib.Uuid.parse "{0x0, 0x0,0x0,{0x0,0x0,0x0,0x0,0x0,0x0,0x0,0x0}}")) = "00000000-0000-0000-0000-000000000000"
Stdlib.Uuid.parse "{0x0,\u200b0x0,0x0,{0x0,0x0,0x0,0x0,0x0,0x0,0x0,0x0}}" = Error Stdlib.Uuid.ParseError.BadFormat
Stdlib.Uuid.parse "{0x0,\u00a0\u03010x0,0x0,{0x0,0x0,0x0,0x0,0x0,0x0,0x0,0x0}}" = Error Stdlib.Uuid.ParseError.BadFormat
let input = "{0x0," ++ Stdlib.String.repeat "\r\n\u00a0" 32 ++ "0x0,0x0,{0x0,0x0,0x0,0x0,0x0,0x0,0x0,0x0}}" in (Stdlib.Uuid.toString (Builtin.unwrap (Stdlib.Uuid.parse input)), Stdlib.String.endsWith input "}}") = ("00000000-0000-0000-0000-000000000000", true)
