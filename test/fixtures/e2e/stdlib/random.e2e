// Stdlib.Random Tests
//
// Tests for Random module functions

// ===================================================================
// Stdlib.Int64.random - upstream bounded Int64 randomness
// ===================================================================

// Stdlib.Int64.random returns an Int64 inside the inclusive bounds.
(let x = Stdlib.Int64.random (-10L) 10L in x >= -10L && x <= 10L) = true

// Multiple calls both return Int64 values without relying on probabilistic uniqueness
(let x = Stdlib.Int64.random 5L 5L in let y = Stdlib.Int64.random (-5L) (-5L) in x == 5L && y == -5L) = true
