// Stdlib.Tuple3 Tests
// Ported from https://github.com/darklang/dark/tree/main/backend/testfiles/execution/stdlib
//
// Tests for Tuple3 module functions

// ===================================================================
// Stdlib.Tuple3.create - Constructs a triple from three values
// ===================================================================

Stdlib.Tuple3.first (Stdlib.Tuple3.create 1L 2L 3L) = 1L
Stdlib.Tuple3.second (Stdlib.Tuple3.create 1L 2L 3L) = 2L
Stdlib.Tuple3.third (Stdlib.Tuple3.create 1L 2L 3L) = 3L
Stdlib.Tuple3.create "one" 2L "pi" = ("one", 2L, "pi")

// ===================================================================
// Stdlib.Tuple3.first - Returns the first value of a triple
// ===================================================================

Stdlib.Tuple3.first ((1L, 2L, 3L)) = 1L
Stdlib.Tuple3.first ((42L, 0L, 99L)) = 42L
Stdlib.Tuple3.first ((true, false, true)) = true
Stdlib.Tuple3.first (("one", 2L, "pi")) = "one"

// ===================================================================
// Stdlib.Tuple3.second - Returns the second value of a triple
// ===================================================================

Stdlib.Tuple3.second ((1L, 2L, 3L)) = 2L
Stdlib.Tuple3.second ((0L, 42L, 99L)) = 42L
Stdlib.Tuple3.second (("one", 2L, "pi")) = 2L

// ===================================================================
// Stdlib.Tuple3.third - Returns the third value of a triple
// ===================================================================

Stdlib.Tuple3.third ((1L, 2L, 3L)) = 3L
Stdlib.Tuple3.third ((0L, 0L, 42L)) = 42L
Stdlib.Tuple3.third (("one", 2L, "pi")) = "pi"

// ===================================================================
// Stdlib.Tuple3.mapFirst - Transform the first value in a triple
// ===================================================================

Stdlib.Tuple3.first (Stdlib.Tuple3.mapFirst ((5L, 10L, 15L)) (fun x -> x + 1L)) = 6L
Stdlib.Tuple3.second (Stdlib.Tuple3.mapFirst ((5L, 10L, 15L)) (fun x -> x + 1L)) = 10L
Stdlib.Tuple3.third (Stdlib.Tuple3.mapFirst ((5L, 10L, 15L)) (fun x -> x + 1L)) = 15L
Stdlib.Tuple3.mapFirst (("one", 2L, "pi")) (fun x -> Stdlib.String.toUppercase x) = ("ONE", 2L, "pi")

// ===================================================================
// Stdlib.Tuple3.mapSecond - Transform the second value in a triple
// ===================================================================

Stdlib.Tuple3.first (Stdlib.Tuple3.mapSecond ((5L, 10L, 15L)) (fun x -> x + 1L)) = 5L
Stdlib.Tuple3.second (Stdlib.Tuple3.mapSecond ((5L, 10L, 15L)) (fun x -> x + 1L)) = 11L
Stdlib.Tuple3.third (Stdlib.Tuple3.mapSecond ((5L, 10L, 15L)) (fun x -> x + 1L)) = 15L
Stdlib.Tuple3.mapSecond (("one", 2L, "pi")) (fun x -> x - 2L) = ("one", 0L, "pi")

// ===================================================================
// Stdlib.Tuple3.mapThird - Transform the third value in a triple
// ===================================================================

Stdlib.Tuple3.first (Stdlib.Tuple3.mapThird ((5L, 10L, 15L)) (fun x -> x + 1L)) = 5L
Stdlib.Tuple3.second (Stdlib.Tuple3.mapThird ((5L, 10L, 15L)) (fun x -> x + 1L)) = 10L
Stdlib.Tuple3.third (Stdlib.Tuple3.mapThird ((5L, 10L, 15L)) (fun x -> x + 1L)) = 16L
Stdlib.Tuple3.mapThird (("one", 2L, "pi")) (fun x -> Stdlib.String.toUppercase x) = ("one", 2L, "PI")

// ===================================================================
// Stdlib.Tuple3.mapAllThree - Transform all three values in a triple
// ===================================================================

Stdlib.Tuple3.first (Stdlib.Tuple3.mapAllThree ((5L, 10L, 15L)) (fun x -> x + 1L) (fun y -> y * 2L) (fun z -> z - 1L)) = 6L
Stdlib.Tuple3.second (Stdlib.Tuple3.mapAllThree ((5L, 10L, 15L)) (fun x -> x + 1L) (fun y -> y * 2L) (fun z -> z - 1L)) = 20L
Stdlib.Tuple3.third (Stdlib.Tuple3.mapAllThree ((5L, 10L, 15L)) (fun x -> x + 1L) (fun y -> y * 2L) (fun z -> z - 1L)) = 14L
Stdlib.Tuple3.mapAllThree (("one", 2L, "pi")) (fun x -> Stdlib.String.toUppercase x) (fun y -> y - 2L) (fun z -> Stdlib.String.toUppercase z) = ("ONE", 0L, "PI")
