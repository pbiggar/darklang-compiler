// Recursive local functions work through every expression container and as values.
type RecBox = { value: Int64 }
type RecCase = RecCase of Int64

(let recur (n: Int64) : Int64 = if n == 0L then 0L else Builtin.unwrap (Stdlib.List.head [recur (n - 1L)]) in recur 3L) = 0L
(let recur (n: Int64) : Int64 = if n == 0L then 0L else Stdlib.Tuple2.first (recur (n - 1L), 1L) in recur 3L) = 0L
(let recur (n: Int64) : Int64 = if n == 0L then 0L else (RecBox { value = recur (n - 1L) }).value in recur 3L) = 0L
(let recur (n: Int64) : Int64 = if n == 0L then 0L else Builtin.unwrap (Stdlib.Dict.get (Dict { "x": recur (n - 1L) }) "x") in recur 3L) = 0L
(let recur (n: Int64) : Int64 = if n == 0L then 0L else Stdlib.Dict.size (Dict { recur (n - 1L): 1L }) |> Stdlib.Int.toInt64 in recur 3L) = 1L
(let recur (n: Int64) : Int64 = if n == 0L then 0L else { RecBox { value = 1L } with value = recur (n - 1L) }.value in recur 3L) = 0L
(let recur (n: Int64) : RecBox = if n == 0L then RecBox { value = 0L } else { recur (n - 1L) with value = 1L } in (recur 3L).value) = 1L
(let recur (n: Int64) : Int64 = if n == 0L then 0L else match RecCase (recur (n - 1L)) with | RecCase value -> value in recur 3L) = 0L
(let recur (n: Int64) : String = if n == 0L then "" else $"x{recur (n - 1L)}" in recur 3L) = "xxx"

// Pipes cover their source and each segment form.
(let recur (n: Int64) : Int64 = if n == 0L then 0L else (n - 1L) |> recur in recur 3L) = 0L
(let recur (n: Int64) : Int64 = if n == 0L then 0L else recur (n - 1L) |> Stdlib.Int64.add 1L in recur 3L) = 3L
(let recur (n: Int64) : Int64 = if n == 0L then 0L else 1L |> (fun value -> value + recur (n - 1L)) in recur 3L) = 3L
(let recur (n: Int64) : Int64 = if n == 0L then 0L else 1L |> (+) (recur (n - 1L)) in recur 3L) = 3L
(let recur (n: Int64) : Int64 = if n == 0L then 0L else match recur (n - 1L) |> RecCase with | RecCase value -> value in recur 3L) = 0L

// Passing the function itself is a recursive reference, not only direct calls.
(let recur (n: Int64) : Int64 = if n == 0L then 0L else (fun fn -> fn (n - 1L)) recur in recur 3L) = 0L

// Shadowed names belong to parameters and destructured bindings, not recursion.
(let recur (n: Int64) : Int64 = (fun recur -> recur n) (fun value -> value + 1L) in recur 3L) = 4L
(let recur (n: Int64) : Int64 = let (recur, other) = ((fun value -> value + 1L), 0L) in recur n + other in recur 3L) = 4L
