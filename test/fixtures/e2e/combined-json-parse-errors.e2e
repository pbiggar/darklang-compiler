// Isolated aggregate of the upstream Int64 JSON error assertions.
type Result<'ok, 'err> = Stdlib.Result.Result<'ok, 'err>
let err (v: Stdlib.Result.Result<'a, Stdlib.Json.ParseError.ParseError>) : Result<'a, String> =
  v |> Stdlib.Result.mapError (Stdlib.Json.ParseError.toString Darklang.SCM.Branch.mainBranchId)

let parseErrors () : Stdlib.Test.Result =
  Stdlib.Test.all
    [ // not ints
      (Stdlib.Json.parse<Int64> " ") |> err
      |> Stdlib.Test.equal (Result.Error "Not JSON")
      (Stdlib.Json.parse<Int64> "4a") |> err
      |> Stdlib.Test.equal (Result.Error "Not JSON")
      (Stdlib.Json.parse<Int64> "- 42") |> err
      |> Stdlib.Test.equal (Result.Error "Not JSON")
      (Stdlib.Json.parse<Int64> "null") |> err
      |> Stdlib.Test.equal (Result.Error "Can't parse JSON `null` as type `Int64` at path: `root`")
      (Stdlib.Json.parse<Int64> "true") |> err
      |> Stdlib.Test.equal (Result.Error "Can't parse JSON `true` as type `Int64` at path: `root`")
      (Stdlib.Json.parse<Int64> "false") |> err
      |> Stdlib.Test.equal (Result.Error "Can't parse JSON `false` as type `Int64` at path: `root`")
      (Stdlib.Json.parse<Int64> "\"42\"") |> err
      |> Stdlib.Test.equal (Result.Error "Can't parse JSON `\"42\"` as type `Int64` at path: `root`")
      (Stdlib.Json.parse<Int64> "[42]") |> err
      |> Stdlib.Test.equal (Result.Error "Can't parse JSON `[42]` as type `Int64` at path: `root`")
      (Stdlib.Json.parse<Int64> "{ \"key\": 42 }") |> err
      |> Stdlib.Test.equal (Result.Error "Can't parse JSON `{ \"key\": 42 }` as type `Int64` at path: `root`")
      (Stdlib.Json.parse<Int64> "42.5") |> err
      |> Stdlib.Test.equal (Result.Error "Can't parse JSON `42.5` as type `Int64` at path: `root`")
      (Stdlib.Json.parse<Int64> "\"42\n\"") |> err
      |> Stdlib.Test.equal (Result.Error "Not JSON") ]

parseErrors () = Stdlib.Test.Result.Pass
