// Canonical name-resolution boundary and interpreter-derived precedence.

let duplicatedFirst (x: Int64): Int64 = x + 1L
let duplicatedSecond (x: Int64): Int64 = x + 2L

// Qualified package/module spellings resolve exactly.
Stdlib.Float.sqrt 4.0 = 2.0

// The interpreter's canonical stdlib root and its public shortcut name the
// same declaration.
Darklang.Stdlib.Float.sqrt 9.0 = 3.0

// Option and Result retain their interpreter-wide short type and constructor
// spellings without implicitly opening the rest of the standard library.
let shortOption (value: Int64): Option<Int64> = Option.Some value in shortOption 4L = Some 4L
let shortResult (value: Int64): Result<Int64, String> = Result.Ok value in shortResult 5L = Ok 5L

// Fully-qualified canonical identities and the Stdlib shortcut agree.
let canonicalOption (value: Int64): Darklang.Stdlib.Option.Option<Int64> = Darklang.Stdlib.Option.Option.Some value in canonicalOption 6L = Some 6L
let shortcutResult (value: Int64): Stdlib.Result.Result<Int64, String> = Stdlib.Result.Result.Ok value in shortcutResult 7L = Ok 7L

// The compiler no longer inserts an implicit Stdlib qualifier.
Float.sqrt 4.0 = compileerror="Unknown function or value 'Float.sqrt'"
Stdlib.Bytes.create 0L = compileerror="Unknown function or value 'Stdlib.Bytes.create'"

// Lexical callable values shadow a same-spelled top-level function.
let shadowed (x: Int64): Int64 = x + 10L; let shadowed = fun x -> x + 20L in shadowed 1L = 21L

// Distinct top-level functions retain their own identities.
duplicatedSecond 1L = 3L

// Constructors from distinct user types do not acquire an order-dependent winner.
type FirstChoice = SharedChoice | FirstOnly
type SecondChoice = SharedChoice | SecondOnly
SharedChoice = compileerror="Constructor 'SharedChoice' requires an expected enum type"

// Explicit qualification selects the constructor identity uniquely.
type QualifiedFirst = QualifiedShared | QualifiedFirstOnly
type QualifiedSecond = QualifiedShared | QualifiedSecondOnly
QualifiedFirst.QualifiedShared == QualifiedFirst.QualifiedShared = true

// Missing names retain their reference category in the diagnostic.
doesNotExist 1L = compileerror="Unknown function or value 'doesNotExist'"

// A function identity in value position is never coerced into a call.
let nullaryIdentity (): Int64 = 1L let needsInt64 (): Int64 = nullaryIdentity; needsInt64 () = compileerror="Expected TInt64, got TFunction ([TUnit], TInt64)"
