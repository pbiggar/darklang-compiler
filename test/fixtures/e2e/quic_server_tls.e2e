// quic_server_tls.e2e - QUIC server negotiation rejects incomplete offers before signing.
Stdlib.QuicServerTls.start (Stdlib.TlsServerIdentity.Identity { certificates = [], key = Stdlib.RsaPrivate.Key { modulus = Stdlib.Blob.empty, exponent = Stdlib.Blob.empty, privateExponent = Stdlib.Blob.empty } }) Stdlib.Blob.empty Stdlib.Blob.empty Stdlib.Blob.empty = Error "Incomplete TLS ClientHello"
