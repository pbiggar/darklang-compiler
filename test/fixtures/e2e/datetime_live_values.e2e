// datetime_live_values.e2e - The realtime clock must preserve live managed values.
let left = Stdlib.String.toBlob (Stdlib.Int.toString (Stdlib.DateTime.year (Stdlib.DateTime.now ()))) in let right = Stdlib.String.toBlob "preserved" in let values = [left, right] in let later = Stdlib.DateTime.now () in (Stdlib.Blob.toString right, Stdlib.List.length values, Stdlib.Blob.length left, Stdlib.DateTime.toMilliseconds later > 1000000000000) = ((Ok "preserved"), 2, 4, true)
let now = Stdlib.DateTime.now () in let values = [Stdlib.String.toBlob "one", Stdlib.String.toBlob "two"] in let header = Stdlib.String.toUppercase "x-clock" in let later = Stdlib.DateTime.now () in (Stdlib.List.map values Stdlib.Blob.toString, header, Stdlib.DateTime.toMilliseconds later >= Stdlib.DateTime.toMilliseconds now) = ([Ok "one", Ok "two"], "X-CLOCK", true)
Stdlib.List.map [Stdlib.String.toBlob "one", Stdlib.String.toBlob "two"] (fun value -> let now = Stdlib.DateTime.now () in (Stdlib.Blob.toString value, Stdlib.DateTime.toMilliseconds now > 1000000000000)) = [((Ok "one"), true), ((Ok "two"), true)]
let first = Stdlib.DateTime.toMilliseconds (Stdlib.DateTime.now ()) in let second = Stdlib.DateTime.toMilliseconds (Stdlib.DateTime.now ()) in second - first < 10000 && second - first >= 0 = true
let value = Stdlib.Int.toString (Stdlib.DateTime.year (Stdlib.DateTime.now ())) in let check = fun a b c d e f g -> let now = Stdlib.DateTime.now () in (Stdlib.String.length a, Stdlib.String.length b, Stdlib.String.length c, Stdlib.String.length d, Stdlib.String.length e, Stdlib.String.length f, Stdlib.String.length g, Stdlib.DateTime.toMilliseconds now > 1000000000000) in check (value ++ "a") (value ++ "b") (value ++ "c") (value ++ "d") (value ++ "e") (value ++ "f") (value ++ "g") = (5, 5, 5, 5, 5, 5, 5, true)
