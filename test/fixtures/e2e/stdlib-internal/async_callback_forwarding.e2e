// async_callback_forwarding.e2e - Known callbacks retain demand semantics through source helper chains.

let forwardedApply (callback: Int64 -> Int64) (value: Int64) : Int64 = callback value
let forwardedOnce (callback: Int64 -> Int64) (value: Int64) : Int64 = forwardedApply callback value
let forwardedChain (callback: Int64 -> Int64) (value: Int64) : Int64 = forwardedOnce callback (forwardedOnce callback value)
let forwardedRepeat (count: Int64) (callback: Int64 -> Int64) (value: Int64) : Int64 =
  if count == 0L then value else forwardedRepeat (count - 1L) callback (forwardedOnce callback value)
let forwardedBoth (first: Int64 -> Int64) (second: Int64 -> Int64) (value: Int64) : Int64 = forwardedOnce second (forwardedOnce first value)
let forwardedDuplicate (callback: Int64 -> Int64) (value: Int64) : Int64 = forwardedBoth callback callback value
let forwardedStringApply (callback: Unit -> String) : String = callback ()
let forwardedString (callback: Unit -> String) : String = forwardedStringApply callback
let forwardedFloatApply (callback: Float -> Float) (value: Float) : Float = callback value
let forwardedFloat (callback: Float -> Float) (value: Float) : Float = forwardedFloatApply callback value
let forwardedMap (values: List<Int64>) (callback: Int64 -> Int64) : List<Int64> =
  match values with
  | [] -> []
  | head :: tail -> Stdlib.List.push (forwardedMap tail callback) (forwardedOnce callback head)

