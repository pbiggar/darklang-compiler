// async_promise.e2e - Native promise transitions and reference-counted ownership.
// These exercise the private promise object, not transparent forcing or fibers.

let promiseTransitions () : (Bool * Option<Int64> * List<Int64> * Bool * Option<Int64> * Option<Int64>) =
  let promise = Stdlib.__Async.__new<Int64> () in
  let before = Stdlib.__Async.__isReady promise in
  let missing = Stdlib.__Async.__poll promise in
  let _ = Stdlib.__Async.__wait promise 11L in
  let _ = Stdlib.__Async.__wait promise 22L in
  let _ = Stdlib.__Async.__wait promise 11L in
  let waiters = Stdlib.__Async.__resolve promise 42L in
  let late = Stdlib.__Async.__wait promise 33L in
  let first = Stdlib.__Async.__poll promise in
  let second = Stdlib.__Async.__poll promise in
  (before, missing, waiters, late, first, second)

promiseTransitions () = (false, None, [11L, 22L], false, Some 42L, Some 42L) // leak_check

let promiseReady<'a> (value: a) : Option<a> =
  let promise = Stdlib.__Async.__new<a> () in
  let _ = Stdlib.__Async.__resolve promise value in
  Stdlib.__Async.__poll promise

promiseReady (-9223372036854775808L) = Some (-9223372036854775808L) // leak_check
promiseReady 18446744073709551615UL = Some 18446744073709551615UL // leak_check
promiseReady 3.25 = Some 3.25 // leak_check
promiseReady 170141183460469231731687303715884105727Q = Some 170141183460469231731687303715884105727Q // leak_check
promiseReady 340282366920938463463374607431768211455Z = Some 340282366920938463463374607431768211455Z // leak_check
promiseReady 1000000000000000000000000000000 = Some 1000000000000000000000000000000 // leak_check
promiseReady false = Some false // leak_check
promiseReady () = Some () // leak_check
promiseReady<Option<Int64>> None = Some None // leak_check
promiseReady<List<Int64>> [] = Some [] // leak_check
promiseReady ("dynamic" + " payload") = Some "dynamic payload" // leak_check
promiseReady ["one" + "!", "two" + "!"] = Some ["one!", "two!"] // leak_check
promiseReady (("tuple" + " value"), [1L, 2L]) = Some (("tuple value", [1L, 2L])) // leak_check
promiseReady<Result<Int64, String>> (Error ("network" + " failure")) = Some (Error "network failure") // leak_check

let promiseAbandon () : Unit =
  let promise = Stdlib.__Async.__new<String> () in
  ()

promiseAbandon () = () // leak_check

let promiseProducer () : Unit -> Option<String> =
  let promise = Stdlib.__Async.__new<String> () in
  fun _unit ->
    let _ = Stdlib.__Async.__resolve promise ("producer" + " alive") in
    Stdlib.__Async.__poll promise

let producer = promiseProducer () in producer () = Some "producer alive" // leak_check

let promiseSharedPayload () : (Option<String> * Option<String>) =
  let promise = Stdlib.__Async.__new<String> () in
  let _ = Stdlib.__Async.__resolve promise ("shared" + " payload") in
  let first = Stdlib.__Async.__poll promise in
  let second = Stdlib.__Async.__poll promise in
  (first, second)

promiseSharedPayload () = (Some "shared payload", Some "shared payload") // leak_check

let promiseDropPayload (counter: RawPtr) : Unit =
  let promise = Stdlib.__Async.__new<Stream<Int64>> () in
  let _ = Stdlib.__Async.__resolve promise (Stdlib.Stream.__new (fun _unit -> None) (fun _unit -> __raw_write_word counter 0L 1L)) in
  ()

let counter = __raw_alloc 8L in let _ = __raw_write_word counter 0L 0L in let _ = promiseDropPayload counter in let result = __raw_get<Int64> counter 0L in let _ = __raw_free counter in result = 1L // leak_check

let promiseClosure () : String =
  let text = "captured" + " value" in
  match promiseReady (fun _unit -> text) with
  | None -> "missing"
  | Some fn -> fn ()

promiseClosure () = "captured value" // leak_check

let promiseDoubleResolve () : List<Int64> =
  let promise = Stdlib.__Async.__new<Int64> () in
  let _ = Stdlib.__Async.__resolve promise 1L in
  Stdlib.__Async.__resolve promise 2L

promiseDoubleResolve () = error="Uncaught exception: Async promise resolved more than once"

let promise = Stdlib.__Async.__new<Int64> () in Stdlib.__Async.__resolve promise "wrong" = compileerror="Expected TInt64, got TString"

let promise = Stdlib.__Async.__new<Int64> () in let _ = Stdlib.__Async.__wait promise 1L in () = error="Uncaught exception: Async promise still has waiting tasks"
