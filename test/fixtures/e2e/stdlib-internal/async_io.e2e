// async_io.e2e - Socket readiness wakes native tasks alongside timer producers.

let ioInterest (listener: Stdlib.__Network.TcpListener) : Stdlib.__Network.Interest =
  Stdlib.__Network.Interest { watch = listener.watch, readable = true, writable = false }

let ioClosed () : Result<Bool, Int64> =
  Stdlib.__Network.listenTcp4 [127L, 0L, 0L, 1L] 0L |> Stdlib.Result.map (fun listener ->
    let _ = Stdlib.__Network.closeListener listener in
    Stdlib.__Task.__runMain (fun _unit ->
      match Stdlib.__Task.__forceCurrent (Stdlib.__Task.__watchCurrent (ioInterest listener)) with
      | Error _ -> false
      | Ok event -> event.closed))

ioClosed () = Ok true // leak_check

let ioTimerClose () : Result<Bool, Int64> =
  Stdlib.__Network.listenTcp4 [127L, 0L, 0L, 1L] 0L |> Stdlib.Result.map (fun listener ->
    Stdlib.__Task.__runMain (fun _unit ->
      let scheduler = Stdlib.__Task.__scheduler (__fiber_current ()) in
      let timer = Stdlib.__Task.__Timer { deadline = Stdlib.__Task.__now () + 2L, complete = (fun _unit -> Stdlib.__Network.closeListener listener) } in
      let _ = Stdlib.__Task.__registerTimer scheduler timer in
      match Stdlib.__Task.__forceCurrent (Stdlib.__Task.__watchCurrent (ioInterest listener)) with
      | Error _ -> false
      | Ok event -> event.closed))

ioTimerClose () = Ok true // leak_check

let ioInvalid () : Bool =
  let lifecycle = Stdlib.Stream.__new (fun _unit -> Some ()) (fun _unit -> ()) in
  let interest = Stdlib.__Network.Interest { watch = Stdlib.__Network.Watch { descriptor = 2147483647L, lifecycle = lifecycle }, readable = true, writable = false } in
  Stdlib.__Task.__runMain (fun _unit ->
    match Stdlib.__Task.__forceCurrent (Stdlib.__Task.__watchCurrent interest) with
    | Error _ -> false
    | Ok event -> event.failed)

ioInvalid () = true // leak_check

let ioOutputInterest () : Stdlib.__Network.Interest =
  let lifecycle = Stdlib.Stream.__new (fun _unit -> Some ()) (fun _unit -> ()) in
  Stdlib.__Network.Interest { watch = Stdlib.__Network.Watch { descriptor = 1L, lifecycle = lifecycle }, readable = false, writable = true }

Stdlib.__Task.__runMain (fun _unit -> match Stdlib.__Task.__forceCurrent (Stdlib.__Task.__watchCurrent (ioOutputInterest ())) with | Error _ -> false | Ok event -> event.writable) = true // kernel descriptor readiness; leak_check

let ioRecord (cell: RawPtr) (digit: Int64) : Unit =
  let event = Stdlib.__Task.__forceCurrent (Stdlib.__Task.__watchCurrent (ioOutputInterest ())) in
  match event with
  | Error _ -> __raw_write_word cell 0L -1L
  | Ok _ -> __raw_write_word cell 0L ((__raw_get<Int64> cell 0L) * 10L + digit)

let cell = __raw_alloc 8L in let _ = __raw_write_word cell 0L 0L in let _ = Stdlib.__Task.__run [(fun _context -> ioRecord cell 1L), (fun _context -> ioRecord cell 2L)] in let result = __raw_get<Int64> cell 0L in let _ = __raw_free cell in result = 12L // leak_check

Stdlib.__Task.__runMain (fun _unit -> let unused = Stdlib.__Task.__watchCurrent (ioOutputInterest ()) in 42L) = 42L // abandoned consumer; leak_check

let ioChain (cell: RawPtr) : Unit =
  let scheduler = Stdlib.__Task.__scheduler (__fiber_current ()) in
  let interest = ioOutputInterest () in
  let second = Stdlib.__Task.__IO { interest = interest, complete = (fun _result -> __raw_write_word cell 0L ((__raw_get<Int64> cell 0L) * 10L + 2L)) } in
  let first = Stdlib.__Task.__IO { interest = interest, complete = (fun _result -> let _ = __raw_write_word cell 0L 1L in Stdlib.__Task.__registerIO scheduler second) } in
  Stdlib.__Task.__registerIO scheduler first

let cell = __raw_alloc 8L in let _ = __raw_write_word cell 0L 0L in let _ = Stdlib.__Task.__runMain (fun _unit -> ioChain cell) in let result = __raw_get<Int64> cell 0L in let _ = __raw_free cell in result = 12L // callbacks can register a new readiness producer; leak_check

let ioFill (scheduler: RawPtr) (interest: Stdlib.__Network.Interest) (count: Int64) (cell: RawPtr) : Unit =
  if count == 0L then ()
  else
    let entry = Stdlib.__Task.__IO { interest = interest, complete = (fun result -> match result with | Ok _ -> __raw_write_word cell 0L ((__raw_get<Int64> cell 0L) + 1L) | Error code -> __raw_write_word cell 8L (if code == 22L then (__raw_get<Int64> cell 8L) + 1L else -100L)) } in
    let _ = Stdlib.__Task.__registerIO scheduler entry in
    ioFill scheduler interest (count - 1L) cell

let cell = __raw_alloc 16L in let _ = __raw_write_word cell 0L 0L in let _ = __raw_write_word cell 8L 0L in let _ = Stdlib.__Task.__runMain (fun _unit -> ioFill (Stdlib.__Task.__scheduler (__fiber_current ())) (ioOutputInterest ()) 1025L cell) in let result = (__raw_get<Int64> cell 0L, __raw_get<Int64> cell 8L) in let _ = __raw_free cell in result = (1024L, 1L) // readiness capacity reports an ordinary error; leak_check

let ioVirtual (closed: Bool) : Stdlib.__Network.TcpConnection =
  let lifecycle = Stdlib.Stream.__new (fun _unit -> Some ()) (fun _unit -> ()) in
  let _ = if closed then Stdlib.Stream.close lifecycle else () in
  Stdlib.__Network.TcpConnection { lifecycle = lifecycle, watch = None, read = (fun _length -> Error 22L), write = (fun _bytes -> Error 22L) }

Stdlib.__Task.__runMain (fun _unit -> Stdlib.__Task.__forceCurrent (Stdlib.__Task.__readTcpCurrent (ioVirtual true))) = Error 9L // closed input is an ordinary payload; leak_check
Stdlib.__Task.__runMain (fun _unit -> Stdlib.__Task.__forceCurrent (Stdlib.__Task.__readTcpCurrent (ioVirtual false))) = Error 22L // native reads reject virtual transports; leak_check
Stdlib.__Task.__readTcpCurrent (ioVirtual false) = error="Uncaught exception: Cannot start a socket read outside a native task"
