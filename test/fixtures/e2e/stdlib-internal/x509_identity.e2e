// x509_identity.e2e - DER leaf SAN and validity checks using an Ed25519 fixture.

(let cert = Stdlib.Base64.decode ""
 match cert with
 | Error message -> Error message
 | Ok bytes -> Stdlib.__X509Identity.parseUnverifiedLeaf bytes
               |> Stdlib.Result.map (fun leaf ->
                    (leaf.notBefore, leaf.notAfter, leaf.dnsNames)))
  = Ok ((20260927221402L, 20360924221402L, ["example.com", "*.example.org"]))

(let cert = Stdlib.Base64.decode ""
 let date = Stdlib.DateTime.parse "2026-10-01T00:00:00Z"
 match (cert, date) with
 | (Ok bytes, Ok at) ->
     match Stdlib.__X509Identity.parseUnverifiedLeaf bytes with
     | Error message -> Error message
     | Ok leaf ->
         let exact = Stdlib.__X509Identity.checkUnverifiedHostnameAt leaf "EXAMPLE.COM" at in
         let wildcard = Stdlib.__X509Identity.checkUnverifiedHostnameAt leaf "www.example.org" at in
         let apex = Stdlib.__X509Identity.checkUnverifiedHostnameAt leaf "example.org" at in
         let nested = Stdlib.__X509Identity.checkUnverifiedHostnameAt leaf "a.b.example.org" at in
         let cn = Stdlib.__X509Identity.checkUnverifiedHostnameAt leaf "ignored.example" at in
         Ok ((exact, wildcard, apex, nested, cn))
 | _ -> Error "Invalid fixture")
  = Ok ((Ok (), Ok (), Error "X.509 certificate does not match hostname",
        Error "X.509 certificate does not match hostname",
        Error "X.509 certificate does not match hostname"))

(let cert = Stdlib.Base64.decode ""
 let expired = Stdlib.DateTime.parse "2040-01-01T00:00:00Z"
 match (cert, expired) with
 | (Ok bytes, Ok at) ->
     match Stdlib.__X509Identity.parseUnverifiedLeaf bytes with
     | Error message -> Error message
     | Ok leaf -> Stdlib.__X509Identity.checkUnverifiedHostnameAt leaf "example.com" at
 | _ -> Error "Invalid fixture")
  = Error "X.509 certificate is outside its validity interval"

(Stdlib.Blob.fromHex "3000" |> Stdlib.Result.map Stdlib.__X509Identity.parseUnverifiedLeaf)
  = Ok (Error "Invalid X.509 certificate size")

(let cert = Stdlib.Base64.decode ""
 match cert with
 | Error message -> Error message
 | Ok bytes -> Stdlib.__X509Identity.parseUnverifiedLeaf bytes
               |> Stdlib.Result.map (fun leaf -> leaf.dnsNames))
  = Error "X.509 subjectAltName missing"

(Stdlib.Blob.fromHex "308300016D0000000000000000000000"
 |> Stdlib.Result.map Stdlib.__X509Identity.parseUnverifiedLeaf)
  = Ok (Error "Non-canonical DER length")
