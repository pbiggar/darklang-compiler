// async_capture.e2e - Capturing pending source values preserves transport and ownership.

let sourceMakeInspector (value: Int64) : Unit -> Int64 = fun _unit -> value + 1L

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let inspect = fun _ -> value + 1L in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in inspect ()) = 43L // capture does not demand; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let pass = fun _ -> value in let passed = pass () in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in passed + 1L) = 43L // returning a captured value does not demand; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Float> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let pass = fun _ -> value in let passed = pass () in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 40.25 in passed + 2.0) = 42.25 // captured float retains carrier register class; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<String> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let inspect = fun _ -> value ++ "!" in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate ("managed" ++ " result") in inspect ()) = "managed result!" // capture owns its pending managed payload; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let unused = fun _ -> value in 42L) = 42L // abandoned capture never waits; leak_check

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let inspect = sourceMakeInspector value in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in inspect ()) = 43L // an inspecting closure can escape its source function; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let child = Stdlib.__Task.__startCurrent (fun _child -> value) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in Stdlib.__Task.__forceCurrent child + 1L) = 43L // native child adapts a pending capture at its result boundary; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let inspect = fun _ -> let nested = fun _ -> value + 1L in nested () in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in inspect ()) = 43L // pending capture crosses nested environments; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let pass = fun (x: Int64) -> x in let passed = pass value in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in passed + 1L) = 43L // known closure arguments and results preserve transport; leak_check
