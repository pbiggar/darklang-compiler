// async_storage_calls.e2e - Pending fields cross ordinary source signatures.

type StoredSourceRecord = { value: Int64, ready: Int64 }
let sourceTuplePass (pair: (Int64 * Int64)) : (Int64 * Int64) = pair
let sourceTupleReady (pair: (Int64 * Int64)) : Int64 = let (_, ready) = pair in ready
let sourceRecordPass (record: StoredSourceRecord) : StoredSourceRecord = record
let sourceRecordReady (record: StoredSourceRecord) : Int64 = record.ready
let sourceMakePair (value: Int64) : (Int64 * Int64) = (value, 1L)
let sourceMakeRecord (value: Int64) : StoredSourceRecord = StoredSourceRecord { value = value; ready = 1L }

let sourceTupleSelect (condition: Bool) (pair: (Int64 * Int64)) : Int64 =
  let (left, right) = pair in if condition then left else right
let sourceWholeTupleReady (pair: (Int64 * Int64)) : Int64 = let (_, ready) = pair in ready
let sourceWholeRecordReady (record: StoredSourceRecord) : Int64 = record.ready
let sourceNestedPass (value: (Int64 * (Float * String))) : (Int64 * (Float * String)) = value

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let pair = sourceTuplePass (value, 1L) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in let (left, right) = pair in left + right) = 43L // tuple argument and result transport pending fields; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in sourceTupleReady (value, 42L)) = 42L // tuple callee inspects only the selected field; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let record = sourceRecordPass (StoredSourceRecord { value = value; ready = 1L }) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in record.value + record.ready) = 43L // nominal record transport keeps physical field types; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in sourceRecordReady (StoredSourceRecord { value = value; ready = 42L })) = 42L // record callee does not demand an unrelated field; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let pair = sourceMakePair value in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in let (left, right) = pair in left + right) = 43L // constructing a tuple in a callee does not demand its argument; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let record = sourceMakeRecord value in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in record.value + record.ready) = 43L // constructing a record in a callee does not demand its argument; leak_check

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let ready = sourceTuplePass (20L, 1L) in let pending = sourceTuplePass (value, 1L) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 20L in let (first, _) = ready in let (second, _) = pending in first + second + 2L) = 42L // concrete tuple calls retain their own layout; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let pair = (value, 42L) in let inspect = fun _ -> let (_, ready) = pair in ready in inspect ()) = 42L // captured aggregate keeps unrelated fields unresolved; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let pair = if true then (value, 1L) else (0L, 2L) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in let (left, right) = pair in left + right) = 43L // typed branch joins preserve pending field layouts; leak_check

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let first = sourceTupleSelect false (value, 20L) in let second = sourceTupleSelect true (22L, value) in first + second) = 42L // merging field layouts promotes only concrete siblings; leak_check
Stdlib.__Task.__runMain (fun _unit -> sourceWholeTupleReady (Stdlib.__Task.__delayTransparent 0L (1L, 42L))) = 42L // a wholly pending tuple is demanded before projection; leak_check
Stdlib.__Task.__runMain (fun _unit -> sourceWholeRecordReady (Stdlib.__Task.__delayTransparent 0L (StoredSourceRecord { value = 1L; ready = 42L }))) = 42L // a wholly pending record is demanded before projection; leak_check
Stdlib.__Task.__runMain (fun _unit -> let floatGate = Stdlib.__Async.__new<Float> () in let stringGate = Stdlib.__Async.__new<String> () in let floating = Stdlib.__Task.__transport (Stdlib.__Async.__pending floatGate) in let text = Stdlib.__Task.__transport (Stdlib.__Async.__pending stringGate) in let first = sourceNestedPass (1L, (floating, "ready")) in let second = sourceNestedPass (41L, (40.25, text)) in let (left, _) = first in let (right, _) = second in left + right) = 42L // nested shape promotion keeps mixed float and managed fields unresolved; leak_check
