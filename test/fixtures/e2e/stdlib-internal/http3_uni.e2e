// http3_uni.e2e - Critical stream uniqueness independent of QUIC stream numbers.
let uniReceive (state: Stdlib.__Http3Uni.State) (id: Int64) (bytes: Blob) (finished: Bool) (reset: Bool) : Stdlib.Result.Result<Stdlib.__Http3Uni.Received, String> =
  Stdlib.__Http3Uni.receive state id bytes finished reset |> Stdlib.Result.mapError (fun error -> error.message)
uniReceive (Stdlib.__Http3Uni.create true) 2L Stdlib.Blob.empty false false = Error "Invalid peer HTTP/3 unidirectional stream"
uniReceive (Stdlib.__Http3Uni.create true) 3L (Stdlib.Blob.fromHex "000400" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false |> Stdlib.Result.map (fun received -> (received.state.controlId, received.events)) = Ok ((Some 3L, [Settings []]))
uniReceive (Stdlib.__Http3Uni.create true) 7L (Stdlib.Blob.fromHex "000400" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false |> Stdlib.Result.andThen (fun received -> uniReceive received.state 3L (Stdlib.Blob.fromHex "00" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false) = Error "Duplicate HTTP/3 control stream"
uniReceive (Stdlib.__Http3Uni.create true) 3L (Stdlib.Blob.fromHex "02" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false |> Stdlib.Result.andThen (fun received -> uniReceive received.state 7L (Stdlib.Blob.fromHex "02" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false) = Error "Duplicate QPACK encoder stream"
uniReceive (Stdlib.__Http3Uni.create true) 3L (Stdlib.Blob.fromHex "022020" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false |> Stdlib.Result.map (fun received -> received.state.encoderId) = Ok (Some 3L)
uniReceive (Stdlib.__Http3Uni.create true) 3L (Stdlib.Blob.fromHex "0340" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false |> Stdlib.Result.map (fun received -> received.state.outgoing.known) = Ok 0L
uniReceive (Stdlib.__Http3Uni.create true) 3L (Stdlib.Blob.fromHex "0380" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false = Error "Unexpected QPACK section acknowledgment"
uniReceive (Stdlib.__Http3Uni.create true) 3L (Stdlib.Blob.fromHex "0004050140400701" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false |> Stdlib.Result.map (fun received -> (received.state.outgoing.capacity, received.state.outgoing.blocked)) = Ok ((64L, 1L))
uniReceive (Stdlib.__Http3Uni.create true) 3L (Stdlib.Blob.fromHex "01" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false = Error "Unpermitted HTTP/3 push stream"
uniReceive (Stdlib.__Http3Uni.create true) 3L (Stdlib.Blob.fromHex "000400" |> Stdlib.Result.withDefault Stdlib.Blob.empty) true false = Error "Closed critical HTTP/3 stream"
uniReceive (Stdlib.__Http3Uni.create true) 3L (Stdlib.Blob.fromHex "02" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false true = Error "Closed critical HTTP/3 stream"
uniReceive (Stdlib.__Http3Uni.create true) 3L (Stdlib.Blob.fromHex "4021" |> Stdlib.Result.withDefault Stdlib.Blob.empty) true false |> Stdlib.Result.map (fun received -> received.state.streams |> Stdlib.List.length) = Ok 1
uniReceive (Stdlib.__Http3Uni.create true) 3L (Stdlib.Blob.fromHex "40" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false |> Stdlib.Result.andThen (fun received -> uniReceive received.state 3L (Stdlib.Blob.fromHex "000400" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false) |> Stdlib.Result.map (fun received -> received.state.controlId) = Ok (Some 3L)
