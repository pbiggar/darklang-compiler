// tls13_certificate_validation.e2e - TLS certificate framing and RSA SPKI behavior.

(let spki = Stdlib.Blob.fromHex "" in
 match spki with
 | Error _ -> Error "Invalid fixture"
 | Ok bytes -> Stdlib.__RsaSpki.parse bytes
               |> Stdlib.Result.map (fun key -> (Stdlib.Blob.toHex key.modulus, Stdlib.Blob.toHex key.exponent)))
  = Ok (("", "010001"))

(let spki = Stdlib.Blob.fromHex "" in
 match spki with
 | Error _ -> false
 | Ok bytes -> match Stdlib.__RsaSpki.parse bytes with | Error _ -> true | Ok _ -> false)
  = true

(let spki = Stdlib.Blob.fromHex "" in
 match spki with
 | Error _ -> false
 | Ok bytes -> match Stdlib.__RsaSpki.parse bytes with | Error _ -> true | Ok _ -> false)
  = true

(let handshake = Stdlib.Blob.fromHex "0B00000C000000080000033001000000" in
 match handshake with
 | Error _ -> Error "Invalid fixture"
 | Ok bytes ->
   match Stdlib.__Tls13Certificate.parseCertificate bytes with
   | Error error -> Error error
   | Ok certificate ->
     match certificate.entries with
     | [entry] -> Ok ((Stdlib.Blob.toHex entry.der, Stdlib.Blob.toHex entry.extensions))
     | _ -> Error "Unexpected entries")
  = Ok (("300100", ""))

(let handshake = Stdlib.Blob.fromHex "0B00000C000000090000033001000000" in
 match handshake with
 | Error _ -> false
 | Ok bytes -> match Stdlib.__Tls13Certificate.parseCertificate bytes with | Error _ -> true | Ok _ -> false)
  = true

(let handshake = Stdlib.Blob.fromHex "" in
 match handshake with
 | Error _ -> Error "Invalid fixture"
 | Ok bytes -> Stdlib.__Tls13Certificate.parseCertificateVerify bytes
               |> Stdlib.Result.map (fun value -> (value.algorithm, Stdlib.Blob.toHex value.signature)))
  = Ok ((2052L, ""))

(let handshake = Stdlib.Blob.fromHex "" in
 match handshake with
 | Error _ -> false
 | Ok bytes -> match Stdlib.__Tls13Certificate.parseCertificateVerify bytes with | Error _ -> true | Ok _ -> false)
  = true

(let transcript = Stdlib.Blob.fromHex "01000000" in
 match transcript with
 | Error _ -> "bad"
 | Ok bytes -> Stdlib.Blob.toHex (Stdlib.__Tls13Certificate.certificateVerifyInput bytes))
  = "20202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020544C5320312E332C207365727665722043657274696669636174655665726966790067ABDD721024F0FF4E0B3F4C2FC13BC5BAD42D0B7851D456D88D203D15AAA450"

// DER length encodings and BIT STRING padding must be canonical.
(let spki = Stdlib.Blob.fromHex "" in
 match spki with
 | Error _ -> false
 | Ok bytes -> match Stdlib.__RsaSpki.parse bytes with | Error _ -> true | Ok _ -> false)
  = true

(let spki = Stdlib.Blob.fromHex "" in
 match spki with
 | Error _ -> false
 | Ok bytes -> match Stdlib.__RsaSpki.parse bytes with | Error _ -> true | Ok _ -> false)
  = true

(let handshake = Stdlib.Blob.fromHex "0B0000140000001000000330010000000000033001000000" in
 match handshake with
 | Error _ -> 0
 | Ok bytes -> match Stdlib.__Tls13Certificate.parseCertificate bytes with
               | Error _ -> 0
               | Ok certificate -> Stdlib.List.length certificate.entries)
  = 2

(let handshake = Stdlib.Blob.fromHex "0B00000C010000080000033001000000" in
 match handshake with
 | Error _ -> false
 | Ok bytes -> match Stdlib.__Tls13Certificate.parseCertificate bytes with | Error _ -> true | Ok _ -> false)
  = true

(let handshake = Stdlib.Blob.fromHex "" in
 match handshake with
 | Error _ -> false
 | Ok bytes -> match Stdlib.__Tls13Certificate.parseCertificateVerify bytes with | Error _ -> true | Ok _ -> false)
  = true
