// quic_parameters.e2e - Transport-parameter bounds, defaults and handshake-ID authentication.
Stdlib.Blob.fromHex "0F00" |> Stdlib.Result.andThen (Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Client) |> Stdlib.Result.map (fun p -> (p.maxUdpPayload, p.ackDelayExponent, p.maxAckDelay, p.activeConnectionIdLimit, p.maxData)) = Ok ((65527L, 3L, 25L, 2L, 0L))
Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Server Stdlib.Blob.empty = Error "Missing QUIC initial source connection ID"
Stdlib.Blob.fromHex "0F00" |> Stdlib.Result.andThen (Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Server) = Error "Missing QUIC original destination connection ID"
Stdlib.Blob.fromHex "00000F00" |> Stdlib.Result.andThen (Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Client) = Error "Server-only QUIC transport parameter from client"
Stdlib.Blob.fromHex "0F000F00" |> Stdlib.Result.andThen (Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Client) = Error "Duplicate QUIC transport parameter"
Stdlib.Blob.fromHex "0F00406300406300" |> Stdlib.Result.andThen (Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Client) = Error "Duplicate QUIC transport parameter"
Stdlib.Blob.fromHex "0F0040" |> Stdlib.Result.andThen (Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Client) = Error "Truncated QUIC transport parameter"
Stdlib.Blob.fromHex "0F040001" |> Stdlib.Result.andThen (Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Client) = Error "Truncated QUIC transport parameter"
Stdlib.Blob.fromHex "0F000400" |> Stdlib.Result.andThen (Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Client) = Error "Invalid QUIC integer transport parameter"
Stdlib.Blob.fromHex "0F0004020102" |> Stdlib.Result.andThen (Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Client) = Error "Invalid QUIC integer transport parameter"
Stdlib.Blob.fromHex "0F000A0115" |> Stdlib.Result.andThen (Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Client) = Error "QUIC ACK delay exponent exceeds 20"
Stdlib.Blob.fromHex "0F000B0480004000" |> Stdlib.Result.andThen (Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Client) = Error "QUIC maximum ACK delay exceeds limit"
Stdlib.Blob.fromHex "0F000E0101" |> Stdlib.Result.andThen (Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Client) = Error "QUIC active connection ID limit is below 2"
Stdlib.Blob.fromHex "0F00030244AF" |> Stdlib.Result.andThen (Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Client) = Error "QUIC maximum UDP payload is below 1200"
Stdlib.Blob.fromHex "0F000C0100" |> Stdlib.Result.andThen (Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Client) = Error "Invalid QUIC disable active migration parameter"
Stdlib.Blob.fromHex "400F4000400440024000" |> Stdlib.Result.andThen (Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Client) |> Stdlib.Result.map (fun p -> p.maxData) = Ok 0L
Stdlib.Blob.fromHex "00000F00" |> Stdlib.Result.andThen (fun bytes -> Stdlib.__QuicParameters.parseServer bytes (Stdlib.__QuicParameters.ConnectionIds { originalDestination = Stdlib.String.toBlob "x", initialSource = Stdlib.Blob.empty, retrySource = None })) = Error "QUIC original destination connection ID mismatch"
Stdlib.Blob.fromHex "00000F00" |> Stdlib.Result.andThen (fun bytes -> Stdlib.__QuicParameters.parseServer bytes (Stdlib.__QuicParameters.ConnectionIds { originalDestination = Stdlib.Blob.empty, initialSource = Stdlib.String.toBlob "x", retrySource = None })) = Error "QUIC initial source connection ID mismatch"
Stdlib.Blob.fromHex "00000F001000" |> Stdlib.Result.andThen (fun bytes -> Stdlib.__QuicParameters.parseServer bytes (Stdlib.__QuicParameters.ConnectionIds { originalDestination = Stdlib.Blob.empty, initialSource = Stdlib.Blob.empty, retrySource = None })) = Error "Unexpected QUIC Retry source connection ID"
Stdlib.Blob.fromHex "00000F00" |> Stdlib.Result.andThen (fun bytes -> Stdlib.__QuicParameters.parseServer bytes (Stdlib.__QuicParameters.ConnectionIds { originalDestination = Stdlib.Blob.empty, initialSource = Stdlib.Blob.empty, retrySource = Some Stdlib.Blob.empty })) = Error "Missing QUIC Retry source connection ID"
Stdlib.Blob.fromHex "00000F001000" |> Stdlib.Result.andThen (fun bytes -> Stdlib.__QuicParameters.parseServer bytes (Stdlib.__QuicParameters.ConnectionIds { originalDestination = Stdlib.Blob.empty, initialSource = Stdlib.Blob.empty, retrySource = Some (Stdlib.String.toBlob "x") })) = Error "QUIC Retry source connection ID mismatch"
Stdlib.Blob.fromHex "00000F001000" |> Stdlib.Result.andThen (fun bytes -> Stdlib.__QuicParameters.parseServer bytes (Stdlib.__QuicParameters.ConnectionIds { originalDestination = Stdlib.Blob.empty, initialSource = Stdlib.Blob.empty, retrySource = Some Stdlib.Blob.empty })) |> Stdlib.Result.map (fun p -> Stdlib.Blob.length p.initialSource) = Ok 0
Stdlib.Blob.fromHex "0F0161" |> Stdlib.Result.andThen (fun bytes -> Stdlib.__QuicParameters.parseClient bytes (Stdlib.String.toBlob "b")) = Error "QUIC initial source connection ID mismatch"
Stdlib.Blob.fromHex "0F000808D0000000000000000408FFFFFFFFFFFFFFFF" |> Stdlib.Result.andThen (Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Client) |> Stdlib.Result.map (fun p -> (p.maxStreamsBidi, p.maxData)) = Ok ((1152921504606846976L, 4611686018427387903L))
Stdlib.Blob.fromHex "00000F01610D2A7F00000101BB0000000000000000000000000000000120FB01AA00000000000000000000000000000000" |> Stdlib.Result.andThen (Stdlib.__QuicParameters.parse Stdlib.__QuicParameters.Sender.Server) |> Stdlib.Result.map (fun p -> Stdlib.Option.map p.preferredAddress (fun address -> (Stdlib.Blob.toHex address.ipv4, address.ipv4Port, address.ipv6Port, Stdlib.Blob.toHex address.connectionId, Stdlib.Blob.length address.resetToken))) = Ok (Some (("7F000001", 443L, 8443L, "AA", 16)))
