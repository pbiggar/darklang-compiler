// async_list.e2e - Literal list storage retains pending elements without inspection.

type ListedAsyncRecord = { value: Float, text: String }
let sourceListPass (values: List<Int64>) : List<Int64> = values

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let values = [value, 1L] in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in values) = [42L, 1L] // list construction does not demand an element; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let values = [value, 42L] in Stdlib.List.length values) = 2 // list length does not inspect unresolved elements; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<String> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let unused = [value, "ready"] in 42L) = 42L // abandoned list releases pending managed elements; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Float> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let values = [value, 2.0, 3.0] in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 40.25 in values) = [40.25, 2.0, 3.0] // float elements use their pending representation in tree nodes; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let values = sourceListPass [value, 1L] in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in values) = [42L, 1L] // lists cross ordinary calls without forcing elements; leak_check

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let values = [value, 1L, 2L, 3L, 4L, 5L, 6L, 7L] in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in values) = [42L, 1L, 2L, 3L, 4L, 5L, 6L, 7L] // connected digits share one physical element layout; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let values = [[value, 1L], [2L, 3L]] in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in values) = [[42L, 1L], [2L, 3L]] // nested lists promote concrete siblings without an early demand; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let values = [value, 42L] in let inspect = fun _ -> Stdlib.List.length values in inspect ()) = 2 // capturing a list does not inspect pending elements; leak_check
Stdlib.__Task.__runMain (fun _unit -> let fieldGate = Stdlib.__Async.__new<Float> () in let outerGate = Stdlib.__Async.__new<ListedAsyncRecord> () in let field = Stdlib.__Task.__transport (Stdlib.__Async.__pending fieldGate) in let outer = Stdlib.__Task.__transport (Stdlib.__Async.__pending outerGate) in let values = [ListedAsyncRecord { value = field; text = "partial" }, outer] in let _ = Stdlib.__Task.__resolve (__fiber_current ()) fieldGate 40.25 in let _ = Stdlib.__Task.__resolve (__fiber_current ()) outerGate (ListedAsyncRecord { value = 2.0; text = "outer" }) in values) = [ListedAsyncRecord { value = 40.25; text = "partial" }, ListedAsyncRecord { value = 2.0; text = "outer" }] // mixed record elements retain float and managed field ownership; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.isEmpty [value, 42L]) = false // emptiness observes the spine without inspecting elements; leak_check
Stdlib.__Task.__runMain (fun _unit -> let fieldGate = Stdlib.__Async.__new<Int64> () in let outerGate = Stdlib.__Async.__new<List<Int64>> () in let field = Stdlib.__Task.__transport (Stdlib.__Async.__pending fieldGate) in let first = sourceListPass [field, 42L] in let second = sourceListPass (Stdlib.__Task.__transport (Stdlib.__Async.__pending outerGate)) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) outerGate [1L, 2L] in Stdlib.List.length first + Stdlib.List.length second) = 4 // outer-list mapping does not demand unresolved elements; leak_check
