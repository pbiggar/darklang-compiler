Stdlib.DateTime.toMilliseconds (Stdlib.DateTime.__fromUnixTimeTicks (-1L)) = -1
Stdlib.DateTime.subtract (Stdlib.DateTime.__fromUnixTimeTicks 5000000L) (Stdlib.DateTime.__fromUnixTimeTicks 0L) = 0
Stdlib.DateTime.subtract (Stdlib.DateTime.__fromUnixTimeTicks 15000000L) (Stdlib.DateTime.__fromUnixTimeTicks 0L) = 2
Stdlib.DateTime.subtractMs (Stdlib.DateTime.__fromUnixTimeTicks 5000L) (Stdlib.DateTime.__fromUnixTimeTicks 0L) = 0
Stdlib.DateTime.subtractMs (Stdlib.DateTime.__fromUnixTimeTicks 15000L) (Stdlib.DateTime.__fromUnixTimeTicks 0L) = 2
