// async_list_predicates.e2e - Known predicates demand only visited inputs and Boolean decisions.

let predicateListPass (values: List<Int64>) : List<Int64> = values

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.any [value, 2L] (fun ignored -> true)) = true // any leaves ignored pending elements unresolved; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<String> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.all [value, "second"] (fun ignored -> false)) = false // all releases ignored pending managed elements; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Float> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let child = Stdlib.__Task.__startCurrent (fun _ -> let _ = Stdlib.__Task.__yield (__fiber_current ()) in Stdlib.__Task.__resolve (__fiber_current ()) gate 40.25) in Stdlib.List.any [value, 2.0] (fun item -> item > 10.0)) = true // visited input inspection demands a pending float; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Float> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.all [(value, "same"), (2.0, "same")] (fun pair -> let (_, text) = pair in text == "same")) = true // predicates leave unrelated pending tuple fields unresolved; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Bool> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let child = Stdlib.__Task.__startCurrent (fun _ -> let _ = Stdlib.__Task.__yield (__fiber_current ()) in Stdlib.__Task.__resolve (__fiber_current ()) gate true) in Stdlib.List.any [1L, 2L] (fun ignored -> value)) = true // any demands a pending Boolean decision; leak_check
Stdlib.__Task.__runMain (fun _unit -> Stdlib.List.all [1L, 2L] (fun ignored -> Stdlib.__Task.__delayTransparent 0L true)) = true // all waits for each visited delayed decision; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Bool> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.any [1L, 2L] (fun item -> if item == 1L then true else value)) = true // any short circuits before an unresolved later decision; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Bool> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.all [1L, 2L] (fun item -> if item == 1L then false else value)) = false // all short circuits before an unresolved later decision; leak_check
Stdlib.__Task.__runMain (fun _unit -> let started = Stdlib.__Async.__new<Unit> () in let first = Stdlib.__Task.__transport (Stdlib.__Async.__ready 1L) in let found = Stdlib.List.any [first, 2L] (fun item -> if item == 1L then true else let _ = Stdlib.__Task.__resolve (__fiber_current ()) started () in false) in if found then Stdlib.__Async.__isReady started == false else false) = true // any never invokes a later predicate after success; leak_check
Stdlib.__Task.__runMain (fun _unit -> let started = Stdlib.__Async.__new<Unit> () in let first = Stdlib.__Task.__transport (Stdlib.__Async.__ready 1L) in let accepted = Stdlib.List.all [first, 2L] (fun item -> if item == 1L then false else let _ = Stdlib.__Task.__resolve (__fiber_current ()) started () in true) in if accepted then false else Stdlib.__Async.__isReady started == false) = true // all never invokes a later predicate after failure; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Bool> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.any (Stdlib.List.drop [1L] 1) (fun ignored -> value)) = false // empty any never demands its predicate; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Bool> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.all (Stdlib.List.drop [1L] 1) (fun ignored -> value)) = true // empty all never demands its predicate; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let predicate = fun ignored -> true in let first = Stdlib.List.any [1L, 2L] predicate in let second = Stdlib.List.all [value] predicate in first && second) = true // shared predicates reconcile concrete and pending inputs; leak_check
Stdlib.__Task.__runMain (fun _unit -> let fieldGate = Stdlib.__Async.__new<Int64> () in let outerGate = Stdlib.__Async.__new<List<Int64>> () in let field = Stdlib.__Task.__transport (Stdlib.__Async.__pending fieldGate) in let first = predicateListPass [field] in let outer = predicateListPass (Stdlib.__Task.__transport (Stdlib.__Async.__pending outerGate)) in let child = Stdlib.__Task.__startCurrent (fun _ -> let _ = Stdlib.__Task.__yield (__fiber_current ()) in Stdlib.__Task.__resolve (__fiber_current ()) outerGate [1L, 2L]) in Stdlib.List.any outer (fun ignored -> true)) = true // any demands the outer spine without demanding ignored elements; leak_check
