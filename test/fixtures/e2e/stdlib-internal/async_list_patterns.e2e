// async_list_patterns.e2e - List patterns inspect the spine and demanded elements independently.

let patternListCount (values: List<Int64>) : Int = match values with | [] -> 0 | head :: tail -> 1 + Stdlib.List.length tail

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let selected = match [value] with | [selected] -> selected | _ -> 0L in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in selected) = 42L // singleton binding preserves pending element; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in match [value, 2L, 3L] with | head :: tail -> Stdlib.List.length tail | [] -> 0) = 2 // cons binding observes no element; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<String> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in match [value, "second"] with | [_, _] -> 42L | _ -> 0L) = 42L // exact wildcard pattern checks length only; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Float> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let selected = match [value, 2.0, 3.0] with | [selected, _, _] -> selected | _ -> 0.0 in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 40.25 in selected + 1.75) = 42.0 // multi-element float binding preserves its carrier; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in match [value] with | [] -> 0L | _ -> 42L) = 42L // empty pattern inspects only the spine; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let child = Stdlib.__Task.__startCurrent (fun _ -> let _ = Stdlib.__Task.__yield (__fiber_current ()) in Stdlib.__Task.__resolve (__fiber_current ()) gate 42L) in match [value, 2L] with | [42L, 2L] -> 42L | _ -> 0L) = 42L // literal pattern demands the selected element; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<String> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let selected = match [value] with | [selected] -> selected | _ -> "missing" in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate "ready" in selected) = "ready" // selected managed element remains owned; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in match [[value, 2L]] with | [[_, _]] -> 42L | _ -> 0L) = 42L // nested list pattern observes no pending payload; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in match [value, 2L, 3L, 4L] with | first :: second :: rest -> Stdlib.List.length rest + (if second == 2L then 2 else 0) | _ -> 0) = 4 // chained cons bindings retain the pending head; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Float> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in match [(value, "ready")] with | [(_, text)] -> text | _ -> "missing") = "ready" // tuple pattern leaves unrelated pending field unresolved; leak_check
Stdlib.__Task.__runMain (fun _unit -> let fieldGate = Stdlib.__Async.__new<Int64> () in let outerGate = Stdlib.__Async.__new<List<Int64>> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending fieldGate) in let first = patternListCount [value, 2L] in let outer = Stdlib.__Task.__transport (Stdlib.__Async.__pending outerGate) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) outerGate [1L, 2L] in first + patternListCount outer) = 4 // function patterns reconcile outer and element pendingness; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let child = Stdlib.__Task.__startCurrent (fun _ -> let _ = Stdlib.__Task.__yield (__fiber_current ()) in Stdlib.__Task.__resolve (__fiber_current ()) gate 42L) in match [value] with | head :: tail when head == 42L -> Stdlib.List.length tail | _ -> 1) = 0 // guard demands its binding after the spine matches; leak_check
