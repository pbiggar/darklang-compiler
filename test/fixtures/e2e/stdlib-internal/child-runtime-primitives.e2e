Builtin.runtimeChildPoll (-1) = Error 9
Builtin.runtimeChildKill (-1) = Error 9
Builtin.runtimeChildClose (-1) = Error 9
Builtin.runtimeChildDescriptors (-1) = Error 9
(match Builtin.runtimeChildStart "/bin/true" [] true with | Error _ -> false | Ok child -> let ports = Builtin.runtimeChildDescriptors child in let _ = Builtin.runtimeChildClose child in ports == Ok []) = true
(match Builtin.runtimeChildStart "/bin/sh" ["-c", "exit 7"] true with | Error _ -> false | Ok child -> let _ = Stdlib.DateTime.__sleepMilliseconds 100.0 in let result = Builtin.runtimeChildPoll child in let _ = Builtin.runtimeChildClose child in result == Ok (Some 7)) = true
// Capturing large output must not expand every byte into an intermediate list.
let outcome = Stdlib.Cli.execute "head -c 100000 /dev/zero; head -c 100000 /dev/zero >&2" in (Stdlib.String.length outcome.stdout, Stdlib.String.length outcome.stderr) = (100000, 100000)
// Pipe allocation must work even when the launching process has closed stdin.
let _ = Builtin.syscallClose 0 in match Stdlib.Cli.Process.run "/bin/cat" [] with | Ok output -> (output.exitCode, output.stdout, output.stderr) | Error error -> (-1, "", error.message) = (0, "", "") isolated=true
// Writing after the child closes its stdin must report EPIPE, not kill Dark.
let handle = Stdlib.Cli.Process.spawn "exec 0<&-; printf ready; sleep 1" in let _ = Stdlib.DateTime.__sleepMilliseconds 100.0 in let response = Stdlib.Cli.Process.communicate handle "input" in let _ = Stdlib.Cli.Process.terminate handle in response.exitCode = -1 isolated=true
// The test runner may ignore SIGPIPE. Re-exec with its real default disposition.
match Stdlib.Cli.Env.get "DARK_CHILD_PIPE_PROBE" with | Some _ -> let handle = Stdlib.Cli.Process.spawn "exec 0<&-; printf ready; sleep 1" in let _ = Stdlib.DateTime.__sleepMilliseconds 100.0 in let response = Stdlib.Cli.Process.communicate handle "input" in let _ = Stdlib.Cli.Process.terminate handle in response.exitCode == -1 | None -> match Stdlib.Cli.Process.run "/usr/bin/env" ["--default-signal=PIPE", "DARK_CHILD_PIPE_PROBE=1", Builtin.runtimeExecutablePath ()] with | Ok output -> output.exitCode == 0 && (Stdlib.String.trim output.stdout == "true") | Error _ -> false = true isolated=true
