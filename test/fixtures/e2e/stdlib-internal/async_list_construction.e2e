Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let values = Stdlib.List.append [1L] [value, 3L] in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in values) = [1L, 42L, 3L] // append reconciles a pending right-hand element; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<List<Int64>> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.length (Stdlib.List.singleton value)) = 1 // singleton can contain an unresolved list; leak_check
Stdlib.__Task.__runMain (fun _unit -> let elementGate = Stdlib.__Async.__new<Int64> () in let outerGate = Stdlib.__Async.__new<List<Int64>> () in let element = Stdlib.__Task.__transport (Stdlib.__Async.__pending elementGate) in let outer = Stdlib.__Task.__transport (Stdlib.__Async.__pending outerGate) in let child = Stdlib.__Task.__startCurrent (fun _ -> let _ = Stdlib.__Task.__yield (__fiber_current ()) in Stdlib.__Task.__resolve (__fiber_current ()) outerGate [1L, 2L]) in Stdlib.List.length (Stdlib.List.push outer element)) = 3 // push demands an outer spine while retaining an unresolved head; leak_check
