// async_list_construction.e2e - Library list builders preserve pending element interfaces.

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let values = Stdlib.List.singleton value in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in values) = [42L] // singleton does not inspect its payload; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let values = Stdlib.List.push [1L, 2L] value in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in values) = [42L, 1L, 2L] // push promotes concrete siblings without demanding its head; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<String> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let values = Stdlib.List.push [value, "second"] "first" in Stdlib.List.length values) = 3 // push preserves unresolved managed elements; leak_check
