// async_record.e2e - Record fields retain pending values until selected and inspected.

type SourcePendingRecord = { value: Int64, ready: Int64 }
type SourcePendingManaged = { value: String, ready: String }
type SourceOuterRecord = { inner: SourcePendingRecord, ready: Int64 }
type SourceNestedRecord = { pair: (Float * String), ready: Int64 }

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let record = SourcePendingRecord { value = value, ready = 1L } in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in record.value + record.ready) = 43L // record construction does not demand; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let record = SourcePendingRecord { value = value, ready = 42L } in record.ready) = 42L // selecting another record field does not demand; leak_check
Stdlib.__Task.__runMain (fun _unit -> let value = Stdlib.__Task.__delayTransparent 0L ("managed" + " result") in SourcePendingManaged { value = value, ready = "!" }) = SourcePendingManaged { value = "managed result", ready = "!" } // native record result materializes managed fields; leak_check
Stdlib.__Task.__runMain (fun _unit -> let value = Stdlib.__Task.__delayTransparent 0L 40.25 in let pair = (value, "managed" + " result") in SourceNestedRecord { pair = pair, ready = 42L }) = SourceNestedRecord { pair = (40.25, "managed result"), ready = 42L } // record containing a pending tuple materializes recursively; leak_check

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let record = SourcePendingRecord { value = value, ready = 1L } in let alias = record in let updated = { alias with ready = 42L } in updated.ready) = 42L // updating a record leaves the pending field untouched; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let record = SourcePendingRecord { value = value, ready = 1L } in let replaced = { record with value = 42L } in replaced.value + replaced.ready) = 43L // replacing the pending field never demands its old value; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let inner = SourcePendingRecord { value = value, ready = 1L } in let outer = SourceOuterRecord { inner = inner, ready = 42L } in outer.inner.ready + outer.ready) = 43L // nested records retain independent pending fields; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<String> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let unused = SourcePendingManaged { value = value, ready = "!" } in 42L) = 42L // abandoning a record releases its pending managed field; leak_check
