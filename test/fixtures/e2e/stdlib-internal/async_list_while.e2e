// async_list_while.e2e - Prefix predicates stop before visiting unrelated pending values.

let whileListPass (values: List<Int64>) : List<Int64> = values

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Float> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let values = Stdlib.List.dropWhile [value, 2.0] (fun ignored -> false) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 40.25 in values) = [40.25, 2.0] // a rejected first element returns its pending suffix unchanged; leak_check

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.length (Stdlib.List.takeWhile [value, 2L] (fun ignored -> true))) = 2 // taking a prefix does not demand ignored retained elements; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<String> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.dropWhile [value, "second"] (fun ignored -> true)) = [] // dropping a prefix releases ignored pending managed elements; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Float> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let child = Stdlib.__Task.__startCurrent (fun _ -> let _ = Stdlib.__Task.__yield (__fiber_current ()) in Stdlib.__Task.__resolve (__fiber_current ()) gate 40.25) in Stdlib.List.takeWhile [value, 2.0] (fun item -> item > 10.0)) = [40.25] // a visited predicate may inspect a pending float; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<String> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.length (Stdlib.List.dropWhile [("first", 1L), (value, 2L)] (fun pair -> let (_, number) = pair in number == 1L))) = 1 // dropping a prefix preserves unrelated pending nested fields; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Bool> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let child = Stdlib.__Task.__startCurrent (fun _ -> let _ = Stdlib.__Task.__yield (__fiber_current ()) in Stdlib.__Task.__resolve (__fiber_current ()) gate true) in Stdlib.List.takeWhile [1L, 2L] (fun ignored -> value)) = [1L, 2L] // taking demands a pending Boolean decision; leak_check
Stdlib.__Task.__runMain (fun _unit -> Stdlib.List.dropWhile [1L, 2L] (fun ignored -> Stdlib.__Task.__delayTransparent 0L true)) = [] // dropping demands delayed Boolean decisions; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.takeWhile [1L, value] (fun item -> item < 0L)) = [] // taking stops before inspecting a later unresolved element; leak_check
Stdlib.__Task.__runMain (fun _unit -> let started = Stdlib.__Async.__new<Unit> () in let first = Stdlib.__Task.__transport (Stdlib.__Async.__ready 1L) in let values = Stdlib.List.dropWhile [first, 2L] (fun item -> if item == 1L then false else let _ = Stdlib.__Task.__resolve (__fiber_current ()) started () in true) in Stdlib.List.length values == 2 && Stdlib.__Async.__isReady started == false) = true // dropping stops invoking predicates after its first rejection; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Bool> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.takeWhile (Stdlib.List.drop [1L] 1) (fun ignored -> value)) = [] // empty takeWhile never demands its predicate; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Bool> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.dropWhile (Stdlib.List.drop [1L] 1) (fun ignored -> value)) = [] // empty dropWhile never demands its predicate; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let predicate = fun ignored -> true in let first = Stdlib.List.takeWhile [1L, 2L] predicate in let second = Stdlib.List.dropWhile [value] predicate in Stdlib.List.length first + Stdlib.List.length second) = 2 // shared predicates reconcile concrete and pending inputs across prefix operations; leak_check
Stdlib.__Task.__runMain (fun _unit -> let fieldGate = Stdlib.__Async.__new<Int64> () in let outerGate = Stdlib.__Async.__new<List<Int64>> () in let field = Stdlib.__Task.__transport (Stdlib.__Async.__pending fieldGate) in let first = whileListPass [field] in let outer = whileListPass (Stdlib.__Task.__transport (Stdlib.__Async.__pending outerGate)) in let child = Stdlib.__Task.__startCurrent (fun _ -> let _ = Stdlib.__Task.__yield (__fiber_current ()) in Stdlib.__Task.__resolve (__fiber_current ()) outerGate [1L, 2L]) in Stdlib.List.takeWhile outer (fun ignored -> true)) = [1L, 2L] // prefix predicates inspect the outer spine without inspecting ignored elements; leak_check
