// SQLite scalars used by package projections and search.
Stdlib.Sqlite.query "/tmp/dark-sqlite-expressions.db" "SELECT coalesce(NULL,'fallback') AS x" |> Stdlib.Result.map (fun rows -> Stdlib.List.map rows (fun row -> Stdlib.Dict.get row "x")) = Ok [Some (Stdlib.Sqlite.Value.Text "fallback")]
Stdlib.Sqlite.query "/tmp/dark-sqlite-expressions.db" "SELECT length(char(101,769,38634)) AS x" |> Stdlib.Result.map (fun rows -> Stdlib.List.map rows (fun row -> Stdlib.Dict.get row "x")) = Ok [Some (Stdlib.Sqlite.Value.Int 3L)]
Stdlib.Sqlite.query "/tmp/dark-sqlite-expressions.db" "SELECT substr(X'00010203',2,2) AS x" |> Stdlib.Result.map (fun rows -> Stdlib.List.map rows (fun row -> match Stdlib.Dict.get row "x" with | Some (Bytes b) -> Stdlib.Blob.toHex b | _ -> "wrong type")) = Ok ["0102"]
Stdlib.Sqlite.query "/tmp/dark-sqlite-expressions.db" "SELECT 'a' || char(0) || 'b' AS x" |> Stdlib.Result.map (fun rows -> Stdlib.List.map rows (fun row -> Stdlib.Dict.get row "x")) = Ok [Some (Stdlib.Sqlite.Value.Text "a\u0000b")]
Stdlib.Sqlite.query "/tmp/dark-sqlite-expressions.db" "SELECT CASE WHEN 1=2 THEN 'no' WHEN 2=2 THEN 'yes' ELSE 'bad' END AS x" |> Stdlib.Result.map (fun rows -> Stdlib.List.map rows (fun row -> Stdlib.Dict.get row "x")) = Ok [Some (Stdlib.Sqlite.Value.Text "yes")]
Stdlib.Sqlite.query "/tmp/dark-sqlite-expressions.db" "SELECT 'Ab雪' LIKE 'a_%' AS x" |> Stdlib.Result.map (fun rows -> Stdlib.List.map rows (fun row -> Stdlib.Dict.get row "x")) = Ok [Some (Stdlib.Sqlite.Value.Int 1L)]
Stdlib.Sqlite.query "/tmp/dark-sqlite-expressions.db" "SELECT 'Æ' LIKE 'æ' AS x" |> Stdlib.Result.map (fun rows -> Stdlib.List.map rows (fun row -> Stdlib.Dict.get row "x")) = Ok [Some (Stdlib.Sqlite.Value.Int 0L)]
Stdlib.Sqlite.query "/tmp/dark-sqlite-expressions.db" "SELECT json_extract('[\"hash\",9007199254740993,null,true]','$[1]') AS x" |> Stdlib.Result.map (fun rows -> Stdlib.List.map rows (fun row -> Stdlib.Dict.get row "x")) = Ok [Some (Stdlib.Sqlite.Value.Int 9007199254740993L)]
