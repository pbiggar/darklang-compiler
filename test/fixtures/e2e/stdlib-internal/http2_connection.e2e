// http2_connection.e2e - Shared compression, ordered outcomes and isolated flow/reset state.
let wireFrame (kind: Int64) (flags: Int64) (id: Int64) (bytes: Blob) : Blob =
  match Stdlib.__Http2Wire.serialize kind flags id bytes with | Ok bytes -> bytes | Error message -> Builtin.crash message
let response (id: Int64) (body: String) : Blob =
  let head = Stdlib.__Hpack.encode [(":status", "200"), ("content-length", Stdlib.Int64.toString (Stdlib.String.__byteLength body))] |> Stdlib.Result.withDefault Stdlib.Blob.empty in
  Stdlib.Blob.concat [wireFrame 1L 4L id head, wireFrame 0L 1L id (Stdlib.String.toBlob body)]
let request () : Stdlib.__Http2Connection.Request = Stdlib.__Http2Connection.Request { method = "GET", fields = [(":method", "GET"), (":scheme", "https"), (":authority", "example.com"), (":path", "/")], body = Stdlib.Blob.empty }
let multiplex (limit: Int64) (input: Blob) : Stdlib.Result.Result<(List<String> * Int64), String> =
  let bytes = Stdlib.Stream.fromList [input] in
  let lifecycle = Stdlib.Stream.__new (fun _unit -> Some ()) (fun _unit -> Stdlib.Stream.close bytes) in
  let transport = Stdlib.__HttpTransport.Transport { lifecycle = lifecycle, idle = fun _unit -> true, poll = fun _unit -> Ok None, pollWrite = fun bytes -> Ok (Some (Stdlib.Blob.__byteLength bytes)), flush = fun _unit -> Ok true, read = fun _unit -> Ok (Stdlib.Stream.next bytes |> Stdlib.Option.withDefault Stdlib.Blob.empty), write = fun _bytes -> Ok () } in
  let state = Stdlib.__Http2Connection.State { wire = { Stdlib.__Http2.initial 0L with settingsSeen = true, concurrent = limit }, next = 1L } in
  let result = Stdlib.__Http2Connection.requestMany transport state [request (), request ()] |> Stdlib.Result.map (fun batch ->
    (Stdlib.List.map batch.responses (fun outcome -> match outcome.response with | Error _ -> "reset" | Ok response -> Stdlib.Blob.toString response.body |> Stdlib.Result.withDefault "invalid"), batch.state.next)) in
  let _ = Stdlib.__HttpTransport.close transport in result
multiplex 2L (Stdlib.Blob.concat [response 3L "second", response 1L "first"]) = Ok ((["first", "second"], 5L))
multiplex 1L (Stdlib.Blob.concat [response 1L "first", response 3L "second"]) = Ok ((["first", "second"], 5L))
multiplex 2L (Stdlib.Blob.concat [wireFrame 3L 0L 1L (Stdlib.__Http2Wire.__u32 8L), response 3L "second"]) = Ok ((["reset", "second"], 5L))
let goAway () : Stdlib.Result.Result<(List<String> * Int64), String> =
  multiplex 2L (Stdlib.Blob.concat [wireFrame 7L 0L 0L (Stdlib.Blob.concat [Stdlib.__Http2Wire.__u32 1L, Stdlib.__Http2Wire.__u32 0L]), response 1L "first"])
goAway () = Ok ((["first", "reset"], 5L))
Stdlib.__Http2.__settings (Stdlib.__Http2.initial 1L) (Stdlib.Blob.fromHex "000300000002" |> Stdlib.Result.withDefault Stdlib.Blob.empty) 0L |> Stdlib.Result.map (fun state -> state.concurrent) = Ok 2L
let active (id: Int64) : Stdlib.__Http2Connection.Active = Stdlib.__Http2Connection.Active { index = id, id = id, request = { request () with body = Stdlib.String.toBlob "abcdef" }, window = 3L, position = 0L, head = None, informational = 0L, total = 0L, blocks = [] }
let flow () : Stdlib.Result.Result<(List<(Int64 * Int64)> * Int64), String> =
  let owner = Stdlib.Stream.__new (fun _unit -> Some ()) (fun _unit -> ()) in
  let transport = Stdlib.__HttpTransport.Transport { lifecycle = owner, idle = fun _unit -> true, poll = fun _unit -> Ok None, pollWrite = fun bytes -> Ok (Some (Stdlib.Blob.__byteLength bytes)), flush = fun _unit -> Ok true, read = fun _unit -> Error "Unexpected read", write = fun _bytes -> Ok () } in
  let work = Stdlib.__Http2Connection.Work { connection = Stdlib.__Http2Connection.State { wire = { Stdlib.__Http2.initial 0L with settingsSeen = true, sendConnection = 5L }, next = 5L }, waiting = [], active = [active 1L, active 3L], completed = [], total = 0L } in
  let result = Stdlib.__Http2Connection.__sendRound transport work.active (Stdlib.__Http2Connection.Round { work = work, progressed = false }) |> Stdlib.Result.map (fun round -> (Stdlib.List.map round.work.active (fun stream -> (stream.position, stream.window)), round.work.connection.wire.sendConnection)) in
  let _ = Stdlib.__HttpTransport.close transport in result
flow () = Ok (([(3L, 0L), (2L, 1L)], 0L))
let isolated () : Stdlib.Result.Result<List<Int64>, String> =
  let owner = Stdlib.Stream.__new (fun _unit -> Some ()) (fun _unit -> ()) in
  let transport = Stdlib.__HttpTransport.Transport { lifecycle = owner, idle = fun _unit -> true, poll = fun _unit -> Ok None, pollWrite = fun bytes -> Ok (Some (Stdlib.Blob.__byteLength bytes)), flush = fun _unit -> Ok true, read = fun _unit -> Error "Unexpected read", write = fun _bytes -> Ok () } in
  let work = Stdlib.__Http2Connection.Work { connection = Stdlib.__Http2Connection.State { wire = { Stdlib.__Http2.initial 0L with settingsSeen = true }, next = 5L }, waiting = [], active = [active 1L, active 3L], completed = [], total = 0L } in
  let frame = Stdlib.__Http2Wire.Frame { kind = 8L, flags = 0L, streamId = 3L, payload = Stdlib.__Http2Wire.__u32 5L } in
  let result = Stdlib.__Http2Connection.__control transport work frame |> Stdlib.Result.map (fun work -> Stdlib.List.map work.active (fun stream -> stream.window)) in
  let _ = Stdlib.__HttpTransport.close transport in result
isolated () = Ok [3L, 8L]
let partial () : Stdlib.Result.Result<Int64, String> =
  let chunks = Stdlib.Stream.fromList [Stdlib.Blob.__fromInt64List [0L, 0L]] in
  let owner = Stdlib.Stream.__new (fun _unit -> Some ()) (fun _unit -> Stdlib.Stream.close chunks) in
  let transport = Stdlib.__HttpTransport.Transport { lifecycle = owner, idle = fun _unit -> false, poll = fun _unit -> Ok (Stdlib.Stream.next chunks), pollWrite = fun bytes -> Ok (Some (Stdlib.Blob.__byteLength bytes)), flush = fun _unit -> Ok true, read = fun _unit -> Error "Partial poll blocked", write = fun _bytes -> Ok () } in
  let state = Stdlib.__Http2Connection.State { wire = { Stdlib.__Http2.initial 0L with settingsSeen = true }, next = 1L } in
  let result = Stdlib.__Http2Connection.prepare transport state |> Stdlib.Result.map (fun state -> Stdlib.Blob.__byteLength state.wire.pending) in
  let _ = Stdlib.__HttpTransport.close transport in result
partial () = Ok 2L
let pooled (now: Int64) (draining: Bool) : (Bool * Int64) =
  let counter = Stdlib.Stream.__cellNew 0L in
  let owner = Stdlib.Stream.__new (fun _unit -> Some ()) (fun _unit -> Stdlib.Stream.__cellSet counter (Stdlib.Stream.__cellGet<Int64> counter + 1L)) in
  let transport = Stdlib.__HttpTransport.Transport { lifecycle = owner, idle = fun _unit -> true, poll = fun _unit -> Ok None, pollWrite = fun bytes -> Ok (Some (Stdlib.Blob.__byteLength bytes)), flush = fun _unit -> Ok true, read = fun _unit -> Error "Unexpected read", write = fun _bytes -> Ok () } in
  let wire = { Stdlib.__Http2.initial 0L with settingsSeen = true, goAway = if draining then Some 1L else None } in
  let state = Stdlib.__Http2Connection.State { wire = wire, next = 3L } in
  let origin = Stdlib.__HttpWire.Url { scheme = "https", host = "example.com", port = 443L, authority = "example.com", target = "/" } in
  let entry = Stdlib.__Http2Pool.Entry { origin = origin, transport = transport, state = state, idle = 1000L } in
  let pool = Stdlib.__Http2Pool.put Stdlib.__Http2Pool.empty entry 1000L in
  let lease = Stdlib.__Http2Pool.take pool origin now in
  let result = (Stdlib.Option.isSome lease.entry, Stdlib.Stream.__cellGet<Int64> counter) in
  let _ = match lease.entry with | None -> () | Some entry -> Stdlib.__HttpTransport.close entry.transport in
  let _ = Stdlib.__Http2Pool.close lease.state in
  let _ = Stdlib.Stream.__cellDispose<Int64> counter in result
pooled 30999L false = (true, 0L)
pooled 31000L false = (false, 1L)
pooled 1001L true = (false, 1L)
let lateCompression () : Stdlib.Result.Result<(List<String> * Int64), String> =
  let fields = [(":status", "200"), ("x-shared", "shared-dynamic-value")] in
  Stdlib.__Hpack.encodeDynamic (Stdlib.__Hpack.encoder ()) fields |> Stdlib.Result.andThen (fun first ->
    Stdlib.__Hpack.encodeDynamic first.state fields |> Stdlib.Result.andThen (fun second ->
      multiplex 2L (Stdlib.Blob.concat [wireFrame 3L 0L 1L (Stdlib.__Http2Wire.__u32 8L), wireFrame 1L 4L 1L first.bytes,
        wireFrame 1L 4L 3L second.bytes, wireFrame 0L 1L 3L (Stdlib.String.toBlob "second")])))
lateCompression () = Ok ((["reset", "second"], 5L))
