// async_list_drop.e2e - Dropping a prefix preserves independently pending elements and spines.

let dropListPass (values: List<Int64>) : List<Int64> = values

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.drop [value, 2L, 3L] 1) = [2L, 3L] // removed pending elements are never inspected; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.length (Stdlib.List.drop [1L, value, 3L] 1)) = 2 // retained pending elements do not affect the spine; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<String> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.drop [value, "second"] 1) = ["second"] // removing pending managed elements releases their carriers; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Float> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let values = Stdlib.List.drop [1.0, value] 1 in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 40.25 in values) = [40.25] // retained floats keep their physical representation; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<String> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.length (Stdlib.List.drop [("first", 1L), (value, 2L)] 1)) = 1 // retained nested fields remain pending; leak_check
Stdlib.__Task.__runMain (fun _unit -> let fieldGate = Stdlib.__Async.__new<Int64> () in let outerGate = Stdlib.__Async.__new<List<Int64>> () in let field = Stdlib.__Task.__transport (Stdlib.__Async.__pending fieldGate) in let first = dropListPass [field] in let outer = dropListPass (Stdlib.__Task.__transport (Stdlib.__Async.__pending outerGate)) in let dropped = Stdlib.List.drop outer 0 in 42L) = 42L // dropping zero does not inspect an unresolved outer spine; leak_check
Stdlib.__Task.__runMain (fun _unit -> let fieldGate = Stdlib.__Async.__new<Int64> () in let outerGate = Stdlib.__Async.__new<List<Int64>> () in let field = Stdlib.__Task.__transport (Stdlib.__Async.__pending fieldGate) in let first = dropListPass [field] in let outer = dropListPass (Stdlib.__Task.__transport (Stdlib.__Async.__pending outerGate)) in let dropped = Stdlib.List.drop outer 0 in let _ = Stdlib.__Task.__resolve (__fiber_current ()) outerGate [1L, 2L, 3L] in dropped) = [1L, 2L, 3L] // zero drop returns the original pending carrier; leak_check
Stdlib.__Task.__runMain (fun _unit -> let fieldGate = Stdlib.__Async.__new<Int64> () in let outerGate = Stdlib.__Async.__new<List<Int64>> () in let field = Stdlib.__Task.__transport (Stdlib.__Async.__pending fieldGate) in let first = dropListPass [field] in let outer = dropListPass (Stdlib.__Task.__transport (Stdlib.__Async.__pending outerGate)) in let dropped = Stdlib.List.drop outer (-1000000000000000000000000000000) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) outerGate [1L, 2L] in dropped) = [1L, 2L] // arbitrary precision negative counts preserve the original carrier; leak_check
Stdlib.__Task.__runMain (fun _unit -> let fieldGate = Stdlib.__Async.__new<Int64> () in let outerGate = Stdlib.__Async.__new<List<Int64>> () in let field = Stdlib.__Task.__transport (Stdlib.__Async.__pending fieldGate) in let first = dropListPass [field] in let outer = dropListPass (Stdlib.__Task.__transport (Stdlib.__Async.__pending outerGate)) in let child = Stdlib.__Task.__startCurrent (fun _ -> let _ = Stdlib.__Task.__yield (__fiber_current ()) in Stdlib.__Task.__resolve (__fiber_current ()) outerGate [1L, 2L, 3L]) in Stdlib.List.drop outer 1) = [2L, 3L] // a positive count inspects the outer spine; leak_check
Stdlib.__Task.__runMain (fun _unit -> let elementGate = Stdlib.__Async.__new<Int64> () in let countGate = Stdlib.__Async.__new<Int> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending elementGate) in let count = Stdlib.__Task.__transport (Stdlib.__Async.__pending countGate) in let child = Stdlib.__Task.__startCurrent (fun _ -> let _ = Stdlib.__Task.__yield (__fiber_current ()) in Stdlib.__Task.__resolve (__fiber_current ()) countGate 1) in Stdlib.List.length (Stdlib.List.drop [1L, value] count)) = 1 // pending counts are demanded independently of retained elements; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.drop [value, 2L] 1000000000000000000000000000000) = [] // arbitrary precision positive counts remove unresolved elements; leak_check
