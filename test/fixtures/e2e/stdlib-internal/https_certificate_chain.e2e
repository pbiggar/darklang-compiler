// https_certificate_chain.e2e - a local RSA CA and server leaf with SAN localhost.

(let root = Stdlib.Base64.decode ""
 let leaf = Stdlib.Base64.decode ""
 let date = Stdlib.DateTime.parse "2026-10-01T00:00:00Z"
 match (root, leaf, date) with
 | (Ok ca, Ok server, Ok at) ->
   Stdlib.__X509Chain.verifyAt [server] [ca] "localhost" at
   |> Stdlib.Result.map (fun verified -> Stdlib.Blob.length verified.spki > 250)
 | _ -> Error "Invalid fixture")
  = Ok true

(let root = Stdlib.Base64.decode ""
 let leaf = Stdlib.Base64.decode ""
 let date = Stdlib.DateTime.parse "2026-10-01T00:00:00Z"
 match (root, leaf, date) with
 | (Ok ca, Ok server, Ok at) ->
   match Stdlib.__X509Chain.verifyAt [server] [ca] "wrong.example" at with
   | Error _ -> true
   | Ok _ -> false
 | _ -> false)
  = true

