// http3_peer_settings.e2e - Retain SETTINGS and enforce decoded field-section limits.
let controlFeed (state: Stdlib.__Http3Control.State) (bytes: Blob) : Stdlib.Result.Result<Stdlib.__Http3Control.Received, String> =
  Stdlib.__Http3Control.feed state bytes |> Stdlib.Result.mapError (fun error -> error.message)
let uniReceive (state: Stdlib.__Http3Uni.State) (id: Int64) (bytes: Blob) (finished: Bool) (reset: Bool) : Stdlib.Result.Result<Stdlib.__Http3Uni.Received, String> =
  Stdlib.__Http3Uni.receive state id bytes finished reset |> Stdlib.Result.mapError (fun error -> error.message)
controlFeed (Stdlib.__Http3Control.create true) (Stdlib.Blob.fromHex "04020621" |> Stdlib.Result.withDefault Stdlib.Blob.empty) |> Stdlib.Result.map (fun received -> received.state.parameters) = Ok [(6L, 33L)]
Stdlib.__Http3Control.checkFields (Stdlib.__Http3Control.create true) [("x", "value")] = Ok ()
controlFeed (Stdlib.__Http3Control.create true) (Stdlib.Blob.fromHex "04020621" |> Stdlib.Result.withDefault Stdlib.Blob.empty) |> Stdlib.Result.andThen (fun received -> Stdlib.__Http3Control.checkFields received.state [("x", "")]) = Ok ()
controlFeed (Stdlib.__Http3Control.create true) (Stdlib.Blob.fromHex "04020621" |> Stdlib.Result.withDefault Stdlib.Blob.empty) |> Stdlib.Result.andThen (fun received -> Stdlib.__Http3Control.checkFields received.state [("x", "v")]) = Error "Peer HTTP/3 field-section limit exceeded"
controlFeed (Stdlib.__Http3Control.create true) (Stdlib.Blob.fromHex "0403064042" |> Stdlib.Result.withDefault Stdlib.Blob.empty) |> Stdlib.Result.andThen (fun received -> Stdlib.__Http3Control.checkFields received.state [("x", ""), ("x", "")]) = Ok ()
controlFeed (Stdlib.__Http3Control.create true) (Stdlib.Blob.fromHex "0403064041" |> Stdlib.Result.withDefault Stdlib.Blob.empty) |> Stdlib.Result.andThen (fun received -> Stdlib.__Http3Control.checkFields received.state [("x", ""), ("x", "")]) = Error "Peer HTTP/3 field-section limit exceeded"
controlFeed (Stdlib.__Http3Control.create true) (Stdlib.Blob.fromHex "04020600" |> Stdlib.Result.withDefault Stdlib.Blob.empty) |> Stdlib.Result.andThen (fun received -> Stdlib.__Http3Control.checkFields received.state []) = Ok ()
controlFeed (Stdlib.__Http3Control.create true) (Stdlib.Blob.fromHex "04020600" |> Stdlib.Result.withDefault Stdlib.Blob.empty) |> Stdlib.Result.andThen (fun received -> Stdlib.__Http3Control.checkFields received.state [("x", "")]) = Error "Peer HTTP/3 field-section limit exceeded"

// Peer settings use the complete QUIC integer range, not a local resource cap.
Stdlib.__Http3Wire.parseSettings (Stdlib.Blob.fromHex "0780010000" |> Stdlib.Result.withDefault Stdlib.Blob.empty) = Ok [(7L, 65536L)]
Stdlib.__Http3Wire.parseSettings (Stdlib.Blob.fromHex "07ffffffffffffffff" |> Stdlib.Result.withDefault Stdlib.Blob.empty) = Ok [(7L, 4611686018427387903L)]
Stdlib.__QpackEncoder.create 4096L 65536L |> Stdlib.Result.map (fun state -> (state.capacity, state.blocked)) = Ok ((4096L, 65536L))
Stdlib.__QpackEncoder.create 4611686018427387903L 4611686018427387903L |> Stdlib.Result.map (fun state -> (state.capacity, state.blocked)) = Ok ((4096L, 4611686018427387903L))
Stdlib.__QpackEncoder.create 4096L (-1L) |> Stdlib.Result.map (fun state -> state.blocked) = Error "Invalid QPACK encoder settings"
Stdlib.__QpackEncoder.create 4096L 4611686018427387904L |> Stdlib.Result.map (fun state -> state.blocked) = Error "Invalid QPACK encoder settings"
uniReceive (Stdlib.__Http3Uni.create true) 3L (Stdlib.Blob.fromHex "00040c01500007ffffffffffffffff" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false |> Stdlib.Result.map (fun received -> (received.state.outgoing.capacity, received.state.outgoing.blocked)) = Ok ((4096L, 4611686018427387903L))
uniReceive (Stdlib.__Http3Uni.create true) 3L (Stdlib.Blob.fromHex "00040c01500007ff" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false |> Stdlib.Result.andThen (fun first -> uniReceive first.state 3L (Stdlib.Blob.fromHex "ffffffffffffff" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false) |> Stdlib.Result.map (fun received -> (received.state.outgoing.capacity, received.state.outgoing.blocked)) = Ok ((4096L, 4611686018427387903L))
uniReceive (Stdlib.__Http3Uni.create true) 3L (Stdlib.Blob.fromHex "00040e01500007ffffffffffffffff0621" |> Stdlib.Result.withDefault Stdlib.Blob.empty) false false |> Stdlib.Result.andThen (fun received -> Stdlib.__Http3Control.checkFields received.state.control [("x", "v")]) = Error "Peer HTTP/3 field-section limit exceeded"
