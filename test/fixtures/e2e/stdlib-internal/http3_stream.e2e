// http3_stream.e2e - Fragmented varints, streaming payloads, and frame-boundary FIN.
let feed (state: Stdlib.__Http3Stream.State) (data: Blob) : Stdlib.Result.Result<Stdlib.__Http3Stream.Received, String> = Stdlib.__Http3Stream.feed state data |> Stdlib.Result.mapError (fun failure -> failure.message)
let finish (state: Stdlib.__Http3Stream.State) : Stdlib.Result.Result<Unit, String> = Stdlib.__Http3Stream.finish state |> Stdlib.Result.mapError (fun failure -> failure.message)
finish Stdlib.__Http3Stream.empty = Ok ()
feed Stdlib.__Http3Stream.empty (Stdlib.Blob.fromHex "0000" |> Stdlib.Result.withDefault Stdlib.Blob.empty) |> Stdlib.Result.map (fun received -> received.events) = Ok [Begin ((0L, 0L)), End 0L]
feed Stdlib.__Http3Stream.empty (Stdlib.Blob.fromHex "000341" |> Stdlib.Result.withDefault Stdlib.Blob.empty) |> Stdlib.Result.map (fun received -> received.events |> Stdlib.List.length) = Ok 2
feed Stdlib.__Http3Stream.empty (Stdlib.Blob.fromHex "000341" |> Stdlib.Result.withDefault Stdlib.Blob.empty) |> Stdlib.Result.andThen (fun received -> finish received.state) = Error "Truncated HTTP/3 frame payload"
feed Stdlib.__Http3Stream.empty (Stdlib.Blob.fromHex "40" |> Stdlib.Result.withDefault Stdlib.Blob.empty) |> Stdlib.Result.andThen (fun received -> finish received.state) = Error "Truncated HTTP/3 frame header"
feed Stdlib.__Http3Stream.empty (Stdlib.Blob.fromHex "0200" |> Stdlib.Result.withDefault Stdlib.Blob.empty) = Error "Forbidden HTTP/3 frame type"
feed Stdlib.__Http3Stream.empty (Stdlib.Blob.fromHex "000341" |> Stdlib.Result.withDefault Stdlib.Blob.empty) |> Stdlib.Result.andThen (fun received -> feed received.state (Stdlib.Blob.fromHex "42430400" |> Stdlib.Result.withDefault Stdlib.Blob.empty)) |> Stdlib.Result.map (fun received -> (received.state.frames, received.events |> Stdlib.List.length)) = Ok ((2L, 4))
feed Stdlib.__Http3Stream.empty (Stdlib.Blob.fromHex "402140" |> Stdlib.Result.withDefault Stdlib.Blob.empty) |> Stdlib.Result.andThen (fun received -> feed received.state (Stdlib.Blob.fromHex "0141" |> Stdlib.Result.withDefault Stdlib.Blob.empty)) |> Stdlib.Result.andThen (fun received -> finish received.state) = Ok ()
feed Stdlib.__Http3Stream.empty (Stdlib.Blob.fromHex "4021FFFFFFFFFFFFFFFF41" |> Stdlib.Result.withDefault Stdlib.Blob.empty) |> Stdlib.Result.map (fun received -> received.state.cursor) = Ok (Payload ((33L, 4611686018427387902L)))
