// async_list_fold.e2e - Known folds transport accumulator and element layouts between steps.

type FoldAsyncRecord = { value: Float, text: String }

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.fold [value, 2L] 0L (fun count ignored -> count + 1L)) = 2L // fold ignores unresolved elements; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let initial = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.fold [1L, 42L] initial (fun ignored item -> item)) = 42L // ignored pending accumulator can be replaced by a ready step; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let folded = Stdlib.List.fold [1L, 2L] 0L (fun ignored item -> value) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in folded) = 42L // fold does not demand a pending step result before the next step; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Float> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let child = Stdlib.__Task.__startCurrent (fun _ -> let _ = Stdlib.__Task.__yield (__fiber_current ()) in Stdlib.__Task.__resolve (__fiber_current ()) gate 40.25) in Stdlib.List.fold [value, 1.75] 0.0 (fun total item -> total + item)) = 42.0 // fold arithmetic demands only inspected inputs; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Float> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let folded = Stdlib.List.fold [1L, 2L] (FoldAsyncRecord { value = 0.0; text = "initial" }) (fun ignored item -> FoldAsyncRecord { value = value; text = "step" }) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 40.25 in folded) = FoldAsyncRecord { value = 40.25; text = "step" } // accumulator records retain independently pending fields; leak_check
