// async_list_fold.e2e - Known folds transport accumulator and element layouts between steps.

type FoldAsyncRecord = { value: Float, text: String }
let foldCountOne (value: Int64) : Int64 = Stdlib.List.fold [value] 0L (fun count ignored -> count + 1L)

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.fold [value, 2L] 0L (fun count ignored -> count + 1L)) = 2L // fold ignores unresolved elements; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let initial = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.fold [1L, 42L] initial (fun ignored item -> item)) = 42L // ignored pending accumulator can be replaced by a ready step; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let folded = Stdlib.List.fold [1L, 2L] 0L (fun ignored item -> value) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in folded) = 42L // fold does not demand a pending step result before the next step; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Float> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let child = Stdlib.__Task.__startCurrent (fun _ -> let _ = Stdlib.__Task.__yield (__fiber_current ()) in Stdlib.__Task.__resolve (__fiber_current ()) gate 40.25) in Stdlib.List.fold [value, 1.75] 0.0 (fun total item -> total + item)) = 42.0 // fold arithmetic demands only inspected inputs; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Float> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let folded = Stdlib.List.fold [1L, 2L] (FoldAsyncRecord { value = 0.0, text = "initial" }) (fun ignored item -> FoldAsyncRecord { value = value, text = "step" }) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 40.25 in folded) = FoldAsyncRecord { value = 40.25, text = "step" } // accumulator records retain independently pending fields; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let initial = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let folded = Stdlib.List.fold [] initial (fun total item -> total + item) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in folded) = 42L // empty fold returns its pending initial value without inspecting it; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let started = Stdlib.__Async.__new<Unit> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let folded = Stdlib.List.fold [1L, 2L] 0L (fun ignored item -> let _ = if item == 2L then Stdlib.__Task.__resolve (__fiber_current ()) started () else () in value) in let allStarted = Stdlib.__Async.__isReady started in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in if allStarted then folded else 0L) = 42L // fold invokes every step eagerly without demanding intermediate accumulators; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<String> () in let initial = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.fold ["first", "second"] initial (fun ignored item -> item)) = "second" // replaced pending managed accumulators are released; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let initial = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let step = fun ignored item -> item in let first = Stdlib.List.fold [1L] 0L step in let second = Stdlib.List.fold [42L] initial step in first + second) = 43L // shared steps reconcile ready and pending accumulator interfaces; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in foldCountOne value) = 1L // preamble folds preserve source values when later called with pending parameters; leak_check
Stdlib.__Task.__runMain (fun _unit -> let initialGate = Stdlib.__Async.__new<Float> () in let elementGate = Stdlib.__Async.__new<Float> () in let initial = Stdlib.__Task.__transport (Stdlib.__Async.__pending initialGate) in let element = Stdlib.__Task.__transport (Stdlib.__Async.__pending elementGate) in let child = Stdlib.__Task.__startCurrent (fun _ -> let _ = Stdlib.__Task.__yield (__fiber_current ()) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) initialGate 40.25 in Stdlib.__Task.__resolve (__fiber_current ()) elementGate 1.75) in Stdlib.List.fold [element] initial (fun total item -> total + item)) = 42.0 // floating point accumulator and element demands remain independent; leak_check
