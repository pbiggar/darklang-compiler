// async_list_spines.e2e - Spine transformations preserve independent element readiness.

let spineListPass (values: List<Int64>) : List<Int64> = values

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.length (Stdlib.List.dropLast [value, 2L, 3L])) = 2 // dropping the last element does not demand retained elements; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.dropLast [value]) = [] // removing an unresolved singleton never demands its element; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<String> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.dropLast ["first", value]) = ["first"] // removed pending managed elements are released; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Float> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let values = Stdlib.List.dropLast [value, 2.0] in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 40.25 in values) = [40.25] // retained floats are demanded only by the native result boundary; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<String> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.length (Stdlib.List.dropLast [(value, 1L), ("second", 2L)])) = 1 // spine transforms preserve pending nested fields; leak_check
Stdlib.__Task.__runMain (fun _unit -> let fieldGate = Stdlib.__Async.__new<Int64> () in let outerGate = Stdlib.__Async.__new<List<Int64>> () in let field = Stdlib.__Task.__transport (Stdlib.__Async.__pending fieldGate) in let first = spineListPass [field] in let outer = spineListPass (Stdlib.__Task.__transport (Stdlib.__Async.__pending outerGate)) in let child = Stdlib.__Task.__startCurrent (fun _ -> let _ = Stdlib.__Task.__yield (__fiber_current ()) in Stdlib.__Task.__resolve (__fiber_current ()) outerGate [1L, 2L, 3L]) in Stdlib.List.length (Stdlib.List.dropLast outer)) = 2 // dropping the last element inspects an outer pending spine without demanding unrelated elements; leak_check
