// quic_tls_hello.e2e - QUIC TLS emits raw handshake messages, not TLS records.
let random = Stdlib.String.toBlob (Stdlib.String.repeat "r" 32) in let share = Stdlib.String.toBlob (Stdlib.String.repeat "k" 32) in Stdlib.__Tls13.quicClientHello "example.com" random share Stdlib.Blob.empty = Error "QUIC transport parameters must have 1..4096 bytes"
let random = Stdlib.String.toBlob (Stdlib.String.repeat "r" 32) in let share = Stdlib.String.toBlob (Stdlib.String.repeat "k" 32) in Stdlib.Blob.fromHex "0F00" |> Stdlib.Result.andThen (Stdlib.__Tls13.quicClientHello "example.com" random share) |> Stdlib.Result.map (fun hello -> Stdlib.Blob.toHex (Stdlib.Blob.slice hello 0 1)) = Ok "01"
let random = Stdlib.String.toBlob (Stdlib.String.repeat "r" 32) in let share = Stdlib.String.toBlob (Stdlib.String.repeat "k" 32) in Stdlib.__Tls13.quicClientHello "example.com" random share (Stdlib.String.toBlob (Stdlib.String.repeat "p" 4097)) = Error "QUIC transport parameters must have 1..4096 bytes"
