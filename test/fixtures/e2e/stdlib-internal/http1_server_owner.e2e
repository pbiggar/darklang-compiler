// http1_server_owner.e2e - Persistent response framing and per-owner parser transitions.
let prepared (input: String) (response: Stdlib.Http.Response) (count: Int64) : (String * String * Int64) =
  let life = Stdlib.Stream.__new (fun _unit -> Some ()) (fun _unit -> ()) in
  let connection = Stdlib.__Network.TcpConnection { lifecycle = life, watch = None, read = fun _length -> Builtin.crash "Prepare attempted read", write = fun _bytes -> Builtin.crash "Prepare attempted write" } in
  let config = { Stdlib.HttpServer.Config.defaults 80 with injectStandardHeaders = false, logRequests = false } in
  let context = Stdlib.__Http1Server.Context { config = config, handler = fun _request -> response, signals = Stdlib.__Network.ShutdownSignals { lifecycle = life }, limit = 16L } in
  let buffer = Stdlib.__Http1Server.RequestBuffer { bytes = Stdlib.String.toBlob input, continued = false } in
  let owner = Stdlib.__Http1Server.Owner { connection = connection, phase = Stdlib.__Http1Server.Phase.Request buffer, started = 0L, deadline = 10000L, requests = count } in
  let next = Stdlib.__Http1Server.prepare context owner 1L buffer in
  let result = match next.phase with
    | Output output ->
      let after = match output.after with | Close -> "closed" | Request bytes -> Stdlib.Blob.toString bytes |> Stdlib.Result.withDefault "invalid" | Continue _ -> "continue" in
      (Stdlib.Blob.toString output.bytes |> Stdlib.Result.withDefault "invalid", after, next.requests)
    | AwaitRequest _ -> ("pending", "pending", next.requests)
    | _ -> ("unexpected", "unexpected", next.requests) in
  let _ = Stdlib.__Network.closeTcp connection in result
let response () : Stdlib.Http.Response = Stdlib.Http.responseWithText "x" 200
prepared "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n" (response ()) 0L = ("HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 1\r\n\r\nx", "", 1L) // leak_check
prepared "HEAD / HTTP/1.1\r\nHost: example.com\r\n\r\n" (response ()) 0L = ("HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 1\r\n\r\n", "", 1L) // leak_check
prepared "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: keep-alive, ClOsE\r\n\r\n" (response ()) 0L |> fun (_wire, after, count) -> (after, count) = ("closed", 1L) // leak_check
prepared "GET / HTTP/1.0\r\nHost: example.com\r\n\r\n" (response ()) 0L |> fun (_wire, after, count) -> (after, count) = ("closed", 1L) // leak_check
prepared "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n" { response () with headers = [("Connection", "close")] } 0L |> fun (_wire, after, count) -> (after, count) = ("closed", 1L) // leak_check
prepared "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n" (response ()) 99L |> fun (_wire, after, count) -> (after, count) = ("closed", 100L) // leak_check
prepared "GET /one HTTP/1.1\r\nHost: example.com\r\n\r\nGET /two HTTP/1.1\r\nHost: example.com\r\n\r\n" (response ()) 0L |> fun (_wire, after, count) -> (after, count) = ("GET /two HTTP/1.1\r\nHost: example.com\r\n\r\n", 1L) // leak_check
prepared "POST / HTTP/1.1\r\nHost: example.com\r\nContent-Length: 4\r\n\r\nab" (response ()) 0L = ("pending", "pending", 0L) // leak_check
prepared "POST / HTTP/1.1\r\nHost: example.com\r\nContent-Length: 4\r\nExpect: 100-continue\r\n\r\n" (response ()) 0L = ("HTTP/1.1 100 Continue\r\n\r\n", "continue", 0L) // leak_check
prepared "HEAD / HTTP/1.1\r\nHost: example.com\r\nContent-Length: 17\r\n\r\n" (response ()) 0L |> fun (wire, after, _count) -> (Stdlib.String.endsWith wire "\r\n\r\n", after) = (true, "closed") // leak_check
