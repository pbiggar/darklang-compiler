// Server stream windows are independent; connection credit and compression are shared.
let stream (id: Int64) (window: Int64) : Stdlib.__Http2Server.Active =
  Stdlib.__Http2Server.Active { id = id, window = window, receiveWindow = 65535L, ended = true, deadline = 0L,
    message = Stdlib.__Http2Server.Message.Responding (Stdlib.__Http2Server.Reply { method = "GET", fields = [], body = Stdlib.String.toBlob "abcdef", position = 0L, headers = true }) }
let state () : Stdlib.__Http2Server.State =
  let initial = Stdlib.__Http2Server.initial Stdlib.Blob.empty in
  { initial with streams = [stream 1L 10L, stream 3L 20L], last = 3L, opened = 2L, total = 12L }
let summary (result: Stdlib.Result.Result<Stdlib.__Http2Server.State, Stdlib.__Http2Server.Failure>) : Stdlib.Result.Result<(Int64 * List<Int64>), Stdlib.__Http2Server.Failure> =
  result |> Stdlib.Result.map (fun state -> (state.wire.sendConnection, Stdlib.List.map state.streams (fun stream -> stream.window)))
let failure (result: Stdlib.Result.Result<Stdlib.__Http2Server.State, Stdlib.__Http2Server.Failure>) : (Int64 * Int64) =
  match result with
  | Ok _ -> (-1L, -1L)
  | Error error -> let id = match error.scope with | Connection -> 0L | Stream id -> id in (id, error.code)
summary (Stdlib.__Http2Server.windowUpdate (state ()) 1L 5L) = Ok ((65535L, [15L, 20L])) // leak_check
summary (Stdlib.__Http2Server.windowUpdate (state ()) 0L 100L) = Ok ((65635L, [10L, 20L])) // leak_check
failure (Stdlib.__Http2Server.windowUpdate (state ()) 1L 2147483647L) = (1L, 3L) // leak_check
failure (Stdlib.__Http2Server.windowUpdate (state ()) 0L 2147483647L) = (0L, 3L) // leak_check
failure (Stdlib.__Http2Server.windowUpdate (state ()) 1L 0L) = (1L, 1L) // leak_check
failure (Stdlib.__Http2Server.windowUpdate (state ()) 0L 0L) = (0L, 1L) // leak_check
failure (Stdlib.__Http2Server.windowUpdate (state ()) 5L 1L) = (0L, 1L) // leak_check
summary (Stdlib.__Http2Server.reset (state ()) 1L |> Stdlib.Result.andThen (fun state -> Stdlib.__Http2Server.windowUpdate state 1L 5L)) = Ok ((65535L, [20L])) // leak_check
failure (Stdlib.__Http2Server.reset (state ()) 1L |> Stdlib.Result.andThen (fun state -> Stdlib.__Http2Server.windowUpdate state 1L 0L)) = (1L, 1L) // leak_check
let setting (value: Int64) : Blob = Stdlib.Blob.concat [Stdlib.Blob.__fromInt64List [0L, 4L], Stdlib.__Http2Wire.__u32 value]
summary (Stdlib.__Http2Server.applySettings (state ()) (setting 0L)) = Ok ((65535L, [-65525L, -65515L])) // leak_check
summary (Stdlib.__Http2Server.applySettings (state ()) (Stdlib.Blob.concat [setting 0L, setting 65535L])) = Ok ((65535L, [10L, 20L])) // leak_check
failure (Stdlib.__Http2Server.applySettings (state ()) (setting 2147483648L)) = (0L, 3L) // leak_check
failure (Stdlib.__Http2Server.applySettings (state ()) (Stdlib.Blob.__fromInt64List [0L, 4L])) = (0L, 6L) // leak_check
let scheduled () : Stdlib.Result.Result<(Int64 * List<Int64> * Int64 * String), Stdlib.__Http2Server.Failure> =
  let initial = state () in
  let initial = { initial with streams = [stream 1L 3L, stream 3L 4L], wire = { initial.wire with sendConnection = 5L } } in
  Stdlib.__Http2Server.scheduleData initial 1L |> Stdlib.Result.andThen (fun first ->
    let length = match first.current with | None -> -1L | Some output -> Stdlib.Blob.__byteLength output.bytes in
    Stdlib.__Http2Server.scheduleData { first with current = None } 3L |> Stdlib.Result.map (fun next ->
      let payload = match next.current with | None -> "missing" | Some output -> Stdlib.Result.withDefault (Stdlib.Blob.toString (Stdlib.__Http2Wire.__slice output.bytes 9L 2L)) "invalid" in
      (next.wire.sendConnection, Stdlib.List.map next.streams (fun stream -> stream.window), length, payload)))
scheduled () = Ok ((0L, [0L, 2L], 12L, "ab")) // leak_check
Stdlib.__Http2Server.reset (state ()) 1L |> Stdlib.Result.map (fun state -> (Stdlib.List.map state.streams (fun stream -> stream.id), state.total)) = Ok (([3L], 6L)) // leak_check
failure (Stdlib.__Http2Server.reset (state ()) 5L) = (0L, 1L) // leak_check

let outputProgress (size: Int64) : Stdlib.Result.Result<(Int64 * Int64 * Int64), Stdlib.__Http2Server.Failure> =
  Stdlib.__Http2Server.scheduleData (state ()) 1L |> Stdlib.Result.andThen (fun scheduled ->
    Stdlib.__Http2Server.pollOutput scheduled (fun _bytes -> if size < 0L then Ok None else Ok (Some size)) (fun _unit -> Builtin.crash "Flush before plaintext accepted") |> Stdlib.Result.map (fun next ->
      let offset = match next.current with | None -> -1L | Some output -> output.offset in
      let position = match Stdlib.__Http2Server.__find next 1L with | None -> -1L | Some stream -> match stream.message with | Receiving _ -> -1L | Responding reply -> reply.position in
      (offset, next.wire.sendConnection, position)))
outputProgress -1L = Ok ((0L, 65529L, 6L)) // leak_check
outputProgress 3L = Ok ((3L, 65529L, 6L)) // leak_check
failure (Stdlib.__Http2Server.scheduleData (state ()) 1L |> Stdlib.Result.andThen (fun state -> Stdlib.__Http2Server.pollOutput state (fun _bytes -> Ok (Some 0L)) (fun _unit -> Ok true))) = (0L, 2L) // leak_check

let flushed (done: Bool) : Stdlib.Result.Result<(Bool * List<Int64> * Int64), Stdlib.__Http2Server.Failure> =
  Stdlib.__Http2Server.scheduleData (state ()) 1L |> Stdlib.Result.andThen (fun scheduled ->
    Stdlib.__Http2Server.pollOutput scheduled (fun bytes -> Ok (Some (Stdlib.Blob.__byteLength bytes))) (fun _unit -> Builtin.crash "Premature flush") |> Stdlib.Result.andThen (fun accepted ->
      Stdlib.__Http2Server.pollOutput accepted (fun _bytes -> Builtin.crash "Replayed accepted frame") (fun _unit -> Ok done) |> Stdlib.Result.map (fun next ->
        (Stdlib.Option.isSome next.current, Stdlib.List.map next.streams (fun stream -> stream.id), next.total))))
flushed false = Ok ((true, [1L, 3L], 12L)) // leak_check
flushed true = Ok ((false, [3L], 6L)) // leak_check

let sharedHeaders () : Stdlib.Result.Result<Bool, Stdlib.__Http2Server.Failure> =
  let initial = state () in
  let fields = [(":status", "200"), ("x-shared", "shared-server-value")] in
  let streams = Stdlib.List.map initial.streams (fun stream -> { stream with message = Stdlib.__Http2Server.Message.Responding (Stdlib.__Http2Server.Reply { method = "GET", fields = fields, body = Stdlib.Blob.empty, position = 0L, headers = false }) }) in
  let initial = { initial with streams = streams, total = 0L } in
  Stdlib.__Http2Server.scheduleHeaders initial 1L |> Stdlib.Result.andThen (fun first ->
    let firstLength = match first.current with | None -> -1L | Some output -> Stdlib.Blob.__byteLength output.bytes in
    Stdlib.__Http2Server.pollOutput first (fun bytes -> Ok (Some (Stdlib.Blob.__byteLength bytes))) (fun _unit -> Ok true) |> Stdlib.Result.andThen (fun accepted ->
      Stdlib.__Http2Server.pollOutput accepted (fun _bytes -> Builtin.crash "Replayed headers") (fun _unit -> Ok true) |> Stdlib.Result.andThen (fun flushed ->
        Stdlib.__Http2Server.scheduleHeaders flushed 3L |> Stdlib.Result.map (fun second ->
          let secondLength = match second.current with | None -> -1L | Some output -> Stdlib.Blob.__byteLength output.bytes in
          firstLength > secondLength && secondLength > 9L))))
sharedHeaders () = Ok true // leak_check
let selected (window: Int64) : Stdlib.Result.Result<(Int64 * List<Int64>), Stdlib.__Http2Server.Failure> =
  let initial = state () in
  Stdlib.__Http2Server.schedule { initial with streams = [stream 1L window, stream 3L 20L] } |> Stdlib.Result.map (fun next ->
    let id = match next.current with | None -> -1L | Some output -> output.stream in
    (id, Stdlib.List.map next.streams (fun stream -> stream.id)))
selected 0L = Ok ((3L, [1L, 3L])) // leak_check
selected 10L = Ok ((1L, [3L, 1L])) // leak_check
