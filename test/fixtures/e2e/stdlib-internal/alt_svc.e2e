// alt_svc.e2e - Alternative-service grammar, origin-relative authority, preference and lifetime bounds.
Stdlib.__AltSvc.parse "example.com" "clear" = Ok Clear
Stdlib.__AltSvc.parse "example.com" " h3=\":443\", clear " = Ok Clear
Stdlib.__AltSvc.parse "example.com" "h3=\":443\"" |> Stdlib.Result.map (fun ad -> match ad with | Clear -> [] | Services entries -> Stdlib.List.map entries (fun entry -> (entry.service.host, entry.service.port, entry.lifetime))) = Ok [("example.com", 443L, 86400L)]
Stdlib.__AltSvc.parse "example.com" "h3=\"alt.example.com:8443\"; ma=60" |> Stdlib.Result.map (fun ad -> match ad with | Clear -> [] | Services entries -> Stdlib.List.map entries (fun entry -> (entry.service.host, entry.service.port, entry.lifetime))) = Ok [("alt.example.com", 8443L, 60L)]
Stdlib.__AltSvc.parse "example.com" "h2=\":443\", h3=\":8443\"; ma=\"30\", h3=\":443\"; ma=5" |> Stdlib.Result.map (fun ad -> match ad with | Clear -> [] | Services entries -> Stdlib.List.map entries (fun entry -> (entry.service.port, entry.lifetime))) = Ok [(8443L, 30L), (443L, 5L)]
Stdlib.__AltSvc.parse "2001:db8::1" "h3=\":443\"" |> Stdlib.Result.map (fun ad -> match ad with | Clear -> [] | Services entries -> Stdlib.List.map entries (fun entry -> entry.service.host)) = Ok ["2001:db8::1"]
Stdlib.__AltSvc.parse "example.com" "h3=\"[2001:db8::1]:443\"" |> Stdlib.Result.map (fun ad -> match ad with | Clear -> [] | Services entries -> Stdlib.List.map entries (fun entry -> entry.service.host)) = Ok ["2001:db8::1"]
Stdlib.__AltSvc.parse "example.com" "h3=\":443\"; ma=0" = Ok (Services [])
Stdlib.__AltSvc.parse "example.com" "h2=\":443\", h3-29=\":443\"" = Ok (Services [])
Stdlib.__AltSvc.parse "example.com" "h3=\":443\"; ma=999999999999999999999999" |> Stdlib.Result.map (fun ad -> match ad with | Clear -> [] | Services entries -> Stdlib.List.map entries (fun entry -> entry.lifetime)) = Ok [86400L]
Stdlib.__AltSvc.parse "example.com" "h3=\":443\"; unknown=\"semi;colon,comma\"; persist=7" |> Stdlib.Result.map (fun ad -> match ad with | Clear -> [] | Services entries -> Stdlib.List.map entries (fun entry -> entry.service.port)) = Ok [443L]
Stdlib.__AltSvc.parse "example.com" "h3=\":4\\43\"; ma=\"6\\0\"" |> Stdlib.Result.map (fun ad -> match ad with | Clear -> [] | Services entries -> Stdlib.List.map entries (fun entry -> (entry.service.port, entry.lifetime))) = Ok [(443L, 60L)]
Stdlib.__AltSvc.parse "example.com" "h3=:443" = Error "Alt-Svc authority must be quoted"
Stdlib.__AltSvc.parse "example.com" "h3=\":0\"" = Error "Invalid URL port"
Stdlib.__AltSvc.parse "example.com" "h3=\"alt.example.com\"" = Error "Invalid Alt-Svc authority"
Stdlib.__AltSvc.parse "example.com" "h3=\":443\"; ma=-1" = Error "Invalid Alt-Svc max-age"
Stdlib.__AltSvc.parse "example.com" "h3=\":443\"; ma=60; ma=30" = Error "Duplicate Alt-Svc max-age"
Stdlib.__AltSvc.parse "example.com" "h3=\":443\"; unknown" = Error "Missing Alt-Svc parameter value"
Stdlib.__AltSvc.parse "example.com" "h3=\":443\"," = Error "Trailing Alt-Svc separator"
Stdlib.__AltSvc.parse "example.com" "h3=\":443" = Error "Unterminated Alt-Svc quoted string"
