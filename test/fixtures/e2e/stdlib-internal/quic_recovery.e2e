// quic_recovery.e2e - Observable packet loss, PTO, ACK validation and congestion accounting.
Stdlib.__QuicRecovery.create 1200L |> Stdlib.Result.map (fun state -> (state.congestion.window, state.congestion.inFlight, state.largestSent)) = Ok ((12000L, 0L, -1L))
Stdlib.__QuicRecovery.create 1200L |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicRecovery.pto state 25L) = Ok 1000L
Stdlib.__QuicRecovery.create 1200L |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicRecovery.sent state (Stdlib.__QuicRecovery.Packet { number = 0L, at = 0L, size = 1200L, token = 0L, payload = Stdlib.String.toBlob "data" }) true false) |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicRecovery.timeout state 999L 0L) |> Stdlib.Result.map (fun update -> (update.probe, Stdlib.List.length update.retransmit, update.state.congestion.inFlight)) = Ok ((false, 0, 1200L))
Stdlib.__QuicRecovery.create 1200L |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicRecovery.sent state (Stdlib.__QuicRecovery.Packet { number = 0L, at = 0L, size = 1200L, token = 0L, payload = Stdlib.String.toBlob "data" }) true false) |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicRecovery.timeout state 1000L 0L) |> Stdlib.Result.map (fun update -> (update.probe, Stdlib.List.length update.retransmit, update.state.ptoCount, update.state.congestion.inFlight)) = Ok ((true, 1, 1L, 1200L))
Stdlib.__QuicRecovery.create 1200L |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicRecovery.sent state (Stdlib.__QuicRecovery.Packet { number = 1L, at = 0L, size = 1200L, token = 0L, payload = Stdlib.Blob.empty }) true false) = Error "QUIC sent packet number is not sequential"
Stdlib.__QuicRecovery.create 1200L |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicRecovery.sent state (Stdlib.__QuicRecovery.Packet { number = 0L, at = 0L, size = 1200L, token = 0L, payload = Stdlib.String.toBlob "data" }) true false) |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicRecovery.acknowledge state (Stdlib.__QuicFrames.Ack { delay = 0L, ecn = None, ranges = [Stdlib.__QuicFrames.Range { smallest = 0L, largest = 1L }] }) 10L 0L 25L) = Error "QUIC ACK acknowledges unsent or invalid packets"
Stdlib.__QuicRecovery.create 1200L |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicRecovery.sent state (Stdlib.__QuicRecovery.Packet { number = 0L, at = 0L, size = 1200L, token = 0L, payload = Stdlib.String.toBlob "data" }) true false) |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicRecovery.acknowledge state (Stdlib.__QuicFrames.Ack { delay = 0L, ecn = None, ranges = [Stdlib.__QuicFrames.Range { smallest = 0L, largest = 0L }] }) 100L 0L 25L) |> Stdlib.Result.map (fun update -> (update.state.rtt.latest, update.state.rtt.smoothed, update.state.rtt.variance, update.state.congestion.window, update.state.congestion.inFlight)) = Ok ((100L, 100L, 50L, 13200L, 0L))
Stdlib.__QuicRecovery.create 1200L |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicRecovery.sent state (Stdlib.__QuicRecovery.Packet { number = 0L, at = 0L, size = 1200L, token = 0L, payload = Stdlib.Blob.empty }) true false) |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicRecovery.acknowledge state (Stdlib.__QuicFrames.Ack { delay = 0L, ecn = None, ranges = [Stdlib.__QuicFrames.Range { smallest = 0L, largest = 0L }] }) 4611686018427387903L 0L 25L) |> Stdlib.Result.andThen (fun update -> Stdlib.__QuicRecovery.pto update.state 25L) = Ok 60000L
Stdlib.__QuicRecovery.create 1200L |> Stdlib.Result.andThen (fun state -> Stdlib.List.fold [0L,1L,2L,3L,4L,5L,6L,7L,8L,9L] (Ok state) (fun result number -> result |> Stdlib.Result.andThen (fun current -> Stdlib.__QuicRecovery.sent current (Stdlib.__QuicRecovery.Packet { number = number, at = number, size = 1200L, token = number, payload = Stdlib.Blob.empty }) true false))) |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicRecovery.sent state (Stdlib.__QuicRecovery.Packet { number = 10L, at = 10L, size = 1200L, token = 10L, payload = Stdlib.Blob.empty }) true false) = Error "QUIC congestion window is full"
Stdlib.__QuicRecovery.create 1200L |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicRecovery.pto state -1L) = Error "Invalid QUIC ACK delay bound"
Stdlib.__QuicRecovery.create 1200L |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicRecovery.sent state (Stdlib.__QuicRecovery.Packet { number = 0L, at = 0L, size = 1200L, token = 77L, payload = Stdlib.String.toBlob "data" }) true false) |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicRecovery.sent state (Stdlib.__QuicRecovery.Packet { number = 1L, at = 1000L, size = 1200L, token = 77L, payload = Stdlib.String.toBlob "data" }) true true) |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicRecovery.acknowledge state (Stdlib.__QuicFrames.Ack { delay = 0L, ecn = None, ranges = [Stdlib.__QuicFrames.Range { smallest = 1L, largest = 1L }] }) 1100L 0L 25L) |> Stdlib.Result.map (fun update -> (update.state.congestion.inFlight, Stdlib.List.length update.retransmit, update.acknowledged)) = Ok ((0L, 0, [77L]))
