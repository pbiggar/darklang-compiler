// Pure progress/short-write tests, plus descriptor identity and metadata.
Stdlib.Cli.File.__copyWriteAt (fun _ _ -> Ok 1) (Stdlib.Blob.fromString "abc") 0 = Ok ()
Stdlib.Cli.File.__copyWriteAt (fun _ _ -> Ok 0) (Stdlib.Blob.fromString "abc") 0 = Error 5
Stdlib.Cli.Dir.withTemp (fun dir -> let destination = Stdlib.String.append dir "/not-a-file" in let copied = Stdlib.Cli.File.copy dir destination in (match copied with | Error e -> e.errno == 21 | Ok _ -> false) && (Stdlib.Cli.File.exists destination) == false) = Ok true isolated=true
Stdlib.Cli.File.__copyWriteAt (fun _ _ -> Ok 4) (Stdlib.Blob.fromString "abc") 0 = Error 5
Stdlib.Cli.File.__copyWriteAt (fun _ _ -> Error 28) (Stdlib.Blob.fromString "abc") 0 = Error 28
Stdlib.Cli.File.__copyBuffered (fun count offset -> if count != 65536 then Error 22 else if offset == 2 then Ok (Stdlib.Blob.fromString "abc") else if offset == 5 then Ok Stdlib.Blob.empty else Error 22) (fun _ offset -> if offset >= 2 && offset < 5 then Ok 1 else Error 22) 2 = Ok ()
Stdlib.Cli.Dir.withTemp (fun dir -> let path = dir ++ "/same" in let _ = Stdlib.Cli.File.writeText path "kept" in let rejected = match Stdlib.Cli.File.copy path path with | Error e -> e.errno == 22 | Ok _ -> false in rejected && Stdlib.Cli.File.readText path == Ok "kept") = Ok true isolated=true
Stdlib.Cli.Dir.withTemp (fun dir -> let source = dir ++ "/source" in let destination = dir ++ "/destination" in let _ = Stdlib.Cli.File.writeText source "new" in let _ = Stdlib.Cli.File.setPermissions source 384 in let _ = Stdlib.Cli.File.writeText destination "old contents" in let _ = Stdlib.Cli.File.setPermissions destination 420 in let copied = Stdlib.Cli.File.copy source destination in let mode = match Stdlib.Cli.Posix.stat destination with | Error _ -> 0 | Ok stat -> stat.mode & 511 in (copied, Stdlib.Cli.File.readText destination, mode) == (Ok (), Ok "new", 384)) = Ok true isolated=true
