// Interpreter-style bindings preserve names and SQLite storage classes.
Stdlib.Sqlite.__Engine.__executeTyped "/tmp/dark-sqlite-named.db" "SELECT @hash AS hash, $blob AS blob, :n AS n, @none AS none" (Dict { "@hash": Stdlib.Sqlite.Value.Text "abc", "$blob": Stdlib.Sqlite.Value.Bytes (Stdlib.Blob.fromHex "00FF" |> Stdlib.Result.withDefault Stdlib.Blob.empty), ":n": Stdlib.Sqlite.Value.Int 42L, "@none": Stdlib.Sqlite.Value.Null }) |> Stdlib.Result.map (fun result -> match result.rows with | [row] -> Stdlib.Dict.get row "hash" == Some (Stdlib.Sqlite.Value.Text "abc") && Stdlib.Dict.get row "n" == Some (Stdlib.Sqlite.Value.Int 42L) && Stdlib.Dict.get row "none" == Some Stdlib.Sqlite.Value.Null && (match Stdlib.Dict.get row "blob" with | Some (Bytes b) -> Stdlib.Blob.toHex b == "00FF" | _ -> false) | _ -> false) = Ok true
Stdlib.Sqlite.__Engine.__executeTyped "/tmp/dark-sqlite-named.db" "SELECT @hash AS a, @hash AS b" (Dict { "@hash": Stdlib.Sqlite.Value.Text "abc" }) |> Stdlib.Result.map (fun result -> result.rows) = Ok [Dict { "a": Stdlib.Sqlite.Value.Text "abc", "b": Stdlib.Sqlite.Value.Text "abc" }]
Stdlib.Sqlite.__Engine.__executeTyped "/tmp/dark-sqlite-named.db" "SELECT @Hash" (Dict { "@hash": Stdlib.Sqlite.Value.Text "abc" }) |> Stdlib.Result.map (fun result -> result.rows) = Error "SQLite: missing bound parameter: @Hash"
Stdlib.Sqlite.__Engine.__executeTyped "/tmp/dark-sqlite-named.db" "SELECT ';' AS a; SELECT 7 AS b;" (Dict {}) |> Stdlib.Result.map (fun result -> result.rows) = Ok [Dict { "b": Stdlib.Sqlite.Value.Int 7L }]
