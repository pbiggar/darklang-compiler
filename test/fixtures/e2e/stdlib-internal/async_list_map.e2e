// async_list_map.e2e - Known mapping callbacks retain their argument and result async interfaces.

type MappedAsyncRecord = { value: Float, text: String }
let mappingListPass (values: List<Int64>) : List<Int64> = values

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.map [value, 2L] (fun ignored -> 42L)) = [42L, 42L] // ignored mapping argument does not demand an element; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.length (Stdlib.List.map [value, 2L] (fun item -> item))) = 2 // identity map retains unresolved elements; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<String> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.length (Stdlib.List.map [1L, 2L] (fun ignored -> value))) = 2 // mapping callback may return an independently pending result; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Float> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let child = Stdlib.__Task.__startCurrent (fun _ -> let _ = Stdlib.__Task.__yield (__fiber_current ()) in Stdlib.__Task.__resolve (__fiber_current ()) gate 40.25) in Stdlib.List.map [value, 1.0] (fun item -> item + 1.75)) = [42.0, 2.75] // callback arithmetic demands its floating point input; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Float> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in Stdlib.List.map [(value, "first"), (2.0, "second")] (fun pair -> let (_, text) = pair in text)) = ["first", "second"] // callback projection leaves unrelated tuple fields unresolved; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Float> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let values = Stdlib.List.map [1L, 2L] (fun index -> MappedAsyncRecord { value = value; text = if index == 1L then "first" else "second" }) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 40.25 in values) = [MappedAsyncRecord { value = 40.25; text = "first" }, MappedAsyncRecord { value = 40.25; text = "second" }] // mapped records retain independent pending fields; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let identity = fun item -> item in let first = Stdlib.List.map [1L, 2L] identity in let second = Stdlib.List.map [value] identity in Stdlib.List.length first + Stdlib.List.length second) = 3 // shared callback reconciles ready and pending element representations; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let started = Stdlib.__Async.__new<Unit> () in let values = Stdlib.List.map [1L] (fun ignored -> let _ = Stdlib.__Task.__resolve (__fiber_current ()) started () in Stdlib.__Task.__transport (Stdlib.__Async.__pending gate)) in if Stdlib.__Async.__isReady started then Stdlib.List.length values else 0) = 1 // mapping invokes producers eagerly while retaining pending results; leak_check
Stdlib.__Task.__runMain (fun _unit -> Stdlib.List.map [41L, 42L] (fun item -> Stdlib.__Task.__delayTransparent 0L item)) = [41L, 42L] // mapped delay operations settle through native result demands; leak_check
Stdlib.__Task.__runMain (fun _unit -> let fieldGate = Stdlib.__Async.__new<Int64> () in let outerGate = Stdlib.__Async.__new<List<Int64>> () in let field = Stdlib.__Task.__transport (Stdlib.__Async.__pending fieldGate) in let first = mappingListPass [field] in let outer = mappingListPass (Stdlib.__Task.__transport (Stdlib.__Async.__pending outerGate)) in let child = Stdlib.__Task.__startCurrent (fun _ -> let _ = Stdlib.__Task.__yield (__fiber_current ()) in Stdlib.__Task.__resolve (__fiber_current ()) outerGate [1L, 2L]) in Stdlib.List.map outer (fun ignored -> 42L)) = [42L, 42L] // mapping demands the outer spine without demanding ignored elements; leak_check
Stdlib.__Task.__runMain (fun _unit -> let fieldGate = Stdlib.__Async.__new<Float> () in let outerGate = Stdlib.__Async.__new<MappedAsyncRecord> () in let field = Stdlib.__Task.__transport (Stdlib.__Async.__pending fieldGate) in let outer = Stdlib.__Task.__transport (Stdlib.__Async.__pending outerGate) in let values = Stdlib.List.map [MappedAsyncRecord { value = field; text = "partial" }, outer] (fun item -> item) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) fieldGate 40.25 in let _ = Stdlib.__Task.__resolve (__fiber_current ()) outerGate (MappedAsyncRecord { value = 2.0; text = "outer" }) in values) = [MappedAsyncRecord { value = 40.25; text = "partial" }, MappedAsyncRecord { value = 2.0; text = "outer" }] // identity mapping preserves mixed outer and field pendingness; leak_check
