// async_runtime_helper.e2e - Demand helpers are generated for source payload types.

type DemandHelperPayload = { number: Int64, text: String }

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<DemandHelperPayload> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate (DemandHelperPayload { number = 42L; text = "managed" ++ " payload" }) in value.number == 42L && value.text == "managed payload") = true // runtime helper specialization is independent of the root result type; leak_check
