// quic_flow.e2e - Client/server stream permissions and connection-wide credit including reset final sizes.
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.openStream state 1L) = Error "Cannot locally open a peer QUIC stream"
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.openStream state 4L) = Error "QUIC stream concurrency limit exceeded"
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.receive state (Stdlib.__QuicApplication.StreamData { id = 0L, offset = 0L, bytes = Stdlib.String.toBlob "x", fin = false })) = Error "Peer referenced an unopened local QUIC stream"
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.openStream state 2L) |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.receive state (Stdlib.__QuicApplication.StreamData { id = 2L, offset = 0L, bytes = Stdlib.String.toBlob "x", fin = false })) = Error "Peer sent data on a send-only QUIC stream"
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.receive state (Stdlib.__QuicApplication.StreamData { id = 3L, offset = 0L, bytes = Stdlib.String.toBlob "abcd", fin = true })) |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.read state 3L) |> Stdlib.Result.map (fun read -> (read.state.received, read.state.consumed, read.state.credit, read.finished, Stdlib.Blob.toHex read.bytes)) = Ok ((4L, 4L, 14L, true, "61626364"))
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.receive state (Stdlib.__QuicApplication.StreamData { id = 3L, offset = 0L, bytes = Stdlib.String.toBlob "abcde", fin = false })) = Error "QUIC stream flow control exceeded"
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in let frame = Stdlib.__QuicApplication.StreamData { id = 3L, offset = 0L, bytes = Stdlib.String.toBlob "abcd", fin = false } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.receive state frame) |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.receive state frame) |> Stdlib.Result.map (fun state -> state.received) = Ok 4L
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.openStream state 0L) |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.receive state (Stdlib.__QuicApplication.StreamData { id = 0L, offset = 0L, bytes = Stdlib.String.toBlob "12345678", fin = false })) |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.reset state (Stdlib.__QuicApplication.Reset { id = 3L, code = 256L, finalSize = 4L })) = Error "QUIC connection flow control exceeded"
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Server limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.receive state (Stdlib.__QuicApplication.StreamData { id = 0L, offset = 0L, bytes = Stdlib.String.toBlob "1234567", fin = false })) = Error "QUIC stream flow control exceeded"
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Server limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.openStream state 1L) |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.write state 1L (Stdlib.String.toBlob "1234567") false) = Error "QUIC send stream is blocked"
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.maxData state 5L) |> Stdlib.Result.map (fun state -> state.peer.data) = Ok 10L
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.receive state (Stdlib.__QuicApplication.StreamData { id = 3L, offset = 0L, bytes = Stdlib.Blob.empty, fin = false })) |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.maxStreamData state (Stdlib.__QuicApplication.StreamLimit { id = 3L, value = 10L })) = Error "Peer granted credit on a receive-only QUIC stream"
