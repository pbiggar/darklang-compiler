// quic_flow.e2e - Client/server stream permissions and connection-wide credit including reset final sizes.
let receiveFrame (state: Stdlib.__QuicFlow.State) (frame: Stdlib.__QuicApplication.StreamData) : Stdlib.Result.Result<Stdlib.__QuicFlow.State, String> =
  Stdlib.__QuicFlow.receive state frame |> Stdlib.Result.mapError Stdlib.__QuicWire.message
let resetFrame (state: Stdlib.__QuicFlow.State) (frame: Stdlib.__QuicApplication.Reset) : Stdlib.Result.Result<Stdlib.__QuicFlow.State, String> =
  Stdlib.__QuicFlow.reset state frame |> Stdlib.Result.mapError Stdlib.__QuicWire.message
let creditFrame (state: Stdlib.__QuicFlow.State) (frame: Stdlib.__QuicApplication.StreamLimit) : Stdlib.Result.Result<Stdlib.__QuicFlow.State, String> =
  Stdlib.__QuicFlow.maxStreamData state frame |> Stdlib.Result.mapError Stdlib.__QuicWire.message
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.openStream state 1L) = Error "Cannot locally open a peer QUIC stream"
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.openStream state 4L) = Error "QUIC stream concurrency limit exceeded"
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> receiveFrame state (Stdlib.__QuicApplication.StreamData { id = 0L, offset = 0L, bytes = Stdlib.String.toBlob "x", fin = false })) = Error "Peer referenced an unopened local QUIC stream"
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.openStream state 2L) |> Stdlib.Result.andThen (fun state -> receiveFrame state (Stdlib.__QuicApplication.StreamData { id = 2L, offset = 0L, bytes = Stdlib.String.toBlob "x", fin = false })) = Error "Peer sent data on a send-only QUIC stream"
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> receiveFrame state (Stdlib.__QuicApplication.StreamData { id = 3L, offset = 0L, bytes = Stdlib.String.toBlob "abcd", fin = true })) |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.read state 3L) |> Stdlib.Result.map (fun read -> (read.state.received, read.state.consumed, read.state.credit, read.finished, Stdlib.Blob.toHex read.bytes)) = Ok ((4L, 4L, 14L, true, "61626364"))
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> receiveFrame state (Stdlib.__QuicApplication.StreamData { id = 3L, offset = 0L, bytes = Stdlib.String.toBlob "abcde", fin = false })) = Error "QUIC stream flow control exceeded"
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in let frame = Stdlib.__QuicApplication.StreamData { id = 3L, offset = 0L, bytes = Stdlib.String.toBlob "abcd", fin = false } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> receiveFrame state frame) |> Stdlib.Result.andThen (fun state -> receiveFrame state frame) |> Stdlib.Result.map (fun state -> state.received) = Ok 4L
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.openStream state 0L) |> Stdlib.Result.andThen (fun state -> receiveFrame state (Stdlib.__QuicApplication.StreamData { id = 0L, offset = 0L, bytes = Stdlib.String.toBlob "12345678", fin = false })) |> Stdlib.Result.andThen (fun state -> resetFrame state (Stdlib.__QuicApplication.Reset { id = 3L, code = 256L, finalSize = 4L })) = Error "QUIC connection flow control exceeded"
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Server limits limits |> Stdlib.Result.andThen (fun state -> receiveFrame state (Stdlib.__QuicApplication.StreamData { id = 0L, offset = 0L, bytes = Stdlib.String.toBlob "1234567", fin = false })) = Error "QUIC stream flow control exceeded"
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Server limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.openStream state 1L) |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.write state 1L (Stdlib.String.toBlob "1234567") false) = Error "QUIC send stream is blocked"
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.maxData state 5L) |> Stdlib.Result.map (fun state -> state.peer.data) = Ok 10L
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> receiveFrame state (Stdlib.__QuicApplication.StreamData { id = 3L, offset = 0L, bytes = Stdlib.Blob.empty, fin = false })) |> Stdlib.Result.andThen (fun state -> creditFrame state (Stdlib.__QuicApplication.StreamLimit { id = 3L, value = 10L })) = Error "Peer granted credit on a receive-only QUIC stream"
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 40L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.List.fold (Stdlib.List.range 0 32) (Ok state) (fun result index -> result |> Stdlib.Result.andThen (fun state -> let id = (Stdlib.Int.toInt64 index |> Stdlib.Option.withDefault 0L) * 4L in Stdlib.__QuicFlow.openStream state id |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.write state id Stdlib.Blob.empty true) |> Stdlib.Result.andThen (fun written -> receiveFrame written.state (Stdlib.__QuicApplication.StreamData { id = id, offset = 0L, bytes = Stdlib.Blob.empty, fin = true }))))) |> Stdlib.Result.map (fun state -> Stdlib.List.length state.channels) = Ok 33
let limits = Stdlib.__QuicFlow.Limits { data = 10L, bidiLocal = 8L, bidiRemote = 6L, uni = 4L, streamsBidi = 1L, streamsUni = 3L } in Stdlib.__QuicFlow.create Stdlib.__QuicFlow.Role.Client limits limits |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.openStream state 0L) |> Stdlib.Result.andThen (fun state -> resetFrame state (Stdlib.__QuicApplication.Reset { id = 0L, code = 256L, finalSize = 8L })) |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicFlow.read state 0L) |> Stdlib.Result.andThen (fun read -> Stdlib.__QuicFlow.read read.state 0L) |> Stdlib.Result.map (fun read -> (read.state.received, read.state.consumed, read.state.credit, Stdlib.Blob.__byteLength read.frames)) = Ok ((8L, 8L, 18L, 0L))
