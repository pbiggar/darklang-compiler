// list-array.e2e - Native storage and immutable-semantics checks for List HIR.
// The seed is a freed 56-byte allocation: fixed buffer header + 40 data bytes.
// No skew-list node has this size. Offset 40 survives free-list linkage at 0.
// Disable inlining only for this allocator probe: seed's release must occur at
// its function boundary. Reacquire the block before inspecting its contents.
let seedArrayBlock () : RawPtr = let p = __raw_alloc 56L in let _ = __raw_write_word p 0L 1L in let _ = __raw_write_word p 8L 40L in let _ = __raw_write_word p 40L 999L in let s = __rawptr_to_string p in let _ = Stdlib.String.__byteLength s in p
let arrayPipeline () : Int64 = let xs = [1L, 2L, 3L] in let ys = Stdlib.List.map<Int64, Int64> xs (fun x -> x + 1L) in let zs = Stdlib.List.reverse<Int64> ys in Stdlib.List.fold<Int64, Int64> zs 0L (fun acc x -> acc * 10L + x)
let inspectRecycledArray () : Int64 = let p = __raw_alloc 56L in let _ = __raw_write_word p 0L 1L in let _ = __raw_write_word p 8L 40L in let s = __rawptr_to_string p in __raw_get<Int64> (__string_to_rawptr s) 40L
let capturedArrayControl (xs: List<Int64>) : Int64 = let ys = Stdlib.List.map<Int64, Int64> xs (fun x -> x + Stdlib.Option.withDefault<Int64> (Stdlib.List.getAt<Int64> xs 0) 0L) in Stdlib.List.fold<Int64, Int64> ys 0L (fun acc x -> acc + x)
let repeatedArrayPipeline (n: Int64) (acc: Int64) : Int64 = if n == 0L then acc else repeatedArrayPipeline (n - 1L) (acc + arrayPipeline ())

let _ = seedArrayBlock () in let result = arrayPipeline () in result + inspectRecycledArray () = stdout="434\n" stderr="" disable_opt_inline=true
repeatedArrayPipeline 100L 0L = stdout="43200\n" stderr=""
arrayPipeline () = 432L
let xs = [1L, 2L, 3L] in let ys = Stdlib.List.map<Int64, Int64> xs (fun x -> x + 10L) in let a = Stdlib.List.fold<Int64, Int64> xs 0L (fun acc x -> acc * 10L + x) in let b = Stdlib.List.fold<Int64, Int64> ys 0L (fun acc x -> acc + x) in a + b = 159L
Stdlib.List.fold<Int64, Int64> (Stdlib.List.reverse<Int64> []) 7L (fun acc x -> acc + x) = 7L
Stdlib.List.fold<Int64, Int64> (Stdlib.List.reverse<Int64> ([9L])) 0L (fun acc x -> acc + x) = 9L
let xs = [1L, 2L, 3L] in let alias = xs in let ys = Stdlib.List.reverse<Int64> xs in let old = Stdlib.List.fold<Int64, Int64> alias 0L (fun acc x -> acc * 10L + x) in let fresh = Stdlib.List.fold<Int64, Int64> ys 0L (fun acc x -> acc * 10L + x) in old * 1000L + fresh = 123321L
let offset = 7L in let xs = [1L, 2L, 3L] in let ys = Stdlib.List.map<Int64, Int64> xs (fun x -> x + offset) in Stdlib.List.fold<Int64, Int64> ys 0L (fun acc x -> acc + x) = 27L
capturedArrayControl ([1L, 2L, 3L]) = 9L
let xs = [1L, 2L, 3L] in let ys = Stdlib.List.map<Int64, Int64> xs (fun x -> let _ = Builtin.printLine (Stdlib.Int64.toString x) in x + 1L) in Stdlib.List.fold<Int64, Int64> (Stdlib.List.reverse<Int64> ys) 0L (fun acc x -> let _ = Builtin.printLine (Stdlib.Int64.toString x) in acc + x) = stdout="1\n2\n3\n4\n3\n2\n9\n" stderr=""
let xs = [1L, 2L, 3L] in let xs = Stdlib.List.reverse<Int64> xs in Stdlib.List.fold<Int64, Int64> xs 0L (fun acc x -> acc * 10L + x) = 321L
let seed = if true then 2L else 9L in Stdlib.List.fold<Int64, Int64> (Stdlib.List.reverse<Int64> ([seed, 3L])) 0L (fun acc x -> acc * 10L + x) = 32L
Stdlib.List.fold<Int64, Int64> (Stdlib.List.reverse<Int64> ([1L, 2L, 3L, 4L, 5L, 6L, 7L, 8L, 9L, 10L, 11L, 12L, 13L, 14L, 15L, 16L, 17L, 18L, 19L, 20L, 21L, 22L, 23L, 24L, 25L, 26L, 27L, 28L])) 0L (fun acc x -> acc + x) = 406L
Stdlib.List.fold<Int64, Int64> (Stdlib.List.reverse<Int64> ([1L, 2L, 3L, 4L, 5L, 6L, 7L, 8L, 9L, 10L, 11L, 12L, 13L, 14L, 15L, 16L, 17L, 18L, 19L, 20L, 21L, 22L, 23L, 24L, 25L, 26L, 27L, 28L, 29L])) 0L (fun acc x -> acc + x) = 435L
