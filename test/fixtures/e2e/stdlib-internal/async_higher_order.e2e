Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let started = Stdlib.__Async.__new<Unit> () in let values = hoMap [1L, 2L] (fun number -> if number == 1L then Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) else let _ = Stdlib.__Task.__resolve (__fiber_current ()) started () in 2L) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 1L in if Stdlib.__Async.__isReady started then Stdlib.List.length values else 0) = 2 // callbacks start eagerly even when an earlier result remains pending; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<String> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let result = hoString (fun _ -> value) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate "ready" in result) = "ready" // managed pending callback results preserve ownership through a source helper; leak_check
