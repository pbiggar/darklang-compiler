// async_tuple.e2e - Tuple storage does not inspect pending source fields.

Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let pair = (value, 1L) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 42L in let (left, right) = pair in left + right) = 43L // tuple construction keeps pending fields; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let pair = (value, 42L) in let (_, right) = pair in right) = 42L // projecting another field never demands the pending field; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Float> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let pair = (value, 2.0) in let alias = pair in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate 40.25 in let (left, right) = alias in left + right) = 42.25 // tuple alias preserves float carrier field layout; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<String> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let pair = (value, "!") in let _ = Stdlib.__Task.__resolve (__fiber_current ()) gate ("managed" + " result") in let (left, right) = pair in left + right) = "managed result!" // tuple owns a pending managed field; leak_check
Stdlib.__Task.__runMain (fun _unit -> let value = Stdlib.__Task.__delayTransparent 0L 42L in (value, 1L)) = (42L, 1L) // explicit native result materializes tuple fields; leak_check

Stdlib.__Task.__runMain (fun _unit -> let first = Stdlib.__Async.__new<Int64> () in let second = Stdlib.__Async.__new<Float> () in let left = Stdlib.__Task.__transport (Stdlib.__Async.__pending first) in let right = Stdlib.__Task.__transport (Stdlib.__Async.__pending second) in let pair = (left, right) in let _ = Stdlib.__Task.__resolve (__fiber_current ()) first 42L in let _ = Stdlib.__Task.__resolve (__fiber_current ()) second 40.25 in let (integer, floating) = pair in (integer, floating + 2.0)) = (42L, 42.25) // independent integer and float fields keep distinct payload types; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<String> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let unused = (value, "unused") in 42L) = 42L // abandoned tuple does not demand a managed field; leak_check
Stdlib.__Task.__runMain (fun _unit -> let gate = Stdlib.__Async.__new<Int64> () in let value = Stdlib.__Task.__transport (Stdlib.__Async.__pending gate) in let inner = (value, 2L) in let outer = (1L, inner) in let (_, selected) = outer in let (_, right) = selected in right) = 2L // nested tuple projection leaves unrelated pending fields untouched; leak_check
