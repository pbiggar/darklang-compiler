// mapped-buffer.e2e - Explicit, reclaimable large-buffer lifetime and bounds.
let mappedBufferRoundtrip (bytes: Int64) : Int64 = let p = __mapped_alloc bytes in let _ = __raw_write_word p 0L 17L in let _ = __raw_write_word p (bytes - 8L) 25L in let result = __raw_get<Int64> p 0L + __raw_get<Int64> p (bytes - 8L) in let _ = __mapped_free p in result
let repeatedMappedBuffers (n: Int64) (acc: Int64) : Int64 = if n == 0L then acc else repeatedMappedBuffers (n - 1L) (acc + mappedBufferRoundtrip 8388608L)

mappedBufferRoundtrip 264L = stdout="42\n" stderr=""
mappedBufferRoundtrip 65544L = stdout="42\n" stderr=""
repeatedMappedBuffers 128L 0L = stdout="5376\n" stderr=""
let p = __mapped_alloc 0L in let _ = __mapped_free p in 7L = stdout="7\n" stderr=""
let p = __mapped_alloc (-1L) in let _ = __mapped_free p in 0L = exit=1 stderr="Out of heap memory"
let p = __mapped_alloc 9223372036854775807L in let _ = __mapped_free p in 0L = exit=1 stderr="Out of heap memory"
