// Outgoing dynamic QPACK: budgets, sensitive fields, acknowledgments and eviction pins.
let bytes (hex: String) : Blob = Stdlib.Blob.fromHex hex |> Stdlib.Result.withDefault Stdlib.Blob.empty
let first (maximum: Int64) (blocked: Int64) : Stdlib.Result.Result<Stdlib.__QpackEncoder.Encoded, String> =
  Stdlib.__QpackEncoder.create maximum blocked |> Stdlib.Result.andThen (fun state -> Stdlib.__QpackEncoder.encode state 0L [("x", "y")] 65536L)
first 64L 1L |> Stdlib.Result.map (fun encoded -> (Stdlib.Blob.toHex encoded.instructions, Stdlib.Blob.toHex encoded.bytes)) = Ok (("3F2141780179", "020080"))
first 64L 4611686018427387903L |> Stdlib.Result.map (fun encoded -> (Stdlib.Blob.toHex encoded.instructions, Stdlib.Blob.toHex encoded.bytes)) = Ok (("3F2141780179", "020080"))
first 0L 1L |> Stdlib.Result.map (fun encoded -> (encoded.state.inserted, Stdlib.Blob.toHex encoded.instructions)) = Ok ((0L, ""))
first 64L 0L |> Stdlib.Result.map (fun encoded -> (encoded.state.inserted, Stdlib.List.length encoded.state.sections)) = Ok ((1L, 0))
first 64L 1L |> Stdlib.Result.andThen (fun encoded -> Stdlib.__QpackEncoder.feed encoded.state (bytes "80")) |> Stdlib.Result.map (fun state -> (state.known, Stdlib.List.length state.sections)) = Ok ((1L, 0))
first 64L 1L |> Stdlib.Result.andThen (fun encoded -> Stdlib.__QpackEncoder.feed encoded.state (bytes "40")) |> Stdlib.Result.map (fun state -> (state.known, Stdlib.List.length state.sections)) = Ok ((0L, 0))
first 64L 1L |> Stdlib.Result.andThen (fun encoded -> Stdlib.__QpackEncoder.feed encoded.state (bytes "40")) |> Stdlib.Result.andThen (fun state -> Stdlib.__QpackEncoder.encode state 4L [("a", "b")] 65536L) |> Stdlib.Result.map (fun encoded -> encoded.state.inserted) = Ok 1L
first 64L 1L |> Stdlib.Result.andThen (fun encoded -> Stdlib.__QpackEncoder.feed encoded.state (bytes "00")) |> Stdlib.Result.map (fun state -> state.known) = Error "Invalid QPACK insert count increment"
first 64L 1L |> Stdlib.Result.andThen (fun encoded -> Stdlib.__QpackEncoder.feed encoded.state (bytes "02")) |> Stdlib.Result.map (fun state -> state.known) = Error "Invalid QPACK insert count increment"
first 64L 1L |> Stdlib.Result.andThen (fun encoded -> Stdlib.__QpackEncoder.feed encoded.state (bytes "84")) |> Stdlib.Result.map (fun state -> state.known) = Error "Unexpected QPACK section acknowledgment"
first 64L 0L |> Stdlib.Result.andThen (fun encoded -> Stdlib.__QpackEncoder.feed encoded.state (bytes "01")) |> Stdlib.Result.andThen (fun state -> Stdlib.__QpackEncoder.encode state 4L [("x", "y")] 0L) |> Stdlib.Result.map (fun encoded -> Stdlib.Blob.toHex encoded.bytes) = Ok "020080"
first 64L 1L |> Stdlib.Result.andThen (fun encoded -> Stdlib.__QpackEncoder.encode encoded.state 4L [("a", "b")] 65536L) |> Stdlib.Result.map (fun encoded -> encoded.state.inserted) = Ok 1L
first 64L 1L |> Stdlib.Result.andThen (fun encoded -> Stdlib.__QpackEncoder.feed encoded.state (bytes "80")) |> Stdlib.Result.andThen (fun state -> Stdlib.__QpackEncoder.encode state 4L [("a", "b")] 65536L) |> Stdlib.Result.map (fun encoded -> encoded.state.inserted) = Ok 2L
first 64L 1L |> Stdlib.Result.andThen (fun encoded -> Stdlib.__QpackEncoder.encode encoded.state 0L [("x", "y")] 0L) |> Stdlib.Result.andThen (fun encoded -> Stdlib.__QpackEncoder.feed encoded.state (bytes "80")) |> Stdlib.Result.map (fun state -> Stdlib.List.length state.sections) = Ok 1
Stdlib.__QpackEncoder.create 64L 1L |> Stdlib.Result.andThen (fun state -> Stdlib.__QpackEncoder.encode state 0L [("authorization", "secret"), ("cookie", "secret")] 65536L) |> Stdlib.Result.map (fun encoded -> encoded.state.inserted) = Ok 0L
Stdlib.__QpackEncoder.create 64L 1L |> Stdlib.Result.andThen (fun state -> Stdlib.__QpackEncoder.encode state 0L [("x", "y")] 5L) |> Stdlib.Result.map (fun encoded -> (encoded.state.inserted, Stdlib.Blob.toHex encoded.instructions)) = Ok ((0L, "3F21"))
Stdlib.__QpackEncoder.create 64L 1L |> Stdlib.Result.andThen (fun state -> Stdlib.__QpackEncoder.encode state 128L [("x", "y")] 65536L) |> Stdlib.Result.andThen (fun encoded -> Stdlib.__QpackEncoder.feed encoded.state (bytes "FF")) |> Stdlib.Result.andThen (fun state -> Stdlib.__QpackEncoder.feed state (bytes "01")) |> Stdlib.Result.map (fun state -> state.known) = Ok 1L
Stdlib.__QpackEncoder.create (-1L) 1L |> Stdlib.Result.map (fun state -> state.capacity) = Error "Invalid QPACK encoder settings"
Stdlib.__QpackEncoder.create 64L 4611686018427387904L |> Stdlib.Result.map (fun state -> state.capacity) = Error "Invalid QPACK encoder settings"
first 64L 1L |> Stdlib.Result.andThen (fun encoded -> Stdlib.__QpackEncoder.feed encoded.state (bytes "01")) |> Stdlib.Result.andThen (fun state -> Stdlib.__QpackEncoder.encode state 4L [("a", "b")] 65536L) |> Stdlib.Result.map (fun encoded -> encoded.state.inserted) = Ok 1L
first 64L 1L |> Stdlib.Result.andThen (fun encoded -> Stdlib.__QpackEncoder.feed encoded.state (bytes "8080")) |> Stdlib.Result.map (fun state -> state.known) = Error "Unexpected QPACK section acknowledgment"
first 128L 1L |> Stdlib.Result.andThen (fun encoded -> Stdlib.__QpackEncoder.encode encoded.state 4L [("a", "b")] 65536L) |> Stdlib.Result.map (fun encoded -> (encoded.state.inserted, Stdlib.List.length encoded.state.sections, Stdlib.Blob.toHex (Stdlib.__Http2Wire.__slice encoded.bytes 0L 2L))) = Ok ((2L, 1, "0000"))
first 128L 1L |> Stdlib.Result.andThen (fun encoded -> Stdlib.__QpackEncoder.encode encoded.state 0L [("a", "b")] 65536L) |> Stdlib.Result.map (fun encoded -> Stdlib.List.length encoded.state.sections) = Ok 2
Stdlib.__QpackEncoder.create 64L 1L |> Stdlib.Result.andThen (fun state -> Stdlib.__QpackEncoder.encode state 0L [("x", "y")] 1L) |> Stdlib.Result.andThen (fun encoded -> Stdlib.__QpackEncoder.encode encoded.state 0L [("x", "y")] 6L) |> Stdlib.Result.map (fun encoded -> Stdlib.Blob.toHex encoded.instructions) = Ok "3F2141780179"
Stdlib.__QpackEncoder.create 64L 1L |> Stdlib.Result.andThen (fun state -> Stdlib.__QpackEncoder.encode state 0L [("x", "y"), ("a", "b")] 65536L) |> Stdlib.Result.map (fun encoded -> encoded.state.inserted) = Ok 1L
Stdlib.__QpackEncoder.create 64L 1L |> Stdlib.Result.andThen (fun state -> Stdlib.__QpackEncoder.encode state 1L [] 0L) |> Stdlib.Result.map (fun encoded -> encoded.state.inserted) = Error "Invalid QPACK encoder budget or stream"
