// The existing buffer/command syscall adapter must support Linux fcntl too.
(match Stdlib.Cli.Posix.openFile "/tmp/dark-sqlite-fcntl.db" (2 + Stdlib.Cli.Posix.OpenFlags.creat ()) 384 with | Error _ -> false | Ok fd -> let ptr = __mapped_alloc 32L in let rc = Stdlib.Cli.__Posix.__fcntl (Stdlib.Int.toInt64 fd |> Stdlib.Option.withDefault 0L) 3L ptr in let _ = __mapped_free ptr in let _ = Stdlib.Cli.Posix.fdClose fd in rc >= 0L && (rc & 3L) == 2L) = true
