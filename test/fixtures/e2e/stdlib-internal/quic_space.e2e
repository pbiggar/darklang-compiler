// quic_space.e2e - Packet-space ownership, duplicate suppression and PTO queue priority.
Stdlib.__QuicSpace.create () |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicSpace.prepare state 0L 29L false) = Ok None
Stdlib.__QuicSpace.create () |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicSpace.queue state Stdlib.Blob.empty) = Error "Invalid QUIC reliable frame size"
Stdlib.__QuicSpace.create () |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicSpace.receive state 4L true) |> Stdlib.Result.andThen (fun receipt -> Stdlib.__QuicSpace.receive receipt.state 4L true) |> Stdlib.Result.map (fun receipt -> (receipt.fresh, receipt.state.ackPending)) = Ok ((false, true))
Stdlib.__QuicSpace.create () |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicSpace.receive state 4L false) |> Stdlib.Result.map (fun receipt -> receipt.state.ackPending) = Ok false
Stdlib.__QuicSpace.create () |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicSpace.receive state 4L true) |> Stdlib.Result.andThen (fun receipt -> Stdlib.__QuicSpace.prepare receipt.state 0L 29L true) |> Stdlib.Result.map (fun plan -> match plan with | None -> (false, "") | Some plan -> (plan.ackEliciting, Stdlib.Blob.toHex plan.payload)) = Ok ((true, "020400000001"))
Stdlib.__QuicSpace.create () |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicSpace.receive state 4L true) |> Stdlib.Result.andThen (fun receipt -> Stdlib.__QuicSpace.prepare receipt.state 0L 29L false) |> Stdlib.Result.map (fun plan -> match plan with | None -> (true, "") | Some plan -> (plan.ackEliciting, Stdlib.Blob.toHex plan.payload)) = Ok ((false, "0204000000"))
