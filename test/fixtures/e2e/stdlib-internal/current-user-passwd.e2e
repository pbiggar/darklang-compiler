// UID matching skips malformed and unrelated passwd entries.
Stdlib.Cli.Posix.__accountFieldFromPasswd ["malformed", "other:x:20:20::/home/other:/bin/sh", "match:x:42:42::/home/match:/bin/sh"] "42" 0 = Some "match"
Stdlib.Cli.Posix.__accountFieldFromPasswd ["other:x:20:20::/home/other:/bin/sh", "malformed"] "42" 0 = None
