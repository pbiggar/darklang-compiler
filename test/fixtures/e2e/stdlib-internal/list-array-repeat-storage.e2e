// list-array-repeat-storage.e2e - Runtime cardinality, initialization, and release.
let inspectRepeatCapacity (count: Int) : Int64 = let p = Stdlib.List.__arrayRepeat count 7L in let capacity = __raw_get<Int64> p 8L in let rc = __raw_get<Int64> p (24L + capacity * 8L) in let _ = Stdlib.List.__arrayRelease p in capacity * 10L + rc
let inspectRepeatedArray (count: Int) : Int64 = let p = Stdlib.List.__arrayRepeat count 7L in let length = __raw_get<Int64> p 0L in let initialized = __raw_get<Int64> p 16L in let last = if length == 0L then 0L else __raw_get<Int64> p (24L + (length - 1L) * 8L) in let _ = Stdlib.List.__arrayRelease p in length * 100L + initialized * 10L + last

inspectRepeatedArray 3 = stdout="337\n" stderr=""
inspectRepeatedArray 0 = stdout="0\n" stderr=""
inspectRepeatedArray (-999999999999999999999999999999) = stdout="0\n" stderr=""
inspectRepeatedArray 513 = stdout="56437\n" stderr=""
inspectRepeatedArray 1152921504606846971 = exit=1 stderr="Uncaught exception: Out of heap memory"
inspectRepeatedArray 999999999999999999999999999999 = exit=1 stderr="Uncaught exception: Out of heap memory"
inspectRepeatCapacity 0 = stdout="281\n" stderr=""
inspectRepeatCapacity 3 = 281L
inspectRepeatCapacity 28 = stdout="281\n" stderr=""
inspectRepeatCapacity 29 = stdout="291\n" stderr=""
inspectRepeatCapacity 513 = stdout="5131\n" stderr=""
