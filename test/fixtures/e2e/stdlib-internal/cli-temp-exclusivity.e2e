// cli-temp-exclusivity.e2e - Native exclusive create preserves an existing temporary file.

let path = Stdlib.Cli.File.createTemp () |> Builtin.unwrap in let flags = if Stdlib.Cli.Runtime.targetOS () == "darwin" then 2561 else 193 in let opened = Stdlib.Cli.Syscall.open path flags 384 in let exclusive = match opened with | Error errno -> errno == 17 | Ok fd -> let _ = Stdlib.Cli.Syscall.close fd in false in let stillExists = Stdlib.Cli.FileSystem.pathExists path in let _ = Stdlib.Cli.FileSystem.deleteFile path |> Builtin.unwrap in (exclusive, stillExists) = (true, true)
