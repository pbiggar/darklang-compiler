// Compiler-only implementation coverage; internal mode is restricted to this directory.

// Arguments are positional (excluding the executable name) and parse failures
// remain values at the public CLI boundary.
match Stdlib.Cli.__Args.int64 0 with | Ok value -> value | Error message -> Builtin.crash message = 42L arg="42"
match Stdlib.Cli.__Args.int64 0 with | Ok value -> value | Error message -> Builtin.crash message = stdout="42\n" stderr="" arg="42"

match Stdlib.Cli.__Args.int64 0 with | Error message -> message | Ok _ -> "unexpected" = "invalid Int64 command-line argument at index 0: twelve" arg="twelve"
