// p256_ecdsa.e2e - P-256 ECDSA signature and public-key validation.

(let key = Stdlib.Blob.fromHex "3059301306072A8648CE3D020106082A8648CE3D0301070342000457E15BB5FA2969E081C0FB26F31EF44ADFB9229E4093986E64A199F94ACBD50A2FD5351E23FDB0309AC9ECFB127A0EAC32F6F77B1AC7EC99B6EBD221B01FADBA"
 let signature = Stdlib.Blob.fromHex "304502210086AD2C7062EB3951FA71FD2EF71BE9D3B9C2E052471943D8B7CED0A5BEE226DB022074031B662437F1E0B0CF9A4F8761DC539F5036BAD624070CC39E5EE200E73963"
 match (key, signature) with
 | (Ok k, Ok s) -> Stdlib.__P256.verifySha256 k (Stdlib.String.toBlob "Dark TLS P-256 verification fixture") s
 | _ -> Error "fixture")
  = Ok true

(let key = Stdlib.Blob.fromHex "3059301306072A8648CE3D020106082A8648CE3D0301070342000457E15BB5FA2969E081C0FB26F31EF44ADFB9229E4093986E64A199F94ACBD50A2FD5351E23FDB0309AC9ECFB127A0EAC32F6F77B1AC7EC99B6EBD221B01FADBA"
 let signature = Stdlib.Blob.fromHex "304502210086AD2C7062EB3951FA71FD2EF71BE9D3B9C2E052471943D8B7CED0A5BEE226DB022074031B662437F1E0B0CF9A4F8761DC539F5036BAD624070CC39E5EE200E73963"
 match (key, signature) with
 | (Ok k, Ok s) -> Stdlib.__P256.verifySha256 k (Stdlib.String.toBlob "Changed message") s
 | _ -> Error "fixture")
  = Ok false

(let key = Stdlib.Blob.fromHex "3059301306072A8648CE3D020106082A8648CE3D0301070342000457E15BB5FA2969E081C0FB26F31EF44ADFB9229E4093986E64A199F94ACBD50A2FD5351E23FDB0309AC9ECFB127A0EAC32F6F77B1AC7EC99B6EBD221B01FADBA"
 let signature = Stdlib.Blob.fromHex "304502210086AD2C7062EB3951FA71FD2EF71BE9D3B9C2E052471943D8B7CED0A5BEE226DB022074031B662437F1E0B0CF9A4F8761DC539F5036BAD624070CC39E5EE200E73963"
 match (key, signature) with
 | (Ok k, Ok s) ->
   let changed = Stdlib.Blob.concat [Stdlib.Blob.slice k 0 90, Stdlib.String.toBlob "x"] in
   Stdlib.__P256.verifySha256 changed (Stdlib.String.toBlob "Dark TLS P-256 verification fixture") s
 | _ -> Error "fixture")
  = Error "P-256 public point is not on curve"

(let signature = Stdlib.Blob.fromHex "304502210086AD2C7062EB3951FA71FD2EF71BE9D3B9C2E052471943D8B7CED0A5BEE226DB022074031B662437F1E0B0CF9A4F8761DC539F5036BAD624070CC39E5EE200E73963"
 match signature with
 | Error _ -> Error "fixture"
 | Ok bytes ->
   let verify = Stdlib.Blob.concat [Stdlib.Blob.fromList [15uy, 0uy, 0uy, 75uy, 4uy, 3uy, 0uy, 71uy], bytes] in
   Stdlib.__Tls13Certificate.parseCertificateVerify verify
   |> Stdlib.Result.map (fun parsed -> parsed.algorithm))
  = Ok 1027L

// A public key equal to -G makes the precomputed G+Q point infinite.
(let key = Stdlib.Blob.fromHex "3059301306072A8648CE3D020106082A8648CE3D030107034200046B17D1F2E12C4247F8BCE6E563A440F277037D812DEB33A0F4A13945D898C296B01CBD1C01E58065711814B583F061E9D431CCA994CEA1313449BF97C840AE0A"
 let signature = Stdlib.Blob.fromHex "304502206B17D1F2E12C4247F8BCE6E563A440F277037D812DEB33A0F4A13945D898C296022100C3A7AD62731D11075B21A4628F1B142C37BA19D23526D218A11DCFBA7558D03D"
 match (key, signature) with
 | (Ok k, Ok s) -> Stdlib.__P256.verifySha256 k (Stdlib.String.toBlob "P-256 negated generator boundary") s
 | _ -> Error "fixture")
  = Ok true
