// Option, Result, and Retry parity with darklang/dark
// 04fbe9dcc995c6188757d583e273cbd30a3e2d3d.

// Option.and selects its second input only when the first is Some, including
// when the payload types differ.
Stdlib.Option.and (Some 6L) (Some 5L) = Some 5L
Stdlib.Option.and (Some 6L) None = None
Stdlib.Option.and None (Some 5L) = None
Stdlib.Option.and None None = None
Stdlib.Option.and (Some "ignored") (Some 42L) = Some 42L

// Result.and and Result.or preserve the selected input and its exact payload.
Stdlib.Result.and (Ok 1L) (Ok 2L) = Ok 2L
Stdlib.Result.and (Ok 1L) (Error "second") = Error "second"
Stdlib.Result.and (Error "first") (Ok 2L) = Error "first"
Stdlib.Result.and (Error "first") (Error "second") = Error "first"
Stdlib.Result.or (Ok 1L) (Ok 2L) = Ok 1L
Stdlib.Result.or (Ok 1L) (Error "second") = Ok 1L
Stdlib.Result.or (Error "first") (Ok 2L) = Ok 2L
Stdlib.Result.or (Error "first") (Error "second") = Error "second"

// Interpreter application lowering evaluates arguments eagerly from left to
// right even when selection makes one payload irrelevant.
let optionAndFirst (): Option<Int64> = let _ = Builtin.print "1" in None let optionAndSecond (): Option<Int64> = let _ = Builtin.print "2" in Some 2L let _ = Stdlib.Option.and (optionAndFirst ()) (optionAndSecond ()) in 0L = stdout="120\n" stderr="" exact_bytes=true
let resultAndFirst (): Result<Int64, String> = let _ = Builtin.print "1" in Error "first" let resultAndSecond (): Result<Int64, String> = let _ = Builtin.print "2" in Ok 2L let _ = Stdlib.Result.and (resultAndFirst ()) (resultAndSecond ()) in 0L = stdout="120\n" stderr="" exact_bytes=true
let resultOrFirst (): Result<Int64, String> = let _ = Builtin.print "1" in Ok 1L let resultOrSecond (): Result<Int64, String> = let _ = Builtin.print "2" in Error "second" let _ = Stdlib.Result.or (resultOrFirst ()) (resultOrSecond ()) in 0L = stdout="120\n" stderr="" exact_bytes=true

// Retry callbacks run at least once, return the final callback payload
// unchanged, and never sleep after success or terminal failure.
match Stdlib.Retry.withBackoff 3 (fun () -> let _ = Builtin.print "x" in Ok "done") with | Ok value -> value | Error error -> error = stdout="x\"done\"\n" stderr="" exact_bytes=true
match Stdlib.Retry.withBackoff 0 (fun () -> let _ = Builtin.print "x" in Error "zero") with | Ok value -> value | Error error -> error = stdout="x\"zero\"\n" stderr="" exact_bytes=true
match Stdlib.Retry.withFixedDelay (-2) 5000.0 (fun () -> let _ = Builtin.print "x" in Error "negative") with | Ok value -> value | Error error -> error = stdout="x\"negative\"\n" stderr="" exact_bytes=true
match Stdlib.Retry.withFixedDelay 1 5000.0 (fun () -> let _ = Builtin.print "x" in Error "last") with | Ok value -> value | Error error -> error = stdout="x\"last\"\n" stderr="" exact_bytes=true
match Stdlib.Retry.withFixedDelay 3 5000.0 (fun () -> let _ = Builtin.print "x" in Ok "done") with | Ok value -> value | Error error -> error = stdout="x\"done\"\n" stderr="" exact_bytes=true

// Explicit starting attempts and zero-delay retry paths pin attempt counts.
match Stdlib.Retry.withBackoffLoop 4 3 0.0 (fun () -> let _ = Builtin.print "x" in Error "last") with | Ok value -> value | Error error -> error = stdout="xx\"last\"\n" stderr="" exact_bytes=true
match Stdlib.Retry.withFixedDelayLoop 4 3 0.0 (fun () -> let _ = Builtin.print "x" in Error "last") with | Ok value -> value | Error error -> error = stdout="xx\"last\"\n" stderr="" exact_bytes=true
match Stdlib.Retry.withFixedDelay 2 0.0 (fun () -> let _ = Builtin.print "x" in Error "last") with | Ok value -> value | Error error -> error = stdout="xx\"last\"\n" stderr="" exact_bytes=true

// Deterministic callback input proves that retrying stops on the first Ok.
let retryFromStdin (unitArg: Unit): Result<String, String> = let value = Builtin.stdinReadLine (()) in let _ = Builtin.print "x" in if value == "ok" then Ok "success" else Error value match Stdlib.Retry.withFixedDelay 5 1.0 retryFromStdin with | Ok value -> value | Error error -> error = stdout="xx\"success\"\n" stderr="" stdin="fail\nok\nunused\n" exact_bytes=true
let backoffFromStdin (unitArg: Unit): Result<String, String> = let value = Builtin.stdinReadLine (()) in let _ = Builtin.print "x" in if value == "ok" then Ok "success" else Error value match Stdlib.Retry.withBackoffLoop 5 1 0.0 backoffFromStdin with | Ok value -> value | Error error -> error = stdout="xx\"success\"\n" stderr="" stdin="fail\nok\nunused\n" exact_bytes=true
