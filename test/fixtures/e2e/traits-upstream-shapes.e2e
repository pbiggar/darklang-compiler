// Adapted native expectations from the unchanged upstream-reference/language/traits.dark.
module UpstreamTraitShapes =
  type Point = { x: Int; y: Int }

  trait Show<'a> =
    let show (value: 'a) : String

  impl Show for Point =
    let show (p: Point) : String =
      $"({Stdlib.toString p.x}, {Stdlib.toString p.y})"

  impl Show for Int =
    let show (n: Int) : String = Stdlib.toString n

  impl Show for Bool =
    let show (b: Bool) : String = if b then "yes" else "no"

  impl<'a: Show> Show for List<'a> =
    let show (xs: List<'a>) : String =
      "[" + (xs |> Stdlib.List.map (fun x -> Show.show x) |> Stdlib.String.join ", ") + "]"

  let display<'a: Show> (v: 'a) : String = "value: " + Show.show v

UpstreamTraitShapes.Point.Show.show (UpstreamTraitShapes.Point { x = 1; y = 2 }) = "(1, 2)"
UpstreamTraitShapes.Show.show (UpstreamTraitShapes.Point { x = 5; y = 6 }) = "(5, 6)"
UpstreamTraitShapes.display [1, 2, 3] = "value: [1, 2, 3]"
UpstreamTraitShapes.Show.show [[true], []] = "[[yes], []]"
([1, 2] |> Stdlib.List.map UpstreamTraitShapes.Show.show) = ["1", "2"]
(UpstreamTraitShapes.Point { x = 1; y = 2 }).show = "(1, 2)"
UpstreamTraitShapes.Show.show 3.5 = compileerror="No implementation of trait"
Stdlib.Int64.ToString.toString 42L = "42"
