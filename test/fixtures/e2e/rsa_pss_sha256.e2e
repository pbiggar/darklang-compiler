// rsa_pss_sha256.e2e - independently signed OpenSSL RSA-PSS/SHA-256 vector.

(let modulus = Stdlib.Blob.fromHex ""
 let signature = Stdlib.Blob.fromHex ""
 let message = Stdlib.Blob.fromHex "4461726B20544C53204365727469666963617465566572696679205253412D505353207465737420766563746F72"
 match (modulus, signature, message) with
 | (Ok n, Ok s, Ok m) -> Stdlib.RsaPss.verifySha256 n (Stdlib.Blob.fromHex "010001" |> Stdlib.Result.withDefault Stdlib.Blob.empty) m s
 | _ -> Error "Invalid vector")
  = Ok true

(let modulus = Stdlib.Blob.fromHex ""
 let signature = Stdlib.Blob.fromHex ""
 let message = Stdlib.Blob.fromHex "4461726B20544C53204365727469666963617465566572696679205253412D505353207465737420766563746F00"
 match (modulus, signature, message) with
 | (Ok n, Ok s, Ok m) -> Stdlib.RsaPss.verifySha256 n (Stdlib.Blob.fromHex "010001" |> Stdlib.Result.withDefault Stdlib.Blob.empty) m s
 | _ -> Error "Invalid vector")
  = Ok false

// OpenSSL RSA-PSS with a 20-byte salt must fail the TLS SHA-256 profile.
(let modulus = Stdlib.Blob.fromHex ""
 let signature = Stdlib.Blob.fromHex ""
 let message = Stdlib.Blob.fromHex "4461726B20544C53204365727469666963617465566572696679205253412D505353207465737420766563746F72"
 match (modulus, signature, message) with
 | (Ok n, Ok s, Ok m) -> Stdlib.RsaPss.verifySha256 n (Stdlib.Blob.fromHex "010001" |> Stdlib.Result.withDefault Stdlib.Blob.empty) m s
 | _ -> Error "Invalid vector")
  = Ok false

Stdlib.RsaPss.verifySha256 Stdlib.Blob.empty Stdlib.Blob.empty Stdlib.Blob.empty Stdlib.Blob.empty
  = Error "Invalid RSA public key"
