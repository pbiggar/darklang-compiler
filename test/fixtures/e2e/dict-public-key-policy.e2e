// Public keys reject present opaque values while private HAMTs retain Blob identity keys.
type OpaqueKey = { payload: Blob }
Stdlib.Dict.singleton (Stdlib.Blob.fromString "bad") "value" = error="Unsupported dictionary key type"
Stdlib.Dict.singleton (Stdlib.Stream.fromList [1L]) "value" = error="Unsupported dictionary key type"
Stdlib.Dict.singleton [Stdlib.Blob.fromString "bad"] "value" = error="Unsupported dictionary key type"
Stdlib.Dict.singleton (Some (Stdlib.Blob.fromString "bad")) "value" = error="Unsupported dictionary key type"
Stdlib.Dict.singleton (OpaqueKey { payload = Stdlib.Blob.fromString "bad" }) "value" = error="Unsupported dictionary key type"
Stdlib.Dict.fromList [(Stdlib.Blob.fromString "bad", "value")] = error="Unsupported dictionary key type"
Stdlib.Dict.fromListOverwritingDuplicates [(Stdlib.Blob.fromString "bad", "value")] = error="Unsupported dictionary key type"
Stdlib.Dict.get (Dict { (Stdlib.Blob.fromString "bad"): "value" }) (Stdlib.Blob.fromString "bad") = error="Unsupported dictionary key type"
let absentBlob () : Stdlib.Option.Option<Blob> = None
Stdlib.Dict.get (Stdlib.Dict.singleton (absentBlob ()) "empty") (absentBlob ()) = Some "empty"
let emptyBlobList = if false then [Stdlib.Blob.fromString "bad"] else [] in Stdlib.Dict.get (Stdlib.Dict.singleton emptyBlobList "empty") emptyBlobList = Some "empty"
let absentStream () : List<Stream<Int64>> = []
Stdlib.Dict.get (Stdlib.Dict.singleton (absentStream ()) "empty") (absentStream ()) = Some "empty"
Stdlib.Dict.singleton (fun x -> x + 1L) "bad" = compileerror="Functions cannot be used as dictionary keys"
Stdlib.Dict.singleton (Some (fun x -> x + 1L)) "bad" = compileerror="Functions cannot be used as dictionary keys"
let genericKey<'key> (key: key) : Dict<key, Int64> = Dict { key: 1L }
genericKey (fun x -> x + 1L) = compileerror="Functions cannot be used as dictionary keys"
let maker = genericKey<(Int64 -> Int64)> in maker (fun x -> x + 1L) = compileerror="Functions cannot be used as dictionary keys"
