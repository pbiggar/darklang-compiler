// Application arguments retain their boundaries before grouped expressions and unit.

let keep (value: Int64) (u: Unit) : Int64 = value; let value = 42L in keep value () = 42L
let keep (value: Int64) (u: Unit) : Int64 = value; keep 42L () = 42L
let keep (first: Unit) (second: Unit) : Int64 = 42L; let value = () in keep value () = 42L
let keep (value: Int64) (u: Unit) : Int64 = value; let value = 42L in keep (value) () = 42L
let add (a: Int64) (b: Int64) : Int64 = a + b; let inc (n: Int64) : Int64 = n + 1L; let value = 20L in add value (inc 21L) = 42L
let add (a: Int64) (b: Int64) : Int64 = a + b; let value = 20L in add value ((fun n -> n + 1L) 21L) = 42L
let invoke (fn: Unit -> Int64) (u: Unit) : Int64 = fn u; let answer (u: Unit) : Int64 = 42L; invoke answer () = 42L
let keep (value: Int64) (u: Unit) : Int64 = value; keep (Stdlib.Int64.add 20L 22L) () = 42L
let answer (u: Unit) : Int64 = 42L; answer () = 42L
let identity<'a> (value: a) : a = value; identity<Unit> () = ()
let keep (value: String) (u: Unit) : String = value; keep Stdlib.String.newline () = "\n"
let apply (fn: Int64 -> Unit -> Int64) : Int64 = fn 42L (); let keep (value: Int64) (u: Unit) : Int64 = value; apply keep = 42L
