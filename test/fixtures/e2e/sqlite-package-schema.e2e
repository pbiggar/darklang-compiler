// Package-style text/composite keys, expression/partial indices and defaults.
(let db = "/tmp/dark-sqlite-package-keys.db" in let _ = Stdlib.Cli.File.delete db in let created = Stdlib.Sqlite.exec db "CREATE TABLE t (hash TEXT PRIMARY KEY, name TEXT NOT NULL DEFAULT 'new', n INTEGER DEFAULT 7); INSERT INTO t(hash) VALUES ('a'),('b')" in (created,Stdlib.Sqlite.scalarInt db "SELECT n FROM t WHERE hash='a'" "n")) = (Ok 2,Some 7L)
(let db = "/tmp/dark-sqlite-package-unique.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t (hash TEXT PRIMARY KEY, owner TEXT, name TEXT); CREATE UNIQUE INDEX u ON t(coalesce(owner,''),name) WHERE name IS NOT NULL; INSERT INTO t VALUES ('a',NULL,'x')" in (Stdlib.Sqlite.exec db "INSERT OR IGNORE INTO t VALUES ('b','','x')",Stdlib.Sqlite.exec db "INSERT INTO t VALUES ('c',NULL,NULL),('d',NULL,NULL)",Stdlib.Sqlite.scalarInt db "SELECT count(*) AS n FROM t" "n")) = (Ok 0,Ok 2,Some 3L)
(let db = "/tmp/dark-sqlite-package-composite.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t (owner TEXT, name TEXT, text TEXT DEFAULT '', PRIMARY KEY(owner,name)); INSERT INTO t(owner,name) VALUES ('d','x')" in (Stdlib.Result.isError (Stdlib.Sqlite.exec db "INSERT INTO t(owner,name) VALUES ('d','x')"),Stdlib.Sqlite.exec db "UPDATE t SET text='changed' WHERE owner='d' AND name='x'",Stdlib.Sqlite.column db "SELECT text FROM t WHERE owner='d' AND name='x'" "text")) = (true,Ok 1,["changed"])
