// Page-backed SQLite: public API, parameter binding and transaction rollback.

(let db = "/tmp/dark-sqlite-basic.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT)" in let _ = Stdlib.Sqlite.execP db "INSERT INTO t (id,name) VALUES (@p0,@p1)" ["1", "o'brien"] in Stdlib.Sqlite.column db "SELECT name FROM t ORDER BY id" "name") = ["o'brien"]

(let db = "/tmp/dark-sqlite-rollback.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT)" in let _ = Stdlib.Sqlite.execP db "INSERT INTO t VALUES (@p0,@p1)" ["1", "alice"] in let batch = Stdlib.Sqlite.execBatch db [("INSERT INTO t VALUES (@p0,@p1)", [["2", "bob"], ["1", "duplicate"]])] in (Stdlib.Result.isError batch, Stdlib.Sqlite.column db "SELECT name FROM t ORDER BY id" "name")) = (true, ["alice"])

(let db = "/tmp/dark-sqlite-types.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, n INTEGER, f REAL, b BLOB)" in let inserted = Stdlib.Sqlite.exec db "INSERT INTO t VALUES (-1,9223372036854775807,1.25,X'00FF')" in match Stdlib.Sqlite.query db "SELECT * FROM t" with | Ok [row] -> (inserted, Stdlib.Sqlite.intField row "n", match Stdlib.Dict.get row "f" with | Some v -> (match v with | Real f -> f == 1.25 | _ -> false) | None -> false, Stdlib.Sqlite.bytesField row "b" |> Stdlib.Option.map Stdlib.Blob.toHex) | _ -> (Error "query", None, false, None)) = (Ok 1, Some 9223372036854775807L, true, Some "00FF")

(let db = "/tmp/dark-sqlite-null.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT)" in let inserted = Stdlib.Sqlite.exec db "INSERT INTO t (name) VALUES (NULL)" in (inserted, Stdlib.Sqlite.scalarInt db "SELECT count(*) AS n FROM t WHERE name = NULL" "n", Stdlib.Sqlite.scalarInt db "SELECT count(*) AS n FROM t WHERE name IS NULL" "n", Stdlib.Sqlite.scalarInt db "SELECT id FROM t" "id")) = (Ok 1, Some 0L, Some 1L, Some 1L)

(let db = "/tmp/dark-sqlite-update.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT NOT NULL)" in let inserted = Stdlib.Sqlite.execBatch db [("INSERT INTO t VALUES (@p0,@p1)", [["1","a"],["2","b"],["3","c"]])] in let updated = Stdlib.Sqlite.execP db "UPDATE t SET name = @p0 WHERE id >= @p1 AND id < @p2" ["changed","2","3"] in let deleted = Stdlib.Sqlite.exec db "DELETE FROM t WHERE id = 3" in (inserted, updated, deleted, Stdlib.Sqlite.column db "SELECT name FROM t ORDER BY id DESC LIMIT 1" "name")) = (Ok [1,1,1], Ok 1, Ok 1, ["changed"])

(let db = "/tmp/dark-sqlite-ignore.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT NOT NULL)" in Stdlib.Sqlite.execBatch db [("INSERT OR IGNORE INTO t VALUES (@p0,@p1)", [["1","first"],["1","second"]])]) = Ok [1,0]

(let db = "/tmp/dark-sqlite-errors.db" in let _ = Stdlib.Cli.File.delete db in let _ = Stdlib.Sqlite.exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT)" in (Stdlib.Result.isError (Stdlib.Sqlite.query db "SELECT missing FROM t"), Stdlib.Result.isError (Stdlib.Sqlite.queryP db "SELECT id FROM t WHERE id=@p0" []), Stdlib.Result.isError (Stdlib.Sqlite.exec db "INSERT INTO t VALUES (1,'x'); DELETE FROM t"), Stdlib.Sqlite.scalarInt db "SELECT count(*) AS n FROM t" "n")) = (true,true,true,Some 0L)

(let db = "/tmp/dark-sqlite-ddl-rollback.db" in let _ = Stdlib.Cli.File.delete db in let result = Stdlib.Sqlite.execBatch db [("CREATE TABLE t (id INTEGER PRIMARY KEY)",[]),("INSERT INTO missing VALUES (1)",[])] in (Stdlib.Result.isError result, Stdlib.Result.isError (Stdlib.Sqlite.query db "SELECT * FROM t"))) = (true,true)

(let db = "/tmp/dark-sqlite-scalar.db" in let _ = Stdlib.Cli.File.delete db in Stdlib.Sqlite.query db "SELECT CAST('hi' AS BLOB) AS b, 1.5 AS f") |> Stdlib.Result.map (fun rows -> Stdlib.List.map rows (fun row -> Stdlib.Sqlite.bytesField row "b" |> Stdlib.Option.map Stdlib.Blob.toHex)) = Ok [Some "6869"]
