---NAME---
constructor_match_exhaustiveness_has_no_runtime_failure
---INPUT---
type ExhaustiveChoice = ExhaustiveChoiceFirst | ExhaustiveChoiceSecond of Int64 | ExhaustiveChoiceThird

type PartialChoice = FirstPartial | SecondPartial of Int64

let choose (value: ExhaustiveChoice) : Int64 =
    match value with
    | ExhaustiveChoiceFirst -> 1L
    | ExhaustiveChoiceSecond (n) -> n
    | ExhaustiveChoiceThird -> 3L

let choosePartial (value: PartialChoice) : Int64 =
    match value with
    | FirstPartial -> 1L
    | SecondPartial (n) -> n
---EXPECTED---
choose:
  StackSize: 0
  UsedCalleeSaved: []
  Label "choose_entry":
    v1 <- HeapLoad(v0, 0)
    BranchZero(v1, Label "choose_ssa_1", Label "choose_ssa_2")
  Label "choose_ssa_1":
    X0 <- Mov(Imm 1)
    Ret
  Label "choose_ssa_2":
    Cmp(v1, Imm 1)
    CondBranch(EQ, Label "choose_ssa_3", Label "choose_ssa_4")
  Label "choose_ssa_3":
    v6 <- HeapLoad(v0, 8)
    X0 <- Mov(Reg v6)
    Ret
  Label "choose_ssa_4":
    X0 <- Mov(Imm 3)
    Ret

choosePartial:
  StackSize: 0
  UsedCalleeSaved: []
  Label "choosePartial_entry":
    v11 <- HeapLoad(v10, 0)
    BranchZero(v11, Label "choosePartial_ssa_1", Label "choosePartial_ssa_2")
  Label "choosePartial_ssa_1":
    X0 <- Mov(Imm 1)
    Ret
  Label "choosePartial_ssa_2":
    v14 <- HeapLoad(v10, 8)
    X0 <- Mov(Reg v14)
    Ret

