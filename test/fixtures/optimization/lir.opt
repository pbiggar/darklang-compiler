---NAME---
retarget_dead_float_add_across_independent_move
---INPUT---
let sum (n: Int64) (acc: Float) : Float =
    if n == 0L then acc
    else sum (n - 1L) (acc + 1.5)
---EXPECTED---
sum:
  StackSize: 0
  UsedCalleeSaved: []
  Label "sum_body":
    v0 <- Phi([(Reg v4000, sum_entry), (Reg v3, sum_ssa_2)])
    fv1 <- FPhi([(fv4001, sum_entry), (fv4, sum_ssa_2)])
    BranchZero(v0, Label "sum_ssa_1", Label "sum_ssa_2")
  Label "sum_entry":
    fv4002 <- FLoad(float[1.5])
    Jump(Label "sum_body")
  Label "sum_ssa_1":
    D0 <- FMov(fv1)
    Ret
  Label "sum_ssa_2":
    v3 <- Sub(v0, Imm 1)
    fv4 <- FAdd(fv1, fv4002)
    Jump(Label "sum_body")

---NAME---
licm_hoist_loop_constant
---INPUT---
let collatzSteps (n: Int64) (steps: Int64) : Int64 =
    if n == 1L then steps
    else if n % 2L == 0L then collatzSteps (n / 2L) (steps + 1L)
    else collatzSteps (3L * n + 1L) (steps + 1L)
---EXPECTED---
collatzSteps:
  StackSize: 0
  UsedCalleeSaved: []
  Label "collatzSteps_body":
    v0 <- Phi([(Reg v4000, collatzSteps_entry), (Reg v5, collatzSteps_ssa_3), (Reg v9, collatzSteps_ssa_4)])
    v1 <- Phi([(Reg v4001, collatzSteps_entry), (Reg v6, collatzSteps_ssa_3), (Reg v10, collatzSteps_ssa_4)])
    Cmp(v0, Imm 1)
    CondBranch(EQ, Label "collatzSteps_ssa_1", Label "collatzSteps_ssa_2")
  Label "collatzSteps_entry":
    v4002 <- Mov(Imm 2)
    Jump(Label "collatzSteps_body")
  Label "collatzSteps_ssa_1":
    X0 <- Mov(Reg v1)
    Ret
  Label "collatzSteps_ssa_2":

    BranchBitZero(v0, #0, Label "collatzSteps_ssa_3", Label "collatzSteps_ssa_4")
  Label "collatzSteps_ssa_3":
    v5 <- Sdiv(v0, Reg v4002)
    v6 <- Add(v1, Imm 1)
    Jump(Label "collatzSteps_body")
  Label "collatzSteps_ssa_4":
    v4003 <- Lsl_imm(v0, #1)
    v8 <- Add(v0, Reg v4003)
    v9 <- Add(v8, Imm 1)
    v10 <- Add(v1, Imm 1)
    Jump(Label "collatzSteps_body")

