---NAME---
positive_constant_modulo_skips_dynamic_sign_checks
---INPUT---
let reduce (value: Int64) : Int64 =
    value % 10L
---EXPECTED---
reduce:
  StackSize: 0
  UsedCalleeSaved: []
  Label "reduce_entry":
    v4000 <- Mov(Imm 10)
    v4001 <- Sdiv(v0, Reg v4000)
    v1 <- Msub(v4001, v4000, v0)
    v4001 <- Asr_imm(v1, #63)
    v4001 <- And(v4000, v4001)
    v1 <- Add(v1, Reg v4001)
    X0 <- Mov(Reg v1)
    Ret

