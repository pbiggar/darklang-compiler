// LIR Optimization Tests
// Tests LIR peephole optimizations and loop-invariant code motion.

---NAME---
ownership_transfer_non_recursive_record
---INPUT---
type OwnedInnerRecord = { value: Int64 }
type OwnedOuterRecord = { inner: OwnedInnerRecord }

let makeOwnedInner (value: Int64) : OwnedInnerRecord =
    if value <= 0L then OwnedInnerRecord { value = 0L }
    else makeOwnedInner (value - 1L)

let wrapOwnedInner (value: Int64) : OwnedOuterRecord =
    OwnedOuterRecord { inner = makeOwnedInner (value) }

wrapOwnedInner (1L)
---EXPECTED---
_start:
  StackSize: 0
  UsedCalleeSaved: []
  Label "_start_body":
    SaveRegs([], [])
    ArgMoves(X0 <- Imm 1)
    v8 <- Call(wrapOwnedInner, [Imm 1])
    RestoreRegs([], [])
    v8 <- Mov(Reg X0)
    SaveRegs([], [])
    X19 <- Mov(Reg v8)
    PrintRecord(X19, OwnedOuterRecord, [(inner, TRecord ("OwnedInnerRecord", []))])
    RestoreRegs([], [])
    RefCountDec(X19, 8, generic)
    X0 <- Mov(Reg v8)
    Ret

makeOwnedInner:
  StackSize: 0
  UsedCalleeSaved: []
  Label "makeOwnedInner_body":
    v0 <- Phi([(Reg v4000, makeOwnedInner_entry), (Reg v3, makeOwnedInner_ssa_2)])
    Cmp(v0, Imm 0)
    CondBranch(LE, Label "makeOwnedInner_ssa_1", Label "makeOwnedInner_ssa_2")
  Label "makeOwnedInner_entry":

    Jump(Label "makeOwnedInner_body")
  Label "makeOwnedInner_ssa_1":
    v2 <- HeapAlloc(8)
    HeapStore(v2, 0, Imm 0)
    X0 <- Mov(Reg v2)
    Ret
  Label "makeOwnedInner_ssa_2":
    v3 <- Sub(v0, Imm 1)
    Jump(Label "makeOwnedInner_body")

wrapOwnedInner:
  StackSize: 0
  UsedCalleeSaved: []
  Label "wrapOwnedInner_entry":
    SaveRegs([], [])
    ArgMoves(X0 <- Reg v5)
    v6 <- Call(makeOwnedInner, [Reg v5])
    RestoreRegs([], [])
    v6 <- Mov(Reg X0)
    v7 <- HeapAlloc(8)
    HeapStore(v7, 0, Reg v6)
    X0 <- Mov(Reg v7)
    Ret

---NAME---
ownership_transfer_nested_record_suffix
---INPUT---
type TransferTree = TransferLeaf of Int64 | TransferNode of (TransferTree * TransferTree)
type TransferEnvelope = { pair: (TransferTree * TransferTree) }

let makeTransferChild (depth: Int64) : TransferTree =
    if depth <= 0L then TransferLeaf (1L)
    else makeTransferChild (depth - 1L)

let makeTransferEnvelope (depth: Int64) : TransferEnvelope =
    TransferEnvelope { pair = (makeTransferChild (depth), makeTransferChild (depth + 1L)) }
---EXPECTED---
makeTransferChild:
  StackSize: 0
  UsedCalleeSaved: []
  Label "makeTransferChild_body":
    v0 <- Phi([(Reg v4000, makeTransferChild_entry), (Reg v3, makeTransferChild_ssa_2)])
    Cmp(v0, Imm 0)
    CondBranch(LE, Label "makeTransferChild_ssa_1", Label "makeTransferChild_ssa_2")
  Label "makeTransferChild_entry":

    Jump(Label "makeTransferChild_body")
  Label "makeTransferChild_ssa_1":
    v2 <- HeapAlloc(16)
    HeapStore(v2, 0, Imm 0)
    HeapStore(v2, 8, Imm 1)
    X0 <- Mov(Reg v2)
    Ret
  Label "makeTransferChild_ssa_2":
    v3 <- Sub(v0, Imm 1)
    Jump(Label "makeTransferChild_body")

makeTransferEnvelope:
  StackSize: 0
  UsedCalleeSaved: []
  Label "makeTransferEnvelope_entry":
    SaveRegs([], [])
    ArgMoves(X0 <- Reg v5)
    v6 <- Call(makeTransferChild, [Reg v5])
    RestoreRegs([], [])
    v6 <- Mov(Reg X0)
    v7 <- Add(v5, Imm 1)
    SaveRegs([], [])
    ArgMoves(X0 <- Reg v7)
    v8 <- Call(makeTransferChild, [Reg v7])
    RestoreRegs([], [])
    v8 <- Mov(Reg X0)
    v9 <- HeapAlloc(16)
    HeapStore(v9, 0, Reg v6)
    HeapStore(v9, 8, Reg v8)
    v10 <- HeapAlloc(8)
    HeapStore(v10, 0, Reg v9)
    X0 <- Mov(Reg v10)
    Ret

---NAME---
ownership_transfer_duplicate_child_reuses_owned_edge
---INPUT---
type DuplicateTransferTree = DuplicateTransferLeaf of Int64 | DuplicateTransferNode of (DuplicateTransferTree * DuplicateTransferTree)

let makeDuplicateTransferChild (depth: Int64) : DuplicateTransferTree =
    if depth <= 0L then DuplicateTransferLeaf (1L)
    else makeDuplicateTransferChild (depth - 1L)

let makeDuplicateTransferPair (depth: Int64) : (DuplicateTransferTree * DuplicateTransferTree) =
    let child = makeDuplicateTransferChild (depth) in
    (child, child)
---EXPECTED---
makeDuplicateTransferChild:
  StackSize: 0
  UsedCalleeSaved: []
  Label "makeDuplicateTransferChild_body":
    v0 <- Phi([(Reg v4000, makeDuplicateTransferChild_entry), (Reg v3, makeDuplicateTransferChild_ssa_2)])
    Cmp(v0, Imm 0)
    CondBranch(LE, Label "makeDuplicateTransferChild_ssa_1", Label "makeDuplicateTransferChild_ssa_2")
  Label "makeDuplicateTransferChild_entry":

    Jump(Label "makeDuplicateTransferChild_body")
  Label "makeDuplicateTransferChild_ssa_1":
    v2 <- HeapAlloc(16)
    HeapStore(v2, 0, Imm 0)
    HeapStore(v2, 8, Imm 1)
    X0 <- Mov(Reg v2)
    Ret
  Label "makeDuplicateTransferChild_ssa_2":
    v3 <- Sub(v0, Imm 1)
    Jump(Label "makeDuplicateTransferChild_body")

makeDuplicateTransferPair:
  StackSize: 0
  UsedCalleeSaved: []
  Label "makeDuplicateTransferPair_entry":
    SaveRegs([], [])
    ArgMoves(X0 <- Reg v5)
    v6 <- Call(makeDuplicateTransferChild, [Reg v5])
    RestoreRegs([], [])
    v6 <- Mov(Reg X0)
    RefCountInc(v6, 16, generic)
    v8 <- HeapAlloc(16)
    HeapStore(v8, 0, Reg v6)
    HeapStore(v8, 8, Reg v6)
    X0 <- Mov(Reg v8)
    Ret

---NAME---
ownership_transfer_retains_cross_level_reuse
---INPUT---
type ReusedTransferTree = ReusedTransferLeaf of Int64 | ReusedTransferNode of (ReusedTransferTree * ReusedTransferTree)

let makeReusedTransferChild (depth: Int64) : ReusedTransferTree =
    if depth <= 0L then ReusedTransferLeaf (1L)
    else makeReusedTransferChild (depth - 1L)

let makeReusedTransferNested (depth: Int64) : ((ReusedTransferTree * Int64) * ReusedTransferTree) =
    let child = makeReusedTransferChild (depth) in
    let inner = (child, 1L) in
    (inner, child)
---EXPECTED---
makeReusedTransferChild:
  StackSize: 0
  UsedCalleeSaved: []
  Label "makeReusedTransferChild_body":
    v0 <- Phi([(Reg v4000, makeReusedTransferChild_entry), (Reg v3, makeReusedTransferChild_ssa_2)])
    Cmp(v0, Imm 0)
    CondBranch(LE, Label "makeReusedTransferChild_ssa_1", Label "makeReusedTransferChild_ssa_2")
  Label "makeReusedTransferChild_entry":

    Jump(Label "makeReusedTransferChild_body")
  Label "makeReusedTransferChild_ssa_1":
    v2 <- HeapAlloc(16)
    HeapStore(v2, 0, Imm 0)
    HeapStore(v2, 8, Imm 1)
    X0 <- Mov(Reg v2)
    Ret
  Label "makeReusedTransferChild_ssa_2":
    v3 <- Sub(v0, Imm 1)
    Jump(Label "makeReusedTransferChild_body")

makeReusedTransferNested:
  StackSize: 0
  UsedCalleeSaved: []
  Label "makeReusedTransferNested_entry":
    SaveRegs([], [])
    ArgMoves(X0 <- Reg v5)
    v6 <- Call(makeReusedTransferChild, [Reg v5])
    RestoreRegs([], [])
    v6 <- Mov(Reg X0)
    RefCountInc(v6, 16, generic)
    v8 <- HeapAlloc(16)
    HeapStore(v8, 0, Reg v6)
    HeapStore(v8, 8, Imm 1)
    v10 <- HeapAlloc(16)
    HeapStore(v10, 0, Reg v8)
    HeapStore(v10, 8, Reg v6)
    X0 <- Mov(Reg v10)
    Ret

---NAME---
counted_loop_unroll_by_two_generated_code
---INPUT---
let loop (i: Int64) (limit: Int64) (sum: Float) (sign: Float) : Float =
    if i >= limit then sum
    else loop (i + 1L) (limit) (sum + sign) (Stdlib.Float.negate (sign))
---EXPECTED---
loop:
  StackSize: 0
  UsedCalleeSaved: []
  Label "loop_body":
    v0 <- Phi([(Reg v4000, loop_entry), (Reg v4012, loop_ssa_2_unroll_second)])
    v1 <- Phi([(Reg v4001, loop_entry), (Reg v4013, loop_ssa_2_unroll_second)])
    fv2 <- FPhi([(fv4002, loop_entry), (fv4014, loop_ssa_2_unroll_second)])
    fv3 <- FPhi([(fv4003, loop_entry), (fv4015, loop_ssa_2_unroll_second)])
    Cmp(v0, Reg v1)
    CondBranch(GE, Label "loop_ssa_1", Label "loop_ssa_2")
  Label "loop_entry":

    Jump(Label "loop_body")
  Label "loop_ssa_1":
    D0 <- FMov(fv2)
    Ret
  Label "loop_ssa_1_unroll_remainder":
    D0 <- FMov(fv6)
    Ret
  Label "loop_ssa_2":
    v5 <- Add(v0, Imm 1)
    fv6 <- FAdd(fv2, fv3)
    fv7 <- FNeg(fv3)
    Cmp(v5, Reg v1)
    CondBranch(GE, Label "loop_ssa_1_unroll_remainder", Label "loop_ssa_2_unroll_second")
  Label "loop_ssa_2_unroll_second":
    v4009 <- Add(v5, Imm 1)
    fv4014 <- FAdd(fv6, fv7)
    fv4011 <- FNeg(fv7)
    v4012 <- Mov(Reg v4009)
    v4013 <- Mov(Reg v1)
    fv4015 <- FMov(fv4011)
    Jump(Label "loop_body")

