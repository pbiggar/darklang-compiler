    if condition then 3L else if condition then 99L else 2L
---EXPECTED---
Function repeatFalse:
  repeatFalse_entry:
    branch v0 ? repeatFalse_ssa_1 : repeatFalse_ssa_4
  repeatFalse_ssa_1:
    ret 3
  repeatFalse_ssa_4:
    ret 2

---NAME---
sccp_repeated_predicate_after_join
---INPUT---
let knownAfterJoin (condition: Bool) (choose: Bool) : Int64 =
    if condition then
        let value = if choose then 20L else 22L in
        if condition then value else 99L
    else 0L
---EXPECTED---
Function knownAfterJoin:
  knownAfterJoin_entry:
    branch v0 ? knownAfterJoin_ssa_1 : knownAfterJoin_ssa_2
  knownAfterJoin_L0:
    ret 20
  knownAfterJoin_L1:
    ret 22
  knownAfterJoin_ssa_1:
    branch v1 ? knownAfterJoin_L0 : knownAfterJoin_L1
  knownAfterJoin_ssa_2:
    ret 0

---NAME---
sccp_range_after_join
---INPUT---
let boundedAfterJoin (value: Int64) (choose: Bool) : Int64 =
    if value < 10L then
        let selected = if choose then 1L else 2L in
        if value >= 10L then 99L else selected
    else 3L
---EXPECTED---
Function boundedAfterJoin:
  boundedAfterJoin_entry:
    v2 <- v0 < 10 : TInt64
    branch v2 ? boundedAfterJoin_ssa_1 : boundedAfterJoin_ssa_2
  boundedAfterJoin_L0:
    ret 1
  boundedAfterJoin_L1:
    ret 2
  boundedAfterJoin_ssa_1:
    branch v1 ? boundedAfterJoin_L0 : boundedAfterJoin_L1
  boundedAfterJoin_ssa_2:
    ret 3

---NAME---
sccp_range_false_edge
---INPUT---
let rangeFalseEdge (value: Int64) : Int64 =
    if value < 10L then 1L
    else if value < 10L then 99L else 2L
---EXPECTED---
Function rangeFalseEdge:
  rangeFalseEdge_entry:
    v1 <- v0 < 10 : TInt64
    branch v1 ? rangeFalseEdge_ssa_1 : rangeFalseEdge_ssa_4
  rangeFalseEdge_ssa_1:
