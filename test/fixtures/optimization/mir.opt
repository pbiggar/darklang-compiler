  rangeFalseEdge_ssa_4:
    ret 2

---NAME---
sccp_unsigned_range_edge
---INPUT---
let unsignedBound (value: UInt8) : Int64 =
    if value < 10uy then
        if value >= 10uy then 99L else 1L
    else 2L
---EXPECTED---
Function unsignedBound:
  unsignedBound_entry:
    v1 <- v0 < 10 : TUInt8
    branch v1 ? unsignedBound_ssa_4 : unsignedBound_ssa_2
  unsignedBound_ssa_2:
    ret 2
  unsignedBound_ssa_4:
    ret 1

---NAME---
sccp_join_weakens_boolean_fact
---INPUT---
let preserveBoolean (condition: Bool) : Int64 =
    let selected = if condition then 20L else 22L in
    if condition then selected else selected + 1L
---EXPECTED---
Function preserveBoolean:
  preserveBoolean_entry:
    branch v0 ? preserveBoolean_L0 : preserveBoolean_L1
  preserveBoolean_L0:
    jump preserveBoolean_L2
  preserveBoolean_L1:
    jump preserveBoolean_L2
  preserveBoolean_L2:
    v1 <- Phi([(20, preserveBoolean_L0), (22, preserveBoolean_L1)]) : TInt64
    branch v0 ? preserveBoolean_ssa_1 : preserveBoolean_ssa_2
  preserveBoolean_ssa_1:
    ret v1
  preserveBoolean_ssa_2:
    v3 <- v1 + 1 : TInt64
    ret v3

---NAME---
sccp_join_weakens_range_fact
---INPUT---
let preserveRange (value: Int64) : Int64 =
    let selected = if value < 10L then 20L else 22L in
    if value < 10L then selected else selected + 1L
---EXPECTED---
Function preserveRange:
  preserveRange_entry:
    v1 <- v0 < 10 : TInt64
    branch v1 ? preserveRange_L0 : preserveRange_L1
  preserveRange_L0:
    jump preserveRange_L2
  preserveRange_L1:
    jump preserveRange_L2
  preserveRange_L2:
    v2 <- Phi([(20, preserveRange_L0), (22, preserveRange_L1)]) : TInt64
    branch v1 ? preserveRange_ssa_1 : preserveRange_ssa_2
  preserveRange_ssa_1:
    ret v2
  preserveRange_ssa_2:
    v5 <- v2 + 1 : TInt64
    ret v5

---NAME---
sccp_and_true_edge_facts
---INPUT---
let andTrueFacts (first: Bool) (second: Bool) (choose: Bool) : Int64 =
    if first && second then
        let selected = if choose then 1L else 2L in
        if first then if second then selected else 99L else 98L
    else 3L
---EXPECTED---
Function andTrueFacts:
  andTrueFacts_entry:
    v3 <- v0 && v1 : TBool
    branch v3 ? andTrueFacts_ssa_1 : andTrueFacts_ssa_2
  andTrueFacts_L0:
    ret 1
  andTrueFacts_L1:
    ret 2
  andTrueFacts_ssa_1:
    branch v2 ? andTrueFacts_L0 : andTrueFacts_L1
  andTrueFacts_ssa_2:
    ret 3

---NAME---
sccp_or_false_edge_facts
---INPUT---
let orFalseFacts (first: Bool) (second: Bool) (choose: Bool) : Int64 =
    if first || second then 3L
    else
        let selected = if choose then 1L else 2L in
        if first then 99L else if second then 98L else selected
---EXPECTED---
Function orFalseFacts:
  orFalseFacts_entry:
    v3 <- v0 || v1 : TBool
    branch v3 ? orFalseFacts_ssa_1 : orFalseFacts_ssa_2
  orFalseFacts_L0:
    ret 1
  orFalseFacts_L1:
    ret 2
  orFalseFacts_ssa_1:
    ret 3
  orFalseFacts_ssa_2:
    branch v2 ? orFalseFacts_L0 : orFalseFacts_L1

---NAME---
sccp_and_false_edge_known_operand
---INPUT---
let andFalseKnown (first: Bool) (second: Bool) : Int64 =
    if first then
        if first && second then 3L
        else if second then 99L else 1L
    else 2L
---EXPECTED---
Function andFalseKnown:
  andFalseKnown_entry:
    branch v0 ? andFalseKnown_ssa_1 : andFalseKnown_ssa_2
  andFalseKnown_ssa_1:
    v2 <- v0 && v1 : TBool
    branch v2 ? andFalseKnown_ssa_3 : andFalseKnown_ssa_6
  andFalseKnown_ssa_2:
    ret 2
  andFalseKnown_ssa_3:
    ret 3
  andFalseKnown_ssa_6:
    ret 1

---NAME---
sccp_or_true_edge_known_operand
---INPUT---
let orTrueKnown (first: Bool) (second: Bool) : Int64 =
    if first then 2L
    else if first || second then if second then 1L else 99L else 3L
---EXPECTED---
Function orTrueKnown:
  orTrueKnown_entry:
