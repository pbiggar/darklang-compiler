---NAME---
licm_hoist_tuple_load
---INPUT---
let loop (n: Int64) (acc: Int64) (t: (Int64 * Int64)) : Int64 =
    if n < 1L then acc
    else
        let (v, _) = t in
        loop (n - 1L) (acc + v) (t)
---EXPECTED---
Function loop:
  loop_entry:
    v5 <- HeapLoad(v4002, 0)
    jump loop_body
  loop_body:
    v0 <- Phi([(v4000, loop_entry), (v4003, loop_ssa_2)]) : TInt64
    v1 <- Phi([(v4001, loop_entry), (v4004, loop_ssa_2)]) : TInt64
    v3 <- v0 < 1 : TInt64
    branch v3 ? loop_ssa_1 : loop_ssa_2
  loop_ssa_1:
    ret v1
  loop_ssa_2:
    v10 <- v0 - 1 : TInt64
    v11 <- v1 + v5 : TInt64
    v4003 <- v10 : TInt64
    v4004 <- v11 : TInt64
    jump loop_body

---NAME---
derived_induction_affine_shift
---INPUT---
let loop (i: Int64) (n: Int64) (total: Int64) : Int64 =
    if i >= n then total
    else
        let odd = 2L * i + 1L in
        loop (i + 1L) (n) (total + odd)
---EXPECTED---
Function loop:
  loop_entry:
    v4006 <- v4000 << 1 : TInt64
    v4007 <- v4006 + 1 : TInt64
    jump loop_body
