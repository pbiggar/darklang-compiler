// MIR Optimization Tests
// Tests MIR optimizations such as loop-invariant code motion in SSA form.

---NAME---
counted_loop_unroll_by_two_mir
---INPUT---
let loop (i: Int64) (limit: Int64) (sum: Float) (sign: Float) : Float =
    if i >= limit then sum
    else loop (i + 1L) (limit) (sum + sign) (Stdlib.Float.negate (sign))
---EXPECTED---
Function loop:
  loop_entry:
    jump loop_body
  loop_body:
    v0 <- Phi([(v4000, loop_entry), (v4012, loop_ssa_2_unroll_second)]) : TInt64
    v1 <- Phi([(v4001, loop_entry), (v4013, loop_ssa_2_unroll_second)]) : TInt64
    v2 <- Phi([(v4002, loop_entry), (v4014, loop_ssa_2_unroll_second)]) : TFloat64
    v3 <- Phi([(v4003, loop_entry), (v4015, loop_ssa_2_unroll_second)]) : TFloat64
    v4 <- v0 >= v1 : TInt64
    branch v4 ? loop_ssa_1 : loop_ssa_2
  loop_ssa_1:
    ret v2
  loop_ssa_1_unroll_remainder:
    ret v6
  loop_ssa_2:
    v5 <- v0 + 1 : TInt64
    v6 <- v2 + v3 : TFloat64
    v7 <- FloatNeg(v3)
    v4008 <- v5 >= v1 : TInt64
    branch v4008 ? loop_ssa_1_unroll_remainder : loop_ssa_2_unroll_second
  loop_ssa_2_unroll_second:
    v4009 <- v5 + 1 : TInt64
    v4010 <- v6 + v7 : TFloat64
    v4011 <- FloatNeg(v7)
    v4012 <- v4009 : TInt64
    v4013 <- v1 : TInt64
    v4014 <- v4010 : TFloat64
    v4015 <- v4011 : TFloat64
    jump loop_body

---NAME---
tail_recursion_modulo_addition_forms_loop
---INPUT---
let fib (n: Int64) : Int64 =
    if n <= 1L then n else fib (n - 1L) + fib (n - 2L)
fib (10L)
---EXPECTED---
Function _start:
  _start_body:
    v7 <- Call(fib, [10])
    Print(v7, type=TInt64)
    ret v7

Function fib:
  fib_entry:
    TailCall(fib$trmo, [v0, 0])
    ret v2004

Function fib$trmo:
  fib$trmo_entry:
    jump fib$trmo_body
  fib$trmo_body:
    v0 <- Phi([(v4000, fib$trmo_entry), (v4, fib$trmo_ssa_2)]) : TInt64
    v2001 <- Phi([(v4001, fib$trmo_entry), (v2003, fib$trmo_ssa_2)]) : TInt64
    v1 <- v0 <= 1 : TInt64
    branch v1 ? fib$trmo_ssa_1 : fib$trmo_ssa_2
  fib$trmo_ssa_1:
    v2002 <- v2001 + v0 : TInt64
    ret v2002
  fib$trmo_ssa_2:
    v2 <- v0 - 1 : TInt64
    v3 <- Call(fib$trmo, [v2, 0])
    v4 <- v0 - 2 : TInt64
    v2003 <- v2001 + v3 : TInt64
    jump fib$trmo_body

---NAME---
tail_recursion_modulo_multiplication_forms_loop
---INPUT---
let factorial (n: Int64) : Int64 =
    if n <= 1L then 1L else n * factorial (n - 1L)
factorial (10L)
---EXPECTED---
Function _start:
  _start_body:
    v5 <- Call(factorial, [10])
    Print(v5, type=TInt64)
    ret v5

Function factorial:
  factorial_entry:
    TailCall(factorial$trmo, [v0, 1])
    ret v2004

Function factorial$trmo:
  factorial$trmo_entry:
    jump factorial$trmo_body
  factorial$trmo_body:
    v0 <- Phi([(v4000, factorial$trmo_entry), (v2, factorial$trmo_ssa_2)]) : TInt64
    v2001 <- Phi([(v4001, factorial$trmo_entry), (v2003, factorial$trmo_ssa_2)]) : TInt64
    v1 <- v0 <= 1 : TInt64
    branch v1 ? factorial$trmo_ssa_1 : factorial$trmo_ssa_2
  factorial$trmo_ssa_1:
    ret v2001
  factorial$trmo_ssa_2:
    v2 <- v0 - 1 : TInt64
    v2003 <- v2001 * v0 : TInt64
    jump factorial$trmo_body

---NAME---
licm_hoists_recursive_effect_free_scalar_call
---INPUT---
let factorial (n: Int64) : Int64 =
    if n <= 1L then 1L
    else n * factorial (n - 1L)

let repeat (n: Int64) (acc: Int64) : Int64 =
    if n <= 0L then acc
    else repeat (n - 1L) (factorial (20L))
---EXPECTED---
Function factorial:
  factorial_entry:
    TailCall(factorial$trmo, [v0, 1])
    ret v2004

Function factorial$trmo:
  factorial$trmo_entry:
    jump factorial$trmo_body
  factorial$trmo_body:
    v0 <- Phi([(v4000, factorial$trmo_entry), (v2, factorial$trmo_ssa_2)]) : TInt64
    v2001 <- Phi([(v4001, factorial$trmo_entry), (v2003, factorial$trmo_ssa_2)]) : TInt64
    v1 <- v0 <= 1 : TInt64
    branch v1 ? factorial$trmo_ssa_1 : factorial$trmo_ssa_2
  factorial$trmo_ssa_1:
    ret v2001
  factorial$trmo_ssa_2:
    v2 <- v0 - 1 : TInt64
    v2003 <- v2001 * v0 : TInt64
    jump factorial$trmo_body

Function repeat:
  repeat_entry:
    v9 <- Call(factorial, [20])
    jump repeat_body
  repeat_body:
    v5 <- Phi([(v4000, repeat_entry), (v8, repeat_ssa_2)]) : TInt64
    v6 <- Phi([(v4001, repeat_entry), (v9, repeat_ssa_2)]) : TInt64
    v7 <- v5 <= 0 : TInt64
    branch v7 ? repeat_ssa_1 : repeat_ssa_2
  repeat_ssa_1:
    ret v6
  repeat_ssa_2:
    v8 <- v5 - 1 : TInt64
    jump repeat_body

---NAME---
licm_hoists_mutually_recursive_effect_free_scalar_call
---INPUT---
let isEven (n: Int64) : Bool =
    if n <= 0L then true else isOdd (n - 1L)

let isOdd (n: Int64) : Bool =
    if n <= 0L then false else isEven (n - 1L)

let loop (n: Int64) (acc: Int64) : Int64 =
    if n <= 0L then acc
    else loop (n - 1L) (if isEven (20L) then acc + 1L else acc)
---EXPECTED---
Function isEven:
  isEven_entry:
    v1 <- v0 <= 0 : TInt64
    branch v1 ? isEven_ssa_1 : isEven_ssa_2
  isEven_ssa_1:
    ret true
  isEven_ssa_2:
    v2 <- v0 - 1 : TInt64
    TailCall(isOdd, [v2])
    ret v3

Function isOdd:
  isOdd_entry:
    v5 <- v4 <= 0 : TInt64
    branch v5 ? isOdd_ssa_1 : isOdd_ssa_2
  isOdd_ssa_1:
    ret false
  isOdd_ssa_2:
    v6 <- v4 - 1 : TInt64
    TailCall(isEven, [v6])
    ret v7

Function loop:
  loop_entry:
    v13 <- Call(isEven, [20])
    jump loop_body
  loop_body:
    v8 <- Phi([(v4002, loop_entry), (v11, loop_ssa_3), (v4004, loop_ssa_4)]) : TInt64
    v9 <- Phi([(v4003, loop_entry), (v14, loop_ssa_3), (v4005, loop_ssa_4)]) : TInt64
    v10 <- v8 <= 0 : TInt64
    branch v10 ? loop_ssa_1 : loop_ssa_2
  loop_ssa_1:
    ret v9
  loop_ssa_2:
    v11 <- v8 - 1 : TInt64
    branch v13 ? loop_ssa_3 : loop_ssa_4
  loop_ssa_3:
    v14 <- v9 + 1 : TInt64
    jump loop_body
  loop_ssa_4:
    v4004 <- v11 : TInt64
    v4005 <- v9 : TInt64
    jump loop_body

---NAME---
licm_keeps_effecting_recursive_call_in_loop
---INPUT---
let readRandom (n: Int64) : Int64 =
    if n <= 0L then Stdlib.Int.__randomInt64Word ()
    else readRandom (n - 1L)

let loop (n: Int64) (acc: Int64) : Int64 =
    if n <= 0L then acc
    else loop (n - 1L) (readRandom (1L))
---EXPECTED---
Function readRandom:
  readRandom_entry:
    jump readRandom_body
  readRandom_body:
    v0 <- Phi([(v4000, readRandom_entry), (v3, readRandom_ssa_2)]) : TInt64
    v1 <- v0 <= 0 : TInt64
    branch v1 ? readRandom_ssa_1 : readRandom_ssa_2
  readRandom_ssa_1:
    v2 <- RandomInt64()
    ret v2
  readRandom_ssa_2:
    v3 <- v0 - 1 : TInt64
    jump readRandom_body

Function loop:
  loop_entry:
    jump loop_body
  loop_body:
    v5 <- Phi([(v4000, loop_entry), (v8, loop_ssa_2)]) : TInt64
    v6 <- Phi([(v4001, loop_entry), (v9, loop_ssa_2)]) : TInt64
    v7 <- v5 <= 0 : TInt64
    branch v7 ? loop_ssa_1 : loop_ssa_2
  loop_ssa_1:
    ret v6
  loop_ssa_2:
    v8 <- v5 - 1 : TInt64
    v9 <- Call(readRandom, [1])
    jump loop_body

---NAME---
licm_keeps_side_effecting_call_in_loop
---INPUT---
let loop (n: Int64) (acc: Int64) : Int64 =
    if n < 1L then acc
    else
        let h = __hash<String> ("hello") in
        loop (n - 1L) (acc + h)
---EXPECTED---
Function loop:
  loop_entry:
    jump loop_body
  loop_body:
    v0 <- Phi([(v4000, loop_entry), (v5, loop_ssa_2)]) : TInt64
    v1 <- Phi([(v4001, loop_entry), (v6, loop_ssa_2)]) : TInt64
    v2 <- v0 < 1 : TInt64
    branch v2 ? loop_ssa_1 : loop_ssa_2
  loop_ssa_1:
    ret v1
  loop_ssa_2:
    v3 <- Call(__hash_str, [str[hello]])
    v5 <- v0 - 1 : TInt64
    v6 <- v1 + v3 : TInt64
    jump loop_body

---NAME---
licm_skip_constant_move
---INPUT---
let loop (n: Int64) : Int64 =
    if n < 1L then 0L
    else loop (1L)
---EXPECTED---
Function loop:
  loop_entry:
    jump loop_body
  loop_body:
    v0 <- Phi([(v4000, loop_entry), (1, loop_ssa_2)]) : TInt64
    v1 <- v0 < 1 : TInt64
    branch v1 ? loop_ssa_1 : loop_ssa_2
  loop_ssa_1:
    ret 0
  loop_ssa_2:
    jump loop_body

---NAME---
const_branch_elimination_bitand
---INPUT---
let pick (n: Int64) : Int64 =
    let masked = Stdlib.Int64.bitwiseAnd n 0L in
    if masked == 0L then 1L else 2L
---EXPECTED---
Function pick:
  pick_entry:
    ret 1

---NAME---
redundant_successor_branch_elimination
---INPUT---
let choose (cond: Bool) : Int64 =
    if cond then (if cond then 1L else 2L) else 3L
---EXPECTED---
Function choose:
  choose_entry:
    branch v0 ? choose_ssa_3 : choose_ssa_2
  choose_ssa_2:
    ret 3
  choose_ssa_3:
    ret 1

---NAME---
sccp_repeated_condition_on_false_edge
---INPUT---
