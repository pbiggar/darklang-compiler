// Executable single-block x64 LIR behavior.

---NAME---
Reject overflow physical register
---INPUT-LIR---
X24 <- Mov(Imm 1)
Ret
---EXPECT-CODEGEN-ERROR---
X24

---NAME---
Reject unsupported FileReadBlob path operand
---INPUT-LIR---
X0 <- FileReadBlob(Imm 0)
Ret
---EXPECT-CODEGEN-ERROR---
FileReadBlob path

---NAME---
MOV and exit
---INPUT-LIR---
X1 <- Mov(Imm 42)
Exit
Ret
---EXPECT-EXIT---
42

---NAME---
ADD immediate
---INPUT-LIR---
X1 <- Mov(Imm 40)
X1 <- Add(X1, Imm 2)
Exit
Ret
---EXPECT-EXIT---
42

---NAME---
SUB immediate
---INPUT-LIR---
X1 <- Mov(Imm 50)
X1 <- Sub(X1, Imm 8)
Exit
Ret
---EXPECT-EXIT---
42

---NAME---
MUL registers
---INPUT-LIR---
X1 <- Mov(Imm 6)
X2 <- Mov(Imm 7)
X1 <- Mul(X1, Reg X2)
Exit
Ret
---EXPECT-EXIT---
42

---NAME---
SDIV preserves a quotient allocated to X7
---INPUT-LIR---
X1 <- Mov(Imm 42)
X2 <- Mov(Imm 6)
X7 <- Sdiv(X1, Reg X2)
X1 <- Mov(Reg X7)
Exit
Ret
---EXPECT-EXIT---
7

---NAME---
Print positive Int64
---INPUT-LIR---
X0 <- Mov(Imm 42)
PrintInt64(X0)
Ret
---EXPECT-EXIT---
0
---EXPECT-STDOUT---
42

---NAME---
Print negative Int64
---INPUT-LIR---
X0 <- Mov(Imm -123)
PrintInt64(X0)
Ret
---EXPECT-EXIT---
0
---EXPECT-STDOUT---
-123

---NAME---
Print zero Int64
---INPUT-LIR---
X0 <- Mov(Imm 0)
PrintInt64(X0)
Ret
---EXPECT-EXIT---
0
---EXPECT-STDOUT---
0

---NAME---
Heap allocation initializes refcount
---INPUT-LIR---
X2 <- HeapAlloc(16)
X1 <- HeapLoad(X2, 16)
Exit
Ret
---EXPECT-EXIT---
1

---NAME---
Heap allocation increments leak counter
---INPUT-LIR---
X2 <- HeapAlloc(16)
X1 <- HeapLoad(X2, 0)
Ret
---LEAK-CHECK---
true
---EXPECT-STDERR---
leaks: 1

---NAME---
Generic RefCountInc increments refcount
---INPUT-LIR---
X2 <- HeapAlloc(16)
RefCountInc(X2, 16, generic)
X1 <- HeapLoad(X2, 16)
Exit
Ret
---EXPECT-EXIT---
2

---NAME---
Generic RefCountDec reclaims tuple2 block
---INPUT-LIR---
X2 <- HeapAlloc(16)
RefCountDec(X2, 16, generic)
Ret
---LEAK-CHECK---
true
---EXPECT-STDERR---

---NAME---
Generic RefCountDec handles fixed sizes
---INPUT-LIR---
X2 <- HeapAlloc(8)
RefCountDec(X2, 8, generic)
X3 <- HeapAlloc(24)
RefCountDec(X3, 24, generic)
Ret
---LEAK-CHECK---
true
---EXPECT-STDERR---

---NAME---
Dynamic string RefCountDec reclaims concat
---INPUT-LIR---
X2 <- StringConcat(str[a], str[b])
RefCountDecString(Reg X2)
Ret
---LEAK-CHECK---
true
---EXPECT-STDERR---

---NAME---
Materialized string literal RefCountDec skips release
---INPUT-LIR---
X2 <- Mov(str[literal])
RefCountDecString(Reg X2)
Ret
---LEAK-CHECK---
true
---EXPECT-STDERR---

---NAME---
Heap allocation reuses a block into X3
---INPUT-LIR---
X1 <- HeapAlloc(16)
RefCountDec(X1, 16, generic)
X3 <- HeapAlloc(16)
HeapStore(X3, 0, Imm 1)
HeapStore(X3, 8, Imm 2)
HeapStore(X3, 16, Imm 12852)
PrintHeapStringNoNewline(X3)
RefCountDecString(Reg X3)
Ret
---LEAK-CHECK---
true
---EXPECT-EXIT---
0
---EXPECT-STDOUT---
42
---EXPECT-STDERR---

---NAME---
Raw allocation reuse balances leak counter
---INPUT-LIR---
X1 <- Mov(Imm 8)
X2 <- RawAlloc(X1)
RawFree(X2)
X3 <- RawAlloc(X1)
RawFree(X3)
Ret
---LEAK-CHECK---
true
---EXPECT-EXIT---
0
---EXPECT-STDERR---

---NAME---
String refcount supports X3
---INPUT-LIR---
X3 <- HeapAlloc(16)
HeapStore(X3, 0, Imm 1)
HeapStore(X3, 8, Imm 2)
HeapStore(X3, 16, Imm 12852)
RefCountIncString(Reg X3)
RefCountDecString(Reg X3)
PrintHeapStringNoNewline(X3)
RefCountDecString(Reg X3)
Ret
---LEAK-CHECK---
true
---EXPECT-EXIT---
0
---EXPECT-STDOUT---
42
---EXPECT-STDERR---

---NAME---
String refcount supports X12
---INPUT-LIR---
X12 <- HeapAlloc(16)
HeapStore(X12, 0, Imm 1)
HeapStore(X12, 8, Imm 2)
HeapStore(X12, 16, Imm 12852)
RefCountIncString(Reg X12)
RefCountDecString(Reg X12)
PrintHeapStringNoNewline(X12)
RefCountDecString(Reg X12)
Ret
---LEAK-CHECK---
true
---EXPECT-EXIT---
0
---EXPECT-STDOUT---
42
---EXPECT-STDERR---

---NAME---
String literal supports X12 destination
---INPUT-LIR---
X12 <- Mov(str[hello])
PrintHeapStringNoNewline(X12)
Ret
---EXPECT-EXIT---
0
---EXPECT-STDOUT---
hello

---NAME---
String concat preserves X4 across literal right operand
---INPUT-LIR---
X4 <- StringConcat(str[\"], str[42])
X5 <- StringConcat(Reg X4, str[\"])
PrintHeapStringNoNewline(X5)
RefCountDecString(Reg X5)
RefCountDecString(Reg X4)
Ret
---LEAK-CHECK---
true
---EXPECT-EXIT---
0
---EXPECT-STDOUT---
"42"
---EXPECT-STDERR---

---NAME---
Full-width AND immediate preserves mask bits
---INPUT-LIR---
X1 <- Mov(Imm 4607182418800017408)
X0 <- AndImm(X1, 4503599627370495)
PrintUInt64(X0)
Ret
---EXPECT-STDOUT---
0
---EXPECT-STDERR---

---NAME---
Multiply-add and subtract support X11 destination
---INPUT-LIR---
X19 <- Mov(Imm 7)
X4 <- Mov(Imm 6)
X21 <- Mov(Imm 5)
X11 <- Madd(X19, X4, X21)
X0 <- Mov(Reg X11)
PrintInt64(X0)
X19 <- Mov(Imm 7)
X4 <- Mov(Imm 6)
X21 <- Mov(Imm 5)
X11 <- Msub(X19, X4, X21)
X0 <- Mov(Reg X11)
PrintInt64(X0)
Ret
---EXPECT-STDOUT---
47
-37
---EXPECT-STDERR---

---NAME---
RandomInt64 preserves syscall-clobbered X2
---INPUT-LIR---
X2 <- Mov(Imm 1)
X1 <- RandomInt64
X0 <- Mov(Reg X2)
PrintInt64(X0)
Ret
---EXPECT-STDOUT---
1
---EXPECT-STDERR---
