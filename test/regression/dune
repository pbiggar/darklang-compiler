; Native equivalence and allocation regression checks.
(rule
 (alias runtest)
 (deps ../../mutation/mutation-test.sh ../../mutation/ocaml_sites.py ../../scripts/test_mutation_workflow.py)
 (action (run python3 %{dep:../../scripts/test_mutation_workflow.py})))
(rule
 (alias runtest)
 (deps ../../scripts/install-darklang-interpreter.sh ../../scripts/test_install_interpreter.py)
 (action (run python3 %{dep:../../scripts/test_install_interpreter.py})))
(rule
 (alias runtest)
 (deps ../../differential-test ../../scripts/test_differential_testing_workflow.py)
 (action (run python3 %{dep:../../scripts/test_differential_testing_workflow.py})))
(rule
 (alias runtest)
 (deps differential_testing_regression.py)
 (action (run python3 %{dep:differential_testing_regression.py} %{exe:../../tools/differential-testing/main.exe})))
(rule
 (alias runtest)
 (deps standalone_compiler_regression.py)
 (action (run python3 %{dep:standalone_compiler_regression.py} %{exe:../../bin/dark.exe})))
(include_subdirs no)
(executables
 (names host_text_regression cache_regression component_regression literal_regression package_io_regression package_http_regression)
 (libraries dark_compiler tls-lwt x509)
 (flags (:standard -w @a -warn-error @a)))

(rule
 (alias runtest)
 (action
  (progn
   (run %{exe:package_io_regression.exe})
   (run %{exe:host_text_regression.exe})
   (run %{exe:literal_regression.exe})
   (run %{exe:cache_regression.exe})
   (run %{exe:component_regression.exe}))))

(rule
