#!/usr/bin/env bash
# mergetrain-status - Continuously refresh the local merge-train status.

set -euo pipefail

script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$script_root"
attempt_dir="/tmp/dark-compiler-mergetrain-codex-attempts"
interval_seconds=2
clear_screen=true
run_once=false
interactive_redraw=false
color_mode=auto
show_conflicts=false
interactive_input=false
show_more_merges=false
benchmark_page=0
benchmark_detail_index=""
show_benchmark_diff=false
show_help=false
help_return_scroll_offset=0
attention_job_id=""
attention_task=""
attention_position=""
attention_policy_changed=false
review_kind=""
retry_pending=false
action_message=""
scroll_offset=0
refresh_status=true
fetch_status=true
refresh_running=false
refresh_pid=""
refresh_serial=0
refresh_dir=""
redraw=true
next_refresh=0
status_output="Loading merge-train status…"
status_json=""
screen_lines=()
attention_ids=()
approval_ids=()
review_ids=()

usage() {
  cat <<EOF
Usage: ./mergetrain-status [OPTIONS]

Continuously display merge-train health, active jobs, recent integration
merges with recorded test runtimes, and benchmark results in pages of nine.
Interactive terminals keep accepting keys while pages refresh.
Use 1-9 for details, 0 for the next benchmark page, b for the previous page,
and w to review a requested gate exception. Press ? for keyboard help.

Options:
  --repo PATH          Repository whose merge-train status is displayed.
                       Default: $repo_root
  --attempt-dir PATH   Integrator evidence directory.
                       Default: $attempt_dir
  --interval SECONDS   Delay between status refreshes.
                       Default: $interval_seconds
  --benchmark-page N   Start at benchmark page N (zero-based).
  --color WHEN         Colorize output: auto, always, or never.
                       Default: $color_mode
  --no-color           Equivalent to --color never.
  --no-clear           Append each refresh instead of redrawing in place.
  --show-conflicts     Show complete conflict reasons instead of summaries.
  --attention-job ID   Open one attention job's evidence immediately.
  --once               Display one status snapshot, then exit.
  -h, --help           Show this help and exit.

Example:
  ./mergetrain-status --interval 5
EOF
}

keyboard_help() {
  cat <<'EOF'
Keyboard shortcuts

Navigation
  j / Down       Scroll down
  k / Up         Scroll up
  PgDn / PgUp    Scroll one page
  g / Home       Go to top
  G / End        Go to bottom
  ?              Show or close this help
  q / Esc        Back, or quit from status

Status
  a              Open attention jobs
  v              Open queued manual approvals
  w              Review a requested gate waiver
  m              Show more or fewer recent merges
  c              Show or hide full conflict details
  1-9            Open benchmark result
  0 / b          Next / previous benchmark page

Job review
  n / p          Next / previous job
  r              Retry an attention job (asks first)
  A              Review and approve a policy change

Benchmark result
  d              Toggle report and source diff
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo)
      repo_root="$2"
      shift 2
      ;;
    --attempt-dir)
      attempt_dir="$2"
      shift 2
      ;;
    --interval)
      interval_seconds="$2"
      shift 2
      ;;
    --benchmark-page)
      benchmark_page="$2"
      shift 2
      ;;
    --color)
      color_mode="$2"
      shift 2
      ;;
    --color=*)
      color_mode="${1#*=}"
      shift
      ;;
    --no-color)
      color_mode=never
      shift
      ;;
    --no-clear)
      clear_screen=false
      shift
      ;;
    --show-conflicts)
      show_conflicts=true
      shift
      ;;
    --attention-job)
      attention_job_id="$2"
      shift 2
      ;;
    --once)
      run_once=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

if [[ ! "$interval_seconds" =~ ^[1-9][0-9]*$ ]]; then
  echo "--interval must be a positive integer" >&2
  exit 2
fi
if [[ ! "$benchmark_page" =~ ^(0|[1-9][0-9]*)$ ]]; then
  echo "--benchmark-page must be a nonnegative integer" >&2
  exit 2
fi
if [[ "$color_mode" != auto && "$color_mode" != always && "$color_mode" != never ]]; then
  echo "--color must be auto, always, or never" >&2
  exit 2
fi
if [[ -n "$attention_job_id" && ! "$attention_job_id" =~ ^[1-9][0-9]*$ ]]; then
  echo "--attention-job must be a positive job ID" >&2
  exit 2
fi
for required_command in git mergetrain python3; do
  if ! command -v "$required_command" >/dev/null 2>&1; then
    echo "Required command not found: $required_command" >&2
    exit 1
  fi
done

repo_root="$(cd "$repo_root" && pwd -P)"
fifo_ledger="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir)/mergetrain-fifo.json"
refresh_dir="$(mktemp -d "${TMPDIR:-/tmp}/mergetrain-status.XXXXXXXX")"
cleanup() {
  if [[ -n "$refresh_pid" ]]; then
    kill "$refresh_pid" 2>/dev/null || true
  fi
  rm -rf -- "$refresh_dir"
  if [[ "$interactive_redraw" == true ]]; then
    printf '\033[?25h\n'
  fi
}
trap cleanup EXIT
if [[ "$color_mode" == auto ]]; then
  if [[ -t 1 ]]; then
    color_mode=always
  else
    color_mode=never
  fi
fi
if [[ "$clear_screen" == true && -t 1 ]]; then
  interactive_redraw=true
  printf '\033[?25l'
fi
if [[ "$interactive_redraw" == true && -t 0 ]]; then
  interactive_input=true
fi

while true; do
  if [[ "$refresh_running" == true && -e "$refresh_dir/$refresh_serial.done" ]]; then
    wait "$refresh_pid" || true
    refresh_pid=""
    refresh_running=false
    next_refresh=$((SECONDS + interval_seconds))
    if [[ -e "$refresh_dir/$refresh_serial.ok" ]]; then
      status_json="$(cat "$refresh_dir/$refresh_serial.json")"
    else
      status_json=""
    fi
    if [[ "$refresh_status" == false ]]; then
      if [[ -e "$refresh_dir/$refresh_serial.ok" ]]; then
        status_output="$(cat "$refresh_dir/$refresh_serial.output")"
        mapfile -t attention_ids < <(python3 -c '
import json, pathlib, sys
ledger = pathlib.Path(sys.argv[1])
try:
    deferred = {int(job["native_id"]) for job in json.loads(ledger.read_text()).get("pending", [])}
except (OSError, ValueError, KeyError, TypeError):
    deferred = set()
for job in json.load(sys.stdin).get("attention_jobs", []):
    if isinstance(job.get("id"), int) and job["id"] not in deferred:
        print(job["id"])
' "$fifo_ledger" <<<"$status_json")
        mapfile -t approval_ids < "$refresh_dir/$refresh_serial.approvals"
        review_ids=("${attention_ids[@]}" "${approval_ids[@]}")
        attention_task=""
        attention_position=""
        attention_policy_changed=false
        review_kind=""
        if [[ -n "$attention_job_id" ]]; then
          mapfile -t selected_attention < <(python3 -c '
import json, sys
payload = json.load(sys.stdin)
approvals = {int(value) for value in sys.argv[2].split()}
review = {int(value) for value in sys.argv[3].split()}
jobs = payload.get("attention_jobs", []) + [
    job for job in payload.get("recent_jobs", []) if job.get("id") in approvals
]
jobs = [job for job in jobs if job.get("id") in review]
for position, job in enumerate(jobs, start=1):
    if job.get("id") == int(sys.argv[1]):
        print(position)
        print(str(job.get("task") or "(unknown task)").replace("\n", " "))
        print("true" if job.get("id") in approvals or str(job.get("reason") or "").startswith("approval_execution_policy_changed:") else "false")
        print("approval" if job.get("id") in approvals else "attention")
        break
' "$attention_job_id" "${approval_ids[*]}" "${review_ids[*]}" <<<"$status_json")
          attention_position="${selected_attention[0]:-?}"
          attention_task="${selected_attention[1]:-(unknown task)}"
          attention_policy_changed="${selected_attention[2]:-false}"
          review_kind="${selected_attention[3]:-attention}"
        fi
      else
        status_output="Status refresh failed; retrying in $interval_seconds second(s)"
        attention_ids=()
        approval_ids=()
        review_ids=()
        review_kind="attention"
        attention_position="?"
        attention_task="(status unavailable)"
      fi
      if [[ -n "$action_message" ]]; then
        status_output="$action_message"$'\n\n'"$status_output"
        action_message=""
      fi
      redraw=true
    fi
  fi
  if [[ "$refresh_status" == true && "$refresh_running" == false ]]; then
    terminal_columns="${COLUMNS:-}"
    if [[ ! "$terminal_columns" =~ ^[1-9][0-9]*$ ]]; then
      terminal_columns="$(tput cols 2>/dev/null || true)"
    fi
    if [[ ! "$terminal_columns" =~ ^[1-9][0-9]*$ ]]; then
      terminal_columns=80
    fi
    renderer_args=(--repo "$repo_root" --attempt-dir "$attempt_dir" \
      --columns "$terminal_columns" --benchmark-page "$benchmark_page")
    if [[ "$interactive_redraw" == true ]]; then
      renderer_args+=(--wrap)
    fi
    if [[ "$show_more_merges" == true ]]; then
      renderer_args+=(--merge-limit 20)
    fi
    if [[ -n "$benchmark_detail_index" ]]; then
      if [[ "$show_benchmark_diff" == true ]]; then
        renderer_args+=(--benchmark-diff-index "$benchmark_detail_index")
      else
        renderer_args+=(--benchmark-detail-index "$benchmark_detail_index")
      fi
    fi
    if [[ "$color_mode" == always ]]; then
      renderer_args+=(--color)
    fi
    if [[ "$show_conflicts" == true ]]; then
      renderer_args+=(--show-conflicts)
    fi
    if [[ -n "$attention_job_id" ]]; then
      renderer_args+=(--attention-job-id "$attention_job_id")
    fi
    refresh_serial=$((refresh_serial + 1))
    cached_status_json="$status_json"
    should_fetch_status="$fetch_status"
    (
      if { if [[ "$should_fetch_status" == true || -z "$cached_status_json" ]]; then
             mergetrain --repo "$repo_root" status --json --limit 1000
           else
             printf '%s\n' "$cached_status_json"
           fi; } > "$refresh_dir/$refresh_serial.json" &&
         python3 "$script_root/scripts/render_mergetrain_status.py" "${renderer_args[@]}" \
           < "$refresh_dir/$refresh_serial.json" > "$refresh_dir/$refresh_serial.output" &&
         python3 -c '
import json, subprocess, sys
repo = sys.argv[1]
for summary in json.load(sys.stdin).get("recent_jobs", []):
    if summary.get("state") not in {"waiting", "ready"} or not isinstance(summary.get("id"), int):
        continue
    completed = subprocess.run(
        ["mergetrain", "--repo", repo, "inspect", str(summary["id"]), "--json"],
        capture_output=True, text=True, check=False,
    )
    if completed.returncode != 0:
        continue
    try:
        details = json.loads(completed.stdout)
    except json.JSONDecodeError:
        continue
    job = details.get("job") or {}
    outcome = details.get("outcome") or {}
    if job.get("auto_deploy") is False and str(outcome.get("message") or "").startswith("approval_execution_policy_changed:"):
        print(summary["id"])
' "$repo_root" < "$refresh_dir/$refresh_serial.json" > "$refresh_dir/$refresh_serial.approvals"; then
        : > "$refresh_dir/$refresh_serial.ok"
      fi
      : > "$refresh_dir/$refresh_serial.done"
    ) &
    refresh_pid=$!
    refresh_running=true
    refresh_status=false
    fetch_status=false
    next_refresh=$((SECONDS + interval_seconds))
    redraw=true
  fi
  if [[ "$interactive_redraw" == true && "$redraw" == true ]]; then
    terminal_lines="${LINES:-}"
    if [[ ! "$terminal_lines" =~ ^[1-9][0-9]*$ ]]; then
      terminal_lines="$(tput lines 2>/dev/null || true)"
    fi
    if [[ ! "$terminal_lines" =~ ^[1-9][0-9]*$ ]]; then
      terminal_lines=24
    fi
    if ((terminal_lines < 4)); then
      terminal_lines=4
    fi
    viewport_lines=$((terminal_lines - 3))
    if ((viewport_lines < 1)); then
      viewport_lines=1
    fi
    scroll_step=$((viewport_lines / 3))
    if ((scroll_step < 3)); then
      scroll_step=3
    fi
    display_output="$status_output"
    if [[ "$show_help" == true ]]; then
      display_output="$(keyboard_help)"
    fi
    output_lines="$(printf '%s\n' "$display_output" | awk 'END { print NR }')"
    max_scroll=$((output_lines - viewport_lines))
    if ((max_scroll < 0)); then
      max_scroll=0
    fi
    if ((scroll_offset > max_scroll)); then
      scroll_offset=$max_scroll
    fi
    first_line=$((scroll_offset + 1))
    last_line=$((scroll_offset + viewport_lines))
    visible_output="$(printf '%s\n' "$display_output" | sed -n "${first_line},${last_line}p")"
    other_controls=""
    if [[ "$show_help" == true ]]; then
      controls="[j/k] scroll [PgUp/Dn] page [?/q/Esc] back"
      other_controls="Keyboard help"
    elif [[ "$retry_pending" == true ]]; then
      controls="Retry #$attention_job_id? Approval may become manual. [y] confirm  [n/Esc] cancel"
    elif [[ -n "$attention_job_id" ]]; then
      if [[ "$refresh_running" == true || "$refresh_status" == true ]]; then
        controls="Loading review…  [q/Esc] back"
      elif [[ "$review_kind" == approval ]]; then
        controls="[j/k] scroll [n/p] next/prev [A] approve & deploy [q/Esc] back"
      elif [[ "$attention_policy_changed" == true ]]; then
        controls="[j/k] scroll [n/p] next/prev [A] approve & deploy [r] retry [q/Esc] back"
      else
        controls="[j/k] scroll [n/p] next/prev [r] retry [q/Esc] back"
      fi
    elif [[ -n "$benchmark_detail_index" ]]; then
      if [[ "$show_benchmark_diff" == true ]]; then
        controls="[j/k] scroll [PgUp/Dn] page [d] report [q/Esc] back"
      else
        controls="[j/k] scroll [PgUp/Dn] page [d] diff [q/Esc] back"
      fi
    else
      controls="[j/k] scroll [PgUp/Dn] page [1-9] detail [0] next [b] prev [?] help"
      if [[ "$show_more_merges" == true ]]; then
        other_controls="[a] jobs [v] review [w] waiver [m] fewer [c] conflicts [q] quit | benchmarks p$((benchmark_page + 1))"
      else
        other_controls="[a] jobs [v] review [w] waiver [m] more [c] conflicts [q] quit | benchmarks p$((benchmark_page + 1))"
      fi
    fi
    if [[ "$show_help" == false && -n "$attention_job_id" ]]; then
      if [[ "$refresh_running" == true || "$refresh_status" == true ]]; then
        identity="Review #$attention_job_id loading…"
      else
        identity="${review_kind^^} ${attention_position:-?}/${#review_ids[@]}  #$attention_job_id ${attention_task:0:36}"
      fi
      other_controls="$identity"
    fi
    progress=""
    if [[ "$refresh_running" == true || "$refresh_status" == true ]]; then
      progress="refreshing…"
    fi
    footer_width=$((terminal_columns - 1))
    mapfile -t visible_lines < <(printf '%s\n' "${visible_output:-Loading merge-train status…}")
    visible_lines[viewport_lines]="${controls:0:footer_width}"
    visible_lines[viewport_lines + 1]="${other_controls:0:footer_width}"
    visible_lines[viewport_lines + 2]="${progress:0:footer_width}"
    if ((${#screen_lines[@]} == 0)); then
      printf '\033[H\033[2J'
    fi
    for ((row = 0; row < terminal_lines; row++)); do
      current_line="${visible_lines[row]:-}"
      if [[ "${screen_lines[row]:-}" != "$current_line" ]]; then
        printf '\033[%d;1H\033[2K%s' "$((row + 1))" "$current_line"
      fi
      screen_lines[row]="$current_line"
    done
    redraw=false
  elif [[ "$interactive_redraw" == false && "$refresh_running" == false ]]; then
    printf '%s\n' "$status_output"
  fi

  if [[ "$run_once" == true && "$refresh_running" == false ]]; then
    exit 0
  fi
  if [[ "$interactive_input" == true ]]; then
    pressed_key=""
    if read -rsn1 -t 0.1 pressed_key; then
      redraw=true
      if [[ "$pressed_key" == $'\033' ]]; then
        escape_suffix=""
        read -rsn2 -t 0.02 escape_suffix || true
        if [[ "$escape_suffix" == "[5" || "$escape_suffix" == "[6" ]]; then
          escape_terminator=""
          read -rsn1 -t 0.02 escape_terminator || true
          escape_suffix+="$escape_terminator"
        fi
        pressed_key+="$escape_suffix"
      fi
      if [[ "$retry_pending" == true && "$pressed_key" != y &&
            "$pressed_key" != n && "$pressed_key" != $'\033' ]]; then
        continue
      fi
      if [[ "$show_help" == true ]]; then
        case "$pressed_key" in
          \?|q|$'\033'|j|k|g|G|$'\033[A'|$'\033[B'|$'\033[5~'|$'\033[6~'|$'\033[H'|$'\033[F') ;;
          *) continue ;;
        esac
      fi
      case "$pressed_key" in
        \?)
          if [[ "$show_help" == true ]]; then
            show_help=false
            scroll_offset=$help_return_scroll_offset
          else
            show_help=true
            help_return_scroll_offset=$scroll_offset
            scroll_offset=0
          fi
          ;;
        y)
          if [[ "$retry_pending" == true ]]; then
            retry_pending=false
            if retry_result="$(python3 "$script_root/scripts/mergetrain_fifo.py" \
                --repo "$repo_root" retry "$attention_job_id" 2>&1)"; then
              action_message="$retry_result"
              attention_job_id=""
            else
              action_message="Retry failed: $retry_result"
            fi
            scroll_offset=0
            refresh_status=true
            fetch_status=true
          fi
          ;;
        n)
          if [[ "$retry_pending" == true ]]; then
            retry_pending=false
          elif [[ -n "$attention_job_id" && ${#review_ids[@]} -gt 0 ]]; then
            for index in "${!review_ids[@]}"; do
              if [[ "${review_ids[$index]}" == "$attention_job_id" ]]; then
                attention_job_id="${review_ids[$(((index + 1) % ${#review_ids[@]}))]}"
                break
              fi
            done
            scroll_offset=0
            refresh_status=true
          fi
          ;;
        p)
          if [[ -n "$attention_job_id" && ${#review_ids[@]} -gt 0 ]]; then
            for index in "${!review_ids[@]}"; do
              if [[ "${review_ids[$index]}" == "$attention_job_id" ]]; then
                attention_job_id="${review_ids[$(((index - 1 + ${#review_ids[@]}) % ${#review_ids[@]}))]}"
                break
              fi
            done
            scroll_offset=0
            refresh_status=true
          fi
          ;;
        a)
          if [[ -n "$attention_job_id" ]]; then
            attention_job_id=""
          elif [[ ${#attention_ids[@]} -gt 0 ]]; then
            attention_job_id="${attention_ids[0]}"
          fi
          scroll_offset=0
          refresh_status=true
          ;;
        v)
          if [[ ${#approval_ids[@]} -gt 0 ]]; then
            attention_job_id="${approval_ids[0]}"
            scroll_offset=0
            refresh_status=true
          fi
          ;;
        r)
          if [[ -n "$attention_job_id" && "$review_kind" == attention &&
                "$refresh_running" == false && "$refresh_status" == false ]]; then
            retry_pending=true
          fi
          ;;
        A)
          if [[ -n "$attention_job_id" && "$attention_policy_changed" == true &&
                "$refresh_running" == false && "$refresh_status" == false ]]; then
            printf '\033[H\033[J'
            if python3 "$script_root/scripts/approve_attention_job.py" \
              --repo "$repo_root" --job-id "$attention_job_id"; then
              action_message="Approval flow finished; inspect the current train state."
            else
              action_message="Approval stopped; inspect the current train state."
            fi
            printf '\nPress any key to return to merge-train status...'
            read -rsn1 || true
            attention_job_id=""
            scroll_offset=0
            refresh_status=true
          fi
          ;;
        $'\033[A'|k)
          if ((scroll_offset > scroll_step)); then
            scroll_offset=$((scroll_offset - scroll_step))
          else
            scroll_offset=0
          fi
          ;;
        $'\033[B'|j)
          scroll_offset=$((scroll_offset + scroll_step))
          ;;
        $'\033[5~')
          if ((scroll_offset > viewport_lines)); then
            scroll_offset=$((scroll_offset - viewport_lines))
          else
            scroll_offset=0
          fi
          ;;
        $'\033[6~')
          scroll_offset=$((scroll_offset + viewport_lines))
          ;;
        $'\033[H'|g)
          scroll_offset=0
          ;;
        $'\033[F'|G)
          scroll_offset=$output_lines
          ;;
        m)
          if [[ -z "$benchmark_detail_index" ]]; then
            if [[ "$show_more_merges" == true ]]; then
              show_more_merges=false
            else
              show_more_merges=true
            fi
            scroll_offset=0
            refresh_status=true
          fi
          ;;
        c)
          if [[ -z "$benchmark_detail_index" ]]; then
            if [[ "$show_conflicts" == true ]]; then
              show_conflicts=false
            else
              show_conflicts=true
            fi
            refresh_status=true
          fi
          ;;
        w)
          if [[ -z "$benchmark_detail_index" ]]; then
            printf '\033[?25h\033[H\033[J'
            if ! python3 "$script_root/scripts/mergetrain_exception.py" \
              --repo "$repo_root" review; then
              printf '\nApproval was not completed.\n'
            fi
            read -r -p 'Press Enter to return to status...' _ || true
            printf '\033[?25l'
            scroll_offset=0
            refresh_status=true
          fi
          ;;
        d)
          if [[ -n "$benchmark_detail_index" ]]; then
            if [[ "$show_benchmark_diff" == true ]]; then
              show_benchmark_diff=false
            else
              show_benchmark_diff=true
            fi
            scroll_offset=0
            refresh_status=true
          fi
          ;;
        [1-9])
          if [[ -z "$benchmark_detail_index" ]]; then
            benchmark_detail_index="$pressed_key"
            show_benchmark_diff=false
            scroll_offset=0
            refresh_status=true
          fi
          ;;
        0)
          if [[ -z "$benchmark_detail_index" ]]; then
            benchmark_count="$(git -C "$repo_root" rev-list --count HEAD -- benchmarks/RESULTS.md)"
            if (((benchmark_page + 1) * 9 < benchmark_count)); then
              benchmark_page=$((benchmark_page + 1))
            else
              benchmark_page=0
            fi
            scroll_offset=0
            refresh_status=true
          fi
          ;;
        b)
          if [[ -z "$benchmark_detail_index" && "$benchmark_page" -gt 0 ]]; then
            benchmark_page=$((benchmark_page - 1))
            scroll_offset=0
            refresh_status=true
          fi
          ;;
        q|$'\033')
          if [[ "$show_help" == true ]]; then
            show_help=false
            scroll_offset=$help_return_scroll_offset
          elif [[ "$retry_pending" == true ]]; then
            retry_pending=false
          elif [[ -n "$attention_job_id" ]]; then
            attention_job_id=""
            scroll_offset=0
            refresh_status=true
          elif [[ -n "$benchmark_detail_index" ]]; then
            benchmark_detail_index=""
            show_benchmark_diff=false
            scroll_offset=0
            refresh_status=true
          else
            exit 0
          fi
          ;;
      esac
      if [[ "$refresh_status" == true ]]; then
        status_output="Loading view…"
        scroll_offset=0
      fi
    else
      if [[ "$refresh_running" == false ]] && ((SECONDS >= next_refresh)); then
        refresh_status=true
        fetch_status=true
        next_refresh=$((SECONDS + interval_seconds))
      fi
    fi
  else
    if [[ "$refresh_running" == true ]]; then
      sleep 0.1
    else
      sleep "$interval_seconds"
      refresh_status=true
      fetch_status=true
    fi
  fi
done
