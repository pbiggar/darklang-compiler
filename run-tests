#!/bin/bash
# run-tests - Build and execute the F# Dark compiler test suite.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

. "$SCRIPT_DIR/scripts/test-common.sh"

BUILD_ONLY=false
QUIET_BUILD=false
AI_BUILD=false
TEST_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --build-only)
            BUILD_ONLY=true
            shift
            ;;
        --quiet)
            QUIET_BUILD=true
            TEST_ARGS+=("$1")
            shift
            ;;
        --ai)
            AI_BUILD=true
            TEST_ARGS+=("$1")
            shift
            ;;
        *)
            TEST_ARGS+=("$1")
            shift
            ;;
    esac
done

if [ "$AI_BUILD" = true ]; then
    echo "building"
    BUILD_OUTPUT="$(mktemp)"
    if ! build_tests "$SCRIPT_DIR" "$SCRIPT_DIR/NuGet.Config" > "$BUILD_OUTPUT" 2>&1; then
        echo "build failed"
        cat "$BUILD_OUTPUT"
        rm -f "$BUILD_OUTPUT"
        exit 1
    fi
    rm -f "$BUILD_OUTPUT"
    echo "build complete"
elif [ "$QUIET_BUILD" = true ]; then
    if ! build_tests "$SCRIPT_DIR" "$SCRIPT_DIR/NuGet.Config" > /dev/null 2>&1; then
        echo "build failed"
        exit 1
    fi
else
    build_tests "$SCRIPT_DIR" "$SCRIPT_DIR/NuGet.Config"
fi

if [ "$BUILD_ONLY" = true ]; then
    if [ "$QUIET_BUILD" != true ]; then
        echo "Build-only mode, skipping tests."
    fi
    exit 0
fi

TEST_EXE="$(find_test_exe "$SCRIPT_DIR" "Try running the build first.")"
exec "$TEST_EXE" "${TEST_ARGS[@]}"
