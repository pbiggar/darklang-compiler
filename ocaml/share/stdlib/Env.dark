// Env.dark - upstream-compatible process environment access.

module Stdlib.Env

let __findEquals (entry: String) (offset: Int64) : Int64 =
    if offset >= Stdlib.String.__byteLength entry then -1L
    else if Stdlib.String.__byteAtUnchecked entry offset == 61L then offset
    else Stdlib.Env.__findEquals entry (offset + 1L)

let __addEntry (entry: String) (result: Dict<String, String>) : Dict<String, String> =
    let equals = Stdlib.Env.__findEquals entry 0L in
    if equals < 0L then result
    else
        let name = Stdlib.String.__byteSlice entry 0L equals in
        let value = Stdlib.String.__byteSlice entry (equals + 1L) (Stdlib.String.__byteLength entry) in
        Stdlib.Dict.setOverridingDuplicates result name value

let __decodePackedFrom (packed: String) (offset: Int64) (start: Int64) (result: Dict<String, String>) : Dict<String, String> =
    if offset >= Stdlib.String.__byteLength packed then result
    else if Stdlib.String.__byteAtUnchecked packed offset == 0L then
        let entry = Stdlib.String.__byteSlice packed start offset in
        Stdlib.Env.__decodePackedFrom packed (offset + 1L) (offset + 1L) (Stdlib.Env.__addEntry entry result)
    else
        Stdlib.Env.__decodePackedFrom packed (offset + 1L) start result

let __decodePacked (packed: String) : Dict<String, String> =
    Stdlib.Env.__decodePackedFrom packed 0L 0L (Dict { })

let get (name: String) : Stdlib.Option.Option<String> = Builtin.environmentGet name

let getAll () : Dict<String, String> = Builtin.environmentGetAll ()
