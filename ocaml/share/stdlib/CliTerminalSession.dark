// CliTerminalSession.dark - upstream terminal restoration values.

module Darklang.Stdlib.Cli.Tui.TerminalSession.Ansi

val enterAlternateScreen = "\u001b[?1049h"
val exitAlternateScreen = "\u001b[?1049l"
val showCursor = "\u001b[?25h"
val resetStyle = "\u001b[0m"
val resetScrollRegion = "\u001b[r"
val beginSynchronizedOutput = "\u001b[?2026h"
val endSynchronizedOutput = "\u001b[?2026l"
val restoreInlineModes = "\u001b[0m\u001b[?25h"
val restoreFullscreenModes = "\u001b[0m\u001b[r\u001b[?25h\u001b[?1049l\u001b[?25h"
val restoreInline = "\u001b[?2026l\u001b[0m\u001b[r\u001b[?25h"
val restoreFullscreen = "\u001b[?2026l\u001b[0m\u001b[r\u001b[?25h\u001b[?1049l\u001b[?25h"
