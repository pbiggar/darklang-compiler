opam-version: "2.0"
synopsis: "Faithful native OCaml port of the Dark compiler"
maintainer: "Darklang"
authors: ["Darklang"]
license: "MIT"
build: [["dune" "build" "-p" name "-j" jobs]]
depends: [
  "ocaml" {= "5.5.1"}
  "dune" {= "3.24.2"}
  "yojson" {= "3.0.0"}
  "zarith" {= "1.14"}
  "uutf" {= "1.0.4"}
  "uucp" {= "16.0.0"}
  "uunf" {= "16.0.0"}
  "uuseg" {= "16.0.0"}
]

depexts: [
  ["libicu-dev"] {os-distribution = "ubuntu" | os-distribution = "debian"}
  ["icu4c"] {os = "macos"}
]
