(library
 (name semantic_observation)
 (libraries dark_compiler yojson zarith)
 (flags (:standard -w @a-42 -warn-error +a-42)))

; Instrument the complete production implementation from the same source.
; Private catalogs remain private in the production library; only this migration
; build appends typed encoders after the real implementation's definitions.
(rule
 (targets InstrumentedCheckedAST.ml)
 (deps ../lib/CheckedAST.ml checked_ast_observation.inc)
 (action
  (with-stdout-to %{targets}
   (progn
    (echo "open Dark_compiler")
    (cat %{dep:../lib/CheckedAST.ml})
    (cat %{dep:checked_ast_observation.inc})))))
(rule
 (targets InstrumentedCheckedAST.mli)
 (deps ../lib/CheckedAST.mli)
 (action
  (with-stdout-to %{targets}
   (progn
    (echo "open Dark_compiler")
    (cat %{dep:../lib/CheckedAST.mli})
    (echo "val observe : string -> Yojson.Basic.t\nval observationProgram : program -> Yojson.Basic.t\nval observationTypeCatalog : typeCatalog -> Yojson.Basic.t\nval observationFunctionCatalog : functionCatalog -> Yojson.Basic.t\nval observationPattern : pattern -> Yojson.Basic.t\nval observationLetPattern : letPattern -> Yojson.Basic.t\nval observationExpr : expr -> Yojson.Basic.t\nval observationGlobalCatalog : symbols -> Yojson.Basic.t\nval observationBinding : AST.bindingId -> Yojson.Basic.t\nval observationFunctionDef : functionDef -> Yojson.Basic.t\nval observationTopLevel : topLevel -> Yojson.Basic.t\nval observationSemanticMetadata : semanticMetadata -> Yojson.Basic.t\nval observationFixtures : string -> (program, string) result list\nval observationRecursiveMember : recursiveMember -> Yojson.Basic.t\n")))))

(rule
 (targets InstrumentedTypes.ml)
 (deps ../lib/frontend/checking/Types.ml instrument_checking.py)
