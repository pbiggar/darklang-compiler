; Port-specific equivalence and allocation regression checks, outside oracle counts.
(executables
 (names host_text_regression cache_regression component_regression)
 (libraries dark_compiler)
 (flags (:standard -w @a -warn-error @a)))

(rule
 (alias runtest)
 (action
  (progn
   (run %{exe:host_text_regression.exe})
   (run %{exe:cache_regression.exe})
   (run %{exe:component_regression.exe}))))
