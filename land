#!/usr/bin/env bash
# land - Dispatch a committed task branch for local integration.

set -euo pipefail

task=""
exception_gate=""
exception_reason=""

usage() {
  cat <<EOF
Usage: ./land [OPTIONS]

Dispatch the current clean, committed task branch. Tooling-only changes are
merged directly into local main after focused validation and print "landed".
Other changes enter the FIFO merge train with bounded --auto approval and
print "queued" after the exact commit is accepted.

Options:
  --task TEXT           Task description.
                        Default: current commit subject
  --exception-gate NAME Request a one-time exception for one eligible gate.
  --exception-reason TEXT
                        Explain why that gate may fail for this commit.
  -h, --help            Show this help and exit.

Example:
  ./land --task "implement dictionary literals"
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --task)
      task="$2"
      shift 2
      ;;
    --exception-gate)
      exception_gate="$2"
      shift 2
      ;;
    --exception-reason)
      exception_reason="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

for required_command in flock git mergetrain python3; do
  if ! command -v "$required_command" >/dev/null 2>&1; then
    echo "Required command not found: $required_command" >&2
    exit 1
  fi
done

repo_root="$(git rev-parse --show-toplevel)"
branch="$(git -C "$repo_root" branch --show-current)"
head_sha="$(git -C "$repo_root" rev-parse HEAD)"

if [[ -z "$branch" || "$branch" == "main" ]]; then
  echo "Run ./land from a task branch, not main or a detached HEAD" >&2
  exit 1
fi
if [[ -n "$(git -C "$repo_root" status --porcelain)" ]]; then
  echo "Commit every intended change before running ./land" >&2
  exit 1
fi
if [[ -z "$task" ]]; then
  task="$(git -C "$repo_root" log -1 --format=%s)"
fi
common_dir="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir)"
kind="$(python3 "$repo_root/scripts/mergetrain_control.py" \
  --repo "$repo_root" classify "$head_sha")"
if [[ "$kind" == control ]]; then
  if [[ -n "$exception_gate" || -n "$exception_reason" ]]; then
    echo "Tooling changes do not use merge-train gate exceptions" >&2
    exit 2
  fi
  python3 "$repo_root/scripts/mergetrain_control.py" \
    --repo "$repo_root" land "$head_sha" --task "$task" >/dev/null
  echo "landed"
  exit 0
fi
exec {dispatch_lock_fd}>"$common_dir/mergetrain-dispatch.lock"
flock -x "$dispatch_lock_fd"
if [[ -n "$exception_gate" || -n "$exception_reason" ]]; then
  if [[ -z "$exception_gate" || -z "$exception_reason" ]]; then
    echo "Use --exception-gate and --exception-reason together" >&2
    exit 2
  fi
  python3 "$repo_root/scripts/mergetrain_exception.py" --repo "$repo_root" \
    request --head "$head_sha" --branch "$branch" \
    --gate "$exception_gate" --reason "$exception_reason"
fi

json_value() {
  local path="$1"
  python3 -c '
import json
import sys

value = json.load(sys.stdin)
for component in sys.argv[1].split("."):
    value = value.get(component) if isinstance(value, dict) else None
if value is None:
    print("")
elif isinstance(value, bool):
    print("true" if value else "false")
else:
    print(value)
' "$path"
}

snapshot="$(mergetrain --repo "$repo_root" status --json)"
contract_version="$(json_value contract_version <<<"$snapshot")"

if [[ "$contract_version" != "4" ]]; then
  echo "Unsupported mergetrain contract version: $contract_version" >&2
  exit 1
fi

if ! enqueue_payload="$(
  mergetrain --repo "$repo_root" enqueue \
    --task "$task" \
    --branch "$branch" \
    --worktree "$repo_root" \
    --auto \
    --json 2>&1
)"; then
  echo "Landing handoff is pending; retry ./land later" >&2
  exit 1
fi
job_id="$(json_value job.id <<<"$enqueue_payload")"
queued_head="$(json_value job.head_sha <<<"$enqueue_payload")"
if [[ -z "$job_id" || "$queued_head" != "$head_sha" ]]; then
  echo "Mergetrain did not enqueue the expected commit" >&2
  echo "$enqueue_payload" >&2
  exit 1
fi

echo "queued"
