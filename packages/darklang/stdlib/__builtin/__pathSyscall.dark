// Typed checked-path kernel adapters. Policy/marshalling stays private.
module Builtin

let __withTimes (a: Int) (an: Int) (m: Int) (mn: Int) (action: RawPtr -> 'a) : 'a =
    let a = Builtin.__posixInt64 a in
    let an = Builtin.__posixInt64 an in
    let m = Builtin.__posixInt64 m in
    let mn = Builtin.__posixInt64 mn in
    let times = __mapped_alloc 32L in
    let _ = __raw_write_word times 0L a in
    let _ = __raw_write_word times 8L an in
    let _ = __raw_write_word times 16L m in
    let _ = __raw_write_word times 24L mn in
    let result = action times in
    let _ = __mapped_free times in
    result

let syscallUtimensAt (path: String) (a: Int) (an: Int) (m: Int) (mn: Int) : Stdlib.Result.Result<Unit, Int> =
    if Stdlib.Cli.__Posix.__mac () then Error 78
    else
        Builtin.__withTimes a an m mn (fun times ->
            Stdlib.Cli.__Posix.__metadataPath path (fun heldFd held ->
                let rc = Stdlib.Cli.__Posix.__withCString "" (fun ptr -> Stdlib.Cli.__Posix.__utimesAt heldFd ptr times 4096L) in
                if rc == -22L then Stdlib.Cli.__Posix.__withCString held (fun ptr -> Stdlib.Cli.__Posix.__unitResult (Stdlib.Cli.__Posix.__utimesAt (Stdlib.Cli.__Posix.__cwdFd ()) ptr times 0L))
                else Stdlib.Cli.__Posix.__unitResult rc))
        |> Stdlib.Result.mapError (fun error -> error.errno)

let syscallSetattrlistTimes (path: String) (a: Int) (an: Int) (m: Int) (mn: Int) : Stdlib.Result.Result<Unit, Int> =
    if Stdlib.Cli.__Posix.__mac () == false then Error 38
    else
        // XNU attribute order is MODTIME followed by ACCTIME.
        Builtin.__withTimes m mn a an (fun times ->
            Stdlib.Cli.__Posix.__withEntry path (fun fd name ->
                let attrs = __mapped_alloc 24L in
                let _ = __raw_write_word attrs 0L 21990232555525L in
                let _ = __raw_write_word attrs 8L 0L in
                let _ = __raw_write_word attrs 16L 0L in
                let result = Stdlib.Cli.__Posix.__unitResult (Stdlib.Cli.__Posix.__setAttributesAt fd name attrs times 32L 1L) in
                let _ = __mapped_free attrs in
                result))
        |> Stdlib.Result.mapError (fun error -> error.errno)

let syscallGetcwd (count: Int) : Stdlib.Result.Result<Blob, Int> =
    let count = Builtin.__posixInt32 count in
    if count <= 0L then Error 22
    else
        let buffer = __mapped_alloc count in
        let rc = Stdlib.Cli.__Posix.__getCwd buffer count in
        let result = if rc < 0L then Error (Stdlib.Int.fromInt64 (0L - rc))
                     else Ok (Stdlib.Cli.__Posix.__bufferBytes buffer 0L rc []) in
        let _ = __mapped_free buffer in
        result

let syscallFcntlGetPath (fd: Int) : Stdlib.Result.Result<Blob, Int> =
    let fd = Builtin.__posixInt32 fd in
    let buffer = __mapped_alloc 1024L in
    let rc = Stdlib.Cli.__Posix.__fcntlGetPath fd 50L buffer in
    let result = if rc < 0L then Error (Stdlib.Int.fromInt64 (0L - rc))
                 else Ok (Stdlib.Cli.__Posix.__bufferBytes buffer 0L 1024L []) in
    let _ = __mapped_free buffer in
    result

let syscallReadlinkAt (path: String) (count: Int) : Stdlib.Result.Result<Blob, Int> =
    let count = Builtin.__posixInt32 count in
    if count <= 0L then Error 22
    else
        Stdlib.Cli.__Posix.__withEntry path (fun fd name ->
            let buffer = __mapped_alloc count in
            let rc = Stdlib.Cli.__Posix.__readlinkAt fd name buffer count in
            let result =
                if rc < 0L then Error (Stdlib.Cli.__Posix.__error (0L - rc))
                else Ok (Stdlib.Cli.__Posix.__bufferBytes buffer 0L rc []) in
            let _ = __mapped_free buffer in
            result)
        |> Stdlib.Result.mapError (fun error -> error.errno)

let syscallUnlinkAt (path: String) (flags: Int) : Stdlib.Result.Result<Unit, Int> =
    Builtin.__checkedUnlinkAt path flags
    |> Stdlib.Result.mapError (fun error -> error.errno)

let syscallOpen (path: String) (flags: Int) (mode: Int) : Stdlib.Result.Result<Int, Int> =
    Builtin.__checkedOpen path flags mode
    |> Stdlib.Result.mapError (fun error -> error.errno)

let syscallMkdir (path: String) (mode: Int) : Stdlib.Result.Result<Unit, Int> =
    Builtin.__checkedMkdir path mode
    |> Stdlib.Result.mapError (fun error -> error.errno)

let syscallChdir (path: String) : Stdlib.Result.Result<Unit, Int> =
    Builtin.__checkedChdir path
    |> Stdlib.Result.mapError (fun error -> error.errno)

let syscallRename (oldpath: String) (newpath: String) : Stdlib.Result.Result<Unit, Int> =
    Builtin.__checkedRename oldpath newpath
    |> Stdlib.Result.mapError (fun error -> error.errno)

let syscallChmod (path: String) (mode: Int) : Stdlib.Result.Result<Unit, Int> =
    Builtin.__checkedChmod path mode
    |> Stdlib.Result.mapError (fun error -> error.errno)

let syscallSymlink (target: String) (linkpath: String) : Stdlib.Result.Result<Unit, Int> =
    Builtin.__checkedSymlink target linkpath
    |> Stdlib.Result.mapError (fun error -> error.errno)
