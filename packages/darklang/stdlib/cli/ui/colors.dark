// CliColor.dark - upstream ANSI values and one-shot colorizers.

module Darklang.Stdlib.Cli.UI.Colors

val reset = "\u001b[0m"
val bold = "\u001b[1m"
val dim = "\u001b[2m"
val italic = "\u001b[3m"
val underline = "\u001b[4m"
val reverse = "\u001b[7m"
val black = "\u001b[30m"
val red = "\u001b[31m"
val green = "\u001b[32m"
val yellow = "\u001b[33m"
val blue = "\u001b[34m"
val magenta = "\u001b[35m"
val cyan = "\u001b[36m"
val white = "\u001b[37m"
val brightBlack = "\u001b[90m"
val brightRed = "\u001b[91m"
val brightGreen = "\u001b[92m"
val brightYellow = "\u001b[93m"
val brightBlue = "\u001b[94m"
val brightMagenta = "\u001b[95m"
val brightCyan = "\u001b[96m"
val brightWhite = "\u001b[97m"
val bgBlack = "\u001b[40m"
val bgRed = "\u001b[41m"
val bgGreen = "\u001b[42m"
val bgYellow = "\u001b[43m"
val bgBlue = "\u001b[44m"
val bgMagenta = "\u001b[45m"
val bgCyan = "\u001b[46m"
val bgWhite = "\u001b[47m"
val pink = "\u001b[38;5;213m"
val purple = "\u001b[38;5;141m"
val orange = "\u001b[38;5;208m"
val grayBg = "\u001b[48;5;236m"
val purpleBg = "\u001b[48;5;61m"
val magentaBg = "\u001b[48;5;134m"
val lightPinkBg = "\u001b[48;5;218m"
val pinkBg = "\u001b[48;5;176m"
val blueBg = "\u001b[48;5;38m"
val greenBg = "\u001b[48;5;115m"
val yellowBg = "\u001b[48;5;229m"
val brownBg = "\u001b[48;5;180m"
val orangeBg = "\u001b[48;5;222m"
val peachBg = "\u001b[48;5;216m"
val salmonBg = "\u001b[48;5;223m"
val faintGreenBg = "\u001b[48;2;24;44;30m"
val faintRedBg = "\u001b[48;2;52;28;32m"
val commandColor = "\u001b[34m"
val argumentColor = "\u001b[32m"
val keywordColor = "\u001b[35m"
val stringColor = "\u001b[33m"
val numberColor = "\u001b[36m"
val commentColor = "\u001b[90m"
val errorColor = "\u001b[31m"
val warningColor = "\u001b[33m"
val successColor = "\u001b[32m"
val infoColor = "\u001b[34m"
val hintColor = "\u001b[2m"
val promptColor = "\u001b[97m"
val logoColor = "\u001b[90m"
val primary = "\u001b[94m"
val muted = "\u001b[90m"
val accent = "\u001b[93m"
val selection = "\u001b[103;30m"
val completionSelection = "\u001b[44;97m"

let colorize (color: String) (text: String) : String = color ++ text ++ Stdlib.Cli.UI.Colors.reset
let plain (text: String) : String = text
let boldText (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.bold text
let dimText (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.dim text
let mutedText (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.muted text
let command (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.commandColor text
let argument (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.argumentColor text
let keyword (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.keywordColor text
let string (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.stringColor text
let number (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.numberColor text
let comment (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.commentColor text
let error (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.errorColor text
let warning (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.warningColor text
let success (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.successColor text
let info (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.infoColor text
let hint (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.hintColor text
let prompt (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.promptColor text
let logo (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.logoColor text
let redText (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.red text
let greenText (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.green text
let yellowText (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.yellow text
let blueText (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.blue text
let magentaText (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.magenta text
let cyanText (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.cyan text
let whiteText (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.white text
let grayText (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.brightBlack text
let italicText (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.italic text
let underlineText (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.underline text
let strikethroughText (text: String) : String = Stdlib.Cli.UI.Colors.colorize "\u001b[9m" text
let onRed (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.bgRed text
let onGreen (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.bgGreen text
let onYellow (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.bgYellow text
let onBlue (text: String) : String = Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.bgBlue text
