// SQLite index B-trees store full record keys in leaves and interior pages.
// Promoted keys move into their parent, retaining ownership of overflow chains.
module Darklang.Stdlib.Sqlite.__Index

type __Cell = { child: Int, raw: Blob, key: List<Stdlib.Sqlite.Value> }
type __Node = { leaf: Bool, cells: List<__Cell>, right: Int }
type __Edit = { state: Stdlib.Sqlite.__Pager.__State, split: Stdlib.Option.Option<(__Cell * Int)> }

let __get (b: Blob) (offset: Int) (width: Int) : Int = Stdlib.Sqlite.__Codec.__beRead b offset width
let __local (size: Int) (payload: Int) : Int =
  let maximum = ((size - 12) * 64 / 255) - 23
  let minimum = ((size - 12) * 32 / 255) - 23
  if payload <= maximum then payload
  else let k = minimum + (payload - minimum) % (size - 4) in if k <= maximum then k else minimum

let __compare (a: List<Stdlib.Sqlite.Value>) (b: List<Stdlib.Sqlite.Value>) : Int =
  match (a,b) with
  | ([],[]) -> 0
  | ([],_) -> -1
  | (_,[]) -> 1
  | (x :: xs,y :: ys) -> let cmp = Stdlib.Sqlite.__Eval.__compare x y in if cmp == 0 then __compare xs ys else cmp

let __cells (s: Stdlib.Sqlite.__Pager.__State) (b: Blob) (leaf: Bool) (i: Int) (count: Int) (cells: List<__Cell>)
  : Stdlib.Result.Result<(Stdlib.Sqlite.__Pager.__State * List<__Cell>), String> =
  if i == count then Ok ((s,cells))
  else
    let header = if leaf then 8 else 12
    let offset = __get b (header + 2 * i) 2
    let start = offset + (if leaf then 0 else 4)
    if offset < header + 2 * count || start >= s.size then Error "SQLite: invalid index cell pointer"
    else Stdlib.Sqlite.__Codec.__readVar b start |> Stdlib.Result.andThen (fun (length,after) ->
      let local = __local s.size length
      let end_ = after + local + (if length > local then 4 else 0)
      if length > 67108864 || end_ > s.size then Error "SQLite: invalid index payload"
      else
        let raw = Stdlib.Blob.slice b start (end_ - start)
        let prefix = Stdlib.Blob.slice b after local
        (if length == local then Ok ((s,prefix))
         else Stdlib.Sqlite.__Btree.__overflowRead s (__get b (after + local) 4) (length - local) [] [prefix])
        |> Stdlib.Result.andThen (fun (s,payload) -> Stdlib.Sqlite.__Codec.__decodeRecord payload |> Stdlib.Result.andThen (fun key ->
          __cells s b leaf (i + 1) count (cells @ [__Cell { child = if leaf then 0 else __get b offset 4, raw = raw, key = key }]))))

let __read (s: Stdlib.Sqlite.__Pager.__State) (page: Int) : Stdlib.Result.Result<(Stdlib.Sqlite.__Pager.__State * __Node), String> =
  if page <= 1 then Error "SQLite: invalid index root"
  else Stdlib.Sqlite.__Pager.__read s page |> Stdlib.Result.andThen (fun (s,b) ->
    let kind = __get b 0 1
    if kind != 2 && kind != 10 then Error "SQLite: invalid index B-tree page"
    else
      let leaf = kind == 10
      let count = __get b 3 2
      if (if leaf then 8 else 12) + count * 2 > s.size then Error "SQLite: invalid index cell count"
      else __cells s b leaf 0 count [] |> Stdlib.Result.map (fun (s,cells) ->
        (s,__Node { leaf = leaf, cells = cells, right = if leaf then 0 else __get b 8 4 })))

let __write (s: Stdlib.Sqlite.__Pager.__State) (page: Int) (node: __Node) : Stdlib.Result.Result<Stdlib.Sqlite.__Pager.__State,String> =
  let cells = Stdlib.List.map node.cells (fun cell ->
    if node.leaf then cell.raw else Stdlib.Blob.concat [Stdlib.Sqlite.__Codec.__be cell.child 4,cell.raw])
  Stdlib.Sqlite.__Btree.__pack s page (if node.leaf then 10 else 2) node.right cells
let __empty (s: Stdlib.Sqlite.__Pager.__State) (root: Int) : Stdlib.Result.Result<Stdlib.Sqlite.__Pager.__State,String> =
  __write s root (__Node { leaf = true, cells = [], right = 0 })

let __make (s: Stdlib.Sqlite.__Pager.__State) (key: List<Stdlib.Sqlite.Value>) : Stdlib.Result.Result<(Stdlib.Sqlite.__Pager.__State * __Cell),String> =
  let payload = Stdlib.Sqlite.__Codec.__record key
  let length = Stdlib.Blob.length payload
  if length > 67108864 then Error "SQLite: index record exceeds 64 MiB limit"
  else
    let local = __local s.size length
    Stdlib.Sqlite.__Btree.__overflowWrite s payload local |> Stdlib.Result.map (fun (s,overflow) ->
      (s,__Cell { child = 0, key = key, raw = Stdlib.Blob.concat [Stdlib.Sqlite.__Codec.__var length,
        Stdlib.Blob.slice payload 0 local,if overflow == 0 then Stdlib.Blob.empty else Stdlib.Sqlite.__Codec.__be overflow 4] }))
let __weight (leaf: Bool) (cells: List<__Cell>) : Int =
  (if leaf then 8 else 12) + Stdlib.List.fold cells 0 (fun n cell -> n + 2 + (if leaf then 0 else 4) + Stdlib.Blob.length cell.raw)
let __insertCell (cells: List<__Cell>) (cell: __Cell) : List<__Cell> =
  match cells with
  | [] -> [cell]
  | first :: rest -> if __compare cell.key first.key < 0 then [cell] @ cells else [first] @ __insertCell rest cell
let __partition (size: Int) (leaf: Bool) (remaining: List<__Cell>) (left: List<__Cell>)
  (best: Stdlib.Option.Option<(List<__Cell> * __Cell * List<__Cell>)>) (score: Int)
  : Stdlib.Option.Option<(List<__Cell> * __Cell * List<__Cell>)> =
  match remaining with
  | [] -> best
  | pivot :: right ->
    let minimum = if leaf then 1 else 2
    let valid = Stdlib.List.length left >= minimum && Stdlib.List.length right >= minimum && __weight leaf left <= size && __weight leaf right <= size
    let difference = Stdlib.Int.absoluteValue (__weight leaf left - __weight leaf right)
    let better = valid && difference < score
    __partition size leaf right (left @ [pivot]) (if better then Some ((left,pivot,right)) else best) (if better then difference else score)
let __store (s: Stdlib.Sqlite.__Pager.__State) (page: Int) (node: __Node) : Stdlib.Result.Result<__Edit,String> =
  if __weight node.leaf node.cells <= s.size then __write s page node |> Stdlib.Result.map (fun s -> __Edit { state = s, split = None })
  else match __partition s.size node.leaf node.cells [] None (s.size * 3) with
    | None -> Error "SQLite: cannot split index page"
    | Some ((left,pivot,right)) -> Stdlib.Sqlite.__Pager.__allocate s |> Stdlib.Result.andThen (fun (s,newPage) ->
      __write s page (__Node { leaf = node.leaf, cells = left, right = if node.leaf then 0 else pivot.child })
      |> Stdlib.Result.andThen (fun s -> __write s newPage (__Node { leaf = node.leaf, cells = right, right = node.right }))
      |> Stdlib.Result.map (fun s -> __Edit { state = s, split = Some (({ pivot with child = page },newPage)) }))
let __choose (cells: List<__Cell>) (right: Int) (key: List<Stdlib.Sqlite.Value>) : Int =
  match cells with | [] -> right | cell :: rest -> if __compare key cell.key < 0 then cell.child else __choose rest right key
let __promote (cells: List<__Cell>) (child: Int) (pivot: __Cell) (right: Int) : List<__Cell> =
  match cells with
  | [] -> [{ pivot with child = child }]
  | cell :: rest -> if cell.child == child then [{ pivot with child = child },{ cell with child = right }] @ rest else [cell] @ __promote rest child pivot right
let __insertAt (s: Stdlib.Sqlite.__Pager.__State) (page: Int) (key: List<Stdlib.Sqlite.Value>) (depth: Int) : Stdlib.Result.Result<__Edit,String> =
  if depth > 64 then Error "SQLite: invalid index B-tree depth"
  else __read s page |> Stdlib.Result.andThen (fun (s,node) ->
    if Stdlib.List.any node.cells (fun cell -> __compare cell.key key == 0) then Error "SQLite: duplicate index entry"
    else if node.leaf then __make s key |> Stdlib.Result.andThen (fun (s,cell) -> __store s page { node with cells = __insertCell node.cells cell })
    else
      let child = __choose node.cells node.right key
      __insertAt s child key (depth + 1) |> Stdlib.Result.andThen (fun edit ->
        match edit.split with
        | None -> Ok edit
        | Some ((pivot,right)) -> __store edit.state page { node with cells = __promote node.cells child pivot right, right = if child == node.right then right else node.right }))
let __insert (s: Stdlib.Sqlite.__Pager.__State) (root: Int) (key: List<Stdlib.Sqlite.Value>) : Stdlib.Result.Result<Stdlib.Sqlite.__Pager.__State,String> =
  __insertAt s root key 0 |> Stdlib.Result.andThen (fun edit -> match edit.split with
    | None -> Ok edit.state
    | Some ((pivot,right)) -> Stdlib.Sqlite.__Pager.__allocate edit.state |> Stdlib.Result.andThen (fun (s,left) ->
      __read s root |> Stdlib.Result.andThen (fun (s,node) -> __write s left node)
      |> Stdlib.Result.andThen (fun s -> __write s root (__Node { leaf = false, cells = [{ pivot with child = left }], right = right }))))

let __release (s: Stdlib.Sqlite.__Pager.__State) (cell: __Cell) : Stdlib.Result.Result<Stdlib.Sqlite.__Pager.__State,String> =
  Stdlib.Sqlite.__Codec.__readVar cell.raw 0 |> Stdlib.Result.andThen (fun (length,after) ->
    let local = __local s.size length
    if local == length then Ok s else Stdlib.Sqlite.__Btree.__overflowFree s (__get cell.raw (after + local) 4) s.count)
let __clearAt (s: Stdlib.Sqlite.__Pager.__State) (page: Int) (depth: Int) (keep: Bool) : Stdlib.Result.Result<Stdlib.Sqlite.__Pager.__State,String> =
  if depth > 64 then Error "SQLite: invalid index B-tree depth"
  else __read s page |> Stdlib.Result.andThen (fun (s,node) ->
    Stdlib.List.fold node.cells (Ok s) (fun result cell -> result |> Stdlib.Result.andThen (fun s -> __release s cell))
    |> Stdlib.Result.andThen (fun s ->
      let children = if node.leaf then [] else Stdlib.List.map node.cells (fun cell -> cell.child) @ [node.right]
      Stdlib.List.fold children (Ok s) (fun result child -> result |> Stdlib.Result.andThen (fun s -> __clearAt s child (depth + 1) false)))
    |> Stdlib.Result.andThen (fun s -> if keep then __empty s page else Stdlib.Sqlite.__Pager.__free s page))

// Rebuild one affected index in the same page transaction. The root page is stable;
// all other old pages/overflow chains return to the SQLite freelist for reuse.
let __rebuild (s: Stdlib.Sqlite.__Pager.__State) (root: Int) (keys: List<List<Stdlib.Sqlite.Value>>) : Stdlib.Result.Result<Stdlib.Sqlite.__Pager.__State,String> =
  __clearAt s root 0 true |> Stdlib.Result.andThen (fun s ->
    Stdlib.List.fold keys (Ok s) (fun result key -> result |> Stdlib.Result.andThen (fun s -> __insert s root key)))
