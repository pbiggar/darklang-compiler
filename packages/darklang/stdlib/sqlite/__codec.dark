// SQLite 3 record, integer and page-field codecs. All offsets are checked before decoding.
module Darklang.Stdlib.Sqlite.__Codec

let __i64 (n: Int) : Int64 =
  match Stdlib.Int.toInt64 n with
  | Some v -> v
  | None -> Builtin.crash "SQLite internal offset exceeds Int64"

let __byte (b: Blob) (offset: Int) : Int =
  Stdlib.Int.fromInt64 (Stdlib.Blob.__getByte b (__i64 offset))

let __zeros (n: Int) : Blob = Stdlib.Blob.__createZeroed (__i64 n)

let __beRead (b: Blob) (offset: Int) (width: Int) : Int =
  if width == 0 then 0
  else __byte b offset * Stdlib.Int.power 256 (width - 1) + __beRead b (offset + 1) (width - 1)

let __be (value: Int) (width: Int) : Blob =
  Stdlib.List.range 0 (width - 1)
  |> Stdlib.List.map (fun i -> __i64 ((value / Stdlib.Int.power 256 (width - i - 1)) % 256))
  |> Stdlib.Blob.__fromInt64List

let __replace (b: Blob) (offset: Int) (value: Blob) : Blob =
  Stdlib.Blob.concat [Stdlib.Blob.slice b 0 offset, value,
    Stdlib.Blob.slice b (offset + Stdlib.Blob.length value) (Stdlib.Blob.length b)]

let __put (b: Blob) (offset: Int) (width: Int) (value: Int) : Blob =
  __replace b offset (__be value width)

let __varLoop (n: Int) (tail: List<Int64>) : Blob =
  if n < 128 then Stdlib.Blob.__fromInt64List ([__i64 n] @ tail)
  else __varLoop (n / 128) ([__i64 (128 + n % 128)] @ tail)

let __var (n: Int) : Blob =
  let unsigned = if n < 0 then n + 18446744073709551616 else n
  if unsigned < 72057594037927936 then
    if unsigned < 128 then __be unsigned 1
    else
      let encoded = __varLoop (unsigned / 128) [__i64 (unsigned % 128)]
      // Every byte except the last carries the continuation bit.
      Stdlib.List.indexedMap (Stdlib.Blob.__toInt64List encoded)
        (fun i v -> if i == Stdlib.Blob.length encoded - 1 then v else if v < 128L then v + 128L else v)
      |> Stdlib.Blob.__fromInt64List
  else
    let high = unsigned / 256
    Stdlib.List.range 0 7
    |> Stdlib.List.map (fun i -> __i64 (128 + (high / Stdlib.Int.power 128 (7 - i)) % 128))
    |> (fun bytes -> Stdlib.Blob.__fromInt64List (bytes @ [__i64 (unsigned % 256)]))

let __readVarLoop (b: Blob) (offset: Int) (count: Int) (acc: Int)
  : Stdlib.Result.Result<(Int * Int), String> =
  if offset >= Stdlib.Blob.length b then Error "SQLite: truncated varint"
  else
    let byte = __byte b offset
    if count == 8 then Ok ((acc * 256 + byte, offset + 1))
    else if byte < 128 then Ok ((acc * 128 + byte, offset + 1))
    else __readVarLoop b (offset + 1) (count + 1) (acc * 128 + byte - 128)

let __readVar (b: Blob) (offset: Int) : Stdlib.Result.Result<(Int * Int), String> =
  if offset < 0 then Error "SQLite: invalid varint offset"
  else __readVarLoop b offset 0 0

let __signed (n: Int) (width: Int) : Int =
  let limit = Stdlib.Int.power 256 width
  if n >= limit / 2 then n - limit else n

let __integerWidth (n: Int) : Int =
  if n >= -128 && n <= 127 then 1
  else if n >= -32768 && n <= 32767 then 2
  else if n >= -8388608 && n <= 8388607 then 3
  else if n >= -2147483648 && n <= 2147483647 then 4
  else if n >= -140737488355328 && n <= 140737488355327 then 6
  else 8

let __field (value: Stdlib.Sqlite.Value) : (Int * Blob) =
  match value with
  | Null -> (0, __zeros 0)
  | Int i ->
    let n = Stdlib.Int.fromInt64 i
    if n == 0 then (8, __zeros 0)
    else if n == 1 then (9, __zeros 0)
    else
      let width = __integerWidth n
      let serial = if width == 6 then 5 else if width == 8 then 6 else width
      (serial, __be (if n < 0 then n + Stdlib.Int.power 256 width else n) width)
  | Real f -> (7, __be (Stdlib.Int.fromUInt64 (Stdlib.Float.toBits f)) 8)
  | Text s ->
    let b = Stdlib.Blob.fromString s
    (13 + 2 * Stdlib.Blob.length b, b)
  | Bytes b -> (12 + 2 * Stdlib.Blob.length b, b)

let __headerSize (n: Int) : Int =
  let total = n + 1
  let adjusted = n + Stdlib.Blob.length (__var total)
  if n + Stdlib.Blob.length (__var adjusted) == adjusted then adjusted
  else n + Stdlib.Blob.length (__var (adjusted + 1))

let __record (values: List<Stdlib.Sqlite.Value>) : Blob =
  let fields = Stdlib.List.map values __field
  let serials = Stdlib.Blob.concat (Stdlib.List.map fields (fun (s, _) -> __var s))
  let header = __headerSize (Stdlib.Blob.length serials)
  Stdlib.Blob.concat [__var header, serials, Stdlib.Blob.concat (Stdlib.List.map fields (fun (_, b) -> b))]

let __pow2 (exponent: Int) : Float =
  if exponent == 0 then 1.0
  else if exponent < 0 then __pow2 (exponent + 1) / 2.0
  else __pow2 (exponent - 1) * 2.0

let __float (bits: Int) : Float =
  let sign = if bits >= 9223372036854775808 then -1.0 else 1.0
  let exponent = (bits / 4503599627370496) % 2048
  let mantissa = bits % 4503599627370496
  if exponent == 2047 then
    if mantissa == 0 then sign / 0.0 else 0.0 / 0.0
  else if exponent == 0 then sign * (Stdlib.Int.toFloat mantissa * __pow2 (-1074))
  else sign * ((1.0 + Stdlib.Int.toFloat mantissa / 4503599627370496.0) * __pow2 (exponent - 1023))

let __serialWidth (serial: Int) : Int =
  if serial == 0 || serial == 8 || serial == 9 then 0
  else if serial <= 4 then serial
  else if serial == 5 then 6
  else if serial == 6 || serial == 7 then 8
  else if serial >= 12 then (serial - 12) / 2
  else -1

let __decodeField (b: Blob) (offset: Int) (serial: Int)
  : Stdlib.Result.Result<Stdlib.Sqlite.Value, String> =
  let width = __serialWidth serial
  if width < 0 || offset < 0 || offset + width > Stdlib.Blob.length b then Error "SQLite: invalid record field"
  else if serial == 0 then Ok Stdlib.Sqlite.Value.Null
  else if serial == 8 then Ok (Stdlib.Sqlite.Value.Int 0L)
  else if serial == 9 then Ok (Stdlib.Sqlite.Value.Int 1L)
  else if serial <= 6 then Ok (Stdlib.Sqlite.Value.Int (__i64 (__signed (__beRead b offset width) width)))
  else if serial == 7 then
    let f = __float (__beRead b offset 8)
    Ok (if Stdlib.Float.isNaN f then Stdlib.Sqlite.Value.Null else Stdlib.Sqlite.Value.Real f)
  else if serial % 2 == 0 then Ok (Stdlib.Sqlite.Value.Bytes (Stdlib.Blob.slice b offset width))
  else Stdlib.Blob.toString (Stdlib.Blob.slice b offset width) |> Stdlib.Result.map (fun s -> Stdlib.Sqlite.Value.Text s)

let __recordFields (b: Blob) (headerEnd: Int) (serialOffset: Int) (dataOffset: Int)
  (reversed: List<Stdlib.Sqlite.Value>) : Stdlib.Result.Result<List<Stdlib.Sqlite.Value>, String> =
  if serialOffset == headerEnd then
    if dataOffset == Stdlib.Blob.length b then Ok (Stdlib.List.reverse reversed)
    else Error "SQLite: record has trailing bytes"
  else if serialOffset > headerEnd then Error "SQLite: invalid record header"
  else
    __readVar b serialOffset |> Stdlib.Result.andThen (fun (serial, next) ->
      if next > headerEnd then Error "SQLite: invalid serial type"
      else __decodeField b dataOffset serial |> Stdlib.Result.andThen (fun value ->
        __recordFields b headerEnd next (dataOffset + __serialWidth serial) ([value] @ reversed)))

let __decodeRecord (b: Blob) : Stdlib.Result.Result<List<Stdlib.Sqlite.Value>, String> =
  __readVar b 0 |> Stdlib.Result.andThen (fun (headerEnd, next) ->
    if headerEnd < next || headerEnd > Stdlib.Blob.length b then Error "SQLite: invalid record header length"
    else __recordFields b headerEnd next headerEnd [])
