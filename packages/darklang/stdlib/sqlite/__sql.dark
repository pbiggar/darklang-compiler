// A deliberately restricted SQL grammar. Unsupported syntax fails before any commit.
module Darklang.Stdlib.Sqlite.__Sql

type __Token = Word of String | Quoted of String | Atom of Stdlib.Sqlite.Value | Symbol of String | Param of String
type __Expr = Literal of Stdlib.Sqlite.Value | Column of String | Parameter of String
  | Cast of __Expr * String | Binary of __Expr * String * __Expr | Count | Star
  | Call of String * List<__Expr> | Unary of String * __Expr | Case of List<(__Expr * __Expr)> * __Expr
type __Column = { name: String, affinity: String, primary: Bool, notNull: Bool, fallback: Stdlib.Option.Option<__Expr> }
type __Select = { fields: List<(__Expr * String)>, table: Stdlib.Option.Option<String>,
  predicate: Stdlib.Option.Option<__Expr>, order: List<(__Expr * Bool)>, limit: Stdlib.Option.Option<Int> }
type __Statement = Create of String * Bool * List<__Column> | Drop of String * Bool
  | Insert of String * List<String> * List<List<__Expr>> * Bool
  | Update of String * List<(String * __Expr)> * Stdlib.Option.Option<__Expr>
  | Delete of String * Stdlib.Option.Option<__Expr> | Select of __Select | Catalog of List<__Token>

let __lower (s: String) : String = Stdlib.String.toLowercase s
let __char (s: String) (i: Int) : Int64 =
  if i < 0 || i >= Stdlib.Int.fromInt64 (Stdlib.String.__byteLength s) then -1L
  else Stdlib.String.__byteAtUnchecked s (Stdlib.Sqlite.__Codec.__i64 i)
let __slice (s: String) (start: Int) (end_: Int) : String =
  let length = Stdlib.Int.fromInt64 (Stdlib.String.__byteLength s)
  let start = Stdlib.Int.min length (Stdlib.Int.max 0 start)
  let end_ = Stdlib.Int.min length (Stdlib.Int.max start end_)
  Stdlib.String.__byteSlice s (Stdlib.Sqlite.__Codec.__i64 start) (Stdlib.Sqlite.__Codec.__i64 end_)
let __identifierStart (c: Int64) : Bool = (c >= 65L && c <= 90L) || (c >= 97L && c <= 122L) || c == 95L || c >= 128L
let __identifierRest (c: Int64) : Bool = __identifierStart c || (c >= 48L && c <= 57L)
let __wordEnd (s: String) (i: Int) : Int = if __identifierRest (__char s i) then __wordEnd s (i + 1) else i
let __numberEnd (s: String) (i: Int) : Int =
  let c = __char s i
  if (c >= 48L && c <= 57L) || c == 46L || c == 101L || c == 69L || ((c == 43L || c == 45L) && (__char s (i - 1) == 101L || __char s (i - 1) == 69L)) then __numberEnd s (i + 1) else i

let __quoted (s: String) (i: Int) (quote: Int64) (acc: String) : Stdlib.Result.Result<(String * Int), String> =
  let c = __char s i
  if c == -1L then Error "SQLite: unterminated quoted token"
  else if c == quote then
    if __char s (i + 1) == quote then __quoted s (i + 2) quote (Stdlib.Blob.__copyToString (Stdlib.Blob.concat [Stdlib.Blob.fromString acc,Stdlib.Blob.fromString (__slice s i (i + 1))]))
    else Ok ((acc,i + 1))
  else
    let (_,width) = Stdlib.String.__decodeUtf8At s (Stdlib.Sqlite.__Codec.__i64 i)
    let next = i + Stdlib.Int.fromInt64 width
    __quoted s next quote (Stdlib.Blob.__copyToString (Stdlib.Blob.concat [Stdlib.Blob.fromString acc,Stdlib.Blob.fromString (__slice s i next)]))

let __commentEnd (s: String) (i: Int) : Stdlib.Result.Result<Int, String> =
  if __char s i == -1L then Error "SQLite: unterminated SQL comment"
  else if __char s i == 42L && __char s (i + 1) == 47L then Ok (i + 2)
  else __commentEnd s (i + 1)
let __lineEnd (s: String) (i: Int) : Int =
  if __char s i == -1L || __char s i == 10L then i else __lineEnd s (i + 1)

let __number (s: String) : Stdlib.Result.Result<Stdlib.Sqlite.Value, String> =
  match Stdlib.Int64.parse s with
  | Ok i -> Ok (Stdlib.Sqlite.Value.Int i)
  | Error _ -> Stdlib.Float.parse s |> Stdlib.Result.map (fun f -> Stdlib.Sqlite.Value.Real f)
    |> Stdlib.Result.mapError (fun _ -> "SQLite: invalid numeric literal")

let __lex (s: String) (i: Int) (acc: List<__Token>) : Stdlib.Result.Result<List<__Token>, String> =
  let c = __char s i
  if c == -1L then Ok (Stdlib.List.reverse acc)
  else if c == 32L || c == 9L || c == 10L || c == 13L then __lex s (i + 1) acc
  else if c == 45L && __char s (i + 1) == 45L then __lex s (__lineEnd s (i + 2)) acc
  else if c == 47L && __char s (i + 1) == 42L then __commentEnd s (i + 2) |> Stdlib.Result.andThen (fun end_ -> __lex s end_ acc)
  else if c == 39L || c == 34L || c == 96L then
    __quoted s (i + 1) c "" |> Stdlib.Result.andThen (fun (value,next) ->
      let token = if c == 39L then Atom (Stdlib.Sqlite.Value.Text value) else Quoted value
      __lex s next ([token] @ acc))
  else if (c == 120L || c == 88L) && __char s (i + 1) == 39L then
    __quoted s (i + 2) 39L "" |> Stdlib.Result.andThen (fun (hex,next) ->
      Stdlib.Blob.fromHex hex |> Stdlib.Result.andThen (fun b -> __lex s next ([Atom (Stdlib.Sqlite.Value.Bytes b)] @ acc)))
  else if c >= 48L && c <= 57L then
    let end_ = __numberEnd s i
    __number (__slice s i end_) |> Stdlib.Result.andThen (fun value -> __lex s end_ ([Atom value] @ acc))
  else if c == 64L || c == 36L || c == 58L then
    let end_ = __wordEnd s (i + 1)
    if end_ == i + 1 then Error "SQLite: empty parameter name"
    else __lex s end_ ([Param (__slice s i end_)] @ acc)
  else if __identifierStart c then
    let end_ = __wordEnd s (i + 1)
    __lex s end_ ([Word (__slice s i end_)] @ acc)
  else
    let one = __slice s i (i + 1)
    let two = __slice s i (i + 2)
    if two == "<=" || two == ">=" || two == "<>" || two == "!=" || two == "==" || two == "||" then __lex s (i + 2) ([Symbol two] @ acc)
    else if Stdlib.List.contains ["(",")",",",";","*","=","<",">","-","+","/","%","."] one then __lex s (i + 1) ([Symbol one] @ acc)
    else Error ("SQLite: unsupported SQL token " + one)

let __is (token: __Token) (text: String) : Bool =
  match token with
  | Word s -> __lower s == text
  | Symbol s -> s == text
  | _ -> false
let __eat (tokens: List<__Token>) (text: String) : Stdlib.Result.Result<List<__Token>, String> =
  match tokens with
  | first :: rest -> if __is first text then Ok rest else Error ("SQLite: expected " + text)
  | [] -> Error ("SQLite: expected " + text)
let __name (tokens: List<__Token>) : Stdlib.Result.Result<(String * List<__Token>), String> =
  match tokens with
  | Word s :: rest -> Ok ((s,rest))
  | Quoted s :: rest -> Ok ((s,rest))
  | _ -> Error "SQLite: expected identifier"

let __precedence (token: __Token) : Int =
  if __is token "or" then 1 else if __is token "and" then 2
  else if Stdlib.List.any ["=","==","!=","<>","<",">","<=",">=","is","like"] (fun s -> __is token s) then 3
  else if __is token "+" || __is token "-" then 4
  else if __is token "*" || __is token "/" || __is token "%" then 5
  else if __is token "||" then 6 else 0
let __tokenText (token: __Token) : String =
  match token with | Word s -> __lower s | Symbol s -> s | _ -> ""

let __expression (tokens: List<__Token>) (minimum: Int) : Stdlib.Result.Result<(__Expr * List<__Token>), String> =
  __atom tokens |> Stdlib.Result.andThen (fun (left,rest) -> __binary left rest minimum)

let __atom (tokens: List<__Token>) : Stdlib.Result.Result<(__Expr * List<__Token>), String> =
  match tokens with
  | Atom v :: rest -> Ok ((Literal v,rest))
  | Param n :: rest -> Ok ((Parameter n,rest))
  | Symbol "*" :: rest -> Ok ((Star,rest))
  | Symbol "(" :: rest -> __expression rest 1 |> Stdlib.Result.andThen (fun (expr,rest) ->
    __eat rest ")" |> Stdlib.Result.map (fun rest -> (expr,rest)))
  | Symbol "-" :: rest -> __expression rest 7 |> Stdlib.Result.map (fun (expr,rest) -> (Unary ("-",expr),rest))
  | Symbol "+" :: rest -> __expression rest 7 |> Stdlib.Result.map (fun (expr,rest) -> (Unary ("+",expr),rest))
  | Word word :: rest ->
    if __lower word == "null" then Ok ((Literal Stdlib.Sqlite.Value.Null,rest))
    else if __lower word == "true" then Ok ((Literal (Stdlib.Sqlite.Value.Int 1L),rest))
    else if __lower word == "false" then Ok ((Literal (Stdlib.Sqlite.Value.Int 0L),rest))
    else if __lower word == "not" then __expression rest 3 |> Stdlib.Result.map (fun (expr,rest) -> (Unary ("not",expr),rest))
    else if __lower word == "case" then __case rest None []
    else if __lower word == "count" then
      __eat rest "(" |> Stdlib.Result.andThen (fun rest -> __eat rest "*")
      |> Stdlib.Result.andThen (fun rest -> __eat rest ")") |> Stdlib.Result.map (fun rest -> (Count,rest))
    else if __lower word == "cast" then
      __eat rest "(" |> Stdlib.Result.andThen (fun rest -> __expression rest 1)
      |> Stdlib.Result.andThen (fun (expr,rest) -> __eat rest "as" |> Stdlib.Result.andThen __name
        |> Stdlib.Result.andThen (fun (name,rest) -> __eat rest ")" |> Stdlib.Result.map (fun rest -> (Cast (expr,__lower name),rest))))
    else
      match rest with
      | Symbol "(" :: tail ->
        (match tail with
        | Symbol ")" :: remaining -> Ok ((Call (__lower word,[]),remaining))
        | _ -> __expressions tail |> Stdlib.Result.andThen (fun (args,remaining) ->
          __eat remaining ")" |> Stdlib.Result.map (fun rest -> (Call (__lower word,args),rest))))
      | Symbol "." :: tail -> __name tail |> Stdlib.Result.map (fun (name,rest) -> (Column (word + "." + name),rest))
      | _ -> Ok ((Column word,rest))
  | Quoted name :: rest -> Ok ((Column name,rest))
  | _ -> Error "SQLite: expected expression"

// Both searched CASE and simple CASE use the same lazy branch representation.
let __case (tokens: List<__Token>) (base: Stdlib.Option.Option<__Expr>) (arms: List<(__Expr * __Expr)>)
  : Stdlib.Result.Result<(__Expr * List<__Token>), String> =
  match tokens with
  | Word word :: rest ->
    if __lower word == "when" then
      __expression rest 1 |> Stdlib.Result.andThen (fun (condition,rest) ->
        let condition = match base with | None -> condition | Some value -> Binary (value,"=",condition)
        __eat rest "then" |> Stdlib.Result.andThen (fun rest -> __expression rest 1)
        |> Stdlib.Result.andThen (fun (value,rest) -> __case rest base (arms @ [(condition,value)])))
    else if __lower word == "else" then
      __expression rest 1 |> Stdlib.Result.andThen (fun (fallback,rest) ->
        __eat rest "end" |> Stdlib.Result.map (fun rest -> (Case (arms,fallback),rest)))
    else if __lower word == "end" then Ok ((Case (arms,Literal Stdlib.Sqlite.Value.Null),rest))
    else if Stdlib.List.isEmpty arms && base == None then
      __expression tokens 1 |> Stdlib.Result.andThen (fun (base,rest) -> __case rest (Some base) [])
    else Error "SQLite: expected WHEN, ELSE or END"
  | _ -> Error "SQLite: incomplete CASE expression"

let __binary (left: __Expr) (tokens: List<__Token>) (minimum: Int) : Stdlib.Result.Result<(__Expr * List<__Token>), String> =
  match tokens with
  | op :: rest ->
    let precedence = __precedence op
    if precedence < minimum then Ok ((left,tokens))
    else
      let (operator,rest) = match rest with
        | next :: tail -> if __is op "is" && __is next "not" then ("is not",tail) else (__tokenText op,rest)
        | [] -> (__tokenText op,rest)
      __expression rest (precedence + 1) |> Stdlib.Result.andThen (fun (right,rest) ->
        __binary (Binary (left,operator,right)) rest minimum)
  | [] -> Ok ((left,[]))

let __expressions (tokens: List<__Token>) : Stdlib.Result.Result<(List<__Expr> * List<__Token>), String> =
  __expression tokens 1 |> Stdlib.Result.andThen (fun (expr,rest) ->
    match rest with
    | Symbol "," :: tail -> __expressions tail |> Stdlib.Result.map (fun (exprs,rest) -> ([expr] @ exprs,rest))
    | _ -> Ok (([expr],rest)))

let __names (tokens: List<__Token>) : Stdlib.Result.Result<(List<String> * List<__Token>), String> =
  __name tokens |> Stdlib.Result.andThen (fun (name,rest) ->
    match rest with
    | Symbol "," :: tail -> __names tail |> Stdlib.Result.map (fun (names,rest) -> ([name] @ names,rest))
    | _ -> Ok (([name],rest)))

let __constraints (column: __Column) (tokens: List<__Token>) : Stdlib.Result.Result<(__Column * List<__Token>), String> =
  match tokens with
  | Word word :: rest ->
    if __lower word == "primary" then __eat rest "key" |> Stdlib.Result.andThen (fun rest ->
      if column.affinity != "integer" then Error "SQLite: only INTEGER PRIMARY KEY is supported"
      else __constraints { column with primary = true } rest)
    else if __lower word == "not" then __eat rest "null" |> Stdlib.Result.andThen (fun rest -> __constraints { column with notNull = true } rest)
    else Error ("SQLite: unsupported column constraint " + word)
  | _ -> Ok ((column,tokens))

let __columns (tokens: List<__Token>) : Stdlib.Result.Result<(List<__Column> * List<__Token>), String> =
  __name tokens |> Stdlib.Result.andThen (fun (name,rest) ->
    __name rest |> Stdlib.Result.andThen (fun (affinity,rest) ->
      let affinity = __lower affinity
      if Stdlib.Bool.not (Stdlib.List.contains ["integer","int","text","real","blob","numeric"] affinity) then Error "SQLite: unsupported column type"
      else __constraints (__Column { name = name, affinity = affinity, primary = false, notNull = false, fallback = None }) rest
      |> Stdlib.Result.andThen (fun (column,rest) ->
        match rest with
        | Symbol "," :: tail -> __columns tail |> Stdlib.Result.map (fun (columns,rest) -> ([column] @ columns,rest))
        | _ -> Ok (([column],rest)))))

let __predicate (tokens: List<__Token>) : Stdlib.Result.Result<(Stdlib.Option.Option<__Expr> * List<__Token>), String> =
  match tokens with
  | Word word :: rest -> if __lower word == "where" then __expression rest 1 |> Stdlib.Result.map (fun (expr,rest) -> (Some expr,rest)) else Ok ((None,tokens))
  | _ -> Ok ((None,tokens))

let __fieldName (expr: __Expr) : String =
  match expr with | Column s -> s | Count -> "count(*)" | Star -> "*" | _ -> "expression"
let __fields (tokens: List<__Token>) : Stdlib.Result.Result<(List<(__Expr * String)> * List<__Token>), String> =
  __expression tokens 1 |> Stdlib.Result.andThen (fun (expr,rest) ->
    (match rest with
    | Word word :: tail -> if __lower word == "as" then __name tail else Ok ((__fieldName expr,rest))
    | _ -> Ok ((__fieldName expr,rest)))
    |> Stdlib.Result.andThen (fun (alias,rest) ->
      match rest with
      | Symbol "," :: tail -> __fields tail |> Stdlib.Result.map (fun (fields,rest) -> ([(expr,alias)] @ fields,rest))
      | _ -> Ok (([(expr,alias)],rest))))

let __order (tokens: List<__Token>) : Stdlib.Result.Result<(List<(__Expr * Bool)> * List<__Token>), String> =
  __expression tokens 1 |> Stdlib.Result.andThen (fun (expr,rest) ->
    let (descending,rest) = match rest with
      | Word word :: tail -> if __lower word == "desc" then (true,tail) else if __lower word == "asc" then (false,tail) else (false,rest)
      | _ -> (false,rest)
    match rest with
    | Symbol "," :: tail -> __order tail |> Stdlib.Result.map (fun (order,rest) -> ([(expr,descending)] @ order,rest))
    | _ -> Ok (([(expr,descending)],rest)))

let __limit (tokens: List<__Token>) : Stdlib.Result.Result<(Stdlib.Option.Option<Int> * List<__Token>), String> =
  match tokens with
  | Word word :: tail ->
    if __lower word != "limit" then Ok ((None,tokens))
    else
      (match tail with
      | Atom value :: rest ->
        (match value with
        | Int n -> if n < 0L then Error "SQLite: negative LIMIT is unsupported" else Ok ((Some (Stdlib.Int.fromInt64 n),rest))
        | _ -> Error "SQLite: LIMIT must be an integer literal")
      | _ -> Error "SQLite: LIMIT must be an integer literal")
  | _ -> Ok ((None,tokens))

let __select (tokens: List<__Token>) : Stdlib.Result.Result<(__Statement * List<__Token>), String> =
  __fields tokens |> Stdlib.Result.andThen (fun (fields,rest) ->
    (match rest with
    | Word word :: tail -> if __lower word == "from" then __name tail |> Stdlib.Result.map (fun (table,rest) -> (Some table,rest)) else Ok ((None,rest))
    | _ -> Ok ((None,rest))) |> Stdlib.Result.andThen (fun (table,rest) ->
      __predicate rest |> Stdlib.Result.andThen (fun (predicate,rest) ->
        (match rest with
        | Word word :: tail -> if __lower word == "order" then __eat tail "by" |> Stdlib.Result.andThen __order else Ok (([],rest))
        | _ -> Ok (([],rest))) |> Stdlib.Result.andThen (fun (order,rest) ->
          __limit rest |> Stdlib.Result.map (fun (limit,rest) ->
            (Select (__Select { fields = fields, table = table, predicate = predicate, order = order, limit = limit }),rest))))))

let __assignments (tokens: List<__Token>) : Stdlib.Result.Result<(List<(String * __Expr)> * List<__Token>), String> =
  __name tokens |> Stdlib.Result.andThen (fun (name,rest) -> __eat rest "=" |> Stdlib.Result.andThen (fun rest -> __expression rest 1)
    |> Stdlib.Result.andThen (fun (expr,rest) -> match rest with
      | Symbol "," :: tail -> __assignments tail |> Stdlib.Result.map (fun (assignments,rest) -> ([(name,expr)] @ assignments,rest))
      | _ -> Ok (([(name,expr)],rest))))

let __catalogStatement (tokens: List<__Token>) (acc: List<__Token>) : Stdlib.Result.Result<(__Statement * List<__Token>),String> =
  match tokens with
  | [] -> Ok ((Catalog (Stdlib.List.reverse acc),[]))
  | Symbol ";" :: _ -> Ok ((Catalog (Stdlib.List.reverse acc),tokens))
  | first :: rest -> __catalogStatement rest ([first] @ acc)

let __valueRows (tokens: List<__Token>) : Stdlib.Result.Result<(List<List<__Expr>> * List<__Token>),String> =
  __eat tokens "(" |> Stdlib.Result.andThen __expressions |> Stdlib.Result.andThen (fun (values,rest) ->
    __eat rest ")" |> Stdlib.Result.andThen (fun rest -> match rest with
      | Symbol "," :: tail -> __valueRows tail |> Stdlib.Result.map (fun (rows,rest) -> ([values] @ rows,rest))
      | _ -> Ok (([values],rest))))

let __statement (tokens: List<__Token>) : Stdlib.Result.Result<(__Statement * List<__Token>), String> =
  match tokens with
  | Word command :: rest ->
    let command = __lower command
    if command == "select" then __select rest
    else if command == "create" then __catalogStatement ([Word command] @ rest) []
    else if command == "drop" then __eat rest "table" |> Stdlib.Result.andThen (fun rest ->
      (match rest with
      | Word word :: tail -> if __lower word == "if" then __eat tail "exists" |> Stdlib.Result.map (fun tail -> (true,tail)) else Ok ((false,rest))
      | _ -> Ok ((false,rest))) |> Stdlib.Result.andThen (fun (ignore,rest) -> __name rest |> Stdlib.Result.map (fun (name,rest) -> (Drop (name,ignore),rest))))
    else if command == "insert" then
      (match rest with
      | Word word :: tail -> if __lower word == "or" then __eat tail "ignore" |> Stdlib.Result.map (fun tail -> (true,tail)) else Ok ((false,rest))
      | _ -> Ok ((false,rest))) |> Stdlib.Result.andThen (fun (ignore,rest) ->
        __eat rest "into" |> Stdlib.Result.andThen __name |> Stdlib.Result.andThen (fun (name,rest) ->
          (match rest with
          | Symbol "(" :: tail -> __names tail |> Stdlib.Result.andThen (fun (names,rest) -> __eat rest ")" |> Stdlib.Result.map (fun rest -> (names,rest)))
          | _ -> Ok (([],rest))) |> Stdlib.Result.andThen (fun (names,rest) ->
            __eat rest "values" |> Stdlib.Result.andThen __valueRows
            |> Stdlib.Result.map (fun (rows,rest) -> (Insert (name,names,rows,ignore),rest)))))
    else if command == "update" then __name rest |> Stdlib.Result.andThen (fun (name,rest) -> __eat rest "set" |> Stdlib.Result.andThen __assignments
      |> Stdlib.Result.andThen (fun (assignments,rest) -> __predicate rest |> Stdlib.Result.map (fun (predicate,rest) -> (Update (name,assignments,predicate),rest))))
    else if command == "delete" then __eat rest "from" |> Stdlib.Result.andThen __name |> Stdlib.Result.andThen (fun (name,rest) ->
      __predicate rest |> Stdlib.Result.map (fun (predicate,rest) -> (Delete (name,predicate),rest)))
    else Error ("SQLite: unsupported SQL statement " + command)
  | _ -> Error "SQLite: expected SQL statement"

let __parse (sql: String) : Stdlib.Result.Result<__Statement, String> =
  __lex sql 0 [] |> Stdlib.Result.andThen __statement |> Stdlib.Result.andThen (fun (statement,rest) ->
    match rest with
    | [] -> Ok statement
    | [Symbol ";"] -> Ok statement
    | _ -> Error "SQLite: unsupported trailing SQL")

// Tokenize once so semicolons in strings/comments never split a statement.
let __statements (tokens: List<__Token>) (acc: List<__Statement>) : Stdlib.Result.Result<List<__Statement>, String> =
  match tokens with
  | [] -> Ok (Stdlib.List.reverse acc)
  | Symbol ";" :: rest -> __statements rest acc
  | _ -> __statement tokens |> Stdlib.Result.andThen (fun (statement,rest) ->
    match rest with
    | [] -> Ok (Stdlib.List.reverse ([statement] @ acc))
    | Symbol ";" :: tail -> __statements tail ([statement] @ acc)
    | _ -> Error "SQLite: unsupported trailing SQL")

let __parseMany (sql: String) : Stdlib.Result.Result<List<__Statement>, String> =
  __lex sql 0 [] |> Stdlib.Result.andThen (fun tokens -> __statements tokens [])

// Reading a catalog does not require executing its constraints. Split declarations
// at top-level commas, retaining nested DEFAULT/functions and composite keys.
let __catalogParts (tokens: List<__Token>) (depth: Int) (part: List<__Token>) (parts: List<List<__Token>>)
  : Stdlib.Result.Result<(List<List<__Token>> * List<__Token>),String> =
  match tokens with
  | [] -> Error "SQLite: unterminated table definition"
  | Symbol ")" :: rest ->
    if depth == 0 then Ok ((parts @ [part],rest)) else __catalogParts rest (depth - 1) (part @ [Symbol ")"]) parts
  | Symbol "(" :: rest -> __catalogParts rest (depth + 1) (part @ [Symbol "("]) parts
  | Symbol "," :: rest ->
    if depth == 0 then __catalogParts rest 0 [] (parts @ [part]) else __catalogParts rest depth (part @ [Symbol ","]) parts
  | token :: rest -> __catalogParts rest depth (part @ [token]) parts

let __catalogHas (tokens: List<__Token>) (a: String) (b: String) : Bool =
  match tokens with
  | first :: second :: rest -> (__is first a && __is second b) || __catalogHas ([second] @ rest) a b
  | _ -> false
let __catalogDefault (tokens: List<__Token>) : Stdlib.Result.Result<Stdlib.Option.Option<__Expr>,String> =
  match tokens with
  | [] -> Ok None
  | token :: rest -> if __is token "default" then __expression rest 1 |> Stdlib.Result.map (fun (expr,_) -> Some expr) else __catalogDefault rest
let __typeAffinity (name: String) : String =
  let name = __lower name
  if Stdlib.String.contains name "int" then "integer"
  else if Stdlib.List.any ["char","clob","text"] (fun part -> Stdlib.String.contains name part) then "text"
  else if name == "" || Stdlib.String.contains name "blob" then "blob"
  else if Stdlib.List.any ["real","floa","doub"] (fun part -> Stdlib.String.contains name part) then "real" else "numeric"

let __catalogColumn (tokens: List<__Token>) : Stdlib.Result.Result<Stdlib.Option.Option<__Column>,String> =
  match tokens with
  | Word word :: _ when Stdlib.List.contains ["primary","unique","foreign","check","constraint"] (__lower word) -> Ok None
  | _ -> __name tokens |> Stdlib.Result.andThen (fun (name,rest) ->
    let (declared,rest) = match rest with
      | Word word :: tail ->
        if Stdlib.List.contains ["primary","not","null","unique","default","references","check","collate"] (__lower word) then ("",rest) else (word,tail)
      | _ -> ("",rest)
    let primary = __lower declared == "integer" && __catalogHas rest "primary" "key" && Stdlib.Bool.not (__catalogHas rest "key" "desc")
    __catalogDefault rest |> Stdlib.Result.map (fun fallback -> Some (__Column { name = name, affinity = __typeAffinity declared,
      primary = primary, notNull = __catalogHas rest "not" "null", fallback = fallback })))

let __catalogColumns (sql: String) : Stdlib.Result.Result<List<__Column>,String> =
  __lex sql 0 [] |> Stdlib.Result.andThen (fun tokens -> __eat tokens "create" |> Stdlib.Result.andThen (fun tokens -> __eat tokens "table"))
  |> Stdlib.Result.andThen (fun tokens ->
    let tokens = match tokens with
      | Word a :: Word b :: Word c :: tail -> if __lower a == "if" && __lower b == "not" && __lower c == "exists" then tail else tokens
      | _ -> tokens
    __name tokens |> Stdlib.Result.andThen (fun (_,rest) -> __eat rest "(" |> Stdlib.Result.andThen (fun rest -> __catalogParts rest 0 [] [])))
  |> Stdlib.Result.andThen (fun (parts,rest) ->
    if rest != [] && rest != [Symbol ";"] then Error "SQLite: unsupported table storage declaration"
    else Stdlib.List.fold parts (Ok []) (fun result part -> result |> Stdlib.Result.andThen (fun columns ->
      __catalogColumn part |> Stdlib.Result.map (fun column -> match column with | None -> columns | Some c -> columns @ [c])))
    |> Stdlib.Result.map (fun columns ->
      // A table-level single-column INTEGER PK is also a rowid alias.
      let primary = Stdlib.List.findFirst parts (fun part -> match part with
        | Word word :: _ -> __lower word == "primary" | _ -> false)
      let name = match primary with
        | Some [Word _,Word _,Symbol "(",Word name,Symbol ")"] -> Some name
        | Some [Word _,Word _,Symbol "(",Quoted name,Symbol ")"] -> Some name
        | _ -> None
      Stdlib.List.map columns (fun column ->
        if name == Some column.name && column.affinity == "integer" then { column with primary = true } else column)))
