// __Tls13ServerRetry.dark - Single X25519 HelloRetryRequest and immutable second ClientHello validation.
module Darklang.Stdlib.__Tls13ServerRetry

type State = { first: Stdlib.__Tls13ServerHello.Hello, hello: Blob }
type Psk = { identity: Blob, size: Int64 }

let create (first: Stdlib.__Tls13ServerHello.Hello) : Stdlib.Result.Result<Stdlib.__Tls13ServerRetry.State, String> =
  if Stdlib.Option.isSome first.keyShare then Error "TLS retry requested an already offered share"
  else if Stdlib.Option.isSome (Stdlib.__Tls13ServerHello.__find first.extensions 44L) then Error "Unexpected TLS client cookie"
  else Stdlib.Blob.fromHex "CF21AD74E59A6111BE1D8C021E65B891C2A211167ABB8C5E079E09E2C8A8339C" |> Stdlib.Result.map (fun random ->
    let extensions = Stdlib.__Tls13ServerHandshake.__extensions [Stdlib.__Tls13.__extension 43L (Stdlib.Blob.__fromInt64List [3L,4L]), Stdlib.__Tls13.__extension 51L (Stdlib.__Tls13.__u16 29L)] in
    let hello = Stdlib.__Tls13ServerHandshake.__message 2L (Stdlib.Blob.concat [Stdlib.Blob.__fromInt64List [3L,3L], random, Stdlib.Blob.__fromInt64List [Stdlib.Blob.__byteLength first.session], first.session, Stdlib.Blob.__fromInt64List [19L,1L,0L], extensions]) in
    Stdlib.__Tls13ServerRetry.State { first = first, hello = hello })

let __prefix (hello: Stdlib.__Tls13ServerHello.Hello) : Blob =
  // parse has already checked all prefix lengths and compression framing.
  let cipherStart = 39L + Stdlib.Blob.__getByte hello.raw 38L in
  let end_ = cipherStart + 2L + Stdlib.__Tls13.__read16 hello.raw cipherStart + 2L in
  Stdlib.__Http2Wire.__slice hello.raw 4L (end_ - 4L)

let __fixed (extensions: List<Stdlib.__Tls13ServerHello.Extension>) : List<Stdlib.__Tls13ServerHello.Extension> =
  Stdlib.List.filter extensions (fun extension -> extension.kind != 51L && extension.kind != 21L && extension.kind != 41L && extension.kind != 42L)

let __same (first: List<Stdlib.__Tls13ServerHello.Extension>) (second: List<Stdlib.__Tls13ServerHello.Extension>) : Bool =
  match first, second with
  | [], [] -> true
  | a :: rest, b :: tail -> a.kind == b.kind && Stdlib.__X509Chain.__same a.data b.data && Stdlib.__Tls13ServerRetry.__same rest tail
  | _, _ -> false

let __zero (data: Blob) (position: Int64) : Bool =
  if position == Stdlib.Blob.__byteLength data then true else Stdlib.Blob.__getByte data position == 0L && Stdlib.__Tls13ServerRetry.__zero data (position + 1L)

let __padding (hello: Stdlib.__Tls13ServerHello.Hello) : Bool =
  match Stdlib.__Tls13ServerHello.__find hello.extensions 21L with | None -> true | Some data -> Stdlib.__Tls13ServerRetry.__zero data 0L

let __identities (data: Blob) (position: Int64) (end_: Int64) (items: List<Blob>) : Stdlib.Result.Result<List<Blob>, String> =
  if position == end_ then Ok (Stdlib.List.reverse items)
  else if position + 2L > end_ || Stdlib.List.length items >= 64 then Error "Invalid TLS PSK identities"
  else
    let size = Stdlib.__Tls13.__read16 data position in
    if size == 0L || position + 2L + size + 4L > end_ then Error "Invalid TLS PSK identity"
    else Stdlib.__Tls13ServerRetry.__identities data (position + 2L + size + 4L) end_ (Stdlib.List.push items (Stdlib.__Http2Wire.__slice data (position + 2L) size))

let __binders (data: Blob) (position: Int64) (identities: List<Blob>) (items: List<Stdlib.__Tls13ServerRetry.Psk>) : Stdlib.Result.Result<List<Stdlib.__Tls13ServerRetry.Psk>, String> =
  let length = Stdlib.Blob.__byteLength data in
  match identities with
  | [] -> if position == length then Ok (Stdlib.List.reverse items) else Error "Invalid TLS PSK binder count"
  | identity :: rest ->
    if position >= length then Error "Missing TLS PSK binder"
    else
      let size = Stdlib.Blob.__getByte data position in
      if size < 32L || position + 1L + size > length then Error "Invalid TLS PSK binder"
      else Stdlib.__Tls13ServerRetry.__binders data (position + 1L + size) rest (Stdlib.List.push items (Stdlib.__Tls13ServerRetry.Psk { identity = identity, size = size }))

let __psk (data: Blob) : Stdlib.Result.Result<List<Stdlib.__Tls13ServerRetry.Psk>, String> =
  let length = Stdlib.Blob.__byteLength data in
  if length < 11L || length > 8192L then Error "Invalid TLS PSK extension"
  else
    let end_ = 2L + Stdlib.__Tls13.__read16 data 0L in
    if end_ < 9L || end_ + 2L > length || Stdlib.__Tls13.__read16 data end_ != length - end_ - 2L then Error "Invalid TLS PSK vectors"
    else Stdlib.__Tls13ServerRetry.__identities data 2L end_ [] |> Stdlib.Result.andThen (fun identities -> Stdlib.__Tls13ServerRetry.__binders data (end_ + 2L) identities [])

let __subset (first: List<Stdlib.__Tls13ServerRetry.Psk>) (second: List<Stdlib.__Tls13ServerRetry.Psk>) : Bool =
  match first, second with
  | [], [] -> true
  | a :: rest, b :: tail ->
    if a.size == b.size && Stdlib.__X509Chain.__same a.identity b.identity then Stdlib.__Tls13ServerRetry.__subset rest tail
    else a.size != 32L && Stdlib.__Tls13ServerRetry.__subset rest second
  | a :: rest, [] -> a.size != 32L && Stdlib.__Tls13ServerRetry.__subset rest []
  | _, _ -> false

let __pskChanges (first: Stdlib.__Tls13ServerHello.Hello) (second: Stdlib.__Tls13ServerHello.Hello) : Stdlib.Result.Result<Unit, String> =
  let a = Stdlib.__Tls13ServerHello.__find first.extensions 41L in
  let b = Stdlib.__Tls13ServerHello.__find second.extensions 41L in
  match a, b with
  | None, None -> Ok ()
  | None, Some _ -> Error "TLS retry added PSK identities"
  | Some first, _ ->
    Stdlib.__Tls13ServerRetry.__psk first |> Stdlib.Result.andThen (fun first ->
      let second = match b with | None -> Ok [] | Some data -> Stdlib.__Tls13ServerRetry.__psk data in
      second |> Stdlib.Result.andThen (fun second -> if Stdlib.__Tls13ServerRetry.__subset first second then Ok () else Error "TLS retry changed compatible PSK identities"))

let validate (state: Stdlib.__Tls13ServerRetry.State) (raw: Blob) : Stdlib.Result.Result<(Stdlib.__Tls13ServerHello.Hello * Blob), String> =
  Stdlib.__Tls13ServerHello.parse raw |> Stdlib.Result.andThen (fun second ->
    let share = Stdlib.__Tls13ServerHello.__find second.extensions 51L in
    let singleShare = match share with | Some data -> Stdlib.Blob.__byteLength data == 38L && Stdlib.__Tls13.__read16 data 0L == 36L && Stdlib.__Tls13.__read16 data 2L == 29L && Stdlib.__Tls13.__read16 data 4L == 32L | None -> false in
    if Stdlib.Option.isSome state.first.keyShare || Stdlib.Option.isNone second.keyShare || Stdlib.Bool.not singleShare then Error "TLS retry requires one new X25519 share"
    else if Stdlib.Bool.not (Stdlib.__Tls13ServerRetry.__padding state.first && Stdlib.__Tls13ServerRetry.__padding second) then Error "Invalid TLS retry padding"
    else if Stdlib.Option.isSome (Stdlib.__Tls13ServerHello.__find second.extensions 42L) || Stdlib.Option.isSome (Stdlib.__Tls13ServerHello.__find second.extensions 44L) then Error "Unexpected TLS retry early data or cookie"
    else if Stdlib.Bool.not (Stdlib.__X509Chain.__same (Stdlib.__Tls13ServerRetry.__prefix state.first) (Stdlib.__Tls13ServerRetry.__prefix second)) || Stdlib.Bool.not (Stdlib.__Tls13ServerRetry.__same (Stdlib.__Tls13ServerRetry.__fixed state.first.extensions) (Stdlib.__Tls13ServerRetry.__fixed second.extensions)) then Error "TLS retry changed ClientHello parameters"
    else Stdlib.__Tls13ServerRetry.__pskChanges state.first second |> Stdlib.Result.map (fun _unit ->
      let hash = Stdlib.__Tls13ServerHandshake.__message 254L (Stdlib.Crypto.sha256 state.first.raw) in
      ((second, Stdlib.Blob.concat [hash, state.hello, raw]))))
