// Builtin.dark - portable implementations and native adapters for upstream builtins.

module Builtin

// The interpreter's slugify regex filters codepoints, not whole grapheme clusters.
// Vertical tab is deliberately discarded even though it is Unicode whitespace.
let __slugifyFilter (codepoints: List<Int64>) (reversed: List<Int64>) : List<Int64> =
    match codepoints with
    | [] -> Stdlib.List.reverse reversed
    | codepoint :: rest ->
        let keep =
            (codepoint >= 97L && codepoint <= 122L) ||
            (codepoint >= 48L && codepoint <= 57L) ||
            codepoint == 45L || codepoint == 95L ||
            (codepoint != 11L && Stdlib.String.__Unicode.isWhitespace codepoint) in
        Builtin.__slugifyFilter rest (if keep then Stdlib.List.push reversed codepoint else reversed)

let __slugifySeparators (codepoints: List<Int64>) (previousSeparator: Bool) (reversed: List<Int64>) : String =
    match codepoints with
    | [] -> Stdlib.String.__fromCodepoints (Stdlib.List.reverse reversed)
    | codepoint :: rest ->
        let separator = codepoint == 45L || codepoint == 95L || Stdlib.String.__Unicode.isWhitespace codepoint in
        let next =
            if separator then
                if previousSeparator then reversed else Stdlib.List.push reversed 45L
            else Stdlib.List.push reversed codepoint in
        Builtin.__slugifySeparators rest separator next

let stringSlugify (value: String) : String =
    let filtered = Builtin.__slugifyFilter (Stdlib.String.__toCodepoints (Stdlib.String.toLowercase value)) [] in
    let trimmed = Stdlib.String.__trimEndCodepoints (Stdlib.String.__trimStartCodepoints filtered) in
    Builtin.__slugifySeparators trimmed false []

// Current interpreter integer probes call these primitive comparison names.
// The compiler keeps their typed behavior while implementing them portably.
let uint64GreaterThanOrEqualTo (a: UInt64) (b: UInt64) : Bool =
    Stdlib.UInt64.greaterThanOrEqualTo a b

let uint64LessThanOrEqualTo (a: UInt64) (b: UInt64) : Bool =
    Stdlib.UInt64.lessThanOrEqualTo a b

let runtimeEnvironmentGet (name: String) : Stdlib.Option.Option<String> =
    Stdlib.Cli.__getenv name

let runtimeEnvironmentGetAll () : Dict<String, String> =
    Stdlib.Cli.__environmentPacked ()
    |> Stdlib.Env.__decodePacked
