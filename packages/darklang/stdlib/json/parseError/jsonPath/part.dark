// JsonPathPart.dark - typed JSON path segment representation and rendering.

module Darklang.Stdlib.Json

module ParseError =
  module JsonPath =
    module Part =

      type Part =
        | Root
        | Index of Int
        | Field of String

      let toString (part: Part) : String =
        match part with
        | Root -> "root"
        | Field name -> "." + name
        | Index index -> "[" + Stdlib.toString index + "]"
