// HttpServerQuic.dark - Fair retained QUIC owners sharing one UDP listener.
module Darklang.Stdlib.HttpServer.Quic

type Recent = { source: Blob, expires: Int64, closing: Option<Stdlib.__QuicConnection.Closing> }
type Context = { config: Stdlib.HttpServer.Config.Config, identity: Stdlib.TlsServerIdentity.Identity, signals: Stdlib.__Network.ShutdownSignals, socket: Stdlib.__Datagram.Socket, secret: Blob, limit: Int64 }
type __Bootstrap = { connection: Stdlib.__QuicConnection.State, opened: Bool, index: Int64, offset: Int64, deadline: Int64 }
type __Phase = Handshake of (Stdlib.__QuicServer.Flight * Int64) | Initializing of Stdlib.HttpServer.Quic.__Bootstrap | Serving of Stdlib.__Http3Server.State | Draining of (Stdlib.__QuicConnection.State * Int64) | Closing of Stdlib.__QuicConnection.Closing
type __Owner = { source: Blob, peer: Stdlib.__Datagram.Endpoint, socket: Stdlib.__Datagram.Socket, outbox: RawPtr, phase: Stdlib.HttpServer.Quic.__Phase }
type __Runtime = { recent: List<Stdlib.HttpServer.Quic.Recent>, owners: List<Stdlib.HttpServer.Quic.__Owner> }
type Step = { state: Stdlib.HttpServer.Quic.__Runtime, stopped: Bool }

let __initial () : Stdlib.HttpServer.Quic.__Runtime = Stdlib.HttpServer.Quic.__Runtime { recent = [], owners = [] }

// QUIC reserves packet numbers before this callback. A bounded queue owns the
// sealed packets until an atomic native send succeeds; an unready retry never
// encrypts from stale state. Closing the child disposes only its queue.
let __socket (peer: Stdlib.__Datagram.Endpoint) : (Stdlib.__Datagram.Socket * RawPtr) =
  let outbox = Stdlib.Stream.__cellNew<List<Blob>> [] in
  let lifecycle = Stdlib.Stream.__new (fun _unit -> Some ()) (fun _unit -> Stdlib.Stream.__cellDispose<List<Blob>> outbox) in
  let socket = Stdlib.__Datagram.Socket { lifecycle = lifecycle, watch = None,
    send = fun target bytes _timeout ->
      match Stdlib.Stream.next lifecycle with
      | None -> Error 9L
      | Some () ->
        let pending = Stdlib.Stream.__cellGet<List<Blob>> outbox in
        if target != peer then Error 22L
        else if Stdlib.List.length pending >= 8 || Stdlib.Blob.__byteLength bytes > 4096L then Error 90L
        else let _ = Stdlib.Stream.__cellSet outbox (pending @ [bytes]) in Ok (),
    receive = fun _timeout -> Error 11L } in
  (socket, outbox)

let __closeAll (owners: List<Stdlib.HttpServer.Quic.__Owner>) : Unit =
  Stdlib.List.iter owners (fun owner -> Stdlib.__Datagram.close owner.socket)

let __flush (context: Stdlib.HttpServer.Quic.Context) (owner: Stdlib.HttpServer.Quic.__Owner) : Stdlib.Result.Result<Unit, String> =
  match Stdlib.Stream.__cellGet<List<Blob>> owner.outbox with
  | [] -> Ok ()
  | packet :: rest ->
    Stdlib.__Datagram.pollSend context.socket owner.peer packet |> Stdlib.Result.mapError (fun _code -> "QUIC listener send failed") |> Stdlib.Result.map (fun sent ->
      if sent then Stdlib.Stream.__cellSet owner.outbox rest else ())

let __input (connection: Stdlib.__QuicConnection.State) (datagram: Option<Stdlib.__Datagram.Message>) (now: Int64) : Stdlib.Result.Result<Stdlib.__QuicConnection.State, Stdlib.__QuicConnection.Failure> =
  match datagram with
  | None -> Ok connection
  | Some datagram -> Stdlib.__QuicConnection.__idle connection now |> Stdlib.Result.mapError Stdlib.__QuicConnection.__opaque |> Stdlib.Result.andThen (fun _unit -> Stdlib.__QuicConnection.__packets connection datagram.payload now)

let __bootstrap (state: Stdlib.HttpServer.Quic.__Bootstrap) (now: Int64) : Stdlib.Result.Result<Stdlib.HttpServer.Quic.__Phase, String> =
  if now >= state.deadline then Error "HTTP/3 initial stream credit timed out"
  else
    let opened =
      if state.opened then Ok state
      else if state.connection.flow.peer.streamsUni < 3L then Ok state
      else Stdlib.__QuicConnection.openStream state.connection 3L
        |> Stdlib.Result.andThen (fun connection -> Stdlib.__QuicConnection.openStream connection 7L)
        |> Stdlib.Result.andThen (fun connection -> Stdlib.__QuicConnection.openStream connection 11L)
        |> Stdlib.Result.map (fun connection -> { state with connection = connection, opened = true }) in
    opened |> Stdlib.Result.andThen (fun state ->
      if Stdlib.Bool.not state.opened then Ok (Stdlib.HttpServer.Quic.__Phase.Initializing state)
      else if state.index == 3L then
        let wire = Stdlib.__Http3.State { connection = state.connection, uni = Stdlib.__Http3.__uni false, stream = 0L,
          message = Stdlib.__Http3Message.create Request, deadline = state.deadline, feedback = Stdlib.Blob.empty } in
        Ok (Stdlib.HttpServer.Quic.__Phase.Serving (Stdlib.__Http3Server.initial wire now))
      else
        let bytes =
          if state.index == 0L then
            Stdlib.__Http3Wire.settingsWithQpack 4096L 1L |> Stdlib.Result.andThen (Stdlib.__Http3Wire.serialize 4L) |> Stdlib.Result.map (fun settings -> Stdlib.Blob.concat [Stdlib.Blob.__fromInt64List [0L], settings])
          else Ok (Stdlib.Blob.__fromInt64List [if state.index == 1L then 2L else 3L]) in
        bytes |> Stdlib.Result.andThen (fun bytes ->
          let id = 3L + state.index * 4L in
          let wire = Stdlib.__Http3.State { connection = state.connection, uni = Stdlib.__Http3.__uni false, stream = id,
            message = Stdlib.__Http3Message.create Request, deadline = state.deadline, feedback = Stdlib.Blob.empty } in
          let credit = Stdlib.__Http3.sendCredit wire in
          if credit <= 0L then Ok (Stdlib.HttpServer.Quic.__Phase.Initializing state)
          else
            let remaining = Stdlib.Blob.__byteLength bytes - state.offset in
            let size = if remaining < credit then remaining else credit in
            Stdlib.__QuicConnection.write state.connection id (Stdlib.__Http2Wire.__slice bytes state.offset size) false |> Stdlib.Result.map (fun connection ->
              Stdlib.HttpServer.Quic.__Phase.Initializing { state with connection = connection,
                index = if size == remaining then state.index + 1L else state.index,
                offset = if size == remaining then 0L else state.offset + size })))

let __advance (context: Stdlib.HttpServer.Quic.Context) (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (owner: Stdlib.HttpServer.Quic.__Owner) (datagram: Option<Stdlib.__Datagram.Message>) (now: Int64) : Stdlib.Result.Result<Option<Stdlib.HttpServer.Quic.__Owner>, String> =
  let pending = Stdlib.Stream.__cellGet<List<Blob>> owner.outbox != [] in
  let phase = match owner.phase with
    | Handshake ((flight, deadline)) ->
      let received = match datagram with | None -> Ok flight | Some datagram -> Stdlib.__QuicServer.receive flight owner.peer datagram now in
      received |> Stdlib.Result.mapError Stdlib.__QuicConnection.__opaque |> Stdlib.Result.andThen (fun flight ->
        if now >= deadline then Error (Stdlib.__QuicConnection.Failure.OpaqueFailure "QUIC server handshake timed out")
        else if pending then Ok (Stdlib.HttpServer.Quic.__Phase.Handshake ((flight, deadline)))
        else Stdlib.__QuicServer.advance owner.socket owner.peer flight None now deadline |> Stdlib.Result.mapError Stdlib.__QuicConnection.__opaque |> Stdlib.Result.andThen (fun progress ->
          match progress with
          | Waiting flight -> Ok (Stdlib.HttpServer.Quic.__Phase.Handshake ((flight, deadline)))
          | Complete ready -> Stdlib.__QuicConnection.fromServer ready context.signals |> Stdlib.Result.map (fun connection ->
              Stdlib.HttpServer.Quic.__Phase.Initializing (Stdlib.HttpServer.Quic.__Bootstrap { connection = connection, opened = false, index = 0L, offset = 0L, deadline = now + 10000L }))))
    | Initializing state ->
      Stdlib.HttpServer.Quic.__input state.connection datagram now |> Stdlib.Result.andThen (fun connection ->
        (
        if pending then
          if now >= state.deadline then Error "HTTP/3 initial stream credit timed out" else Ok (Stdlib.HttpServer.Quic.__Phase.Initializing { state with connection = connection })
        else Stdlib.__QuicConnection.__tick connection now |> Stdlib.Result.andThen (fun connection -> Stdlib.HttpServer.Quic.__bootstrap { state with connection = connection } now)) |> Stdlib.Result.mapError Stdlib.__QuicConnection.__opaque)
    | Serving state ->
      Stdlib.HttpServer.Quic.__input state.wire.connection datagram now |> Stdlib.Result.andThen (fun connection ->
        (
        let state = { state with wire = { state.wire with connection = connection } } in
        if Stdlib.Option.isSome connection.meta.closed then Ok (Stdlib.HttpServer.Quic.__Phase.Draining ((connection, now)))
        else if pending then Stdlib.__QuicConnection.__idle connection now |> Stdlib.Result.map (fun _unit -> Stdlib.HttpServer.Quic.__Phase.Serving state)
        else if (state.goAwaySent && state.streams == []) || (now >= state.deadline && state.streams == []) then Ok (Stdlib.HttpServer.Quic.__Phase.Draining ((connection, now + 10000L)))
        else Stdlib.__Http3Server.step (Stdlib.__Http3Server.Context { config = context.config, handler = handler, limit = context.limit }) state now
          |> Stdlib.Result.andThen (fun state -> Stdlib.__QuicConnection.__tick state.wire.connection now |> Stdlib.Result.map (fun connection ->
            Stdlib.HttpServer.Quic.__Phase.Serving { state with wire = { state.wire with connection = connection } }))) |> Stdlib.Result.mapError Stdlib.__QuicConnection.__opaque)
    | Draining ((connection, deadline)) ->
      Stdlib.HttpServer.Quic.__input connection datagram now |> Stdlib.Result.andThen (fun connection ->
        (
        if Stdlib.Option.isSome connection.meta.closed then Ok (Stdlib.HttpServer.Quic.__Phase.Draining ((connection, now)))
        else if pending then
          if now >= deadline then Error "QUIC output drain timed out"
          else Stdlib.__QuicConnection.__idle connection now |> Stdlib.Result.map (fun _unit -> Stdlib.HttpServer.Quic.__Phase.Draining ((connection, deadline)))
        else if now >= deadline || (connection.space.queued == [] && connection.space.recovery.congestion.inFlight == 0L) then
          Stdlib.__QuicConnection.__beginClose connection now (Stdlib.__QuicConnection.CloseReason.ApplicationCloseReason 256L) |> Stdlib.Result.map (fun closing -> Stdlib.HttpServer.Quic.__Phase.Closing closing)
        else Stdlib.__QuicConnection.__tick connection now |> Stdlib.Result.map (fun connection -> Stdlib.HttpServer.Quic.__Phase.Draining ((connection, deadline)))) |> Stdlib.Result.mapError Stdlib.__QuicConnection.__opaque)
    | Closing closing -> Ok (Stdlib.HttpServer.Quic.__Phase.Closing closing) in
  let phase = match phase with
    | Ok phase -> Ok phase
    | Error failure ->
      match failure with
      | OpaqueFailure message -> Error message
      | TransportFailure ((connection, kind, error)) ->
        // Keep the child and its sealed outbox alive until the listener flushes
        // this transport close. Closing immediately would dispose the packet.
        Stdlib.__QuicConnection.__beginClose connection now (Stdlib.__QuicConnection.CloseReason.TransportCloseReason ((error.code, kind)))
          |> Stdlib.Result.map (fun closing -> Stdlib.HttpServer.Quic.__Phase.Closing closing) in
  phase |> Stdlib.Result.map (fun phase ->
    match phase with
    | Draining ((connection, _deadline)) -> if Stdlib.Option.isSome connection.meta.closed then None else Some { owner with phase = phase }
    | Closing closing -> if now >= closing.deadline then None else Some { owner with phase = phase }
    | _ -> Some { owner with phase = phase })

let __retry (socket: Stdlib.__Datagram.Socket) (secret: Blob) (peer: Stdlib.__Datagram.Endpoint) (packet: Stdlib.__QuicPacket.Protected) (now: Int64) : Unit =
  if Stdlib.Blob.__byteLength packet.destination < 8L then ()
  else match Stdlib.Crypto.__secureRandomBytes 8L with
  | Error _ -> ()
  | Ok source -> match Stdlib.__QuicServerRetry.create secret peer packet.destination packet.source source now with
    | Error _ -> ()
    | Ok retry -> let _ = Stdlib.__Datagram.pollSend socket peer retry in ()

let __route (context: Stdlib.HttpServer.Quic.Context) (state: Stdlib.HttpServer.Quic.__Runtime) (datagram: Stdlib.__Datagram.Message) (now: Int64) : Stdlib.HttpServer.Quic.__Runtime =
  match Stdlib.__QuicPacket.parse 8L datagram.payload with
  | Ok (Protected packet) ->
    if Stdlib.List.any state.owners (fun owner -> Stdlib.__QuicClient.__same owner.source packet.destination) then state
    else if Stdlib.List.any state.recent (fun entry -> Stdlib.__QuicClient.__same entry.source packet.destination) then
      // Only a successful send returns a new closing nonce. Failure retires
      // the keys rather than retrying encryption from the previous number.
      let immediate = { context.socket with send = fun peer bytes _timeout ->
        context.socket.send peer bytes 0L } in
      { state with recent = Stdlib.List.map state.recent (fun entry ->
          match entry.closing with
          | Some closing ->
            if Stdlib.__QuicClient.__same closing.source packet.destination && closing.peer == datagram.peer then
              { entry with closing = (match Stdlib.__QuicConnection.repeatClose immediate closing now with | Ok next -> Some next | Error _ -> None) }
            else entry
          | None -> entry) }
    else if packet.kind != Stdlib.__QuicPacket.Kind.Initial || Stdlib.Blob.__byteLength datagram.payload < 1200L then state
    else if Stdlib.Blob.__byteLength packet.token == 0L then
      let _ = Stdlib.HttpServer.Quic.__retry context.socket context.secret datagram.peer packet now in
      state
    else if Stdlib.List.length state.recent >= 256 || Stdlib.List.length state.owners >= 64 then state
    else match Stdlib.__QuicServerRetry.validate context.secret datagram.peer packet now with
    | Error _ -> state
    | Ok _ ->
      let recent = state.recent @ [Stdlib.HttpServer.Quic.Recent { source = packet.destination, expires = now + 30000L, closing = None }] in
      match Stdlib.__QuicServer.start context.identity context.secret datagram now with
      | Error _ -> { state with recent = recent }
      | Ok flight ->
        let (socket, outbox) = Stdlib.HttpServer.Quic.__socket datagram.peer in
        { state with recent = recent, owners = state.owners @ [Stdlib.HttpServer.Quic.__Owner { source = packet.destination, peer = datagram.peer,
            socket = socket, outbox = outbox, phase = Stdlib.HttpServer.Quic.__Phase.Handshake ((flight, now + 10000L)) }] }
  | _ -> state
// Count retained transport payloads as well as buffered HTTP bodies. The
// listener shares a 101 MiB payload budget instead of multiplying a per-owner
// body limit by the sixty-four connection slots.
let __spaceSize (space: Stdlib.__QuicSpace.State) : Int64 =
  Stdlib.List.fold space.queued 0L (fun size frame -> size + Stdlib.Blob.__byteLength frame.payload) +
  Stdlib.List.fold space.recovery.packets 0L (fun size packet -> size + Stdlib.Blob.__byteLength packet.payload) +
  Stdlib.List.fold space.crypto.segments 0L (fun size segment -> size + Stdlib.Blob.__byteLength segment.bytes)

let __connectionSize (connection: Stdlib.__QuicConnection.State) : Int64 =
  Stdlib.HttpServer.Quic.__spaceSize connection.space + Stdlib.Blob.__byteLength connection.meta.ticketBytes +
  (match connection.meta.handshake with | None -> 0L | Some handshake -> Stdlib.HttpServer.Quic.__spaceSize handshake.space) +
  Stdlib.List.fold connection.flow.channels 0L (fun size channel ->
    size + (match channel.receive with | None -> 0L | Some receive -> Stdlib.List.fold receive.buffer.segments 0L (fun size segment -> size + Stdlib.Blob.__byteLength segment.bytes)))

let __size (owner: Stdlib.HttpServer.Quic.__Owner) : Int64 =
  let queued = Stdlib.List.fold (Stdlib.Stream.__cellGet<List<Blob>> owner.outbox) 0L (fun size packet -> size + Stdlib.Blob.__byteLength packet) in
  queued + (match owner.phase with
    | Handshake ((flight, _deadline)) -> Stdlib.HttpServer.Quic.__spaceSize flight.initial + Stdlib.HttpServer.Quic.__spaceSize flight.handshake + Stdlib.List.fold flight.pending 0L (fun size bytes -> size + Stdlib.Blob.__byteLength bytes)
    | Initializing state -> Stdlib.HttpServer.Quic.__connectionSize state.connection
    | Serving state -> state.total + Stdlib.HttpServer.Quic.__connectionSize state.wire.connection
    | Draining ((connection, _deadline)) -> Stdlib.HttpServer.Quic.__connectionSize connection
    | Closing _ -> 0L)

let __total (owners: List<Stdlib.HttpServer.Quic.__Owner>) : Int64 =
  Stdlib.List.fold owners 0L (fun size owner -> size + Stdlib.HttpServer.Quic.__size owner)

let __roundOwners (context: Stdlib.HttpServer.Quic.Context) (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (recent: List<Stdlib.HttpServer.Quic.Recent>) (datagram: Option<Stdlib.__Datagram.Message>) (remaining: List<Stdlib.HttpServer.Quic.__Owner>) (next: List<Stdlib.HttpServer.Quic.__Owner>) : Stdlib.Result.Result<Stdlib.HttpServer.Quic.__Runtime, String> =
  match remaining with
  | [] -> Ok (Stdlib.HttpServer.Quic.__Runtime { recent = recent, owners = Stdlib.List.reverse next })
  | owner :: rest ->
    match Stdlib.__Network.monotonicMillis () with
    | Error _ -> let _ = Stdlib.HttpServer.Quic.__closeAll (remaining @ next) in Error "QUIC listener clock failed"
    | Ok now ->
      let input = match datagram with
        | Some datagram -> if datagram.peer == owner.peer && (match Stdlib.__QuicPacket.parse 8L datagram.payload with | Ok (Protected packet) -> Stdlib.__QuicClient.__same owner.source packet.destination | _ -> false) then Some datagram else None
        | None -> None in
      let result = Stdlib.HttpServer.Quic.__advance context handler owner input now |> Stdlib.Result.andThen (fun candidate ->
        match candidate with | None -> Ok candidate | Some candidate -> Stdlib.HttpServer.Quic.__flush context candidate |> Stdlib.Result.map (fun _unit -> Some candidate)) in
      match result with
      | Error _ -> let _ = Stdlib.__Datagram.close owner.socket in Stdlib.HttpServer.Quic.__roundOwners context handler recent datagram rest next
      | Ok None -> let _ = Stdlib.__Datagram.close owner.socket in Stdlib.HttpServer.Quic.__roundOwners context handler recent datagram rest next
      | Ok (Some candidate) ->
        if Stdlib.HttpServer.Quic.__size candidate + Stdlib.HttpServer.Quic.__total (rest @ next) > 105906176L then
          let _ = Stdlib.__Datagram.close candidate.socket in Stdlib.HttpServer.Quic.__roundOwners context handler recent datagram rest next
        else match candidate.phase with
        | Closing closing ->
          if Stdlib.Stream.__cellGet<List<Blob>> candidate.outbox != [] then Stdlib.HttpServer.Quic.__roundOwners context handler recent datagram rest (Stdlib.List.push next candidate)
          else
            let _ = Stdlib.__Datagram.close candidate.socket in
            let recent = Stdlib.List.map recent (fun entry -> if Stdlib.__QuicClient.__same entry.source candidate.source then { entry with expires = if closing.deadline > entry.expires then closing.deadline else entry.expires, closing = Some closing } else entry) in
            Stdlib.HttpServer.Quic.__roundOwners context handler recent datagram rest next
        | _ -> Stdlib.HttpServer.Quic.__roundOwners context handler recent datagram rest (Stdlib.List.push next candidate)

// One routed datagram and one packet send per owner per round. Owners never
// receive from the shared socket; unrelated CIDs and peers cannot steal input.
let __round (context: Stdlib.HttpServer.Quic.Context) (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (state: Stdlib.HttpServer.Quic.__Runtime) (datagram: Option<Stdlib.__Datagram.Message>) : Stdlib.Result.Result<Stdlib.HttpServer.Quic.__Runtime, String> =
  Stdlib.HttpServer.Quic.__roundOwners context handler state.recent datagram state.owners []

let __step (context: Stdlib.HttpServer.Quic.Context) (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (state: Stdlib.HttpServer.Quic.__Runtime) (timeout: Int64) : Stdlib.Result.Result<Stdlib.HttpServer.Quic.Step, String> =
  match Stdlib.__Network.shutdownRequested context.signals, Stdlib.__Network.monotonicMillis () with
  | Ok true, _ -> let _ = Stdlib.HttpServer.Quic.__closeAll state.owners in
    Ok (Stdlib.HttpServer.Quic.Step { state = { state with owners = [] }, stopped = true })
  | Ok false, Ok now ->
    let recent = Stdlib.List.filter state.recent (fun entry -> entry.expires > now || Stdlib.List.any state.owners (fun owner -> Stdlib.__QuicClient.__same owner.source entry.source))
      |> Stdlib.List.map (fun entry -> match entry.closing with | Some closing -> if closing.deadline <= now then { entry with closing = None } else entry | None -> entry) in
    let received = if timeout == 0L then Stdlib.__Datagram.poll context.socket else Stdlib.__Datagram.receive context.socket timeout |> Stdlib.Result.map (fun datagram -> Some datagram) in
    match received with
    | Error code ->
      if code == 4L || code == 11L || code == 35L || code == 90L then
        Stdlib.HttpServer.Quic.__round context handler { state with recent = recent } None |> Stdlib.Result.map (fun state -> Stdlib.HttpServer.Quic.Step { state = state, stopped = false })
      else let _ = Stdlib.HttpServer.Quic.__closeAll state.owners in
        Error "HTTP/3 listener receive failed"
    | Ok datagram ->
      let routed = match datagram with | None -> { state with recent = recent } | Some datagram -> Stdlib.HttpServer.Quic.__route context { state with recent = recent } datagram now in
      Stdlib.HttpServer.Quic.__round context handler routed datagram |> Stdlib.Result.map (fun state -> Stdlib.HttpServer.Quic.Step { state = state, stopped = false })
  | _, _ -> let _ = Stdlib.HttpServer.Quic.__closeAll state.owners in
    Error "HTTP/3 server shutdown or clock check failed"

let __loop (context: Stdlib.HttpServer.Quic.Context) (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (state: Stdlib.HttpServer.Quic.__Runtime) : Stdlib.Result.Result<Unit, String> =
  match Stdlib.HttpServer.Quic.__step context handler state 0L with
  | Error message -> Error message
  | Ok step ->
    if step.stopped then Ok ()
    else match context.socket.watch with
    | None -> let _ = Stdlib.HttpServer.Quic.__closeAll step.state.owners in Error "HTTP/3 listener has no native readiness watch"
    | Some watch ->
      let writable = Stdlib.List.any step.state.owners (fun owner -> Stdlib.Stream.__cellGet<List<Blob>> owner.outbox != []) in
      match Stdlib.__Network.waitSockets [Stdlib.__Network.Interest { watch = watch, readable = true, writable = writable }] (if step.state.owners == [] then 100L else 10L) with
      | Error 4L -> Stdlib.HttpServer.Quic.__loop context handler step.state
      | Error _ -> let _ = Stdlib.HttpServer.Quic.__closeAll step.state.owners in Error "HTTP/3 listener readiness failed"
      | Ok events ->
        if Stdlib.List.any events (fun event -> event.closed || event.failed) then let _ = Stdlib.HttpServer.Quic.__closeAll step.state.owners in Error "HTTP/3 listener closed"
        else Stdlib.HttpServer.Quic.__loop context handler step.state

/// Serve bounded multiplexed HTTPS requests per authenticated QUIC v1 connection. Import the
/// certificate chain and private key with TlsServerIdentity.create. Every new
/// connection proves its source address with Retry before a certificate flight.
/// The shared UDP listener returns normally on SIGINT or SIGTERM.
let serveOn (address: List<Int64>) (config: Stdlib.HttpServer.Config.Config) (identity: Stdlib.TlsServerIdentity.Identity) (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (onListening: Unit -> Unit) : Stdlib.Result.Result<Unit, String> =
  match Stdlib.Int.toInt64 config.port, Stdlib.Int.toInt64 config.maxBodyBytes with
  | Some port, Some limit ->
    if port <= 0L || port > 65535L || limit < 0L || limit > 104857600L then Error "Invalid HTTP/3 server configuration"
    else match Stdlib.__Network.shutdownSignals () with
    | Error _ -> Error "HTTP/3 shutdown setup failed"
    | Ok signals ->
      let result = match Stdlib.Crypto.__secureRandomBytes 32L with
        | Error _ -> Error "HTTP/3 Retry key generation failed"
        | Ok secret -> match (if Stdlib.List.length address == 16 then Stdlib.__Datagram.bind6 address port else Stdlib.__Datagram.bind4 address port) with
          | Error _ -> Error "Cannot bind HTTP/3 server"
          | Ok socket ->
            onListening ()
            let context = Stdlib.HttpServer.Quic.Context { config = config, identity = identity, signals = signals, socket = socket, secret = secret, limit = limit } in
            let result = Stdlib.HttpServer.Quic.__loop context handler (Stdlib.HttpServer.Quic.__initial ()) in
            Stdlib.__Datagram.close socket
            result in
      Stdlib.__Network.closeShutdownSignals signals
      result
  | _, _ -> Error "Invalid HTTP/3 server configuration"

/// Serve on the default IPv4 wildcard address. Use serveOn for IPv6 or an explicit interface.
let serve (config: Stdlib.HttpServer.Config.Config) (identity: Stdlib.TlsServerIdentity.Identity) (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (onListening: Unit -> Unit) : Stdlib.Result.Result<Unit, String> =
  Stdlib.HttpServer.Quic.serveOn [0L, 0L, 0L, 0L] config identity handler onListening
