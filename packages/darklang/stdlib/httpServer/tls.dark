// HttpServerTls.dark - Owned TLS serving with incremental handshakes and HTTP/1.1 persistence.
module Darklang.Stdlib.HttpServer.Tls

let __handler (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (request: Stdlib.Http.Request) : Stdlib.Http.Response =
  let url = if Stdlib.String.startsWith request.url "http://" then "https://" ++ Stdlib.String.dropFirst request.url 7 else request.url in
  handler (Stdlib.Http.Request { url = url, headers = request.headers, body = request.body })

let __loop (config: Stdlib.HttpServer.Config.Config) (identity: Stdlib.TlsServerIdentity.Identity) (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (signals: Stdlib.__Network.ShutdownSignals) (listener: Stdlib.__Network.TcpListener) (limit: Int64) : Stdlib.Result.Result<Unit, String> =
  Stdlib.__TlsServer.serve config identity handler signals listener limit

/// Import the certificate and key with TlsServerIdentity.create before serving.
/// Bind before announcing and return normally on SIGINT or SIGTERM, including
/// while a peer holds an incomplete TLS handshake or HTTP request open.
let serveOn (address: List<Int64>) (config: Stdlib.HttpServer.Config.Config) (identity: Stdlib.TlsServerIdentity.Identity) (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (onListening: Unit -> Unit) : Stdlib.Result.Result<Unit, String> =
  match Stdlib.Int.toInt64 config.port, Stdlib.Int.toInt64 config.maxBodyBytes with
  | Some port, Some limit ->
    if port <= 0L || port > 65535L || limit < 0L || limit > 104857600L then Error "Invalid TLS HTTP server configuration"
    else match Stdlib.__Network.shutdownSignals () with
    | Error _ -> Error "TLS HTTP shutdown setup failed"
    | Ok signals ->
      let result = match (if Stdlib.List.length address == 16 then Stdlib.__Network.listenTcp6 address port else Stdlib.__Network.listenTcp4 address port) with
                   | Error _ -> Error "Cannot bind TLS HTTP server"
                   | Ok listener ->
                     let _ = onListening () in
                     let result = Stdlib.HttpServer.Tls.__loop config identity handler signals listener limit in
                     let _ = Stdlib.__Network.closeListener listener in
                     result in
      let _ = Stdlib.__Network.closeShutdownSignals signals in
      result
  | _, _ -> Error "Invalid TLS HTTP server configuration"

/// Serve on the default IPv4 wildcard address. Use serveOn for IPv6 or an explicit interface.
let serve (config: Stdlib.HttpServer.Config.Config) (identity: Stdlib.TlsServerIdentity.Identity) (handler: Stdlib.Http.Request -> Stdlib.Http.Response) (onListening: Unit -> Unit) : Stdlib.Result.Result<Unit, String> =
  Stdlib.HttpServer.Tls.serveOn [0L, 0L, 0L, 0L] config identity handler onListening
