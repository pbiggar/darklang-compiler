// Stdlib.UInt32.dark - Stdlib.UInt32 definitions
//
// Split from stdlib.dark for modular stdlib loading.

module Darklang.Stdlib.UInt32

type ParseError = BadFormat | OutOfRange

// Stdlib.UInt32 - Integer operations

let add (a: UInt32) (b: UInt32) : UInt32 = a + b

let subtract (a: UInt32) (b: UInt32) : UInt32 = a - b

let multiply (a: UInt32) (b: UInt32) : UInt32 = a * b

let divide (a: UInt32) (b: UInt32) : UInt32 = if b == 0ul then Builtin.crash "Cannot divide by 0" else a / b

let max (a: UInt32) (b: UInt32) : UInt32 = if a > b then a else b

let min (a: UInt32) (b: UInt32) : UInt32 = if a < b then a else b

let mod (a: UInt32) (b: UInt32) : UInt32 = if b == 0ul then Builtin.crash "Cannot evaluate modulus against 0" else a % b



let __powerLoop (base: UInt32) (exponent: UInt32) (result: UInt32) : UInt32 =
    if exponent == 0ul then result
    else
        let next = if (exponent % 2ul) == 1ul then result * base else result in
        Stdlib.UInt32.__powerLoop (base * base) (exponent / 2ul) next
let power (base: UInt32) (exponent: UInt32) : UInt32 = Stdlib.UInt32.__powerLoop base exponent 1ul

let clamp (value: UInt32) (limitA: UInt32) (limitB: UInt32) : UInt32 =
    let lower = Stdlib.UInt32.min limitA limitB in
    let upper = Stdlib.UInt32.max limitA limitB in
    Stdlib.UInt32.max lower (Stdlib.UInt32.min upper value)

let greaterThan (a: UInt32) (b: UInt32) : Bool = a > b

let greaterThanOrEqualTo (a: UInt32) (b: UInt32) : Bool = a >= b

let lessThan (a: UInt32) (b: UInt32) : Bool = a < b

let lessThanOrEqualTo (a: UInt32) (b: UInt32) : Bool = a <= b

// Count number of set bits (population count)
// Uses parallel bit counting algorithm (SWAR)
let __popcount (x: UInt32) : UInt32 =
    let mask1 = 1431655765ul in
    let mask2 = 858993459ul in
    let mask3 = 252645135ul in
    let mask4 = 63ul in
    let x = x - Stdlib.UInt32.bitwiseAnd (Stdlib.UInt32.shiftRight x 1ul) mask1 in
    let x = Stdlib.UInt32.bitwiseAnd x mask2 + Stdlib.UInt32.bitwiseAnd (Stdlib.UInt32.shiftRight x 2ul) mask2 in
    let x = Stdlib.UInt32.bitwiseAnd (x + Stdlib.UInt32.shiftRight x 4ul) mask3 in
    let x = x + Stdlib.UInt32.shiftRight x 8ul in
    let x = x + Stdlib.UInt32.shiftRight x 16ul in
    Stdlib.UInt32.bitwiseAnd x mask4

// Convert a single digit (0ul-9ul) to its string representation
let __digitToString (n: UInt32) : String =
    match n with
    | 0ul -> "0"
    | 1ul -> "1"
    | 2ul -> "2"
    | 3ul -> "3"
    | 4ul -> "4"
    | 5ul -> "5"
    | 6ul -> "6"
    | 7ul -> "7"
    | 8ul -> "8"
    | 9ul -> "9"
    | _ -> "?"

// Convert an integer to its string representation
let toString (n: UInt32) : String =
    if n < 10ul then Stdlib.UInt32.__digitToString n
    else Stdlib.UInt32.toString (n / 10ul) + Stdlib.UInt32.__digitToString (n % 10ul)

// Sum all integers in a list
let sum (list: List<UInt32>) : UInt32 =
    Stdlib.List.fold list 0ul (fun acc x -> acc + x)

let __fromIntUnchecked (value: Int) : UInt32 =
    match Stdlib.Int.toUInt32 value with
    | Some result -> result
    | None -> Builtin.crash "Internal UInt32 conversion invariant failed"
let random (start: UInt32) (finish: UInt32) : UInt32 = Stdlib.UInt32.__fromIntUnchecked (Stdlib.Int.random (Stdlib.Int.fromUInt32 start) (Stdlib.Int.fromUInt32 finish))
let toFloat (value: UInt32) : Float = Stdlib.Int.toFloat (Stdlib.Int.fromUInt32 value)
let sqrt (value: UInt32) : Float = Stdlib.Float.sqrt (Stdlib.UInt32.toFloat value)
let parse (value: String) : Stdlib.Result.Result<UInt32, Stdlib.UInt32.ParseError> =
    match Stdlib.Int.parse value with
    | Error _ -> Error Stdlib.UInt32.ParseError.BadFormat
    | Ok parsed ->
        match Stdlib.Int.toUInt32 parsed with
        | None -> Error Stdlib.UInt32.ParseError.OutOfRange
        | Some result -> Ok result
let fromInt8 (value: Int8) : Stdlib.Option.Option<UInt32> = Stdlib.Int.toUInt32 (Stdlib.Int.fromInt8 value)
let fromUInt8 (value: UInt8) : UInt32 = Stdlib.UInt32.__fromIntUnchecked (Stdlib.Int.fromUInt8 value)
let fromInt16 (value: Int16) : Stdlib.Option.Option<UInt32> = Stdlib.Int.toUInt32 (Stdlib.Int.fromInt16 value)
let fromUInt16 (value: UInt16) : UInt32 = Stdlib.UInt32.__fromIntUnchecked (Stdlib.Int.fromUInt16 value)
let fromInt32 (value: Int32) : Stdlib.Option.Option<UInt32> = Stdlib.Int.toUInt32 (Stdlib.Int.fromInt32 value)
let fromInt64 (value: Int64) : Stdlib.Option.Option<UInt32> = Stdlib.Int.toUInt32 (Stdlib.Int.fromInt64 value)
let fromUInt64 (value: UInt64) : Stdlib.Option.Option<UInt32> = Stdlib.Int.toUInt32 (Stdlib.Int.fromUInt64 value)
let fromInt128 (value: Int128) : Stdlib.Option.Option<UInt32> = Stdlib.Int.toUInt32 (Stdlib.Int.fromInt128 value)
let fromUInt128 (value: UInt128) : Stdlib.Option.Option<UInt32> = Stdlib.Int.toUInt32 (Stdlib.Int.fromUInt128 value)

// Trait implementations reuse the compiler's existing native operations.

impl Stdlib.Add for UInt32 =
  let add = Stdlib.UInt32.add

impl Stdlib.Subtract for UInt32 =
  let subtract = Stdlib.UInt32.subtract

impl Stdlib.Multiply for UInt32 =
  let multiply = Stdlib.UInt32.multiply

impl Stdlib.Divide for UInt32 =
  let divide = Stdlib.UInt32.divide

impl Stdlib.Modulo for UInt32 =
  let modulo = Stdlib.UInt32.mod

impl Stdlib.Power for UInt32 =
  let power = Stdlib.UInt32.power

impl Stdlib.BitwiseAnd for UInt32 =
  let bitwiseAnd = Stdlib.UInt32.bitwiseAnd

impl Stdlib.BitwiseOr for UInt32 =
  let bitwiseOr = Stdlib.UInt32.bitwiseOr

impl Stdlib.BitwiseXor for UInt32 =
  let bitwiseXor = Stdlib.UInt32.bitwiseXor

impl Stdlib.BitwiseNot for UInt32 =
  let bitwiseNot = Stdlib.UInt32.bitwiseNot

impl Stdlib.ShiftLeft for UInt32 =
  let shiftLeft = Stdlib.UInt32.shiftLeft

impl Stdlib.ShiftRight for UInt32 =
  let shiftRight = Stdlib.UInt32.shiftRight

impl Stdlib.ToString for UInt32 =
  let toString = Stdlib.UInt32.toString

impl Stdlib.Compare for UInt32 =
  let lessThan = Stdlib.UInt32.lessThan
  let lessThanOrEqualTo = Stdlib.UInt32.lessThanOrEqualTo
  let greaterThan = Stdlib.UInt32.greaterThan
  let greaterThanOrEqualTo = Stdlib.UInt32.greaterThanOrEqualTo

impl Stdlib.Zero for UInt32 =
  let zero () : UInt32 = 0ul

impl Stdlib.One for UInt32 =
  let one () : UInt32 = 1ul
