// __Http2Fields.dark - HTTP/2 and HTTP/3 pseudo-header and message validation.
module Darklang.Stdlib.__Http2Fields

type Fields = { pseudo: List<(String * String)>, headers: List<(String * String)> }
type RequestHead = { method: String, url: String, headers: List<(String * String)> }
type ResponseHead = { status: Int64, headers: List<(String * String)> }

let __find (headers: List<(String * String)>) (key: String) : Stdlib.Option.Option<String> =
  match headers with
  | [] -> None
  | (name, value) :: rest -> if name == key then Some value else Stdlib.__Http2Fields.__find rest key

let __connectionSpecific (name: String) : Bool =
  name == "connection" || name == "proxy-connection" || name == "keep-alive" ||
  name == "transfer-encoding" || name == "upgrade"

let __split (fields: List<(String * String)>) (request: Bool) (trailer: Bool)
  (pseudo: List<(String * String)>) (regular: List<(String * String)>)
  : Stdlib.Result.Result<Stdlib.__Http2Fields.Fields, String> =
  match fields with
  | [] -> Ok (Stdlib.__Http2Fields.Fields {
      pseudo = Stdlib.List.reverse pseudo, headers = Stdlib.List.reverse regular })
  | (name, value) :: rest ->
    if name == "" || name != Stdlib.String.toLowercase name ||
       Stdlib.Bool.not (Stdlib.__HttpWire.__headerValueValid value 0L (Stdlib.String.__byteLength value)) then
      Error "Invalid HTTP/2 header field"
    else if Stdlib.String.startsWith name ":" then
      let permitted = if request then name == ":method" || name == ":scheme" ||
                           name == ":authority" || name == ":path" else name == ":status" in
      if trailer || regular != [] || Stdlib.Bool.not permitted ||
         Stdlib.Option.isSome (Stdlib.__Http2Fields.__find pseudo name) then
        Error "Invalid HTTP/2 pseudo-header"
      else Stdlib.__Http2Fields.__split rest request trailer (Stdlib.List.push pseudo (name, value)) regular
    else if Stdlib.Bool.not (Stdlib.__HttpWire.__tokenValid name 0L (Stdlib.String.__byteLength name)) ||
            Stdlib.__Http2Fields.__connectionSpecific name || (name == "te" && value != "trailers") then
      Error "Forbidden HTTP/2 header field"
    else Stdlib.__Http2Fields.__split rest request trailer pseudo (Stdlib.List.push regular (name, value))

let request (fields: List<(String * String)>) : Stdlib.Result.Result<Stdlib.__Http2Fields.RequestHead, String> =
  match Stdlib.__Http2Fields.__split fields true false [] [] with
  | Error message -> Error message
  | Ok split ->
    match Stdlib.__Http2Fields.__find split.pseudo ":method",
          Stdlib.__Http2Fields.__find split.pseudo ":scheme",
          Stdlib.__Http2Fields.__find split.pseudo ":authority",
          Stdlib.__Http2Fields.__find split.pseudo ":path" with
    | Some method, Some scheme, Some authority, Some path ->
      if method == "" || method == "CONNECT" ||
         Stdlib.Bool.not (Stdlib.__HttpWire.__tokenValid method 0L (Stdlib.String.__byteLength method)) ||
         (scheme != "http" && scheme != "https") || Stdlib.Bool.not (Stdlib.String.startsWith path "/") then
        Error "Invalid HTTP/2 request pseudo-headers"
      else
        let urlText = scheme ++ "://" ++ authority ++ path in
        match Stdlib.__HttpWire.parseUrl urlText with
        | Error _ -> Error "Invalid HTTP/2 request URL"
        | Ok _ ->
          match Stdlib.__Http2Fields.__find split.headers "host" with
          | Some host ->
            if host != authority then Error "HTTP/2 Host disagrees with authority"
            else Ok (Stdlib.__Http2Fields.RequestHead { method = method, url = urlText, headers = split.headers })
          | None -> Ok (Stdlib.__Http2Fields.RequestHead { method = method, url = urlText, headers = split.headers })
    | _, _, _, _ -> Error "Missing HTTP/2 request pseudo-header"

let response (fields: List<(String * String)>) : Stdlib.Result.Result<Stdlib.__Http2Fields.ResponseHead, String> =
  match Stdlib.__Http2Fields.__split fields false false [] [] with
  | Error message -> Error message
  | Ok split ->
    match Stdlib.__Http2Fields.__find split.pseudo ":status" with
    | None -> Error "Missing HTTP/2 status"
    | Some status ->
      if Stdlib.String.__byteLength status != 3L then Error "Invalid HTTP/2 status"
      else
        match Stdlib.Int64.parse status with
        | Error _ -> Error "Invalid HTTP/2 status"
        | Ok code ->
          if code < 100L || code > 599L || code == 101L then Error "Invalid HTTP/2 status"
          else Ok (Stdlib.__Http2Fields.ResponseHead { status = code, headers = split.headers })

let trailers (fields: List<(String * String)>) : Stdlib.Result.Result<Unit, String> =
  match Stdlib.__Http2Fields.__split fields false true [] [] with
  | Error message -> Error message
  | Ok split ->
    if Stdlib.Option.isSome (Stdlib.__Http2Fields.__find split.headers "content-length") then
      Error "Content-Length in HTTP trailers"
    else Ok ()

let __outgoing (headers: List<(String * String)>) : Stdlib.Result.Result<List<(String * String)>, String> =
  match headers with
  | [] -> Ok []
  | (name, value) :: rest ->
    let lower = Stdlib.String.toLowercase name in
    if name == "" || Stdlib.String.startsWith lower ":" ||
       Stdlib.Bool.not (Stdlib.__HttpWire.__tokenValid name 0L (Stdlib.String.__byteLength name)) ||
       Stdlib.Bool.not (Stdlib.__HttpWire.__headerValueValid value 0L (Stdlib.String.__byteLength value)) ||
       Stdlib.__Http2Fields.__connectionSpecific lower || (lower == "te" && value != "trailers") then
      Error "Invalid outgoing HTTP/2 header"
    else
      match Stdlib.__Http2Fields.__outgoing rest with
      | Error message -> Error message
      | Ok fields -> Ok (Stdlib.List.push fields (lower, value))

let requestFields (method: String) (url: Stdlib.__HttpWire.Url)
  (headers: List<(String * String)>) (body: Blob)
  : Stdlib.Result.Result<List<(String * String)>, String> =
  match Stdlib.__Http2Fields.__outgoing headers with
  | Error message -> Error message
  | Ok fields ->
    if Stdlib.Option.isSome (Stdlib.__Http2Fields.__find fields "host") ||
       Stdlib.Option.isSome (Stdlib.__Http2Fields.__find fields "content-length") || method == "CONNECT" then
      Error "Managed HTTP/2 request header cannot be overridden"
    else Ok ([(":method", method), (":scheme", url.scheme), (":authority", url.authority),
              (":path", url.target)] @ fields @
              [("content-length", Stdlib.Int64.toString (Stdlib.Blob.__byteLength body))])

let length (headers: List<(String * String)>) : Stdlib.Result.Result<Stdlib.Option.Option<Int64>, String> =
  match Stdlib.__HttpWire.__contentLength headers None with
  | Error _ -> Error "Invalid HTTP message Content-Length"
  | Ok length -> Ok length
