// Stdlib.List.dark - Stdlib.List definitions
//
// Split from stdlib.dark for modular stdlib loading.

module Darklang.Stdlib.List

// Stdlib.List - List operations
// Lists are direct-payload skew-binary random-access lists internally.

type ChunkBySizeError = | SizeMustBeGreaterThanZero

type IndexError =
  /// The resolved index was outside the bounds of the list.
  | IndexOutOfBounds

let setAt
  (list: List<'a>)
  (index: Int)
  (value: 'a)
  : Result.Result<List<'a>, IndexError> =
  let listLength = length list
  let resolvedIndex = if index < 0 then listLength + index else index

  if resolvedIndex < 0 || resolvedIndex >= listLength then
    Result.Result.Error IndexError.IndexOutOfBounds
  else
    Result.Result.Ok(
      indexedMap list (fun i v -> if i == resolvedIndex then value else v)
    )

val empty = []

// Check if list is empty - O(1)
let isEmpty<'t> (list: List<t>) : Bool =
    Stdlib.List.__isEmpty<t> list

// Get the public arbitrary-precision length of a list - O(1)
let length<'t> (list: List<t>) : Int =
    Stdlib.Int.fromInt64 (Stdlib.List.__length<t> list)

// Create a single-element list - O(1)
let singleton (value: 'a) : List<'a> =
  [ value ]

// Prepend an element to a list - O(1) worst case
let push<'t> (list: List<t>) (value: t) : List<t> =
    Stdlib.List.__push<t> list value

// Internal: force concrete monomorphization of push for compiler-generated list literals
let __pushInt64 (list: List<Int64>) (value: Int64) : List<Int64> =
    Stdlib.List.__push list value

// Apply a function to each element of a list - O(n)
let map<'a, 'b> (list: List<a>) (fn: a -> b) : List<b> =
    Stdlib.List.__map<a, b> list fn

let __mapHelper<'a, 'b> (list: List<a>) (fn: a -> b) (acc: List<b>) : List<b> =
    if Stdlib.List.__isEmpty<a> list then acc
    else
        match Stdlib.List.__head<a> list with
        | None -> acc
        | Some h ->
            let newAcc = Stdlib.List.__pushBack<b> acc (fn h) in
            Stdlib.List.__mapHelper<a, b> (Stdlib.List.__tail<a> list) fn newAcc

// Flatten a list of lists into a single list - O(n*m)
let flatten<'a> (lists: List<List<a>>) : List<a> =
    Stdlib.List.__flattenHelper<a> lists (Stdlib.List.__empty<a> ())

let __flattenHelper<'a> (lists: List<List<a>>) (acc: List<a>) : List<a> =
    if Stdlib.List.__isEmpty<List<a>> lists then Stdlib.List.__reverse<a> acc
    else
        match Stdlib.List.__head<List<a>> lists with
        | None -> Stdlib.List.__reverse<a> acc
        | Some h ->
            let newAcc = Stdlib.List.__flattenOneToReverse<a> h acc in
            Stdlib.List.__flattenHelper<a> (Stdlib.List.__tail<List<a>> lists) newAcc

let __flattenOneToReverse<'a> (list: List<a>) (acc: List<a>) : List<a> =
    if Stdlib.List.__isEmpty<a> list then acc
    else
        let next = Stdlib.List.__push<a> acc (Stdlib.List.__headUnsafe<a> list) in
        Stdlib.List.__flattenOneToReverse<a> (Stdlib.List.__tail<a> list) next

// Keep only elements that satisfy a predicate - O(n)
let filter<'a> (list: List<a>) (fn: (a) -> Bool) : List<a> =
    Stdlib.List.__reverse<a> (Stdlib.List.__filterToReverse<a> list fn (Stdlib.List.__empty<a> ()))

let __filterToReverse<'a> (list: List<a>) (fn: (a) -> Bool) (acc: List<a>) : List<a> =
    if Stdlib.List.__isEmpty<a> list then acc
    else
        let h = Stdlib.List.__headUnsafe<a> list in
        let next = if fn h then Stdlib.List.__push<a> acc h else acc in
        Stdlib.List.__filterToReverse<a> (Stdlib.List.__tail<a> list) fn next

let __filterHelper<'a> (list: List<a>) (fn: (a) -> Bool) (acc: List<a>) : List<a> =
    let len = Stdlib.List.__length<a> list in
    let filtered = Stdlib.List.__filterByIndexHelper<a> list fn 0L len (Stdlib.List.__empty<a> ()) in
    Stdlib.List.append<a> acc filtered

let __filterByIndexHelper<'a> (list: List<a>) (fn: (a) -> Bool) (index: Int64) (len: Int64) (accRev: List<a>) : List<a> =
    if index >= len then
        Stdlib.List.reverse<a> accRev
    else
        match Stdlib.List.__getAt<a> list index with
        | None -> Stdlib.List.reverse<a> accRev
        | Some v ->
            let nextAccRev = if fn v then Stdlib.List.push<a> accRev v else accRev in
            Stdlib.List.__filterByIndexHelper<a> list fn (index + 1L) len nextAccRev

// Append an element to the end of a list - O(n)
let pushBack<'a> (list: List<a>) (value: a) : List<a> =
    Stdlib.List.__pushBack<a> list value

// Concatenate two lists - O(length(list1))
let append<'a> (list1: List<a>) (list2: List<a>) : List<a> =
    Stdlib.List.__concat<a> list1 list2

// Reverse a list - O(n)
let reverse<'a> (list: List<a>) : List<a> =
    Stdlib.List.__reverse<a> list

let __reverseHelper<'a> (list: List<a>) (acc: List<a>) : List<a> =
    Stdlib.List.__reverseInto<a> list acc

let __reverseByIndexHelper<'a> (list: List<a>) (index: Int64) (acc: List<a>) : List<a> =
    if index < 0L then acc
    else
        match Stdlib.List.__getAt<a> list index with
        | None -> acc
        | Some v ->
            Stdlib.List.__reverseByIndexHelper<a> list (index - 1L) (Stdlib.List.__pushBack<a> acc v)

let sortByComparator
  (list: List<'a>)
  (fn: 'a -> 'a -> Int)
  : Result.Result<List<'a>, String> =
  SortByComparatorHelpers.mergeSort list fn

// Canonical interpreter ordering is synthesized per concrete AOT type.
let sort<'a> (list: List<a>) : List<a> =
    Stdlib.List.__canonicalSortHelper list []

let __canonicalInsert<'a> (value: a) (sorted: List<a>) : List<a> =
    match sorted with
    | [] -> [value]
    | head :: tail ->
        if __sort_precedes<a> value head then Stdlib.List.push<a> sorted value
        else Stdlib.List.push<a> (Stdlib.List.__canonicalInsert<a> value tail) head

let __canonicalSortHelper<'a> (remaining: List<a>) (sorted: List<a>) : List<a> =
    match remaining with
    | [] -> sorted
    | head :: tail -> Stdlib.List.__canonicalSortHelper<a> tail (Stdlib.List.__canonicalInsert<a> head sorted)

let __sortByValues<'key, 'value> (pairs: List<(key * value)>) : List<value> =
    match pairs with
    | [] -> []
    | (key, value) :: tail -> Stdlib.List.push<value> (Stdlib.List.__sortByValues<key, value> tail) value

let __sortByPairs<'a, 'b> (list: List<a>) (fn: a -> b) : List<(b * a)> =
    match list with
    | [] -> []
    | head :: tail -> Stdlib.List.push<(b * a)> (Stdlib.List.__sortByPairs<a, b> tail fn) ((fn head, head))

let sortBy<'a, 'b> (list: List<a>) (fn: a -> b) : List<a> =
    Stdlib.List.__sortByValues<b, a> (
        Stdlib.List.sort<(b * a)> (Stdlib.List.__sortByPairs<a, b> list fn))

let unique<'a> (list: List<a>) : List<a> =
    Stdlib.List.sort (Stdlib.List.__uniqueUnsorted list [])

let __uniqueUnsorted<'a> (remaining: List<a>) (uniqueValues: List<a>) : List<a> =
    match remaining with
    | [] -> uniqueValues
    | head :: tail ->
        let next = if Stdlib.List.contains<a> uniqueValues head then uniqueValues else Stdlib.List.push<a> uniqueValues head in
        Stdlib.List.__uniqueUnsorted<a> tail next

let uniqueBy<'a, 'b> (list: List<a>) (fn: a -> b) : List<a> =
    Stdlib.List.sort (Stdlib.List.__uniqueByHelper list fn [] [])

let __uniqueByHelper<'a, 'b> (remaining: List<a>) (fn: a -> b) (uniqueValues: List<a>) (seen: List<b>) : List<a> =
    match remaining with
    | [] -> uniqueValues
    | value :: tail ->
        let key = fn value in
        if Stdlib.List.__keyMember<b> seen key then Stdlib.List.__uniqueByHelper<a, b> tail fn uniqueValues seen
        else Stdlib.List.__uniqueByHelper<a, b> tail fn (Stdlib.List.push<a> uniqueValues value) (Stdlib.List.push<b> seen key)

// Dictionary key equality is total: NaNs, including nested NaNs, compare equal.
// Keep the ordered scan until a dictionary optimization passes its own gates.
let __keyMember<'a> (keys: List<a>) (key: a) : Bool =
    match keys with
    | [] -> false
    | head :: tail -> if __compare<a> head key == 0L then true else Stdlib.List.__keyMember<a> tail key

let dedup<'a> (list: List<a>) : List<a> =
    Stdlib.List.reverse (Stdlib.List.__dedup list [] [])

let __dedup<'a> (remaining: List<a>) (seen: List<a>) (result: List<a>) : List<a> =
    match remaining with
    | [] -> result
    | head :: tail ->
        if Stdlib.List.__keyMember seen head then Stdlib.List.__dedup tail seen result
        else Stdlib.List.__dedup tail (Stdlib.List.push seen head) (Stdlib.List.push result head)

// Fold left (reduce) over a list - O(n)
let fold<'a, 'b> (list: List<a>) (init: b) (fn: b -> a -> b) : b =
    if Stdlib.List.__isEmpty<a> list then init
    else
        match Stdlib.List.__head<a> list with
        | None -> init
        | Some h ->
            let newInit = fn init h in
            Stdlib.List.fold<a, b> (Stdlib.List.__tail<a> list) newInit fn

// Get head of list or return None - O(1)
let head (list: List<'a>) : Option.Option<'a> =
  match list with
  | [] -> Option.Option.None
  | head :: _ -> Option.Option.Some head

// Internal: get head without option wrapper (caller must ensure non-empty)
// This forces monomorphization of headUnsafe_i64 for pattern matching
let __headUnsafeInt64 (list: List<Int64>) : Int64 =
    Stdlib.List.__headUnsafe list

// Internal: get head without option wrapper for Float lists
let __headUnsafeFloat (list: List<Float>) : Float =
    Stdlib.List.__headUnsafe list

// Internal: get element at index (forces monomorphization for pattern matching)
let __getAtInt64 (list: List<Int64>) (idx: Int64) : Stdlib.Option.Option<Int64> =
    Stdlib.List.__getAt list idx

let __getAtFloat (list: List<Float>) (idx: Int64) : Stdlib.Option.Option<Float> =
    Stdlib.List.__getAt list idx

// Get tail of list or return None - O(1) worst case
let tail (list: List<'a>) : Option.Option<List<'a>> =
  match list with
  | [] -> Option.Option.None
  | _ :: tail -> Option.Option.Some tail

// Get element at an arbitrary-precision index (0-based) - O(log n)
let getAt<'a> (list: List<a>) (index: Int) : Stdlib.Option.Option<a> =
    match Stdlib.Int.toInt64 index with
    | None -> None
    | Some machineIndex -> Stdlib.List.__getAt<a> list machineIndex

// Find first element satisfying a predicate - O(n)
let findFirst<'a> (list: List<a>) (fn: (a) -> Bool) : Stdlib.Option.Option<a> =
    if Stdlib.List.__isEmpty<a> list then None
    else
        match Stdlib.List.__head<a> list with
        | None -> None
        | Some h ->
            if fn h then Some h
            else Stdlib.List.findFirst<a> (Stdlib.List.__tail<a> list) fn

// Take first n elements - O(n)
let take<'a> (list: List<a>) (n: Int) : List<a> =
    Stdlib.List.__takeHelper<a> list n (Stdlib.List.__empty<a> ())

let __takeHelper<'a> (list: List<a>) (n: Int) (acc: List<a>) : List<a> =
    if n <= 0 then Stdlib.List.__reverse<a> acc
    else if Stdlib.List.__isEmpty<a> list then Stdlib.List.__reverse<a> acc
    else
        match Stdlib.List.__head<a> list with
        | None -> Stdlib.List.__reverse<a> acc
        | Some h ->
            let newAcc = Stdlib.List.__push<a> acc h in
            Stdlib.List.__takeHelper<a> (Stdlib.List.__tail<a> list) (n - 1) newAcc

// Drop first n elements - O(n)
let drop (list: List<'a>) (count: Int) : List<'a> =
  if count <= 0 then
    list
  else
    match list with
    | [] -> []
    | _ :: tail -> drop tail (count - 1)

// Check if any element satisfies a predicate - O(n)
let any<'a> (list: List<a>) (fn: (a) -> Bool) : Bool =
    if Stdlib.List.__isEmpty<a> list then false
    else
        match Stdlib.List.__head<a> list with
        | None -> false
        | Some h ->
            if fn h then true
            else Stdlib.List.any<a> (Stdlib.List.__tail<a> list) fn

// Get the last element of a list, or None if empty - O(log n)
let last (list: List<'a>) : Option.Option<'a> =
  match list with
  | [] -> Option.Option.None
  | head :: tail ->
    match tail with
    | [] -> Option.Option.Some head
    | _ -> last tail

// Remove the last element from a list - O(n)
let dropLast (list: List<'a>) : List<'a> =
  match list with
  | [] -> []
  | head :: tail ->
    match tail with
    | [] -> []
    | _ -> push (dropLast tail) head

// Generate every Int from the lower through the upper bound, inclusively.
let range (start: Int) (end_: Int) : List<Int> =
    Stdlib.List.__rangeHelper start end_ (Stdlib.List.__empty ())

let __rangeHelper (current: Int) (end_: Int) (acc: List<Int>) : List<Int> =
    if current > end_ then Stdlib.List.__reverse acc
    else Stdlib.List.__rangeHelper (current + 1) end_ (Stdlib.List.__push acc current)

let repeatUnsafe (times: Int) (value: 'a) : List<'a> =
  if times <= 0 then
    []
  else
    push (repeatUnsafe (times - 1) value) value

let __repeatHelper<'a> (count: Int) (value: a) (acc: List<a>) : List<a> =
    if count <= 0 then acc
    else Stdlib.List.__repeatHelper<a> (count - 1) value (Stdlib.List.__push<a> acc value)

// Internal machine-sized form for compiler and benchmark workloads whose
// cardinality is already proven to fit the skew-list representation.
let __repeatInt64<'a> (count: Int64) (value: a) (acc: List<a>) : List<a> =
    if count <= 0L then acc
    else Stdlib.List.__repeatInt64<a> (count - 1L) value (Stdlib.List.__push<a> acc value)

// Repeat validates negative counts and preserves the interpreter's exact error.
let repeat
  (times: Int)
  (value: 'a)
  : Result.Result<List<'a>, String> =
  if times < 0 then
    Result.Result.Error
      $"Expected `times` to be positive, but it was `{times |> Stdlib.toString}`"
  else
    Result.Result.Ok(repeatUnsafe times value)

// Map with index: apply a function to each element along with its index - O(n)
let indexedMap<'a, 'b> (list: List<a>) (fn: Int -> a -> b) : List<b> =
    Stdlib.List.__indexedMapHelper<a, b> list fn 0 (Stdlib.List.__empty<b> ())

let __indexedMapHelper<'a, 'b> (list: List<a>) (fn: Int -> a -> b) (index: Int) (acc: List<b>) : List<b> =
    if Stdlib.List.__isEmpty<a> list then Stdlib.List.__reverse<b> acc
    else
        match Stdlib.List.__head<a> list with
        | None -> Stdlib.List.__reverse<b> acc
        | Some h ->
            let newAcc = Stdlib.List.__push<b> acc (fn index h) in
            Stdlib.List.__indexedMapHelper<a, b> (Stdlib.List.__tail<a> list) fn (index + 1) newAcc

// Partition a list into two lists based on a predicate
// Returns (elements where predicate is true, elements where predicate is false)
let partition (ls: List<'a>) (f: 'a -> Bool) : (List<'a> * List<'a>) =
  match ls with
  | [] -> ([], [])
  | head :: tail ->
    let (trueList, falseList) = partition tail f

    if (f head) then
      (push trueList head, falseList)
    else
      (trueList, push falseList head)

// Check if all elements satisfy a predicate, short-circuiting left-to-right.
let all (list: List<'a>) (fn: 'a -> Bool) : Bool =
  match list with
  | [] -> true
  | head :: tail -> if (fn head) then all tail fn else false

// Collection helpers ported from darklang/dark packages/darklang/stdlib/list.dark.
let findFirstIndex (list: List<'a>) (fn: 'a -> Bool) : Option.Option<Int> =
  list
  |> indexedMap (fun i item -> (i, item))
  |> findFirst (fun (_i, item) -> fn item)
  |> Stdlib.Option.map (fun (i, _item) -> i)

let __findFirstIndexHelper<'a> (list: List<a>) (fn: (a) -> Bool) (index: Int) : Stdlib.Option.Option<Int> =
    match list with
    | [] -> None
    | head :: tail -> if fn head then Some index else Stdlib.List.__findFirstIndexHelper<a> tail fn (index + 1)

let contains<'a> (list: List<a>) (value: a) : Bool =
    match list with
    | [] -> false
    | head :: tail -> if head == value then true else Stdlib.List.contains<a> tail value

let interpose (list: List<'a>) (sep: 'a) : List<'a> =
  match list with
  | [] -> []
  | [ single ] -> [ single ]
  | head :: tail ->
    (interpose tail sep)
    |> push sep
    |> push head

let interleave (lA: List<'a>) (lB: List<'a>) : List<'a> =
  match lA with
  | [] -> lB
  | aHead :: aTail ->
    match lB with
    | [] -> lA
    | bHead :: bTail ->
      (interleave aTail bTail)
      |> push bHead
      |> push aHead

let filterMap<'a, 'b> (list: List<a>) (fn: a -> Stdlib.Option.Option<b>) : List<b> =
    match list with
    | [] -> []
    | head :: tail ->
        match fn head with
        | Some value -> Stdlib.List.push<b> (Stdlib.List.filterMap<a, b> tail fn) value
        | None -> Stdlib.List.filterMap<a, b> tail fn

let dropWhile (list: List<'a>) (fn: 'a -> Bool) : List<'a> =
  match list with
  | [] -> []
  | head :: tail -> if (fn head) then dropWhile tail fn else list

let takeWhile (list: List<'a>) (fn: 'a -> Bool) : List<'a> =
  match list with
  | [] -> []
  | head :: tail ->
    if (fn head) then
      push (takeWhile tail fn) head
    else
      []

let map2shortest<'a, 'b, 'c> (listA: List<a>) (listB: List<b>) (fn: a -> b -> c) : List<c> =
    match (listA, listB) with
    | ([], _) -> []
    | (_, []) -> []
    | (headA :: tailA, headB :: tailB) ->
        Stdlib.List.push (Stdlib.List.map2shortest tailA tailB fn) (fn headA headB)

let map2
  (as_: List<'a>)
  (bs: List<'b>)
  (fn: 'a -> 'b -> 'c)
  : Option.Option<List<'c>> =
  if (length as_) != (length bs) then
    Option.Option.None
  else
    Option.Option.Some(map2shortest as_ bs fn)

let zipShortest<'a, 'b> (listA: List<a>) (listB: List<b>) : List<(a * b)> =
    match (listA, listB) with
    | ([], _) -> []
    | (_, []) -> []
    | (headA :: tailA, headB :: tailB) -> Stdlib.List.push<(a * b)> (Stdlib.List.zipShortest<a, b> tailA tailB) ((headA, headB))

let unzip (pairs: List<('a * 'b)>) : (List<'a> * List<'b>) =
  match pairs with
  | [] -> ([], [])
  | (a, b) :: tail ->
    let (firsts, seconds) = unzip tail

    (push firsts a, push seconds b)

let splitLast (l: List<'a>) : Option.Option<(List<'a> * 'a)> =
  match reverse l with
  | [] -> Option.Option.None
  | head :: tail -> Option.Option.Some((reverse tail, head))

let groupByWithKey<'a, 'b> (list: List<a>) (fn: a -> b) : List<(b * List<a>)> =
    Stdlib.List.__groupByWithKeyHelper list fn []

let __groupContainsKey<'a, 'b> (groups: List<(b * List<a>)>) (key: b) : Bool =
    match groups with
    | [] -> false
    | (groupKey, _) :: tail -> if groupKey == key then true else Stdlib.List.__groupContainsKey<a, b> tail key

let __appendToGroup<'a, 'b> (groups: List<(b * List<a>)>) (key: b) (element: a) : List<(b * List<a>)> =
    match groups with
    | [] -> []
    | (groupKey, groupElements) :: tail ->
        if groupKey == key then Stdlib.List.push<(b * List<a>)> tail ((groupKey, Stdlib.List.pushBack<a> groupElements element))
        else Stdlib.List.push<(b * List<a>)> (Stdlib.List.__appendToGroup<a, b> tail key element) ((groupKey, groupElements))

let __groupByWithKeyHelper<'a, 'b> (remaining: List<a>) (fn: a -> b) (groups: List<(b * List<a>)>) : List<(b * List<a>)> =
    match remaining with
    | [] -> groups
    | element :: tail ->
        let key = fn element in
        let retainedGroups = [groups] in
        let retainedKey = [key] in
        let retainedElement = [element] in
        if Stdlib.List.__groupContainsKey<a, b> groups key then
            match (retainedGroups, retainedKey, retainedElement) with
            | ([rootedGroups], [rootedKey], [rootedElement]) ->
                Stdlib.List.__groupByWithKeyHelper<a, b> tail fn (Stdlib.List.__appendToGroup<a, b> rootedGroups rootedKey rootedElement)
            | _ -> Builtin.crash "groupByWithKey retained state was empty"
        else
            match (retainedGroups, retainedKey, retainedElement) with
            | ([rootedGroups], [rootedKey], [rootedElement]) ->
                Stdlib.List.__groupByWithKeyHelper<a, b> tail fn (Stdlib.List.pushBack<(b * List<a>)> rootedGroups ((rootedKey, [rootedElement])))
            | _ -> Builtin.crash "groupByWithKey retained state was empty"

let iter (list: List<'a>) (f: 'a -> Unit) : Unit =
  match list with
  | [] -> ()
  | head :: tail ->
    f head
    iter tail f

let __randomIndex (bound: Int64) : Int64 =
    let sample = Stdlib.Int64.bitwiseAnd (Stdlib.Int64.random (-9223372036854775808L) 9223372036854775807L) 9223372036854775807L in
    let limit = 9223372036854775807L - (9223372036854775807L % bound) in
    if sample < limit then sample % bound else Stdlib.List.__randomIndex bound

let randomElement<'a> (list: List<a>) : Stdlib.Option.Option<a> =
    let length = Stdlib.List.__length<a> list in
    if length == 0L then None
    else Stdlib.List.__getAt<a> list (Stdlib.List.__randomIndex length)

let chunkBySizeHelper
  (currentList: List<'a>)
  (size: Int)
  (accum: List<List<'a>>)
  : List<List<'a>> =
  match currentList with
  | [] -> reverse accum
  | _ ->
    let taken = take currentList size
    let rest = drop currentList size

    let newAccum =
      if isEmpty taken then
        accum
      else
        push accum taken

    chunkBySizeHelper rest size newAccum

let chunkBySize
  (list: List<'a>)
  (size: Int)
  : Result.Result<List<List<'a>>, ChunkBySizeError> =
  if size <= 0 then
    Result.Result.Error
      ChunkBySizeError.SizeMustBeGreaterThanZero
  else
    Result.Result.Ok(chunkBySizeHelper list size [])

// Convert list to display string representation: "[elem1, elem2, ...]"
// Note: Generic version disabled due to function reference bug
// let Stdlib.List.toDisplayString<'a>(list: List<a>, elemToString: (a) -> String) : String =
//     let strs = Stdlib.List.map<a, String>(list, elemToString) in
//     "[" ++ Stdlib.String.join(strs, ", ") ++ "]"

// Type-specific toDisplayString implementations (workaround for function reference bug)

// Helper to build string list from Int64 list
let __int64sToStrings (list: List<Int64>) (acc: List<String>) : List<String> =
    if Stdlib.List.__isEmpty list then Stdlib.List.__reverse acc
    else
        match Stdlib.List.__head list with
        | None -> Stdlib.List.__reverse acc
        | Some h ->
            let s = Stdlib.Int64.toString h in
            let newAcc = Stdlib.List.__push acc s in
            Stdlib.List.__int64sToStrings (Stdlib.List.__tail list) newAcc

let __toDisplayString_i64 (list: List<Int64>) : String =
    let strs = Stdlib.List.__int64sToStrings list (Stdlib.List.__empty ()) in
    "[" + Stdlib.String.join strs ", " + "]"

let __intsToStrings (list: List<Int>) (acc: List<String>) : List<String> =
    if Stdlib.List.__isEmpty list then Stdlib.List.__reverse acc
    else
        match Stdlib.List.__head list with
        | None -> Stdlib.List.__reverse acc
        | Some h ->
            let next = Stdlib.List.__push acc (Stdlib.Int.toString h) in
            Stdlib.List.__intsToStrings (Stdlib.List.__tail list) next

let __toDisplayString_int (list: List<Int>) : String =
    let strs = Stdlib.List.__intsToStrings list (Stdlib.List.__empty ()) in
    "[" + Stdlib.String.join strs ", " + "]"

let __i64ListsToStrings (list: List<List<Int64>>) (acc: List<String>) : List<String> =
    if Stdlib.List.__isEmpty list then Stdlib.List.__reverse acc
    else
        match Stdlib.List.__head list with
        | None -> Stdlib.List.__reverse acc
        | Some h ->
            let s = Stdlib.List.__toDisplayString_i64 h in
            let newAcc = Stdlib.List.__push acc s in
            Stdlib.List.__i64ListsToStrings (Stdlib.List.__tail list) newAcc

let __toDisplayString_list_i64 (list: List<List<Int64>>) : String =
    let strs = Stdlib.List.__i64ListsToStrings list (Stdlib.List.__empty ()) in
    "[" + Stdlib.String.join strs ", " + "]"

// Helper to build string list from String list (with double quotes for display)
let __stringsToStrings (list: List<String>) (acc: List<String>) : List<String> =
    if Stdlib.List.__isEmpty list then Stdlib.List.__reverse acc
    else
        match Stdlib.List.__head list with
        | None -> Stdlib.List.__reverse acc
        | Some h ->
            let quoted = "\"" + h + "\"" in
            let newAcc = Stdlib.List.__push acc quoted in
            Stdlib.List.__stringsToStrings (Stdlib.List.__tail list) newAcc

let __quoteStringForDisplay (s: String) : String =
    "\"" + s + "\""

let __stringsDisplayItems (list: List<String>) (first: Bool) : String =
    match list with
    | [] -> ""
    | [h] ->
        if first then Stdlib.List.__quoteStringForDisplay h
        else ", " + Stdlib.List.__quoteStringForDisplay h
    | h :: t ->
        let item = Stdlib.List.__quoteStringForDisplay h in
        let rest = Stdlib.List.__stringsDisplayItems t false in
        if first then item + rest else ", " + item + rest

let __toDisplayString_str (list: List<String>) : String =
    "[" + Stdlib.List.__stringsDisplayItems list true + "]"

let __charsDisplayItems (list: List<Char>) (first: Bool) : String =
    match list with
    | [] -> ""
    | [h] ->
        if first then Stdlib.Char.toString h else ", " + Stdlib.Char.toString h
    | h :: t ->
        let rest = Stdlib.List.__charsDisplayItems t false in
        if first then Stdlib.Char.toString h + rest else ", " + Stdlib.Char.toString h + rest

let __toDisplayString_char (list: List<Char>) : String =
    "[" + Stdlib.List.__charsDisplayItems list true + "]"

// Helper to build string list from Bool list
let __boolsToStrings (list: List<Bool>) (acc: List<String>) : List<String> =
    if Stdlib.List.__isEmpty list then Stdlib.List.__reverse acc
    else
        match Stdlib.List.__head list with
        | None -> Stdlib.List.__reverse acc
        | Some h ->
            let s = Stdlib.Bool.toString h in
            let newAcc = Stdlib.List.__push acc s in
            Stdlib.List.__boolsToStrings (Stdlib.List.__tail list) newAcc

let __toDisplayString_bool (list: List<Bool>) : String =
    let strs = Stdlib.List.__boolsToStrings list (Stdlib.List.__empty ()) in
    "[" + Stdlib.String.join strs ", " + "]"

let __floatsDisplayItems (list: List<Float>) (first: Bool) : String =
    if Stdlib.List.__isEmpty list then ""
    else
        match Stdlib.List.__head list with
        | None -> ""
        | Some h ->
            let item = Stdlib.Float.toString h in
            let tail = Stdlib.List.__tail list in
            let rest = Stdlib.List.__floatsDisplayItems tail false in
            if first then item + rest else ", " + item + rest

let __toDisplayString_f64 (list: List<Float>) : String =
    "[" + Stdlib.List.__floatsDisplayItems list true + "]"

let zip (l1: List<'a>) (l2: List<'b>) : Option.Option<List<('a * 'b)>> =
  // The lengths once, then one native zip, rather than recursing and measuring both lengths
  // again at every level, which is quadratic in the length.
  if (length l1) != (length l2) then
    Option.Option.None
  else
    Option.Option.Some(zipShortest l1 l2)
