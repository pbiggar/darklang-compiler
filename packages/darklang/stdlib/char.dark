// Stdlib.Char - operations on one NFC-normalized extended grapheme cluster.

module Darklang.Stdlib.Char

let toString (char: Char) : String = __char_to_string char

let __asChar (value: String) : Char = __string_to_char_unchecked value

let toUppercase (char: Char) : Char =
    Stdlib.Char.__asChar (Stdlib.String.__Unicode.uppercase (Stdlib.Char.toString char))

let toLowercase (char: Char) : Char =
    Stdlib.Char.__asChar (Stdlib.String.__Unicode.lowercase (Stdlib.Char.toString char))

let isLowercase (c: Char) : Bool =
  Stdlib.Char.toLowercase c == c && Stdlib.Char.toUppercase c != c

let isUppercase (c: Char) : Bool =
  Stdlib.Char.toLowercase c != c && Stdlib.Char.toUppercase c == c

let __firstCodepoint (char: Char) : Stdlib.Option.Option<Int64> =
    Stdlib.List.head (Stdlib.String.__toCodepoints (Stdlib.Char.toString char))

let isDigit (c: Char) : Bool =
  (Stdlib.Char.isGreaterThanOrEqualTo c '0')
  && (Stdlib.Char.isLessThanOrEqualTo c '9')

let isASCIILetter (c: Char) : Bool =
  (Stdlib.Char.isGreaterThanOrEqualTo c 'a')
  && (Stdlib.Char.isLessThanOrEqualTo c 'z')
  || (Stdlib.Char.isGreaterThanOrEqualTo c 'A')
      && (Stdlib.Char.isLessThanOrEqualTo c 'Z')

let isLetter (char: Char) : Bool =
    match Stdlib.Char.__firstCodepoint char with
    | Some codepoint -> Stdlib.String.__Unicode.isLetter codepoint
    | None -> false

let isAlphanumeric (char: Char) : Bool =
    match Stdlib.Char.__firstCodepoint char with
    | Some codepoint -> Stdlib.String.__Unicode.isLetter codepoint || Stdlib.String.__Unicode.generalCategory codepoint == Stdlib.String.__Unicode.__Data.GeneralCategory.Nd
    | None -> false

let isWhitespace (char: Char) : Bool =
    match Stdlib.Char.__firstCodepoint char with
    | Some codepoint -> Stdlib.String.__Unicode.isWhitespace codepoint
    | None -> false

let toCodepoint (char: Char) : Stdlib.Option.Option<Int> =
    match Stdlib.String.__toCodepoints (Stdlib.Char.toString char) with
    | [codepoint] -> Some (Stdlib.Int.fromInt64 codepoint)
    | _ -> None

let toAsciiCode (char: Char) : Stdlib.Option.Option<Int> =
    match Stdlib.String.__toCodepoints (Stdlib.Char.toString char) with
    | [codepoint] ->
        if codepoint >= 0L && codepoint < 128L then Some (Stdlib.Int.fromInt64 codepoint) else None
    | _ -> None

let isASCII (c: Char) : Bool =
  let asciiCode = Stdlib.Char.toAsciiCode c

  match asciiCode with
  | Some ascii -> (ascii >= 0) && (ascii <= 127)
  | None -> false

let __utf16Units (codepoints: List<Int64>) (acc: List<Int64>) : List<Int64> =
    match codepoints with
    | [] -> Stdlib.List.reverse acc
    | codepoint :: rest ->
        if codepoint <= 65535L then Stdlib.Char.__utf16Units rest (Stdlib.List.push acc codepoint)
        else
            let adjusted = codepoint - 65536L in
            let high = 55296L + Stdlib.Int64.shiftRight adjusted 10L in
            let low = 56320L + Stdlib.Int64.bitwiseAnd adjusted 1023L in
            Stdlib.Char.__utf16Units rest (Stdlib.List.push (Stdlib.List.push acc high) low)

let __compareUnits (left: List<Int64>) (right: List<Int64>) : Int64 =
    match (left, right) with
    | ([], []) -> 0L
    | ([], _) -> -1L
    | (_, []) -> 1L
    | (leftHead :: leftRest, rightHead :: rightRest) ->
        if leftHead < rightHead then -1L
        else if leftHead > rightHead then 1L
        else Stdlib.Char.__compareUnits leftRest rightRest

let __compare (left: Char) (right: Char) : Int64 =
    Stdlib.Char.__compareUnits (Stdlib.Char.__utf16Units (Stdlib.String.__toCodepoints (Stdlib.Char.toString left)) []) (Stdlib.Char.__utf16Units (Stdlib.String.__toCodepoints (Stdlib.Char.toString right)) [])

let isLessThan (left: Char) (right: Char) : Bool = Stdlib.Char.__compare left right < 0L
let isLessThanOrEqualTo (left: Char) (right: Char) : Bool = Stdlib.Char.__compare left right <= 0L
let isGreaterThan (left: Char) (right: Char) : Bool = Stdlib.Char.__compare left right > 0L
let isGreaterThanOrEqualTo (left: Char) (right: Char) : Bool = Stdlib.Char.__compare left right >= 0L

let fromCodepoint (codepoint: Int) : Stdlib.Option.Option<Char> =
    match Stdlib.Int.toInt64 codepoint with
    | None -> None
    | Some value ->
        if Stdlib.String.__Unicode.isScalar value then Some (Stdlib.Char.__asChar (Stdlib.String.__fromCodepoints ([value])))
        else None

impl Stdlib.ToString for Char =
  let toString = Stdlib.Char.toString

impl Stdlib.Compare for Char =
  let lessThan = Stdlib.Char.isLessThan
  let lessThanOrEqualTo = Stdlib.Char.isLessThanOrEqualTo
  let greaterThan = Stdlib.Char.isGreaterThan
  let greaterThanOrEqualTo = Stdlib.Char.isGreaterThanOrEqualTo
