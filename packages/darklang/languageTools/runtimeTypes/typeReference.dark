// TypeReference.dark - portable public type references used by JSON errors.

module Darklang.LanguageTools.RuntimeTypes

type TypeReference =
    TUnit
    | TBool
    | TInt8
    | TUInt8
    | TInt16
    | TUInt16
    | TInt32
    | TUInt32
    | TInt64
    | TUInt64
    | TInt128
    | TUInt128
    | TInt
    | TFloat
    | TChar
    | TString
    | TUuid
    | TDateTime
    | TBlob
    | TStream of Darklang.LanguageTools.RuntimeTypes.TypeReference
    | TTuple of Darklang.LanguageTools.RuntimeTypes.TypeReference * Darklang.LanguageTools.RuntimeTypes.TypeReference * List<Darklang.LanguageTools.RuntimeTypes.TypeReference>
    | TList of Darklang.LanguageTools.RuntimeTypes.TypeReference
    | TDict of key: Darklang.LanguageTools.RuntimeTypes.TypeReference * value: Darklang.LanguageTools.RuntimeTypes.TypeReference
    | TCustomType of Darklang.LanguageTools.RuntimeTypes.NameResolution<Darklang.LanguageTools.RuntimeTypes.FQTypeName.FQTypeName> * typeArgs: List<Darklang.LanguageTools.RuntimeTypes.TypeReference>
    | TFn of List<Darklang.LanguageTools.RuntimeTypes.TypeReference> * Darklang.LanguageTools.RuntimeTypes.TypeReference
    | TDB of Darklang.LanguageTools.RuntimeTypes.TypeReference
    | TVariable of String
