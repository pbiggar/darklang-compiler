// PrettyPrinterRuntimeTypes.dark - upstream runtime type-reference rendering API.

module Darklang.PrettyPrinter.RuntimeTypes

let __runtimeHash (hash: Darklang.LanguageTools.RuntimeTypes.Hash) : String =
    Darklang.LanguageTools.RuntimeTypes.hashToString hash

let typeName
    (_branchId: Uuid)
    (name: Darklang.LanguageTools.RuntimeTypes.FQTypeName.FQTypeName)
    : String =
    match name with
    | Package hash -> Darklang.PrettyPrinter.RuntimeTypes.__runtimeHash hash

let shortTypeName
    (branchId: Uuid)
    (name: Darklang.LanguageTools.RuntimeTypes.FQTypeName.FQTypeName)
    : String =
    Darklang.PrettyPrinter.RuntimeTypes.typeName branchId name

let fnName
    (_branchId: Uuid)
    (name: Darklang.LanguageTools.RuntimeTypes.FQFnName.FQFnName)
    : String =
    match name with
    | Builtin builtin ->
        if builtin.version == 0l then "Builtin." ++ builtin.name
        else "Builtin." ++ builtin.name ++ "_v" ++ Stdlib.Int32.toString builtin.version
    | Package hash -> Darklang.PrettyPrinter.RuntimeTypes.__runtimeHash hash

let valueName
    (_branchId: Uuid)
    (name: Darklang.LanguageTools.RuntimeTypes.FQValueName.FQValueName)
    : String =
    match name with
    | Builtin builtin ->
        if builtin.version == 0l then builtin.name
        else builtin.name ++ "_v" ++ Stdlib.Int32.toString builtin.version
    | Package hash -> Darklang.PrettyPrinter.RuntimeTypes.__runtimeHash hash

let __typeReferenceList
    (branchId: Uuid)
    (types: List<Darklang.LanguageTools.RuntimeTypes.TypeReference>)
    : List<String> =
    Stdlib.List.map
        (types)
        (fun typ -> Darklang.PrettyPrinter.RuntimeTypes.typeReference (branchId) (typ))

let typeReference
    (branchId: Uuid)
    (typ: Darklang.LanguageTools.RuntimeTypes.TypeReference)
    : String =
    match typ with
    | TVariable (name) -> "'" ++ name
    | TUnit -> "Unit"
    | TBool -> "Bool"
    | TInt8 -> "Int8"
    | TUInt8 -> "UInt8"
    | TInt16 -> "Int16"
    | TUInt16 -> "UInt16"
    | TInt32 -> "Int32"
    | TUInt32 -> "UInt32"
    | TInt64 -> "Int64"
    | TUInt64 -> "UInt64"
    | TInt128 -> "Int128"
    | TUInt128 -> "UInt128"
    | TInt -> "Int"
    | TFloat -> "Float"
    | TChar -> "Char"
    | TString -> "String"
    | TUuid -> "Uuid"
    | TDateTime -> "DateTime"
    | TBlob -> "Blob"
    | TStream (inner) ->
        "Stream<" ++ Darklang.PrettyPrinter.RuntimeTypes.typeReference (branchId) (inner) ++ ">"
    | TTuple (first, second, rest) ->
        let all =
            Stdlib.List.push
                (Stdlib.List.push (rest) (second))
                (first) in
        "(" ++ Stdlib.String.join (Darklang.PrettyPrinter.RuntimeTypes.__typeReferenceList (branchId) (all)) (" * ") ++ ")"
    | TList (inner) ->
        "List<" ++ Darklang.PrettyPrinter.RuntimeTypes.typeReference (branchId) (inner) ++ ">"
    | TDict (key, value) ->
        "Dict<" ++ Darklang.PrettyPrinter.RuntimeTypes.typeReference (branchId) (key) ++ ", " ++ Darklang.PrettyPrinter.RuntimeTypes.typeReference (branchId) (value) ++ ">"
    | TCustomType (resolution, typeArgs) ->
        let renderedName = Stdlib.String.join (resolution.originalName) (".") in
        (match typeArgs with
        | [] -> renderedName
        | _ ->
            renderedName ++ "<" ++
            Stdlib.String.join (Darklang.PrettyPrinter.RuntimeTypes.__typeReferenceList (branchId) (typeArgs)) (", ") ++
            ">")
    | TFn (parameters, result) ->
        "(" ++
        Stdlib.String.join (Darklang.PrettyPrinter.RuntimeTypes.__typeReferenceList (branchId) (parameters)) (", ") ++
        ") -> " ++ Darklang.PrettyPrinter.RuntimeTypes.typeReference (branchId) (result)
    | TDB (inner) ->
        "DB<" ++ Darklang.PrettyPrinter.RuntimeTypes.typeReference (branchId) (inner) ++ ">"

let valueType
    (branchId: Uuid)
    (typ: Darklang.LanguageTools.RuntimeTypes.ValueType)
    : String =
    match typ with
    | Unknown -> "_"
    | Known known -> Darklang.PrettyPrinter.RuntimeTypes.knownType branchId known

let knownType
    (branchId: Uuid)
    (typ: Darklang.LanguageTools.RuntimeTypes.KnownType)
    : String =
    match typ with
    | KTUnit -> "Unit"
    | KTBool -> "Bool"
    | KTInt8 -> "Int8"
    | KTUInt8 -> "UInt8"
    | KTInt16 -> "Int16"
    | KTUInt16 -> "UInt16"
    | KTInt32 -> "Int32"
    | KTUInt32 -> "UInt32"
    | KTInt64 -> "Int64"
    | KTUInt64 -> "UInt64"
    | KTInt128 -> "Int128"
    | KTUInt128 -> "UInt128"
    | KTInt -> "Int"
    | KTFloat -> "Float"
    | KTChar -> "Char"
    | KTString -> "String"
    | KTUuid -> "Uuid"
    | KTDateTime -> "DateTime"
    | KTBlob -> "Blob"
    | KTStream inner -> "Stream<" ++ Darklang.PrettyPrinter.RuntimeTypes.valueType branchId inner ++ ">"
    | KTTuple (first, second, rest) ->
        let parts = Stdlib.List.append [first, second] rest in
        "(" ++ Stdlib.String.join (Stdlib.List.map parts (fun item -> Darklang.PrettyPrinter.RuntimeTypes.valueType branchId item)) " * " ++ ")"
    | KTList inner -> "List<" ++ Darklang.PrettyPrinter.RuntimeTypes.valueType branchId inner ++ ">"
    | KTDict (key, value) ->
        "Dict<" ++ Darklang.PrettyPrinter.RuntimeTypes.valueType branchId key ++ ", " ++ Darklang.PrettyPrinter.RuntimeTypes.valueType branchId value ++ ">"
    | KTFn (parameters, result) ->
        let parts = Stdlib.List.push parameters result in
        Stdlib.String.join (Stdlib.List.map parts (fun item -> Darklang.PrettyPrinter.RuntimeTypes.valueType branchId item)) " -> "
    | KTCustomType (name, args) ->
        let baseName = Darklang.PrettyPrinter.RuntimeTypes.typeName branchId name in
        match args with
        | [] -> baseName
        | _ -> baseName ++ "<" ++ Stdlib.String.join (Stdlib.List.map args (fun item -> Darklang.PrettyPrinter.RuntimeTypes.valueType branchId item)) ", " ++ ">"
    | KTDB inner -> "Datastore<" ++ Darklang.PrettyPrinter.RuntimeTypes.valueType branchId inner ++ ">"

let declaredValueType
    (branchId: Uuid)
    (declared: Stdlib.Option.Option<Darklang.LanguageTools.RuntimeTypes.TypeReference>)
    (typ: Darklang.LanguageTools.RuntimeTypes.ValueType)
    : String =
    match typ with
    | Unknown -> "_"
    | Known known -> Darklang.PrettyPrinter.RuntimeTypes.declaredKnownType branchId declared known

let declaredKnownType
    (branchId: Uuid)
    (declared: Stdlib.Option.Option<Darklang.LanguageTools.RuntimeTypes.TypeReference>)
    (typ: Darklang.LanguageTools.RuntimeTypes.KnownType)
    : String =
    match typ, declared with
    | KTStream inner, Some (TStream reference) ->
        "Stream<" ++ Darklang.PrettyPrinter.RuntimeTypes.declaredValueType branchId (Some reference) inner ++ ">"
    | KTList inner, Some (TList reference) ->
        "List<" ++ Darklang.PrettyPrinter.RuntimeTypes.declaredValueType branchId (Some reference) inner ++ ">"
    | KTDict (key, value), Some (TDict (keyReference, valueReference)) ->
        "Dict<" ++
        Darklang.PrettyPrinter.RuntimeTypes.declaredValueType branchId (Some keyReference) key ++
        ", " ++
        Darklang.PrettyPrinter.RuntimeTypes.declaredValueType branchId (Some valueReference) value ++
        ">"
    | KTTuple (first, second, rest), Some (TTuple (firstReference, secondReference, restReferences)) ->
        let items = Stdlib.List.append [first, second] rest in
        let references = Stdlib.List.append [firstReference, secondReference] restReferences in
        if Stdlib.List.length items == Stdlib.List.length references then
            "(" ++
            Stdlib.String.join
                (Stdlib.List.indexedMap items (fun index item ->
                    Darklang.PrettyPrinter.RuntimeTypes.declaredValueType branchId (Stdlib.List.getAt references index) item))
                " * " ++
            ")"
        else Darklang.PrettyPrinter.RuntimeTypes.knownType branchId typ
    | KTFn (parameters, result), Some (TFn (parameterReferences, resultReference)) ->
        if Stdlib.List.length parameters == Stdlib.List.length parameterReferences then
            let renderedParameters =
                Stdlib.List.indexedMap parameters (fun index item ->
                    Darklang.PrettyPrinter.RuntimeTypes.declaredValueType branchId (Stdlib.List.getAt parameterReferences index) item) in
            Stdlib.String.join
                (Stdlib.List.push renderedParameters
                    (Darklang.PrettyPrinter.RuntimeTypes.declaredValueType branchId (Some resultReference) result))
                " -> "
        else Darklang.PrettyPrinter.RuntimeTypes.knownType branchId typ
    | KTCustomType (name, args), Some (TCustomType (declaredName, declaredArgs)) ->
        let renderedName =
            match declaredName.originalName with
            | [] -> Darklang.PrettyPrinter.RuntimeTypes.typeName branchId name
            | parts -> Stdlib.String.join parts "." in
        match args with
        | [] -> renderedName
        | _ ->
            renderedName ++ "<" ++
            Stdlib.String.join
                (Stdlib.List.indexedMap args (fun index item ->
                    Darklang.PrettyPrinter.RuntimeTypes.declaredValueType branchId (Stdlib.List.getAt declaredArgs index) item))
                ", " ++
            ">"
    | _, _ -> Darklang.PrettyPrinter.RuntimeTypes.knownType branchId typ

let letPattern
    (pattern: Darklang.LanguageTools.RuntimeTypes.LetPattern)
    : String =
    match pattern with
    | LPVariable _ -> "[variable]"
    | LPWildcard -> "_"
    | LPUnit -> "()"
    | LPTuple (first, second, rest) ->
        let parts = Stdlib.List.append [first, second] rest in
        "(" ++ Stdlib.String.join (Stdlib.List.map parts (fun item -> Darklang.PrettyPrinter.RuntimeTypes.letPattern item)) ", " ++ ")"

module Dval =
  let valueTypeName
      (branchId: Uuid)
      (value: Darklang.LanguageTools.RuntimeTypes.Dval)
      : String =
    match value with
    | DUnit -> "Unit"
    | DBool _ -> "Bool"
    | DInt8 _ -> "Int8"
    | DUInt8 _ -> "UInt8"
    | DInt16 _ -> "Int16"
    | DUInt16 _ -> "UInt16"
    | DInt32 _ -> "Int32"
    | DUInt32 _ -> "UInt32"
    | DInt64 _ -> "Int64"
    | DUInt64 _ -> "UInt64"
    | DInt128 _ -> "Int128"
    | DUInt128 _ -> "UInt128"
    | DInt _ -> "Int"
    | DFloat _ -> "Float"
    | DChar _ -> "Char"
    | DString _ -> "String"
    | DDateTime _ -> "DateTime"
    | DUuid _ -> "Uuid"
    | DTuple (first, second, rest) ->
        let parts = Stdlib.List.append [first, second] rest in
        "(" ++ Stdlib.String.join (Stdlib.List.map parts (fun item -> Darklang.PrettyPrinter.RuntimeTypes.Dval.valueTypeName branchId item)) " * " ++ ")"
    | DList (typ, _) -> "List<" ++ Darklang.PrettyPrinter.RuntimeTypes.valueType branchId typ ++ ">"
    | DDict (key, valueType, _) ->
        "Dict<" ++ Darklang.PrettyPrinter.RuntimeTypes.valueType branchId key ++ ", " ++ Darklang.PrettyPrinter.RuntimeTypes.valueType branchId valueType ++ ">"
    | DRecord (_, name, args, _) ->
        let rendered = Darklang.PrettyPrinter.RuntimeTypes.typeName branchId name in
        match args with
        | [] -> rendered
        | _ -> rendered ++ "<" ++ Stdlib.String.join (Stdlib.List.map args (fun item -> Darklang.PrettyPrinter.RuntimeTypes.valueType branchId item)) ", " ++ ">"
    | DEnum (_, name, args, _, _) ->
        let rendered = Darklang.PrettyPrinter.RuntimeTypes.typeName branchId name in
        match args with
        | [] -> rendered
        | _ -> rendered ++ "<" ++ Stdlib.String.join (Stdlib.List.map args (fun item -> Darklang.PrettyPrinter.RuntimeTypes.valueType branchId item)) ", " ++ ">"
    | DApplicable (AppNamedFn _) -> "Function"
    | DApplicable (AppLambda _) -> "Lambda"
    | DDB _ -> "Datastore"
    | DBlobPersistent (_, _) -> "Blob"
    | DBlobEphemeral _ -> "Blob"
    | DStreamStub typ -> "Stream<" ++ Darklang.PrettyPrinter.RuntimeTypes.valueType branchId typ ++ ">"

let dval
    (branchId: Uuid)
    (value: Darklang.LanguageTools.RuntimeTypes.Dval)
    : String =
    match value with
    | DUnit -> "()"
    | DBool item -> if item then "true" else "false"
    | DInt8 item -> Stdlib.Int8.toString item
    | DUInt8 item -> Stdlib.UInt8.toString item
    | DInt16 item -> Stdlib.Int16.toString item
    | DUInt16 item -> Stdlib.UInt16.toString item
    | DInt32 item -> Stdlib.Int32.toString item
    | DUInt32 item -> Stdlib.UInt32.toString item
    | DInt64 item -> Stdlib.Int64.toString item
    | DUInt64 item -> Stdlib.UInt64.toString item
    | DInt128 item -> Stdlib.Int128.toString item
    | DUInt128 item -> Stdlib.UInt128.toString item
    | DInt item -> Stdlib.Int.toString item
    | DFloat item -> Stdlib.Float.toString item
    | DChar item -> "'" ++ Stdlib.Char.toString item ++ "'"
    | DString item -> Stdlib.AltJson.__quote item
    | DDateTime item -> "<DateTime: " ++ Stdlib.DateTime.toString item ++ ">"
    | DUuid item -> "<Uuid: " ++ Stdlib.Uuid.toString item ++ ">"
    | DTuple (first, second, rest) ->
        let parts = Stdlib.List.append [first, second] rest in
        "(" ++ Stdlib.String.join (Stdlib.List.map parts (fun item -> Darklang.PrettyPrinter.RuntimeTypes.dval branchId item)) ", " ++ ")"
    | DList (typ, items) ->
        match items with
        | [] -> "List<" ++ Darklang.PrettyPrinter.RuntimeTypes.valueType branchId typ ++ "> []"
        | _ -> "[" ++ Stdlib.String.join (Stdlib.List.map items (fun item -> Darklang.PrettyPrinter.RuntimeTypes.dval branchId item)) ", " ++ "]"
    | DDict (_, _, entries) ->
        let parts =
            Stdlib.Dict.__entries entries
            |> Stdlib.List.map (fun pair ->
                let (key, item) = pair in
                Darklang.PrettyPrinter.RuntimeTypes.dval branchId key ++ ": " ++ Darklang.PrettyPrinter.RuntimeTypes.dval branchId item)
            |> Stdlib.List.sort in
        if parts == [] then "{}" else "{ " ++ Stdlib.String.join parts ", " ++ " }"
    | DRecord (_, name, _, fields) ->
        let parts =
            Stdlib.Dict.__entries fields
            |> Stdlib.List.map (fun pair ->
                let (fieldName, item) = pair in
                fieldName ++ ": " ++ Darklang.PrettyPrinter.RuntimeTypes.dval branchId item) in
        Darklang.PrettyPrinter.RuntimeTypes.typeName branchId name ++ " { " ++ Stdlib.String.join parts ", " ++ " }"
    | DEnum (_, name, _, caseName, fields) ->
        let prefix = Darklang.PrettyPrinter.RuntimeTypes.typeName branchId name ++ "." ++ caseName in
        match fields with
        | [] -> prefix
        | _ -> prefix ++ "(" ++ Stdlib.String.join (Stdlib.List.map fields (fun item -> Darklang.PrettyPrinter.RuntimeTypes.dval branchId item)) ", " ++ ")"
    | DApplicable (AppNamedFn named) -> Darklang.PrettyPrinter.RuntimeTypes.fnName branchId named.name
    | DApplicable (AppLambda _) -> "(lambda)"
    | DDB name -> "<Datastore: " ++ name ++ ">"
    | DBlobPersistent (hash, length) -> "<Blob: " ++ Stdlib.String.first hash 8 ++ "… " ++ Stdlib.Int.toString length ++ " bytes>"
    | DBlobEphemeral _ -> "<Blob: ephemeral>"
    | DStreamStub _ -> "<stream: stub>"
