// Fannkuch Benchmark - Pancake flipping
// Count maximum flips needed to sort any permutation

// Get element at index (unsafe - assumes valid index)
let getAt(list: List<Int64>, index: Int64) : Int64 =
    match Stdlib.List.getAt<Int64>(list, Stdlib.Int.fromInt64(index)) with
    | Some(v) -> v
    | None -> 0L

// Prepend values held in reverse order without constructing an intermediate.
let prependReversed(source: List<Int64>, suffix: List<Int64>) : List<Int64> =
    match source with
    | [] -> suffix
    | h :: t -> prependReversed(t, Stdlib.List.push<Int64>(suffix, h))

// Reverse the first k+1 values in one source traversal.
let reversePrefixCollect(source: List<Int64>, remaining: Int64, reversed: List<Int64>) : List<Int64> =
    if remaining < 0L then Stdlib.List.append<Int64>(reversed, source)
    else
        match source with
        | [] -> reversed
        | h :: t -> reversePrefixCollect(t, remaining - 1L, Stdlib.List.push<Int64>(reversed, h))

let reversePrefix(list: List<Int64>, k: Int64) : List<Int64> =
    reversePrefixCollect(list, k, [])

// Count flips until first element is 0
let countFlips(perm: List<Int64>, flips: Int64) : Int64 =
    match perm with
    | [] -> flips
    | first :: _ ->
        if first == 0L then flips
        else countFlips(reversePrefix(perm, first), flips + 1L)

// Rotate first i+1 elements left by 1: [a,b,c,d,...] -> [b,c,d,a,...]
let rotateLeftCollect(source: List<Int64>, remaining: Int64, reversed: List<Int64>, first: Int64) : List<Int64> =
    if remaining <= 0L then prependReversed(reversed, Stdlib.List.push<Int64>(source, first))
    else
        match source with
        | [] -> prependReversed(reversed, [first])
        | h :: t -> rotateLeftCollect(t, remaining - 1L, Stdlib.List.push<Int64>(reversed, h), first)

let rotateLeft(list: List<Int64>, i: Int64) : List<Int64> =
    match list with
    | [] -> []
    | first :: tail -> rotateLeftCollect(tail, i, [], first)

// Set element at index
let setAt(list: List<Int64>, index: Int64, value: Int64) : List<Int64> =
    Stdlib.Internal.SkewList.setAt<Int64>(list, index, value)

// Generate next permutation, returns (newPerm, newCount, done)
let nextPerm(perm: List<Int64>, count: List<Int64>, i: Int64, n: Int64) : (List<Int64> * List<Int64> * Bool) =
    if i >= n then (perm, count, true)
    else
        let newPerm = rotateLeft(perm, i) in
        let ci = getAt(count, i) in
        if ci > 1L then
            (newPerm, setAt(count, i, ci - 1L), false)
        else
            let newCount = setAt(count, i, i + 1L) in
            nextPerm(newPerm, newCount, i + 1L, n)

// Main loop: process all permutations
let fannkuchLoop(perm: List<Int64>, count: List<Int64>, n: Int64, maxFlips: Int64) : Int64 =
    let flips =
        match perm with
        | [] -> 0L
        | first :: _ -> if first == 0L then 0L else countFlips(perm, 0L) in
    let newMax = if flips > maxFlips then flips else maxFlips in
    let result = nextPerm(perm, count, 1L, n) in
    let newPerm = Stdlib.Tuple3.first<List<Int64>, List<Int64>, Bool>(result) in
    let newCount = Stdlib.Tuple3.second<List<Int64>, List<Int64>, Bool>(result) in
    let done = Stdlib.Tuple3.third<List<Int64>, List<Int64>, Bool>(result) in
    if done then newMax
    else fannkuchLoop(newPerm, newCount, n, newMax)

// Create initial list [0, 1, 2, ..., n-1]
let intToInt64(value: Int) : Int64 =
    Builtin.unwrap(Stdlib.Int.toInt64(value))

let createRange(n: Int64) : List<Int64> =
    Stdlib.List.map<Int, Int64>(
        Stdlib.List.range(0I, Stdlib.Int.fromInt64(n - 1L)),
        intToInt64)

let fannkuch(n: Int64) : Int64 =
    let perm = createRange(n) in
    let count = Stdlib.List.map<Int, Int64>(
        Stdlib.List.range(1I, Stdlib.Int.fromInt64(n)),
        intToInt64) in
    fannkuchLoop(perm, count, n, 0L)

// Dark's fixed heap cannot complete the correct n=9 permutation traversal.
// Run the complete n=8 traversal and keep this full pair explicitly reduced.
let benchmarkArg(index: Int) : Int64 =
    match Stdlib.Cli.Args.int64(index) with
    | Ok(value) -> value
    | Error(message) -> Builtin.testRuntimeError(message)

Builtin.printLine(Stdlib.Int64.toString(fannkuch(benchmarkArg(0I))))
