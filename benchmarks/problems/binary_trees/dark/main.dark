// Binary Trees Benchmark
// Allocates and traverses the same complete recursive tree as the references.
type Tree<'a> = Leaf of a | Node of (Tree<a> * Tree<a>)

let makeTree(depth: Int64) : Tree<Int64> =
    if depth <= 0 then Leaf(1)
    else Node((makeTree(depth - 1), makeTree(depth - 1)))

let countTree(tree: Tree<Int64>) : Int64 =
    match tree with
    | Leaf(_) -> 1
    | Node((left, right)) -> 1 + countTree(left) + countTree(right)

let stressTest(depth: Int64, iterations: Int64, acc: Int64) : Int64 =
    if iterations <= 0 then acc
    else
        let tree = makeTree(depth) in
        let count = countTree(tree) in
        stressTest(depth, iterations - 1, acc + count)

// Construct and traverse 100 trees of depth 15.
// Each complete binary tree of depth 15 has 2^16 - 1 = 65535 nodes
let benchmarkArg(index: Int) : Int64 =
    match Stdlib.Cli.Args.int64(index) with
    | Ok(value) -> value
    | Error(message) -> Builtin.testRuntimeError(message)

Builtin.printLine(Stdlib.Int64.toString(stressTest(benchmarkArg(0I), benchmarkArg(1I), 0)))
