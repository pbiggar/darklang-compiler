// Binary Trees Benchmark - Quick check version

type Tree<'a> = Leaf of a | Node of (Tree<a> * Tree<a>)

let makeTree(depth: Int64) : Tree<Int64> =
    if depth <= 0L then Leaf(1L)
    else Node((makeTree(depth - 1L), makeTree(depth - 1L)))

let countTree(tree: Tree<Int64>) : Int64 =
    match tree with
    | Leaf(_) -> 1L
    | Node((left, right)) -> 1L + countTree(left) + countTree(right)

let stressTest(depth: Int64, iterations: Int64, acc: Int64) : Int64 =
    if iterations <= 0L then acc
    else
        let tree = makeTree(depth) in
        let count = countTree(tree) in
        stressTest(depth, iterations - 1L, acc + count)

// Reduced: depth 10, 5 iterations instead of depth 15, 100 iterations
stressTest(10L, 5L, 0L)
