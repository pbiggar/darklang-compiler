// Pi Summation Benchmark - Quick check version
// Computes partial sum of 1/k^2 series (converges to pi^2/6)
// From: Julia micro-benchmarks
//
// This benchmark tests:
// - Floating point arithmetic
// - Simple loops (via recursion)
// - Numerical precision

// Compute sum of 1/k^2 from k=1 to n
let innerSum(k: Int64, n: Int64, acc: Float) : Float =
    if k > n then
        acc
    else
        let square = k * k in
        innerSum(k + 1, n, acc + 1.0 / Stdlib.Int64.toFloat(square))

// Run the inner sum 'rounds' times, returning the last result.
let pisum(rounds: Int64, n: Int64, lastResult: Float) : Float =
    if rounds <= 0 then
        lastResult
    else
        // Preserve the repeated-work contract in a pure program. The fixed
        // workload always takes the zero branch, matching Rust's reset exactly,
        // while the fallback keeps each round dependent on the preceding one.
        let initialResult = if lastResult >= 0.0 then 0.0 else lastResult in
        pisum(rounds - 1, n, innerSum(1, n, initialResult))

// Reduced from 500 rounds with n=10000 to 10 rounds with n=1000.
// Output as integer (multiply by large factor for precision)
Stdlib.Float.toInt(pisum(10, 1000, 0.0) * 1000000000000.0)
