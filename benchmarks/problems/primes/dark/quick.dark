// Prime Counting Benchmark - Quick check version
// Tests integer arithmetic, conditionals, and loops/recursion
//
// Counts primes up to N using trial division.

let isDivisible(n: Int64, d: Int64, limit: Int64) : Bool =
    if d > limit then false
    else if n % d == 0L then true
    else isDivisible(n, d + 1L, limit)

let isPrime(n: Int64) : Bool =
    if n < 2L then false
    else if n == 2L then true
    else if n % 2L == 0L then false
    else
        let limit = Stdlib.Float.toInt(Stdlib.Float.sqrt(Stdlib.Int64.toFloat(n))) in
        if isDivisible(n, 3L, limit) then false else true

let countPrimes(n: Int64, count: Int64) : Int64 =
    if n <= 1L then count
    else if isPrime(n) then countPrimes(n - 1L, count + 1L)
    else countPrimes(n - 1L, count)

// Reduced from 10,000 candidates to 1,000.
countPrimes(1000L, 0L)
