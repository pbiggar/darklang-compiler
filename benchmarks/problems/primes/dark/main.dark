// Prime Counting Benchmark
// Tests integer arithmetic, conditionals, and loops/recursion
//
// Counts primes up to N using trial division.

let isDivisible(n: Int64, d: Int64, limit: Int64) : Bool =
    if d > limit then false
    else if n % d == 0 then true
    else isDivisible(n, d + 1, limit)

let isPrime(n: Int64) : Bool =
    if n < 2 then false
    else if n == 2 then true
    else if n % 2 == 0 then false
    else
        let limit = Stdlib.Float.toInt(Stdlib.Float.sqrt(Stdlib.Int64.toFloat(n))) in
        if isDivisible(n, 3, limit) then false else true

let countPrimes(n: Int64, count: Int64) : Int64 =
    if n <= 1 then count
    else if isPrime(n) then countPrimes(n - 1, count + 1)
    else countPrimes(n - 1, count)

// Count primes up to 10000
// Expected: 1229 primes
let benchmarkArg(index: Int) : Int64 =
    match Stdlib.Cli.Args.int64(index) with
    | Ok(value) -> value
    | Error(message) -> Builtin.testRuntimeError(message)

Builtin.printLine(Stdlib.Int64.toString(countPrimes(benchmarkArg(0I), 0)))
