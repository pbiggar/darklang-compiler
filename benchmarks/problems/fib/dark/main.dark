let fib(n: Int64) : Int64 =
    if n <= 1L then n
    else fib(n - 1L) + fib(n - 2L)

let benchmarkArg(index: Int) : Int64 =
    match Stdlib.Cli.Args.int64(index) with
    | Ok(value) -> value
    | Error(message) -> Builtin.testRuntimeError(message)

Builtin.printLine(Stdlib.Int64.toString(fib(benchmarkArg(0I))))
