let factorial (n: Int64) : Int64 =
    if n <= 1L then 1L
    else n * factorial (n - 1L)

let repeat (n: Int64) (factorialInput: Int64) (acc: Int64) : Int64 =
    if n <= 0L then acc
    else repeat (n - 1L) factorialInput (factorial factorialInput)

let benchmarkArg (index: Int) : Int64 =
    match Stdlib.Cli.__Args.int64 index with
    | Ok value -> value
    | Error message -> Builtin.testRuntimeError message

Builtin.printLine (Stdlib.Int64.toString (repeat (benchmarkArg 0) (benchmarkArg 1) 0L))
