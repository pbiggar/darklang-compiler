// Reduced UInt64 power-of-two modulo benchmark for quick validation.

def sumRemainders(value: UInt64, remaining: UInt64, acc: UInt64) : UInt64 =
    if remaining == 0UL then acc
    else
        sumRemainders(
            value + 6364136223846793005UL,
            remaining - 1UL,
            acc + (value % 64UL))

sumRemainders(1UL, 10000UL, 0UL)
