// Tak (Takeuchi) Benchmark
// Tests recursion and function call overhead
//
// The Takeuchi function creates deeply nested recursive calls.
// tak(24, 16, 8) makes millions of calls.

let tak(x: Int64, y: Int64, z: Int64) : Int64 =
    if x <= y then z
    else tak(tak(x - 1, y, z), tak(y - 1, z, x), tak(z - 1, x, y))

// Repeat multiple times for meaningful measurement
let repeat(n: Int64, x: Int64, y: Int64, z: Int64, acc: Int64) : Int64 =
    if n <= 0 then acc
    else repeat(n - 1, x, y, z, tak(x, y, z))

let benchmarkArg(index: Int) : Int64 =
    match Stdlib.Cli.Args.int64(index) with
    | Ok(value) -> value
    | Error(message) -> Builtin.testRuntimeError(message)

Builtin.printLine(Stdlib.Int64.toString(repeat(benchmarkArg(0I), benchmarkArg(1I), benchmarkArg(2I), benchmarkArg(3I), 0)))
