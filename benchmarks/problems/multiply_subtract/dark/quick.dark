// Reduced multiply-subtract benchmark for quick validation.

def multiplySubtract(minuend: Int64, left: Int64, right: Int64) : Int64 =
    minuend - (left * right)

def repeat(n: Int64, result: Int64) : Int64 =
    if n <= 0 then result
    else repeat(n - 1, multiplySubtract(1000000, n, n))

repeat(10000, 0)
