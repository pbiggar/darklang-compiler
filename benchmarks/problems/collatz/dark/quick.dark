// Collatz Benchmark - Quick check version

let collatzSteps(n: Int64, steps: Int64) : Int64 =
    if n == 1L then steps
    else if n % 2L == 0L then collatzSteps(n / 2L, steps + 1L)
    else collatzSteps(3L * n + 1L, steps + 1L)

let sumCollatzRange(i: Int64, limit: Int64, total: Int64) : Int64 =
    if i > limit then total
    else sumCollatzRange(i + 1L, limit, total + collatzSteps(i, 0L))

// Reduced: 1000 instead of 100000
sumCollatzRange(1L, 1000L, 0L)
