// Collatz Benchmark
// Counts steps in Collatz sequences for numbers 1 to n
//
// STATUS: IMPLEMENTABLE
// Current compiler lowers the tail-recursive loops to local jumps.
//
// This benchmark tests:
// - Integer arithmetic (mod, div, mul)
// - Conditionals
// - Recursion/iteration
// - Loop performance

let collatzSteps(n: Int64, steps: Int64) : Int64 =
    if n == 1L then steps
    else if n % 2L == 0L then collatzSteps(n / 2L, steps + 1L)
    else collatzSteps(3L * n + 1L, steps + 1L)

let sumCollatzRange(i: Int64, limit: Int64, total: Int64) : Int64 =
    if i > limit then total
    else sumCollatzRange(i + 1L, limit, total + collatzSteps(i, 0L))

// Sum steps for numbers 1 to 100000
let benchmarkArg(index: Int) : Int64 =
    match Stdlib.Cli.Args.int64(index) with
    | Ok(value) -> value
    | Error(message) -> Builtin.testRuntimeError(message)

Builtin.printLine(Stdlib.Int64.toString(sumCollatzRange(1L, benchmarkArg(0I), 0L)))
