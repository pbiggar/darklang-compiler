// Collatz Benchmark
// Counts steps in Collatz sequences for numbers 1 to n
//
// STATUS: IMPLEMENTABLE
// Current compiler lowers the tail-recursive loops to local jumps.
//
// This benchmark tests:
// - Integer arithmetic (mod, div, mul)
// - Conditionals
// - Recursion/iteration
// - Loop performance

let collatzSteps(n: Int64, steps: Int64) : Int64 =
    if n == 1 then steps
    else if n % 2 == 0 then collatzSteps(n / 2, steps + 1)
    else collatzSteps(3 * n + 1, steps + 1)

let sumCollatzRange(i: Int64, limit: Int64, total: Int64) : Int64 =
    if i > limit then total
    else sumCollatzRange(i + 1, limit, total + collatzSteps(i, 0))

// Sum steps for numbers 1 to 100000
Builtin.printLine(Stdlib.Int64.toString(sumCollatzRange(1, 100000, 0)))
