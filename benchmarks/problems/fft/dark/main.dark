// Radix-2 FFT benchmark using recursive Cooley-Tukey decomposition.
// Each level performs linear splitting and combining, for O(n log n) work.

type Complex = { real: Float, imaginary: Float }

let add (left: Complex) (right: Complex) : Complex =
    Complex { real = left.real + right.real, imaginary = left.imaginary + right.imaginary }

let subtract (left: Complex) (right: Complex) : Complex =
    Complex { real = left.real - right.real, imaginary = left.imaginary - right.imaginary }

let multiply (left: Complex) (right: Complex) : Complex =
    Complex {
        real = left.real * right.real - left.imaginary * right.imaginary,
        imaginary = left.real * right.imaginary + left.imaginary * right.real
    }

let split (values: List<Complex>) (takeEven: Bool) (evens: List<Complex>) (odds: List<Complex>) : (List<Complex> * List<Complex>) =
    match values with
    | [] -> (Stdlib.List.reverse evens, Stdlib.List.reverse odds)
    | value :: rest ->
        if takeEven then split rest false (Stdlib.List.push evens value) odds
        else split rest true evens (Stdlib.List.push odds value)

let combine (evens: List<Complex>) (odds: List<Complex>) (index: Int64) (size: Int64) (lower: List<Complex>) (upper: List<Complex>) : List<Complex> =
    match (evens, odds) with
    | ([], []) ->
        Stdlib.List.append (Stdlib.List.reverse lower) (Stdlib.List.reverse upper)
    | (even :: evenRest, odd :: oddRest) ->
        let angle = -6.283185307179586 * Stdlib.Int64.toFloat index / Stdlib.Int64.toFloat size in
        let twiddle = Complex { real = Stdlib.Math.cos angle, imaginary = Stdlib.Math.sin angle } in
        let product = multiply twiddle odd in
        combine evenRest oddRest (index + 1L) size (Stdlib.List.push lower (add even product)) (Stdlib.List.push upper (subtract even product))
    | _ -> Builtin.testRuntimeError "FFT halves had different lengths"

let fft (values: List<Complex>) (size: Int64) : List<Complex> =
    if size <= 1L then values
    else
        let (evenValues, oddValues) = split values true [] [] in
        let evens = fft evenValues (size / 2L) in
        let odds = fft oddValues (size / 2L) in
        combine evens odds 0L size [] []

let generateInput (remaining: Int64) (index: Int64) (reversed: List<Complex>) : List<Complex> =
    if remaining <= 0L then Stdlib.List.reverse reversed
    else
        let x = Stdlib.Int64.toFloat index in
        let value = Complex {
            real = Stdlib.Math.sin (x * 0.017) + Stdlib.Math.cos (x * 0.031),
            imaginary = Stdlib.Math.cos (x * 0.013) - Stdlib.Math.sin (x * 0.007)
        } in
        generateInput (remaining - 1L) (index + 1L) (Stdlib.List.push reversed value)

let checksum (values: List<Complex>) (index: Int64) (result: Int64) : Int64 =
    match values with
    | [] -> result
    | value :: rest ->
        let quantized = Stdlib.Int64.fromFloat ((value.real * 3.0 + value.imaginary * 5.0) * 1000000.0) in
        checksum rest (index + 1L) ((result + quantized * (index + 1L)) % 1000000007L)

let run (remaining: Int64) (input: List<Complex>) (size: Int64) (result: Int64) : Int64 =
    if remaining <= 0L then result
    else
        let transformed = fft input size in
        run (remaining - 1L) input size ((result + checksum transformed 0L 0L) % 1000000007L)

let isPowerOfTwo (value: Int64) : Bool =
    value > 0L && Stdlib.Int64.bitwiseAnd value (value - 1L) == 0L

let benchmarkArg (index: Int) : Int64 =
    match Stdlib.Cli.Args.int64 index with
    | Ok value -> value
    | Error message -> Builtin.testRuntimeError message

let size = benchmarkArg 0 in
let repetitions = benchmarkArg 1 in
if Stdlib.Bool.not (isPowerOfTwo size) || repetitions <= 0L then
    Builtin.testRuntimeError "FFT size must be a positive power of two and repetitions must be positive"
else
    let input = generateInput size 0L [] in
    Builtin.printLine (Stdlib.Int64.toString (run repetitions input size 0L))
