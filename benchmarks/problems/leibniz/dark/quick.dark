// Leibniz Pi Benchmark - Quick check version

let leibnizLoop(i: Int64, n: Int64, sum: Float, sign: Float) : Float =
    if i >= n then sum * 4.0
    else
        let term = sign / Stdlib.Int64.toFloat(2L * i + 1L) in
        leibnizLoop(i + 1L, n, sum + term, Stdlib.Float.negate(sign))

let leibnizPi(n: Int64) : Float =
    leibnizLoop(0L, n, 0.0, 1.0)

// Reduced: 100000 iterations instead of 100000000
Stdlib.Float.toInt(leibnizPi(100000L) * 100000000.0)
