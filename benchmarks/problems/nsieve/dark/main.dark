// Nsieve Benchmark - Sieve of Eratosthenes
// Counts primes up to n using Dict as sparse composite set

// Mark all multiples of prime as composite
let markMultiples(j: Int64, step: Int64, n: Int64, composites: Dict<Int64, Bool>) : Dict<Int64, Bool> =
    if j > n then composites
    else markMultiples(j + step, step, n, Stdlib.Internal.HAMT.__setOverwriting<Int64, Bool>(composites, j, true))

// Run sieve for numbers from i to n
let sieveLoop(i: Int64, n: Int64, composites: Dict<Int64, Bool>) : Dict<Int64, Bool> =
    if i > n then composites
    else
        let newComposites =
            if Stdlib.Internal.HAMT.__contains<Int64, Bool>(composites, i) then composites
            else markMultiples(i + i, i, n, composites)
        in
        sieveLoop(i + 1, n, newComposites)

// Count primes (numbers not in composites set)
let countPrimes(i: Int64, n: Int64, composites: Dict<Int64, Bool>, count: Int64) : Int64 =
    if i > n then count
    else
        let newCount = if Stdlib.Internal.HAMT.__contains<Int64, Bool>(composites, i) then count else count + 1 in
        countPrimes(i + 1, n, composites, newCount)

let nsieve(n: Int64) : Int64 =
    let composites = sieveLoop(2, n, Stdlib.Internal.HAMT.__empty<Int64, Bool>()) in
    countPrimes(2, n, composites, 0)

// Diagnostic only: one full-size run. The original Rust reference runs 100
// times; Dark's bump allocator cannot reclaim the persistent Dict between runs,
// so this implementation is non-comparable and excluded from canonical ratios.
let repeat(remaining: Int64, n: Int64, result: Int64) : Int64 =
    if remaining <= 0 then result
    else repeat(remaining - 1, n, nsieve(n))

let benchmarkArg(index: Int) : Int64 =
    match Stdlib.Cli.Args.int64(index) with
    | Ok(value) -> value
    | Error(message) -> Builtin.testRuntimeError(message)

Builtin.printLine(Stdlib.Int64.toString(repeat(benchmarkArg(1I), benchmarkArg(0I), 0)))
