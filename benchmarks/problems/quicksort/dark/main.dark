// Quicksort Benchmark - Dark implementation
// Sorts a list and returns a checksum

// Partition once, building each bucket with the skew list's O(1) prepend.
def partition3(arr: List<Int64>, pivot: Int64, less: List<Int64>, equal: List<Int64>, greater: List<Int64>) : (List<Int64>, List<Int64>, List<Int64>) =
    match arr with
    | [] -> (less, equal, greater)
    | [h, ...t] ->
        if h < pivot then partition3(t, pivot, [h, ...less], equal, greater)
        else if h == pivot then partition3(t, pivot, less, [h, ...equal], greater)
        else partition3(t, pivot, less, equal, [h, ...greater])

// Prepend a bucket to an existing suffix. Equal buckets need no reversal.
def prependAll(source: List<Int64>, suffix: List<Int64>) : List<Int64> =
    match source with
    | [] -> suffix
    | [h, ...t] -> [h, ...prependAll(t, suffix)]

// Continuation-style output avoids repeatedly copying the sorted left side.
def quicksortInto(arr: List<Int64>, suffix: List<Int64>) : List<Int64> =
    match arr with
    | [] -> suffix
    | [only] -> [only, ...suffix]
    | [pivot, ..._] ->
        let (less, equal, greater) = partition3(arr, pivot, [], [], []) in
        let sortedGreater = quicksortInto(greater, suffix) in
        let equalAndGreater = prependAll(equal, sortedGreater) in
        quicksortInto(less, equalAndGreater)

def quicksort(arr: List<Int64>) : List<Int64> =
    quicksortInto(arr, [])

// Generate pseudo-random list using LCG
def generateListHelper(n: Int64, x: Int64, acc: List<Int64>) : List<Int64> =
    if n <= 0 then Stdlib.List.reverse<Int64>(acc)
    else
        let nextX = (x * 1103515245 + 12345) % 2147483648 in
        let value = nextX % 10000 in
        generateListHelper(n - 1, nextX, [value, ...acc])

def generateList(n: Int64, seed: Int64) : List<Int64> =
    generateListHelper(n, seed, [])

// Compute checksum with index weighting
def checksumHelper(arr: List<Int64>, index: Int64, acc: Int64) : Int64 =
    match arr with
    | [] -> acc
    | [h, ...t] ->
        let newAcc = (acc + (h * (index + 1)) % 1000000007) % 1000000007 in
        checksumHelper(t, index + 1, newAcc)

def checksum(arr: List<Int64>) : Int64 =
    checksumHelper(arr, 0, 0)

let arr = generateList(5000, 42) in
let sortedArr = quicksort(arr) in
checksum(sortedArr)
