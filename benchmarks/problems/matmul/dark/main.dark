// Matrix Multiplication Benchmark - Dark implementation
// Generates the same 100x100 matrices as the reference implementation and
// computes the weighted checksum without materializing the product matrix.

def nextRand(x: Int64) : Int64 =
    (x * 1103515245 + 12345) % 2147483648

def generateMatrixValues(remaining: Int64, index: Int64, seed: Int64, values: Dict<Int64, Int64>) : Dict<Int64, Int64> =
    if remaining <= 0 then values
    else
        let next = nextRand(seed) in
        generateMatrixValues(remaining - 1, index + 1, next, Stdlib.Dict.set<Int64, Int64>(values, index, next % 100))

def matrixValue(values: Dict<Int64, Int64>, index: Int64) : Int64 =
    Stdlib.Dict.getOrDefault<Int64, Int64>(values, index, 0)

def dotCell(a: Dict<Int64, Int64>, b: Dict<Int64, Int64>, n: Int64, i: Int64, j: Int64, k: Int64, acc: Int64) : Int64 =
    if k >= n then acc
    else
        let aValue = matrixValue(a, i * n + k) in
        let bValue = matrixValue(b, k * n + j) in
        dotCell(a, b, n, i, j, k + 1, acc + aValue * bValue)

def checksumCells(a: Dict<Int64, Int64>, b: Dict<Int64, Int64>, n: Int64, i: Int64, j: Int64, acc: Int64) : Int64 =
    if i >= n then acc
    else if j >= n then checksumCells(a, b, n, i + 1, 0, acc)
    else
        let cell = dotCell(a, b, n, i, j, 0, 0) in
        let weight = i * n + j + 1 in
        checksumCells(a, b, n, i, j + 1, (acc + cell * weight) % 1000000007)

def matmulChecksum(n: Int64) : Int64 =
    let a = generateMatrixValues(n * n, 0, 42, Stdlib.Dict.empty<Int64, Int64>()) in
    let b = generateMatrixValues(n * n, 0, 123, Stdlib.Dict.empty<Int64, Int64>()) in
    checksumCells(a, b, n, 0, 0, 0)

matmulChecksum(100)
