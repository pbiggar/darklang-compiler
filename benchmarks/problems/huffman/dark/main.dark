// Huffman benchmark: build a codec, encode deterministic symbols, and decode them.
// A sorted priority queue keeps codec construction O(k^2); encoding and
// decoding are linear in the input and encoded bit counts respectively.

type HuffmanTree =
    | Leaf of (Int64 * Int64)
    | Branch of ((Int64 * Int64) * (HuffmanTree * HuffmanTree))

type Codec = { tree: HuffmanTree, codes: Dict<String, Int64> }

let symbolKey (symbol: Int64) : String =
    match Stdlib.String.getByteAt "abcdefghijklmnopqrstuvwxyzABCDEF" (Stdlib.Int.fromInt64 symbol) with
    | None -> Builtin.testRuntimeError "Huffman symbol is out of range"
    | Some byte ->
        match Stdlib.Char.fromCodepoint (Stdlib.Int.fromUInt8 byte) with
        | Some char -> Stdlib.Char.toString char
        | None -> Builtin.testRuntimeError "Huffman symbol is not ASCII"

let treeWeight (tree: HuffmanTree) : Int64 =
    match tree with
    | Leaf ((_, weight)) -> weight
    | Branch (((weight, _), _)) -> weight

let treeMinimumSymbol (tree: HuffmanTree) : Int64 =
    match tree with
    | Leaf ((symbol, _)) -> symbol
    | Branch (((_, minimumSymbol), _)) -> minimumSymbol

let treeComesFirst (left: HuffmanTree) (right: HuffmanTree) : Bool =
    let leftWeight = treeWeight left in
    let rightWeight = treeWeight right in
    leftWeight < rightWeight
    || (leftWeight == rightWeight && treeMinimumSymbol left < treeMinimumSymbol right)

let insertTree (tree: HuffmanTree) (queue: List<HuffmanTree>) : List<HuffmanTree> =
    match queue with
    | [] -> [tree]
    | first :: rest ->
        if treeComesFirst tree first then Stdlib.List.push queue tree
        else Stdlib.List.push (insertTree tree rest) first

let countFrequencies (data: List<Int64>) (frequencies: Dict<String, Int64>) : Dict<String, Int64> =
    match data with
    | [] -> frequencies
    | symbol :: rest ->
        let key = symbolKey symbol in
        match Stdlib.Dict.get frequencies key with
        | None ->
            countFrequencies rest (Stdlib.Dict.setOverridingDuplicates frequencies key 1L)
        | Some count ->
            countFrequencies rest (Stdlib.Dict.setOverridingDuplicates frequencies key (count + 1L))

let frequenciesToQueue (symbol: Int64) (frequencies: Dict<String, Int64>) (queue: List<HuffmanTree>) : List<HuffmanTree> =
    if symbol >= 32L then queue
    else
        match Stdlib.Dict.get frequencies (symbolKey symbol) with
        | None -> frequenciesToQueue (symbol + 1L) frequencies queue
        | Some count -> frequenciesToQueue (symbol + 1L) frequencies (insertTree (Leaf ((symbol, count))) queue)

let mergeMinimumTrees (queue: List<HuffmanTree>) : Stdlib.Option.Option<HuffmanTree> =
    match queue with
    | [] -> None
    | [first] -> Some first
    | first :: second :: tail ->
        let combined =
            Branch (((
                treeWeight first + treeWeight second,
                Stdlib.Int64.min (treeMinimumSymbol first) (treeMinimumSymbol second)),
                (first, second))) in
        mergeMinimumTrees (insertTree combined tail)

// Codes pack the bit pattern above its six-bit length so the dictionary holds
// a primitive value. The benchmark alphabet is capped at 32 symbols.
let buildCodes (tree: HuffmanTree) (bits: Int64) (length: Int64) (codes: Dict<String, Int64>) : Dict<String, Int64> =
    match tree with
    | Leaf ((symbol, _)) ->
        let codeLength = if length == 0L then 1L else length in
        Stdlib.Dict.setOverridingDuplicates codes (symbolKey symbol) (bits * 64L + codeLength)
    | Branch ((_, (left, right))) ->
        let afterLeft = buildCodes left (bits * 2L) (length + 1L) codes in
        buildCodes right (bits * 2L + 1L) (length + 1L) afterLeft

let buildCodec (data: List<Int64>) : Stdlib.Option.Option<Codec> =
    let frequencies = countFrequencies data Stdlib.Dict.empty in
    let queue = frequenciesToQueue 0L frequencies [] in
    match mergeMinimumTrees queue with
    | None -> None
    | Some tree -> Some (Codec { tree = tree, codes = buildCodes tree 0L 0L Stdlib.Dict.empty })

let prependCodeToReversed (bits: Int64) (index: Int64) (reversed: List<Int64>) : List<Int64> =
    if index < 0L then reversed
    else
        let bit = Stdlib.Int64.bitwiseAnd (Stdlib.Int64.shiftRight bits index) 1L in
        prependCodeToReversed bits (index - 1L) (Stdlib.List.push reversed bit)

let encodeReversed (data: List<Int64>) (codes: Dict<String, Int64>) (reversed: List<Int64>) : Stdlib.Result.Result<List<Int64>, String> =
    match data with
    | [] -> Ok (Stdlib.List.reverse reversed)
    | symbol :: rest ->
        match Stdlib.Dict.get codes (symbolKey symbol) with
        | None -> Error "symbol missing from Huffman code table"
        | Some code ->
            let length = code % 64L in
            encodeReversed rest codes (prependCodeToReversed (code / 64L) (length - 1L) reversed)

let encode (data: List<Int64>) (codec: Codec) : Stdlib.Result.Result<List<Int64>, String> =
    encodeReversed data codec.codes []

let decodeLoop (bits: List<Int64>) (root: HuffmanTree) (current: HuffmanTree) (reversed: List<Int64>) : Stdlib.Result.Result<List<Int64>, String> =
    match bits with
    | [] -> Ok (Stdlib.List.reverse reversed)
    | bit :: rest ->
        match current with
        | Leaf _ -> Error "decoder reached a leaf before consuming a bit"
        | Branch ((_, (left, right))) ->
            let next = if bit == 0L then left else right in
            match next with
            | Leaf ((symbol, _)) ->
                decodeLoop rest root root (Stdlib.List.push reversed symbol)
            | Branch _ -> decodeLoop rest root next reversed

let decode (bits: List<Int64>) (codec: Codec) : Stdlib.Result.Result<List<Int64>, String> =
    match codec.tree with
    | Leaf ((symbol, _)) ->
        Ok (Stdlib.List.map bits (fun _ -> symbol))
    | Branch _ -> decodeLoop bits codec.tree codec.tree []

let chooseSymbol (random: Int64) : Int64 =
    let roll = random % 1000L in
    if roll < 300L then 0L
    else if roll < 480L then 1L
    else if roll < 610L then 2L
    else if roll < 710L then 3L
    else if roll < 790L then 4L
    else if roll < 850L then 5L
    else if roll < 900L then 6L
    else if roll < 940L then 7L
    else 8L + random % 24L

let generateData (remaining: Int64) (state: Int64) (reversed: List<Int64>) : List<Int64> =
    if remaining <= 0L then Stdlib.List.reverse reversed
    else
        let next = (state * 1103515245L + 12345L) % 2147483648L in
        generateData (remaining - 1L) next (Stdlib.List.push reversed (chooseSymbol next))

let checksum (values: List<Int64>) (index: Int64) (result: Int64) : (Int64 * Int64) =
    match values with
    | [] -> (index, result)
    | value :: rest ->
        checksum rest (index + 1L) ((result + value * (index + 1L)) % 1000000007L)

let runIterations (remaining: Int64) (data: List<Int64>) (codec: Codec) (expectedChecksum: Int64) (result: Int64) : Int64 =
    if remaining <= 0L then result
    else
        match encode data codec with
        | Error message -> Builtin.testRuntimeError message
        | Ok bits ->
            match decode bits codec with
            | Error message -> Builtin.testRuntimeError message
            | Ok decoded ->
                let (bitCount, bitChecksum) = checksum bits 0L 0L in
                let (_, decodedChecksum) = checksum decoded 0L 0L in
                if decodedChecksum != expectedChecksum then
                    Builtin.testRuntimeError "Huffman round trip changed the input"
                else
                    let contribution = (bitCount * 17L + bitChecksum + decodedChecksum) % 1000000007L in
                    runIterations (remaining - 1L) data codec expectedChecksum ((result + contribution) % 1000000007L)

let benchmarkArg (index: Int) : Int64 =
    match Stdlib.Cli.__Args.int64 index with
    | Ok value -> value
    | Error message -> Builtin.testRuntimeError message

let size = benchmarkArg 0 in
let seed = benchmarkArg 1 in
let repetitions = benchmarkArg 2 in
if size <= 0L || repetitions <= 0L then
    Builtin.testRuntimeError "Huffman size and repetitions must be positive"
else
    let data = generateData size seed [] in
    let (_, expectedChecksum) = checksum data 0L 0L in
    match buildCodec data with
    | None -> Builtin.testRuntimeError "Huffman codec requires non-empty input"
    | Some codec ->
        Builtin.printLine (Stdlib.Int64.toString (runIterations repetitions data codec expectedChecksum 0L))
