// Reduced bitwise absorption benchmark for quick validation.

def repeat(n: Int64, result: Int64) : Int64 =
    if n <= 0 then result
    else
        let absorbedAnd = n & (n ||| result) in
        let absorbedOr = n ||| (n & result) in
        repeat(n - 1, absorbedAnd + absorbedOr)

repeat(10000, 0)
