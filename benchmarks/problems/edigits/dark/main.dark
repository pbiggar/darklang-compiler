// Edigits Benchmark - Computing digits of e
// Uses series expansion: e = sum(1/n!) for n=0 to infinity
// Computes checksum of first N digits

// Store 15 decimal digits per Int64 chunk. For n <= 50, carry * chunkBase
// remains safely within Int64 while cutting persistent-list traversal by 15x.
def chunkBase() : Int64 = 1000000000000000

def chunkWidth() : Int64 = 15

def leadingOne() : Int64 = 100000000000000

// Divide each chunk by n, propagating carry left-to-right.
def divideByN(chunks: List<Int64>, n: Int64, carry: Int64, idx: Int64, len: Int64) : List<Int64> =
    if idx >= len then chunks
    else
        match Stdlib.List.getAt<Int64>(chunks, idx) with
        | None -> chunks
        | Some(chunk) ->
            let current = carry * chunkBase() + chunk in
            let newChunk = current / n in
            let newCarry = current % n in
            let updated = Stdlib.List.setAt<Int64>(chunks, idx, newChunk) in
            divideByN(updated, n, newCarry, idx + 1, len)

// Add chunks right-to-left so carries flow toward the most-significant chunk.
def addWithCarry(e: List<Int64>, term: List<Int64>, carry: Int64, idx: Int64) : List<Int64> =
    if idx < 0 then e
    else
        match Stdlib.List.getAt<Int64>(e, idx) with
        | None -> e
        | Some(eChunk) ->
            match Stdlib.List.getAt<Int64>(term, idx) with
            | None -> e
            | Some(termChunk) ->
                let total = eChunk + termChunk + carry in
                let newChunk = total % chunkBase() in
                let newCarry = total / chunkBase() in
                let updated = Stdlib.List.setAt<Int64>(e, idx, newChunk) in
                addWithCarry(updated, term, newCarry, idx - 1)

// Add one factorial term to e: e += term, then term /= n
def addFactorialTerm(e: List<Int64>, term: List<Int64>, n: Int64, maxN: Int64, len: Int64) : List<Int64> =
    if n > maxN then e
    else
        let newTerm = divideByN(term, n, 0, 0, len) in
        let newE = addWithCarry(e, newTerm, 0, len - 1) in
        addFactorialTerm(newE, newTerm, n + 1, maxN, len)

def initChunks(n: Int64) : List<Int64> =
    [leadingOne(), ...Stdlib.List.repeat<Int64>(0, n - 1)]

// Compute digits of e
def computeEDigits(numDigits: Int64) : List<Int64> =
    let precision = numDigits + 10 in
    let chunkCount = (precision + chunkWidth() - 1) / chunkWidth() in
    let e = initChunks(chunkCount) in
    let term = initChunks(chunkCount) in
    addFactorialTerm(e, term, 1, 50, chunkCount)

// Compute checksum: sum(digit * (index + 1)) mod 1000000007
def checksumChunk(chunk: Int64, divisor: Int64, idx: Int64, acc: Int64, numDigits: Int64) : (Int64, Int64) =
    if divisor <= 0 || idx >= numDigits then (idx, acc)
    else
        let digit = (chunk / divisor) % 10 in
        let newAcc = (acc + digit * (idx + 1)) % 1000000007 in
        checksumChunk(chunk, divisor / 10, idx + 1, newAcc, numDigits)

def computeChecksum(chunks: List<Int64>, chunkIdx: Int64, digitIdx: Int64, acc: Int64, numDigits: Int64) : Int64 =
    if digitIdx >= numDigits then acc
    else
        match Stdlib.List.getAt<Int64>(chunks, chunkIdx) with
        | None -> acc
        | Some(chunk) ->
            let chunkResult = checksumChunk(chunk, leadingOne(), digitIdx, acc, numDigits) in
            computeChecksum(chunks, chunkIdx + 1, chunkResult.0, chunkResult.1, numDigits)

// Run multiple iterations
def runIterations(n: Int64, numDigits: Int64) : Int64 =
    if n <= 0 then 0
    else
        let digits = computeEDigits(numDigits) in
        let checksum = computeChecksum(digits, 0, 0, 0, numDigits) in
        if n == 1 then checksum
        else runIterations(n - 1, numDigits)

// Match the canonical benchmark size used by the reference implementations.
let numDigits = 1000 in
let iterations = 10 in
let result = runIterations(iterations, numDigits) in
Stdlib.Int64.toString(result)
