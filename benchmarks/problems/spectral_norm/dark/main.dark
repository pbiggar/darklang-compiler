// Spectral Norm Benchmark - full-size immutable skew-RAL implementation.

let matA(i: Int64, j: Int64) : Float =
    let ij = i + j in
    let div = ij * (ij + 1) / 2 + i + 1 in
    1.0 / Stdlib.Int64.toFloat(div)

// All callers prove the index is within the fixed vector length.
let getAt(v: List<Float>, i: Int64) : Float =
    Stdlib.List.getAtOrDefault<Float>(v, i, 0.0)

let avRow(i: Int64, j: Int64, n: Int64, v: List<Float>, acc: Float) : Float =
    if j >= n then acc
    else avRow(i, j + 1, n, v, acc + matA(i, j) * getAt(v, j))

let atvRow(i: Int64, j: Int64, n: Int64, v: List<Float>, acc: Float) : Float =
    if j >= n then acc
    else atvRow(i, j + 1, n, v, acc + matA(j, i) * getAt(v, j))

let avRows(i: Int64, n: Int64, v: List<Float>, out: List<Float>) : List<Float> =
    if i >= n then out
    else avRows(i + 1, n, v, Stdlib.Internal.SkewList.setAt<Float>(out, i, avRow(i, 0, n, v, 0.0)))

let atvRows(i: Int64, n: Int64, v: List<Float>, out: List<Float>) : List<Float> =
    if i >= n then out
    else atvRows(i + 1, n, v, Stdlib.Internal.SkewList.setAt<Float>(out, i, atvRow(i, 0, n, v, 0.0)))

let atav(n: Int64, v: List<Float>) : List<Float> =
    let zeroes = Stdlib.List.__repeatInt64<Float>(n, 0.0, []) in
    atvRows(0, n, avRows(0, n, v, zeroes), zeroes)

let iterate(iterations: Int64, n: Int64, u: List<Float>, v: List<Float>) : (List<Float>, List<Float>) =
    if iterations <= 0 then (u, v)
    else
        let nextV = atav(n, u) in
        let nextU = atav(n, nextV) in
        iterate(iterations - 1, n, nextU, nextV)

let dot(i: Int64, n: Int64, a: List<Float>, b: List<Float>, acc: Float) : Float =
    if i >= n then acc
    else dot(i + 1, n, a, b, acc + getAt(a, i) * getAt(b, i))

let spectralNorm(n: Int64) : Float =
    let result = iterate(10, n, Stdlib.List.__repeatInt64<Float>(n, 1.0, []), Stdlib.List.__repeatInt64<Float>(n, 0.0, [])) in
    let u = result.0 in
    let v = result.1 in
    Stdlib.Float.sqrt(dot(0, n, u, v, 0.0) / dot(0, n, v, v, 0.0))

Builtin.printLine(Stdlib.Int64.toString(Stdlib.Float.toInt(spectralNorm(100) * 1000000000.0)))
