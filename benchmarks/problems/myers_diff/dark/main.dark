// Myers shortest-edit-path benchmark over deterministic in-memory byte strings.
// Each frontier layer uses a dictionary keyed by diagonal, preserving the
// O((N + M)D) Myers search architecture without quadratic edit-distance tables.

let byteAt (value: String) (index: Int64) : Int64 =
    match Stdlib.String.getByteAt value (Stdlib.Int.fromInt64 index) with
    | Some byte -> Stdlib.Int64.fromUInt8 byte
    | None -> Builtin.testRuntimeError "Myers byte index is out of range"

let stringLengthFrom (value: String) (index: Int64) : Int64 =
    match Stdlib.String.getByteAt value (Stdlib.Int.fromInt64 index) with
    | Some _ -> stringLengthFrom value (index + 1L)
    | None -> index

let stringLength (value: String) : Int64 = stringLengthFrom value 0L

type DiffResult = { distance: Int64, work: Int64 }

let diagonalKey (value: Int64) : String = Stdlib.Int64.toString value

let frontierGet (frontier: Dict<String, Int64>) (diagonal: Int64) : Int64 =
    match Stdlib.Dict.get frontier (diagonalKey diagonal) with
    | Some value -> value
    | None -> Builtin.testRuntimeError ("missing Myers frontier diagonal " ++ diagonalKey diagonal)

let snake (left: String) (right: String) (leftLength: Int64) (rightLength: Int64) (x: Int64) (y: Int64) : (Int64 * Int64) =
    if x >= leftLength || y >= rightLength then (x, y)
    else if byteAt left x == byteAt right y then snake left right leftLength rightLength (x + 1L) (y + 1L)
    else (x, y)

let search (leftText: String) (rightText: String) (d: Int64) (k: Int64) (previous: Dict<String, Int64>) (current: Dict<String, Int64>) (outcome: (Bool * Int64)) : DiffResult =
    let (found, work) = outcome in
    if k > d then
        if found then DiffResult { distance = d, work = work }
        else if d >= stringLength leftText + stringLength rightText then
            Builtin.testRuntimeError "Myers search exceeded maximum edit distance"
        else search leftText rightText (d + 1L) (-(d + 1L)) current Stdlib.Dict.empty ((false, work))
    else
        let leftLength = stringLength leftText in
        let rightLength = stringLength rightText in
        let choice =
            if k == -d then frontierGet previous (k + 1L)
            else if k == d then frontierGet previous (k - 1L) + 1L
            else
                let previousLeft = frontierGet previous (k - 1L) in
                let previousRight = frontierGet previous (k + 1L) in
                if previousLeft < previousRight then previousRight else previousLeft + 1L in
        let (endX, endY) = snake leftText rightText leftLength rightLength choice (choice - k) in
        let next = Stdlib.Dict.setOverridingDuplicates current (diagonalKey k) endX in
        let nextWork = (work + (endX + 1L) * (endY + 3L) + (k + d + 1L) * 17L) % 1000000007L in
        search leftText rightText d (k + 2L) previous next ((found || (endX >= leftLength && endY >= rightLength), nextWork))

let myers (leftText: String) (rightText: String) : DiffResult =
    let leftLength = stringLength leftText in
    let rightLength = stringLength rightText in
    let (startX, startY) = snake leftText rightText leftLength rightLength 0L 0L in
    let initialWork = (startX + 1L) * (startY + 3L) in
    if startX >= leftLength && startY >= rightLength then DiffResult { distance = 0L, work = initialWork }
    else
        let frontier = Stdlib.Dict.setOverridingDuplicates Stdlib.Dict.empty (diagonalKey 0L) startX in
        search leftText rightText 1L (-1L) frontier Stdlib.Dict.empty ((false, initialWork))

let run (remaining: Int64) (leftText: String) (rightText: String) (result: Int64) : Int64 =
    if remaining <= 0L then result
    else
        let diff = myers leftText rightText in
        run (remaining - 1L) leftText rightText ((result + diff.distance * 1000003L + diff.work) % 1000000007L)

let benchmarkArg (index: Int) : Int64 =
    match Stdlib.Cli.__Args.int64 index with
    | Ok value -> value
    | Error message -> Builtin.testRuntimeError message

let blocks = benchmarkArg 0 in
let insertions = benchmarkArg 1 in
let repetitions = benchmarkArg 2 in
if blocks <= 0L || insertions <= 0L || repetitions <= 0L then Builtin.testRuntimeError "Myers workload arguments must be positive"
else
    let unit = "darklang compiler benchmark: persistent values and recursive paths.\n" in
    let prefix = Stdlib.String.repeat unit (Stdlib.Int.fromInt64 blocks) in
    let suffix = Stdlib.String.repeat unit (Stdlib.Int.fromInt64 (blocks + 1L)) in
    let insertion = Stdlib.String.repeat "<changed-block>" (Stdlib.Int.fromInt64 insertions) in
    let leftText = prefix ++ suffix in
    let rightText = prefix ++ insertion ++ suffix in
    Builtin.printLine (Stdlib.Int64.toString (run repetitions leftText rightText 0L))
