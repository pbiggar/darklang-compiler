// Merkle Trees Benchmark - Quick check version

let hashLoop(h: Int64, data: Int64, i: Int64) : Int64 =
    if i >= 8L then h
    else
        let h1 = (h ^ (data & 255L)) * 1099511628211L in
        hashLoop(h1, data, i + 1L)

let hashVal(data: Int64) : Int64 =
    hashLoop(-3750763034362895579L, data, 0L)

let hashPair(left: Int64, right: Int64) : Int64 =
    hashVal(left + right * 31L)

let buildTree(depth: Int64, leafStart: Int64) : Int64 =
    if depth == 0L then hashVal(leafStart)
    else
        let leftSize = 1L << (depth - 1L) in
        let left = buildTree(depth - 1L, leafStart) in
        let right = buildTree(depth - 1L, leafStart + leftSize) in
        hashPair(left, right)

let verifyTree(depth: Int64, leafStart: Int64, expectedRoot: Int64) : Bool =
    buildTree(depth, leafStart) == expectedRoot

let benchmark(depth: Int64, iterations: Int64, i: Int64, checksum: Int64) : Int64 =
    if i >= iterations then checksum
    else
        let root = buildTree(depth, i) in
        let verified = verifyTree(depth, i, root) in
        let newChecksum = (checksum + root) % 1000000007L in
        let finalChecksum = if verified then (newChecksum + 1L) % 1000000007L else newChecksum in
        benchmark(depth, iterations, i + 1L, finalChecksum)

// Reduced: depth=10, iterations=5 instead of depth=15, iterations=50
benchmark(10L, 5L, 0L, 0L)
