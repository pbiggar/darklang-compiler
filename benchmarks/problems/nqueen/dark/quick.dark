// N-Queens Benchmark - Quick check version

let nqueenSolve(allOnes: Int64, cols: Int64, diag1: Int64, diag2: Int64, avail: Int64, count: Int64) : Int64 =
    if avail == 0L then count
    else
        let pos = avail & (0L - avail) in
        let newAvail = avail - pos in
        let newCols = Stdlib.Int64.bitwiseOr(cols, pos) in
        let subCount =
            if newCols == allOnes then 1L
            else
                let newDiag1 = (Stdlib.Int64.bitwiseOr(diag1, pos)) << 1L in
                let newDiag2 = (Stdlib.Int64.bitwiseOr(diag2, pos)) >> 1L in
                let blocked = Stdlib.Int64.bitwiseOr(Stdlib.Int64.bitwiseOr(newCols, newDiag1), newDiag2) in
                let nextRowAvail = allOnes & (~~~blocked) in
                nqueenSolve(allOnes, newCols, newDiag1, newDiag2, nextRowAvail, 0L) in
        nqueenSolve(allOnes, cols, diag1, diag2, newAvail, count + subCount)

let nqueen(n: Int64) : Int64 =
    let allOnes = (1L << n) - 1L in
    nqueenSolve(allOnes, 0L, 0L, 0L, allOnes, 0L)

// Reduced: N=9 instead of N=13
nqueen(9L)
