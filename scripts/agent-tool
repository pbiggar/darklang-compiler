#!/usr/bin/env bash
set -euo pipefail

agent="${1:-}"
role="${2:-inventory}"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
artifact_dir="$root/.dcb/tool-artifacts"
artifact="$artifact_dir/${agent}-${role}.txt"
mkdir -p "$artifact_dir"

case "$agent" in
  pass-optimization)
    pattern='(Pass|pass|phase|Phase|optimi[sz])'
    paths=(src/DarkCompiler)
    ;;
  bad-code-finder)
    pattern='(TODO|FIXME|failwith|invalidOp|NotImplemented|unreachable)'
    paths=(src)
    ;;
  classic-optimizations)
    pattern='(constant fold|dead code|common subexpression|inline|tail call|peephole|strength reduc)'
    paths=(src)
    ;;
  optimization-implementer)
    pattern='(Candidate vs Rust|instructions|regression|optimization)'
    paths=(benchmarks src/DarkCompiler)
    ;;
  int64-type-infer)
    pattern='(int64|Int64|default.*int|integer literal)'
    paths=(src)
    ;;
  benchmark-investigation|benchmark-fixer)
    pattern='(Candidate vs Rust|CONFLICT|regression|instructions)'
    paths=(benchmarks)
    ;;
  darklang-compatibility|feature-parity)
    pattern='(unsupported|not supported|compatib|parity|TODO)'
    paths=(src)
    ;;
  upstream-test-enabler|upstream-test-refresher)
    pattern='(skip|skipped|disabled|upstream)'
    paths=(src/Tests scripts)
    ;;
  module-function-affinity)
    pattern='(module|function|package|namespace)'
    paths=(src/DarkCompiler src/Tests)
    ;;
  parser-pretty-roundtrip)
    pattern='(roundtrip|pretty|parser|parse)'
    paths=(src)
    ;;
  *)
    printf '{"status":"error","error":"unknown-agent","agent":"%s"}\n' "$agent"
    exit 2
    ;;
esac

if [[ "$role" != inventory && "$role" != inspect ]]; then
  printf '{"status":"error","error":"unknown-role","role":"%s"}\n' "$role"
  exit 2
fi

cd "$root"
rg -n -i --glob '!**/bin/**' --glob '!**/obj/**' \
  "$pattern" "${paths[@]}" >"$artifact" || true

matches="$(wc -l <"$artifact" | tr -d ' ')"
ranked="$({ cut -d: -f1 "$artifact" || true; } | sort | uniq -c | sort -k1,1nr -k2,2 | head -8)"
printf '{"status":"ok","agent":"%s","role":"%s","matches":%s,"artifact":"%s","topFiles":[' \
  "$agent" "$role" "$matches" ".dcb/tool-artifacts/${agent}-${role}.txt"
first=1
while read -r count path; do
  [[ -z "${path:-}" ]] && continue
  if [[ $first -eq 0 ]]; then printf ','; fi
  first=0
  printf '{"path":"%s","matches":%s}' "$path" "$count"
done <<<"$ranked"
printf ']}\n'
