#!/usr/bin/env bash
set -uo pipefail

name="${1:-}"
artifact="${2:-}"
shift 2 || true
if [[ -z "$name" || -z "$artifact" || "${1:-}" != "--" ]]; then
  printf '{"status":"error","error":"usage","usage":"scripts/concise-command NAME ARTIFACT -- COMMAND..."}\n'
  exit 2
fi
shift
mkdir -p "$(dirname "$artifact")"
started="$(date +%s)"
"$@" >"$artifact" 2>&1
exit_code=$?
elapsed="$(( $(date +%s) - started ))"
bytes="$(wc -c <"$artifact" | tr -d ' ')"
if [[ $exit_code -eq 0 ]]; then
  printf '{"status":"passed","name":"%s","seconds":%s,"outputBytes":%s,"artifact":"%s"}\n' \
    "$name" "$elapsed" "$bytes" "$artifact"
  exit 0
fi

printf '{"status":"failed","name":"%s","exitCode":%s,"seconds":%s,"outputBytes":%s,"artifact":"%s"}\n' \
  "$name" "$exit_code" "$elapsed" "$bytes" "$artifact"
printf 'essential diagnostic:\n'
grep -E -i -m1 '(^|[^a-z])(error|failed|failure|regression|exception)([^a-z]|$)' "$artifact" || true
printf 'last output:\n'
tail -n 30 "$artifact" | head -c 3072
printf '\nreproduce: '
printf '%q ' "$@"
printf '\n'
exit "$exit_code"
