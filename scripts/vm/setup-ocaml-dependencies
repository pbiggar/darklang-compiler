#!/usr/bin/env bash
# Reproduce pinned native prerequisites and opam dependencies in the VM.
set -euo pipefail
repo=$(cd "$(dirname "$0")/../.." && pwd)
root=${1:?Usage: scripts/vm/setup-ocaml-dependencies ABSOLUTE_TOOLCHAIN_DIRECTORY}
case "$root" in /*) ;; *) echo 'Use an absolute directory' >&2; exit 1;; esac
source "$root/activate"
# CoreCLR's procfs workaround must not alter native configure probes.
unset LD_PRELOAD
mkdir -p "$root/downloads" "$root/native"
export PATH="$root/native/bin:$PATH"
export C_INCLUDE_PATH="$root/native/include"
export LIBRARY_PATH="$root/native/lib"
export PKG_CONFIG_PATH="$root/native/lib/pkgconfig"
fetch () {
  local archive=$1 checksum=$2 url=$3
  if [[ ! -f "$root/downloads/$archive" ]]; then
    curl -fL --retry 2 -o "$root/downloads/$archive" "$url"
  fi
  echo "$checksum  $root/downloads/$archive" | sha256sum --check
}
if [[ ! -x "$root/native/bin/m4" ]]; then
  fetch m4-1.4.20.tar.xz e236ea3a1ccf5f6c270b1c4bb60726f371fa49459a8eaaebc90b216b328daf2b \
    https://ftp.gnu.org/gnu/m4/m4-1.4.20.tar.xz
  tar --no-same-owner -xf "$root/downloads/m4-1.4.20.tar.xz" -C "$root"
  (cd "$root/m4-1.4.20"; ./configure --prefix="$root/native"; make -j1; make install) > "$root/m4-build.log" 2>&1
fi
if [[ ! -f "$root/native/lib/libgmp.a" ]]; then
  fetch gmp-6.3.0.tar.xz a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898 \
    https://gmplib.org/download/gmp/gmp-6.3.0.tar.xz
  tar --no-same-owner -xf "$root/downloads/gmp-6.3.0.tar.xz" -C "$root"
  (cd "$root/gmp-6.3.0"; ./configure --prefix="$root/native" --disable-shared --with-pic; make -j1; make install) > "$root/gmp-build.log" 2>&1
fi
if [[ ! -x "$root/native/bin/pkg-config" ]]; then
  fetch pkg-config-0.29.2.tar.gz 6fc69c01688c9458a57eb9a1664c9aba372ccda420a02bf4429fe610e7e7d591 \
    https://pkgconfig.freedesktop.org/releases/pkg-config-0.29.2.tar.gz
  tar --no-same-owner -xf "$root/downloads/pkg-config-0.29.2.tar.gz" -C "$root"
  (cd "$root/pkg-config-0.29.2"; ./configure --prefix="$root/native" --with-internal-glib; make -j1; make install) > "$root/pkg-config-build.log" 2>&1
fi
# SQLite host cache: extract the same Noble development/runtime pair without root.
if [[ ! -f "$root/native/include/sqlite3.h" || ! -f "$root/native/lib/libsqlite3.so.0" ]]; then
  fetch sqlite-dev-3.45.1.deb d23577c43936fedd8c4fa1337a6e960a6e71e94ac164d7a15c46ea96bf21265d \
    https://archive.ubuntu.com/ubuntu/pool/main/s/sqlite3/libsqlite3-dev_3.45.1-1ubuntu2_amd64.deb
  fetch sqlite-runtime-3.45.1.deb 6ea94c8a822551187cef0085073910eeae0a7525cfec4415171942c7019c68af \
    https://archive.ubuntu.com/ubuntu/pool/main/s/sqlite3/libsqlite3-0_3.45.1-1ubuntu2_amd64.deb
  mkdir -p "$root/sqlite-host-deps" "$root/native/include" "$root/native/lib"
  dpkg-deb -x "$root/downloads/sqlite-dev-3.45.1.deb" "$root/sqlite-host-deps"
  dpkg-deb -x "$root/downloads/sqlite-runtime-3.45.1.deb" "$root/sqlite-host-deps"
  cp "$root/sqlite-host-deps/usr/include/sqlite3.h" "$root/native/include/"
  cp -a "$root/sqlite-host-deps/usr/lib/x86_64-linux-gnu/"libsqlite3.so* "$root/native/lib/"
fi
# The development image supplies ICU and libcurl headers/libraries, on both
# host architectures. These bindings are compiler dependencies only.
fetch opam a59184447f881005dae70b2ae455c3a7e9549834a41c635c49a5a28235eca758 \
  https://github.com/ocaml/opam/releases/download/2.6.0/opam-2.6.0-x86_64-linux
chmod +x "$root/downloads/opam"
export OPAMROOT="$root/opam"
opam="$root/downloads/opam"
if [[ ! -f "$OPAMROOT/config" ]]; then
  "$opam" init --bare --disable-sandboxing --yes > "$root/opam-init.log" 2>&1
fi
if ! "$opam" switch list --short | rg -x 'port-5.5.1' >/dev/null; then
  "$opam" switch create port-5.5.1 ocaml-system.5.5.1 --yes --jobs=1 --no-depexts > "$root/opam-switch.log" 2>&1
fi
packages=()
while IFS= read -r package; do
  case "$package" in ''|'#'*) ;; *) packages+=("$package");; esac
done < "$repo/ocaml/dependencies.lock"
"$opam" install --switch=port-5.5.1 --yes --jobs=1 --no-depexts "${packages[@]}" > "$root/opam-dependencies.log" 2>&1
printf 'Pinned OCaml dependencies installed. Build with:\n'
printf '  source %q/activate\n' "$root"
printf '  export OCAMLPATH=%q/opam/port-5.5.1/lib\n' "$root"
printf '  env -u LD_PRELOAD %q/opam/port-5.5.1/bin/dune build --root ocaml -j1\n' "$root"
