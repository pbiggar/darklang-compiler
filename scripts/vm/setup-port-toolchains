#!/usr/bin/env bash
# Install the OCaml port's toolchains inside a writable VM workspace.
set -euo pipefail
repo=$(cd "$(dirname "$0")/../.." && pwd)
root=${1:?Usage: scripts/vm/setup-port-toolchains ABSOLUTE_TOOLCHAIN_DIRECTORY}
case "$root" in /*) ;; *) echo 'Use an absolute directory' >&2; exit 1;; esac
sdk=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["sdk"]["version"])' "$repo/global.json")
ocaml_version=5.3.0
mkdir -p "$root"/{downloads,tmp,dotnet,dotnet-home,nuget,ocaml}
if [[ ! -x "$root/dotnet/dotnet" ]]; then
  curl -fL --retry 2 -o "$root/downloads/dotnet.tar.gz" \
    "https://builds.dotnet.microsoft.com/dotnet/Sdk/$sdk/dotnet-sdk-$sdk-linux-x64.tar.gz"
  tar --no-same-owner -xzf "$root/downloads/dotnet.tar.gz" -C "$root/dotnet"
fi
python3 "$repo/scripts/vm/materialize-links.py" "$root/downloads/dotnet.tar.gz" "$root/dotnet"
gcc -shared -fPIC "$repo/scripts/vm/compat.c" -ldl -pthread -o "$root/vm-compat.so"
if [[ ! -x "$root/ocaml/bin/ocamlopt" ]]; then
  curl -fL --retry 2 -o "$root/downloads/ocaml.tar.gz" \
    "https://github.com/ocaml/ocaml/archive/refs/tags/$ocaml_version.tar.gz"
  tar --no-same-owner -xzf "$root/downloads/ocaml.tar.gz" -C "$root"
  (
    cd "$root/ocaml-$ocaml_version"
    export TMPDIR="$root/tmp"
    ./configure --prefix="$root/ocaml" > "$root/ocaml-configure.log" 2>&1
    make -j1 world.opt > "$root/ocaml-build.log" 2>&1
    make install > "$root/ocaml-install.log" 2>&1
  )
fi
python3 - "$root" <<'PY'
import pathlib, shlex, sys
root = pathlib.Path(sys.argv[1])
values = {
    "DOTNET_ROOT": root / "dotnet",
    "DOTNET_CLI_HOME": root / "dotnet-home",
    "NUGET_PACKAGES": root / "nuget",
    "TMPDIR": root / "tmp",
    "PORT_VM_TMPDIR": root / "tmp",
    "DOTNET_EnableDiagnostics": "0",
    "DOTNET_PROCESSOR_COUNT": "1",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "LD_PRELOAD": root / "vm-compat.so",
}
lines = [f"export {key}={shlex.quote(str(value))}" for key, value in values.items()]
lines += [f'export PATH={shlex.quote(str(root / "ocaml/bin"))}:{shlex.quote(str(root / "dotnet"))}:"$PATH"']
(root / "activate").write_text("# Source this file before building in the VM.\n" + "\n".join(lines) + "\n")
PY
source "$root/activate"
dotnet --version
ocamlc -version
ocamlopt -version
echo "Activate with: source $root/activate"
