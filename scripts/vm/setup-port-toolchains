#!/usr/bin/env bash
# Install the OCaml port's toolchains inside a writable VM workspace.
set -euo pipefail
repo=$(cd "$(dirname "$0")/../.." && pwd)
root=${1:?Usage: scripts/vm/setup-port-toolchains ABSOLUTE_TOOLCHAIN_DIRECTORY}
case "$root" in /*) ;; *) echo 'Use an absolute directory' >&2; exit 1;; esac
sdk=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["sdk"]["version"])' "$repo/global.json")
ocaml_version=5.5.1
ocaml_prefix="$root/ocaml-$ocaml_version-install"
mkdir -p "$root"/{downloads,tmp,dotnet,dotnet-home,nuget,ocaml}
if [[ ! -x "$root/dotnet/dotnet" ]]; then
  curl -fL --retry 2 -o "$root/downloads/dotnet.tar.gz" \
    "https://builds.dotnet.microsoft.com/dotnet/Sdk/$sdk/dotnet-sdk-$sdk-linux-x64.tar.gz"
  tar --no-same-owner -xzf "$root/downloads/dotnet.tar.gz" -C "$root/dotnet"
fi
python3 "$repo/scripts/vm/materialize-links.py" "$root/downloads/dotnet.tar.gz" "$root/dotnet"
gcc -shared -fPIC "$repo/scripts/vm/compat.c" -ldl -pthread -o "$root/vm-compat.so"
# A version check alone accepts builds whose configure probes disabled Unix
# operations needed by opam and Dune. Exercise those operations before reuse.
cat > "$root/ocaml/unix-smoke.ml" <<'ML'
let () =
  ignore (Unix.realpath ".");
  let child = Unix.create_process "/bin/true" [|"/bin/true"|]
    Unix.stdin Unix.stdout Unix.stderr in
  match snd (Unix.waitpid [] child) with
  | Unix.WEXITED 0 -> ()
  | _ -> failwith "OCaml Unix process smoke check failed"
ML
ocaml_unix_works () {
  [[ -x "$ocaml_prefix/bin/ocaml" ]] &&
    env -u LD_PRELOAD "$ocaml_prefix/bin/ocaml" -I +unix unix.cma \
      "$root/ocaml/unix-smoke.ml" > "$root/ocaml-unix-smoke.log" 2>&1
}
if ! ocaml_unix_works; then
  curl -fL --retry 2 -o "$root/downloads/ocaml.tar.gz" \
    "https://github.com/ocaml/ocaml/archive/refs/tags/$ocaml_version.tar.gz"
  echo 'ae47728d0a876665ccc7b745e3a8d8c9ca5ba63c4f7a11d4db6cdbd1dbeef4bb  '"$root/downloads/ocaml.tar.gz" | sha256sum --check
  tar --no-same-owner -xzf "$root/downloads/ocaml.tar.gz" -C "$root"
  (
    cd "$root/ocaml-$ocaml_version"
    export TMPDIR="$root/tmp"
    env -u LD_PRELOAD ./configure --prefix="$ocaml_prefix" > "$root/ocaml-configure.log" 2>&1
    env -u LD_PRELOAD make -j1 world.opt > "$root/ocaml-build.log" 2>&1
    env -u LD_PRELOAD make install > "$root/ocaml-install.log" 2>&1
  )
fi
ocaml_unix_works
python3 - "$root" "$ocaml_prefix" <<'PY'
import pathlib, shlex, sys
root = pathlib.Path(sys.argv[1])
values = {
    "DOTNET_ROOT": root / "dotnet",
    "DOTNET_CLI_HOME": root / "dotnet-home",
    "NUGET_PACKAGES": root / "nuget",
    "TMPDIR": root / "tmp",
    "PORT_VM_TMPDIR": root / "tmp",
    "DOTNET_EnableDiagnostics": "0",
    "DOTNET_PROCESSOR_COUNT": "1",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "LD_PRELOAD": root / "vm-compat.so",
    "C_INCLUDE_PATH": f"{root / 'native/include'}:{root / 'qemu-deps/sysroot/usr/include'}",
    "LIBRARY_PATH": f"{root / 'native/lib'}:{root / 'qemu-deps/sysroot/usr/lib/x86_64-linux-gnu'}",
    "LD_LIBRARY_PATH": f"{root / 'native/lib'}:{root / 'qemu-deps/sysroot/usr/lib/x86_64-linux-gnu'}",
}
lines = [f"export {key}={shlex.quote(str(value))}" for key, value in values.items()]
# The full migration oracle is a large FSI compilation unit. A fresh VM's
# 8 MiB initial stack can overflow while compiling it; retain a bounded 64 MiB
# stack for reference compilation and the procfs-free stack-discovery adapter.
lines += ['ulimit -s 65536']
lines += [f'export PATH={shlex.quote(str(pathlib.Path(sys.argv[2]) / "bin"))}:{shlex.quote(str(root / "dotnet"))}:"$PATH"']
(root / "activate").write_text("# Source this file before building in the VM.\n" + "\n".join(lines) + "\n")
(root / "activate-native").write_text(
    "# Source this file before executing native tests in the restricted VM.\n"
    + f"source {shlex.quote(str(root / 'activate'))}\n"
    + f"export PORT_QEMU_DIRECTORY={shlex.quote(str(root / 'qemu/build'))}\n"
    + f"export LD_PRELOAD={shlex.quote(str(root / 'qemu-deps/exec-path.so'))}:\"$LD_PRELOAD\"\n")
PY
source "$root/activate"
dotnet --version
ocamlc -version
ocamlopt -version
echo "Activate with: source $root/activate"
