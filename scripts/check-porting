#!/usr/bin/env bash
# check-porting - Verify the source-owned ledger and imported upstream bodies.
set -euo pipefail
cd "$(dirname "$0")/.."
python3 scripts/test_ledger_sources.py
python3 scripts/test_ledger.py
for argument in "$@"; do
    if [[ "$argument" == --upstream* ]]; then
        exec python3 scripts/update-ledger.py --check "$@"
    fi
done
porting_temp=$(mktemp -d)
trap 'rm -rf -- "$porting_temp"' EXIT
porting_revision=$(python3 -c 'import yaml; print(yaml.safe_load(open("porting/sources.yaml"))["upstream_revision"])')
git init -q "$porting_temp/upstream"
git -C "$porting_temp/upstream" fetch -q --depth 1 https://github.com/darklang/dark.git "$porting_revision"
python3 scripts/update-ledger.py --check --upstream "$porting_temp/upstream" "$@"
