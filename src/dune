(include_subdirs unqualified)
(rule
 (target EmbeddedStdlib.ml)
 (deps ../scripts/embed-stdlib.py ../library-sources.list
  (source_tree ../StdLib) (source_tree ../packages))
 (action (run python3 %{dep:../scripts/embed-stdlib.py} .. %{target})))
(rule
 (target BuildPlatform.ml)
 (action (with-stdout-to %{target}
  (echo "(* BuildPlatform.ml - Native OCaml build target. *)\nlet system = \"%{ocaml-config:system}\"\nlet architecture = \"%{ocaml-config:architecture}\""))))
(library
 (name dark_compiler)
 (libraries digestif.ocaml unix threads cohttp-lwt-unix tls-lwt ca-certs sqlite3 uutf uucp uunf uuseg zarith yojson mtime.clock.os uri uuidm)
 ; Shared field names are part of the frozen syntax schema. Warning 42 only
 ; concerns compatibility with OCaml before 4.01; this port pins 5.5.1.
 (flags (:standard -w @a-42 -warn-error +a-42)))
