---NAME---
licm_hoist_tuple_load
---INPUT---
let loop (n: Int64) (acc: Int64) (t: (Int64 * Int64)) : Int64 =
    if n < 1L then acc
    else
        let v = t.0 in
        loop (n - 1L) (acc + v) (t)
---EXPECTED---
Function loop:
  loop_entry:
    v14017 <- HeapLoad(v4002, 0)
    jump loop_body
  loop_body:
    v14013 <- Phi([(v4000, loop_entry), (v14020, loop_ssa_2)]) : TInt64
    v14014 <- Phi([(v4001, loop_entry), (v14021, loop_ssa_2)]) : TInt64
    v14016 <- v14013 < 1 : TInt64
    branch v14016 ? loop_ssa_1 : loop_ssa_2
  loop_ssa_1:
    ret v14014
  loop_ssa_2:
    v14018 <- v14013 - 1 : TInt64
    v14019 <- v14014 + v14017 : TInt64
    v14020 <- v14018 : TInt64
    v14021 <- v14019 : TInt64
    jump loop_body

---NAME---
derived_induction_affine_shift
---INPUT---
let loop (i: Int64) (n: Int64) (total: Int64) : Int64 =
    if i >= n then total
    else
        let odd = 2L * i + 1L in
        loop (i + 1L) (n) (total + odd)
---EXPECTED---
Function loop:
  loop_entry:
    v14026 <- v4000 << 1 : TInt64
    v14027 <- v14026 + 1 : TInt64
    jump loop_body
  loop_body:
    v14015 <- Phi([(v4000, loop_entry), (v14035, loop_ssa_2_unroll_second)]) : TInt64
    v14016 <- Phi([(v4001, loop_entry), (v14036, loop_ssa_2_unroll_second)]) : TInt64
    v14017 <- Phi([(v4002, loop_entry), (v14037, loop_ssa_2_unroll_second)]) : TInt64
    v14020 <- Phi([(v14027, loop_entry), (v14034, loop_ssa_2_unroll_second)]) : TInt64
    v14018 <- v14015 >= v14016 : TInt64
    branch v14018 ? loop_ssa_1 : loop_ssa_2
  loop_ssa_1:
    ret v14017
  loop_ssa_1_unroll_remainder:
    ret v14022
  loop_ssa_2:
    v14021 <- v14015 + 1 : TInt64
    v14022 <- v14017 + v14020 : TInt64
    v14028 <- v14020 + 2 : TInt64
    v14030 <- v14021 >= v14016 : TInt64
    branch v14030 ? loop_ssa_1_unroll_remainder : loop_ssa_2_unroll_second
  loop_ssa_2_unroll_second:
    v14031 <- v14021 + 1 : TInt64
    v14032 <- v14022 + v14028 : TInt64
    v14033 <- v14028 + 2 : TInt64
    v14034 <- v14033 : TInt64
    v14035 <- v14031 : TInt64
    v14036 <- v14016 : TInt64
    v14037 <- v14032 : TInt64
    jump loop_body

---NAME---
derived_induction_affine_invariant_coefficient_positive
---INPUT---
let loop (i: Int64) (n: Int64) (a: Int64) (total: Int64) : Int64 =
    if i >= n then total
    else
        let value = a * i + 3L in
        loop (i + 1L) (n) (a) (total + value)
---EXPECTED---
Function loop:
  loop_entry:
    v14031 <- v4000 * v4002 : TInt64
    v14032 <- v14031 + 3 : TInt64
    jump loop_body
  loop_body:
    v14018 <- Phi([(v4000, loop_entry), (v14040, loop_ssa_2_unroll_second)]) : TInt64
    v14019 <- Phi([(v4001, loop_entry), (v14041, loop_ssa_2_unroll_second)]) : TInt64
    v14020 <- Phi([(v4002, loop_entry), (v14042, loop_ssa_2_unroll_second)]) : TInt64
    v14021 <- Phi([(v4003, loop_entry), (v14043, loop_ssa_2_unroll_second)]) : TInt64
    v14024 <- Phi([(v14032, loop_entry), (v14039, loop_ssa_2_unroll_second)]) : TInt64
    v14022 <- v14018 >= v14019 : TInt64
    branch v14022 ? loop_ssa_1 : loop_ssa_2
  loop_ssa_1:
    ret v14021
  loop_ssa_1_unroll_remainder:
    ret v14026
  loop_ssa_2:
    v14025 <- v14018 + 1 : TInt64
    v14026 <- v14021 + v14024 : TInt64
    v14033 <- v14024 + v14020 : TInt64
    v14035 <- v14025 >= v14019 : TInt64
    branch v14035 ? loop_ssa_1_unroll_remainder : loop_ssa_2_unroll_second
  loop_ssa_2_unroll_second:
    v14036 <- v14025 + 1 : TInt64
    v14037 <- v14026 + v14033 : TInt64
    v14038 <- v14033 + v14020 : TInt64
    v14039 <- v14038 : TInt64
    v14040 <- v14036 : TInt64
    v14041 <- v14019 : TInt64
    v14042 <- v14020 : TInt64
    v14043 <- v14037 : TInt64
    jump loop_body

---NAME---
derived_induction_affine_invariant_coefficient_negative
---INPUT---
let loop (i: Int64) (n: Int64) (a: Int64) (total: Int64) : Int64 =
    if i >= n then total
    else
        let value = i * a + -7L in
