---NAME---
self_eq_float_not_folded
---INPUT---
def pick(n: Float) : Int64 =
    if n == n then 1 else 2
---EXPECTED---
Function pick:
  pick_entry:
    v10002 <- v0 == v0 : TFloat64
    branch v10002 ? pick_L0 : pick_L1
  pick_L0:
    ret 1
  pick_L1:
    ret 2

---NAME---
self_eq_shadowed_vars_not_folded
---INPUT---
def pick(n: Int64) : Int64 =
    let x = n in
    let x = n + 1 in
    if x == n then 1 else 2
---EXPECTED---
Function pick:
  pick_entry:
    v10005 <- v0 + 1 : TInt64
    v10006 <- v10005 == v0 : TInt64
    branch v10006 ? pick_L0 : pick_L1
  pick_L0:
    ret 1
  pick_L1:
    ret 2

---NAME---
self_division_not_folded
---INPUT---
def divideSelf(n: Int64) : Int64 =
    n / n
---EXPECTED---
Function divideSelf:
  divideSelf_entry:
    v10001 <- v0 / v0 : TInt64
    ret v10001

---NAME---
licm_hoist_tuple_load
---INPUT---
def loop(n: Int64, acc: Int64, t: (Int64, Int64)) : Int64 =
    if n < 1 then acc
    else
        let v = t.0 in
        loop(n - 1, acc + v, t)
---EXPECTED---
Function loop:
  loop_entry:
    v10023 <- HeapLoad(v2, 0)
    jump loop_body
  loop_L1:
    v10024 <- v10021 - 1 : TInt64
    v10025 <- v10020 + v10023 : TInt64
    v10029 <- v10024 : TInt64
    v10030 <- v10025 : TInt64
    jump loop_body
  loop_L2:
    ret v10020
  loop_body:
    v10020 <- Phi([(v1, loop_entry), (v10030, loop_L1)]) : TInt64
    v10021 <- Phi([(v0, loop_entry), (v10029, loop_L1)]) : TInt64
    v10022 <- v10021 < 1 : TInt64
    branch v10022 ? loop_L2 : loop_L1

---NAME---
derived_induction_affine_shift
---INPUT---
def loop(i: Int64, n: Int64, total: Int64) : Int64 =
    if i >= n then total
    else
        let odd = 2 * i + 1 in
        loop(i + 1, n, total + odd)
---EXPECTED---
Function loop:
  loop_entry:
    v10035 <- v0 << 1 : TInt64
    v10036 <- v10035 + 1 : TInt64
    jump loop_body
  loop_L1:
    v10027 <- v10023 + 1 : TInt64
    v10028 <- v10021 + v10026 : TInt64
    v10037 <- v10026 + 2 : TInt64
    v10038 <- v10037 : TInt64
    v10032 <- v10027 : TInt64
    v10033 <- v10022 : TInt64
    v10034 <- v10028 : TInt64
    jump loop_body
  loop_L2:
    ret v10021
  loop_body:
    v10021 <- Phi([(v2, loop_entry), (v10034, loop_L1)]) : TInt64
    v10022 <- Phi([(v1, loop_entry), (v10033, loop_L1)]) : TInt64
    v10023 <- Phi([(v0, loop_entry), (v10032, loop_L1)]) : TInt64
    v10026 <- Phi([(v10036, loop_entry), (v10038, loop_L1)]) : TInt64
    v10024 <- v10023 >= v10022 : TInt64
    branch v10024 ? loop_L2 : loop_L1
