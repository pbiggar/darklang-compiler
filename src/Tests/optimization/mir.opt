// MIR Optimization Tests
// Tests MIR optimizations such as loop-invariant code motion in SSA form.

---NAME---
counted_loop_unroll_by_two_mir
---INPUT---
let loop(i: Int64, limit: Int64, sum: Float, sign: Float) : Float =
    if i >= limit then sum
    else loop(i + 1, limit, sum + sign, Stdlib.Float.negate(sign))
---EXPECTED---
Function loop:
  loop_entry:
    jump loop_body
  loop_L1:
    v10026 <- v10024 + 1 : TInt64
    v10027 <- v10022 + v10021 : TFloat64
    v10028 <- FloatNeg(v10021)
    v10037 <- v10026 >= v10023 : TInt64
    branch v10037 ? loop_L2_unroll_remainder : loop_L1_unroll_second
  loop_L1_unroll_second:
    v10038 <- v10026 + 1 : TInt64
    v10039 <- v10027 + v10028 : TFloat64
    v10040 <- FloatNeg(v10028)
    v10041 <- v10038 : TInt64
    v10042 <- v10023 : TInt64
    v10043 <- v10039 : TFloat64
    v10044 <- v10040 : TFloat64
    jump loop_body
  loop_L2:
    ret v10022
  loop_L2_unroll_remainder:
    ret v10027
  loop_body:
    v10021 <- Phi([(v3, loop_entry), (v10044, loop_L1_unroll_second)]) : TFloat64
    v10022 <- Phi([(v2, loop_entry), (v10043, loop_L1_unroll_second)]) : TFloat64
    v10023 <- Phi([(v1, loop_entry), (v10042, loop_L1_unroll_second)]) : TInt64
    v10024 <- Phi([(v0, loop_entry), (v10041, loop_L1_unroll_second)]) : TInt64
    v10025 <- v10024 >= v10023 : TInt64
    branch v10025 ? loop_L2 : loop_L1

---NAME---
tail_recursion_modulo_addition_forms_loop
---INPUT---
let fib(n: Int64) : Int64 =
    if n <= 1 then n else fib(n - 1) + fib(n - 2)
fib(10)
---EXPECTED---
Function fib:
  fib_entry:
    TailCall(fib$trmo, [v0, 0])
    ret v11

Function fib$trmo:
  fib$trmo_entry:
    jump fib$trmo_body
  fib$trmo_L0:
    v10025 <- v10012 + v10017 : TInt64
    ret v10025
  fib$trmo_L1:
    v10019 <- v10017 - 1 : TInt64
    v10020 <- Call(fib$trmo, [v10019, 0])
    v10021 <- v10017 - 2 : TInt64
    v10022 <- v10012 + v10020 : TInt64
    v10023 <- v10021 : TInt64
    v10024 <- v10022 : TInt64
    jump fib$trmo_body
  fib$trmo_body:
    v10012 <- Phi([(v8, fib$trmo_entry), (v10024, fib$trmo_L1)]) : TInt64
    v10017 <- Phi([(v0, fib$trmo_entry), (v10023, fib$trmo_L1)]) : TInt64
    v10018 <- v10017 <= 1 : TInt64
    branch v10018 ? fib$trmo_L0 : fib$trmo_L1

Function _start:
  _start_body:
    v10007 <- Call(fib, [10])
    Print(v10007, type=TInt64)
    ret v10007

---NAME---
licm_hoists_recursive_effect_free_scalar_call
---INPUT---
let factorial(n: Int64) : Int64 =
    if n <= 1 then 1
    else n * factorial(n - 1)

let repeat(n: Int64, acc: Int64) : Int64 =
    if n <= 0 then acc
    else repeat(n - 1, factorial(20))
---EXPECTED---
Function factorial:
  factorial_entry:
    v10005 <- v0 <= 1 : TInt64
    branch v10005 ? factorial_L0 : factorial_L1
  factorial_L0:
    ret 1
  factorial_L1:
    v10007 <- v0 - 1 : TInt64
    v10008 <- Call(factorial, [v10007])
    v10009 <- v0 * v10008 : TInt64
    ret v10009

Function repeat:
  repeat_entry:
    v10018 <- Call(factorial, [20])
    jump repeat_body
  repeat_L1:
    v10017 <- v10015 - 1 : TInt64
    v10019 <- v10017 : TInt64
    v10020 <- v10018 : TInt64
    jump repeat_body
  repeat_L2:
    ret v10014
  repeat_body:
    v10014 <- Phi([(v6, repeat_entry), (v10020, repeat_L1)]) : TInt64
    v10015 <- Phi([(v5, repeat_entry), (v10019, repeat_L1)]) : TInt64
    v10016 <- v10015 <= 0 : TInt64
    branch v10016 ? repeat_L2 : repeat_L1

---NAME---
licm_hoists_mutually_recursive_effect_free_scalar_call
---INPUT---
let isEven(n: Int64) : Bool =
    if n <= 0 then true else isOdd(n - 1)

let isOdd(n: Int64) : Bool =
    if n <= 0 then false else isEven(n - 1)

let loop(n: Int64, acc: Int64) : Int64 =
    if n <= 0 then acc
    else loop(n - 1, if isEven(20) then acc + 1 else acc)
---EXPECTED---
Function isEven:
  isEven_entry:
    v10004 <- v0 <= 0 : TInt64
    branch v10004 ? isEven_L0 : isEven_L1
  isEven_L0:
    ret true
  isEven_L1:
    v10006 <- v0 - 1 : TInt64
    TailCall(isOdd, [v10006])
    ret v3

Function isOdd:
  isOdd_entry:
    v10008 <- v4 <= 0 : TInt64
    branch v10008 ? isOdd_L0 : isOdd_L1
  isOdd_L0:
    ret false
  isOdd_L1:
    v10010 <- v4 - 1 : TInt64
    TailCall(isEven, [v10010])
    ret v7

Function loop:
  loop_entry:
    v10028 <- Call(isEven, [20])
    jump loop_body
  loop_L0:
    ret v10024
  loop_L1:
    v10027 <- v10025 - 1 : TInt64
    branch v10028 ? loop_L3 : loop_L4
  loop_L3:
    v10033 <- v10024 + 1 : TInt64
    v10034 <- v10027 : TInt64
    v10035 <- v10033 : TInt64
    jump loop_body
  loop_L4:
    v10031 <- v10027 : TInt64
    v10032 <- v10024 : TInt64
    jump loop_body
  loop_body:
    v10024 <- Phi([(v9, loop_entry), (v10032, loop_L4), (v10035, loop_L3)]) : TInt64
    v10025 <- Phi([(v8, loop_entry), (v10031, loop_L4), (v10034, loop_L3)]) : TInt64
    v10026 <- v10025 <= 0 : TInt64
    branch v10026 ? loop_L0 : loop_L1

---NAME---
licm_keeps_effecting_recursive_call_in_loop
---INPUT---
let readRandom(n: Int64) : Int64 =
    if n <= 0 then Stdlib.Random.int64()
    else readRandom(n - 1)

let loop(n: Int64, acc: Int64) : Int64 =
    if n <= 0 then acc
    else loop(n - 1, readRandom(1))
---EXPECTED---
Function readRandom:
  readRandom_entry:
    jump readRandom_body
  readRandom_L0:
    v10011 <- RandomInt64()
    ret v10011
  readRandom_L1:
    v10009 <- v10007 - 1 : TInt64
    v10010 <- v10009 : TInt64
    jump readRandom_body
  readRandom_body:
    v10007 <- Phi([(v0, readRandom_entry), (v10010, readRandom_L1)]) : TInt64
    v10008 <- v10007 <= 0 : TInt64
    branch v10008 ? readRandom_L0 : readRandom_L1

Function loop:
  loop_entry:
    jump loop_body
  loop_L1:
    v10017 <- v10015 - 1 : TInt64
    v10018 <- Call(readRandom, [1])
    v10019 <- v10017 : TInt64
    v10020 <- v10018 : TInt64
    jump loop_body
  loop_L2:
    ret v10014
  loop_body:
    v10014 <- Phi([(v6, loop_entry), (v10020, loop_L1)]) : TInt64
    v10015 <- Phi([(v5, loop_entry), (v10019, loop_L1)]) : TInt64
    v10016 <- v10015 <= 0 : TInt64
    branch v10016 ? loop_L2 : loop_L1

---NAME---
licm_keeps_side_effecting_call_in_loop
---INPUT---
let loop(n: Int64, acc: Int64) : Int64 =
    if n < 1 then acc
    else
        let h = __hash<String>("hello") in
        loop(n - 1, acc + h)
---EXPECTED---
Function loop:
  loop_entry:
    jump loop_body
  loop_L1:
    v10015 <- Call(__hash_str, [str[hello]])
    v10016 <- v10013 - 1 : TInt64
    v10017 <- v10012 + v10015 : TInt64
    v10018 <- v10016 : TInt64
    v10019 <- v10017 : TInt64
    jump loop_body
  loop_L2:
    ret v10012
  loop_body:
    v10012 <- Phi([(v1, loop_entry), (v10019, loop_L1)]) : TInt64
    v10013 <- Phi([(v0, loop_entry), (v10018, loop_L1)]) : TInt64
    v10014 <- v10013 < 1 : TInt64
    branch v10014 ? loop_L2 : loop_L1

---NAME---
licm_skip_constant_move
---INPUT---
let loop(n: Int64) : Int64 =
    if n < 1 then 0
    else loop(1)
---EXPECTED---
Function loop:
  loop_entry:
    jump loop_body
  loop_L1:
    v10006 <- 1 : TInt64
    jump loop_body
  loop_L2:
    ret 0
  loop_body:
    v10004 <- Phi([(v0, loop_entry), (v10006, loop_L1)]) : TInt64
    v10005 <- v10004 < 1 : TInt64
    branch v10005 ? loop_L2 : loop_L1

---NAME---
