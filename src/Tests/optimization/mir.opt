---NAME---
redundant_successor_branch_elimination
---INPUT---
let choose(cond: Bool) : Int64 =
    if cond then (if cond then 1 else 2) else 3
---EXPECTED---
Function choose:
  choose_entry:
    branch v0 ? choose_L3 : choose_L1
  choose_L1:
    ret 3
  choose_L3:
    ret 1

