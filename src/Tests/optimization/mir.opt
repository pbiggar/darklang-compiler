---NAME---
licm_hoist_tuple_load
---INPUT---
let loop(n: Int64, acc: Int64, t: (Int64, Int64)) : Int64 =
    if n < 1 then acc
    else
        let v = t.0 in
        loop(n - 1, acc + v, t)
---EXPECTED---
Function loop:
  loop_entry:
    v10023 <- HeapLoad(v2, 0)
    jump loop_body
  loop_L1:
    v10024 <- v10021 - 1 : TInt64
    v10025 <- v10020 + v10023 : TInt64
    v10029 <- v10024 : TInt64
    v10030 <- v10025 : TInt64
    jump loop_body
  loop_L2:
    ret v10020
  loop_body:
    v10020 <- Phi([(v1, loop_entry), (v10030, loop_L1)]) : TInt64
    v10021 <- Phi([(v0, loop_entry), (v10029, loop_L1)]) : TInt64
    v10022 <- v10021 < 1 : TInt64
    branch v10022 ? loop_L2 : loop_L1

---NAME---
derived_induction_affine_shift
---INPUT---
let loop(i: Int64, n: Int64, total: Int64) : Int64 =
    if i >= n then total
    else
        let odd = 2 * i + 1 in
        loop(i + 1, n, total + odd)
---EXPECTED---
Function loop:
  loop_entry:
    v10035 <- v0 << 1 : TInt64
    v10036 <- v10035 + 1 : TInt64
    jump loop_body
  loop_L1:
    v10027 <- v10023 + 1 : TInt64
    v10028 <- v10021 + v10026 : TInt64
    v10037 <- v10026 + 2 : TInt64
    v10039 <- v10027 >= v10022 : TInt64
    branch v10039 ? loop_L2_unroll_remainder : loop_L1_unroll_second
  loop_L1_unroll_second:
    v10040 <- v10027 + 1 : TInt64
    v10041 <- v10028 + v10037 : TInt64
    v10042 <- v10037 + 2 : TInt64
    v10043 <- v10042 : TInt64
    v10044 <- v10040 : TInt64
    v10045 <- v10022 : TInt64
    v10046 <- v10041 : TInt64
    jump loop_body
  loop_L2:
    ret v10021
  loop_L2_unroll_remainder:
    ret v10028
  loop_body:
    v10021 <- Phi([(v2, loop_entry), (v10046, loop_L1_unroll_second)]) : TInt64
    v10022 <- Phi([(v1, loop_entry), (v10045, loop_L1_unroll_second)]) : TInt64
    v10023 <- Phi([(v0, loop_entry), (v10044, loop_L1_unroll_second)]) : TInt64
    v10026 <- Phi([(v10036, loop_entry), (v10043, loop_L1_unroll_second)]) : TInt64
    v10024 <- v10023 >= v10022 : TInt64
    branch v10024 ? loop_L2 : loop_L1

---NAME---
closure_devirtualization_capture_free_local
---INPUT---
let applyOnce(value: Int64) : Int64 =
  let increment = fun x -> x + 1 in
  increment(value)
---EXPECTED---
Function __closure_0:
  __closure_0_entry:
    v10002 <- v1 + 1 : TInt64
    ret v10002

Function applyOnce:
  applyOnce_entry:
    TailCall(__closure_0, [0, v3])
    ret v6

---NAME---
closure_devirtualization_captured_local
---INPUT---
let addOffset(value: Int64, offset: Int64) : Int64 =
  let add = fun x -> x + offset in
  add(value)
---EXPECTED---
Function __closure_0:
  __closure_0_entry:
    v10004 <- HeapLoad(v0, 8)
    v10005 <- v1 + v10004 : TInt64
    ret v10005

Function addOffset:
  addOffset_entry:
    v10009 <- HeapAlloc(16)
    HeapStore(v10009, 0, &__closure_0)
    HeapStore(v10009, 8, v6)
    v10010 <- ClosureCall(v10009, [v5])
    RefCountDec(v10009, size=0, kind=closure)
    ret v10010

---NAME---
closure_devirtualization_preserves_escaping_closure
---INPUT---
let makeIncrement() : (Int64) -> Int64 =
  let increment = fun x -> x + 1 in
  increment
---EXPECTED---
Function __closure_0:
  __closure_0_entry:
    v10002 <- v1 + 1 : TInt64
    ret v10002

Function makeIncrement:
  makeIncrement_entry:
    v10003 <- HeapAlloc(8)
    HeapStore(v10003, 0, &__closure_0)
    ret v10003

---NAME---
closure_devirtualization_reuses_local_closure
---INPUT---
let applyTwice(value: Int64) : Int64 =
  let increment = fun x -> x + 1 in
  let once = increment(value) in
  increment(once)
---EXPECTED---
Function __closure_0:
  __closure_0_entry:
    v10002 <- v1 + 1 : TInt64
    ret v10002

Function applyTwice:
  applyTwice_entry:
    v10006 <- Call(__closure_0, [0, v3])
    TailCall(__closure_0, [0, v10006])
    ret v8
