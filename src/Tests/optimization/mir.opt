---NAME---
derived_induction_affine_reused_value
---INPUT---
let loop(i: Int64, n: Int64, a: Int64, total: Int64) : Int64 =
    if i >= n then total
    else
        let value = a * i + 1 in
        loop(i + 1, n, a, total + value + value)
---EXPECTED---
Function loop:
  loop_entry:
    v10044 <- v0 * v2 : TInt64
    v10045 <- v10044 + 1 : TInt64
    jump loop_body
  loop_L1:
    v10033 <- v10029 + 1 : TInt64
    v10034 <- v10026 + v10032 : TInt64
    v10035 <- v10034 + v10032 : TInt64
