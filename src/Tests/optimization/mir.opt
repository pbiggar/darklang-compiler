    let x = n in
    let x = n + 1 in
    if x == n then 1 else 2
---EXPECTED---
Function pick:
  pick_entry:
    v10005 <- v0 + 1 : TInt64
    v10006 <- v10005 == v0 : TInt64
    branch v10006 ? pick_L0 : pick_L1
  pick_L0:
    ret 1
  pick_L1:
    ret 2

