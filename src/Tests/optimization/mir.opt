// MIR Optimization Tests
// Tests MIR optimizations such as loop-invariant code motion in SSA form.

---NAME---
counted_loop_unroll_by_two_mir
---INPUT---
let loop (i: Int64) (limit: Int64) (sum: Float) (sign: Float) : Float =
    if i >= limit then sum
    else loop (i + 1L) (limit) (sum + sign) (Stdlib.Float.negate (sign))
---EXPECTED---
Function loop:
  loop_entry:
    jump loop_body
  loop_body:
    v14017 <- Phi([(v4000, loop_entry), (v14033, loop_ssa_2_unroll_second)]) : TInt64
    v14018 <- Phi([(v4001, loop_entry), (v14034, loop_ssa_2_unroll_second)]) : TInt64
    v14019 <- Phi([(v4002, loop_entry), (v14035, loop_ssa_2_unroll_second)]) : TFloat64
    v14020 <- Phi([(v4003, loop_entry), (v14036, loop_ssa_2_unroll_second)]) : TFloat64
    v14021 <- v14017 >= v14018 : TInt64
    branch v14021 ? loop_ssa_1 : loop_ssa_2
  loop_ssa_1:
    ret v14019
  loop_ssa_1_unroll_remainder:
    ret v14023
  loop_ssa_2:
    v14022 <- v14017 + 1 : TInt64
    v14023 <- v14019 + v14020 : TFloat64
    v14024 <- FloatNeg(v14020)
    v14029 <- v14022 >= v14018 : TInt64
    branch v14029 ? loop_ssa_1_unroll_remainder : loop_ssa_2_unroll_second
  loop_ssa_2_unroll_second:
    v14030 <- v14022 + 1 : TInt64
    v14031 <- v14023 + v14024 : TFloat64
    v14032 <- FloatNeg(v14024)
    v14033 <- v14030 : TInt64
    v14034 <- v14018 : TInt64
    v14035 <- v14031 : TFloat64
    v14036 <- v14032 : TFloat64
    jump loop_body

---NAME---
tail_recursion_modulo_addition_forms_loop
---INPUT---
let fib (n: Int64) : Int64 =
    if n <= 1L then n else fib (n - 1L) + fib (n - 2L)
fib (10L)
---EXPECTED---
Function fib:
  fib_entry:
    TailCall(fib$trmo, [v0, 0])
    ret v11
Function fib$trmo:
  fib$trmo_entry:
    jump fib$trmo_body
  fib$trmo_body:
    v10016 <- Phi([(v4000, fib$trmo_entry), (v10021, fib$trmo_ssa_2)]) : TInt64
    v10017 <- Phi([(v4001, fib$trmo_entry), (v10022, fib$trmo_ssa_2)]) : TInt64
    v10018 <- v10016 <= 1 : TInt64
    branch v10018 ? fib$trmo_ssa_1 : fib$trmo_ssa_2
  fib$trmo_ssa_1:
    v10023 <- v10017 + v10016 : TInt64
    ret v10023
  fib$trmo_ssa_2:
    v10019 <- v10016 - 1 : TInt64
    v10020 <- Call(fib$trmo, [v10019, 0])
    v10021 <- v10016 - 2 : TInt64
    v10022 <- v10017 + v10020 : TInt64
    jump fib$trmo_body
Function _start:
  _start_body:
    v10007 <- Call(fib, [10])
    Print(v10007, type=TInt64)
    ret v10007

---NAME---
tail_recursion_modulo_multiplication_forms_loop
---INPUT---
let factorial (n: Int64) : Int64 =
    if n <= 1L then 1L else n * factorial (n - 1L)
factorial (10L)
---EXPECTED---
Function factorial:
  factorial_entry:
    TailCall(factorial$trmo, [v0, 1])
    ret v9
Function factorial$trmo:
  factorial$trmo_entry:
    jump factorial$trmo_body
  factorial$trmo_body:
    v10012 <- Phi([(v4000, factorial$trmo_entry), (v10015, factorial$trmo_ssa_2)]) : TInt64
    v10013 <- Phi([(v4001, factorial$trmo_entry), (v10016, factorial$trmo_ssa_2)]) : TInt64
    v10014 <- v10012 <= 1 : TInt64
    branch v10014 ? factorial$trmo_ssa_1 : factorial$trmo_ssa_2
  factorial$trmo_ssa_1:
    ret v10013
  factorial$trmo_ssa_2:
    v10015 <- v10012 - 1 : TInt64
    v10016 <- v10013 * v10012 : TInt64
    jump factorial$trmo_body
Function _start:
  _start_body:
    v10005 <- Call(factorial, [10])
    Print(v10005, type=TInt64)
    ret v10005

---NAME---
licm_hoists_recursive_effect_free_scalar_call
---INPUT---
let factorial (n: Int64) : Int64 =
    if n <= 1L then 1L
    else n * factorial (n - 1L)

let repeat (n: Int64) (acc: Int64) : Int64 =
    if n <= 0L then acc
    else repeat (n - 1L) (factorial (20L))
---EXPECTED---
Function factorial:
  factorial_entry:
    TailCall(factorial$trmo, [v0, 1])
    ret v14
Function factorial$trmo:
  factorial$trmo_entry:
    jump factorial$trmo_body
  factorial$trmo_body:
    v10017 <- Phi([(v4000, factorial$trmo_entry), (v10020, factorial$trmo_ssa_2)]) : TInt64
    v10018 <- Phi([(v4001, factorial$trmo_entry), (v10021, factorial$trmo_ssa_2)]) : TInt64
    v10019 <- v10017 <= 1 : TInt64
    branch v10019 ? factorial$trmo_ssa_1 : factorial$trmo_ssa_2
  factorial$trmo_ssa_1:
    ret v10018
  factorial$trmo_ssa_2:
    v10020 <- v10017 - 1 : TInt64
    v10021 <- v10018 * v10017 : TInt64
    jump factorial$trmo_body
Function repeat:
  repeat_entry:
    v10017 <- Call(factorial, [20])
    jump repeat_body
  repeat_body:
    v10013 <- Phi([(v4000, repeat_entry), (v10016, repeat_ssa_2)]) : TInt64
    v10014 <- Phi([(v4001, repeat_entry), (v10017, repeat_ssa_2)]) : TInt64
    v10015 <- v10013 <= 0 : TInt64
    branch v10015 ? repeat_ssa_1 : repeat_ssa_2
  repeat_ssa_1:
    ret v10014
  repeat_ssa_2:
    v10016 <- v10013 - 1 : TInt64
    jump repeat_body

---NAME---
licm_hoists_mutually_recursive_effect_free_scalar_call
---INPUT---
let isEven (n: Int64) : Bool =
    if n <= 0L then true else isOdd (n - 1L)

let isOdd (n: Int64) : Bool =
    if n <= 0L then false else isEven (n - 1L)

let loop (n: Int64) (acc: Int64) : Int64 =
    if n <= 0L then acc
    else loop (n - 1L) (if isEven (20L) then acc + 1L else acc)
---EXPECTED---
Function isEven:
  isEven_entry:
    v10002 <- v0 <= 0 : TInt64
    branch v10002 ? isEven_ssa_1 : isEven_ssa_2
  isEven_ssa_1:
    ret true
  isEven_ssa_2:
    v10003 <- v0 - 1 : TInt64
    TailCall(isOdd, [v10003])
    ret v3
Function isOdd:
  isOdd_entry:
    v10006 <- v4 <= 0 : TInt64
    branch v10006 ? isOdd_ssa_1 : isOdd_ssa_2
  isOdd_ssa_1:
    ret false
  isOdd_ssa_2:
    v10007 <- v4 - 1 : TInt64
    TailCall(isEven, [v10007])
    ret v7
Function loop:
  loop_entry:
    v14015 <- Call(isEven, [20])
    jump loop_body
  loop_body:
    v14011 <- Phi([(v4001, loop_entry), (v14014, loop_ssa_3), (v14016, loop_ssa_4)]) : TInt64
    v14012 <- Phi([(v4002, loop_entry), (v14018, loop_ssa_3), (v14017, loop_ssa_4)]) : TInt64
    v14013 <- v14011 <= 0 : TInt64
    branch v14013 ? loop_ssa_1 : loop_ssa_2
  loop_ssa_1:
    ret v14012
  loop_ssa_2:
    v14014 <- v14011 - 1 : TInt64
    branch v14015 ? loop_ssa_3 : loop_ssa_4
  loop_ssa_3:
    v14018 <- v14012 + 1 : TInt64
    jump loop_body
  loop_ssa_4:
    v14016 <- v14014 : TInt64
    v14017 <- v14012 : TInt64
    jump loop_body

---NAME---
licm_keeps_effecting_recursive_call_in_loop
---INPUT---
let readRandom (n: Int64) : Int64 =
    if n <= 0L then Stdlib.Int.__randomInt64Word ()
    else readRandom (n - 1L)

let loop (n: Int64) (acc: Int64) : Int64 =
    if n <= 0L then acc
    else loop (n - 1L) (readRandom (1L))
---EXPECTED---
Function readRandom:
  readRandom_entry:
    jump readRandom_body
  readRandom_body:
    v10006 <- Phi([(v4000, readRandom_entry), (v10008, readRandom_ssa_2)]) : TInt64
    v10007 <- v10006 <= 0 : TInt64
    branch v10007 ? readRandom_ssa_1 : readRandom_ssa_2
  readRandom_ssa_1:
    v10009 <- RandomInt64()
    ret v10009
  readRandom_ssa_2:
    v10008 <- v10006 - 1 : TInt64
    jump readRandom_body
Function loop:
  loop_entry:
    jump loop_body
  loop_body:
    v10013 <- Phi([(v4000, loop_entry), (v10016, loop_ssa_2)]) : TInt64
    v10014 <- Phi([(v4001, loop_entry), (v10017, loop_ssa_2)]) : TInt64
    v10015 <- v10013 <= 0 : TInt64
    branch v10015 ? loop_ssa_1 : loop_ssa_2
  loop_ssa_1:
    ret v10014
  loop_ssa_2:
    v10016 <- v10013 - 1 : TInt64
    v10017 <- Call(readRandom, [1])
    jump loop_body

---NAME---
licm_keeps_side_effecting_call_in_loop
---INPUT---
let loop (n: Int64) (acc: Int64) : Int64 =
    if n < 1L then acc
    else
        let h = __hash<String> ("hello") in
        loop (n - 1L) (acc + h)
---EXPECTED---
Function loop:
  loop_entry:
    jump loop_body
  loop_body:
    v10011 <- Phi([(v4000, loop_entry), (v10015, loop_ssa_2)]) : TInt64
    v10012 <- Phi([(v4001, loop_entry), (v10016, loop_ssa_2)]) : TInt64
    v10013 <- v10011 < 1 : TInt64
    branch v10013 ? loop_ssa_1 : loop_ssa_2
  loop_ssa_1:
    ret v10012
  loop_ssa_2:
    v10014 <- Call(__hash_str, [str[hello]])
    v10015 <- v10011 - 1 : TInt64
    v10016 <- v10012 + v10014 : TInt64
    jump loop_body

---NAME---
licm_skip_constant_move
---INPUT---
let loop (n: Int64) : Int64 =
    if n < 1L then 0L
    else loop (1L)
---EXPECTED---
Function loop:
  loop_entry:
    jump loop_body
  loop_body:
    v10003 <- Phi([(v4000, loop_entry), (1, loop_ssa_2)]) : TInt64
    v10004 <- v10003 < 1 : TInt64
    branch v10004 ? loop_ssa_1 : loop_ssa_2
  loop_ssa_1:
    ret 0
  loop_ssa_2:
    jump loop_body

---NAME---
const_branch_elimination_bitand
---INPUT---
let pick (n: Int64) : Int64 =
    let masked = Stdlib.Int64.bitwiseAnd n 0L in
    if masked == 0L then 1L else 2L
---EXPECTED---
Function pick:
  pick_entry:
    ret 1

---NAME---
redundant_successor_branch_elimination
---INPUT---
let choose (cond: Bool) : Int64 =
    if cond then (if cond then 1L else 2L) else 3L
---EXPECTED---
Function choose:
  choose_entry:
    branch v0 ? choose_ssa_3 : choose_ssa_2
  choose_ssa_2:
    ret 3
  choose_ssa_3:
    ret 1

---NAME---
sccp_repeated_condition_on_false_edge
---INPUT---
