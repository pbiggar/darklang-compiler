---NAME---
constructor_match_exhaustiveness_has_no_runtime_failure
---INPUT---
type ExhaustiveChoice = First | Second of Int64 | Third

type PartialChoice = FirstPartial | SecondPartial of Int64

let choose(value: ExhaustiveChoice) : Int64 =
    match value with
    | First -> 1L
    | Second(n) -> n
    | Third -> 3L

let choosePartial(value: PartialChoice) : Int64 =
    match value with
    | FirstPartial -> 1L
    | SecondPartial(n) -> n
---EXPECTED---
choose:
  StackSize: 0
  UsedCalleeSaved: []
  Label "choose_L0":
    X0 <- Mov(Imm 1)
    Ret
  Label "choose_L1":
    Cmp(v10009, Imm 1)
    CondBranch(EQ, Label "choose_L3", Label "choose_L4")
  Label "choose_L3":
    v10016 <- HeapLoad(v0, 8)
    X0 <- Mov(Reg v10016)
    Ret
  Label "choose_L4":
    X0 <- Mov(Imm 3)
    Ret
  Label "choose_entry":
    v10009 <- HeapLoad(v0, 0)
    BranchZero(v10009, Label "choose_L0", Label "choose_L1")
choosePartial:
  StackSize: 0
  UsedCalleeSaved: []
  Label "choosePartial_L0":
    X0 <- Mov(Imm 1)
    Ret
  Label "choosePartial_L1":
    v10019 <- HeapLoad(v10, 8)
    X0 <- Mov(Reg v10019)
    Ret
  Label "choosePartial_entry":
    v10016 <- HeapLoad(v10, 0)
    BranchZero(v10016, Label "choosePartial_L0", Label "choosePartial_L1")

---NAME---
closure_devirtualization_capture_free_generated_code
---INPUT---
let applyOnce(value: Int64) : Int64 =
  let increment = fun x -> x + 1L in
  increment(value)
---EXPECTED---
__closure_0:
  StackSize: 0
  UsedCalleeSaved: []
  Label "__closure_0_entry":
    v10002 <- Add(v1, Imm 1)
    X0 <- Mov(Reg v10002)
    Ret

applyOnce:
  StackSize: 0
  UsedCalleeSaved: []
  Label "applyOnce_entry":
    TailArgMoves(X0 <- Imm 0, X1 <- Reg v3)
    TailCall(__closure_0, [Imm 0, Reg v3])
    X0 <- Mov(Reg v6)
    Ret

---NAME---
closure_devirtualization_captured_generated_code
---INPUT---
let addOffset(value: Int64, offset: Int64) : Int64 =
  let add = fun x -> x + offset in
  add(value)
---EXPECTED---
__closure_0:
  StackSize: 0
  UsedCalleeSaved: []
  Label "__closure_0_entry":
    v10004 <- HeapLoad(v0, 8)
    v10005 <- Add(v1, Reg v10004)
    X0 <- Mov(Reg v10005)
    Ret

addOffset:
  StackSize: 0
  UsedCalleeSaved: []
  Label "addOffset_entry":
    v10009 <- HeapAlloc(16)
    HeapStore(v10009, 0, &__closure_0)
    HeapStore(v10009, 8, Reg v6)
    SaveRegs([], [])
    X10 <- Mov(Reg v10009)
    ArgMoves(X0 <- Reg X10, X1 <- Reg v5)
    X9 <- HeapLoad(X0, 0)
    v10010 <- ClosureCall(X9, [Reg v5])
    RestoreRegs([], [])
    v10010 <- Mov(Reg X0)
    RefCountDec(v10009, 0, closure)
    X0 <- Mov(Reg v10010)
    Ret

