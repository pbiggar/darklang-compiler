---NAME---
constructor_match_exhaustiveness_has_no_runtime_failure
---INPUT---
type ExhaustiveChoice = First | Second of Int64 | Third

type PartialChoice = FirstPartial | SecondPartial of Int64

let choose (value: ExhaustiveChoice) : Int64 =
    match value with
    | First -> 1L
    | Second (n) -> n
    | Third -> 3L

let choosePartial (value: PartialChoice) : Int64 =
    match value with
    | FirstPartial -> 1L
    | SecondPartial (n) -> n
---EXPECTED---
choose:
  StackSize: 0
  UsedCalleeSaved: []
  Label "choose_entry":
    v10007 <- HeapLoad(v0, 0)
    BranchZero(v10007, Label "choose_ssa_1", Label "choose_ssa_2")
  Label "choose_ssa_1":
    X0 <- Mov(Imm 1)
    Ret
  Label "choose_ssa_2":
    Cmp(v10007, Imm 1)
    CondBranch(EQ, Label "choose_ssa_3", Label "choose_ssa_4")
  Label "choose_ssa_3":
    v10010 <- HeapLoad(v0, 8)
    X0 <- Mov(Reg v10010)
    Ret
  Label "choose_ssa_4":
    X0 <- Mov(Imm 3)
    Ret
choosePartial:
  StackSize: 0
  UsedCalleeSaved: []
  Label "choosePartial_entry":
    v10015 <- HeapLoad(v10, 0)
    BranchZero(v10015, Label "choosePartial_ssa_1", Label "choosePartial_ssa_2")
  Label "choosePartial_ssa_1":
    X0 <- Mov(Imm 1)
    Ret
  Label "choosePartial_ssa_2":
    v10017 <- HeapLoad(v10, 8)
    X0 <- Mov(Reg v10017)
    Ret

