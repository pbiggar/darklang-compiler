  Label "makeDuplicateTransferChild_entry":
    Jump(Label "makeDuplicateTransferChild_body")
  Label "makeDuplicateTransferChild_ssa_1":
    v10009 <- HeapAlloc(16)
    HeapStore(v10009, 0, Imm 0)
    HeapStore(v10009, 8, Imm 1)
    X0 <- Mov(Reg v10009)
    Ret
  Label "makeDuplicateTransferChild_ssa_2":
    v10008 <- Sub(v10006, Imm 1)
    Jump(Label "makeDuplicateTransferChild_body")
makeDuplicateTransferPair:
  StackSize: 0
  UsedCalleeSaved: []
  Label "makeDuplicateTransferPair_entry":
    SaveRegs([], [])
    ArgMoves(X0 <- Reg v5)
    v10008 <- Call(makeDuplicateTransferChild, [Reg v5])
    RestoreRegs([], [])
    v10008 <- Mov(Reg X0)
    RefCountInc(v10008, 16, generic)
    v10009 <- HeapAlloc(16)
    HeapStore(v10009, 0, Reg v10008)
    HeapStore(v10009, 8, Reg v10008)
    X0 <- Mov(Reg v10009)
    Ret

---NAME---
ownership_transfer_retains_cross_level_reuse
---INPUT---
type ReusedTransferTree = ReusedTransferLeaf of Int64 | ReusedTransferNode of (ReusedTransferTree * ReusedTransferTree)

let makeReusedTransferChild (depth: Int64) : ReusedTransferTree =
    if depth <= 0L then ReusedTransferLeaf (1L)
    else makeReusedTransferChild (depth - 1L)

let makeReusedTransferNested (depth: Int64) : ((ReusedTransferTree * Int64) * ReusedTransferTree) =
    let child = makeReusedTransferChild (depth) in
    let inner = (child, 1L) in
    (inner, child)
---EXPECTED---
makeReusedTransferChild:
  StackSize: 0
  UsedCalleeSaved: []
  Label "makeReusedTransferChild_body":
    v10006 <- Phi([(Reg v4000, makeReusedTransferChild_entry), (Reg v10008, makeReusedTransferChild_ssa_2)])
