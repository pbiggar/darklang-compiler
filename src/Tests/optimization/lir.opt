    CondBranch(LE, Label "makeReusedTransferChild_ssa_1", Label "makeReusedTransferChild_ssa_2")
  Label "makeReusedTransferChild_entry":
    Jump(Label "makeReusedTransferChild_body")
  Label "makeReusedTransferChild_ssa_1":
    v10009 <- HeapAlloc(16)
    HeapStore(v10009, 0, Imm 0)
    HeapStore(v10009, 8, Imm 1)
    X0 <- Mov(Reg v10009)
    Ret
  Label "makeReusedTransferChild_ssa_2":
    v10008 <- Sub(v10006, Imm 1)
    Jump(Label "makeReusedTransferChild_body")
makeReusedTransferNested:
  StackSize: 0
  UsedCalleeSaved: []
  Label "makeReusedTransferNested_entry":
    SaveRegs([], [])
    ArgMoves(X0 <- Reg v5)
    v10010 <- Call(makeReusedTransferChild, [Reg v5])
    RestoreRegs([], [])
    v10010 <- Mov(Reg X0)
    v10011 <- HeapAlloc(16)
    HeapStore(v10011, 0, Reg v10010)
    HeapStore(v10011, 8, Imm 1)
    RefCountInc(v10010, 16, generic)
    v10012 <- HeapAlloc(16)
    HeapStore(v10012, 0, Reg v10011)
    HeapStore(v10012, 8, Reg v10010)
    X0 <- Mov(Reg v10012)
    Ret

---NAME---
counted_loop_unroll_by_two_generated_code
---INPUT---
let loop (i: Int64) (limit: Int64) (sum: Float) (sign: Float) : Float =
    if i >= limit then sum
    else loop (i + 1L) (limit) (sum + sign) (Stdlib.Float.negate (sign))
---EXPECTED---
loop:
  StackSize: 0
  UsedCalleeSaved: []
  Label "loop_body":
    v14017 <- Phi([(Reg v4000, loop_entry), (Reg v14033, loop_ssa_2_unroll_second)])
    v14018 <- Phi([(Reg v4001, loop_entry), (Reg v14034, loop_ssa_2_unroll_second)])
    fv14019 <- FPhi([(fv4002, loop_entry), (fv14035, loop_ssa_2_unroll_second)])
    fv14020 <- FPhi([(fv4003, loop_entry), (fv14036, loop_ssa_2_unroll_second)])
    Cmp(v14017, Reg v14018)
    CondBranch(GE, Label "loop_ssa_1", Label "loop_ssa_2")
  Label "loop_entry":
    Jump(Label "loop_body")
  Label "loop_ssa_1":
    D0 <- FMov(fv14019)
    Ret
  Label "loop_ssa_1_unroll_remainder":
    D0 <- FMov(fv14023)
    Ret
  Label "loop_ssa_2":
    v14022 <- Add(v14017, Imm 1)
    fv14023 <- FAdd(fv14019, fv14020)
    fv14024 <- FNeg(fv14020)
    Cmp(v14022, Reg v14018)
    CondBranch(GE, Label "loop_ssa_1_unroll_remainder", Label "loop_ssa_2_unroll_second")
  Label "loop_ssa_2_unroll_second":
    v14030 <- Add(v14022, Imm 1)
    fv14035 <- FAdd(fv14023, fv14024)
    fv14032 <- FNeg(fv14024)
    v14033 <- Mov(Reg v14030)
    v14034 <- Mov(Reg v14018)
    fv14036 <- FMov(fv14032)
    Jump(Label "loop_body")

