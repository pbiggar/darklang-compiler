---NAME---
licm_hoist_loop_constant
---INPUT---
let collatzSteps(n: Int64, steps: Int64) : Int64 =
    if n == 1L then steps
    else if n % 2L == 0L then collatzSteps(n / 2L, steps + 1L)
    else collatzSteps(3L * n + 1L, steps + 1L)
---EXPECTED---
collatzSteps:
  StackSize: 0
  UsedCalleeSaved: []
  Label "collatzSteps_L0":
    X0 <- Mov(Reg v10020)
    Ret
  Label "collatzSteps_L1":
    BranchBitZero(v10021, #0, Label "collatzSteps_L3", Label "collatzSteps_L4")
  Label "collatzSteps_L3":
    v10030 <- Sdiv(v10021, Reg v10034)
    v10031 <- Add(v10020, Imm 1)
    v10032 <- Mov(Reg v10030)
    v10033 <- Mov(Reg v10031)
    Jump(Label "collatzSteps_body")
  Label "collatzSteps_L4":
    v10035 <- Lsl_imm(v10021, #1)
    v10025 <- Add(v10021, Reg v10035)
    v10026 <- Add(v10025, Imm 1)
    v10027 <- Add(v10020, Imm 1)
    v10028 <- Mov(Reg v10026)
    v10029 <- Mov(Reg v10027)
    Jump(Label "collatzSteps_body")
  Label "collatzSteps_body":
    v10020 <- Phi([(Reg v1, collatzSteps_entry), (Reg v10029, collatzSteps_L4), (Reg v10033, collatzSteps_L3)])
    v10021 <- Phi([(Reg v0, collatzSteps_entry), (Reg v10028, collatzSteps_L4), (Reg v10032, collatzSteps_L3)])
    Cmp(v10021, Imm 1)
    CondBranch(EQ, Label "collatzSteps_L0", Label "collatzSteps_L1")
  Label "collatzSteps_entry":
    v10034 <- Mov(Imm 2)
    Jump(Label "collatzSteps_body")

---NAME---
licm_hoist_loop_float_constant
---INPUT---
let sum(n: Int64, acc: Float) : Float =
    if n == 0L then acc
    else sum(n - 1L, acc + 1.5)
---EXPECTED---
sum:
  StackSize: 0
  UsedCalleeSaved: []
  Label "sum_L1":
    v10012 <- Sub(v10010, Imm 1)
    fv10013 <- FAdd(fv10009, fv10017)
    v10014 <- Mov(Reg v10012)
    fv10015 <- FMov(fv10013)
    Jump(Label "sum_body")
  Label "sum_L2":
    D0 <- FMov(fv10009)
    Ret
  Label "sum_body":
    fv10009 <- FPhi([(fv1, sum_entry), (fv10015, sum_L1)])
    v10010 <- Phi([(Reg v0, sum_entry), (Reg v10014, sum_L1)])
    BranchZero(v10010, Label "sum_L2", Label "sum_L1")
  Label "sum_entry":
    fv10017 <- FLoad(float[1.5])
    Jump(Label "sum_body")

---NAME---
licm_skip_loop_with_call
---INPUT---
let helper(x: Int64) : Int64 =
    let a0 = x + 1L in
    let a1 = a0 + 1L in
    let a2 = a1 + 1L in
    let a3 = a2 + 1L in
    let a4 = a3 + 1L in
    let a5 = a4 + 1L in
    let a6 = a5 + 1L in
    let a7 = a6 + 1L in
    let a8 = a7 + 1L in
    let a9 = a8 + 1L in
    let a10 = a9 + 1L in
    let a11 = a10 + 1L in
    let a12 = a11 + 1L in
    let a13 = a12 + 1L in
    let a14 = a13 + 1L in
    let a15 = a14 + 1L in
    let a16 = a15 + 1L in
    let a17 = a16 + 1L in
    let a18 = a17 + 1L in
    let a19 = a18 + 1L in
    let a20 = a19 + 1L in
    let a21 = a20 + 1L in
    let a22 = a21 + 1L in
    let a23 = a22 + 1L in
    let a24 = a23 + 1L in
    a24

let loop(n: Int64, acc: Int64) : Int64 =
    if n == 0L then acc
    else loop(n - 1L, helper(3L * acc))
---EXPECTED---
helper:
  StackSize: 0
  UsedCalleeSaved: []
  Label "helper_entry":
    v10049 <- Add(v0, Imm 25)
    X0 <- Mov(Reg v10049)
    Ret

loop:
  StackSize: 0
  UsedCalleeSaved: []
  Label "loop_L1":
    v10065 <- Sub(v10063, Imm 1)
    v10070 <- Lsl_imm(v10062, #1)
    v10066 <- Add(v10062, Reg v10070)
    SaveRegs([], [])
    ArgMoves(X0 <- Reg v10066)
    v10067 <- Call(helper, [Reg v10066])
    RestoreRegs([], [])
    v10067 <- Mov(Reg X0)
    v10068 <- Mov(Reg v10065)
    v10069 <- Mov(Reg v10067)
    Jump(Label "loop_body")
  Label "loop_L2":
    X0 <- Mov(Reg v10062)
    Ret
  Label "loop_body":
    v10062 <- Phi([(Reg v52, loop_entry), (Reg v10069, loop_L1)])
    v10063 <- Phi([(Reg v51, loop_entry), (Reg v10068, loop_L1)])
    BranchZero(v10063, Label "loop_L2", Label "loop_L1")
  Label "loop_entry":
    Jump(Label "loop_body")

---NAME---
