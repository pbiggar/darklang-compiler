    Ret
  Label "sum_ssa_2":
    v10011 <- Sub(v10008, Imm 1)
    fv10012 <- FAdd(fv10009, fv10013)
    Jump(Label "sum_body")

---NAME---
licm_hoist_loop_constant
---INPUT---
let collatzSteps (n: Int64) (steps: Int64) : Int64 =
    if n == 1L then steps
    else if n % 2L == 0L then collatzSteps (n / 2L) (steps + 1L)
    else collatzSteps (3L * n + 1L) (steps + 1L)
---EXPECTED---
collatzSteps:
  StackSize: 0
  UsedCalleeSaved: []
  Label "collatzSteps_body":
    v10019 <- Phi([(Reg v4000, collatzSteps_entry), (Reg v10027, collatzSteps_ssa_3), (Reg v10025, collatzSteps_ssa_4)])
    v10020 <- Phi([(Reg v4001, collatzSteps_entry), (Reg v10028, collatzSteps_ssa_3), (Reg v10026, collatzSteps_ssa_4)])
    Cmp(v10019, Imm 1)
    CondBranch(EQ, Label "collatzSteps_ssa_1", Label "collatzSteps_ssa_2")
  Label "collatzSteps_entry":
    v10029 <- Mov(Imm 2)
    Jump(Label "collatzSteps_body")
  Label "collatzSteps_ssa_1":
    X0 <- Mov(Reg v10020)
    Ret
  Label "collatzSteps_ssa_2":
    BranchBitZero(v10019, #0, Label "collatzSteps_ssa_3", Label "collatzSteps_ssa_4")
  Label "collatzSteps_ssa_3":
    v10027 <- Sdiv(v10019, Reg v10029)
    v10028 <- Add(v10020, Imm 1)
    Jump(Label "collatzSteps_body")
  Label "collatzSteps_ssa_4":
    v10030 <- Lsl_imm(v10019, #1)
    v10024 <- Add(v10019, Reg v10030)
    v10025 <- Add(v10024, Imm 1)
    v10026 <- Add(v10020, Imm 1)
    Jump(Label "collatzSteps_body")

