---NAME---
closure_devirtualization_reuses_local_generated_code
---INPUT---
let applyTwice(value: Int64) : Int64 =
  let increment = fun x -> x + 1L in
  let once = increment(value) in
  increment(once)
---EXPECTED---
__closure_0:
  StackSize: 0
  UsedCalleeSaved: []
  Label "__closure_0_entry":
    v10002 <- Add(v1, Imm 1)
    X0 <- Mov(Reg v10002)
    Ret

applyTwice:
  StackSize: 0
  UsedCalleeSaved: []
  Label "applyTwice_entry":
    SaveRegs([], [])
    ArgMoves(X0 <- Imm 0, X1 <- Reg v3)
    v10006 <- Call(__closure_0, [Imm 0, Reg v3])
    RestoreRegs([], [])
    v10006 <- Mov(Reg X0)
    TailArgMoves(X0 <- Imm 0, X1 <- Reg v10006)
    TailCall(__closure_0, [Imm 0, Reg v10006])
    X0 <- Mov(Reg v8)
    Ret
