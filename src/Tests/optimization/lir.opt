// LIR Optimization Tests
// Tests LIR peephole optimizations and loop-invariant code motion.

---NAME---
ownership_transfer_non_recursive_record
---INPUT---
type OwnedInnerRecord = { value: Int64 }
type OwnedOuterRecord = { inner: OwnedInnerRecord }

let makeOwnedInner (value: Int64) : OwnedInnerRecord =
    if value <= 0L then OwnedInnerRecord { value = 0L }
    else makeOwnedInner (value - 1L)

let wrapOwnedInner (value: Int64) : OwnedOuterRecord =
    OwnedOuterRecord { inner = makeOwnedInner (value) }

wrapOwnedInner (1L)
---EXPECTED---
makeOwnedInner:
  StackSize: 0
  UsedCalleeSaved: []
  Label "makeOwnedInner_body":
    v10006 <- Phi([(Reg v4000, makeOwnedInner_entry), (Reg v10008, makeOwnedInner_ssa_2)])
    Cmp(v10006, Imm 0)
    CondBranch(LE, Label "makeOwnedInner_ssa_1", Label "makeOwnedInner_ssa_2")
  Label "makeOwnedInner_entry":
    Jump(Label "makeOwnedInner_body")
  Label "makeOwnedInner_ssa_1":
    v10009 <- HeapAlloc(8)
    HeapStore(v10009, 0, Imm 0)
    X0 <- Mov(Reg v10009)
    Ret
  Label "makeOwnedInner_ssa_2":
    v10008 <- Sub(v10006, Imm 1)
    Jump(Label "makeOwnedInner_body")
wrapOwnedInner:
  StackSize: 0
  UsedCalleeSaved: []
  Label "wrapOwnedInner_entry":
    SaveRegs([], [])
    ArgMoves(X0 <- Reg v5)
    v10007 <- Call(makeOwnedInner, [Reg v5])
    RestoreRegs([], [])
    v10007 <- Mov(Reg X0)
    v10008 <- HeapAlloc(8)
    HeapStore(v10008, 0, Reg v10007)
    X0 <- Mov(Reg v10008)
    Ret
_start:
  StackSize: 0
  UsedCalleeSaved: []
  Label "_start_body":
    SaveRegs([], [])
    ArgMoves(X0 <- Imm 1)
    v10008 <- Call(wrapOwnedInner, [Imm 1])
    RestoreRegs([], [])
    v10008 <- Mov(Reg X0)
    SaveRegs([], [])
    X19 <- Mov(Reg v10008)
    PrintRecord(X19, OwnedOuterRecord, [(inner, TRecord ("OwnedInnerRecord", []))])
    RestoreRegs([], [])
    RefCountDec(X19, 8, generic)
    X0 <- Mov(Reg v10008)
    Ret

---NAME---
ownership_transfer_nested_record_suffix
---INPUT---
type TransferTree = TransferLeaf of Int64 | TransferNode of (TransferTree * TransferTree)
type TransferEnvelope = { pair: (TransferTree * TransferTree) }

let makeTransferChild (depth: Int64) : TransferTree =
    if depth <= 0L then TransferLeaf (1L)
    else makeTransferChild (depth - 1L)

let makeTransferEnvelope (depth: Int64) : TransferEnvelope =
    TransferEnvelope { pair = (makeTransferChild (depth), makeTransferChild (depth + 1L)) }
---EXPECTED---
makeTransferChild:
  StackSize: 0
  UsedCalleeSaved: []
  Label "makeTransferChild_body":
    v10006 <- Phi([(Reg v4000, makeTransferChild_entry), (Reg v10008, makeTransferChild_ssa_2)])
    Cmp(v10006, Imm 0)
    CondBranch(LE, Label "makeTransferChild_ssa_1", Label "makeTransferChild_ssa_2")
  Label "makeTransferChild_entry":
    Jump(Label "makeTransferChild_body")
  Label "makeTransferChild_ssa_1":
    v10009 <- HeapAlloc(16)
    HeapStore(v10009, 0, Imm 0)
    HeapStore(v10009, 8, Imm 1)
    X0 <- Mov(Reg v10009)
    Ret
  Label "makeTransferChild_ssa_2":
    v10008 <- Sub(v10006, Imm 1)
    Jump(Label "makeTransferChild_body")
makeTransferEnvelope:
  StackSize: 0
  UsedCalleeSaved: []
  Label "makeTransferEnvelope_entry":
    SaveRegs([], [])
    ArgMoves(X0 <- Reg v5)
    v10010 <- Call(makeTransferChild, [Reg v5])
    RestoreRegs([], [])
    v10010 <- Mov(Reg X0)
    v10011 <- Add(v5, Imm 1)
    SaveRegs([], [])
    ArgMoves(X0 <- Reg v10011)
    v10012 <- Call(makeTransferChild, [Reg v10011])
    RestoreRegs([], [])
    v10012 <- Mov(Reg X0)
    v10013 <- HeapAlloc(16)
    HeapStore(v10013, 0, Reg v10010)
    HeapStore(v10013, 8, Reg v10012)
    v10014 <- HeapAlloc(8)
    HeapStore(v10014, 0, Reg v10013)
    X0 <- Mov(Reg v10014)
    Ret

---NAME---
ownership_transfer_duplicate_child_reuses_owned_edge
---INPUT---
type DuplicateTransferTree = DuplicateTransferLeaf of Int64 | DuplicateTransferNode of (DuplicateTransferTree * DuplicateTransferTree)

let makeDuplicateTransferChild (depth: Int64) : DuplicateTransferTree =
    if depth <= 0L then DuplicateTransferLeaf (1L)
    else makeDuplicateTransferChild (depth - 1L)

let makeDuplicateTransferPair (depth: Int64) : (DuplicateTransferTree * DuplicateTransferTree) =
    let child = makeDuplicateTransferChild (depth) in
    (child, child)
---EXPECTED---
makeDuplicateTransferChild:
  StackSize: 0
  UsedCalleeSaved: []
