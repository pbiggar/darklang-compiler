def f(x: Float) : (Bool, Bool, Bool, Bool) =
  (x == x, x != x, x <= x, x >= x)
f(0.0)
---EXPECTED---
Function f:
let TempId 1 = t0 == t0
let TempId 3 = !t1
let TempId 4 = t0 <= t0
let TempId 6 = (t1, t3, t4, t4)
return t6

Main:
let TempId 7 = f(0)
return t7

