// CLI/process/host/input parity tests pinned to darklang/dark
// 04fbe9dcc995c6188757d583e273cbd30a3e2d3d. Compiler work began at
// cce6860f02b13d416295ff342341eeeae997f49f.

Stdlib.Cli.Process.shellQuote("it's ready") = "'it'\\''s ready'"

match Stdlib.Cli.OS.getOS() with | Ok(Linux) -> true | Ok(MacOS) -> true | _ -> false = true

Stdlib.Cli.Sys.cpuCount() > 0I = true
Stdlib.Cli.Sys.currentPid() > 0I = true

match Stdlib.Cli.Process.exec("printf", ["%s", "direct execution"]) with | Ok(output) -> output | Error(message) -> message = "direct execution"

match Stdlib.Cli.Process.run("/definitely/missing/cli-parity", []) with | Error(error) -> (error.errno, error.message) | Ok(_) -> (0I, "unexpected") = (2I, "No such file or directory")

let outcome = Stdlib.Cli.execute("printf 'stdout'; printf 'stderr' >&2; exit 7") in (outcome.exitCode, outcome.stdout, outcome.stderr) = (7I, "stdout", "stderr")

let outcome = Stdlib.Cli.execute("printf 'x\\n\\n'") in outcome.stdout = "x\n\n"

let outcome = Stdlib.Cli.execute("head -c 100000 /dev/zero; head -c 100000 /dev/zero >&2") in (Stdlib.String.length(outcome.stdout), Stdlib.String.length(outcome.stderr)) = (100000I, 100000I)

let key = Stdlib.Cli.Stdin.KeyRead.KeyRead { key = Stdlib.Cli.Stdin.Key.Key.A, modifiers = Stdlib.Cli.Stdin.Modifiers.Modifiers { alt = true, ctrl = true, shift = true }, keyChar = "A", repeat = 2I } in Stdlib.Cli.Stdin.KeyRead.toString(key) = stdout="\"ALT+CTRL+SHIFT+A\"\n" stderr=""

let key = Stdlib.Cli.Stdin.readKey() in (Stdlib.Cli.Stdin.Key.toString(key.key), key.keyChar, key.repeat) = ("Escape", "", 1I)

match Stdlib.Cli.Env.get("PATH") with | Some(path) -> Stdlib.String.length(path) > 0I | None -> false = true

// Arguments are positional (excluding the executable name) and parsing errors
// are values, so command-line programs must handle absent or invalid input.
match Stdlib.Cli.Args.int64(999I) with | Error(message) -> Stdlib.String.length(message) > 0I | Ok(_) -> false = true

match Stdlib.Cli.Process.runIn("/", "pwd", []) with | Ok(output) -> Stdlib.String.trimEnd(output.stdout) | Error(error) -> error.message = "/"

match Stdlib.Cli.Process.runWithEnv("/bin/sh", ["-c", "printf %s \"$CLI_PARITY_VALUE\""], [("CLI_PARITY_VALUE", "inherited")]) with | Ok(output) -> output.stdout | Error(error) -> error = "inherited"

match Stdlib.Cli.Process.pipe("printf", ["abc"], "tr", ["a-z", "A-Z"]) with | Ok(output) -> output.stdout | Error(error) -> error.message = "ABC"

match Stdlib.Cli.Process.runWithTimeout(0I, "true", []) with | Error(error) -> error | Ok(_) -> "unexpected" = "timeoutMs must be positive"

match Stdlib.Cli.Process.runWithTimeout(5I, "/bin/sh", ["-c", "sleep 1"]) with | Error(error) -> error | Ok(_) -> "unexpected" = "Process timed out"

let handle = Stdlib.Cli.Process.spawn("") in let result = Stdlib.Cli.Process.communicate(handle, "") in (result.exitCode, result.stderr) = (-1I, "Invalid process handle")

match Stdlib.Cli.Host.getRuntimeHost() with | Ok(_) -> true | Error(_) -> false = true

match (Stdlib.Cli.Sys.hostname(), Stdlib.Cli.Sys.os(), Stdlib.Cli.Sys.arch()) with | (Ok(hostname), Ok(os), Ok(arch)) -> Stdlib.String.length(hostname) > 0I && Stdlib.String.length(os) > 0I && Stdlib.String.length(arch) > 0I | _ -> false = true

match Stdlib.Cli.Sys.currentUser() with | Some(user) -> Stdlib.String.length(user) > 0I | None -> false = true
