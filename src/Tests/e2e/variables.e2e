// Variable Tests - Let bindings and variable references
//
// Tests covering:
// - Basic let bindings
// - Variable references
// - Shadowing
// - Nested let bindings
// - Let bindings in expressions


// ===================================================================
// Basic Let Bindings
// ===================================================================

// Simple let binding

// Let binding with arithmetic
let x = 10L in x + 5L = 15L
let x = 20L in x - 7L = 13L
let x = 6L in x * 3L = 18L
let x = 15L in x / 3L = 5L

// Let binding used multiple times
let x = 4L in x + x = 8L
let x = 3L in x * x = 9L
let x = 10L in x - x = 0L
let x = 5L in x / x = 1L


// ===================================================================
// Multiple Let Bindings
// ===================================================================

// Sequential let bindings
let x = 2L in let y = 3L in x + y = 5L
let x = 10L in let y = 4L in x - y = 6L
let x = 5L in let y = 7L in x * y = 35L
let x = 20L in let y = 4L in x / y = 5L

// Multiple variables in expressions
let x = 1L in let y = 2L in let z = 3L in x + y + z = 6L
let a = 10L in let b = 5L in let c = 2L in a - b - c = 3L
let x = 2L in let y = 3L in let z = 4L in x * y * z = 24L


// ===================================================================
// Shadowing
// ===================================================================

// Simple shadowing
let x = 5L in let x = 10L in x = 10L
let x = 1L in let x = 2L in let x = 3L in x = 3L

// Shadowing with arithmetic
let x = 5L in let x = x + 1L in x = 6L
let x = 10L in let x = x * 2L in x = 20L
let x = 8L in let x = x - 3L in x = 5L
let x = 12L in let x = x / 2L in x = 6L

// Multiple shadowing
let x = 1L in let x = x + 1L in let x = x + 1L in x = 3L
let x = 2L in let x = x * 2L in let x = x * 2L in x = 8L


// ===================================================================
// Nested Let Bindings in Expressions
// ===================================================================

// Let binding in left operand
(let x = 5L in x) + 3L = 8L
(let x = 10L in x) - 4L = 6L
(let x = 6L in x) * 2L = 12L
(let x = 20L in x) / 4L = 5L

// Let binding in right operand
3L + (let x = 5L in x) = 8L
10L - (let x = 4L in x) = 6L
2L * (let x = 6L in x) = 12L
20L / (let x = 4L in x) = 5L

// Let bindings in both operands
(let x = 3L in x) + (let y = 4L in y) = 7L
(let x = 10L in x) - (let y = 3L in y) = 7L
(let x = 5L in x) * (let y = 4L in y) = 20L
(let x = 24L in x) / (let y = 6L in y) = 4L

// Nested let bindings with multiple variables
(let x = 2L in let y = 3L in x + y) + 1L = 6L
(let x = 10L in let y = 5L in x - y) * 2L = 10L


// ===================================================================
// Complex Expressions
// ===================================================================

// Let binding with complex value expression
let x = 2L + 3L in x = 5L
let x = 10L - 4L in x = 6L
let x = 3L * 4L in x = 12L
let x = 20L / 5L in x = 4L
let x = 2L + (3L * 4L) in x = 14L
let x = (2L + 3L) * 4L in x = 20L

// Let binding with complex body expression
let x = 5L in x + (2L * 3L) = 11L
let x = 10L in (x + 2L) * 3L = 36L
let x = 4L in (x * x) + x = 20L

// Multiple variables with complex expressions
let x = 2L + 3L in let y = 4L * 5L in x + y = 25L
let x = 10L - 2L in let y = 3L + 1L in x * y = 32L
let x = (2L + 3L) * 2L in let y = 20L / 4L in x + y = 15L


// ===================================================================
// Edge Cases
// ===================================================================

// Zero values
let x = 0L in x = 0L
let x = 0L in x + 5L = 5L
let x = 0L in 5L + x = 5L
let x = 5L in let y = 0L in x + y = 5L

// Negative values
let x = -5L in x = -5L
let x = -10L in x + 15L = 5L
let x = 10L in x + -5L = 5L
let x = -3L in let y = -4L in x + y = -7L

// Large values
let x = 1000000L in x = 1000000L
let x = 9223372036854775807L in x = 9223372036854775807L
let x = -9223372036854775808L in x = -9223372036854775808L

// Long variable names
let variable_name_with_underscores = 42L in variable_name_with_underscores = 42L
let x123 = 456L in x123 = 456L
