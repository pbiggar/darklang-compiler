// Verifies that interpreter-style top-level values initialize once and are available to expressions.

val parityAnswer = 41L
val parityWords = ["compiler"; "interpreter"]
val parityWordCount = Stdlib.List.length parityWords
val initializedOnce = Stdlib.Int64.random (-9223372036854775808L) 9223372036854775807L
val parityOffset = 40L
val scopedRandom = Stdlib.Int64.random (-9223372036854775808L) 9223372036854775807L
let addParityOffset (value: Int64): Int64 = parityOffset + value
let parityIdentity<'a> (value: a): a = value
let observesOneScopedValue (ignored: Unit): Bool = scopedRandom == scopedRandom

parityAnswer + 1L = 42L
parityWordCount = 2
initializedOnce == initializedOnce = true
addParityOffset 2L = 42L
parityIdentity<Int64> parityAnswer = 41L
observesOneScopedValue () = true
