// E2E tests for recursive functions with tuple parameters
// Regression tests for stack space issues with tuple recursion
// The compiler should handle tuple recursion without excessive stack usage

// =====================================================
// Basic tuple recursion
// =====================================================

// Simple tuple recursion with let binding
let tupleRecurseLet(t: (Int64, Int64), n: Int64) : Int64 =
    if n <= 0L then t.0 + t.1
    else
        let next = (t.0 + 1L, t.1 + 1L) in
        tupleRecurseLet(next, n - 1L)

tupleRecurseLet((0L, 0L), 10L) = 20L

// Tuple recursion with inline construction
let tupleRecurseInline(t: (Int64, Int64), n: Int64) : Int64 =
    if n <= 0L then t.0 + t.1
    else tupleRecurseInline((t.0 + 1L, t.1 + 1L), n - 1L)

tupleRecurseInline((0L, 0L), 10L) = 20L

// =====================================================
// Tuple recursion with helper function
// =====================================================

let stepPairHelper(x: Int64, y: Int64) : (Int64, Int64) = (x + 1L, y + 2L)

let recurseWithHelper(t: (Int64, Int64), n: Int64) : Int64 =
    if n <= 0L then t.0 + t.1
    else
        let next = stepPairHelper(t.0, t.1) in
        recurseWithHelper(next, n - 1L)

recurseWithHelper((0L, 0L), 10L) = 30L

// =====================================================
// 3-tuple recursion
// =====================================================

let tuple3Recurse(t: (Int64, Int64, Int64), n: Int64) : Int64 =
    if n <= 0L then t.0 + t.1 + t.2
    else
        let next = (t.0 + 1L, t.1 + 1L, t.2 + 1L) in
        tuple3Recurse(next, n - 1L)

tuple3Recurse((0L, 0L, 0L), 10L) = 30L

// =====================================================
// Tuple recursion returning tuple
// =====================================================

// Note: Tests for tuple-returning recursive functions are in a separate file
// as they involve a different bug with tuple element propagation through recursion

// Non-recursive tuple return works correctly
let makeTupleFromTuple(t: (Int64, Int64)) : (Int64, Int64) = (t.0 + 1L, t.1 + 2L)

let orig = (5L, 10L) in let result = makeTupleFromTuple(orig) in result.0 + result.1 = 18L

// =====================================================
// Moderate depth recursion (should not stack overflow)
// These tests verify the compiler doesn't use excessive stack space
// =====================================================

// 100 iterations should work without stack overflow
tupleRecurseLet((0L, 0L), 100L) = 200L

tupleRecurseInline((0L, 0L), 100L) = 200L

recurseWithHelper((0L, 0L), 100L) = 300L
