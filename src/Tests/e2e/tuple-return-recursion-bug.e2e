// E2E tests for tuple-returning functions
// BUG FIXED: "let t = (tuple) in t" pattern now works correctly
// Root cause: ANF optimization (beta reduction) was missing in the stdlib prebuilt test pipeline

// =====================================================
// FIXED: "let t = (a, b) in t" pattern now works
// =====================================================

let test(a: Int64) : (Int64, Int64) = let t = (a, a * 2) in t
let r = test(5) in let (first, _) = r in first = 5

let makeNext(t: (Int64, Int64)) : (Int64, Int64) = let (first, second) = t in let next = (first + 1, second + 2) in next
let r2 = makeNext((0, 0)) in let (first, _) = r2 in first = 1

// =====================================================
// Direct tuple return without let binding
// =====================================================
let addToTupleDirect(t: (Int64, Int64)) : (Int64, Int64) = let (first, second) = t in (first + 1, second + 2)

let r3 = addToTupleDirect((5, 10)) in let (first, second) = r3 in first + second = 18

let r4 = addToTupleDirect((0, 0)) in let (first, _) = r4 in first = 1

let r5 = addToTupleDirect((0, 0)) in let (_, second) = r5 in second = 2

// =====================================================
// Accessing tuple elements inside the function
// =====================================================
let getFirst(a: Int64) : Int64 = let t = (a, a * 2) in let (first, _) = t in first
getFirst(5) = 5

let getSecond(a: Int64) : Int64 = let t = (a, a * 2) in let (_, second) = t in second
getSecond(5) = 10
