// Boolean Tests - Boolean literals, comparisons, and logical operations
//
// Tests covering:
// - Boolean literals
// - Integer comparisons
// - Boolean operations (&&, ||, !)
// - Let bindings with booleans


// ===================================================================
// Boolean Literals
// ===================================================================
// Boolean literals print as "true" and "false"
true = true
false = false


// ===================================================================
// Integer Comparisons
// ===================================================================

// Equality
1L == 1L = true
1L == 2L = false
5L == 5L = true
0L == 0L = true
42L == 42L = true

// Inequality
1L != 2L = true
5L != 5L = false
0L != 1L = true
42L != 0L = true

// Less than
1L < 2L = true
2L < 1L = false
5L < 5L = false
0L < 1L = true
10L < 20L = true

// Greater than
2L > 1L = true
1L > 2L = false
5L > 5L = false
20L > 10L = true

// Less than or equal
1L <= 2L = true
2L <= 2L = true
3L <= 2L = false
5L <= 10L = true

// Greater than or equal
2L >= 1L = true
2L >= 2L = true
1L >= 2L = false
10L >= 5L = true


// ===================================================================
// Boolean Operations
// ===================================================================

// AND (&&)

// OR (||)

// NOT (!)
!true = false
!false = true
!!true = true
!!false = false


// ===================================================================
// Combined Comparisons and Boolean Operations
// ===================================================================

// Comparisons with boolean operators
1L == 1L && 2L == 2L = true
1L == 1L && 1L == 2L = false
1L == 2L || 2L == 2L = true
1L == 2L || 3L == 4L = false

// Negated comparisons
!(1L == 1L) = false
!(1L == 2L) = true
!(5L < 3L) = true
!(5L > 3L) = false


// ===================================================================
// Let Bindings with Booleans
// ===================================================================

let x = true in x = true
let x = false in x = false
let x = 1L == 1L in x = true
let x = 1L == 2L in x = false
let x = 5L < 10L in x = true

// Multiple let bindings
let x = true in let y = false in x && y = false
let x = true in let y = false in x || y = true
let x = 1L < 2L in let y = 3L > 2L in x && y = true

// Boolean operations in let values
let x = true && false in x = false
let x = true || false in x = true
let x = !true in x = false
let x = !(1L == 2L) in x = true


// ===================================================================
// Complex Expressions
// ===================================================================

// Nested boolean operations
(true || false) && true = true
true && (false || true) = true
(true && false) || (true && true) = true

// Comparisons with arithmetic
1L + 1L == 2L = true
3L * 4L == 12L = true
10L - 5L == 5L = true
8L / 2L == 4L = true

// More complex
(1L + 2L) < (4L + 5L) = true
(10L - 3L) > (2L * 2L) = true
(6L / 2L) == 3L = true

// Negation with arithmetic
!(5L + 5L == 11L) = true
!(3L * 3L == 9L) = false
