// Conditional and sequential evaluation parity

let paritySequenceHead(): Unit = ()
let paritySequenceTail(): Int64 = 43L

// Canonical conditional syntax, nesting, and branch selection
if false then 1L elif true then 2L else 3L = 2L
if true then (if false then 1L else 2L) else 3L = 2L

// Conditions are Boolean and the compiler statically unifies branch types
if 5L then "yes" else "no" = error="Encountered a condition that must be a Bool, but got an Int64 (5)"
if true then "yes" else 0L = error="Type mismatch: if branches must have same type: expected String, got Int64"
if false then [] else [1L] = [1L]
if true then (if false then [] else [1L]) else [2L] = [1L]
if false then () = ()

// Untaken branches remain lazy, including primitive work in atom position
(if true then 5L else 1L / 0L) + 1L = 6L
if false then Builtin.testRuntimeError("skipped") else 7L = 7L
if true then Builtin.testRuntimeError("selected") else 7L = exit=1 stderr="Uncaught exception: selected"

// A parenthesized statement sequence evaluates strictly to its final expression
(() ; 42L) = 42L
(paritySequenceHead(); paritySequenceTail()) = 43L
(() ; (() ; "done")) = "done"
if true then (() ; 7L) else (() ; 9L) = 7L
(1L ; "done") = error="Type mismatch in integer literal: expected Unit, got Int64"
(Builtin.testRuntimeError("first"); Builtin.testRuntimeError("second")) = exit=1 stderr="Uncaught exception: first"
