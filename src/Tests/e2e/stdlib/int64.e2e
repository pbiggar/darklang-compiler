// Stdlib.Int64 Tests
// Ported from https://github.com/darklang/dark/tree/main/backend/testfiles/execution/stdlib
//
// Tests for Int64 module functions

// ===================================================================
// Stdlib.Int64.add - Add two integers
// ===================================================================

Stdlib.Int64.add(10L, 9L) = 19L
Stdlib.Int64.add(0L, 0L) = 0L
Stdlib.Int64.add(-5L, 5L) = 0L
Stdlib.Int64.add(100L, 200L) = 300L

// ===================================================================
// Stdlib.Int64.subtract - Subtract two integers
// ===================================================================

Stdlib.Int64.subtract(10L, 9L) = 1L
Stdlib.Int64.subtract(0L, 0L) = 0L
Stdlib.Int64.subtract(100L, 50L) = 50L
Stdlib.Int64.subtract(5L, 10L) = -5L

// ===================================================================
// Stdlib.Int64.multiply - Multiply two integers
// ===================================================================

Stdlib.Int64.multiply(8L, 8L) = 64L
Stdlib.Int64.multiply(0L, 100L) = 0L
Stdlib.Int64.multiply(-5L, 5L) = -25L
Stdlib.Int64.multiply(100L, 100L) = 10000L

// ===================================================================
// Stdlib.Int64.divide - Divide two integers
// ===================================================================

Stdlib.Int64.divide(10L, 5L) = 2L
Stdlib.Int64.divide(10L, 3L) = 3L
Stdlib.Int64.divide(100L, 10L) = 10L
Stdlib.Int64.divide(-10L, 2L) = -5L

// ===================================================================
// Stdlib.Int64.mod - Modulo operation
// ===================================================================

Stdlib.Int64.mod(15L, 6L) = 3L
Stdlib.Int64.mod(10L, 3L) = 1L
Stdlib.Int64.mod(100L, 7L) = 2L
Stdlib.Int64.mod(-10L, 3L) = 2L

// ===================================================================
// Stdlib.Int64.max - Maximum of two integers
// ===================================================================

Stdlib.Int64.max(5L, 6L) = 6L
Stdlib.Int64.max(6L, 5L) = 6L
Stdlib.Int64.max(-5L, -10L) = -5L
Stdlib.Int64.max(0L, 0L) = 0L

// ===================================================================
// Stdlib.Int64.min - Minimum of two integers
// ===================================================================

Stdlib.Int64.min(5L, 6L) = 5L
Stdlib.Int64.min(6L, 5L) = 5L
Stdlib.Int64.min(-5L, -10L) = -10L
Stdlib.Int64.min(0L, 0L) = 0L

// ===================================================================
// Stdlib.Int64.absoluteValue - Absolute value
// ===================================================================

Stdlib.Int64.absoluteValue(-5L) = 5L
Stdlib.Int64.absoluteValue(5L) = 5L
Stdlib.Int64.absoluteValue(0L) = 0L
Stdlib.Int64.absoluteValue(-100L) = 100L

// ===================================================================
// Stdlib.Int64.negate - Negate an integer
// ===================================================================

Stdlib.Int64.negate(-5L) = 5L
Stdlib.Int64.negate(5L) = -5L
Stdlib.Int64.negate(0L) = 0L
Stdlib.Int64.negate(100L) = -100L

// ===================================================================
// Stdlib.Int64.power - Raise to a power
// ===================================================================

Stdlib.Int64.power(8L, 5L) = 32768L
Stdlib.Int64.power(2L, 10L) = 1024L
Stdlib.Int64.power(0L, 0L) = 1L
Stdlib.Int64.power(5L, 0L) = 1L
Stdlib.Int64.power(5L, 1L) = 5L
Stdlib.Int64.power(2L, 8L) = 256L
Stdlib.Int64.power(2L, -3L) = error="Cannot raise integer to a negative exponent"

// ===================================================================
// Stdlib.Int64.clamp - Clamp value between limits
// ===================================================================

Stdlib.Int64.clamp(-5L, -2L, 5L) = -2L
Stdlib.Int64.clamp(3L, 0L, 2L) = 2L
Stdlib.Int64.clamp(1L, 0L, 5L) = 1L
Stdlib.Int64.clamp(10L, 5L, 15L) = 10L
Stdlib.Int64.clamp(0L, 5L, 10L) = 5L

// ===================================================================
// Stdlib.Int64.greaterThan - Greater than comparison
// ===================================================================

Stdlib.Int64.greaterThan(20L, 1L) = true
Stdlib.Int64.greaterThan(1L, 20L) = false
Stdlib.Int64.greaterThan(5L, 5L) = false

// ===================================================================
// Stdlib.Int64.greaterThanOrEqualTo - Greater than or equal comparison
// ===================================================================

Stdlib.Int64.greaterThanOrEqualTo(6L, 1L) = true
Stdlib.Int64.greaterThanOrEqualTo(1L, 6L) = false
Stdlib.Int64.greaterThanOrEqualTo(5L, 5L) = true

// ===================================================================
// Stdlib.Int64.lessThan - Less than comparison
// ===================================================================

Stdlib.Int64.lessThan(6L, 8L) = true
Stdlib.Int64.lessThan(8L, 6L) = false
Stdlib.Int64.lessThan(5L, 5L) = false

// ===================================================================
// Stdlib.Int64.lessThanOrEqualTo - Less than or equal comparison
// ===================================================================

Stdlib.Int64.lessThanOrEqualTo(6L, 8L) = true
Stdlib.Int64.lessThanOrEqualTo(8L, 6L) = false
Stdlib.Int64.lessThanOrEqualTo(5L, 5L) = true

// ===================================================================
// Stdlib.Int64.toString - Convert integer to string
// ===================================================================

Stdlib.Int64.toString(0L) = "0"
Stdlib.Int64.toString(42L) = "42"
Stdlib.Int64.toString(-5L) = "-5"
Stdlib.Int64.toString(-9223372036854775808L) = "-9223372036854775808"
Stdlib.Int64.toString(1234567890L) = "1234567890"

// ===================================================================
// Stdlib.Int64.isEven - Check if integer is even
// ===================================================================


// ===================================================================
// Stdlib.Int64.isOdd - Check if integer is odd
// ===================================================================


// ===================================================================
// Stdlib.Int64.sum - Sum all integers in a list
// ===================================================================

Stdlib.Int64.sum([1L, 2L, 3L, 4L, 5L]) = 15L
Stdlib.Int64.sum([]) = 0L
Stdlib.Int64.sum([100L]) = 100L
Stdlib.Int64.sum([1L, -1L, 2L, -2L]) = 0L
Stdlib.Int64.sum([10L, 20L, 30L]) = 60L

