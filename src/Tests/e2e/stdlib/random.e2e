// Stdlib.Random Tests
//
// Tests for Random module functions

// ===================================================================
// Stdlib.Random.int64 - Get 8 random bytes as Int64
// ===================================================================

// Stdlib.Random.int64 returns an Int64 (type check via addition succeeds if it's an Int64)
(let x = Stdlib.Random.int64() in Stdlib.Int64.add(x, 0L) == x) = true

// Multiple calls both return Int64 values without relying on probabilistic uniqueness
(let x = Stdlib.Random.int64() in let y = Stdlib.Random.int64() in Stdlib.Int64.add(x, 0L) == x && Stdlib.Int64.add(y, 0L) == y) = true
