// Stdlib.Option Tests
// Ported from https://github.com/darklang/dark/tree/main/backend/testfiles/execution/stdlib
//
// Tests for Option module functions

// ===================================================================
// Stdlib.Option.isSome - Returns true if the option is Some
// ===================================================================

Stdlib.Option.isSome (Some 5L) = true
// Unresolved type variable is preserved during monomorphization
Stdlib.Option.isSome None = false

// ===================================================================
// Stdlib.Option.isNone - Returns true if the option is None
// ===================================================================

Stdlib.Option.isNone (Some 5L) = false
// Unresolved type variable is preserved during monomorphization
Stdlib.Option.isNone None = true

// ===================================================================
// Stdlib.Option.withDefault - Returns the value or a default
// ===================================================================

Stdlib.Option.withDefault (Some 5L) 0L = 5L
Stdlib.Option.withDefault None 42L = 42L

// ===================================================================
// Stdlib.Option.map - Apply a function to the value if Some
// ===================================================================

Stdlib.Option.withDefault (Stdlib.Option.map (Some 5L) (fun x -> x + 1L)) 0L = 6L
Stdlib.Option.isNone (Stdlib.Option.map None (fun x -> x + 1L)) = true

// ===================================================================
// Stdlib.Option.andThen - Chain Option computations
// ===================================================================

Stdlib.Option.withDefault (Stdlib.Option.andThen (Some 5L) (fun x -> Some (x * 2L))) 0L = 10L
Stdlib.Option.isNone (Stdlib.Option.andThen None (fun x -> Some (x * 2L))) = true
// NOTE: Needs type params because the lambda returns None which doesn't constrain the output type
Stdlib.Option.isNone (Stdlib.Option.andThen (Some 5L) (fun x -> None)) = true

// ===================================================================
// Stdlib.Option.or - Return the first Some, or fall back to the second option
// ===================================================================

Stdlib.Option.or (Some 6L) (Some 5L) = Some 6L
Stdlib.Option.or (Some 6L) None = Some 6L
Stdlib.Option.or None (Some 5L) = Some 5L
Stdlib.Option.or None None = None

// ===================================================================
// Stdlib.Option.toList - Convert to a list
// ===================================================================

Stdlib.List.length (Stdlib.Option.toList (Some 42L)) = 1
Stdlib.List.isEmpty (Stdlib.Option.toList None) = true

// ===================================================================
// Pipe operator with Option functions
// ===================================================================

Some 42L |> Stdlib.Option.isSome () = true
Some 10L |> Stdlib.Option.map (fun x -> x * 2L) |> Stdlib.Option.withDefault 0L = 20L

// ===================================================================
// Unresolved type variable resolved later by context
// Tests that type variables unify correctly with all types
// ===================================================================

// Int64
let x = None in Stdlib.Option.withDefault x 42L = 42L

// String
let x = None in Stdlib.Option.withDefault x "hello" = "hello"

// Bool
let x = None in Stdlib.Option.withDefault x true = true

// Float64
let x = None in Stdlib.Option.withDefault x 3.14 = 3.14

// Char
let x = None in Stdlib.Option.withDefault x 'a' = 'a'

// Unit
let x = None in Stdlib.Option.withDefault (x) () = ()

// Int8
let x = None in Stdlib.Option.withDefault x 42y = 42y

// Int16
let x = None in Stdlib.Option.withDefault x 42s = 42s

// Int32
let x = None in Stdlib.Option.withDefault x 42l = 42l

// UInt8
let x = None in Stdlib.Option.withDefault x 42uy = 42uy

// UInt16
let x = None in Stdlib.Option.withDefault x 42us = 42us

// UInt32
let x = None in Stdlib.Option.withDefault x 42ul = 42ul

// UInt64
let x = None in Stdlib.Option.withDefault x 42UL = 42UL

// Tuple
let x = None in Stdlib.Option.withDefault x ((1L, 2L)) = (1L, 2L)

// Tuple3
let x = None in Stdlib.Option.withDefault x ((1L, 2L, 3L)) = (1L, 2L, 3L)

// List
let x = None in Stdlib.List.length (Stdlib.Option.withDefault x ([1L, 2L, 3L])) = 3

// Nested Option (Option<Option<Int64>>)
let x = None in Stdlib.Option.isSome (Stdlib.Option.withDefault x (Some 42L)) = true

// Result
let x = None in Stdlib.Result.isOk (Stdlib.Option.withDefault x (Ok 42L)) = true

// Large combines follow the interpreter's stack-safe fold implementation.
let options = Stdlib.List.repeatUnsafe 100000 (Some 1L) in match Stdlib.Option.combine options with | Some values -> Stdlib.List.length values | None -> 0 = 100000 isolated=true

// Large value extraction follows the interpreter's filterMap implementation.
let options = Stdlib.List.repeatUnsafe 100000 (Some 1L) in Stdlib.List.length (Stdlib.Option.values options) = 100000 isolated=true
