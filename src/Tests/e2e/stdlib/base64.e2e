// Stdlib.Base64 Tests
// Tests for Base64 encoding and decoding

// ===================================================================
// Stdlib.Base64.encode - Encode bytes to base64 string
// ===================================================================

// Empty bytes
Stdlib.Base64.encode(Stdlib.Bytes.create(0L)) = ""

// Single byte
Stdlib.Base64.encode(Stdlib.Bytes.fromList([0L])) = "AA=="
Stdlib.Base64.encode(Stdlib.Bytes.fromList([255L])) = "/w=="

// Two bytes
Stdlib.Base64.encode(Stdlib.Bytes.fromList([0L, 0L])) = "AAA="

// Three bytes (no padding needed)
Stdlib.Base64.encode(Stdlib.Bytes.fromList([0L, 0L, 0L])) = "AAAA"

// "Hello" = [72, 101, 108, 108, 111]
Stdlib.Base64.encode(Stdlib.Bytes.fromList([72L, 101L, 108L, 108L, 111L])) = "SGVsbG8="

// "Hi" = [72, 105]
Stdlib.Base64.encode(Stdlib.Bytes.fromList([72L, 105L])) = "SGk="

// "ABC" = [65, 66, 67]
Stdlib.Base64.encode(Stdlib.Bytes.fromList([65L, 66L, 67L])) = "QUJD"

// ===================================================================
// Stdlib.Base64.urlEncode - URL-safe encoding
// ===================================================================

// Test that + and / are replaced with - and _
// Blob that would produce + in standard encoding
Stdlib.Base64.urlEncode(Stdlib.Bytes.fromList([251L])) = "-w=="

// ===================================================================
// Stdlib.Base64.decode - Decode base64 to bytes
// ===================================================================

// Empty string
Stdlib.Result.isOk<Blob, String>(Stdlib.Base64.decode("")) = true

// Single padded value
match Stdlib.Base64.decode("AA==") with | Ok(b) -> Stdlib.Bytes.length(b) | Error(_) -> -1L = 1L
match Stdlib.Base64.decode("AA==") with | Ok(b) -> Stdlib.Bytes.get(b, 0L) | Error(_) -> -1L = 0L

// Two bytes
match Stdlib.Base64.decode("AAA=") with | Ok(b) -> Stdlib.Bytes.length(b) | Error(_) -> -1L = 2L

// Three bytes
match Stdlib.Base64.decode("AAAA") with | Ok(b) -> Stdlib.Bytes.length(b) | Error(_) -> -1L = 3L

// "SGVsbG8=" -> "Hello"
match Stdlib.Base64.decode("SGVsbG8=") with | Ok(b) -> Stdlib.Bytes.length(b) | Error(_) -> -1L = 5L
match Stdlib.Base64.decode("SGVsbG8=") with | Ok(b) -> Stdlib.Bytes.get(b, 0L) | Error(_) -> -1L = 72L
match Stdlib.Base64.decode("SGVsbG8=") with | Ok(b) -> Stdlib.Bytes.get(b, 4L) | Error(_) -> -1L = 111L

// Unpadded final groups
match Stdlib.Base64.decode("Kw") with | Ok(b) -> Stdlib.Bytes.get(b, 0L) | Error(_) -> -1L = 43L
match Stdlib.Base64.decode("ABC") with | Ok(b) -> (Stdlib.Bytes.get(b, 0L), Stdlib.Bytes.get(b, 1L)) | Error(_) -> (-1L, -1L) = (0L, 16L)

// Invalid base64 - a single character cannot encode a byte
Stdlib.Result.isError<Blob, String>(Stdlib.Base64.decode("x")) = true

// Invalid base64 - padding is only valid in the final two positions
Stdlib.Result.isError<Blob, String>(Stdlib.Base64.decode("=AAA")) = true

// ===================================================================
// Roundtrip tests
// ===================================================================

// Encode then decode should give back original bytes
match Stdlib.Base64.decode(Stdlib.Base64.encode(Stdlib.Bytes.fromList([1L, 2L, 3L]))) with | Ok(b) -> Stdlib.Bytes.get(b, 0L) | Error(_) -> -1L = 1L
match Stdlib.Base64.decode(Stdlib.Base64.encode(Stdlib.Bytes.fromList([1L, 2L, 3L]))) with | Ok(b) -> Stdlib.Bytes.get(b, 2L) | Error(_) -> -1L = 3L
