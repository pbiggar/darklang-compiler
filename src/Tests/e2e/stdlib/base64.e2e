// Stdlib.Base64 Tests
// Tests for Base64 encoding and decoding

// ===================================================================
// Stdlib.Base64.encode - Encode bytes to base64 string
// ===================================================================

// Empty bytes
Stdlib.Base64.encode(Stdlib.Bytes.create(0)) = ""

// Single byte
Stdlib.Base64.encode(Stdlib.Bytes.fromList([0])) = "AA=="
Stdlib.Base64.encode(Stdlib.Bytes.fromList([255])) = "/w=="

// Two bytes
Stdlib.Base64.encode(Stdlib.Bytes.fromList([0, 0])) = "AAA="

// Three bytes (no padding needed)
Stdlib.Base64.encode(Stdlib.Bytes.fromList([0, 0, 0])) = "AAAA"

// "Hello" = [72, 101, 108, 108, 111]
Stdlib.Base64.encode(Stdlib.Bytes.fromList([72, 101, 108, 108, 111])) = "SGVsbG8="

// "Hi" = [72, 105]
Stdlib.Base64.encode(Stdlib.Bytes.fromList([72, 105])) = "SGk="

// "ABC" = [65, 66, 67]
Stdlib.Base64.encode(Stdlib.Bytes.fromList([65, 66, 67])) = "QUJD"

// ===================================================================
// Stdlib.Base64.urlEncode - URL-safe encoding
// ===================================================================

// Test that + and / are replaced with - and _
// Bytes that would produce + in standard encoding
Stdlib.Base64.urlEncode(Stdlib.Bytes.fromList([251])) = "-w=="

// ===================================================================
// Stdlib.Base64.decode - Decode base64 to bytes
// ===================================================================

// Empty string
Stdlib.Result.isOk<Bytes, String>(Stdlib.Base64.decode("")) = true

// Single padded value
match Stdlib.Base64.decode("AA==") with | Ok(b) -> Stdlib.Bytes.length(b) | Error(_) -> -1 = 1
match Stdlib.Base64.decode("AA==") with | Ok(b) -> Stdlib.Bytes.get(b, 0) | Error(_) -> -1 = 0

// Two bytes
match Stdlib.Base64.decode("AAA=") with | Ok(b) -> Stdlib.Bytes.length(b) | Error(_) -> -1 = 2

// Three bytes
match Stdlib.Base64.decode("AAAA") with | Ok(b) -> Stdlib.Bytes.length(b) | Error(_) -> -1 = 3

// "SGVsbG8=" -> "Hello"
match Stdlib.Base64.decode("SGVsbG8=") with | Ok(b) -> Stdlib.Bytes.length(b) | Error(_) -> -1 = 5
match Stdlib.Base64.decode("SGVsbG8=") with | Ok(b) -> Stdlib.Bytes.get(b, 0) | Error(_) -> -1 = 72
match Stdlib.Base64.decode("SGVsbG8=") with | Ok(b) -> Stdlib.Bytes.get(b, 4) | Error(_) -> -1 = 111

// Unpadded final groups
match Stdlib.Base64.decode("Kw") with | Ok(b) -> Stdlib.Bytes.get(b, 0) | Error(_) -> -1 = 43
match Stdlib.Base64.decode("ABC") with | Ok(b) -> (Stdlib.Bytes.get(b, 0), Stdlib.Bytes.get(b, 1)) | Error(_) -> (-1, -1) = (0, 16)

// Invalid base64 - a single character cannot encode a byte
Stdlib.Result.isError<Bytes, String>(Stdlib.Base64.decode("x")) = true

// Invalid base64 - padding is only valid in the final two positions
Stdlib.Result.isError<Bytes, String>(Stdlib.Base64.decode("=AAA")) = true

// ===================================================================
// Roundtrip tests
// ===================================================================

// Encode then decode should give back original bytes
match Stdlib.Base64.decode(Stdlib.Base64.encode(Stdlib.Bytes.fromList([1, 2, 3]))) with | Ok(b) -> Stdlib.Bytes.get(b, 0) | Error(_) -> -1 = 1
match Stdlib.Base64.decode(Stdlib.Base64.encode(Stdlib.Bytes.fromList([1, 2, 3]))) with | Ok(b) -> Stdlib.Bytes.get(b, 2) | Error(_) -> -1 = 3
