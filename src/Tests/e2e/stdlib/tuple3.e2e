// Stdlib.Tuple3 Tests
// Ported from https://github.com/darklang/dark/tree/main/backend/testfiles/execution/stdlib
//
// Tests for Tuple3 module functions

// ===================================================================
// Stdlib.Tuple3.create - Constructs a triple from three values
// ===================================================================

Stdlib.Tuple3.first(Stdlib.Tuple3.create(1, 2, 3)) = 1
Stdlib.Tuple3.second(Stdlib.Tuple3.create(1, 2, 3)) = 2
Stdlib.Tuple3.third(Stdlib.Tuple3.create(1, 2, 3)) = 3
Stdlib.Tuple3.create("one", 2, "pi") = ("one", 2, "pi")

// ===================================================================
// Stdlib.Tuple3.first - Returns the first value of a triple
// ===================================================================

Stdlib.Tuple3.first((1, 2, 3)) = 1
Stdlib.Tuple3.first((42, 0, 99)) = 42
Stdlib.Tuple3.first((true, false, true)) = true
Stdlib.Tuple3.first(("one", 2, "pi")) = "one"

// ===================================================================
// Stdlib.Tuple3.second - Returns the second value of a triple
// ===================================================================

Stdlib.Tuple3.second((1, 2, 3)) = 2
Stdlib.Tuple3.second((0, 42, 99)) = 42
Stdlib.Tuple3.second(("one", 2, "pi")) = 2

// ===================================================================
// Stdlib.Tuple3.third - Returns the third value of a triple
// ===================================================================

Stdlib.Tuple3.third((1, 2, 3)) = 3
Stdlib.Tuple3.third((0, 0, 42)) = 42
Stdlib.Tuple3.third(("one", 2, "pi")) = "pi"

// ===================================================================
// Stdlib.Tuple3.mapFirst - Transform the first value in a triple
// ===================================================================

Stdlib.Tuple3.first(Stdlib.Tuple3.mapFirst(fun x -> x + 1, (5, 10, 15))) = 6
Stdlib.Tuple3.second(Stdlib.Tuple3.mapFirst(fun x -> x + 1, (5, 10, 15))) = 10
Stdlib.Tuple3.third(Stdlib.Tuple3.mapFirst(fun x -> x + 1, (5, 10, 15))) = 15
Stdlib.Tuple3.mapFirst(fun x -> Stdlib.String.toUppercase(x), ("one", 2, "pi")) = ("ONE", 2, "pi")

// ===================================================================
// Stdlib.Tuple3.mapSecond - Transform the second value in a triple
// ===================================================================

Stdlib.Tuple3.first(Stdlib.Tuple3.mapSecond(fun x -> x + 1, (5, 10, 15))) = 5
Stdlib.Tuple3.second(Stdlib.Tuple3.mapSecond(fun x -> x + 1, (5, 10, 15))) = 11
Stdlib.Tuple3.third(Stdlib.Tuple3.mapSecond(fun x -> x + 1, (5, 10, 15))) = 15
Stdlib.Tuple3.mapSecond(fun x -> x - 2, ("one", 2, "pi")) = ("one", 0, "pi")

// ===================================================================
// Stdlib.Tuple3.mapThird - Transform the third value in a triple
// ===================================================================

Stdlib.Tuple3.first(Stdlib.Tuple3.mapThird(fun x -> x + 1, (5, 10, 15))) = 5
Stdlib.Tuple3.second(Stdlib.Tuple3.mapThird(fun x -> x + 1, (5, 10, 15))) = 10
Stdlib.Tuple3.third(Stdlib.Tuple3.mapThird(fun x -> x + 1, (5, 10, 15))) = 16
Stdlib.Tuple3.mapThird(fun x -> Stdlib.String.toUppercase(x), ("one", 2, "pi")) = ("one", 2, "PI")

// ===================================================================
// Stdlib.Tuple3.mapAllThree - Transform all three values in a triple
// ===================================================================

Stdlib.Tuple3.first(Stdlib.Tuple3.mapAllThree(fun x -> x + 1, fun y -> y * 2, fun z -> z - 1, (5, 10, 15))) = 6
Stdlib.Tuple3.second(Stdlib.Tuple3.mapAllThree(fun x -> x + 1, fun y -> y * 2, fun z -> z - 1, (5, 10, 15))) = 20
Stdlib.Tuple3.third(Stdlib.Tuple3.mapAllThree(fun x -> x + 1, fun y -> y * 2, fun z -> z - 1, (5, 10, 15))) = 14
Stdlib.Tuple3.mapAllThree(fun x -> Stdlib.String.toUppercase(x), fun y -> y - 2, fun z -> Stdlib.String.toUppercase(z), ("one", 2, "pi")) = ("ONE", 0, "PI")
