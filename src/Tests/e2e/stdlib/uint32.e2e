// Stdlib.UInt32 Tests
// Ported from https://github.com/darklang/dark/tree/main/backend/testfiles/execution/stdlib
//
// Tests for UInt32 module functions

// ===================================================================
// Stdlib.UInt32.add - Add two integers
// ===================================================================

Stdlib.UInt32.add(0ul, 0ul) = 0ul
Stdlib.UInt32.add(5ul, 5ul) = 10ul
Stdlib.UInt32.add(100ul, 200ul) = 300ul

// ===================================================================
// Stdlib.UInt32.subtract - Subtract two integers
// ===================================================================

Stdlib.UInt32.subtract(10ul, 0ul) = 10ul
Stdlib.UInt32.subtract(100ul, 50ul) = 50ul
Stdlib.UInt32.subtract(5ul, 0ul) = 5ul

// ===================================================================
// Stdlib.UInt32.multiply - Multiply two integers
// ===================================================================

Stdlib.UInt32.multiply(0ul, 100ul) = 0ul
Stdlib.UInt32.multiply(5ul, 5ul) = 25ul
Stdlib.UInt32.multiply(100ul, 100ul) = 10000ul

// ===================================================================
// Stdlib.UInt32.divide - Divide two integers
// ===================================================================

Stdlib.UInt32.divide(10ul, 3ul) = 3ul
Stdlib.UInt32.divide(100ul, 10ul) = 10ul
Stdlib.UInt32.divide(10ul, 2ul) = 5ul

// ===================================================================
// Stdlib.UInt32.mod - Modulo operation
// ===================================================================

Stdlib.UInt32.mod(10ul, 3ul) = 1ul
Stdlib.UInt32.mod(100ul, 7ul) = 2ul
Stdlib.UInt32.mod(20ul, 3ul) = 2ul

// ===================================================================
// Stdlib.UInt32.max - Maximum of two integers
// ===================================================================

Stdlib.UInt32.max(6ul, 5ul) = 6ul
Stdlib.UInt32.max(10ul, 20ul) = 20ul
Stdlib.UInt32.max(0ul, 0ul) = 0ul

// ===================================================================
// Stdlib.UInt32.min - Minimum of two integers
// ===================================================================

Stdlib.UInt32.min(6ul, 5ul) = 5ul
Stdlib.UInt32.min(10ul, 20ul) = 10ul
Stdlib.UInt32.min(0ul, 0ul) = 0ul

// ===================================================================
// Stdlib.UInt32.absoluteValue - Absolute value
// ===================================================================

Stdlib.UInt32.absoluteValue(5ul) = 5ul
Stdlib.UInt32.absoluteValue(0ul) = 0ul
Stdlib.UInt32.absoluteValue(100ul) = 100ul
Stdlib.UInt32.absoluteValue(1ul) = 1ul

// ===================================================================
// Stdlib.UInt32.negate - Negate an integer
// ===================================================================

Stdlib.UInt32.negate(0ul) = 0ul
Stdlib.UInt32.negate(1ul) = 4294967295ul
Stdlib.UInt32.negate(5ul) = 4294967291ul
Stdlib.UInt32.negate(100ul) = 4294967196ul

// ===================================================================
// Stdlib.UInt32.power - Raise to a power
// ===================================================================

Stdlib.UInt32.power(8ul, 5ul) = 32768ul
Stdlib.UInt32.power(2ul, 10ul) = 1024ul
Stdlib.UInt32.power(5ul, 0ul) = 1ul
Stdlib.UInt32.power(5ul, 1ul) = 5ul
Stdlib.UInt32.power(2ul, 8ul) = 256ul

// ===================================================================
// Stdlib.UInt32.clamp - Clamp value between limits
// ===================================================================

Stdlib.UInt32.clamp(5ul, 0ul, 5ul) = 5ul
Stdlib.UInt32.clamp(1ul, 0ul, 5ul) = 1ul
Stdlib.UInt32.clamp(10ul, 5ul, 15ul) = 10ul
Stdlib.UInt32.clamp(2ul, 5ul, 10ul) = 5ul

// ===================================================================
// Stdlib.UInt32.greaterThan - Greater than comparison
// ===================================================================

Stdlib.UInt32.greaterThan(1ul, 20ul) = false
Stdlib.UInt32.greaterThan(5ul, 5ul) = false

// ===================================================================
// Stdlib.UInt32.greaterThanOrEqualTo - Greater than or equal comparison
// ===================================================================

Stdlib.UInt32.greaterThanOrEqualTo(1ul, 6ul) = false
Stdlib.UInt32.greaterThanOrEqualTo(5ul, 5ul) = true

// ===================================================================
// Stdlib.UInt32.lessThan - Less than comparison
// ===================================================================

Stdlib.UInt32.lessThan(8ul, 6ul) = false
Stdlib.UInt32.lessThan(5ul, 5ul) = false

// ===================================================================
// Stdlib.UInt32.lessThanOrEqualTo - Less than or equal comparison
// ===================================================================

Stdlib.UInt32.lessThanOrEqualTo(8ul, 6ul) = false
Stdlib.UInt32.lessThanOrEqualTo(5ul, 5ul) = true

// ===================================================================
// Stdlib.UInt32.toString - Convert integer to string
// ===================================================================

Stdlib.UInt32.toString(42ul) = "42"
Stdlib.UInt32.toString(5ul) = "5"
Stdlib.UInt32.toString(1234567890ul) = "1234567890"

// ===================================================================
// Stdlib.UInt32.isEven - Check if integer is even
// ===================================================================


// ===================================================================
// Stdlib.UInt32.isOdd - Check if integer is odd
// ===================================================================


// ===================================================================
// Stdlib.UInt32.sum - Sum all integers in a list
// ===================================================================

Stdlib.UInt32.sum([1ul, 2ul, 3ul, 4ul, 5ul]) = 15ul
Stdlib.UInt32.sum([]) = 0ul
Stdlib.UInt32.sum([100ul]) = 100ul
Stdlib.UInt32.sum([1ul, 1ul, 2ul, 2ul]) = 6ul
Stdlib.UInt32.sum([10ul, 20ul, 30ul]) = 60ul

