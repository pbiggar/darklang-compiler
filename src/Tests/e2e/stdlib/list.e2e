// Stdlib.List Tests
// Ported from https://github.com/darklang/dark/tree/main/backend/testfiles/execution/stdlib
//
// Tests for List module functions
//
// Canonical list concatenation is covered below.

// ===================================================================
// Stdlib.List.singleton - Create a single-element list
// ===================================================================

Stdlib.List.length(Stdlib.List.singleton(42L)) = 1I
match Stdlib.List.singleton(5L) with | [x] -> x | _ -> 0L = 5L

// ===================================================================
// List append syntax
// ===================================================================

let rest = [3L, 4L, 5L] in Stdlib.List.length([1L, 2L] @ rest) = 5I
Stdlib.List.length<Int64>([1L] @ []) = 1I
let tail = [2L, 3L] in match [1L] @ tail with | [a, b, c] -> a + b + c | _ -> 0L = 6L

// ===================================================================
// Stdlib.List.push - Add element to front of list
// ===================================================================

match Stdlib.List.push([2L, 3L], 1L) with | [a, b, c] -> a | _ -> 0L = 1L
Stdlib.List.length(Stdlib.List.push([1L, 2L], 0L)) = 3I
// ===================================================================
// Stdlib.List.append - Concatenate two lists
// ===================================================================

Stdlib.List.length(Stdlib.List.append([1L, 2L, 3L], [4L, 5L, 6L])) = 6I
match Stdlib.List.append([1L, 2L], [3L, 4L]) with | [a, b, c, d] -> a + b + c + d | _ -> 0L = 10L

// ===================================================================
// Stdlib.List.pushBack - Add element to end of list
// ===================================================================

match Stdlib.List.pushBack([1L, 2L], 3L) with | [a, b, c] -> c | _ -> 0L = 3L

// ===================================================================
// Stdlib.List.reverse - Reverse a list
// ===================================================================

match Stdlib.List.reverse([1L, 2L, 3L]) with | [a, b, c] -> a | _ -> 0L = 3L

// ===================================================================
// Stdlib.List.map - Apply a function to each element
// ===================================================================

match Stdlib.List.map<Int64, Int64>([1L, 2L, 3L], fun x -> x + 1L) with | [a, b, c] -> a + b + c | _ -> 0L = 9L
Stdlib.List.length(Stdlib.List.map<Int64, Int64>([1L, 2L, 3L, 4L], fun x -> x * 2L)) = 4I
let add = Stdlib.Int64.add in match Stdlib.List.map<Int64, Int64>([1L, 2L, 3L], fun x -> add(x, 1L)) with | [a, b, c] -> a + b + c | _ -> 0L = 9L

// ===================================================================
// Stdlib.List.filter - Keep elements that match predicate
// ===================================================================

Stdlib.List.length(Stdlib.List.filter<Int64>([1L, 2L, 3L, 4L, 5L], fun x -> x > 2L)) = 3I
let filterThreshold = 3L in match Stdlib.List.filter<Int64>([1L, 2L, 3L, 4L, 5L], fun x -> x < filterThreshold) with | [a, b] -> a * 10L + b | _ -> 0L = 12L
// ===================================================================
// Stdlib.List.fold - Reduce list with accumulator
// ===================================================================

Stdlib.List.fold([1L, 2L, 3L, 4L, 5L], 0L, fun acc x -> acc + x) = 15L
Stdlib.List.fold([1L, 2L, 3L, 4L], 1L, fun acc x -> acc * x) = 24L

// ===================================================================
// Stdlib.List.drop - Drop first n elements
// ===================================================================

Stdlib.List.length(Stdlib.List.drop([1L, 2L, 3L, 4L, 5L], 2I)) = 3I
Stdlib.List.length(Stdlib.List.drop([1L, 2L, 3L], 0I)) = 3I
Stdlib.List.length(Stdlib.List.drop([1L, 2L, 3L], 10I)) = 0I
// ===================================================================
// Stdlib.List.take - Take first n elements
// ===================================================================

Stdlib.List.length(Stdlib.List.take([1L, 2L, 3L, 4L, 5L], 3I)) = 3I
Stdlib.List.length(Stdlib.List.take([1L, 2L, 3L], 0I)) = 0I
Stdlib.List.length(Stdlib.List.take([1L, 2L], 10I)) = 2I
// ===================================================================
// Stdlib.List.head - Get first element or None
// ===================================================================

Stdlib.Option.withDefault(Stdlib.List.head([1L, 2L, 3L]), 0L) = 1L
Stdlib.Option.isNone<Int64>(Stdlib.List.head<Int64>([])) = true

// ===================================================================
// Stdlib.List.tail - Get rest of list (all but first element) or None
// ===================================================================

// NOTE: Needs type params because empty list default doesn't constrain type
Stdlib.List.length(Stdlib.Option.withDefault<List<Int64>>(Stdlib.List.tail([1L, 2L, 3L]), [])) = 2I
Stdlib.Option.isNone<List<Int64>>(Stdlib.List.tail<Int64>([])) = true
match Stdlib.List.tail([1L, 2L, 3L]) with | Some(t) -> Stdlib.List.length(t) | None -> 0I = 2I
Stdlib.List.tail([1L, 2L, 3L]) = Some([2L, 3L])

// ===================================================================
// Stdlib.List.getAt - Get element at index
// ===================================================================

Stdlib.Option.withDefault(Stdlib.List.getAt([10L, 20L, 30L], 0I), 0L) = 10L
Stdlib.Option.withDefault(Stdlib.List.getAt([10L, 20L, 30L], 2I), 0L) = 30L
Stdlib.Option.isNone<Int64>(Stdlib.List.getAt<Int64>([1L, 2L, 3L], 10I)) = true

// Stdlib.List.getAtOrDefault returns the element without allocating an Option.
Stdlib.List.getAtOrDefault<Int64>([10L, 20L, 30L], 1L, 99L) = 20L
Stdlib.List.getAtOrDefault<Int64>([10L, 20L, 30L], -1L, 99L) = 99L
Stdlib.List.getAtOrDefault<Int64>([10L, 20L, 30L], 3L, 99L) = 99L
let selected = Stdlib.List.getAtOrDefault<Float>([-0.0], 0L, 1.0) in Stdlib.Float.toBits(selected) = 9223372036854775808UL
let fallback = Stdlib.List.getAtOrDefault<Float>([1.0], 1L, -0.0) in Stdlib.Float.toBits(fallback) = 9223372036854775808UL

// Regression test: Stdlib.List.getAt<Float> should correctly extract Float from Option
// NOTE: Float list storage works (FpToGp converts Float bits to GP for RawSlotInit),
// but extraction doesn't work yet - __raw_get<Float> returns bits in GP register
// and needs GpToFp conversion at function return level, which isn't implemented.
// let v = [1.0, 2.0, 3.0] in match Stdlib.List.getAt<Float>(v, 1I) with | Some(x) -> Stdlib.Float.toInt(x * 1000.0) | None -> -1 = 2000

// ===================================================================
// Stdlib.List.findFirst - Find first element matching predicate
// ===================================================================

Stdlib.Option.withDefault(Stdlib.List.findFirst<Int64>([1L, 2L, 3L, 4L], fun x -> x > 2L), 0L) = 3L
Stdlib.Option.isNone<Int64>(Stdlib.List.findFirst<Int64>([1L, 2L, 3L], fun x -> x > 10L)) = true

// ===================================================================
// Stdlib.List.all - Check if all elements satisfy predicate
// ===================================================================

Stdlib.List.all([1L, 2L, 3L], fun x -> x > 0L) = true
Stdlib.List.all([1L, 2L, 3L], fun x -> x > 2L) = false
Stdlib.List.all<Int64>([], fun x -> x > 0L) = true

// ===================================================================
// Stdlib.List.any - Check if any element satisfies predicate
// ===================================================================

Stdlib.List.any([1L, 2L, 3L], fun x -> x > 2L) = true
Stdlib.List.any([1L, 2L, 3L], fun x -> x > 10L) = false
Stdlib.List.any<Int64>([], fun x -> x > 0L) = false

// ===================================================================
// Stdlib.List.last - Get last element or None
// ===================================================================

Stdlib.Option.withDefault(Stdlib.List.last([1L, 2L, 3L]), 0L) = 3L
Stdlib.Option.withDefault(Stdlib.List.last([42L]), 0L) = 42L
Stdlib.Option.isNone<Int64>(Stdlib.List.last<Int64>([])) = true

// ===================================================================
// Stdlib.List.dropLast - Remove last element
// ===================================================================

Stdlib.List.length(Stdlib.List.dropLast([1L, 2L, 3L, 4L, 5L])) = 4I
Stdlib.List.length(Stdlib.List.dropLast([1L])) = 0I
Stdlib.List.length(Stdlib.List.dropLast<Int64>([])) = 0I
match Stdlib.List.dropLast([1L, 2L, 3L]) with | [a, b] -> a + b | _ -> 0L = 3L

// ===================================================================
// Stdlib.List.range - Generate list of integers
// ===================================================================

Stdlib.List.length<Int>(Stdlib.List.range(0I, 5I)) = 6I
Stdlib.List.length<Int>(Stdlib.List.range(0I, 0I)) = 1I
Stdlib.List.length<Int>(Stdlib.List.range(5I, 3I)) = 0I
match Stdlib.List.range(1I, 3I) with | [a, b, c] -> a + b + c | _ -> 0I = 6I

// ===================================================================
// Stdlib.List.repeat - Repeat value n times
// ===================================================================

Stdlib.List.length(Stdlib.List.repeatUnsafe(5I, 42L)) = 5I
Stdlib.List.length(Stdlib.List.repeatUnsafe(0I, 1L)) = 0I
match Stdlib.List.repeatUnsafe(3I, 7L) with | [a, b, c] -> a + b + c | _ -> 0L = 21L

// ===================================================================
// Stdlib.List.indexedMap - Map with index
// ===================================================================

// Sum of index + value for [10, 20, 30] = (0+10) + (1+20) + (2+30) = 63
Stdlib.List.fold(Stdlib.List.indexedMap<Int64, Int64>([10L, 20L, 30L], fun i x -> let index = Builtin.unwrap(Stdlib.Int.toInt64(i)) in Stdlib.Int64.add(x, index)), 0L, fun acc x -> acc + x) = 63L
Stdlib.List.length(Stdlib.List.indexedMap<Int64, Int64>([1L, 2L, 3L, 4L], fun i x -> x)) = 4I
// ===================================================================
// Stdlib.List.partition - Split list by predicate
// ===================================================================

match Stdlib.List.partition([1L, 2L, 3L, 4L, 5L], fun x -> x > 2L) with | (trues, falses) -> Stdlib.List.length(trues) | _ -> 0I = 3I
match Stdlib.List.partition([1L, 2L, 3L, 4L, 5L], fun x -> x > 2L) with | (trues, falses) -> Stdlib.List.length(falses) | _ -> 0I = 2I
// ===================================================================
// Stdlib.List.all - Check if all satisfy predicate (alias for forAll)
// ===================================================================

Stdlib.List.all([1L, 2L, 3L], fun x -> x > 0L) = true
Stdlib.List.all([1L, 2L, 3L], fun x -> x > 2L) = false

