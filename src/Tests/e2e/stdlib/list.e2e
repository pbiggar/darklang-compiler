// Stdlib.List Tests
// Ported from https://github.com/darklang/dark/tree/main/backend/testfiles/execution/stdlib
//
// Tests for List module functions
//
// Canonical list concatenation is covered below.

// ===================================================================
// Stdlib.List.singleton - Create a single-element list
// ===================================================================

Stdlib.List.length (Stdlib.List.singleton 42L) = 1
match Stdlib.List.singleton 5L with | [x] -> x | _ -> 0L = 5L

// ===================================================================
// List append syntax
// ===================================================================

let rest = [3L, 4L, 5L] in Stdlib.List.length ([1L, 2L] @ rest) = 5
Stdlib.List.length ([1L] @ []) = 1
let tail = [2L, 3L] in match [1L] @ tail with | [a, b, c] -> a + b + c | _ -> 0L = 6L

// ===================================================================
// Stdlib.List.push - Add element to front of list
// ===================================================================

match Stdlib.List.push ([2L, 3L]) 1L with | [a, b, c] -> a | _ -> 0L = 1L
Stdlib.List.length (Stdlib.List.push ([1L, 2L]) 0L) = 3
// ===================================================================
// Stdlib.List.append - Concatenate two lists
// ===================================================================

Stdlib.List.length (Stdlib.List.append ([1L, 2L, 3L]) ([4L, 5L, 6L])) = 6
match Stdlib.List.append ([1L, 2L]) ([3L, 4L]) with | [a, b, c, d] -> a + b + c + d | _ -> 0L = 10L

// ===================================================================
// Stdlib.List.pushBack - Add element to end of list
// ===================================================================

match Stdlib.List.pushBack ([1L, 2L]) 3L with | [a, b, c] -> c | _ -> 0L = 3L

// ===================================================================
// Stdlib.List.reverse - Reverse a list
// ===================================================================

match Stdlib.List.reverse ([1L, 2L, 3L]) with | [a, b, c] -> a | _ -> 0L = 3L

// ===================================================================
// Stdlib.List.map - Apply a function to each element
// ===================================================================

match Stdlib.List.map ([1L, 2L, 3L]) (fun x -> x + 1L) with | [a, b, c] -> a + b + c | _ -> 0L = 9L
Stdlib.List.length (Stdlib.List.map ([1L, 2L, 3L, 4L]) (fun x -> x * 2L)) = 4
let add = Stdlib.Int64.add in match Stdlib.List.map ([1L, 2L, 3L]) (fun x -> add x 1L) with | [a, b, c] -> a + b + c | _ -> 0L = 9L

// ===================================================================
// Stdlib.List.filter - Keep elements that match predicate
// ===================================================================

Stdlib.List.length (Stdlib.List.filter ([1L, 2L, 3L, 4L, 5L]) (fun x -> x > 2L)) = 3
let filterThreshold = 3L in match Stdlib.List.filter ([1L, 2L, 3L, 4L, 5L]) (fun x -> x < filterThreshold) with | [a, b] -> a * 10L + b | _ -> 0L = 12L
// ===================================================================
// Stdlib.List.fold - Reduce list with accumulator
// ===================================================================

Stdlib.List.fold ([1L, 2L, 3L, 4L, 5L]) 0L (fun acc x -> acc + x) = 15L
Stdlib.List.fold ([1L, 2L, 3L, 4L]) 1L (fun acc x -> acc * x) = 24L

// ===================================================================
// Stdlib.List.drop - Drop first n elements
// ===================================================================

Stdlib.List.length (Stdlib.List.drop ([1L, 2L, 3L, 4L, 5L]) 2) = 3
Stdlib.List.length (Stdlib.List.drop ([1L, 2L, 3L]) 0) = 3
Stdlib.List.length (Stdlib.List.drop ([1L, 2L, 3L]) 10) = 0
// ===================================================================
// Stdlib.List.take - Take first n elements
// ===================================================================

Stdlib.List.length (Stdlib.List.take ([1L, 2L, 3L, 4L, 5L]) 3) = 3
Stdlib.List.length (Stdlib.List.take ([1L, 2L, 3L]) 0) = 0
Stdlib.List.length (Stdlib.List.take ([1L, 2L]) 10) = 2
// ===================================================================
// Stdlib.List.head - Get first element or None
// ===================================================================

Stdlib.Option.withDefault (Stdlib.List.head ([1L, 2L, 3L])) 0L = 1L
Stdlib.Option.isNone (Stdlib.List.head []) = true

// ===================================================================
// Stdlib.List.tail - Get rest of list (all but first element) or None
// ===================================================================

// NOTE: Needs type params because empty list default doesn't constrain type
Stdlib.List.length (Stdlib.Option.withDefault (Stdlib.List.tail ([1L, 2L, 3L])) []) = 2
Stdlib.Option.isNone (Stdlib.List.tail []) = true
match Stdlib.List.tail ([1L, 2L, 3L]) with | Some t -> Stdlib.List.length t | None -> 0 = 2
Stdlib.List.tail ([1L, 2L, 3L]) = Some ([2L, 3L])

// ===================================================================
// Stdlib.List.getAt - Get element at index
// ===================================================================

Stdlib.Option.withDefault (Stdlib.List.getAt ([10L, 20L, 30L]) 0) 0L = 10L
Stdlib.Option.withDefault (Stdlib.List.getAt ([10L, 20L, 30L]) 2) 0L = 30L
Stdlib.Option.isNone (Stdlib.List.getAt ([1L, 2L, 3L]) 10) = true

// Compose the upstream Option-returning getAt with a default value.
Stdlib.Option.withDefault (Stdlib.List.getAt ([10L, 20L, 30L]) 1) 99L = 20L
Stdlib.Option.withDefault (Stdlib.List.getAt ([10L, 20L, 30L]) (-1)) 99L = 99L
let index = 1L in Stdlib.Option.withDefault (Stdlib.List.getAt ([10L, 20L, 30L]) (Stdlib.Int.fromInt64 index)) 99L = 20L
let index = -1L in Stdlib.Option.isNone (Stdlib.List.getAt ([10L, 20L, 30L]) (Stdlib.Int.fromInt64 index)) = true
let index = 3L in Stdlib.Option.isNone (Stdlib.List.getAt ([10L, 20L, 30L]) (Stdlib.Int.fromInt64 index)) = true
let index = 1L in match Stdlib.List.getAt (["a" ++ "b", "c" ++ "d"]) (Stdlib.Int.fromInt64 index) with | Some value -> value | None -> "missing" = "cd"
let index = 1L in match Stdlib.List.getAt ([(1L, 1.5), (2L, 2.5)]) (Stdlib.Int.fromInt64 index) with | Some ((first, _)) -> first | None -> 0L = 2L
Stdlib.Option.withDefault (Stdlib.List.getAt ([10L, 20L, 30L]) 3) 99L = 99L
let selected = Stdlib.Option.withDefault (Stdlib.List.getAt ([-0.0]) 0) 1.0 in Stdlib.Float.toBits selected = 9223372036854775808
let fallback = Stdlib.Option.withDefault (Stdlib.List.getAt ([1.0]) 1) (-0.0) in Stdlib.Float.toBits fallback = 9223372036854775808

// Float results cross the generic Option boundary without losing their type.
let floats = [1.0, 2.0, 3.0] in match Stdlib.List.getAt floats 1 with | Some x -> Stdlib.Float.toInt (x * 1000.0) | None -> -1 = 2000

// ===================================================================
// Stdlib.List.findFirst - Find first element matching predicate
// ===================================================================

Stdlib.Option.withDefault (Stdlib.List.findFirst ([1L, 2L, 3L, 4L]) (fun x -> x > 2L)) 0L = 3L
Stdlib.Option.isNone (Stdlib.List.findFirst ([1L, 2L, 3L]) (fun x -> x > 10L)) = true

// ===================================================================
// Stdlib.List.all - Check if all elements satisfy predicate
// ===================================================================

Stdlib.List.all ([1L, 2L, 3L]) (fun x -> x > 0L) = true
Stdlib.List.all ([1L, 2L, 3L]) (fun x -> x > 2L) = false
Stdlib.List.all [] (fun x -> x > 0L) = true

// ===================================================================
// Stdlib.List.any - Check if any element satisfies predicate
// ===================================================================

Stdlib.List.any ([1L, 2L, 3L]) (fun x -> x > 2L) = true
Stdlib.List.any ([1L, 2L, 3L]) (fun x -> x > 10L) = false
Stdlib.List.any [] (fun x -> x > 0L) = false

// ===================================================================
// Stdlib.List.last - Get last element or None
// ===================================================================

Stdlib.Option.withDefault (Stdlib.List.last ([1L, 2L, 3L])) 0L = 3L
Stdlib.Option.withDefault (Stdlib.List.last ([42L])) 0L = 42L
Stdlib.Option.isNone (Stdlib.List.last []) = true

// ===================================================================
// Stdlib.List.dropLast - Remove last element
// ===================================================================

Stdlib.List.length (Stdlib.List.dropLast ([1L, 2L, 3L, 4L, 5L])) = 4
Stdlib.List.length (Stdlib.List.dropLast ([1L])) = 0
Stdlib.List.length (Stdlib.List.dropLast []) = 0
match Stdlib.List.dropLast ([1L, 2L, 3L]) with | [a, b] -> a + b | _ -> 0L = 3L

// ===================================================================
// Stdlib.List.range - Generate list of integers
// ===================================================================

Stdlib.List.length (Stdlib.List.range 0 5) = 6
Stdlib.List.length (Stdlib.List.range 0 0) = 1
Stdlib.List.length (Stdlib.List.range 5 3) = 0
match Stdlib.List.range 1 3 with | [a, b, c] -> a + b + c | _ -> 0 = 6

// ===================================================================
// Stdlib.List.repeat - Repeat value n times
// ===================================================================

Stdlib.List.length (Stdlib.List.repeatUnsafe 5 42L) = 5
Stdlib.List.length (Stdlib.List.repeatUnsafe 0 1L) = 0
match Stdlib.List.repeatUnsafe 3 7L with | [a, b, c] -> a + b + c | _ -> 0L = 21L

// ===================================================================
// Stdlib.List.indexedMap - Map with index
// ===================================================================

// Sum of index + value for [10, 20, 30] = (0+10) + (1+20) + (2+30) = 63
Stdlib.List.fold (Stdlib.List.indexedMap ([10L, 20L, 30L]) (fun i x -> let index = Builtin.unwrap (Stdlib.Int.toInt64 i) in Stdlib.Int64.add x index)) 0L (fun acc x -> acc + x) = 63L
Stdlib.List.length (Stdlib.List.indexedMap ([1L, 2L, 3L, 4L]) (fun i x -> x)) = 4
let target = Stdlib.Int.fromInt64 10L in Stdlib.List.length (Stdlib.List.indexedMap ([1L, 2L, 3L, 4L, 5L, 6L, 7L, 8L, 9L, 10L, 11L]) (fun i x -> if i == target then 99L else x)) = stdout="11\n" stderr="" disable_opt_inline=true
// ===================================================================
// Stdlib.List.partition - Split list by predicate
// ===================================================================

match Stdlib.List.partition ([1L, 2L, 3L, 4L, 5L]) (fun x -> x > 2L) with | (trues, falses) -> Stdlib.List.length trues | _ -> 0 = 3
match Stdlib.List.partition ([1L, 2L, 3L, 4L, 5L]) (fun x -> x > 2L) with | (trues, falses) -> Stdlib.List.length falses | _ -> 0 = 2
// ===================================================================
// Stdlib.List.all - Check if all satisfy predicate (alias for forAll)
// ===================================================================


// ===================================================================
// List memory reclamation regression
// ===================================================================
let memReclaimMakeHelper (n: Int64) (acc: List<Int64>) : List<Int64> =
    if n <= 0L then acc
    else memReclaimMakeHelper (n - 1L) (Stdlib.List.push acc n)

let memReclaimMake (n: Int64) : List<Int64> =
    memReclaimMakeHelper n []

let memReclaimBurn (iters: Int64) (total: Int64) : Int64 =
    if iters <= 0L then total
    else
        let l = memReclaimMake 400L in
        let len = Builtin.unwrap (Stdlib.Int.toInt64 (Stdlib.List.length l)) in
        memReclaimBurn (iters - 1L) (total + len)

memReclaimBurn 10000L 0L = stdout="4000000\n" stderr=""

// ===================================================================
// NOTE: Functions disabled due to compiler bugs
// ===================================================================

// Stdlib.List.zip - disabled due to tuple recursion bug
