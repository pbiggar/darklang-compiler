// Stdlib.List Tests
// Ported from https://github.com/darklang/dark/tree/main/backend/testfiles/execution/stdlib
//
// Tests for List module functions
//
// NOTE: List spread syntax in expressions is supported and covered below.
// Remaining disabled cases are documented near the affected tests.

// ===================================================================
// Stdlib.List.singleton - Create a single-element list
// ===================================================================

Stdlib.List.length(Stdlib.List.singleton(42)) = 1
match Stdlib.List.singleton(5) with | [x] -> x | _ -> 0 = 5

// ===================================================================
// List spread syntax - [h, ...rest] in expressions
// ===================================================================

// Test basic spread syntax
let rest = [3, 4, 5] in Stdlib.List.length([1, 2, ...rest]) = 5

// Test spread with empty list (need type annotation via function call)
Stdlib.List.length<Int64>([1, ...[]]) = 1

// Test spread with single element head
let tail = [2, 3] in match [1, ...tail] with | [a, b, c] -> a + b + c | _ -> 0 = 6

// ===================================================================
// Stdlib.List.push - Add element to front of list
// ===================================================================

match Stdlib.List.push([2, 3], 1) with | [a, b, c] -> a | _ -> 0 = 1
Stdlib.List.length(Stdlib.List.push([1, 2], 0)) = 3

// ===================================================================
// Stdlib.List.append - Concatenate two lists
// ===================================================================

Stdlib.List.length(Stdlib.List.append([1, 2, 3], [4, 5, 6])) = 6
match Stdlib.List.append([1, 2], [3, 4]) with | [a, b, c, d] -> a + b + c + d | _ -> 0 = 10

// ===================================================================
// Stdlib.List.pushBack - Add element to end of list
// ===================================================================

match Stdlib.List.pushBack([1, 2], 3) with | [a, b, c] -> c | _ -> 0 = 3

// ===================================================================
// Stdlib.List.reverse - Reverse a list
// ===================================================================

match Stdlib.List.reverse([1, 2, 3]) with | [a, b, c] -> a | _ -> 0 = 3

// ===================================================================
// Stdlib.List.map - Apply a function to each element
// ===================================================================

match Stdlib.List.map([1, 2, 3], (x: Int64) => x + 1) with | [a, b, c] -> a + b + c | _ -> 0 = 9
Stdlib.List.length(Stdlib.List.map([1, 2, 3, 4], (x: Int64) => x * 2)) = 4
let add = Stdlib.Int64.add in match Stdlib.List.map([1, 2, 3], (x: Int64) => add(x, 1)) with | [a, b, c] -> a + b + c | _ -> 0 = 9

// ===================================================================
// Stdlib.List.filter - Keep elements that match predicate
// ===================================================================

Stdlib.List.length(Stdlib.List.filter([1, 2, 3, 4, 5], (x: Int64) => x > 2)) = 3

// ===================================================================
// Stdlib.List.fold - Reduce list with accumulator
// ===================================================================

Stdlib.List.fold([1, 2, 3, 4, 5], 0, (acc: Int64, x: Int64) => acc + x) = 15
Stdlib.List.fold([1, 2, 3, 4], 1, (acc: Int64, x: Int64) => acc * x) = 24

// ===================================================================
// Stdlib.List.drop - Drop first n elements
// ===================================================================

Stdlib.List.length(Stdlib.List.drop([1, 2, 3, 4, 5], 2)) = 3
Stdlib.List.length(Stdlib.List.drop([1, 2, 3], 0)) = 3
Stdlib.List.length(Stdlib.List.drop([1, 2, 3], 10)) = 0

// ===================================================================
// Stdlib.List.take - Take first n elements
// ===================================================================

Stdlib.List.length(Stdlib.List.take([1, 2, 3, 4, 5], 3)) = 3
Stdlib.List.length(Stdlib.List.take([1, 2, 3], 0)) = 0
Stdlib.List.length(Stdlib.List.take([1, 2], 10)) = 2

// ===================================================================
// Stdlib.List.head - Get first element or None
// ===================================================================

Stdlib.Option.withDefault(Stdlib.List.head([1, 2, 3]), 0) = 1
Stdlib.Option.isNone<Int64>(Stdlib.List.head<Int64>([])) = true

// ===================================================================
// Stdlib.List.tail - Get rest of list (all but first element) or None
// ===================================================================

// NOTE: Needs type params because empty list default doesn't constrain type
Stdlib.List.length(Stdlib.Option.withDefault<List<Int64>>(Stdlib.List.tail([1, 2, 3]), [])) = 2
Stdlib.Option.isNone<List<Int64>>(Stdlib.List.tail<Int64>([])) = true
match Stdlib.List.tail([1, 2, 3]) with | Some(t) -> Stdlib.List.length(t) | None -> 0 = 2
Stdlib.List.tail([1, 2, 3]) = Some([2, 3])

// ===================================================================
// Stdlib.List.getAt - Get element at index
// ===================================================================

Stdlib.Option.withDefault(Stdlib.List.getAt([10, 20, 30], 0), 0) = 10
Stdlib.Option.withDefault(Stdlib.List.getAt([10, 20, 30], 2), 0) = 30
Stdlib.Option.isNone<Int64>(Stdlib.List.getAt<Int64>([1, 2, 3], 10)) = true

// Regression test: Stdlib.List.getAt<Float> should correctly extract Float from Option
// NOTE: Float list storage works (FpToGp converts Float bits to GP for RawSlotInit),
// but extraction doesn't work yet - __raw_get<Float> returns bits in GP register
// and needs GpToFp conversion at function return level, which isn't implemented.
// let v = [1.0, 2.0, 3.0] in match Stdlib.List.getAt<Float>(v, 1) with | Some(x) -> Stdlib.Float.toInt(x * 1000.0) | None -> -1 = 2000

// ===================================================================
// Stdlib.List.findFirst - Find first element matching predicate
// ===================================================================

Stdlib.Option.withDefault(Stdlib.List.findFirst([1, 2, 3, 4], (x: Int64) => x > 2), 0) = 3
Stdlib.Option.isNone<Int64>(Stdlib.List.findFirst<Int64>([1, 2, 3], (x: Int64) => x > 10)) = true

// ===================================================================
// Stdlib.List.forAll - Check if all elements satisfy predicate
// ===================================================================

Stdlib.List.forAll([1, 2, 3], (x: Int64) => x > 0) = true
Stdlib.List.forAll([1, 2, 3], (x: Int64) => x > 2) = false
Stdlib.List.forAll<Int64>([], (x: Int64) => x > 0) = true

// ===================================================================
// Stdlib.List.any - Check if any element satisfies predicate
// ===================================================================

Stdlib.List.any([1, 2, 3], (x: Int64) => x > 2) = true
Stdlib.List.any([1, 2, 3], (x: Int64) => x > 10) = false
Stdlib.List.any<Int64>([], (x: Int64) => x > 0) = false

// ===================================================================
// Stdlib.List.last - Get last element or None
// ===================================================================

Stdlib.Option.withDefault(Stdlib.List.last([1, 2, 3]), 0) = 3
Stdlib.Option.withDefault(Stdlib.List.last([42]), 0) = 42
Stdlib.Option.isNone<Int64>(Stdlib.List.last<Int64>([])) = true

// ===================================================================
// Stdlib.List.dropLast - Remove last element
// ===================================================================

Stdlib.List.length(Stdlib.List.dropLast([1, 2, 3, 4, 5])) = 4
Stdlib.List.length(Stdlib.List.dropLast([1])) = 0
Stdlib.List.length(Stdlib.List.dropLast<Int64>([])) = 0
match Stdlib.List.dropLast([1, 2, 3]) with | [a, b] -> a + b | _ -> 0 = 3

// ===================================================================
// Stdlib.List.range - Generate list of integers
// ===================================================================

Stdlib.List.length<Int64>(Stdlib.List.range(0, 5)) = 5
Stdlib.List.length<Int64>(Stdlib.List.range(0, 0)) = 0
Stdlib.List.length<Int64>(Stdlib.List.range(5, 3)) = 0
match Stdlib.List.range(1, 4) with | [a, b, c] -> a + b + c | _ -> 0 = 6

// ===================================================================
// Stdlib.List.repeat - Repeat value n times
// ===================================================================

Stdlib.List.length(Stdlib.List.repeat(42, 5)) = 5
Stdlib.List.length(Stdlib.List.repeat(1, 0)) = 0
match Stdlib.List.repeat(7, 3) with | [a, b, c] -> a + b + c | _ -> 0 = 21

// ===================================================================
// Stdlib.List.setAt - Set element at index
// ===================================================================

Stdlib.Option.withDefault(Stdlib.List.getAt(Stdlib.List.setAt([10, 20, 30], 1, 99), 1), 0) = 99
Stdlib.List.length(Stdlib.List.setAt([1, 2, 3], 0, 100)) = 3

// NOTE: Tail call optimization bug corrupts lists - see benchmarks.e2e
// Lists built by tail-recursive functions (like Stdlib.List.repeat) get corrupted
// when modified by other tail-recursive functions (like Stdlib.List.setAt).
// Non-tail-recursive versions work correctly.

// ===================================================================
// Stdlib.List.indexedMap - Map with index
// ===================================================================

// Sum of index + value for [10, 20, 30] = (0+10) + (1+20) + (2+30) = 63
Stdlib.List.fold(Stdlib.List.indexedMap([10, 20, 30], (i: Int64, x: Int64) => i + x), 0, (acc: Int64, x: Int64) => acc + x) = 63
Stdlib.List.length(Stdlib.List.indexedMap([1, 2, 3, 4], (i: Int64, x: Int64) => x)) = 4

// ===================================================================
// Stdlib.List.partition - Split list by predicate
// ===================================================================

match Stdlib.List.partition([1, 2, 3, 4, 5], (x: Int64) => x > 2) with | (trues, falses) -> Stdlib.List.length(trues) | _ -> 0 = 3
match Stdlib.List.partition([1, 2, 3, 4, 5], (x: Int64) => x > 2) with | (trues, falses) -> Stdlib.List.length(falses) | _ -> 0 = 2

// ===================================================================
// Stdlib.List.all - Check if all satisfy predicate (alias for forAll)
// ===================================================================

Stdlib.List.all([1, 2, 3], (x: Int64) => x > 0) = true
Stdlib.List.all([1, 2, 3], (x: Int64) => x > 2) = false

// ===================================================================
// List memory reclamation regression
// ===================================================================
// Disabled on x86_64: requires reference counting, which is implemented
// but currently gated off (enabling it regresses 37 other tests). See
// docs/x64-refcounting.md.
//
// def memReclaimMakeHelper(n: Int64, acc: List<Int64>) : List<Int64> =
//     if n <= 0 then acc
//     else memReclaimMakeHelper(n - 1, [n, ...acc])
//
// def memReclaimMake(n: Int64) : List<Int64> =
//     memReclaimMakeHelper(n, [])
//
// def memReclaimBurn(iters: Int64, total: Int64) : Int64 =
//     if iters <= 0 then total
//     else
//         let l = memReclaimMake(400) in
//         let len = Stdlib.List.length<Int64>(l) in
//         memReclaimBurn(iters - 1, total + len)
//
// memReclaimBurn(10000, 0) = 4000000

// ===================================================================
// NOTE: Functions disabled due to compiler bugs
// ===================================================================

// Stdlib.List.zip - disabled due to tuple recursion bug
