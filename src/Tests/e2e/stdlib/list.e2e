// Stdlib.List Tests
// Ported from https://github.com/darklang/dark/tree/main/backend/testfiles/execution/stdlib
//
// Tests for List module functions
//
// Canonical list concatenation is covered below.

// ===================================================================
// Stdlib.List.singleton - Create a single-element list
// ===================================================================

Stdlib.List.length(Stdlib.List.singleton(42)) = 1I
match Stdlib.List.singleton(5) with | [x] -> x | _ -> 0 = 5

// ===================================================================
// List append syntax
// ===================================================================

let rest = [3, 4, 5] in Stdlib.List.length([1, 2] @ rest) = 5I
Stdlib.List.length<Int64>([1] @ []) = 1I
let tail = [2, 3] in match [1] @ tail with | [a, b, c] -> a + b + c | _ -> 0 = 6

// ===================================================================
// Stdlib.List.push - Add element to front of list
// ===================================================================

match Stdlib.List.push([2, 3], 1) with | [a, b, c] -> a | _ -> 0 = 1
Stdlib.List.length(Stdlib.List.push([1, 2], 0)) = 3I
// ===================================================================
// Stdlib.List.append - Concatenate two lists
// ===================================================================

Stdlib.List.length(Stdlib.List.append([1, 2, 3], [4, 5, 6])) = 6I
match Stdlib.List.append([1, 2], [3, 4]) with | [a, b, c, d] -> a + b + c + d | _ -> 0 = 10

// ===================================================================
// Stdlib.List.pushBack - Add element to end of list
// ===================================================================

match Stdlib.List.pushBack([1, 2], 3) with | [a, b, c] -> c | _ -> 0 = 3

// ===================================================================
// Stdlib.List.reverse - Reverse a list
// ===================================================================

match Stdlib.List.reverse([1, 2, 3]) with | [a, b, c] -> a | _ -> 0 = 3

// ===================================================================
// Stdlib.List.map - Apply a function to each element
// ===================================================================

match Stdlib.List.map([1, 2, 3], fun x -> x + 1) with | [a, b, c] -> a + b + c | _ -> 0 = 9
Stdlib.List.length(Stdlib.List.map([1, 2, 3, 4], fun x -> x * 2)) = 4I
let add = Stdlib.Int64.add in match Stdlib.List.map([1, 2, 3], fun x -> add(x, 1)) with | [a, b, c] -> a + b + c | _ -> 0 = 9

// ===================================================================
// Stdlib.List.filter - Keep elements that match predicate
// ===================================================================

Stdlib.List.length(Stdlib.List.filter([1, 2, 3, 4, 5], fun x -> x > 2)) = 3I
let filterThreshold = 3 in match Stdlib.List.filter([1, 2, 3, 4, 5], fun x -> x < filterThreshold) with | [a, b] -> a * 10 + b | _ -> 0 = 12
// ===================================================================
// Stdlib.List.fold - Reduce list with accumulator
// ===================================================================

Stdlib.List.fold([1, 2, 3, 4, 5], 0, fun acc x -> acc + x) = 15
Stdlib.List.fold([1, 2, 3, 4], 1, fun acc x -> acc * x) = 24

// ===================================================================
// Stdlib.List.drop - Drop first n elements
// ===================================================================

Stdlib.List.length(Stdlib.List.drop([1, 2, 3, 4, 5], 2I)) = 3I
Stdlib.List.length(Stdlib.List.drop([1, 2, 3], 0I)) = 3I
Stdlib.List.length(Stdlib.List.drop([1, 2, 3], 10I)) = 0I
// ===================================================================
// Stdlib.List.take - Take first n elements
// ===================================================================

Stdlib.List.length(Stdlib.List.take([1, 2, 3, 4, 5], 3I)) = 3I
Stdlib.List.length(Stdlib.List.take([1, 2, 3], 0I)) = 0I
Stdlib.List.length(Stdlib.List.take([1, 2], 10I)) = 2I
// ===================================================================
// Stdlib.List.head - Get first element or None
// ===================================================================

Stdlib.Option.withDefault(Stdlib.List.head([1, 2, 3]), 0) = 1
Stdlib.Option.isNone<Int64>(Stdlib.List.head<Int64>([])) = true

// ===================================================================
// Stdlib.List.tail - Get rest of list (all but first element) or None
// ===================================================================

// NOTE: Needs type params because empty list default doesn't constrain type
Stdlib.List.length(Stdlib.Option.withDefault<List<Int64>>(Stdlib.List.tail([1, 2, 3]), [])) = 2I
Stdlib.Option.isNone<List<Int64>>(Stdlib.List.tail<Int64>([])) = true
match Stdlib.List.tail([1, 2, 3]) with | Some(t) -> Stdlib.List.length(t) | None -> 0I = 2I
Stdlib.List.tail([1, 2, 3]) = Some([2, 3])

// ===================================================================
// Stdlib.List.getAt - Get element at index
// ===================================================================

Stdlib.Option.withDefault(Stdlib.List.getAt([10, 20, 30], 0I), 0) = 10
Stdlib.Option.withDefault(Stdlib.List.getAt([10, 20, 30], 2I), 0) = 30
Stdlib.Option.isNone<Int64>(Stdlib.List.getAt<Int64>([1, 2, 3], 10I)) = true

// Stdlib.List.getAtOrDefault returns the element without allocating an Option.
Stdlib.List.getAtOrDefault<Int64>([10, 20, 30], 1, 99) = 20
Stdlib.List.getAtOrDefault<Int64>([10, 20, 30], -1, 99) = 99
Stdlib.List.getAtOrDefault<Int64>([10, 20, 30], 3, 99) = 99
let selected = Stdlib.List.getAtOrDefault<Float>([-0.0], 0, 1.0) in Stdlib.Float.toBits(selected) = 9223372036854775808UL
let fallback = Stdlib.List.getAtOrDefault<Float>([1.0], 1, -0.0) in Stdlib.Float.toBits(fallback) = 9223372036854775808UL

// Regression test: Stdlib.List.getAt<Float> should correctly extract Float from Option
// NOTE: Float list storage works (FpToGp converts Float bits to GP for RawSlotInit),
// but extraction doesn't work yet - __raw_get<Float> returns bits in GP register
// and needs GpToFp conversion at function return level, which isn't implemented.
// let v = [1.0, 2.0, 3.0] in match Stdlib.List.getAt<Float>(v, 1I) with | Some(x) -> Stdlib.Float.toInt(x * 1000.0) | None -> -1 = 2000

// ===================================================================
// Stdlib.List.findFirst - Find first element matching predicate
// ===================================================================

Stdlib.Option.withDefault(Stdlib.List.findFirst([1, 2, 3, 4], fun x -> x > 2), 0) = 3
Stdlib.Option.isNone<Int64>(Stdlib.List.findFirst<Int64>([1, 2, 3], fun x -> x > 10)) = true

// ===================================================================
// Stdlib.List.all - Check if all elements satisfy predicate
// ===================================================================

Stdlib.List.all([1, 2, 3], fun x -> x > 0) = true
Stdlib.List.all([1, 2, 3], fun x -> x > 2) = false
Stdlib.List.all<Int64>([], fun x -> x > 0) = true

// ===================================================================
// Stdlib.List.any - Check if any element satisfies predicate
// ===================================================================

Stdlib.List.any([1, 2, 3], fun x -> x > 2) = true
Stdlib.List.any([1, 2, 3], fun x -> x > 10) = false
Stdlib.List.any<Int64>([], fun x -> x > 0) = false

// ===================================================================
// Stdlib.List.last - Get last element or None
// ===================================================================

Stdlib.Option.withDefault(Stdlib.List.last([1, 2, 3]), 0) = 3
Stdlib.Option.withDefault(Stdlib.List.last([42]), 0) = 42
Stdlib.Option.isNone<Int64>(Stdlib.List.last<Int64>([])) = true

// ===================================================================
// Stdlib.List.dropLast - Remove last element
// ===================================================================

Stdlib.List.length(Stdlib.List.dropLast([1, 2, 3, 4, 5])) = 4I
Stdlib.List.length(Stdlib.List.dropLast([1])) = 0I
Stdlib.List.length(Stdlib.List.dropLast<Int64>([])) = 0I
match Stdlib.List.dropLast([1, 2, 3]) with | [a, b] -> a + b | _ -> 0 = 3

// ===================================================================
// Stdlib.List.range - Generate list of integers
// ===================================================================

Stdlib.List.length<Int>(Stdlib.List.range(0I, 5I)) = 6I
Stdlib.List.length<Int>(Stdlib.List.range(0I, 0I)) = 1I
Stdlib.List.length<Int>(Stdlib.List.range(5I, 3I)) = 0I
match Stdlib.List.range(1I, 3I) with | [a, b, c] -> a + b + c | _ -> 0I = 6I

// ===================================================================
// Stdlib.List.repeat - Repeat value n times
// ===================================================================

Stdlib.List.length(Stdlib.List.repeatUnsafe(5I, 42)) = 5I
Stdlib.List.length(Stdlib.List.repeatUnsafe(0I, 1)) = 0I
match Stdlib.List.repeatUnsafe(3I, 7) with | [a, b, c] -> a + b + c | _ -> 0 = 21

// ===================================================================
// Stdlib.List.indexedMap - Map with index
// ===================================================================

// Sum of index + value for [10, 20, 30] = (0+10) + (1+20) + (2+30) = 63
Stdlib.List.fold(Stdlib.List.indexedMap([10, 20, 30], fun i x -> Stdlib.Int64.add(x, Builtin.unwrap(Stdlib.Int.toInt64(i)))), 0, fun acc x -> acc + x) = 63
Stdlib.List.length(Stdlib.List.indexedMap([1, 2, 3, 4], fun i x -> x)) = 4I
// ===================================================================
// Stdlib.List.partition - Split list by predicate
// ===================================================================

match Stdlib.List.partition([1, 2, 3, 4, 5], fun x -> x > 2) with | (trues, falses) -> Stdlib.List.length(trues) | _ -> 0I = 3I
match Stdlib.List.partition([1, 2, 3, 4, 5], fun x -> x > 2) with | (trues, falses) -> Stdlib.List.length(falses) | _ -> 0I = 2I
// ===================================================================
// Stdlib.List.all - Check if all satisfy predicate (alias for forAll)
// ===================================================================

Stdlib.List.all([1, 2, 3], fun x -> x > 0) = true
Stdlib.List.all([1, 2, 3], fun x -> x > 2) = false

