// Stdlib.Math Tests
// Tests for Math module functions

// ===================================================================
// Stdlib.Math.pi - Pi constant
// ===================================================================

// Pi should be approximately 3.14159..., with an integer part of 3
Stdlib.Math.truncate(Stdlib.Math.pi()) = 3

// ===================================================================
// Stdlib.Math.tau - Circle constant equal to exactly twice pi
// ===================================================================

Stdlib.Math.tau() = 2.0 * Stdlib.Math.pi()

// ===================================================================
// Stdlib.Math.e - Euler's number constant
// ===================================================================

// e should be approximately 2.71828...
Stdlib.Math.truncate(Stdlib.Math.e()) = 2

// ===================================================================
// Stdlib.Math.abs - Absolute value of float
// ===================================================================

Stdlib.Math.truncate(Stdlib.Math.abs(5.0)) = 5
Stdlib.Math.truncate(Stdlib.Math.abs(-5.0)) = 5

// ===================================================================
// Stdlib.Math.sqrt - Square root
// ===================================================================

Stdlib.Math.truncate(Stdlib.Math.sqrt(4.0)) = 2
Stdlib.Math.truncate(Stdlib.Math.sqrt(9.0)) = 3
Stdlib.Math.truncate(Stdlib.Math.sqrt(16.0)) = 4

// ===================================================================
// Stdlib.Math.truncate - Truncate toward zero
// ===================================================================

Stdlib.Math.truncate(3.7) = 3
Stdlib.Math.truncate(-3.7) = -3
Stdlib.Math.truncate(0.0) = 0

// ===================================================================
// Stdlib.Math.floor - Floor function
// ===================================================================

Stdlib.Math.floor(3.7) = 3
Stdlib.Math.floor(3.0) = 3
Stdlib.Math.floor(-3.7) = -4
Stdlib.Math.floor(-3.0) = -3

// ===================================================================
// Stdlib.Math.ceiling - Ceiling function
// ===================================================================

Stdlib.Math.ceiling(3.7) = 4
Stdlib.Math.ceiling(3.0) = 3
Stdlib.Math.ceiling(-3.7) = -3
Stdlib.Math.ceiling(-3.0) = -3

// ===================================================================
// Stdlib.Math.round - Round to nearest, ties to even
// ===================================================================

Stdlib.Math.round(2.5) = 2
Stdlib.Math.round(3.5) = 4
Stdlib.Math.round(3.4) = 3
Stdlib.Math.round(3.0) = 3
Stdlib.Math.round(-2.5) = -2
Stdlib.Math.round(-3.5) = -4
Stdlib.Math.round(-3.4) = -3
Stdlib.Math.round(-3.0) = -3
