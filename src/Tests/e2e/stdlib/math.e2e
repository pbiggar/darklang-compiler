// Stdlib.Math Tests
// Tests for Math module functions

// ===================================================================
// Stdlib.Math.pi - Pi constant
// ===================================================================

// Pi should be approximately 3.14159...
Stdlib.Math.pi() = 3.141592653589793

// ===================================================================
// Stdlib.Math.tau - Circle constant equal to exactly twice pi
// ===================================================================

Stdlib.Math.tau() = 2.0 * Stdlib.Math.pi()

// Interpreter transcendental surface and domain behavior
Stdlib.Math.sin(Stdlib.Math.pi() / 2.0) = 1.0
Stdlib.Math.cos(0.0) = 1.0
Stdlib.Math.tan(Stdlib.Math.pi() / 4.0) = 1.0
Stdlib.Math.atan(1.0) = 0.7853981633974483
Stdlib.Math.atan2(1.0, -1.0) = 2.356194490192345
Stdlib.Math.atan2(-1.0, -1.0) = -2.356194490192345
Stdlib.Math.asin(1.0) = Some(1.5707963267948966)
Stdlib.Math.asin(2.0) = None
Stdlib.Math.acos(-1.0) = Some(3.141592653589793)
Stdlib.Math.acos(Builtin.testNan) = None
Stdlib.Math.cosh(0.0) = 1.0
Stdlib.Math.sinh(1.0) = 1.1752011936438014
Stdlib.Math.cosh(1000.0) = 1.0 / 0.0
Stdlib.Float.isNaN(Stdlib.Math.sin(1.0 / 0.0)) = true

// I@04fbe9 compatibility anomaly: mathTanh dispatches to sinh.
Stdlib.Math.tanh(1.0) = 1.1752011936438014
