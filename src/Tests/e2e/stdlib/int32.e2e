// Stdlib.Int32 Tests
// Ported from https://github.com/darklang/dark/tree/main/backend/testfiles/execution/stdlib
//
// Tests for Int32 module functions

// ===================================================================
// Stdlib.Int32.add - Add two integers
// ===================================================================

Stdlib.Int32.add(0l, 0l) = 0l
Stdlib.Int32.add(-5l, 5l) = 0l
Stdlib.Int32.add(100l, 200l) = 300l

// ===================================================================
// Stdlib.Int32.subtract - Subtract two integers
// ===================================================================

Stdlib.Int32.subtract(0l, 0l) = 0l
Stdlib.Int32.subtract(100l, 50l) = 50l
Stdlib.Int32.subtract(5l, 10l) = -5l

// ===================================================================
// Stdlib.Int32.multiply - Multiply two integers
// ===================================================================

Stdlib.Int32.multiply(0l, 100l) = 0l
Stdlib.Int32.multiply(-5l, 5l) = -25l
Stdlib.Int32.multiply(100l, 100l) = 10000l

// ===================================================================
// Stdlib.Int32.divide - Divide two integers
// ===================================================================

Stdlib.Int32.divide(10l, 3l) = 3l
Stdlib.Int32.divide(100l, 10l) = 10l
Stdlib.Int32.divide(-10l, 2l) = -5l

// ===================================================================
// Stdlib.Int32.mod - Modulo operation
// ===================================================================

Stdlib.Int32.mod(10l, 3l) = 1l
Stdlib.Int32.mod(100l, 7l) = 2l
Stdlib.Int32.mod(-10l, 3l) = 2l

// ===================================================================
// Stdlib.Int32.max - Maximum of two integers
// ===================================================================

Stdlib.Int32.max(6l, 5l) = 6l
Stdlib.Int32.max(-5l, -10l) = -5l
Stdlib.Int32.max(0l, 0l) = 0l

// ===================================================================
// Stdlib.Int32.min - Minimum of two integers
// ===================================================================

Stdlib.Int32.min(6l, 5l) = 5l
Stdlib.Int32.min(-5l, -10l) = -10l
Stdlib.Int32.min(0l, 0l) = 0l

// ===================================================================
// Stdlib.Int32.absoluteValue - Absolute value
// ===================================================================

Stdlib.Int32.absoluteValue(0l) = 0l
Stdlib.Int32.absoluteValue(-100l) = 100l

// ===================================================================
// Stdlib.Int32.negate - Negate an integer
// ===================================================================

Stdlib.Int32.negate(100l) = -100l

// ===================================================================
// Stdlib.Int32.power - Raise to a power
// ===================================================================

Stdlib.Int32.power(8l, 5l) = 32768l
Stdlib.Int32.power(2l, 10l) = 1024l
Stdlib.Int32.power(5l, 0l) = 1l
Stdlib.Int32.power(5l, 1l) = 5l
Stdlib.Int32.power(2l, 8l) = 256l
Stdlib.Int32.power(2l, -3l) = error="Uncaught exception: Cannot raise integer to a negative exponent"

// ===================================================================
// Stdlib.Int32.clamp - Clamp value between limits
// ===================================================================

Stdlib.Int32.clamp(1l, 0l, 5l) = 1l
Stdlib.Int32.clamp(10l, 5l, 15l) = 10l
Stdlib.Int32.clamp(0l, 5l, 10l) = 5l

// ===================================================================
// Stdlib.Int32.greaterThan - Greater than comparison
// ===================================================================

Stdlib.Int32.greaterThan(1l, 20l) = false
Stdlib.Int32.greaterThan(5l, 5l) = false

// ===================================================================
// Stdlib.Int32.greaterThanOrEqualTo - Greater than or equal comparison
// ===================================================================

Stdlib.Int32.greaterThanOrEqualTo(1l, 6l) = false
Stdlib.Int32.greaterThanOrEqualTo(5l, 5l) = true

// ===================================================================
// Stdlib.Int32.lessThan - Less than comparison
// ===================================================================

Stdlib.Int32.lessThan(8l, 6l) = false
Stdlib.Int32.lessThan(5l, 5l) = false

// ===================================================================
// Stdlib.Int32.lessThanOrEqualTo - Less than or equal comparison
// ===================================================================

Stdlib.Int32.lessThanOrEqualTo(8l, 6l) = false
Stdlib.Int32.lessThanOrEqualTo(5l, 5l) = true

// ===================================================================
// Stdlib.Int32.toString - Convert integer to string
// ===================================================================

Stdlib.Int32.toString(42l) = "42"
Stdlib.Int32.toString(-5l) = "-5"
Stdlib.Int32.toString(1234567890l) = "1234567890"

// ===================================================================
// Stdlib.Int32.isEven - Check if integer is even
// ===================================================================


// ===================================================================
// Stdlib.Int32.isOdd - Check if integer is odd
// ===================================================================


// ===================================================================
// Stdlib.Int32.sum - Sum all integers in a list
// ===================================================================

Stdlib.Int32.sum([1l, 2l, 3l, 4l, 5l]) = 15l
Stdlib.Int32.sum([]) = 0l
Stdlib.Int32.sum([100l]) = 100l
Stdlib.Int32.sum([1l, -1l, 2l, -2l]) = 0l
Stdlib.Int32.sum([10l, 20l, 30l]) = 60l

