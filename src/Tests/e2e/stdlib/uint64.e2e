// Stdlib.UInt64 Tests
// Ported from https://github.com/darklang/dark/tree/main/backend/testfiles/execution/stdlib
//
// Tests for UInt64 module functions

18446744073709551615UL = stdout="18446744073709551615\n"

// ===================================================================
// Stdlib.UInt64.add - Add two integers
// ===================================================================

Stdlib.UInt64.add(0UL, 0UL) = 0UL
Stdlib.UInt64.add(5UL, 5UL) = 10UL
Stdlib.UInt64.add(100UL, 200UL) = 300UL

// ===================================================================
// Stdlib.UInt64.subtract - Subtract two integers
// ===================================================================

Stdlib.UInt64.subtract(10UL, 0UL) = 10UL
Stdlib.UInt64.subtract(100UL, 50UL) = 50UL
Stdlib.UInt64.subtract(5UL, 0UL) = 5UL

// ===================================================================
// Stdlib.UInt64.multiply - Multiply two integers
// ===================================================================

Stdlib.UInt64.multiply(0UL, 100UL) = 0UL
Stdlib.UInt64.multiply(5UL, 5UL) = 25UL
Stdlib.UInt64.multiply(100UL, 100UL) = 10000UL

// ===================================================================
// Stdlib.UInt64.divide - Divide two integers
// ===================================================================

Stdlib.UInt64.divide(10UL, 3UL) = 3UL
Stdlib.UInt64.divide(100UL, 10UL) = 10UL
Stdlib.UInt64.divide(10UL, 2UL) = 5UL

// ===================================================================
// Stdlib.UInt64.mod - Modulo operation
// ===================================================================

Stdlib.UInt64.mod(10UL, 3UL) = 1UL
Stdlib.UInt64.mod(100UL, 7UL) = 2UL
Stdlib.UInt64.mod(20UL, 3UL) = 2UL

// ===================================================================
// Stdlib.UInt64.max - Maximum of two integers
// ===================================================================

Stdlib.UInt64.max(6UL, 5UL) = 6UL
Stdlib.UInt64.max(10UL, 20UL) = 20UL
Stdlib.UInt64.max(0UL, 0UL) = 0UL

// ===================================================================
// Stdlib.UInt64.min - Minimum of two integers
// ===================================================================

Stdlib.UInt64.min(6UL, 5UL) = 5UL
Stdlib.UInt64.min(10UL, 20UL) = 10UL
Stdlib.UInt64.min(0UL, 0UL) = 0UL

// ===================================================================
// Stdlib.UInt64.absoluteValue - Absolute value
// ===================================================================

Stdlib.UInt64.absoluteValue(5UL) = 5UL
Stdlib.UInt64.absoluteValue(0UL) = 0UL
Stdlib.UInt64.absoluteValue(100UL) = 100UL
Stdlib.UInt64.absoluteValue(1UL) = 1UL

// ===================================================================
// Stdlib.UInt64.negate - Negate an integer
// ===================================================================

Stdlib.UInt64.negate(0UL) = 0UL
Stdlib.UInt64.negate(1UL) = 18446744073709551615UL
Stdlib.UInt64.negate(5UL) = 18446744073709551611UL
Stdlib.UInt64.negate(100UL) = 18446744073709551516UL

// ===================================================================
// Stdlib.UInt64.power - Raise to a power
// ===================================================================

Stdlib.UInt64.power(2UL, 10UL) = 1024UL
Stdlib.UInt64.power(5UL, 0UL) = 1UL
Stdlib.UInt64.power(5UL, 1UL) = 5UL
Stdlib.UInt64.power(2UL, 8UL) = 256UL

// ===================================================================
// UInt64 bitwise operations
// ===================================================================

Stdlib.UInt64.shiftLeft(1UL, 4UL) = 16UL
Stdlib.UInt64.shiftRight(16UL, 4UL) = 1UL

// ===================================================================
// Stdlib.UInt64.clamp - Clamp value between limits
// ===================================================================

Stdlib.UInt64.clamp(5UL, 0UL, 5UL) = 5UL
Stdlib.UInt64.clamp(1UL, 0UL, 5UL) = 1UL
Stdlib.UInt64.clamp(10UL, 5UL, 15UL) = 10UL
Stdlib.UInt64.clamp(2UL, 5UL, 10UL) = 5UL

// ===================================================================
// Stdlib.UInt64.greaterThan - Greater than comparison
// ===================================================================

Stdlib.UInt64.greaterThan(1UL, 20UL) = false
Stdlib.UInt64.greaterThan(5UL, 5UL) = false

// ===================================================================
// Stdlib.UInt64.greaterThanOrEqualTo - Greater than or equal comparison
// ===================================================================

Stdlib.UInt64.greaterThanOrEqualTo(1UL, 6UL) = false
Stdlib.UInt64.greaterThanOrEqualTo(5UL, 5UL) = true

// ===================================================================
// Stdlib.UInt64.lessThan - Less than comparison
// ===================================================================

Stdlib.UInt64.lessThan(8UL, 6UL) = false
Stdlib.UInt64.lessThan(5UL, 5UL) = false
Stdlib.UInt64.lessThan(18446744073709551615UL, 10UL) = false

// ===================================================================
// Stdlib.UInt64.lessThanOrEqualTo - Less than or equal comparison
// ===================================================================

Stdlib.UInt64.lessThanOrEqualTo(8UL, 6UL) = false
Stdlib.UInt64.lessThanOrEqualTo(5UL, 5UL) = true
Stdlib.UInt64.lessThanOrEqualTo(18446744073709551615UL, 10UL) = false

// ===================================================================
// Stdlib.UInt64.toString - Convert integer to string
// ===================================================================

Stdlib.UInt64.toString(42UL) = "42"
Stdlib.UInt64.toString(5UL) = "5"
Stdlib.UInt64.toString(1234567890UL) = "1234567890"

// ===================================================================
// Stdlib.UInt64.isEven - Check if integer is even
// ===================================================================


// ===================================================================
// Stdlib.UInt64.isOdd - Check if integer is odd
// ===================================================================


// ===================================================================
// Stdlib.UInt64.sum - Sum all integers in a list
// ===================================================================

Stdlib.UInt64.sum([1UL, 2UL, 3UL, 4UL, 5UL]) = 15UL
Stdlib.UInt64.sum([]) = 0UL
Stdlib.UInt64.sum([100UL]) = 100UL
Stdlib.UInt64.sum([1UL, 1UL, 2UL, 2UL]) = 6UL
Stdlib.UInt64.sum([10UL, 20UL, 30UL]) = 60UL

