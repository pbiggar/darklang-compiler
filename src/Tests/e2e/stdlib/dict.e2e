// Stdlib.Dict Tests
// Tests for Dict module functions
//
// NOTE: Dict tests use String keys for simplicity since that's the most common use case.

// ===================================================================
// Stdlib.Dict.empty - Create empty dictionary
// ===================================================================

Stdlib.Dict.isEmpty<String, Int64>(Stdlib.Dict.empty<String, Int64>()) = true
Stdlib.Dict.size<String, Int64>(Stdlib.Dict.empty<String, Int64>()) = 0

// ===================================================================
// Stdlib.Dict.singleton - Create single-entry dictionary
// ===================================================================

Stdlib.Dict.size(Stdlib.Dict.singleton("key", 42)) = 1
Stdlib.Dict.isEmpty(Stdlib.Dict.singleton("key", 42)) = false
Stdlib.Option.withDefault(Stdlib.Dict.get(Stdlib.Dict.singleton("key", 42), "key"), 0) = 42

// ===================================================================
// Stdlib.Dict.set - Add/update entries
// ===================================================================

Stdlib.Option.withDefault(Stdlib.Dict.get(Stdlib.Dict.set(Stdlib.Dict.empty<String, Int64>(), "a", 1), "a"), 0) = 1
Stdlib.Dict.size(Stdlib.Dict.set(Stdlib.Dict.set(Stdlib.Dict.empty<String, Int64>(), "a", 1), "b", 2)) = 2

// ===================================================================
// Stdlib.Dict.get - Lookup values
// ===================================================================

Stdlib.Option.isNone<Int64>(Stdlib.Dict.get<String, Int64>(Stdlib.Dict.empty<String, Int64>(), "missing")) = true
Stdlib.Option.withDefault(Stdlib.Dict.get(Stdlib.Dict.singleton("hello", 100), "hello"), 0) = 100
Stdlib.Option.isNone<Int64>(Stdlib.Dict.get(Stdlib.Dict.singleton("hello", 100), "world")) = true

// ===================================================================
// Stdlib.Dict.member - Check if key exists
// ===================================================================

Stdlib.Dict.member(Stdlib.Dict.singleton("key", 42), "key") = true
Stdlib.Dict.member(Stdlib.Dict.singleton("key", 42), "other") = false
Stdlib.Dict.member<String, Int64>(Stdlib.Dict.empty<String, Int64>(), "any") = false

// ===================================================================
// Stdlib.Dict.remove - Remove entries
// ===================================================================

Stdlib.Dict.isEmpty(Stdlib.Dict.remove(Stdlib.Dict.singleton("key", 42), "key")) = true
Stdlib.Dict.member(Stdlib.Dict.remove(Stdlib.Dict.singleton("key", 42), "key"), "key") = false
Stdlib.Dict.size(Stdlib.Dict.remove(Stdlib.Dict.set(Stdlib.Dict.set(Stdlib.Dict.empty<String, Int64>(), "a", 1), "b", 2), "a")) = 1

// ===================================================================
// Stdlib.Dict.getOrDefault - Get with fallback
// ===================================================================

Stdlib.Dict.getOrDefault(Stdlib.Dict.singleton("key", 42), "key", 0) = 42
Stdlib.Dict.getOrDefault<String, Int64>(Stdlib.Dict.empty<String, Int64>(), "missing", 99) = 99
Stdlib.Dict.getOrDefault(Stdlib.Dict.singleton("hello", 100), "world", 50) = 50

// ===================================================================
// Stdlib.Dict.toList - Convert to list of pairs (alias for entries)
// ===================================================================

Stdlib.List.length(Stdlib.Dict.toList<String, Int64>(Stdlib.Dict.empty<String, Int64>())) = 0
Stdlib.List.length(Stdlib.Dict.toList(Stdlib.Dict.singleton("key", 42))) = 1
Stdlib.List.length(Stdlib.Dict.toList(Stdlib.Dict.set(Stdlib.Dict.set(Stdlib.Dict.empty<String, Int64>(), "a", 1), "b", 2))) = 2

// ===================================================================
// Stdlib.Dict.keys - Get all keys
// ===================================================================

Stdlib.List.length(Stdlib.Dict.keys<String, Int64>(Stdlib.Dict.empty<String, Int64>())) = 0
Stdlib.List.length(Stdlib.Dict.keys(Stdlib.Dict.singleton("key", 42))) = 1

// ===================================================================
// Stdlib.Dict.values - Get all values
// ===================================================================

Stdlib.List.length(Stdlib.Dict.values<String, Int64>(Stdlib.Dict.empty<String, Int64>())) = 0
Stdlib.List.length(Stdlib.Dict.values(Stdlib.Dict.singleton("key", 42))) = 1

// ===================================================================
// Stdlib.Dict.fromList - Build from list of pairs
// ===================================================================

Stdlib.Dict.size(Stdlib.Dict.fromList<String, Int64>([])) = 0
Stdlib.Dict.size(Stdlib.Dict.fromList([("a", 1), ("b", 2), ("c", 3)])) = 3
Stdlib.Option.withDefault(Stdlib.Dict.get(Stdlib.Dict.fromList([("x", 100)]), "x"), 0) = 100

// Mutation #137: Test Stdlib.Dict.fromList([]) with a unique type combination that has no
// corresponding Stdlib.Dict.empty call elsewhere. This ensures the Stdlib.Dict.fromList empty-list
// optimization correctly collects the Stdlib.Dict.empty specialization (uses || not &&).
Stdlib.Dict.isEmpty(Stdlib.Dict.fromList<Bool, String>([])) = true

// Mutation #138: Test Stdlib.Dict.fromList([]) with a unique type combination using
// the fully-qualified name. This ensures both branches of the || condition in the
// Stdlib.Dict.fromList empty-list optimization work correctly.
Stdlib.Dict.isEmpty(Stdlib.Dict.fromList<UInt8, UInt8>([])) = true

// ===================================================================
// Stdlib.Dict.merge - Combine dictionaries
// ===================================================================

Stdlib.Dict.size(Stdlib.Dict.merge(Stdlib.Dict.singleton("a", 1), Stdlib.Dict.singleton("b", 2))) = 2
// Second dict wins on conflicts
Stdlib.Option.withDefault(Stdlib.Dict.get(Stdlib.Dict.merge(Stdlib.Dict.singleton("key", 1), Stdlib.Dict.singleton("key", 2)), "key"), 0) = 2
