// Stdlib.Char Tests
// Tests for Char module functions

// ===================================================================
// Stdlib.Char.isDigit - Check if character is digit (0-9)
// ===================================================================

Stdlib.Char.isDigit('0') = true
Stdlib.Char.isDigit('5') = true
Stdlib.Char.isDigit('9') = true
Stdlib.Char.isDigit('a') = false
Stdlib.Char.isDigit('A') = false
Stdlib.Char.isDigit(' ') = false

// ===================================================================
// Stdlib.Char.isLetter - Check if character is letter (a-z, A-Z)
// ===================================================================

Stdlib.Char.isLetter('a') = true
Stdlib.Char.isLetter('z') = true
Stdlib.Char.isLetter('A') = true
Stdlib.Char.isLetter('Z') = true
Stdlib.Char.isLetter('0') = false
Stdlib.Char.isLetter(' ') = false

// ===================================================================
// Stdlib.Char.isWhitespace - Check if character is whitespace
// ===================================================================

Stdlib.Char.isWhitespace(' ') = true
Stdlib.Char.isWhitespace('\t') = true
Stdlib.Char.isWhitespace('\n') = true
Stdlib.Char.isWhitespace('a') = false
Stdlib.Char.isWhitespace('0') = false

// ===================================================================
// Stdlib.Char.isUppercase - Check if character is uppercase (A-Z)
// ===================================================================

Stdlib.Char.isUppercase('A') = true
Stdlib.Char.isUppercase('Z') = true
Stdlib.Char.isUppercase('a') = false
Stdlib.Char.isUppercase('z') = false
Stdlib.Char.isUppercase('0') = false

// ===================================================================
// Stdlib.Char.isLowercase - Check if character is lowercase (a-z)
// ===================================================================

Stdlib.Char.isLowercase('a') = true
Stdlib.Char.isLowercase('z') = true
Stdlib.Char.isLowercase('A') = false
Stdlib.Char.isLowercase('Z') = false
Stdlib.Char.isLowercase('0') = false

// ===================================================================
// Stdlib.Char.isAlphanumeric - Check if character is alphanumeric
// ===================================================================

Stdlib.Char.isAlphanumeric('a') = true
Stdlib.Char.isAlphanumeric('Z') = true
Stdlib.Char.isAlphanumeric('5') = true
Stdlib.Char.isAlphanumeric(' ') = false
Stdlib.Char.isAlphanumeric('!') = false

// ===================================================================
// Char ASCII classification
// ===================================================================

Stdlib.Char.isASCII('a') = true
Stdlib.Char.isASCII('A') = true
Stdlib.Char.isASCII('3') = true
Stdlib.Char.isASCII(' ') = true
Stdlib.Char.isASCII('\t') = true
Stdlib.Char.isASCII('á') = false
Stdlib.Char.isASCII('ჾ') = false
Stdlib.Char.isASCII('Ż') = false
Stdlib.Char.isASCII('😂') = false

Stdlib.Char.isASCIILetter('a') = true
Stdlib.Char.isASCIILetter('A') = true
Stdlib.Char.isASCIILetter('z') = true
Stdlib.Char.isASCIILetter('Z') = true
Stdlib.Char.isASCIILetter('á') = false
Stdlib.Char.isASCIILetter('3') = false
Stdlib.Char.isASCIILetter(',') = false
Stdlib.Char.isASCIILetter(' ') = false

// ===================================================================
// Char ordering by codepoint
// ===================================================================

Stdlib.Char.isLessThan('a', 'b') = true
Stdlib.Char.isLessThan('a', 'A') = false
Stdlib.Char.isLessThan('a', 'á') = true
Stdlib.Char.isLessThan('a', ' ') = false
Stdlib.Char.isLessThan('2', '1') = false

Stdlib.Char.isLessThanOrEqualTo('a', 'a') = true
Stdlib.Char.isLessThanOrEqualTo('a', 'b') = true
Stdlib.Char.isLessThanOrEqualTo('b', 'a') = false

Stdlib.Char.isGreaterThan('a', 'b') = false
Stdlib.Char.isGreaterThan('a', 'A') = true
Stdlib.Char.isGreaterThan('a', 'á') = false
Stdlib.Char.isGreaterThan('a', ' ') = true
Stdlib.Char.isGreaterThan('2', '1') = true

Stdlib.Char.isGreaterThanOrEqualTo('a', 'a') = true
Stdlib.Char.isGreaterThanOrEqualTo('b', 'a') = true
Stdlib.Char.isGreaterThanOrEqualTo('a', 'b') = false

// ===================================================================
// Stdlib.Char.toUppercase - Convert to uppercase
// ===================================================================

Stdlib.Char.toUppercase('a') = 'A'
Stdlib.Char.toUppercase('z') = 'Z'
Stdlib.Char.toUppercase('A') = 'A'
Stdlib.Char.toUppercase('5') = '5'
Stdlib.Char.toUppercase('á') = 'Á'
Stdlib.Char.toUppercase('ż') = 'Ż'
Stdlib.Char.toUppercase('ó') = 'Ó'
Stdlib.Char.toUppercase('ł') = 'Ł'
Stdlib.Char.toUppercase('ჾ') = 'Ჾ'

// ===================================================================
// Stdlib.Char.toLowercase - Convert to lowercase
// ===================================================================

Stdlib.Char.toLowercase('A') = 'a'
Stdlib.Char.toLowercase('Z') = 'z'
Stdlib.Char.toLowercase('a') = 'a'
Stdlib.Char.toLowercase('5') = '5'
Stdlib.Char.toLowercase('Á') = 'á'
Stdlib.Char.toLowercase('Ż') = 'ż'
Stdlib.Char.toLowercase('Ó') = 'ó'
Stdlib.Char.toLowercase('Ł') = 'ł'
Stdlib.Char.toLowercase('Ჾ') = 'ჾ'

// ===================================================================
// Stdlib.Char.toCode - Get codepoint value
// ===================================================================

Stdlib.Char.toCode('A') = 65
Stdlib.Char.toCode('a') = 97
Stdlib.Char.toCode('0') = 48
Stdlib.Char.toCode(' ') = 32
Stdlib.Char.toCode("") = exit=1 stderr="Uncaught exception: Char invariant violated: empty value"

// ===================================================================
// Stdlib.Char.fromCode - Create character from codepoint
// ===================================================================

Stdlib.Char.fromCode(65) = 'A'
Stdlib.Char.fromCode(97) = 'a'
Stdlib.Char.fromCode(48) = '0'
Stdlib.Char.fromCode(32) = ' '

// ===================================================================
// Stdlib.Char.toString - Identity conversion
// ===================================================================

Stdlib.Char.toString('A') = "A"
Stdlib.Char.toString('á') = "á"
Stdlib.Char.toString('😂') = "😂"
