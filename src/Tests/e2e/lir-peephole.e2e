// LIR Peephole Optimization Tests
//
// These tests exercise the LIR peephole optimizer, specifically:
// - TBZ/TBNZ fusion (AND with power-of-2 mask + branch)
// - Multiply-by-constant strength reduction
// - Loop invariant code motion (LICM)
// - Bit position calculations

// ===================================================================
// Bit Position Tests (exercises bitPosition function in LIR_Peephole)
// ===================================================================
// The bitPosition function calculates log2 of power-of-2 values
// and is used by TBZ/TBNZ optimization to determine which bit to test.
// These tests verify correct bit extraction at various positions.

// Test bit 0 extraction (power-of-2 mask = 1)
let testBit0(x: Int64) : Int64 =
  if (x & 1) == 0 then 0 else 1
testBit0(0) = 0
testBit0(1) = 1
testBit0(2) = 0
testBit0(3) = 1
testBit0(254) = 0
testBit0(255) = 1

// Test bit 1 extraction (power-of-2 mask = 2)
let testBit1(x: Int64) : Int64 =
  if (x & 2) == 0 then 0 else 1
testBit1(0) = 0
testBit1(1) = 0
testBit1(2) = 1
testBit1(3) = 1
testBit1(4) = 0
testBit1(5) = 0
testBit1(6) = 1
testBit1(7) = 1

// Test bit 2 extraction (power-of-2 mask = 4)
let testBit2(x: Int64) : Int64 =
  if (x & 4) == 0 then 0 else 1
testBit2(0) = 0
testBit2(3) = 0
testBit2(4) = 1
testBit2(7) = 1
testBit2(8) = 0
testBit2(12) = 1

// Test bit 3 extraction (power-of-2 mask = 8)
let testBit3(x: Int64) : Int64 =
  if (x & 8) == 0 then 0 else 1
testBit3(0) = 0
testBit3(7) = 0
testBit3(8) = 1
testBit3(15) = 1
testBit3(16) = 0
testBit3(24) = 1

// Test bit 4 extraction (power-of-2 mask = 16)
let testBit4(x: Int64) : Int64 =
  if (x & 16) == 0 then 0 else 1
testBit4(0) = 0
testBit4(15) = 0
testBit4(16) = 1
testBit4(31) = 1
testBit4(32) = 0
testBit4(48) = 1

// Test higher bit positions
let testBit7(x: Int64) : Int64 =
  if (x & 128) == 0 then 0 else 1
testBit7(0) = 0
testBit7(127) = 0
testBit7(128) = 1
testBit7(255) = 1
testBit7(256) = 0

// Test bit 8 (mask = 256)
let testBit8(x: Int64) : Int64 =
  if (x & 256) == 0 then 0 else 1
testBit8(0) = 0
testBit8(255) = 0
testBit8(256) = 1
testBit8(511) = 1
testBit8(512) = 0

// ===================================================================
// Combined Bit Operations
// ===================================================================
// These test multiple bit positions in sequence, exercising the
// bit position calculation multiple times.

// Extract multiple bits and combine them
let extractBits(x: Int64) : Int64 =
  let b0 = if (x & 1) == 0 then 0 else 1 in
  let b1 = if (x & 2) == 0 then 0 else 2 in
  let b2 = if (x & 4) == 0 then 0 else 4 in
  b0 + b1 + b2

extractBits(0) = 0
extractBits(1) = 1
extractBits(2) = 2
extractBits(3) = 3
extractBits(4) = 4
extractBits(5) = 5
extractBits(6) = 6
extractBits(7) = 7

// ===================================================================
// LICM with Bit Operations
// ===================================================================
// These tests combine LICM with bit testing to exercise multiple
// optimization passes together.

let loopWithBitTest(mask: Int64, n: Int64, acc: Int64) : Int64 =
  if n <= 0 then acc
  else
    // Loop-invariant bit test on mask
    let hasBit = if (mask & 4) == 0 then 0 else 10 in
    loopWithBitTest(mask, n - 1, acc + hasBit)

// mask=4 has bit 2 set, so hasBit=10, 5 iterations = 50
loopWithBitTest(4, 5, 0) = 50
// mask=3 doesn't have bit 2 set, so hasBit=0, 5 iterations = 0
loopWithBitTest(3, 5, 0) = 0
// mask=7 has bit 2 set, so hasBit=10, 3 iterations = 30
loopWithBitTest(7, 3, 0) = 30
// mask=0 doesn't have bit 2 set
loopWithBitTest(0, 10, 0) = 0

// ===================================================================
// Multiply-by-Constant Strength Reduction Tests
// ===================================================================
// The LIR peephole optimizer converts multiplication by constants
// of the form (2^n - 1) or (2^n + 1) to shift + add/sub sequences.
// For (2^n - 1): x * n = (x << shift) - x
// For (2^n + 1): x * n = (x << shift) + x
//
// Mutation #175 tests: if the subtraction in (x << shift) - x
// were changed to addition, multiply by 7, 15, 31, 63 would be wrong.

// Multiply by 7 (2^3 - 1 = 8 - 1)
// Correct: x * 7 = (x << 3) - x = 8x - x = 7x
// If mutated to +: (x << 3) + x = 8x + x = 9x (WRONG)
let mulBy7(x: Int64) : Int64 = x * 7
mulBy7(1) = 7
mulBy7(2) = 14
mulBy7(3) = 21
mulBy7(10) = 70
mulBy7(100) = 700

// Multiply by 15 (2^4 - 1 = 16 - 1)
let mulBy15(x: Int64) : Int64 = x * 15
mulBy15(1) = 15
mulBy15(2) = 30
mulBy15(3) = 45
mulBy15(10) = 150

// Multiply by 31 (2^5 - 1 = 32 - 1)
let mulBy31(x: Int64) : Int64 = x * 31
mulBy31(1) = 31
mulBy31(2) = 62
mulBy31(3) = 93
mulBy31(10) = 310

// Multiply by 63 (2^6 - 1 = 64 - 1)
let mulBy63(x: Int64) : Int64 = x * 63
mulBy63(1) = 63
mulBy63(2) = 126
mulBy63(3) = 189
mulBy63(10) = 630

// ===================================================================
// isPowerOf2 Tests (Mutation #176)
// ===================================================================
// The isPowerOf2 function checks if a value is a power of 2 for use in
// TBZ/TBNZ optimization. It uses `n > 0L && (n &&& (n - 1L)) = 0L`.
//
// Mutation #176 changes `n > 0L` to `n < 0L`, which would cause isPowerOf2
// to return false for all positive values. This is an "equivalent mutant"
// because the TBZ/TBNZ optimization is purely a performance optimization -
// when isPowerOf2 returns false, the code falls back to AND + CBZ/CBNZ
// which produces identical results.
//
// The tests below exercise code paths that use isPowerOf2 through the
// TBZ/TBNZ optimization. While they pass with or without the optimization,
// they document the intended behavior.

// Power-of-2 mask values that trigger TBZ/TBNZ when isPowerOf2 works
// These masks are: 1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024
let checkPowerOf2Mask1(x: Int64) : Int64 =
  if (x & 1) != 0 then 1 else 0
checkPowerOf2Mask1(0) = 0
checkPowerOf2Mask1(1) = 1
checkPowerOf2Mask1(2) = 0
checkPowerOf2Mask1(3) = 1

let checkPowerOf2Mask512(x: Int64) : Int64 =
  if (x & 512) != 0 then 1 else 0
checkPowerOf2Mask512(0) = 0
checkPowerOf2Mask512(511) = 0
checkPowerOf2Mask512(512) = 1
checkPowerOf2Mask512(1023) = 1
checkPowerOf2Mask512(1024) = 0

let checkPowerOf2Mask1024(x: Int64) : Int64 =
  if (x & 1024) != 0 then 1 else 0
checkPowerOf2Mask1024(0) = 0
checkPowerOf2Mask1024(1023) = 0
checkPowerOf2Mask1024(1024) = 1
checkPowerOf2Mask1024(2047) = 1
checkPowerOf2Mask1024(2048) = 0

// ===================================================================
// Mutation #177 Tests - LOGIC_AND in multiply-by-constant guard
// ===================================================================
// The tryMulByConstant optimization has a guard condition that checks:
//   sameReg constReg mulRight && not (sameReg constReg mulLeft)
// This ensures the constant is only on one side of the multiply.
//
// If && is changed to ||, the optimization would incorrectly fire when:
// 1. The constant register is used on BOTH sides (x * x where x = constant)
// 2. This would produce wrong results because strength reduction assumes
//    one operand is the constant and one is the variable to transform.
//
// Test: Square a constant that matches the strength reduction pattern.
// 7 * 7 = 49 (correct), but if mutation applies optimization thinking
// it's x * 7, it would compute (7 << 3) - 7 = 56 - 7 = 49 (accidentally correct)
// So we need a case where the optimization would produce a different result.
//
// Actually, let's test the pattern matching itself: if the guard is wrong,
// the optimizer might try to transform when it shouldn't, potentially
// causing incorrect register usage or wrong arithmetic.

// Test multiply by same constant on both sides - this should NOT use
// strength reduction because both operands are the same constant
let squareConst7() : Int64 = 7 * 7
squareConst7() = 49

let squareConst15() : Int64 = 15 * 15
squareConst15() = 225

let squareConst31() : Int64 = 31 * 31
squareConst31() = 961

// Test that nested expressions with strength-reduction constants work correctly
// These create more complex patterns that could confuse a buggy optimizer
let nestedMul7(x: Int64) : Int64 = (x * 7) * 7
nestedMul7(1) = 49
nestedMul7(2) = 98
nestedMul7(3) = 147

let nestedMul15(x: Int64) : Int64 = (x * 15) * 15
nestedMul15(1) = 225
nestedMul15(2) = 450
nestedMul15(3) = 675

// Test multiply where both operands come from the same expression
// This creates a scenario where registers might be reused
let selfMulPattern(x: Int64) : Int64 =
  let y = x + 1 in
  let z = y * 7 in  // strength reduction: (y << 3) - y
  z * z             // should NOT use strength reduction here
selfMulPattern(1) = 196   // (1+1)*7 = 14, 14*14 = 196
selfMulPattern(2) = 441   // (2+1)*7 = 21, 21*21 = 441

// Test mixing strength-reducible and non-reducible multiplies
let mixedMul(x: Int64) : Int64 =
  let a = x * 7 in    // strength reducible
  let b = x * 11 in   // NOT strength reducible (11 is not 2^n ± 1)
  a + b
mixedMul(1) = 18      // 7 + 11 = 18
mixedMul(10) = 180    // 70 + 110 = 180

// ===================================================================
// Mutation #178 Tests - LOGIC_AND in commutative multiply-by-constant guard
// ===================================================================
// The tryMulByConstant optimization has a second pattern for the commutative case:
//   sameReg constReg mulLeft && not (sameReg constReg mulRight)
// This checks if the constant is on the LEFT side of the multiply.
//
// If && is changed to ||, the guard becomes:
//   sameReg constReg mulLeft || not (sameReg constReg mulRight)
//
// This would fire when EITHER condition is true. The second condition
// `not (sameReg constReg mulRight)` is TRUE whenever the constant register
// is not used on the right side of the multiply - which is almost always!
//
// This means the optimization would incorrectly fire when:
// - A constant 7 (or similar pattern) is defined but NOT used in a multiply
// - A separate multiply x * y follows (where neither x nor y is the constant)
// - The buggy optimizer would transform x * y into y * 7 because it thinks
//   the constant applies to this multiply!
//
// Test: Define a strength-reduction constant (7) but DON'T use it in the multiply.
// Then do a completely separate multiply. With the mutation, this would produce
// wrong results because the optimizer incorrectly applies the 7 optimization.

let testMutation178_separateConstant(x: Int64, y: Int64) : Int64 =
  let seven = 7 in        // Creates: Mov tempReg, 7
  let result = x * y in   // Creates: Mul dest, xReg, yReg (neither is tempReg!)
  result + seven          // Use seven so it's not optimized away

// With correct code:   x * y + 7 = 2*3 + 7 = 13
// With mutation:       y * 7 + 7 = 3*7 + 7 = 28 (WRONG - applies 7 optimization to x*y)
testMutation178_separateConstant(2, 3) = 13
testMutation178_separateConstant(5, 4) = 27    // 5*4 + 7 = 27
testMutation178_separateConstant(10, 10) = 107 // 10*10 + 7 = 107

// Additional test with different strength-reduction constants
let testMutation178_with15(x: Int64, y: Int64) : Int64 =
  let fifteen = 15 in     // Creates: Mov tempReg, 15
  let result = x * y in   // Creates: Mul dest, xReg, yReg
  result + fifteen

// With correct code:   x * y + 15 = 3*4 + 15 = 27
// With mutation:       y * 15 + 15 = 4*15 + 15 = 75 (WRONG)
testMutation178_with15(3, 4) = 27
testMutation178_with15(2, 5) = 25    // 2*5 + 15 = 25

// Test where x == y to ensure we're testing the right path
let testMutation178_sameArgs(x: Int64) : Int64 =
  let seven = 7 in
  let result = x * x in   // Square, not multiply by 7!
  result + seven

testMutation178_sameArgs(3) = 16     // 3*3 + 7 = 16
testMutation178_sameArgs(5) = 32     // 5*5 + 7 = 32
testMutation178_sameArgs(10) = 107   // 10*10 + 7 = 107

// ===================================================================
// Mutation #179 Tests - LOGIC_AND in MUL+ADD fusion guard
// ===================================================================
// The tryFuseMulAdd optimization fuses MUL temp, a, b; ADD dest, temp, c
// into MADD dest, a, b, c. The guard condition is:
//   sameReg mulDest addLeft && not (sameReg mulDest addRight)
// This ensures the MUL result (temp) is on the LEFT of the ADD.
//
// If && is changed to ||, the guard becomes:
//   sameReg mulDest addLeft || not (sameReg mulDest addRight)
//
// This would fire when EITHER:
// - The MUL result is on the left of ADD, OR
// - The MUL result is NOT on the right of ADD
//
// The second condition is true for almost any MUL+ADD pair!
// This means the optimization would incorrectly transform:
//   MUL temp, a, b      // temp = a * b
//   ADD dest, x, Reg y  // dest = x + y (where x,y != temp)
// into:
//   MADD dest, a, b, y  // dest = a*b + y (WRONG! should be x + y)
//
// Test: Create a MUL followed by an ADD that uses different registers.
// The MUL result should NOT influence the ADD result.

let testMutation179_independentMulAdd(a: Int64, b: Int64, x: Int64, y: Int64) : Int64 =
  let mulResult = a * b in   // Creates: MUL temp, aReg, bReg
  let addResult = x + y in   // Creates: ADD dest, xReg, yReg (NOT temp!)
  addResult + mulResult      // Use both to prevent dead code elimination

// With correct code:   (x + y) + (a * b) = (3 + 4) + (2 * 5) = 7 + 10 = 17
// With mutation:       (a*b + y) + (a * b) = (10 + 4) + 10 = 24 (WRONG)
testMutation179_independentMulAdd(2, 5, 3, 4) = 17
testMutation179_independentMulAdd(3, 7, 10, 20) = 51    // (10+20) + (3*7) = 30 + 21 = 51
testMutation179_independentMulAdd(1, 1, 100, 200) = 301 // (100+200) + (1*1) = 300 + 1 = 301

// Additional test with larger values to make the difference more obvious
let testMutation179_largeValues(a: Int64, b: Int64, x: Int64, y: Int64) : Int64 =
  let product = a * b in
  let sum = x + y in
  sum * 2 + product      // Use both results

// With correct code:   (x + y) * 2 + (a * b) = (5 + 3) * 2 + (4 * 6) = 16 + 24 = 40
testMutation179_largeValues(4, 6, 5, 3) = 40
testMutation179_largeValues(10, 10, 1, 2) = 106  // (1+2)*2 + 10*10 = 6 + 100 = 106

// Test where the MUL result is used elsewhere but not in the immediate ADD
let testMutation179_delayedUse(a: Int64, b: Int64, x: Int64, y: Int64) : Int64 =
  let mul1 = a * b in      // MUL temp1, a, b
  let add1 = x + y in      // ADD dest1, x, y (independent of mul1!)
  let add2 = add1 + mul1 in // Now use both
  add2

testMutation179_delayedUse(2, 3, 10, 20) = 36   // (10+20) + (2*3) = 30 + 6 = 36
testMutation179_delayedUse(5, 5, 7, 8) = 40     // (7+8) + (5*5) = 15 + 25 = 40
