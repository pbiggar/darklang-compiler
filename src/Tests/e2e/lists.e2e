// =====================================================
// Lists of Tuples
// =====================================================

// List of 2-tuples
match [(1L, 2L), (3L, 4L)] with | [t1, t2] -> t1.0 + t2.1 | _ -> 0L = 5L

// List of 2-tuples - product
match [(2L, 3L), (4L, 5L)] with | [t1, t2] -> t1.0 * t1.1 + t2.0 * t2.1 | _ -> 0L = 26L

// Single tuple in list
match [(10L, 20L)] with | [t] -> t.0 + t.1 | _ -> 0L = 30L

// Recursive list construction with tuple elements
let makePairs(n: Int64) : List<(Int64, Int64)> =
    if n <= 0L then
        []
    else
        Stdlib.List.push<(Int64, Int64)>(makePairs(n - 1L), (n, n + 1L))

let pairs = makePairs(1L) in match pairs with | [(a, b)] -> a + b | _ -> 999L = 3L

// Tuple pattern destructuring in list with non-commutative operation
// This test ensures tuple element indices are extracted correctly (kills mutation #61)
match [(10L, 3L)] with | [(a, b)] -> a - b | _ -> 0L = 7L

// Three-element tuple in list with subtraction to verify correct index ordering
match [(100L, 40L, 7L)] with | [(a, b, c)] -> a - b - c | _ -> 0L = 53L

// Tuple arity mismatch under a guard should not bind missing elements as Int64 defaults.
// This pattern cannot match a 2-tuple list element and must fall through.
match [(1L, 2L)] with | [(a, b, c)] when true -> 1L = error="Non-exhaustive match expression"

// List of float tuples
match [(1.0, 2.5), (3.5, 4.0)] with | [t1, t2] -> t1.0 + t1.1 + t2.0 + t2.1 | _ -> 0.0 = 11.0

// Float tuple comparison inside list
match [("a", 0.5)] with | [t] -> if t.1 < 0.6 then 1L else 0L | _ -> 0L = 1L

// Cumulative float tuple selection in list
let makeCumulative(table: List<(Int64, Float)>, running: Float) : List<(Int64, Float)> = match Stdlib.List.head<(Int64, Float)>(table) with | None -> [] | Some(item) -> let c = Stdlib.Tuple2.first<Int64, Float>(item) in let p = Stdlib.Tuple2.second<Int64, Float>(item) in let newRunning = running + p in match Stdlib.List.tail<(Int64, Float)>(table) with | None -> [(c, newRunning)] | Some(rest) -> Stdlib.List.push<(Int64, Float)>(makeCumulative(rest, newRunning), (c, newRunning)) let selectRandom(table: List<(Int64, Float)>, r: Float, idx: Int) : Int64 = match Stdlib.List.getAt(table, idx) with | None -> 0L | Some(item) -> let c = Stdlib.Tuple2.first(item) in let p = Stdlib.Tuple2.second(item) in if r < p then c else if idx + 1I >= Stdlib.List.length(table) then c else selectRandom(table, r, idx + 1I) let table = [(97L, 0.27), (99L, 0.12), (103L, 0.12), (116L, 0.27)] in let cumulative = makeCumulative(table, 0.0) in let newSeed = (1L * 3877L + 29573L) % 139968L in let r = Stdlib.Int64.toFloat(newSeed) / 139968.0 in selectRandom(cumulative, r, 0I) = 97L
// =====================================================
// Lists of Strings
// =====================================================

// List of strings - basic
match ["hello", "world"] with | [a, b] -> a ++ " " ++ b | _ -> "" = "hello world"

// Single string in list
match ["test"] with | [s] -> s | _ -> "" = "test"

// Three strings
match ["a", "b", "c"] with | [x, y, z] -> x ++ y ++ z | _ -> "" = "abc"

// =====================================================
// Lists of Bools
// =====================================================

// List of bools - all true
match [true, true, true] with | [a, b, c] -> if a && b && c then 1L else 0L | _ -> -1L = 1L

// List of bools - mixed
match [true, false] with | [a, b] -> if a && b then 1L else 0L | _ -> -1L = 0L

// =====================================================
// Recursive Functions on Complex Element Types
// =====================================================

// Sum list of floats recursively
// DISABLED (same float list bug): let sumFloats(xs: List<Float>) : Float = match xs with | [] -> 0.0 | h :: t -> h + sumFloats(t)
// DISABLED: sumFloats([1.0, 2.0, 3.0, 4.0]) = stdout="10.00\n"

// Concatenate list of strings
let concatStrings(xs: List<String>) : String = match xs with | [] -> "" | h :: t -> h ++ concatStrings(t)
concatStrings(["a", "b", "c"]) = "abc"

// =====================================================
// Middle Spine Access Tests (6+ element lists)
// =====================================================
// For lists with 6+ elements, elements 2-3 are stored in the middle spine
// (a NODE2 or NODE3). These tests verify the tree measure is correctly
// calculated for navigating to middle elements.

// Access element at index 2 (first element in middle NODE2)
Stdlib.Option.withDefault(Stdlib.List.getAt([1L, 2L, 3L, 4L, 5L, 6L], 2I), 0L) = 3L

// Access element at index 3 (second element in middle NODE2)
Stdlib.Option.withDefault(Stdlib.List.getAt([1L, 2L, 3L, 4L, 5L, 6L], 3I), 0L) = 4L

// =====================================================
// DEEP node element extraction offset tests (kills mutation #69)
// =====================================================
// These tests verify that elements are extracted from the correct offsets
// in the former deep-tree lowering. The mutation changed the offset calculation
// from `64 + (idx-1)*8` to `64 - (idx-1)*8`, causing wrong element access.

// 4-element list - verify third element (idx=2) is correct using subtraction
// idx=0: offset 16 (p0), idx=1: offset 64 (s0), idx=2: offset 72 (s1), idx=3: offset 80 (s2)
// With mutation: idx=2 would read from 56 (wrong), idx=3 would read from 48 (wrong)
match [100L, 200L, 300L, 400L] with | [a, b, c, d] -> c - d | _ -> 999L = -100L

// 5-element list - verify fourth element (idx=3) is correct
match [10L, 20L, 30L, 40L, 50L] with | [a, b, c, d, e] -> d - e | _ -> 999L = -10L

// Alternative: verify element ordering with non-commutative expression
match [1000L, 100L, 10L, 1L] with | [a, b, c, d] -> a - b - c - d | _ -> 999L = 889L

// =====================================================
// Wildcard index increment test (kills mutation #71)
// =====================================================
// Tests that wildcard patterns correctly increment the index
// when extracting subsequent elements from DEEP lists.
// If idx + 1 were changed to idx - 1 in the wildcard case,
// element 'c' would be extracted from wrong offset.
match [100L, 200L, 300L, 400L] with | [_, _, c, d] -> c - d | _ -> 999L = -100L

// =====================================================
// Tuple destructuring index increment test (kills mutation #72)
// =====================================================
// Tests that tuple pattern destructuring correctly increments the index
// when extracting subsequent elements from DEEP lists containing tuples.
// If idx + 1 were changed to idx - 1 in the PTuple case,
// element (c, d) would be extracted from the wrong offset.
match [(10L, 1L), (20L, 2L), (30L, 3L), (40L, 4L)] with | [(a, b), (c, d), (e, f), (g, h)] -> g - h | _ -> 999L = 36L

// =====================================================
// Wildcard inside tuple inside list pattern (kills mutation #76)
// =====================================================
// Tests that wildcards inside tuple patterns correctly increment the index
// when extracting subsequent elements within collectTupleBindings.
// If idx + 1 were changed to idx - 1 in the PWildcard case inside collectTupleBindings,
// the element 'b' would be extracted from wrong tuple index.
match [(100L, 37L)] with | [(_, b)] -> b | _ -> 999L = 37L

// Three-element tuple with wildcard at start
match [(50L, 25L, 10L)] with | [(_, b, c)] -> b - c | _ -> 999L = 15L

// Wildcard in middle of tuple inside list
match [(1L, 2L, 3L)] with | [(a, _, c)] -> a + c | _ -> 999L = 4L

// =====================================================
// Tuple binding index increment test (kills mutation #77)
// =====================================================
// Tests that binding multiple tuple elements correctly increments the index
// when extracting subsequent elements in collectTupleBindings.
// If idx + 1 were changed to idx - 1 in the PVar case inside collectTupleBindings,
// the elements would be extracted from wrong tuple indices after the first.
match [(100L, 10L, 7L)] with | [(a, b, c)] -> a - b - c | _ -> 999L = 83L

// Four-element tuple - verify third and fourth element indices are correct
match [(1000L, 100L, 10L, 1L)] with | [(a, b, c, d)] -> a - b - c - d | _ -> 999L = 889L

// =====================================================
// Wildcard inside tuple inside list cons pattern (kills mutation #78)
// =====================================================
// Tests that wildcards inside tuple patterns correctly increment the index
// when extracting subsequent elements in collectTupleBindings within collectListConsBindings.
// This is specifically for list cons patterns like (a, _, c) :: rest where the head
// element is a tuple containing wildcards.
// If idx + 1 were changed to idx - 1 in the PWildcard case inside the nested collectTupleBindings
// (within collectListConsBindings), the element after the wildcard would be extracted from wrong index.
match [(100L, 50L, 7L), (1L, 2L, 3L)] with | (a, _, c) :: rest -> a - c | [] -> 999L = 93L

// Verify with more elements after the wildcard in tuple inside cons pattern
match [(1000L, 500L, 100L, 10L), (1L, 2L, 3L, 4L)] with | (a, _, c, d) :: rest -> a - c - d | [] -> 999L = 890L

// =====================================================
// Tuple destructuring in multi-element list patterns (kills mutation #87)
// =====================================================
// Tests that tuple element extraction correctly increments the index
// when processing tuple patterns inside multi-element list patterns via
// compileListPatternWithChecks -> extractElements -> extractTupleBindings.
// If idx + 1 were changed to idx - 1, the second element of each tuple
// would be extracted from the wrong index.

// 2-element list of 2-tuples - verify correct tuple element indexing
// b should be 37 (index 1), d should be 13 (index 1)
// With mutation: b would read from index -1 or 0, getting wrong value
match [(100L, 37L), (50L, 13L)] with | [(a, b), (c, d)] -> b - d | _ -> 999L = 24L

// 3-element list of 2-tuples - verify index increment across multiple tuple elements
match [(100L, 10L), (200L, 20L), (300L, 30L)] with | [(a, b), (c, d), (e, f)] -> b - d - f | _ -> 999L = -40L

// 2-element list of 3-tuples - verify third element uses correct index
match [(1000L, 100L, 10L), (500L, 50L, 5L)] with | [(a, b, c), (d, e, f)] -> c - f | _ -> 999L = 5L

// =====================================================
// Wildcard in tuple within multi-element list patterns (kills mutation #88)
// =====================================================
// Tests that wildcard patterns inside tuples correctly increment the index
// when processing tuple patterns inside multi-element list patterns via
// compileListPatternWithChecks -> extractElements -> extractTupleBindings.
// The PWildcard case must increment idx + 1 to extract subsequent elements.
// If idx + 1 were changed to idx - 1, the element after the wildcard would
// be extracted from the wrong tuple index.

// 2-element list of 2-tuples with wildcard in first tuple
// b should be 37 (tuple index 1 of first list element)
// With mutation: b would read from index -1 or 0, getting wrong value
match [(100L, 37L), (50L, 13L)] with | [(_, b), (c, d)] -> b - d | _ -> 999L = 24L

// 2-element list of 3-tuples with wildcard, then extraction
// c should be 10 (tuple index 2), f should be 5 (tuple index 2)
// With mutation: c would read from wrong index after the wildcard
match [(1000L, 100L, 10L), (500L, 50L, 5L)] with | [(_, b, c), (d, e, f)] -> c - f | _ -> 999L = 5L

// Multiple wildcards in tuples within multi-element list
// Verifies index increments correctly through multiple wildcards
match [(1000L, 100L, 10L, 1L), (500L, 50L, 5L, 0L)] with | [(_, _, c, d), (_, _, g, h)] -> c - g + d - h | _ -> 999L = 6L

// =====================================================
// groupSizes nodeCount % 3 == 1 test (kills mutation #90)
// =====================================================
// Tests that groupSizes correctly calculates (nodeCount - 4) / 3 for
// middle spine nodes when nodeCount % 3 == 1 (i.e., 4, 7, 10, ... nodes).
// For an 8-element list: prefix=2, suffix=2, middle=4 nodes.
// With 4 middle nodes (4 % 3 == 1), groupSizes returns [2, 2].
// If - 4 were changed to + 4, groupSizes would return [2, 2, 3, 3]
// expecting 10 nodes but only having 4, causing incorrect tree construction.
// The 8th element (at index 7) would not be accessible if tree is malformed.
Stdlib.Option.withDefault(Stdlib.List.getAt([10L, 20L, 30L, 40L, 50L, 60L, 70L, 80L], 7I), 0L) = 80L

// =====================================================
// groupSizes nodeCount % 3 == 2 test (kills mutation #91)
// =====================================================
// Tests that groupSizes correctly calculates (nodeCount - 2) / 3 for
// middle spine nodes when nodeCount % 3 == 2 (i.e., 2, 5, 8, 11, ... nodes).
// For a 9-element list: prefix=2, suffix=2, middle=5 nodes.
// With 5 middle nodes (5 % 3 == 2), groupSizes returns [2, 3] (one NODE2 + one NODE3).
// If - 2 were changed to + 2, groupSizes would return [2, 3, 3]
// expecting 8 nodes but only having 5, causing incorrect tree construction.
// The 9th element (at index 8) would not be accessible if tree is malformed.
Stdlib.Option.withDefault(Stdlib.List.getAt([10L, 20L, 30L, 40L, 50L, 60L, 70L, 80L, 90L], 8I), 0L) = 90L

// =====================================================
// Nested list pattern element extraction test (kills mutation #92)
// =====================================================
// Tests that exact nested list patterns extract elements in order.
// calculates offsets when a list pattern appears inside a constructor payload.
// The extractElements function in extractAndCompileBody uses idx - 1 to
// compute suffix slot offsets: 64 + (idx-1)*8 for s0, s1, s2, s3.
// If idx - 1 were changed to idx + 1, the second element onwards would
// be extracted from wrong offsets (e.g., idx=1 would read s2 instead of s0).
type WrappedList = NoList | WrapList of List<Int64>
match WrapList([100L, 200L, 300L, 400L]) with | WrapList([a, b, c, d]) -> c - d | NoList -> 999L = -100L

// =====================================================
// Nested list offset multiplication test (kills mutation #105)
// =====================================================
// Tests that the offset calculation `64L + (int64 (idx - 1) * 8L)` uses
// multiplication, not division. If * were changed to /, all elements after
// the first would read from offset 64 (the second element's slot), since
// integer division of small numbers by 8 yields 0.
// For a 5-element list in a constructor payload:
// - idx=0: offset 16 (p0)
// - idx=1: offset 64 + (0 * 8) = 64 (s0)
// - idx=2: offset 64 + (1 * 8) = 72 (s1) -- with / this becomes 64 + 0 = 64
// - idx=3: offset 64 + (2 * 8) = 80 (s2) -- with / this becomes 64 + 0 = 64
// - idx=4: offset 64 + (3 * 8) = 88 (s3) -- with / this becomes 64 + 0 = 64
// Sum of c+d+e with correct offsets: 30+40+50 = 120
// Sum of c+d+e with / mutation: 20+20+20 = 60 (all read from s0)
type WrappedList5 = NoList5 | WrapList5 of List<Int64>
match WrapList5([10L, 20L, 30L, 40L, 50L]) with | WrapList5([a, b, c, d, e]) -> c + d + e | NoList5 -> 999L = 120L

// =====================================================
// groupSizes nodeCount % 3 == 0 test (kills mutation #108)
// =====================================================
// Tests that groupSizes correctly calculates nodeCount / 3 for
// middle spine nodes when nodeCount % 3 == 0 (i.e., 3, 6, 9, ... nodes).
// For a 7-element list: prefix=2, suffix=2, middle=3 nodes.
// With 3 middle nodes (3 % 3 == 0), groupSizes returns [3] (one NODE3).
// If / were changed to *, groupSizes would return [3, 3, 3, 3, 3, 3, 3, 3, 3]
// expecting 27 nodes but only having 3, causing incorrect tree construction.
// The 7th element (at index 6) would not be accessible if tree is malformed.
Stdlib.Option.withDefault(Stdlib.List.getAt([10L, 20L, 30L, 40L, 50L, 60L, 70L], 6I), 0L) = 70L

// =====================================================
// groupSizes nodeCount % 3 == 0 in toAtom (kills mutation #109)
// =====================================================
// Tests the second occurrence of nodeCount / 3 in the toAtom function
// for list literals used as arguments. This exercises the toAtom code path
// distinct from toANF. A 7-element list has 3 middle nodes (3 % 3 == 0).
// If / were changed to *, the list construction would fail trying to
// create 9 groups of 3 from only 3 middle nodes.
// Uses a variable to ensure the list is compiled via toAtom as an argument.
let xs = [10L, 20L, 30L, 40L, 50L, 60L, 70L] in Stdlib.Option.withDefault(Stdlib.List.getAt(xs, 6I), 0L) = 70L

// =====================================================
// Single-element list cons pattern empty check (kills mutation #119)
// =====================================================
// Tests that the notEmpty check in compileSingleBranch correctly uses <> (not =)
// when checking if a single-element list is non-empty. The SINGLE branch handles
// lists with exactly one element and must correctly identify them as non-empty.
// If the <> 0 check were changed to = 0, the cons pattern would incorrectly
// treat single-element lists as empty and fall through to the [] branch.
//
// Key test: A single-element list matched with h :: t should extract h,
// not fall through to the empty list case.
let checkSingle119(xs: List<Int64>) : Int64 =
    match xs with
    | [] -> 0L
    | h :: t -> h + 1000L

// Single-element list should match h :: t, returning head + 1000
checkSingle119([42L]) = 1042L

// Empty list should match [], returning 0
checkSingle119([]) = 0L

// Multi-element list should also match h :: t
checkSingle119([10L, 20L, 30L]) = 1010L

// =====================================================
// List cons pattern guard check (kills mutation #120)
// =====================================================
// Tests that the guard condition for list cons patterns correctly uses <> (not =)
// when checking if the list is not nil. This guard is generated in compileListConsGuard
// for patterns like h :: t which require at least one element.
// If the <> 0 check were changed to = 0, the cons pattern would incorrectly
// match empty lists and reject non-empty lists.
//
// This test specifically exercises the pattern guard generation path which is
// distinct from the compileSingleBranch notEmpty check tested by mutation #119.
// The guard check is used when the cons pattern is one of multiple alternatives
// in a match expression.

// Test with multiple match cases where cons pattern is NOT the first case
// This ensures the guard check is properly evaluated
let checkGuard120(xs: List<Int64>) : Int64 =
    match xs with
    | [] -> 100L
    | h :: t -> h + 200L

// Non-empty list should match cons pattern, returning head + 200
checkGuard120([50L]) = 250L
checkGuard120([1L, 2L, 3L]) = 201L

// Empty list should match [], returning 100
checkGuard120([]) = 100L

// Test with cons pattern as first alternative to exercise guard check path
let checkGuardFirst120(xs: List<Int64>) : Int64 =
    match xs with
    | h :: t -> h + 300L
    | [] -> 400L

// Non-empty list should match cons pattern
checkGuardFirst120([99L]) = 399L
checkGuardFirst120([5L, 10L, 15L]) = 305L

// Empty list should fall through to [] pattern
checkGuardFirst120([]) = 400L

// =====================================================
// Variable used only in list cons tail (kills mutation #141)
// =====================================================
// Tests that varOccursInExpr correctly uses || (not &&) when checking
// if a variable occurs in a ListCons expression. The check is:
//   Stdlib.List.exists (varOccursInExpr name) headElements || varOccursInExpr name tail
// If || were changed to &&, a variable appearing only in the tail would be
// incorrectly considered as not occurring, causing dead code elimination
// to remove the let binding.
//
// This test uses a variable only in the tail of the list cons 1 :: xs.
// The variable xs must be recognized as used; otherwise the compiler would
// eliminate the let binding and produce incorrect code.
let xs = [42L] in match [1L] @ xs with | [a, b] -> a + b | _ -> 0L = 43L

// List<Float> cons destructuring must preserve the floating-point representation
// for heads extracted from both singleton and multi-element skew lists.
let sumFloatList(xs: List<Float>) : Float =
    match xs with
    | [] -> 0.0
    | head :: tail -> head + sumFloatList(tail)

Stdlib.Float.toInt(sumFloatList([1.5, 2.25]) * 100.0) = 375L

// Exercise the exact-list and nested-pattern lowering paths, which unwrap the
// same leaf representation independently from list-cons lowering.
match [1.5] with | [value] -> Stdlib.Float.toInt(value * 100.0) | _ -> 0L = 150L

type WrappedFloatList = WrappedFloatList of List<Float>
match WrappedFloatList([1.5]) with | WrappedFloatList([value]) -> Stdlib.Float.toInt(value * 100.0) = 150L

// =====================================================
// List head type tracking test (kills mutation #167)
// =====================================================
// Tests that the TupleGet handler for TList correctly uses && (not ||)
// when checking whether to set destType to Float64. The condition is:
//   if index = 1 && elemType = AST.TFloat64 then destType := AST.TFloat64
// If && were changed to ||, accessing index 1 of a List<Int64> would
// incorrectly mark the result as Float64, causing the integer value to
// be loaded into a float register and misinterpreted.
//
// This test creates a List<Int64> via a function and accesses the head.
// If the head is incorrectly typed as Float64, the integer bit pattern
// would be interpreted as a float, giving a wrong result.
let makeIntList167() : List<Int64> = [42L, 84L, 126L]
match makeIntList167() with | h :: t -> h + 100L | [] -> 999L = 142L

// =====================================================
// List head type tracking via TFunction test (kills mutation #168)
// =====================================================
// Tests that the TupleGet handler for TFunction returning TList correctly
// uses && (not ||) when checking whether to set destType to Float64.
// The condition at line 796 is:
//   if index = 1 && elemType = AST.TFloat64 then destType := AST.TFloat64
// This is specifically for when TypeMap contains TFunction instead of just
// the return type (happens with closures stored in variables).
// If && were changed to ||, accessing index 1 of a List<Int64> from a
// closure would incorrectly mark the result as Float64.
//
// This test creates a function that returns List<Int64>, stores it as a
// first-class function value, calls it, and accesses the head. This exercises
// the TFunction path in TypeMap lookup.
let makeList168(n: Int64) : List<Int64> = [55L + n, 110L, 165L] let f = makeList168 in match f(0L) with | h :: t -> h + 200L | [] -> 999L = stdout="255\n"

// =====================================================
// List head type tracking in convertExprToOperand (kills mutation #169)
// =====================================================
// Tests that the TupleGet handler for TList in convertExprToOperand correctly
// uses && (not ||) when checking whether to set destType to Float64.
// The condition at line 1394 is:
//   if index = 1 && elemType = AST.TFloat64 then destType := AST.TFloat64
// This path is exercised when a list pattern match occurs inside an if-branch,
// because the if-branch is processed by convertExprToOperand, not convertExpr.
// If && were changed to ||, accessing index 1 of a List<Int64> inside a branch
// would incorrectly mark the result as Float64, causing the integer value to
// be loaded into a float register and misinterpreted.
//
// This test places the list pattern match inside an if-then branch to exercise
// the convertExprToOperand code path rather than the convertExpr path.
let testListInBranch169(flag: Bool) : Int64 =
    if flag then
        let xs = [55L, 110L, 165L] in match xs with | h :: t -> h | [] -> 0L
    else
        999L
testListInBranch169(true) = 55L

// =====================================================
// List head type tracking via TFunction in convertExprToOperand (kills mutation #170)
// =====================================================
// Tests that the TupleGet handler for TFunction returning TList in
// convertExprToOperand correctly uses && (not ||) when checking whether
// to set destType to Float64. The condition at line 1398 is:
//   if index = 1 && elemType = AST.TFloat64 then destType := AST.TFloat64
// This path is exercised when a closure that returns List<Int64> is stored
// as a first-class function, called, and pattern matched inside an if-branch.
// If && were changed to ||, accessing index 1 of a List<Int64> from a
// closure inside a branch would incorrectly mark the result as Float64.
//
// This test combines the closure pattern from #168 with the branch context
// from #169 to exercise the TFunction->TList case in convertExprToOperand.
let makeList170(n: Int64) : List<Int64> = [77L + n, 154L, 231L] let testBranch170(flag: Bool) : Int64 = if flag then let f = makeList170 in match f(0L) with | h :: t -> h | [] -> 0L else 999L testBranch170(true) = 77L

// Compound list elements use the same recursive value renderer.
[(1L, 2L)] = stdout="[(1, 2)]\n"
