// List tests for Phase 8

// === Empty List ===

// Empty list should not default to Int64 element type
Stdlib.List.length(if true then [] else [true]) = 0I
// Top-level char lists use the recursive interpreter value renderer.
['a', 'b'] = stdout="['a', 'b']\n"

// Empty list is Nil (represented as 0)
match [] with | [] -> 1L | _ -> 0L = 1L

// Empty list fallback
match [] with | [x] -> x | [] -> 99L = 99L

// Empty list should not default to Int64 element type
match [] with | [] -> true | [x] -> x | _ -> false = true

// Empty list should not erase element types when cons'ing tuples
let xs = [] in let ys = [("hi", "there")] @ xs in match ys with | [(a, b)] -> a ++ b | [] -> "" = error="Non-exhaustive match expression"

// Nested Int64 list display should format inner lists, not read inner list pointers as integers.
[[1L, 2L], [3L, 4L]] = stdout="[[1, 2], [3, 4]]\n" stderr=""

// === Single Element List ===

// Single element list
match [42L] with | [x] -> x | _ -> 0L = 42L

// Single element list with arithmetic
match [10L] with | [x] -> x * 2L | _ -> 0L = 20L

// Single element wildcard
match [100L] with | [_] -> 1L | _ -> 0L = 1L

// === Two Element List ===

// Two element list - sum
match [1L, 2L] with | [a, b] -> a + b | _ -> 0L = 3L

// Two element list - product
match [3L, 4L] with | [a, b] -> a * b | _ -> 0L = 12L

// Two element list - first element
match [10L, 20L] with | [a, _] -> a | _ -> 0L = 10L

// Two element list - second element
match [10L, 20L] with | [_, b] -> b | _ -> 0L = 20L

// Two element list - subtraction to verify element index increment (kills mutation #70)
// This ensures extractElements increments idx correctly when processing 2+ element DEEP lists
match [10L, 3L] with | [a, b] -> a - b | _ -> 999L = 7L

// === Three Element List ===

// Three element list - sum
match [10L, 20L, 30L] with | [a, b, c] -> a + b + c | _ -> 0L = 60L

// Three element list - middle element
match [1L, 2L, 3L] with | [_, x, _] -> x | _ -> 0L = 2L

// Three element list - product
match [2L, 3L, 4L] with | [a, b, c] -> a * b * c | _ -> 0L = 24L

// === Four Element List ===

// Four element list
match [1L, 2L, 3L, 4L] with | [a, b, c, d] -> a + b + c + d | _ -> 0L = 10L

// === Five Element List ===

// Five element list
match [1L, 2L, 3L, 4L, 5L] with | [a, b, c, d, e] -> a + b + c + d + e | _ -> 0L = 15L

// === Wildcard Patterns ===

// All wildcards in list pattern
match [1L, 2L, 3L] with | [_, _, _] -> 42L | _ -> 0L = 42L

// Mix of binding and wildcard (3 elements)
match [5L, 10L, 15L] with | [a, _, c] -> a + c | _ -> 0L = 20L

// === Non-Matching Cases ===

// Empty list doesn't match single element pattern

// Shorter list falls through to fallback
match [1L] with | [x] -> x | _ -> 99L = 1L

// === List in Variable ===

// Store list in variable
let xs = [5L, 10L] in match xs with | [a, b] -> a * b | _ -> 0L = 50L

// Store empty list in variable
let xs = [] in match xs with | [] -> 42L | _ -> 0L = 42L

// Store longer list in variable
let xs = [1L, 2L, 3L, 4L] in match xs with | [a, b, c, d] -> a + b + c + d | _ -> 0L = 10L

// === Computed List Elements ===

// List with computed elements
let x = 5L in match [x, x + 1L, x + 2L] with | [a, b, c] -> a + b + c | _ -> 0L = 18L

// List with arithmetic expressions (2 elements to avoid register pressure)
match [2L + 3L, 4L * 5L] with | [a, b] -> a + b | _ -> 0L = 25L

// === Nested Match ===

// Match result is a list, then match that
match [1L] with | [x] -> (match [x, x + 1L] with | [a, b] -> a + b | _ -> 0L) | _ -> 0L = 3L

// Chain of list matches
match [2L] with | [x] -> (let y = x * 3L in match [y] with | [z] -> z | _ -> 0L) | _ -> 0L = 6L

// === List in Let Body ===

// Use match result in computation
match [5L, 10L] with | [a, b] -> (a + b) * 2L | _ -> 0L = 30L

// Multiple bindings then use
match [1L, 2L] with | [x, y] -> (match [3L, 4L] with | [a, b] -> x + y + a + b | _ -> 0L) | _ -> 0L = 10L

// === Edge Cases ===

// Single element list equals empty fallback
match [0L] with | [] -> 1L | [x] -> x | _ -> 99L = 0L

// Large numbers in list
match [1000000L, 2000000L] with | [a, b] -> a + b | _ -> 0L = 3000000L

// Zero in list
match [0L, 0L, 0L] with | [a, b, c] -> a + b + c | _ -> 99L = 0L

// Negative numbers in list (via subtraction)
match [0L - 5L, 0L - 10L] with | [a, b] -> a + b | _ -> 0L = -15L

// === Pattern Order ===

// More specific pattern first
match [1L] with | [] -> 0L | [x] -> x | _ -> 99L = 1L

// Catch-all at end (use 2 elements to avoid pattern length mismatch issues)
match [1L, 2L] with | [] -> 0L | _ -> 99L = 99L

// === Complex Bodies ===

// Conditional in body
match [5L, 10L] with | [a, b] -> if a < b then b else a | _ -> 0L = 10L

// Let in body
match [3L, 4L] with | [a, b] -> let c = a * b in c + 1L | _ -> 0L = 13L

// Nested let in body
match [2L, 3L] with | [a, b] -> let x = a + b in let y = x * 2L in y | _ -> 0L = 10L

// === Length Mismatch Tests ===
// These test proper length validation - patterns should fall through when list is too short

// Match [a, b] against [1] - should fall through to wildcard
match [1L] with | [a, b] -> a + b | _ -> 99L = 99L

// Match [a, b, c] against [1, 2] - should fall through
match [1L, 2L] with | [a, b, c] -> a + b + c | _ -> 99L = 99L

// Match [a] against [] - should fall through
match [] with | [a] -> a | _ -> 99L = 99L

// Multiple length patterns - choose correct one
match [1L] with | [a, b] -> 1L | [a] -> 2L | [] -> 3L | _ -> 99L = 2L

// Empty list with multiple length patterns
match [] with | [a, b] -> 1L | [a] -> 2L | [] -> 3L = 3L

// Two-element list with various length patterns
match [1L, 2L] with | [a, b, c] -> 1L | [a, b] -> 2L | [a] -> 3L | _ -> 99L = 2L

// Pattern too long - 4 elements expected, 3 provided
match [1L, 2L, 3L] with | [a, b, c, d] -> a + b + c + d | _ -> 99L = 99L

// Pattern too long - 5 elements expected, 2 provided
match [1L, 2L] with | [a, b, c, d, e] -> a | _ -> 99L = 99L

// === Exact-length matching (fixed) ===
// Pattern [a, b] now correctly matches only lists with exactly 2 elements
// VReg conflict issue fixed by initializing RegGen past max TempId
match [1L, 2L, 3L] with | [a, b] -> a + b | _ -> 99L = 99L
match [1L, 2L, 3L, 4L] with | [a, b, c] -> a + b + c | _ -> 99L = 99L

// Verify exact matching works correctly
match [1L, 2L] with | [a, b] -> a + b | _ -> 99L = 3L
match [1L, 2L, 3L] with | [a, b, c] -> a + b + c | _ -> 99L = 6L

// =====================================================
// Polymorphic List Tests (List<t>)
// =====================================================

// Bool list - single element
let bs = [true] in match bs with | [x] -> if x then 1L else 0L | _ -> 99L = 1L

// Bool list - two elements
let bs = [true, false] in match bs with | [a, b] -> if a then 1L else 0L | _ -> 99L = 1L

// Bool list - check second element
let bs = [false, true] in match bs with | [a, b] -> if b then 1L else 0L | _ -> 99L = 1L

// Bool list - logical operations from extracted values
let bs = [true, true] in match bs with | [a, b] -> if a && b then 42L else 0L | _ -> 99L = 42L

// Bool list - three elements
let bs = [true, false, true] in match bs with | [a, b, c] -> if a && c then 1L else 0L | _ -> 99L = 1L

// Int lists still work as before
let xs = [10L, 20L, 30L] in match xs with | [a, b, c] -> a + b + c | _ -> 0L = 60L

// =====================================================
// Cons Pattern Tests h :: t
// =====================================================

// Basic cons pattern - extract head
match [1L, 2L, 3L] with | h :: t -> h | [] -> 0L = 1L

// Cons pattern - tail is a list
match [1L, 2L, 3L] with | h :: t -> match t with | [a, b] -> a + b | _ -> 0L | [] -> 0L = 5L

// Empty list doesn't match h :: t
match [] with | h :: t -> 1L | [] -> 0L = 0L

// Single element - tail is empty
match [42L] with | h :: t -> match t with | [] -> h | _ -> 0L | [] -> 0L = 42L

// Multiple head elements before rest
match [1L, 2L, 3L, 4L] with | a :: b :: t -> a + b | [] -> 0L | _ -> 0L = 3L

// Wildcard in head position
match [1L, 2L, 3L] with | _ :: t -> match t with | [a, b] -> a + b | _ -> 0L | [] -> 0L = 5L

// Wildcard as tail
match [1L, 2L, 3L] with | h :: _ -> h | [] -> 0L = 1L

// A variable pattern matches any list, including empty.
match [] with | t -> 1L = 1L
match [1L] with | t -> 1L = 1L

// Recursive length using cons pattern
let length(xs: List<Int64>) : Int64 = match xs with | [] -> 0L | _ :: t -> 1L + length(t); length([1L, 2L, 3L, 4L, 5L]) = 5L

// Recursive sum using cons pattern
let sum(xs: List<Int64>) : Int64 = match xs with | [] -> 0L | h :: t -> h + sum(t); sum([1L, 2L, 3L, 4L, 5L]) = 15L

// =====================================================
// Stdlib.List Function Tests
// =====================================================

// Stdlib.List.isEmpty
Stdlib.List.isEmpty<Int64>([]) = true
Stdlib.List.isEmpty([1L]) = false
Stdlib.List.isEmpty([1L, 2L, 3L]) = false

// Stdlib.List.length
Stdlib.List.length<Int64>([]) = 0I
Stdlib.List.length([1L]) = 1I
Stdlib.List.length([1L, 2L]) = 2I
Stdlib.List.length([1L, 2L, 3L]) = 3I
Stdlib.List.length([1L, 2L, 3L, 4L, 5L]) = 5I
// Stdlib.List.length with different types
Stdlib.List.length([true, false, true]) = 3I
// =====================================================
// Large List Literal Tests (6-50 elements)
// =====================================================

// Int lists (6+)
match [1L, 2L, 3L, 4L, 5L, 6L] with | [a, b, c, d, e, f] -> a + f | _ -> 0L = 7L
match [10L, 11L, 12L, 13L, 14L, 15L, 16L] with | [a, b, c, d, e, f, g] -> g - a | _ -> 0L = 6L
Stdlib.Option.withDefault(Stdlib.List.getAt([1L, 2L, 3L, 4L, 5L, 6L, 7L, 8L], 7I), 0L) = 8L
match [1L, 2L, 3L, 4L, 5L, 6L, 7L, 8L, 9L, 10L, 11L, 12L] with | [a, b, c, d, e, f, g, h, i, j, k, l] -> k + l | _ -> 0L = 23L
Stdlib.Option.withDefault(Stdlib.List.getAt([1L, 2L, 3L, 4L, 5L, 6L, 7L, 8L, 9L, 10L, 11L, 12L, 13L, 14L, 15L, 16L], 10I), 0L) = 11L
Stdlib.Option.withDefault(Stdlib.List.getAt([1L, 2L, 3L, 4L, 5L, 6L, 7L, 8L, 9L, 10L, 11L, 12L, 13L, 14L, 15L, 16L, 17L, 18L, 19L, 20L], 18I), 0L) = 19L
Stdlib.Option.withDefault(Stdlib.List.getAt([1L, 2L, 3L, 4L, 5L, 6L, 7L, 8L, 9L, 10L, 11L, 12L, 13L, 14L, 15L, 16L, 17L, 18L, 19L, 20L, 21L, 22L, 23L, 24L, 25L, 26L, 27L, 28L, 29L, 30L], 25I), 0L) = 26L
Stdlib.Option.withDefault(Stdlib.List.getAt([1L, 2L, 3L, 4L, 5L, 6L, 7L, 8L, 9L, 10L, 11L, 12L, 13L, 14L, 15L, 16L, 17L, 18L, 19L, 20L, 21L, 22L, 23L, 24L, 25L, 26L, 27L, 28L, 29L, 30L, 31L, 32L, 33L, 34L, 35L, 36L, 37L, 38L, 39L, 40L, 41L, 42L, 43L, 44L, 45L, 46L, 47L, 48L, 49L, 50L], 49I), 0L) = 50L

// Bool lists (6+)
match [true, false, true, false, true, false] with | [a, b, c, d, e, f] -> if f then 1L else 0L | _ -> -1L = 0L
match [false, false, false, false, true, true, true, true] with | [a, b, c, d, e, f, g, h] -> if e && h then 1L else 0L | _ -> -1L = 1L
Stdlib.Option.withDefault(Stdlib.List.getAt([true, false, true, false, true, false, true, false, true, false, true, false], 10I), false) = true
Stdlib.List.length([true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false]) = 16I
// String lists (6+)
match ["a", "b", "c", "d", "e", "f"] with | [a, b, c, d, e, f] -> a ++ f | _ -> "" = "af"
Stdlib.Option.withDefault(Stdlib.List.getAt(["s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8", "s9", "s10"], 9I), "") = "s10"
Stdlib.Option.withDefault(Stdlib.List.getAt(["s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8", "s9", "s10", "s11", "s12"], 11I), "") = "s12"
Stdlib.Option.withDefault(Stdlib.List.getAt(["t1", "t2", "t3", "t4", "t5", "t6", "t7", "t8", "t9", "t10", "t11", "t12", "t13", "t14", "t15", "t16", "t17", "t18", "t19", "t20"], 15I), "") = "t16"

// Record lists (6+)
type Item = { id: Int64, name: String } match [Item { id = 1L, name = "one" }, Item { id = 2L, name = "two" }, Item { id = 3L, name = "three" }, Item { id = 4L, name = "four" }, Item { id = 5L, name = "five" }, Item { id = 6L, name = "six" }] with | [a, b, c, d, e, f] -> f.name | _ -> "" = "six"
type Item = { id: Int64, name: String } match [Item { id = 1L, name = "one" }, Item { id = 2L, name = "two" }, Item { id = 3L, name = "three" }, Item { id = 4L, name = "four" }, Item { id = 5L, name = "five" }, Item { id = 6L, name = "six" }, Item { id = 7L, name = "seven" }, Item { id = 8L, name = "eight" }] with | [a, b, c, d, e, f, g, h] -> a.id + h.id | _ -> 0L = 9L
type Item = { id: Int64, name: String } match [Item { id = 1L, name = "one" }, Item { id = 2L, name = "two" }, Item { id = 3L, name = "three" }, Item { id = 4L, name = "four" }, Item { id = 5L, name = "five" }, Item { id = 6L, name = "six" }, Item { id = 7L, name = "seven" }, Item { id = 8L, name = "eight" }, Item { id = 9L, name = "nine" }, Item { id = 10L, name = "ten" }] with | [a, b, c, d, e, f, g, h, i, j] -> j.name | _ -> "" = "ten"

// =====================================================
// List Append Construction Tests
// =====================================================

// Basic spread construction - prepend single element
let x = [2L, 3L] in Stdlib.List.length([1L] @ x) = 3I
// Prepend multiple elements
let x = [3L, 4L] in Stdlib.List.length([1L, 2L] @ x) = 4I
// Empty spread - just return tail
let x = [1L, 2L, 3L] in Stdlib.List.length(x) = 3I
// Spread with empty tail (use function to get typed empty list)
let emptyList() : List<Int64> = []; Stdlib.List.length<Int64>([1L, 2L] @ emptyList()) = 2I
// Verify element values with pattern matching
let x = [2L, 3L] in match [1L] @ x with | [a, b, c] -> a + b + c | _ -> 0L = 6L

// Prepend computed value
let x = [2L, 3L] in match [10L + 1L] @ x with | [a, b, c] -> a | _ -> 0L = 11L

// Use in match case body
match [1L, 2L, 3L] with | h :: rest -> Stdlib.List.length([h] @ rest) | [] -> 0I = 3I
// Rebuild list with modified head
match [1L, 2L, 3L] with | h :: rest -> match [h + 10L] @ rest with | [a, b, c] -> a + b + c | _ -> 0L | [] -> 0L = 16L

// Chain of spreads
let a = [3L] in let b = [2L] @ a in Stdlib.List.length([1L] @ b) = 3I
// =====================================================
// Lists of Floats
// KNOWN BUG: Float list pattern matching fails - lists fall through to wildcard
// =====================================================

// Float list - basic
// DISABLED: match [1.0, 2.0, 3.0] with | [a, b, c] -> a + b + c | _ -> 0.0 = stdout="6.00\n"

// Float list - two elements
// DISABLED: match [1.5, 2.5] with | [a, b] -> a * b | _ -> 0.0 = stdout="3.75\n"

