// E2E coverage for pruning unreachable functions while retaining first-class function edges.

let unreachableLeaf (x: Int64): Int64 = x * 100L; let unreachableCycleA (x: Int64): Int64 = unreachableCycleB (x + 1L); let unreachableCycleB (x: Int64): Int64 = unreachableCycleA (x - 1L); let reachableIncrement (x: Int64): Int64 = x + 1L; let chooseReachable (flag: Bool): Int64 -> Int64 = if flag then reachableIncrement else reachableIncrement; let selected = chooseReachable true in selected 41L = 42L
