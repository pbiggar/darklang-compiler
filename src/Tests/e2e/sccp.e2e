// SCCP must preserve effects in both executable predecessors while removing a
// branch made unreachable by their common scalar result.

let choose (condition: Bool) : Int64 = let value = if condition then let _ = Builtin.print "left" in 7L else let _ = Builtin.print "right" in 7L in if value == 7L then value + 35L else let _ = Builtin.print "unreachable" in 0L choose (true) = stdout="left42\n" stderr="" exact_bytes=true
let choose (condition: Bool) : Int64 = let value = if condition then let _ = Builtin.print "left" in 7L else let _ = Builtin.print "right" in 7L in if value == 7L then value + 35L else let _ = Builtin.print "unreachable" in 0L choose (false) = stdout="right42\n" stderr="" exact_bytes=true

// Mixed scalar kinds must not disable executable-edge analysis or confuse
// Float/String/constructor representations with integer heap sentinels.
let mixed (condition: Bool) : String = let floating = if condition then 1.5 else 1.5 in let text = if condition then "same" else "same" in if (floating == 1.5) && (text == "same") then text else Builtin.testRuntimeError "unreachable"; mixed (true) = "same"
type Choice = | First | Second of Int64
let constructor (condition: Bool) : Int64 = let value = if condition then Second 42L else Second 42L in match value with | First -> Builtin.testRuntimeError "unreachable" | Second number -> number; constructor (false) = 42L
let smallResult (value: UInt8) : UInt8 = value
let callRange (value: UInt8) : Bool = let result = smallResult value in if result <= 255uy then true else Builtin.testRuntimeError "unreachable"; callRange (42uy) = true

// Pruning an unreachable runtime-error result must keep its integer sentinel
// behind the register used by a float-typed continuation.
let floatAt (values: List<Float>) (index: Int) : Float = match Stdlib.List.getAt values index with | Some value -> value | None -> Builtin.testRuntimeError "missing float"; floatAt ([1.5]) (0) = 1.5
let multipliedFloatAt (values: List<Float>) (index: Int) : Float = 2.0 * (match Stdlib.List.getAt values index with | Some value -> value | None -> Builtin.testRuntimeError "missing float"); multipliedFloatAt ([1.5]) (0) = 3.0
let recRow (values: List<Float>) (index: Int) (acc: Float) : Float = if index >= 1 then acc else recRow values (index + 1) (acc + 2.0 * (match Stdlib.List.getAt values index with | Some value -> value | None -> Builtin.testRuntimeError "missing float")); recRow ([1.5]) (0) (0.0) = 3.0

// Copies and a shared phi constant must retain only the executable result.
let foldedCopies (condition: Bool) : Int64 = let value = if condition then let _ = Builtin.print "left" in 20L + 22L else let _ = Builtin.print "right" in 6L * 7L in let copy = value in if copy == 42L then copy else Builtin.testRuntimeError "unreachable"; foldedCopies (true) = stdout="left42\n" stderr="" exact_bytes=true
let foldedCopies (condition: Bool) : Int64 = let value = if condition then let _ = Builtin.print "left" in 20L + 22L else let _ = Builtin.print "right" in 6L * 7L in let copy = value in if copy == 42L then copy else Builtin.testRuntimeError "unreachable"; foldedCopies (false) = stdout="right42\n" stderr="" exact_bytes=true

// Every incoming path to the inner join inherits the outer true edge.
let knownAfterJoin (condition: Bool) (choose: Bool) : Int64 = if condition then let value = if choose then 20L else 22L in if condition then value else Builtin.testRuntimeError "contradictory condition" else 0L; knownAfterJoin (true) (true) = 20L
let knownAfterJoin (condition: Bool) (choose: Bool) : Int64 = if condition then let value = if choose then 20L else 22L in if condition then value else Builtin.testRuntimeError "contradictory condition" else 0L; knownAfterJoin (true) (false) = 22L
let knownAfterJoin (condition: Bool) (choose: Bool) : Int64 = if condition then let value = if choose then 20L else 22L in if condition then value else Builtin.testRuntimeError "contradictory condition" else 0L; knownAfterJoin (false) (true) = 0L

// A range established on an edge survives a join but cannot escape that edge.
let boundedAfterJoin (value: Int64) (choose: Bool) : Int64 = if value < 10L then let selected = if choose then 1L else 2L in if value >= 10L then Builtin.testRuntimeError "contradictory range" else selected else 3L; boundedAfterJoin (9L) (true) = 1L
let boundedAfterJoin (value: Int64) (choose: Bool) : Int64 = if value < 10L then let selected = if choose then 1L else 2L in if value >= 10L then Builtin.testRuntimeError "contradictory range" else selected else 3L; boundedAfterJoin (10L) (false) = 3L

// Both outcomes of a comparison contribute edge facts, including unsigned
// values at their type bounds.
let rangeFalseEdge (value: Int64) : Int64 = if value < 10L then 1L else if value < 10L then Builtin.testRuntimeError "contradictory false edge" else 2L; rangeFalseEdge (9L) = 1L
let rangeFalseEdge (value: Int64) : Int64 = if value < 10L then 1L else if value < 10L then Builtin.testRuntimeError "contradictory false edge" else 2L; rangeFalseEdge (10L) = 2L
let unsignedBound (value: UInt8) : Int64 = if value < 10uy then if value >= 10uy then Builtin.testRuntimeError "contradictory unsigned edge" else 1L else 2L; unsignedBound (0uy) = 1L
let unsignedBound (value: UInt8) : Int64 = if value < 10uy then if value >= 10uy then Builtin.testRuntimeError "contradictory unsigned edge" else 1L else 2L; unsignedBound (9uy) = 1L
let unsignedBound (value: UInt8) : Int64 = if value < 10uy then if value >= 10uy then Builtin.testRuntimeError "contradictory unsigned edge" else 1L else 2L; unsignedBound (10uy) = 2L
let unsignedBound (value: UInt8) : Int64 = if value < 10uy then if value >= 10uy then Builtin.testRuntimeError "contradictory unsigned edge" else 1L else 2L; unsignedBound (255uy) = 2L

// At a join, a later executable predecessor must remove any fact it disagrees
// with. Both arms of these later branches remain observable.
let preserveBoolean (condition: Bool) : Int64 = let selected = if condition then 20L else 22L in if condition then selected else selected + 1L; preserveBoolean (true) = 20L
let preserveBoolean (condition: Bool) : Int64 = let selected = if condition then 20L else 22L in if condition then selected else selected + 1L; preserveBoolean (false) = 23L
let preserveRange (value: Int64) : Int64 = let selected = if value < 10L then 20L else 22L in if value < 10L then selected else selected + 1L; preserveRange (9L) = 20L
let preserveRange (value: Int64) : Int64 = let selected = if value < 10L then 20L else 22L in if value < 10L then selected else selected + 1L; preserveRange (10L) = 23L
