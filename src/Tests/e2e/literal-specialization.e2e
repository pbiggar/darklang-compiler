// Finite scalar literal specialization end-to-end coverage.

// Differing invariant modes create reduced-signature recursive clones while
// the changing counter and accumulator retain their original evaluation order.
let specializedLoop (n: Int64) (mode: Int64) (acc: Int64) : Int64 =
    if n <= 0L then acc
    else specializedLoop (n - 1L) mode (acc + mode)

specializedLoop 5L 2L 0L + specializedLoop 5L 3L 0L = 25L

// Literal specialization preserves the runtime representation of managed text,
// immediate temporal values, and nullary constructor tags.
type SpecializationMode = First | Second

let stringSpecializedLoop (n: Int64) (suffix: String) (acc: String) : String =
    if n <= 0L then acc
    else stringSpecializedLoop (n - 1L) suffix (acc ++ suffix)

let stringComparisonSpecializedLoop (n: Int64) (value: String) : Bool =
    if n <= 0L then value == "x"
    else stringComparisonSpecializedLoop (n - 1L) value

let charSpecializedLoop (n: Int64) (value: Char) : Char =
    if n <= 0L then value else charSpecializedLoop (n - 1L) value

let dateTimeSpecializedLoop (n: Int64) (value: DateTime) : DateTime =
    if n <= 0L then value else dateTimeSpecializedLoop (n - 1L) value

let constructorSpecializedLoop (n: Int64) (mode: SpecializationMode) : SpecializationMode =
    if n <= 0L then mode else constructorSpecializedLoop (n - 1L) mode

let wideSpecializedLoop (n: Int64) (value: Int128) : Int128 =
    if n <= 0L then value else wideSpecializedLoop (n - 1L) value

let tupleSpecializedLoop (n: Int64) (value: (Int64 * Bool)) : (Int64 * Bool) =
    if n <= 0L then value else tupleSpecializedLoop (n - 1L) value

stringSpecializedLoop 3L "x" "" ++ stringSpecializedLoop 2L "yz" "" = "xxxyzyz"
stringComparisonSpecializedLoop 2L "x" = true
stringComparisonSpecializedLoop 2L "y" = false
charSpecializedLoop 2L 'a' = 'a'
dateTimeSpecializedLoop 2L (Stdlib.DateTime.fromMilliseconds 1234) = Stdlib.DateTime.fromMilliseconds 1234
constructorSpecializedLoop 2L First = First
wideSpecializedLoop 2L 170141183460469231731687303715884105727Q = 170141183460469231731687303715884105727Q
tupleSpecializedLoop 2L (42L, true) = (42L, true)

// Different constructed arguments and a dynamic caller keep the original
// signature available alongside any literal clones.
let pairScore (pair: (Int64 * Bool)) : Int64 =
    let (score, positive) = pair in
    if positive then score else 0L - score
let dynamicPairScore (pair: (Int64 * Bool)) : Int64 = pairScore pair
pairScore (3L, true) + pairScore (5L, false) + dynamicPairScore (8L, true) = 6L

// Float literal identities include the sign bit of zero.
let specializedZeroBits (value: Float) : Int = Stdlib.Float.toBits value
specializedZeroBits (0.0) != specializedZeroBits (-0.0) = true
