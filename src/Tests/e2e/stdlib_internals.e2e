// Stdlib internal API visibility tests
//
// Double-underscore functions should not be callable from user code.

__raw_alloc 8L = compileerror="Internal identifier not allowed in user code: __raw_alloc"
Stdlib.Dict.__getTag (Dict { }) = compileerror="Internal identifier not allowed in user code: Stdlib.Dict.__getTag"
Stdlib.List.__empty () = compileerror="Internal identifier not allowed in user code: Stdlib.List.__empty"
Stdlib.List.__arrayCopy 0L 0L 0L 0L = compileerror="Internal identifier not allowed in user code: Stdlib.List.__arrayCopy"
Stdlib.List.__arrayOwnershipBoundary_i64 [] = compileerror="Internal identifier not allowed in user code: Stdlib.List.__arrayOwnershipBoundary_i64"
Stdlib.Internal.SkewList.empty () = compileerror="Unknown function or value 'Stdlib.Internal.SkewList.empty'"
Stdlib.Internal.ListArray.copy 0L 0L 0L 0L = compileerror="Unknown function or value 'Stdlib.Internal.ListArray.copy'"
