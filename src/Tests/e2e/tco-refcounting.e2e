// Tail-call + refcount interaction regressions
//
// These tests guard against dropping RefCountDec operations when a self-tailcall
// is lowered to a loop in ANF->MIR.

let buildList (n: Int64) (acc: List<Int64>) : List<Int64> = if n <= 0L then acc else buildList (n - 1L) (Stdlib.List.push acc n) let xs = buildList 50L ([]) in let _ = Stdlib.List.reverse xs in 1L = stdout="1\n" stderr=""
let buildList (n: Int64) (acc: List<Int64>) : List<Int64> = if n <= 0L then acc else buildList (n - 1L) (Stdlib.List.push acc n) let xs = buildList 50L ([]) in let _ = Stdlib.List.filter xs (fun x -> x < 9999L) in 1L = stdout="1\n" stderr=""
let buildList (n: Int64) (acc: List<Int64>) : List<Int64> = if n <= 0L then acc else buildList (n - 1L) (Stdlib.List.push acc n) let consume (xs: List<Int64>) (acc: Int64) : Int64 = match xs with | [] -> acc | _ :: t -> consume t (acc + 1L) let xs = buildList 100L ([]) in consume xs 0L = stdout="100\n" stderr=""

// Persistent dictionaries used as owned loop state must retain every shared
// HAMT edge before the obsolete root is released at the loop backedge.
let loop (remaining: Int64) (dict: Dict<Int64>) : Int64 = if remaining <= 0L then match Stdlib.Dict.get dict "1" with | Some value -> value | None -> 0L else let next = Stdlib.Dict.setOverridingDuplicates dict (Stdlib.Int64.toString remaining) remaining in loop (remaining - 1L) next let result = loop 50L Stdlib.Dict.empty in result = stdout="1\n" stderr=""
let loop (remaining: Int64) (dict: Dict<Int64>) : Int64 = if remaining <= 0L then match Stdlib.Dict.get dict "1" with | Some value -> value | None -> 0L else let next = Stdlib.Dict.setOverridingDuplicates dict (Stdlib.Int64.toString remaining) remaining in loop (remaining - 1L) next let result = loop 50L Stdlib.Dict.empty in result = stdout="1\n" stderr="" disable_opt_freelist=true

let lookup (dict: Dict<Int64>) : Int64 = match Stdlib.Dict.get dict "1" with | Some value -> value | None -> 0L let rotate (layers: Int64) (index: Int64) (previous: Dict<Int64>) (current: Dict<Int64>) (state: (Bool * Int64)) : Int64 = if index > 3L then if layers <= 0L then lookup previous + state.1 else rotate (layers - 1L) 0L current Stdlib.Dict.empty ((false, state.1 + 1L)) else let previousValue = lookup previous in let next = Stdlib.Dict.setOverridingDuplicates current (Stdlib.Int64.toString index) (index + previousValue) in rotate layers (index + 1L) previous next ((false, state.1 + 1L)) let initial = Stdlib.Dict.setOverridingDuplicates Stdlib.Dict.empty "1" 1L in rotate 1L 0L initial Stdlib.Dict.empty ((false, 0L)) = stdout="11\n" stderr=""
let lookup (dict: Dict<Int64>) : Int64 = match Stdlib.Dict.get dict "1" with | Some value -> value | None -> 0L let rotate (layers: Int64) (index: Int64) (previous: Dict<Int64>) (current: Dict<Int64>) (state: (Bool * Int64)) : Int64 = if index > 3L then if layers <= 0L then lookup previous + state.1 else rotate (layers - 1L) 0L current Stdlib.Dict.empty ((false, state.1 + 1L)) else let previousValue = lookup previous in let next = Stdlib.Dict.setOverridingDuplicates current (Stdlib.Int64.toString index) (index + previousValue) in rotate layers (index + 1L) previous next ((false, state.1 + 1L)) let initial = Stdlib.Dict.setOverridingDuplicates Stdlib.Dict.empty "1" 1L in rotate 1L 0L initial Stdlib.Dict.empty ((false, 0L)) = stdout="11\n" stderr="" disable_opt_freelist=true

let lookup (dict: Dict<Int64>) : Int64 = match Stdlib.Dict.get dict "1" with | Some value -> value | None -> 0L let grow (remaining: Int64) (dict: Dict<Int64>) : Dict<Int64> = if remaining <= 0L then dict else grow (remaining - 1L) (Stdlib.Dict.setOverridingDuplicates dict (Stdlib.Int64.toString remaining) remaining) let original = Stdlib.Dict.setOverridingDuplicates Stdlib.Dict.empty "1" 1L in let latest = grow 50L original in lookup original + lookup latest = stdout="2\n" stderr=""
let lookup (dict: Dict<Int64>) : Int64 = match Stdlib.Dict.get dict "1" with | Some value -> value | None -> 0L let grow (remaining: Int64) (dict: Dict<Int64>) : Dict<Int64> = if remaining <= 0L then dict else grow (remaining - 1L) (Stdlib.Dict.setOverridingDuplicates dict (Stdlib.Int64.toString remaining) remaining) let original = Stdlib.Dict.setOverridingDuplicates Stdlib.Dict.empty "1" 1L in let latest = grow 50L original in lookup original + lookup latest = stdout="2\n" stderr="" disable_opt_freelist=true

// Replacing an owned record accumulator must release the old record before looping.
type RcLoopState = { value: Int64 } let replaceRecord (state: RcLoopState) (n: Int64) : RcLoopState = if n <= 0L then state else replaceRecord (RcLoopState { value = state.value + 1L }) (n - 1L) let result = replaceRecord (RcLoopState { value = 0L }) 500000L in result.value = stdout="500000\n" stderr=""
