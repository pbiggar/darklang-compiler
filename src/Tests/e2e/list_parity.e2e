Stdlib.List.length Stdlib.List.empty = 0
Stdlib.List.length Stdlib.List.empty = 0
Stdlib.List.length ([1L, 2L, 3L]) = 3
Stdlib.List.findFirstIndex ([10L, 20L, 30L]) (fun value -> value == 20L) = Some 1
Stdlib.List.indexedMap ([3L, 2L, 1L]) (fun index value -> index) = [0, 1, 2]
Stdlib.List.getAt ([1L, 2L, 3L]) (-1) = None
Stdlib.List.getAt ([1L, 2L, 3L]) 1 = Some 2L
Stdlib.List.getAt ([1L, 2L, 3L]) 9223372036854775808 = None

Stdlib.List.range (-1) 2 = [-1, 0, 1, 2]
Stdlib.List.range 2 1 = []
Stdlib.List.repeatUnsafe 3 "x" = ["x", "x", "x"]
Stdlib.List.repeat 0 1L = Ok []
Stdlib.List.repeat (-4) "x" = Error "Expected `times` to be positive, but it was `-4`"

Stdlib.List.take ([1L, 2L, 3L]) (-1) = []
Stdlib.List.take ([1L, 2L, 3L]) 2147483648 = [1L, 2L, 3L]
Stdlib.List.drop ([1L, 2L, 3L]) (-1) = [1L, 2L, 3L]
Stdlib.List.drop ([1L, 2L, 3L]) 2147483648 = []

Stdlib.List.map2shortest ([1L, 2L]) ([10L, 20L, 30L]) (fun a b -> a + b) = [11L, 22L]
Stdlib.List.map2shortest ([1L, 2L]) ([10L, 20L, 30L]) (fun a b -> a + b) = [11L, 22L]
Stdlib.List.groupByWithKey ([1L, 2L, 3L, 4L, 5L]) (fun x -> x % 2L) = [(1L, [1L, 3L, 5L]), (0L, [2L, 4L])]
Stdlib.List.groupByWithKey (["apple", "ant", "bee"]) (fun value -> Stdlib.String.first value 1) = [("a", ["apple", "ant"]), ("b", ["bee"])]

Stdlib.List.iter ([1L, 2L, 3L]) (fun x -> let ignored = if x == 2L then Builtin.testRuntimeError "iter-second" else () in ()) = error="Uncaught exception: iter-second"
Stdlib.List.iter [] (fun _ -> ()) = ()
Stdlib.List.randomElement [] = None
Stdlib.List.randomElement ([42L]) = Some 42L

Stdlib.List.chunkBySize ([1L, 2L, 3L, 4L, 5L]) 2 = Ok ([[1L, 2L], [3L, 4L], [5L]])
Stdlib.List.chunkBySizeHelper 2 ([1L, 2L, 3L]) [] = [[1L, 2L], [3L]]
Stdlib.List.chunkBySize [] 4 = Ok []
Stdlib.List.chunkBySize ([1L]) 0 = Error Stdlib.List.ChunkBySizeError.SizeMustBeGreaterThanZero
Stdlib.List.chunkBySize ([1L]) (-1) = Error Stdlib.List.ChunkBySizeError.SizeMustBeGreaterThanZero

Stdlib.List.sort (["6", "2", "8", "3"]) = ["2", "3", "6", "8"]
Stdlib.List.sort ([6L, 2L, 8L, 3L]) = [2L, 3L, 6L, 8L]
Stdlib.List.sort ([[2L], [], [1L, 3L], [1L, 2L]]) = [[], [1L, 2L], [1L, 3L], [2L]]
Stdlib.List.sort ([(2L, "a"), (1L, "z"), (1L, "a")]) = [(1L, "a"), (1L, "z"), (2L, "a")]
Stdlib.List.sort ([Stdlib.Cli.Stdin.Modifiers.Modifiers { alt = true, ctrl = false, shift = false }, Stdlib.Cli.Stdin.Modifiers.Modifiers { alt = false, ctrl = true, shift = false }, Stdlib.Cli.Stdin.Modifiers.Modifiers { alt = false, ctrl = false, shift = true }]) = [Stdlib.Cli.Stdin.Modifiers.Modifiers { alt = false, ctrl = false, shift = true }, Stdlib.Cli.Stdin.Modifiers.Modifiers { alt = false, ctrl = true, shift = false }, Stdlib.Cli.Stdin.Modifiers.Modifiers { alt = true, ctrl = false, shift = false }]
Stdlib.List.sort ([Some 2L, None, Some 1L]) = [None, Some 1L, Some 2L]
Stdlib.List.sortBy ([6L, 2L, 8L, 3L]) (fun x -> 0L - x) = [8L, 6L, 3L, 2L]
Stdlib.List.unique ([7L, 42L, 7L, 2L, 10L]) = [2L, 7L, 10L, 42L]
Stdlib.List.uniqueBy ([1L, 2L, 3L, 4L]) (fun x -> x / 2L) = [1L, 2L, 4L]

Stdlib.List.SortByComparatorHelpers.validate (fun a b -> 3) 1L 2L = Error "Expected comparator function to return -1, 0, or 1, but it returned 3"
Stdlib.List.SortByComparatorHelpers.splitList ([1L, 2L, 3L, 4L, 5L]) = ([1L, 3L, 5L], [2L, 4L])
Stdlib.List.SortByComparatorHelpers.merge<Int64> (fun a b -> if a < b then -1 else if a > b then 1 else 0) ([1L, 3L]) ([2L, 4L]) = Ok ([1L, 2L, 3L, 4L])
Stdlib.List.SortByComparatorHelpers.mergeSort<Int64> (fun a b -> if a < b then -1 else if a > b then 1 else 0) ([3L, 1L, 2L]) = Ok ([1L, 2L, 3L])
Stdlib.List.sortByComparator ([3L, 1L, 2L]) (fun a b -> if a < b then -1 else if a > b then 1 else 0) = Ok ([1L, 2L, 3L])
Stdlib.List.sortByComparator ([(1L, "first"), (1L, "second"), (0L, "zero")]) (fun (a, _) (b, _) -> if a < b then -1 else if a > b then 1 else 0) = Ok ([(0L, "zero"), (1L, "first"), (1L, "second")])
Stdlib.List.sortByComparator ([1L, 2L]) (fun _ _ -> 2) = Error "Expected comparator function to return -1, 0, or 1, but it returned 2"
Stdlib.List.sortByComparator ([3L, 1L, 2L]) (fun a b -> if a == 3L && b == 2L then 2 else if a < b then -1 else if a > b then 1 else 0) = Error "Expected comparator function to return -1, 0, or 1, but it returned 2"
Stdlib.List.sortByComparator ([1L, 2L]) (fun _ _ -> 0L) = compileerror="Expected TInt, got TInt64"
