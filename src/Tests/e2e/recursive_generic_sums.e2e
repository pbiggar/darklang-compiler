// Recursive generic sums must keep their nominal identity through folds and callbacks.

type Tree<'a> = Empty | Node of Tree<'a> * 'a * Tree<'a>

let singleton (value: 'a) : Tree<'a> = Tree.Node(Tree.Empty, value, Tree.Empty)
let prepend (tree: Tree<'a>) (value: 'a) : Tree<'a> = Tree.Node(tree, value, Tree.Empty)
let ofList (values: List<'a>) : Tree<'a> = Stdlib.List.fold values Tree.Empty (fun tree value -> prepend tree value)
let count (tree: Tree<'a>) : Int64 = match tree with | Empty -> 0L | Node(left, _, right) -> 1L + count left + count right
let total (tree: Tree<Int64>) : Int64 = match tree with | Empty -> 0L | Node(left, value, right) -> total left + value + total right
let words (tree: Tree<String>) : String = match tree with | Empty -> "" | Node(left, value, right) -> words left ++ value ++ words right

count (ofList [1L, 2L, 3L]) = 3L
count (ofList ["one", "two"]) = 2L
count (prepend (singleton 1L) 2L) = 2L
total (ofList [1L, 2L, 3L]) = 6L
words (ofList ["one", "two"]) = "onetwo"
total (ofList []) = 0L

// Nongeneric recursive sums use the same accumulator inference rule.
type Spine = End | Link of Spine
let spineLength (spine: Spine) : Int64 = match spine with | End -> 0L | Link rest -> 1L + spineLength rest
spineLength (Stdlib.List.fold [1L, 2L, 3L] Spine.End (fun spine _ -> Spine.Link spine)) = 3L

// An unresolved accumulator also accepts an empty nonrecursive generic sum.
Stdlib.List.fold [1L, 2L] Stdlib.Option.Option.None (fun _ value -> Stdlib.Option.Option.Some value) = Stdlib.Option.Option.Some 2L

// Inference must retain nominal identity and concrete type arguments.
let requireOption (value: Stdlib.Option.Option<Int64>) : Int64 = 0L
let requireIntTree (value: Tree<Int64>) : Int64 = 0L
requireOption Tree.Empty = compileerror="expects Stdlib.Option.Option<Int64>, but got Tree<a>"
requireIntTree (Tree.Node(Tree.Empty, "one", Tree.Empty)) = compileerror="expects Tree<Int64>, but got Tree<String>"

// A generic call must satisfy its input and contextual result constraints together.
requireIntTree (ofList ["one"]) = compileerror="conflicting inferences"
