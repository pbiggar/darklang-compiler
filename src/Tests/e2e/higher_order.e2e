// E2E tests for higher-order functions (functions as arguments)

// =====================================================
// Named Function as Argument
// =====================================================

// Pass named function as argument and call it
let apply(f: (Int64) -> Int64, x: Int64): Int64 = f(x) let inc(n: Int64): Int64 = n + 1L apply(inc, 5L) = 6L

// Two-argument function passed as argument
let apply2(f: (Int64, Int64) -> Int64, a: Int64, b: Int64): Int64 = f(a, b) let add(x: Int64, y: Int64): Int64 = x + y; apply2(add, 3L, 4L) = 7L

// Pass named function and use with multiple values
let twice(f: (Int64) -> Int64, x: Int64): Int64 = f(f(x)) let double(n: Int64): Int64 = n * 2L twice(double, 5L) = 20L

// =====================================================
// Lambda as Argument (no captures)
// =====================================================

// Pass simple lambda as argument
let apply(f: (Int64) -> Int64, x: Int64): Int64 = f(x); apply(fun y -> y + 1L, 5L) = 6L

// Lambda with multiplication
let apply(f: (Int64) -> Int64, x: Int64): Int64 = f(x); apply(fun y -> y * 2L, 21L) = 42L

// Two-argument lambda
let apply2(f: (Int64, Int64) -> Int64, a: Int64, b: Int64): Int64 = f(a, b); apply2(fun a b -> a * b, 6L, 7L) = 42L

// =====================================================
// Lambda with Captures as Argument
// =====================================================

// Pass capturing lambda - closure support
let apply(f: (Int64) -> Int64, x: Int64): Int64 = f(x) let base = 10L in apply(fun y -> y + base, 5L) = 15L

// Two variables captured
let apply(f: (Int64) -> Int64, x: Int64): Int64 = f(x) let a = 10L in let b = 20L in apply(fun y -> y + a + b, 12L) = 42L

// Capture and multiply
let apply(f: (Int64) -> Int64, x: Int64): Int64 = f(x) let factor = 7L in apply(fun y -> y * factor, 6L) = 42L

// =====================================================
// Composed Function Applications
// =====================================================

// Apply function twice using higher-order function
let twice(f: (Int64) -> Int64, x: Int64): Int64 = f(f(x)); twice(fun y -> y + 1L, 5L) = 7L

// Twice with capturing lambda
let twice(f: (Int64) -> Int64, x: Int64): Int64 = f(f(x)) let inc = 3L in twice(fun y -> y + inc, 5L) = 11L

// =====================================================
// Nested Lambdas (CPS-style)
// =====================================================

// Nested lambda passed as continuation
let withCont(x: Int64, cont: (Int64) -> Int64): Int64 = cont(x + 1L); withCont(5L, fun r -> r * 2L) = 12L

// Two levels of nesting - inner lambda calls outer function
let cps1(x: Int64, k: (Int64) -> Int64): Int64 = k(x) let cps2(x: Int64): Int64 = cps1(x + 1L, fun r -> r * 2L); cps2(5L) = 12L

// Three levels of CPS-style nesting
let step(x: Int64, k: (Int64) -> Int64): Int64 = k(x + 1L); step(1L, fun a -> step(a, fun b -> step(b, fun c -> c))) = 4L

// Nested lambda capturing outer lambda's parameter
let outer(f: (Int64) -> Int64, x: Int64): Int64 = f(x) let inner(g: (Int64) -> Int64, y: Int64): Int64 = g(y); outer(fun a -> inner(fun b -> a + b, 10L), 32L) = 42L

// CPS-style with captured variables
let cpsAdd(x: Int64, k: (Int64) -> Int64): Int64 = k(x) let base = 10L in cpsAdd(5L, fun r -> r + base) = 15L

// Capturing function parameter in nested lambda (requires proper type tracking)
let apply(f: (Int64) -> Int64, x: Int64): Int64 = f(x) let wrapper(k: (Int64) -> Int64, x: Int64): Int64 = apply(fun r -> k(r), x); wrapper(fun n -> n * 2L, 21L) = 42L

// =====================================================
// Multiple FuncRefs (tests wrapper name uniqueness)
// =====================================================

// Pass two different named functions as values - each needs unique wrapper
let apply(f: (Int64) -> Int64, x: Int64): Int64 = f(x) let inc(n: Int64): Int64 = n + 1L let dec(n: Int64): Int64 = n - 1L apply(inc, 10L) + apply(dec, 10L) = 20L

// =====================================================
// Multiple FuncRefs Counter Test (Mutation #53)
// =====================================================
// Tests that the wrapper counter increments correctly in generateFuncWrapper.
// With mutation (+ -> -), the counter decrements instead of incrementing when
// generating wrappers for named functions used as values.
// This tests 3+ named functions to ensure all wrappers get unique names.

// Three named functions used as values - each should get unique wrapper
let applyF(f: (Int64) -> Int64, x: Int64): Int64 = f(x) let add1(n: Int64): Int64 = n + 1L let add2(n: Int64): Int64 = n + 2L let add3(n: Int64): Int64 = n + 3L applyF(add1, 10L) + applyF(add2, 10L) + applyF(add3, 10L) = 36L

// =====================================================
// FuncRef with Non-Int64 Types (tests correct type propagation)
// =====================================================
// Tests that FuncRef wrappers use the actual function signature types
// instead of defaulting to TInt64. Before the fix, these would generate
// wrappers with incorrect Int64 types.

// FuncRef with Bool parameter and return type
let applyBool(f: (Bool) -> Bool, x: Bool): Bool = f(x) let notBool(b: Bool): Bool = if b then false else true applyBool(notBool, true) = false

// FuncRef with Bool return, testing truthiness
let applyBool2(f: (Bool) -> Bool, x: Bool): Bool = f(x) let identity(b: Bool): Bool = b; applyBool2(identity, true) = true

// FuncRef with Float parameter and return type
let applyFloat(f: (Float) -> Float, x: Float): Float = f(x) let doubleFloat(n: Float): Float = n * 2.0 applyFloat(doubleFloat, 21.0) = 42.0

// FuncRef with multiple non-Int64 parameters
let apply2Floats(f: (Float, Float) -> Float, a: Float, b: Float): Float = f(a, b) let addFloats(x: Float, y: Float): Float = x + y; apply2Floats(addFloats, 3.5, 4.5) = 8.0

// FuncRef with String parameter and return type
let applyStr(f: (String) -> String, s: String): String = f(s) let addBang(s: String): String = s ++ "!" applyStr(addBang, "hello") = "hello!"

// Returning a named function as a first-class value must use the wrapper calling convention
let choose(): (String) -> String = addBang let addBang(s: String): String = s ++ "!" let f = choose() in f("ok") = "ok!"

// FuncRef with mixed types (Int64 param, Bool return)
let checkPositive(f: (Int64) -> Bool, n: Int64): Bool = f(n) let isPositive(x: Int64): Bool = x > 0L checkPositive(isPositive, 5L) = true

// FuncRef with mixed types (Bool param, Int64 return)
let boolToNum(f: (Bool) -> Int64, b: Bool): Int64 = f(b) let fromBool(b: Bool): Int64 = if b then 1L else 0L boolToNum(fromBool, true) = 1L
