// File I/O Tests - Testing file system operations
//
// Tests covering:
// - File existence checks (Stdlib.File.exists)
// - File reading (Stdlib.File.readText)
// - File writing (Stdlib.File.writeText, Stdlib.File.appendText)
//

// ===================================================================
// File Existence
// ===================================================================
// Check if a file exists using Stdlib.File.exists

// /etc/passwd exists on both Linux and macOS
Stdlib.File.exists("/etc/passwd") = true

// Non-existent file
Stdlib.File.exists("/nonexistent/file/path/that/does/not/exist") = false

// Root directory exists (should work as a path)
Stdlib.File.exists("/") = true

// Another standard file
Stdlib.File.exists("/etc/hosts") = true

// Empty string path (edge case - should be false)
Stdlib.File.exists("") = false

// Use with let binding
let exists = Stdlib.File.exists("/etc/passwd") in exists = true

// Use in conditional
if Stdlib.File.exists("/etc/passwd") then 1 else 0 = 1
if Stdlib.File.exists("/nonexistent") then 1 else 0 = 0


// ===================================================================
// File Reading
// ===================================================================
// Reading file contents using Stdlib.File.readText

// Reading an existing file returns Ok - test with pattern matching
match Stdlib.File.readText("/etc/hosts") with | Ok(_) -> true | Error(_) -> false = true

// Reading a non-existent file returns Error
match Stdlib.File.readText("/nonexistent/file") with | Ok(_) -> false | Error(_) -> true = true

// Read the error message from a non-existent file
match Stdlib.File.readText("/nonexistent") with | Ok(s) -> s | Error(e) -> e = "Error"

// Use in let binding
let result = Stdlib.File.readText("/etc/hosts") in match result with | Ok(_) -> 1 | Error(_) -> 0 = 1

// Use in conditional - return different values based on file existence
match Stdlib.File.readText("/etc/hosts") with | Ok(_) -> 42 | Error(_) -> 0 = 42
match Stdlib.File.readText("/nonexistent") with | Ok(_) -> 42 | Error(_) -> 0 = 0


// ===================================================================
// File Writing
// ===================================================================
// Writing file contents using Stdlib.File.writeText

// Write to a new file and verify success
match Stdlib.File.writeText("/tmp/dark_test_write1.txt", "hello") with | Ok(_) -> "ok" | Error(e) -> e = "ok"

// Write to a file and read it back
let _ = Stdlib.File.writeText("/tmp/dark_test_write2.txt", "test content") in match Stdlib.File.readText("/tmp/dark_test_write2.txt") with | Ok(s) -> s | Error(_) -> "error" = "test content"

// Write creates file - verify it exists
let _ = Stdlib.File.writeText("/tmp/dark_test_write3.txt", "content") in Stdlib.File.exists("/tmp/dark_test_write3.txt") = true

// Write to invalid path returns Error
match Stdlib.File.writeText("/nonexistent/directory/file.txt", "test") with | Ok(_) -> "ok" | Error(_) -> "error" = "error"

// Write empty string
let _ = Stdlib.File.writeText("/tmp/dark_test_empty.txt", "") in Stdlib.File.exists("/tmp/dark_test_empty.txt") = true

// Dead if-branch file writes must not execute when if is lowered in atom position.
let path = "/tmp/dark_test_if_lazy_write.txt" in let _ = Stdlib.File.writeText(path, "good") in let _ = if true then 0 else let _ = Stdlib.File.writeText(path, "bad") in 0 in match Stdlib.File.readText(path) with | Ok(s) -> s | Error(_) -> "error" = "good"

// Regression: if-toAtom lowering must not eagerly execute branch calls when the branch is dead.
let path = "/tmp/dark_test_if_dead_branch_call.txt" in let _ = Stdlib.File.writeText(path, "good") in let _ = if false then Stdlib.File.writeText(path, "bad") else Stdlib.Result.Result.Ok(()) in match Stdlib.File.readText(path) with | Ok(s) -> s | Error(_) -> "error" = "good"


// ===================================================================
// File Appending
// ===================================================================
// Appending to files using Stdlib.File.appendText

// Append to a file creates it if it doesn't exist
match Stdlib.File.appendText("/tmp/dark_test_append1.txt", "hello") with | Ok(_) -> "ok" | Error(e) -> e = "ok"

// Append to existing file - verify append returns Ok
let _ = Stdlib.File.writeText("/tmp/dark_test_append2.txt", "first") in match Stdlib.File.appendText("/tmp/dark_test_append2.txt", "second") with | Ok(_) -> "ok" | Error(_) -> "error" = "ok"

// Multiple appends accumulate - verify the operations succeed
let _ = Stdlib.File.writeText("/tmp/dark_test_append3.txt", "a") in match Stdlib.File.appendText("/tmp/dark_test_append3.txt", "b") with | Ok(_) -> "ok" | Error(_) -> "error" = "ok"

// Append to invalid path returns Error
match Stdlib.File.appendText("/nonexistent/directory/file.txt", "test") with | Ok(_) -> "ok" | Error(_) -> "error" = "error"


// ===================================================================
// Path Operations
// ===================================================================

// Stdlib.Path.combine joins paths with /
Stdlib.Path.combine("foo", "bar") = "foo/bar"
Stdlib.Path.combine("/usr", "bin") = "/usr/bin"
Stdlib.Path.combine("", "file.txt") = "/file.txt"
Stdlib.Path.combine("/", "tmp") = "/tmp"
Stdlib.Path.combine("/tmp", "test.txt") = "/tmp/test.txt"
Stdlib.Path.combine("/tmp/", "test.txt") = "/tmp/test.txt"

// Stdlib.Path.tempDir returns /tmp
Stdlib.Path.tempDir() = "/tmp"

// Combine with tempDir
Stdlib.Path.combine(Stdlib.Path.tempDir(), "myfile.txt") = "/tmp/myfile.txt"


// ===================================================================
// Platform Detection
// ===================================================================

// Platform detection functions return booleans.
// These calls are constant-folded at compile time based on the compiler host.
// Exactly one supported platform predicate should be true

Stdlib.Platform.isMacOS() != Stdlib.Platform.isLinux() = true
