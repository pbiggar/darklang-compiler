// Record tests for Phase 7 Milestone 2

// Basic record type definition and access
type Point = { x: Int64, y: Int64 } let p = Point { x = 10L, y = 20L } in p.x = 10L

type Point = { x: Int64, y: Int64 } let p = Point { x = 10L, y = 20L } in p.y = 20L

// Records remain matchable through a variable followed by field access.
type Point = { x: Int64, y: Int64 } let p = Point { x = 10L, y = 20L } in match p with | value -> if value.y == 20L && value.x == 10L then 1L else 0L = 1L

// Record with arithmetic on fields
type Point = { x: Int64, y: Int64 } let p = Point { x = 5L, y = 3L } in p.x + p.y = 8L

// Record with three fields
type Vec3 = { x: Int64, y: Int64, z: Int64 } let v = Vec3 { x = 1L, y = 2L, z = 3L } in v.x + v.y + v.z = 6L

// Nested let with record
type Point = { x: Int64, y: Int64 } let a = Point { x = 100L, y = 200L } in let b = a.x in b = 100L

// Multiple records
type Point = { x: Int64, y: Int64 } let a = Point { x = 1L, y = 2L } in let b = Point { x = 3L, y = 4L } in a.x + b.y = 5L

// Record with negative values
type Point = { x: Int64, y: Int64 } let p = Point { x = -5L, y = 10L } in p.x + p.y = 5L

// Record with zero
type Point = { x: Int64, y: Int64 } let p = Point { x = 0L, y = 42L } in p.y = 42L

// ===================================================================
// Records with String Fields
// ===================================================================

// Record with string field
type Person = { name: String, age: Int64 }
let p = Person { name = "Alice", age = 30L } in p.name = "Alice"
let p = Person { name = "Bob", age = 25L } in p.age = 25L

// Record with only string fields
type Names = { first: String, last: String }
let n = Names { first = "John", last = "Doe" } in n.first = "John"
let n = Names { first = "John", last = "Doe" } in n.last = "Doe"

// ===================================================================
// Records with Float Fields
// ===================================================================

// Record with float field
type Circle = { radius: Float, x: Int64, y: Int64 }
let c = Circle { radius = 3.14, x = 0L, y = 0L } in c.radius = 3.14
let c = Circle { radius = 2.5, x = 10L, y = 20L } in c.x = 10L

// Generic record printing substitutes concrete field types
type GenericDisplayBox<'t> = { value: t } GenericDisplayBox { value = "hi" } = stdout="GenericDisplayBox<String> { value: \"hi\" }\n" stderr=""

// Record with all float fields
type Vec2f = { x: Float, y: Float }
let v = Vec2f { x = 1.5, y = 2.5 } in v.x = 1.5
let v = Vec2f { x = 1.5, y = 2.5 } in v.y = 2.5
let v = Vec2f { x = 1.5, y = 2.5 } in v.x + v.y = 4.0

// ===================================================================
// Records with Bool Fields
// ===================================================================

// Record with bool field
type Config = { enabled: Bool, value: Int64 }
let c = Config { enabled = true, value = 42L } in c.enabled = true
let c = Config { enabled = false, value = 0L } in c.enabled = false
let c = Config { enabled = true, value = 42L } in c.value = 42L

// ===================================================================
// Records with Many Fields
// ===================================================================

// Record with 5 fields
type BigRecord = { a: Int64, b: Int64, c: Int64, d: Int64, e: Int64 }
let r = BigRecord { a = 1L, b = 2L, c = 3L, d = 4L, e = 5L } in r.a + r.b + r.c + r.d + r.e = 15L
let r = BigRecord { a = 10L, b = 20L, c = 30L, d = 40L, e = 50L } in r.e = 50L

// Record with 6 fields
type SixFields = { f1: Int64, f2: Int64, f3: Int64, f4: Int64, f5: Int64, f6: Int64 }
let r = SixFields { f1 = 1L, f2 = 2L, f3 = 3L, f4 = 4L, f5 = 5L, f6 = 6L } in r.f6 = 6L

// ===================================================================
// Mixed Type Records
// ===================================================================

// Record with string, int, bool
type User = { name: String, age: Int64, active: Bool }
let u = User { name = "Alice", age = 30L, active = true } in u.name = "Alice"
let u = User { name = "Alice", age = 30L, active = true } in u.age = 30L
let u = User { name = "Alice", age = 30L, active = true } in u.active = true

// Record with float and string (using 19.75 which is exactly representable in binary)
type Product = { name: String, price: Float }
let p = Product { name = "Widget", price = 19.75 } in p.name = "Widget"
let p = Product { name = "Widget", price = 19.75 } in p.price = 19.75

// ===================================================================
// Record field type inference with floats (kills mutation #115)
// Tests that record field access correctly infers types for fields
// at later positions. If the type lookup uses > instead of < for
// index bounds checking, field types would be incorrectly inferred.
// ===================================================================

// Record with float in second field - verify float arithmetic works
type Pair = { first: Int64, second: Float }
let p = Pair { first = 1L, second = 2.5 } in p.second * 2.0 = 5.0

// Record with float in third field - verify correct type at index 2
type Triple = { a: Int64, b: Int64, c: Float }
let t = Triple { a = 1L, b = 2L, c = 3.5 } in t.c + 1.5 = 5.0

// Record with float in middle position
type Middle = { x: Int64, y: Float, z: Int64 }
let m = Middle { x = 10L, y = 1.5, z = 20L } in m.y * 4.0 = 6.0

// Record with all floats - verify all field positions get float type
type AllFloats = { a: Float, b: Float, c: Float }
let r = AllFloats { a = 1.0, b = 2.0, c = 3.0 } in r.a + r.b + r.c = 6.0

// ===================================================================
// Record Update Tests (kills mutation #139)
// Tests record update syntax: { record with field = value }
// Mutation #139 changes || to && in varOccursInExpr for RecordUpdate,
// which would cause dead code elimination to incorrectly remove
// variables that only appear in the record or only in updates.
// ===================================================================

// Record update where variable only appears in the record part
type Point = { x: Int64, y: Int64 }
let p = Point { x = 10L, y = 20L } in { p with x = 5L }.y = 20L

// Record update where a later field is replaced and earlier fields are preserved
type Point = { x: Int64, y: Int64 }
let p = Point { x = 10L, y = 20L } in { p with y = 5L }.x = 10L
let p = Point { x = 10L, y = 20L } in { p with y = 5L }.y = 5L

// Record update on a three-field record preserves all untouched fields
type Vec3 = { x: Int64, y: Int64, z: Int64 }
let v = Vec3 { x = 10L, y = 20L, z = 30L } in { v with z = 5L }.x + { v with z = 5L }.y + { v with z = 5L }.z = 35L

// Record update where variable only appears in the update part
type Point = { x: Int64, y: Int64 }
let ``val`` = 100L in { Point { x = 1L, y = 2L } with x = ``val`` }.x = 100L

// Canonical validation, generic identity, nesting, ordering, and rendering.
type PhantomRecord<'unused> = { value: Int64 }
PhantomRecord<String> { value = 7L } = stdout="PhantomRecord<String> { value: 7 }\n" stderr=""

type MixedPhantomRecord<'unused, 'value> = { value: 'value }
MixedPhantomRecord<Int64, String> { value = "managed" } = stdout="MixedPhantomRecord<Int64, String> { value: \"managed\" }\n" stderr=""

type GenericInner<'a> = { value: a }
type GenericOuter<'a> = { inner: GenericInner<a> }
let outer = GenericOuter<String> { inner = GenericInner<String> { value = "nested" } } in outer.inner.value = "nested"

type GenericInner<'a> = { value: a }
type GenericOuter<'a> = { inner: GenericInner<a> }
let outer = GenericOuter<String> { inner = GenericInner<String> { value = "before" } } in { outer with inner = { outer.inner with value = "after" } }.inner.value = "after"

type AliasRecord<'a> = { value: a }
type AliasRecordView<'a> = AliasRecord<'a>
AliasRecordView<String> { value = "alias" } == AliasRecord<String> { value = "alias" } = true

type OrderedPresentation = { z: Int64; a: String }
OrderedPresentation { z = 2L; a = "first" } = stdout="OrderedPresentation { a: \"first\", z: 2 }\n" stderr=""

type DuplicateDeclarationField = { value: Int64; value: String }
DuplicateDeclarationField { value = 7L }.value = 7L

type DuplicateConstruction = { value: Int64 }
DuplicateConstruction { value = 1L; value = 2L } = error="Duplicate field `value`"

type MissingConstruction = { first: Int64; second: Int64 }
MissingConstruction { first = 1L } = error="Missing fields in record literal: second"

type UnknownConstruction = { value: Int64 }
UnknownConstruction { value = 1L; other = 2L } = error="Unknown fields in record literal: other"

type EmptyConstructionKey = { value: Int64 }
EmptyConstructionKey { ___ = 1L } = error="Empty key in record creation"

type ExplicitArity<'a> = { value: a }
ExplicitArity<Int64, String> { value = 1L } = error="Record type argument arity mismatch: expected 1, got 2"

type UpdateLastWins = { value: Int64; untouched: String }
let original = UpdateLastWins { value = 1L; untouched = "kept" } in let updated = { original with value = 2L; value = 3L } in updated.value = 3L

type InvalidUpdate = { value: Int64 }
let original = InvalidUpdate { value = 1L } in { original with other = 2L } = error="Unknown fields in record update: other"

type InvalidUpdate = { value: Int64 }
let original = InvalidUpdate { value = 1L } in { original with ___ = 2L } = error="Empty key in record update"

type AccessDiagnostics = { value: Int64 }
let record = AccessDiagnostics { value = 1L } in record.___ = error="Field name is empty"

type AccessDiagnostics = { value: Int64 }
let record = AccessDiagnostics { value = 1L } in record.other = error="Tried to access field 'other' but record type AccessDiagnostics has no such field"

let nonRecord = 1L in nonRecord.value = error="Attempting to access field 'value' on non-record type Int64"

type LongRenderedRecord = { alpha: String; beta: String }
LongRenderedRecord { alpha = "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz"; beta = "abcdefghijklmnopqrstuvwxyz" } = stdout="LongRenderedRecord {\n  alpha: \"abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz\",\n  beta: \"abcdefghijklmnopqrstuvwxyz\"\n}\n" stderr=""
