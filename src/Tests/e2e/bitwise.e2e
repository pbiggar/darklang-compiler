// Bitwise Operators Tests
//
// Tests covering:
// - Left shift (<<)
// - Right shift (>>)
// - Bitwise AND (&)
// - Bitwise XOR (^)
// - Bitwise NOT (~~~)
// Note: Bitwise OR (|) is not available as operator due to conflict with pattern matching.
// Use Stdlib.Int64.bitwiseOr function instead.


// ===================================================================
// Left Shift (<<)
// ===================================================================

// Basic shifts
1L << 0L = 1L
1L << 1L = 2L
1L << 2L = 4L
1L << 3L = 8L
1L << 4L = 16L
1L << 5L = 32L
1L << 6L = 64L
1L << 7L = 128L
1L << 8L = 256L

// Shifting larger values
2L << 1L = 4L
2L << 2L = 8L
3L << 1L = 6L
3L << 2L = 12L
5L << 3L = 40L
10L << 4L = 160L

// Int32 shifts
1l << 1l = 2l

// Shifting by 0
42L << 0L = 42L
100L << 0L = 100L

// Large shifts
1L << 16L = 65536L
1L << 20L = 1048576L
1L << 30L = 1073741824L
1L << 31L = 2147483648L
1L << 32L = 4294967296L
1L << 62L = 4611686018427387904L


// ===================================================================
// Right Shift (>>)
// ===================================================================

// Basic shifts
256L >> 0L = 256L
256L >> 1L = 128L
256L >> 2L = 64L
256L >> 3L = 32L
256L >> 4L = 16L
256L >> 5L = 8L
256L >> 6L = 4L
256L >> 7L = 2L
256L >> 8L = 1L

// Shifting larger values
100L >> 1L = 50L
100L >> 2L = 25L
64L >> 3L = 8L
128L >> 4L = 8L

// Shift to zero
1L >> 1L = 0L
3L >> 2L = 0L
7L >> 3L = 0L
15L >> 4L = 0L

// Large number shifts
1073741824L >> 30L = 1L
4294967296L >> 32L = 1L
4611686018427387904L >> 62L = 1L


// ===================================================================
// Bitwise AND (&)
// ===================================================================

// Basic AND
0L & 0L = 0L
1L & 0L = 0L
0L & 1L = 0L
1L & 1L = 1L

// With larger values
255L & 0L = 0L
255L & 255L = 255L
255L & 15L = 15L
15L & 255L = 15L

// Binary patterns
// 0b1100 & 0b1010 = 0b1000 = 8
12L & 10L = 8L
// 0b1111 & 0b1010 = 0b1010 = 10
15L & 10L = 10L
// 0b10101010 & 0b01010101 = 0 (alternating bits)
170L & 85L = 0L
// 0b11111111 & 0b10101010 = 0b10101010
255L & 170L = 170L

// Masking operations
256L & 255L = 0L
257L & 255L = 1L
258L & 255L = 2L
1000L & 255L = 232L


// ===================================================================
// Bitwise XOR (^)
// ===================================================================

// Basic XOR
0L ^ 0L = 0L
1L ^ 0L = 1L
0L ^ 1L = 1L
1L ^ 1L = 0L

// XOR with same value = 0
42L ^ 42L = 0L
255L ^ 255L = 0L
1000L ^ 1000L = 0L

// Binary patterns
// 0b1100 ^ 0b1010 = 0b0110 = 6
12L ^ 10L = 6L
// 0b1111 ^ 0b1010 = 0b0101 = 5
15L ^ 10L = 5L
// 0b10101010 ^ 0b01010101 = 0b11111111 = 255
170L ^ 85L = 255L
// 0b11111111 ^ 0b10101010 = 0b01010101 = 85
255L ^ 170L = 85L

// Toggle bits
255L ^ 1L = 254L
255L ^ 128L = 127L


// ===================================================================
// Bitwise NOT (~~~)
// ===================================================================

// Basic NOT - inverts all bits
~~~0L = -1L // 0 -> all 1s (signed -1)
~~~1L = -2L // 0b...0001 -> 0b...1110 (signed -2)
~~~2L = -3L // 0b...0010 -> 0b...1101 (signed -3)
~~~(-1L) = 0L // all 1s -> 0

// Bit patterns
~~~255L = -256L // 0x00FF -> 0xFF00 (sign-extended)
~~~256L = -257L // 0x0100 -> 0xFEFF
~~~127L = -128L // 0x7F -> 0x80

// Double negation is identity
~~~(~~~0L) = 0L
~~~(~~~1L) = 1L
~~~(~~~42L) = 42L
~~~(~~~(-1L)) = -1L
~~~(~~~9223372036854775807L) = 9223372036854775807L

// Property: x XOR ~~~x = -1 (all bits set)
(0L ^ ~~~0L) = -1L
(1L ^ ~~~1L) = -1L
(42L ^ ~~~42L) = -1L
(255L ^ ~~~255L) = -1L

// Property: x AND ~~~x = 0 (no common bits)
(0L & ~~~0L) = 0L
(1L & ~~~1L) = 0L
(42L & ~~~42L) = 0L
(255L & ~~~255L) = 0L

// Property: x OR ~~~x = -1 (all bits set)
Stdlib.Int64.bitwiseOr(0L, ~~~0L) = -1L
Stdlib.Int64.bitwiseOr(1L, ~~~1L) = -1L
Stdlib.Int64.bitwiseOr(42L, ~~~42L) = -1L
Stdlib.Int64.bitwiseOr(255L, ~~~255L) = -1L

// Combined with shifts
~~~(1L << 0L) = -2L// Clear bit 0 (inverted)
~~~(1L << 3L) = -9L// Clear bit 3 (inverted)
~~~(1L << 7L) = -129L// Clear bit 7 (inverted)
~~~(1L << 63L) = 9223372036854775807L// Min int -> Max int

// Masking patterns with NOT
(~~~255L) & 65535L = 65280L// Mask out low byte: 0xFF00

// De Morgan's Law: ~~~(a & b) = (~~~a) | (~~~b)
~~~(12L & 10L) = -9L// ~~~8 = -9
Stdlib.Int64.bitwiseOr(~~~12L, ~~~10L) = -9L

// Constant folding verification (in variables)
let x = 42L in ~~~x = -43L
let y = -1L in ~~~y = 0L
let z = 0L in ~~~z = -1L


// ===================================================================
// Sized Integer Bitwise Ops
// ===================================================================

1y & 3y = 1y
1y ^ 3y = 2y
5y << 1y = 10y
5y >> 1y = 2y
~~~1y = -2y
// Regression: unsigned bitwise-not must preserve UInt8, not widen via TInt64 fallback.
~~~1uy = 254uy
// Regression: MIR constant folding must preserve the result width for UInt32 bitwise-not.
~~~0ul = 4294967295ul


// ===================================================================
// Wrapping Negation for Bit Manipulation
// ===================================================================

// Basic wrapping negation (two's complement)
0L - 12L = -12L// Same as unary negation

// Lowest set bit pattern: x & -x (used in nqueen)
let x = 12L in x & (0L - x) = 4L// 12 = 0b1100, lowest bit at position 2 = 4
let x = 8L in x & (0L - x) = 8L// 8 = 0b1000, power of 2, result = 8
let x = 7L in x & (0L - x) = 1L// 7 = 0b0111, lowest bit = 1
let x = 1L in x & (0L - x) = 1L// 1 = 0b0001, lowest bit = 1

// Clear lowest set bit: x & (x - 1)
let x = 12L in x & (x - 1L) = 8L// 12 = 0b1100 -> 0b1000 = 8
let x = 8L in x & (x - 1L) = 0L// 8 = 0b1000 -> 0b0000 = 0
let x = 7L in x & (x - 1L) = 6L// 7 = 0b0111 -> 0b0110 = 6

// nqueen availability check pattern
let avail = 23L in let pos = avail & (0L - avail) in pos = 1L// 23 = 0b10111, lowest = 1
let avail = 22L in let pos = avail & (0L - avail) in pos = 2L// 22 = 0b10110, lowest = 2
let avail = 20L in let pos = avail & (0L - avail) in pos = 4L// 20 = 0b10100, lowest = 4


// ===================================================================
// Combined Operations
// ===================================================================

// Shift and AND (common masking pattern)
(256L >> 1L) & 255L = 128L
(1L << 8L) & 255L = 0L
((1L << 4L) - 1L) = 15L

// Extracting bits
(255L >> 4L) & 15L = 15L
(240L >> 4L) & 15L = 15L
(128L >> 7L) & 1L = 1L
(127L >> 7L) & 1L = 0L


// ===================================================================
// 64-bit Operations
// ===================================================================

// Powers of 2 via shift
1L << 10L = 1024L
1L << 40L = 1099511627776L
1L << 50L = 1125899906842624L

// Large number shifts
1L << 63L = -9223372036854775808L


// ===================================================================
// Stdlib Function Versions (coverage for function forms)
// ===================================================================

// Stdlib.Int64.bitwiseAnd
Stdlib.Int64.bitwiseAnd(12L, 10L) = 8L
Stdlib.Int64.bitwiseAnd(255L, 15L) = 15L
Stdlib.Int64.bitwiseAnd(0L, 255L) = 0L

// Stdlib.Int64.bitwiseXor
Stdlib.Int64.bitwiseXor(12L, 10L) = 6L
Stdlib.Int64.bitwiseXor(42L, 42L) = 0L
Stdlib.Int64.bitwiseXor(170L, 85L) = 255L

// Stdlib.Int64.shiftLeft
Stdlib.Int64.shiftLeft(1L, 4L) = 16L
Stdlib.Int64.shiftLeft(1L, 10L) = 1024L
Stdlib.Int64.shiftLeft(5L, 3L) = 40L

// Stdlib.Int64.shiftRight
Stdlib.Int64.shiftRight(16L, 4L) = 1L
Stdlib.Int64.shiftRight(1024L, 10L) = 1L
Stdlib.Int64.shiftRight(256L, 4L) = 16L

// Stdlib.Int64.bitwiseNot
Stdlib.Int64.bitwiseNot(0L) = -1L
Stdlib.Int64.bitwiseNot(1L) = -2L
Stdlib.Int64.bitwiseNot(-1L) = 0L
Stdlib.Int64.bitwiseNot(255L) = -256L
Stdlib.Int64.bitwiseNot(42L) = -43L
