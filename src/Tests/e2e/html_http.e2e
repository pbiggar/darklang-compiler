// Html and Http compatibility probes. The upstream interpreter-syntax fixtures
// provide the constructor-by-constructor surface; these cases pin AOT syntax,
// structural values, and frozen quirks absent from those fixtures.

// Blob bridge preserves UTF-8 bytes and the public empty module value.
Stdlib.Blob.toList (Stdlib.String.toBlob "Aé😀") = [65uy, 195uy, 169uy, 240uy, 159uy, 152uy, 128uy]
Stdlib.Blob.length Stdlib.Blob.empty = 0

// Canonical record and recursive sum constructors are public. Constructor calls
// throughout this file also exercise the alias-typed Attributes parameters.
Stdlib.Html.nodeToString (Stdlib.Html.Node.HtmlTag (Stdlib.Html.HtmlTag { name = "x", attrs = [], children = [] })) = "<x></x>"
Stdlib.Html.nodeToString (Stdlib.Html.Node.String "raw") = "raw"
type HtmlNodeAlias = Stdlib.Html.Node let htmlAliasNode (value: String): HtmlNodeAlias = Stdlib.Html.stringNode value let aliasNode = htmlAliasNode "alias" in Stdlib.Html.nodeToString aliasNode = stdout="\"alias\"\n" stderr=""

// Serialization boundaries: fixed escape order, raw attributes/comments,
// boolean attributes, void behavior, case sensitivity, and documents.
Stdlib.Html.escapeHtml "&<>'\"" = "&amp;&lt;&gt;&#x27;&quot;"
Stdlib.Html.nodeToString (Stdlib.Html.htmlTagNode "img" ([("alt", Some "<&"), ("hidden", None)]) ([Stdlib.Html.text "ignored"])) = "<img alt=\"<&\" hidden>"
Stdlib.Html.nodeToString (Stdlib.Html.htmlTagNode "IMG" ([]) ([])) = "<IMG></IMG>"
Stdlib.Html.nodeToString (Stdlib.Html.comment "<raw>") = "<!-- <raw> -->"
Stdlib.Html.document ([Stdlib.Html.html ([]) ([])]) = "<!DOCTYPE html><html></html>"

// Complete interpreter constructor family.
Stdlib.List.map ([Stdlib.Html.br (), Stdlib.Html.html ([]) ([]), Stdlib.Html.body ([]) ([]), Stdlib.Html.head ([]) ([]), Stdlib.Html.title ([]) ([]), Stdlib.Html.a ([]) ([]), Stdlib.Html.div ([]) ([]), Stdlib.Html.span ([]) ([]), Stdlib.Html.h1 ([]) ([]), Stdlib.Html.h2 ([]) ([]), Stdlib.Html.h3 ([]) ([]), Stdlib.Html.h4 ([]) ([]), Stdlib.Html.h5 ([]) ([]), Stdlib.Html.h6 ([]) ([]), Stdlib.Html.p ([]) ([]), Stdlib.Html.ul ([]) ([]), Stdlib.Html.ol ([]) ([]), Stdlib.Html.li ([]) ([]), Stdlib.Html.table ([]) ([]), Stdlib.Html.tr ([]) ([]), Stdlib.Html.td ([]) ([]), Stdlib.Html.th ([]) ([]), Stdlib.Html.tbody ([]) ([]), Stdlib.Html.thead ([]) ([]), Stdlib.Html.tfoot ([]) ([]), Stdlib.Html.caption ([]) ([]), Stdlib.Html.colgroup ([]) ([]), Stdlib.Html.col ([]) ([]), Stdlib.Html.button ([]) ([]), Stdlib.Html.img ([]), Stdlib.Html.svg ([]) ([]), Stdlib.Html.path ([]), Stdlib.Html.meta ([]), Stdlib.Html.link ([]), Stdlib.Html.script ([]) ([]), Stdlib.Html.input ([]), Stdlib.Html.label ([]) ([]), Stdlib.Html.form ([]) ([]), Stdlib.Html.section ([]) ([]), Stdlib.Html.i ([]) ([]), Stdlib.Html.code ([]) ([]), Stdlib.Html.pre ([]) ([]), Stdlib.Html.nav ([]) ([]), Stdlib.Html.footer ([]) ([]), Stdlib.Html.article ([]) ([]), Stdlib.Html.aside ([]) ([]), Stdlib.Html.header ([]) ([]), Stdlib.Html.main ([]) ([]), Stdlib.Html.figure ([]) ([]), Stdlib.Html.figcaption ([]) ([]), Stdlib.Html.video ([]) ([]), Stdlib.Html.audio ([]) ([]), Stdlib.Html.picture ([]) ([]), Stdlib.Html.strong ([]) ([]), Stdlib.Html.em ([]) ([]), Stdlib.Html.b ([]) ([]), Stdlib.Html.u ([]) ([]), Stdlib.Html.small ([]) ([]), Stdlib.Html.mark ([]) ([]), Stdlib.Html.del ([]) ([]), Stdlib.Html.ins ([]) ([]), Stdlib.Html.dl ([]) ([]), Stdlib.Html.dt ([]) ([]), Stdlib.Html.dd ([]) ([]), Stdlib.Html.textarea ([]) ([]), Stdlib.Html.select ([]) ([]), Stdlib.Html.option ([]) ([]), Stdlib.Html.fieldset ([]) ([]), Stdlib.Html.legend ([]) ([]), Stdlib.Html.details ([]) ([]), Stdlib.Html.summary ([]) ([]), Stdlib.Html.dialog ([]) ([])]) (fun node -> Stdlib.Html.nodeToString node) =
  ["<br>", "<html></html>", "<body></body>", "<head></head>", "<title></title>", "<a></a>", "<div></div>", "<span></span>", "<h1></h1>", "<h2></h2>", "<h3></h3>", "<h4></h4>", "<h5></h5>", "<h6></h6>", "<p></p>", "<ul></ul>", "<ol></ol>", "<li></li>", "<table></table>", "<tr></tr>", "<td></td>", "<th></th>", "<tbody></tbody>", "<thead></thead>", "<tfoot></tfoot>", "<caption></caption>", "<colgroup></colgroup>", "<col>", "<button></button>", "<img>", "<svg></svg>", "<path></path>", "<meta>", "<link>", "<script></script>", "<input>", "<label></label>", "<form></form>", "<section></section>", "<i></i>", "<code></code>", "<pre></pre>", "<nav></nav>", "<footer></footer>", "<article></article>", "<aside></aside>", "<header></header>", "<main></main>", "<figure></figure>", "<figcaption></figcaption>", "<video></video>", "<audio></audio>", "<picture></picture>", "<strong></strong>", "<em></em>", "<b></b>", "<u></u>", "<small></small>", "<mark></mark>", "<del></del>", "<ins></ins>", "<dl></dl>", "<dt></dt>", "<dd></dd>", "<textarea></textarea>", "<select></select>", "<option></option>", "<fieldset></fieldset>", "<legend></legend>", "<details></details>", "<summary></summary>", "<dialog></dialog>"]

// Request records and parser edge behavior.
let req = Stdlib.Http.Request { url = "https://x?a=1&a=2&bare&bad=a=b&&q=?", headers = [("X", "1")], body = Stdlib.String.toBlob "body" } in req.url = "https://x?a=1&a=2&bare&bad=a=b&&q=?"
Stdlib.Http.parseQueryString "https://x?x=1&&x=2&bare&token=a=b&q=?" = Stdlib.Dict.fromListOverwritingDuplicates ([("x", "2"), ("bare", ""), ("token", "a=b"), ("q", "?")])
Stdlib.Http.parseQueryString "https://x?a+b=%2F" = Stdlib.Dict.fromListOverwritingDuplicates ([("a+b", "%2F")])
Stdlib.Http.parseHeaders " A : one\r\nmalformed\r\nA: two:three\r\n : blank-name " = Stdlib.Dict.fromListOverwritingDuplicates ([("A", "two:three"), ("", "blank-name")])

// Frozen Request accessors intentionally differ from parseQueryString.
let req = Stdlib.Http.Request { url = "https://x", headers = [], body = Stdlib.Blob.empty } in Stdlib.Http.Request.queryParams req = [("", "")]
let req = Stdlib.Http.Request { url = "https://x?", headers = [], body = Stdlib.Blob.empty } in Stdlib.Http.Request.queryParams req = [("", "")]
let req = Stdlib.Http.Request { url = "https://x?a=1&a=2&bad=a=b&bare", headers = [], body = Stdlib.Blob.empty } in Stdlib.Http.Request.queryParams req = [("a", "1"), ("a", "2"), ("bad=a=b", ""), ("bare", "")]
let req = Stdlib.Http.Request { url = "https://x?a=1&a=2", headers = [], body = Stdlib.Blob.empty } in Stdlib.Http.Request.queryParam req "a" = Some "1,2"
let req = Stdlib.Http.Request { url = "https://x?a=1", headers = [], body = Stdlib.Blob.empty } in Stdlib.Http.Request.queryParam req "missing" = None

// Response helpers preserve status, header spelling/order, bytes, raw JSON,
// arbitrary redirects, and duplicate ordered Set-Cookie header pairs.
let r = Stdlib.Http.response (Stdlib.String.toBlob "ok") 201 in (r.statusCode, r.headers, Stdlib.Blob.toString r.body) = (201, [], Ok "ok")
let r = Stdlib.Http.responseWithHeaders (Stdlib.String.toBlob "x") ([("Set-Cookie", "a=1"), ("Set-Cookie", "b=2")]) 202 in r.headers = [("Set-Cookie", "a=1"), ("Set-Cookie", "b=2")]
let r = Stdlib.Http.success (Stdlib.String.toBlob "yes") in (r.statusCode, Stdlib.Blob.toString r.body) = (200, Ok "yes")
let r = Stdlib.Http.responseWithHtml "<b>x</b>" 203 in (r.statusCode, r.headers, Stdlib.Blob.toString r.body) = (203, [("Content-Type", "text/html; charset=utf-8")], Ok "<b>x</b>")
let r = Stdlib.Http.responseWithText "hello" 204 in (r.statusCode, r.headers, Stdlib.Blob.toString r.body) = (204, [("Content-Type", "text/plain; charset=utf-8")], Ok "hello")
let r = Stdlib.Http.responseWithJson "{\"already\":true}" 205 in (r.statusCode, r.headers, Stdlib.Blob.toString r.body) = (205, [("Content-Type", "application/json")], Ok "{\"already\":true}")
let r = Stdlib.Http.redirectTo "bad url" in (r.statusCode, r.headers, Stdlib.Blob.length r.body) = (302, [("Location", "bad url")], 0)
let r = Stdlib.Http.badRequest "bad" in (r.statusCode, Stdlib.Blob.toString r.body) = (400, Ok "bad")
let r = Stdlib.Http.notFound () in (r.statusCode, r.headers, Stdlib.Blob.length r.body) = (404, [], 0)
let r = Stdlib.Http.unauthorized () in (r.statusCode, Stdlib.Blob.length r.body) = (401, 0)
let r = Stdlib.Http.forbidden () in (r.statusCode, Stdlib.Blob.length r.body) = (403, 0)
let r = Stdlib.Http.serverError "boom" in (r.statusCode, Stdlib.Blob.toString r.body) = (500, Ok "boom")

// Cookie is a structural value only at the pinned revision.
let c = Stdlib.Http.Cookie { expires = Stdlib.DateTime.fromSeconds 0, maxAge = 60, domain = "example.com", path = "/", secure = true, httpOnly = true, sameSite = "Strict" } in (c.maxAge, c.secure, c.sameSite) = (60, true, "Strict")
