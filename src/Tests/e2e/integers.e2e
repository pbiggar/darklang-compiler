// Integer Tests - Comprehensive integer arithmetic test suite
//
// Tests covering:
// - Boundary values (8-bit, 32-bit, 64-bit)
// - Zero and identity operations
// - Powers of 2
// - Overflow and underflow at 32-bit and 64-bit boundaries
// - Special cases (INT64_MIN negation overflow, etc.)


// ===================================================================
// Basic Boundary Values
// ===================================================================

// Boundary values - basic
1L = 1L// minimum positive
254L = 254L
255L = 255L
256L = 256L
257L = 257L

// Boundary values - edge of byte boundaries
127L = 127L// max signed byte (if using signed)
128L = 128L// min negative as unsigned
253L = 253L
254L = 254L
255L = 255L


// ===================================================================
// Zero and Identity Operations
// ===================================================================

// Zero operations
0L + 0L = 0L
0L - 0L = 0L
0L * 0L = 0L
0L * 1L = 0L
0L * 255L = 0L
1L * 0L = 0L
255L * 0L = 0L

// Identity operations
1L + 0L = 1L
0L + 1L = 1L
5L - 0L = 5L
1L * 1L = 1L
5L * 1L = 5L
1L * 5L = 5L
10L / 1L = 10L
5L / 5L = 1L


// ===================================================================
// Powers of 2
// ===================================================================

1L = 1L// 2^0
2L = 2L// 2^1
4L = 4L// 2^2
8L = 8L// 2^3
16L = 16L// 2^4
32L = 32L// 2^5
64L = 64L// 2^6
128L = 128L// 2^7
2L * 2L = 4L
2L * 2L * 2L = 8L
2L * 2L * 2L * 2L = 16L
4L * 4L = 16L
8L * 8L = 64L
16L * 16L = 256L


// ===================================================================
// Addition and Subtraction with Large Results
// ===================================================================

// Addition tests with large results
255L + 1L = 256L
255L + 2L = 257L
255L + 255L = 510L
200L + 100L = 300L
128L + 128L = 256L
127L + 129L = 256L
100L + 200L = 300L
150L + 150L = 300L

// Subtraction tests (positive results)
10L - 3L = 7L
20L - 5L = 15L
100L - 50L = 50L
255L - 1L = 254L
255L - 100L = 155L


// ===================================================================
// Multiplication and Division with Large Results
// ===================================================================

// Multiplication tests with large results
16L * 16L = 256L
16L * 17L = 272L
15L * 17L = 255L
15L * 18L = 270L
20L * 20L = 400L
25L * 25L = 625L
50L * 50L = 2500L
100L * 100L = 10000L
128L * 2L = 256L
64L * 4L = 256L
32L * 8L = 256L

// Division edge cases
1L / 1L = 1L
255L / 1L = 255L
255L / 255L = 1L
256L / 2L = 128L// 256 doesn't wrap before division
100L / 10L = 10L
99L / 10L = 9L// integer division truncates
10L / 3L = 3L// 10 / 3 = 3 remainder 1
7L / 2L = 3L// 7 / 2 = 3 remainder 1
1L / 2L = 0L// rounds down to 0


// ===================================================================
// Large Number Combinations
// ===================================================================

1000L + 2000L = 3000L
1000L * 1000L = 1000000L
10000L - 5000L = 5000L
500L + 500L = 1000L
999L = 999L
1024L = 1024L
2048L = 2048L
4096L = 4096L


// ===================================================================
// Sequential and Mixed Operations
// ===================================================================

// Sequential operations
255L + 1L + 1L = 257L
128L + 128L + 1L = 257L
100L + 100L + 100L = 300L

// Mixed operations (positive results)
255L + 1L - 1L = 255L
200L + 100L - 50L = 250L
100L * 3L - 50L = 250L
50L * 2L + 100L = 200L


// ===================================================================
// 32-bit Boundary Tests
// ===================================================================

// INT32_MAX = 2,147,483,647
// INT32_MIN = -2,147,483,648

// 32-bit maximum and minimum
2147483647L = 2147483647L// INT32_MAX
-2147483648L = -2147483648L// INT32_MIN

// Operations at 32-bit boundaries
2147483647L + 1L = 2147483648L// INT32_MAX + 1
2147483647L + 2147483647L = 4294967294L// INT32_MAX + INT32_MAX
-2147483648L - 1L = -2147483649L// INT32_MIN - 1
-2147483648L + -2147483648L = -4294967296L// INT32_MIN + INT32_MIN

// Multiplication near 32-bit boundaries
65536L * 65536L = 4294967296L// 2^32
32768L * 65536L = 2147483648L// 2^31
100000L * 100000L = 10000000000L
1000000L * 1000L = 1000000000L

// Division with 32-bit values
2147483647L / 2L = 1073741823L// INT32_MAX / 2
-2147483648L / 2L = -1073741824L// INT32_MIN / 2
4294967296L / 2L = 2147483648L// 2^32 / 2


// ===================================================================
// 64-bit Boundary Tests
// ===================================================================

// INT64_MAX = 9,223,372,036,854,775,807
// INT64_MIN = -9,223,372,036,854,775,808

// 64-bit maximum and minimum
9223372036854775807L = 9223372036854775807L// INT64_MAX
-9223372036854775808L = -9223372036854775808L// INT64_MIN

// Operations at 64-bit boundaries (overflow wraps around)
9223372036854775807L + 1L = -9223372036854775808L// INT64_MAX + 1 wraps to INT64_MIN
9223372036854775807L + 2L = -9223372036854775807L// INT64_MAX + 2
-9223372036854775808L - 1L = 9223372036854775807L// INT64_MIN - 1 wraps to INT64_MAX
-9223372036854775808L - 2L = 9223372036854775806L// INT64_MIN - 2

// Addition overflow
9223372036854775807L + 9223372036854775807L = -2L// INT64_MAX + INT64_MAX
9000000000000000000L + 9000000000000000000L = -446744073709551616L// Large + Large
5000000000000000000L + 5000000000000000000L = -8446744073709551616L// Overflow

// Subtraction underflow
-9000000000000000000L - 9000000000000000000L = 446744073709551616L
-5000000000000000000L - 5000000000000000000L = 8446744073709551616L

// Multiplication (large values within 64-bit range)
1000000000L * 1000000000L = 1000000000000000000L// 10^9 * 10^9 = 10^18 (fits in 64-bit)
3000000000L * 3000000000L = 9000000000000000000L// 3*10^9 * 3*10^9 = 9*10^18 (fits in 64-bit)
4294967296L * 4294967296L = 0L// 2^32 * 2^32 = 2^64 = 0 (wraps)

// Powers of 2 at boundaries
4611686018427387904L = 4611686018427387904L// 2^62
9223372036854775807L = 9223372036854775807L// 2^63 - 1

// Large number operations
1000000000000000000L = 1000000000000000000L// 10^18

// UInt64 values above Int64 max must format as unsigned decimal, not signed bits
Stdlib.UInt64.toString(9223372036854775808UL) = "9223372036854775808"
Stdlib.UInt64.toString(18446744073709551615UL) = "18446744073709551615"
1000000000000000000L + 1000000000000000000L = 2000000000000000000L
1000000000000000000L * 2L = 2000000000000000000L
1000000000000000000L * 10L = -8446744073709551616L// 10^19 overflows


// ===================================================================
// Mixed Boundary Operations
// ===================================================================

// Crossing from 32-bit to 64-bit range
2147483647L * 2L = 4294967294L// INT32_MAX * 2 (still in 64-bit range)
2147483647L * 4L = 8589934588L// INT32_MAX * 4
2147483647L * 1000000L = 2147483647000000L

// Operations that stay within 32-bit range
1000000000L + 1000000000L = 2000000000L
1000000L * 2000L = 2000000000L
2000000000L / 2L = 1000000000L

// Near-boundary division
9223372036854775807L / 2L = 4611686018427387903L// INT64_MAX / 2
9223372036854775807L / 9223372036854775807L = 1L// INT64_MAX / INT64_MAX


// ===================================================================
// Special INT64_MIN Cases
// ===================================================================

// INT64_MIN is special: -INT64_MIN overflows to INT64_MIN
// (because abs(INT64_MIN) = INT64_MAX + 1, which doesn't fit)
-(-9223372036854775808L) = -9223372036854775808L// -INT64_MIN = INT64_MIN (overflow)

// INT64_MIN operations
-9223372036854775808L + 1L = -9223372036854775807L
-9223372036854775808L * 1L = -9223372036854775808L
-9223372036854775808L * -1L = -9223372036854775808L// Overflow: should be INT64_MAX+1
-9223372036854775808L / 1L = -9223372036854775808L
-9223372036854775808L / -1L = -9223372036854775808L// Overflow case


// ===================================================================
// Modulo Operations
// ===================================================================

// Basic modulo
10L % 3L = 1L
7L % 2L = 1L
8L % 2L = 0L
15L % 5L = 0L
17L % 5L = 2L
100L % 7L = 2L
255L % 10L = 5L

// Modulo with larger numbers
1000L % 7L = 6L
12345L % 100L = 45L
1000000L % 999L = 1L
2147483647L % 10L = 7L

// Modulo with negative dividend
-10L % 3L = 2L
-7L % 2L = 1L
-17L % 5L = 3L

// Modulo with negative divisor
10L % -3L = stdout="Error when executing Script. Call-stack:\nCall stack (last call at bottom):\n\nScript error: Cannot evaluate modulus against a negative number\n"
7L % -2L = stdout="Error when executing Script. Call-stack:\nCall stack (last call at bottom):\n\nScript error: Cannot evaluate modulus against a negative number\n"
17L % -5L = stdout="Error when executing Script. Call-stack:\nCall stack (last call at bottom):\n\nScript error: Cannot evaluate modulus against a negative number\n"

// Modulo with both negative
-10L % -3L = stdout="Error when executing Script. Call-stack:\nCall stack (last call at bottom):\n\nScript error: Cannot evaluate modulus against a negative number\n"
-7L % -2L = stdout="Error when executing Script. Call-stack:\nCall stack (last call at bottom):\n\nScript error: Cannot evaluate modulus against a negative number\n"
-17L % -5L = stdout="Error when executing Script. Call-stack:\nCall stack (last call at bottom):\n\nScript error: Cannot evaluate modulus against a negative number\n"

// Modulo edge cases
1L % 1L = 0L
0L % 5L = 0L
5L % 1L = 0L
255L % 256L = 255L

// Modulo with powers of 2 (common optimization case)
16L % 8L = 0L
17L % 8L = 1L
18L % 8L = 2L
31L % 16L = 15L
32L % 16L = 0L
33L % 16L = 1L


// ===================================================================
// Deeply Nested Expressions (Bug: Segfault with 4+ levels of nesting)
// ===================================================================

// These test cases found by fuzzer - currently cause segfaults
(((209L * 1L) * (-55L - -3L)) / (-1L + (-29L - -809L))) = -13L
(((-3L - -40L) + (-790L * 426L)) * ((-970L + -535L) * (-608L - 996L))) = -812324972060L


// ===================================================================
// Int64 Suffix (L) Tests
// ===================================================================

// The L suffix explicitly marks Int64 literals (same as default)
42L = 42L
1L + 2L = 3L
100L * 100L = 10000L
42L + 1L = 43L
1L + 42L = 43L
-42L = -42L
0L = 0L
9223372036854775807L = 9223372036854775807L
-9223372036854775808L = -9223372036854775808L


// ===================================================================
// Unary Negation for Sized Integers
// ===================================================================

let x = 1y in -x = -1y// neg int8 var
let x = 1s in -x = -1s// neg int16 var
let x = 1l in -x = -1l// neg int32 var
let x = 1L in -x = -1L// neg int64 var


// ===================================================================
// Int128/UInt128 Literal Identity Tests
// ===================================================================

// These literals are > 64-bit and must not wrap into Int64/UInt64 space.
(18446744073709551616Q == 0Q) = false
(18446744073709551617Q == 1Q) = false
(18446744073709551616Z == 0Z) = false
(18446744073709551617Z == 1Z) = false

// Literal boundaries and identity checks.
0Q = 0Q
-1Q = -1Q
170141183460469231731687303715884105727Q = 170141183460469231731687303715884105727Q
-170141183460469231731687303715884105728Q = -170141183460469231731687303715884105728Q
0Z = 0Z
340282366920938463463374607431768211455Z = 340282366920938463463374607431768211455Z

let i128 = 170141183460469231731687303715884105727Q in i128 == 170141183460469231731687303715884105727Q = true
let u128 = 340282366920938463463374607431768211455Z in u128 == 340282366920938463463374607431768211455Z = true
