// Reference Counting Tests
//
// Tests for reference counting behavior with memory reuse via free list.
//
// Implementation status:
// - RefCountDec is inserted at END of scope (before Return)
// - Free list logic is fully implemented
// - Memory is reclaimed and reused when ref count hits 0
// - Borrowed values (TupleGet, aliases) don't get their own Dec

// ===================================================================
// Basic tuple creation and use - should work correctly
// ===================================================================

// Simple tuple
let t = (1, 2) in let (first, second) = t in first + second = 3

// Tuple destructuring
let (a, b) = (10, 20) in a + b = 30

// Multiple tuples
let t1 = (1, 2) in let t2 = (3, 4) in let (first, _) = t1 in let (_, fourth) = t2 in first + fourth = 5

// ===================================================================
// Tests for correct RefCountDec placement
// Dec should happen at END of scope, not start
// ===================================================================

// Tuple used then destructured - Dec happens after use
let t = (1, 2) in let (a, b) = t in a + b = 3

// Tuple aliased - alias is borrowed, original gets Dec
let outer = (1, 2) in let inner = outer in let (first, second) = inner in first + second = 3

// ===================================================================
// Memory reuse tests - free list reclaims and reuses memory
// ===================================================================

// Allocate two tuples of same size - second reuses freed memory
let t1 = (1, 2) in let (first, _) = t1 in let _ = first in let t2 = (3, 4) in let (third, fourth) = t2 in third + fourth = 7

// Allocate many tuples - tests free list under pressure
let a = (1, 1) in let b = (2, 2) in let c = (3, 3) in let d = (4, 4) in let (a0, _) = a in let (b0, _) = b in let (c0, _) = c in let (d0, _) = d in a0 + b0 + c0 + d0 = 10

// 24-byte non-list payloads should use generic RC, not list-specific helper paths
let t = (1, 2, 3) in let (a, b, c) = t in a + b + c = stdout="6\n" stderr=""
type Point3 = { x: Int64, y: Int64, z: Int64 } let p = Point3 { x = 1, y = 2, z = 3 } in p.x + p.y + p.z = stdout="6\n" stderr=""

// Displaying managed final values should release the printed value after output
type DisplayRecordLeak = { name: String, age: Int64 } DisplayRecordLeak { name = "record", age = 42 } = stdout="DisplayRecordLeak { age: 42, name: \"record\" }\n" stderr=""
type DisplaySumLeak = SumList of List<Int64> | SumString of String let items = [1, 2, 3] in SumList(items) = stdout="DisplaySumLeak.SumList([1, 2, 3])\n" stderr=""
Stdlib.Blob.fromList([65uy, 66uy, 67uy]) = stdout="<Blob: ephemeral>\n" stderr=""

// ===================================================================
// Function calls with heap values
// ===================================================================

// Tuple passed to function and returned - ownership transfer
let identity(t: Int64) : Int64 = t identity(42) = 42

// Tuple created in function and returned
let make_value() : Int64 = 42 make_value() = 42

// Multiple function calls
let add1(x: Int64) : Int64 = x + 1 let a = add1(1) in let b = add1(10) in a + b = 13

// ===================================================================
// Records (also heap-allocated)
// ===================================================================

// Basic record
type Point = { x: Int64, y: Int64 } let p = Point { x = 10, y = 20 } in p.x + p.y = 30

// Record with aliasing
type Point = { x: Int64, y: Int64 } let p = Point { x = 5, y = 7 } in let q = p in q.x + q.y = 12

// ===================================================================
// Nested heap values
// ===================================================================

// Tuple containing tuples - outer tuple owns nested refs
let outer = ((1, 2), (3, 4)) in let ((a, _), (_, d)) = outer in a + d = 5

// Deeply nested tuple access (must use intermediate let bindings)
let t = ((10, 20), (30, 40)) in let ((a, _), (_, d)) = t in a + d = 50

// ===================================================================
// Lists (also heap-allocated)
// ===================================================================

// Simple list operations
match [1, 2, 3] with | [x, _, _] -> x | _ -> 0 = 1

// List with element extraction
match [10, 20, 30] with | [x, y, z] -> x | _ -> 0 = 10

// Empty list
match [] with | [] -> 42 | _ -> 0 = 42

// List allocation then match
let xs = [1, 2] in match xs with | [a, b] -> a + b | _ -> 0 = 3

// ===================================================================
// Memory reuse stress test
// ===================================================================

// TODO: These tests are disabled due to a bug where RefCountDec is inserted
// after TailCall. Since TailCall doesn't return to that point, the RefCountDec
// never executes, causing memory to leak and heap exhaustion.
// Fix: RefCountDec should be inserted BEFORE TailCall, not before Return.

// 5000 allocations of 24-byte tuples = 120KB, but heap is 64KB
// This only works because freed memory is reused via free list
// let alloc_one() : Int64 = let t = (1, 1) in let (first, second) = t in first + second let loop(n: Int64, acc: Int64) : Int64 = if n < 1 then acc else loop(n - 1, acc + alloc_one()) loop(5000, 0) = 10000

// Same test but with free list disabled - should crash (SIGSEGV = exit 139)
// This proves that memory reuse via free list is necessary for the test above to pass
// let alloc_one() : Int64 = let t = (1, 1) in let (first, second) = t in first + second let loop(n: Int64, acc: Int64) : Int64 = if n < 1 then acc else loop(n - 1, acc + alloc_one()) loop(5000, 0) = exit=139 no_free_list=true // Memory exhaustion crash
