// Stdlib.Base64 — decode returns Result<Blob, String>;
// encode / urlEncode take Blob.

// The compiler E2E value oracle uses language equality. Compare decoded byte
// lists so the upstream vectors coexist with Blob's identity equality.
def base64DecodeForParity(value: String) : Stdlib.Result.Result<List<UInt8>, String> =
  match Stdlib.Base64.decode value with
  | Ok blob -> Ok(Stdlib.Blob.toList blob)
  | Error error -> Error(error)

// TODO: try decoding values with incorrect padding

// Stdlib.Base64.decode
base64DecodeForParity "" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString ""))
base64DecodeForParity "garbage text" = Stdlib.Result.Result.Error "Not a valid base64 string"
base64DecodeForParity "Kw" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "+"))
base64DecodeForParity "yLo" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "Ⱥ"))
base64DecodeForParity "xbzDs8WCdw" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "żółw"))
base64DecodeForParity "LyotKygmQDk4NTIx" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "/*-+(&@98521"))

// some failures
base64DecodeForParity "illegal-chars&@:" = Stdlib.Result.Result.Error "Not a valid base64 string"
base64DecodeForParity "x" = Stdlib.Result.Result.Error "Not a valid base64 string"

// empty case
// Test cases from the spec with padding added
base64DecodeForParity "Zg" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "f"))
base64DecodeForParity "Zg==" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "f"))
base64DecodeForParity "Zm8" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "fo"))
base64DecodeForParity "Zm8=" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "fo"))
base64DecodeForParity "Zm9v" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "foo"))
base64DecodeForParity "Zm9vYg" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "foob"))
base64DecodeForParity "Zm9vYg==" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "foob"))
base64DecodeForParity "Zm9vYmE" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "fooba"))
base64DecodeForParity "Zm9vYmE=" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "fooba"))
base64DecodeForParity "Zm9vYmFy" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "foobar"))

// "Impossible cases" from apache
// https://commons.apache.org/proper/commons-codec/xref-test/org/apache/commons/codec/binary/Base64Test.html
base64DecodeForParity "ZE==" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "d"))
base64DecodeForParity "ZmC=" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "f`"))
base64DecodeForParity "Zm9vYE==" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "foo`"))
base64DecodeForParity "Zm9vYmC=" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "foob`"))

// longer tests
base64DecodeForParity "ZnJvbT0wNi8wNy8yMDEzIHF1ZXJ5PSLOms6xzrvPjs-CIM6_z4HOr8-DzrHPhM61Ig" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "from=06/07/2013 query=\"Καλώς ορίσατε\""))
base64DecodeForParity "8J-RsfCfkbHwn4-78J-RsfCfj7zwn5Gx8J-PvfCfkbHwn4--8J-RsfCfj78" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromString "👱👱🏻👱🏼👱🏽👱🏾👱🏿"))

// These produce strings of bytes which are technically legal it seems
base64DecodeForParity "-p" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromList [ 250uy ]))
base64DecodeForParity "lI" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromList [ 148uy ]))
base64DecodeForParity "5Sk" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromList [ 229uy; 41uy ]))
base64DecodeForParity "AA" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromList [ 0uy ]))
base64DecodeForParity "_w" = Stdlib.Result.Result.Ok(Stdlib.Blob.toList(Stdlib.Blob.fromList [ 255uy ]))


// Stdlib.Base64.encode
Stdlib.Base64.encode (Stdlib.Blob.fromString "abcdef") = "YWJjZGVm"
Stdlib.Base64.encode (Stdlib.Blob.fromString "Z̤͔ͧ̑̓ä͖̭̈̇lͮ̒ͫǧ̗͚̚o̙̔ͮ̇͐̇") = "WsykzZTNp8yRzJPDpM2WzK3MiMyHbM2uzJLNq8enzJfNmsyab8yZzJTNrsyHzZDMhw=="
Stdlib.Base64.encode (Stdlib.Blob.fromString "اختبار النص") = "2KfYrtiq2KjYp9ixINin2YTZhti1"
Stdlib.Base64.encode (Stdlib.Blob.fromString "﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽") = "77e977e977e977e977e977e977e977e977e977e977e977e977e977e977e977e9"
Stdlib.Base64.encode (Stdlib.Blob.fromString "👱👱🏻👱🏼👱🏽👱🏾👱🏿") = "8J+RsfCfkbHwn4+78J+RsfCfj7zwn5Gx8J+PvfCfkbHwn4++8J+RsfCfj78="
Stdlib.Base64.encode (Stdlib.Blob.fromString "👨‍❤️‍💋‍👨👩‍👩‍👧‍👦🏳️‍⚧️🇵🇷") = "8J+RqOKAjeKdpO+4j+KAjfCfkovigI3wn5Go8J+RqeKAjfCfkanigI3wn5Gn4oCN8J+RpvCfj7PvuI/igI3imqfvuI/wn4e18J+Htw=="


Stdlib.Base64.urlEncode (Stdlib.Blob.fromString "abcdef") = "YWJjZGVm"
Stdlib.Base64.urlEncode (Stdlib.Blob.fromString "Z̤͔ͧ̑̓ä͖̭̈̇lͮ̒ͫǧ̗͚̚o̙̔ͮ̇͐̇") = "WsykzZTNp8yRzJPDpM2WzK3MiMyHbM2uzJLNq8enzJfNmsyab8yZzJTNrsyHzZDMhw=="
Stdlib.Base64.urlEncode (Stdlib.Blob.fromString "اختبار النص") = "2KfYrtiq2KjYp9ixINin2YTZhti1"
Stdlib.Base64.urlEncode (Stdlib.Blob.fromString "﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽") = "77e977e977e977e977e977e977e977e977e977e977e977e977e977e977e977e9"
Stdlib.Base64.urlEncode (Stdlib.Blob.fromString "👱👱🏻👱🏼👱🏽👱🏾👱🏿") = "8J-RsfCfkbHwn4-78J-RsfCfj7zwn5Gx8J-PvfCfkbHwn4--8J-RsfCfj78="

Stdlib.Base64.urlEncode (Stdlib.Blob.fromString "👨‍❤️‍💋‍👨👩‍👩‍👧‍👦🏳️‍⚧️🇵🇷") =
  "8J-RqOKAjeKdpO-4j-KAjfCfkovigI3wn5Go8J-RqeKAjfCfkanigI3wn5Gn4oCN8J-RpvCfj7PvuI_igI3imqfvuI_wn4e18J-Htw=="
