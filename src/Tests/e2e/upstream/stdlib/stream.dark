// Stream — consumption (next/toList/toBlob/close) and transforms
// (map/filter/take/concat).

// fromList -> toList roundtrips
(let s = Stdlib.Stream.fromList [ 1L; 2L; 3L ] in
 Stdlib.Stream.toList s) = [ 1L; 2L; 3L ]

// empty stream drains to empty list
(let s = Stdlib.Stream.fromList<Int64> [] in
 Stdlib.Stream.toList s) = []

// next on an empty stream returns None
(let s = Stdlib.Stream.fromList<Int64> [] in
 Stdlib.Stream.next s) = Stdlib.Option.Option.None

// next pulls head, leaves rest
(let s = Stdlib.Stream.fromList [ 7L; 8L ] in
 let first = Stdlib.Stream.next s in
 let second = Stdlib.Stream.next s in
 let third = Stdlib.Stream.next s in
 [ first; second; third ]) = [ Stdlib.Option.Option.Some 7L;
                               Stdlib.Option.Option.Some 8L;
                               Stdlib.Option.Option.None ]

// toBlob drains a Stream<UInt8> into a Blob
(let s = Stdlib.Stream.fromList [ 104uy; 105uy ] in
 let b = Stdlib.Stream.toBlob s in
 Stdlib.Blob.toString b) = Stdlib.Result.Result.Ok "hi"

// close is idempotent; subsequent next returns None
(let s = Stdlib.Stream.fromList [ 1L; 2L ] in
 let _ = Stdlib.Stream.close s in
 let _ = Stdlib.Stream.close s in
 Stdlib.Stream.next s) = Stdlib.Option.Option.None


// --- transforms ---

// map doubles every element
(let s = Stdlib.Stream.fromList [ 1L; 2L; 3L ] in
 let mapped = Stdlib.Stream.map s (fun n -> n * 2L) in
 Stdlib.Stream.toList mapped) = [ 2L; 4L; 6L ]

// filter keeps only matching elements
(let s = Stdlib.Stream.fromList [ 1L; 2L; 3L; 4L ] in
 let evens = Stdlib.Stream.filter s (fun n -> n % 2L == 0L) in
 Stdlib.Stream.toList evens) = [ 2L; 4L ]

// filter rejecting everything yields empty
(let s = Stdlib.Stream.fromList [ 1L; 3L; 5L ] in
 let none = Stdlib.Stream.filter s (fun n -> n % 2L == 0L) in
 Stdlib.Stream.toList none) = []

// take caps at n
(let s = Stdlib.Stream.fromList [ 10L; 20L; 30L; 40L ] in
 let first2 = Stdlib.Stream.take s 2I in
 Stdlib.Stream.toList first2) = [ 10L; 20L ]

// take more than available returns all available
(let s = Stdlib.Stream.fromList [ 7L; 8L ] in
 let wide = Stdlib.Stream.take s 10I in
 Stdlib.Stream.toList wide) = [ 7L; 8L ]

// take 0 returns empty without pulling
(let s = Stdlib.Stream.fromList [ 1L; 2L ] in
 let none = Stdlib.Stream.take s 0I in
 Stdlib.Stream.toList none) = []

// a negative n of any magnitude (even past Int64) clamps to 0 -> empty
(let s = Stdlib.Stream.fromList [ 1L; 2L ] in
 let none = Stdlib.Stream.take s -9223372036854775809I in
 Stdlib.Stream.toList none) = []

// concat drains streams in list order
(let a = Stdlib.Stream.fromList [ 1L; 2L ] in
 let b = Stdlib.Stream.fromList [ 3L; 4L ] in
 let joined = Stdlib.Stream.concat [ a; b ] in
 Stdlib.Stream.toList joined) = [ 1L; 2L; 3L; 4L ]

// concat over an empty list yields empty
(let joined = Stdlib.Stream.concat<Int64> [] in
 Stdlib.Stream.toList joined) = []

// concat skips an empty sub-stream in the middle
(let a = Stdlib.Stream.fromList [ 1L ] in
 let empty = Stdlib.Stream.fromList<Int64> [] in
 let b = Stdlib.Stream.fromList [ 2L ] in
 let joined = Stdlib.Stream.concat [ a; empty; b ] in
 Stdlib.Stream.toList joined) = [ 1L; 2L ]

// the spec done-when: filter evens, map +1, take 3, toList
// [1..10] -> evens [2,4,6,8,10] -> +1 [3,5,7,9,11] -> take 3 [3,5,7]
(let s = Stdlib.Stream.fromList [ 1L; 2L; 3L; 4L; 5L; 6L; 7L; 8L; 9L; 10L ] in
 let filtered = Stdlib.Stream.filter s (fun n -> n % 2L == 0L) in
 let mapped = Stdlib.Stream.map filtered (fun n -> n + 1L) in
 let taken = Stdlib.Stream.take mapped 3I in
 Stdlib.Stream.toList taken) = [ 3L; 5L; 7L ]


// --- extra compositional coverage ---

// map can change the element type
(let s = Stdlib.Stream.fromList [ 1L; 2L; 3L ] in
 let mapped = Stdlib.Stream.map s (fun n -> Stdlib.Int64.toString n) in
 Stdlib.Stream.toList mapped) = [ "1"; "2"; "3" ]

// take after map — the take limit applies to the mapped output
(let s = Stdlib.Stream.fromList [ 1L; 2L; 3L; 4L; 5L ] in
 let mapped = Stdlib.Stream.map s (fun n -> n * 10L) in
 let taken = Stdlib.Stream.take mapped 2I in
 Stdlib.Stream.toList taken) = [ 10L; 20L ]

// map after take — map only applies to elements that survive the take
(let s = Stdlib.Stream.fromList [ 1L; 2L; 3L; 4L; 5L ] in
 let taken = Stdlib.Stream.take s 3I in
 let mapped = Stdlib.Stream.map taken (fun n -> n * n) in
 Stdlib.Stream.toList mapped) = [ 1L; 4L; 9L ]

// concat of already-transformed streams
(let a = Stdlib.Stream.fromList [ 1L; 2L ] in
 let b = Stdlib.Stream.fromList [ 3L; 4L ] in
 let aDoubled = Stdlib.Stream.map a (fun n -> n * 2L) in
 let bNegated = Stdlib.Stream.map b (fun n -> 0L - n) in
 let joined = Stdlib.Stream.concat [ aDoubled; bNegated ] in
 Stdlib.Stream.toList joined) = [ 2L; 4L; -3L; -4L ]

// filter then take: early-terminate once Take is satisfied
(let s = Stdlib.Stream.fromList [ 1L; 2L; 3L; 4L; 5L; 6L; 7L; 8L ] in
 let evens = Stdlib.Stream.filter s (fun n -> n % 2L == 0L) in
 let firstTwo = Stdlib.Stream.take evens 2I in
 Stdlib.Stream.toList firstTwo) = [ 2L; 4L ]

// concat of concats flattens correctly
(let a = Stdlib.Stream.fromList [ 1L ] in
 let b = Stdlib.Stream.fromList [ 2L ] in
 let c = Stdlib.Stream.fromList [ 3L ] in
 let ab = Stdlib.Stream.concat [ a; b ] in
 let full = Stdlib.Stream.concat [ ab; c ] in
 Stdlib.Stream.toList full) = [ 1L; 2L; 3L ]

// map/filter/take over an empty source yields empty
(let s = Stdlib.Stream.fromList<Int64> [] in
 let mapped = Stdlib.Stream.map s (fun n -> n + 1L) in
 let filtered = Stdlib.Stream.filter mapped (fun n -> n > 0L) in
 let taken = Stdlib.Stream.take filtered 5I in
 Stdlib.Stream.toList taken) = []

// Stream<Blob> round-trips via fromList/toList
(let b1 = Stdlib.Blob.fromString "hi" in
 let b2 = Stdlib.Blob.fromString "there" in
 let s = Stdlib.Stream.fromList [ b1; b2 ] in
 let result = Stdlib.Stream.toList s in
 Stdlib.List.length result) = 2I
