// Arbitrary-precision `Int` compatibility tests.
//
// Values are normalized to canonical decimal storage. These tests exercise the
// former finite/infinite boundary as a behavioral boundary: operations and
// conversions must remain exact on both sides regardless of representation.
// Literals use Dark's `I` suffix.

// --- boundary: largest small value vs first big value ---
9223372036854775807I + 0I = 9223372036854775807I // Stdlib.Int64.MAX stays small
9223372036854775807I + 1I = 9223372036854775808I // promotes past Stdlib.Int64.MAX
-9223372036854775808I - 1I = -9223372036854775809I // promotes past Stdlib.Int64.MIN

// --- demotion: a big-arithmetic result that fits Int64 collapses to small ---
9223372036854775808I - 1I = 9223372036854775807I
(Stdlib.Int.power 2I 100I) - (Stdlib.Int.power 2I 100I) = 0I
(Stdlib.Int.power 2I 100I) / (Stdlib.Int.power 2I 100I) = 1I

// --- normalization: a promoted-then-demoted result equals the small literal ---
// (this is the property that fails if a small value is left as the big rep)
(9223372036854775808I - 9223372036854775808I) == 0I = true
9223372036854775807I == (9223372036854775806I + 1I) = true

// --- equality and ordering across representations ---
(Stdlib.Int.power 2I 64I) == (Stdlib.Int.power 2I 64I) = true
9223372036854775808I > 5I = true
5I < 9223372036854775808I = true
9223372036854775808I == 5I = false

// --- arithmetic correctness at scale ---
Stdlib.Int.power 2I 64I = 18446744073709551616I
Stdlib.Int.power 2I 200I
  = 1606938044258990275541962092341162602522202993782792835301376I

// --- round-trips (stringify / parse / Int64 conversions) ---
Stdlib.Int.toString 5I = "5"
Stdlib.Int.toString 9223372036854775808I = "9223372036854775808"
Stdlib.Int.parse "9223372036854775808" = Stdlib.Result.Result.Ok 9223372036854775808I
Stdlib.Int.parse "5" = Stdlib.Result.Result.Ok 5I
Stdlib.Int.parse "not a number" = Stdlib.Result.Result.Error Stdlib.Int.ParseError.BadFormat
Stdlib.Int.parse "" = Stdlib.Result.Result.Error Stdlib.Int.ParseError.BadFormat
Stdlib.Int.parse "5.0" = Stdlib.Result.Result.Error Stdlib.Int.ParseError.BadFormat
Stdlib.Int.parse "5_000" = Stdlib.Result.Result.Error Stdlib.Int.ParseError.BadFormat
// arbitrary precision: a value past Stdlib.Int64.MinValue still parses
Stdlib.Int.parse "-9223372036854775809" = Stdlib.Result.Result.Ok -9223372036854775809I
Stdlib.Int.fromInt64 5L = 5I

// toInt64 relies on the invariant: a small Int always fits, a big Int never does
Stdlib.Int.toInt64 5I = Stdlib.Option.Option.Some 5L
Stdlib.Int.toInt64 9223372036854775808I = Stdlib.Option.Option.None


// --- conversions from the fixed-width types (always succeed) ---
Stdlib.Int.fromInt8 127y = 127I
Stdlib.Int.fromUInt8 255uy = 255I
Stdlib.Int.fromInt16 32767s = 32767I
Stdlib.Int.fromUInt32 4294967295ul = 4294967295I
// values past Int64 still convert exactly
Stdlib.Int.fromUInt64 18446744073709551615UL = 18446744073709551615I
Stdlib.Int.fromUInt128 340282366920938463463374607431768211455Z =
  340282366920938463463374607431768211455I

// --- conversions into the fixed-width types (Some if it fits, else None) ---
Stdlib.Int.toInt8 100I = Stdlib.Option.Option.Some 100y
Stdlib.Int.toInt8 200I = Stdlib.Option.Option.None
Stdlib.Int.toUInt8 (Stdlib.Int.negate 1I) = Stdlib.Option.Option.None
Stdlib.Int.toInt32 (Stdlib.Int.power 2I 40I) = Stdlib.Option.Option.None
Stdlib.Int.toInt128 (Stdlib.Int.power 2I 100I) =
  Stdlib.Option.Option.Some 1267650600228229401496703205376Q
Stdlib.Int.toInt128 (Stdlib.Int.power 2I 200I) = Stdlib.Option.Option.None
Stdlib.Int.toUInt128 (Stdlib.Int.power 2I 200I) = Stdlib.Option.Option.None

// --- fromFloat: truncates toward zero; NaN/Infinity have no Int, so OutOfRange ---
Stdlib.Int.fromFloat 3.9 = 3I
Stdlib.Int.fromFloat -3.9 = -3I
Stdlib.Int.fromFloat 1.0e20 = 100000000000000000000I
Stdlib.Int.fromFloat (0.0 / 0.0) =
  error="Encountered out-of-range value for type of Int"
Stdlib.Int.fromFloat (1.0 / 0.0) =
  error="Encountered out-of-range value for type of Int"
Stdlib.Int.fromFloat (-1.0 / 0.0) =
  error="Encountered out-of-range value for type of Int"


// --- remainder: Result<Int>; sign follows the dividend; Error only if divisor is 0 ---
Stdlib.Int.remainder 15I 6I = Stdlib.Result.Result.Ok 3I
Stdlib.Int.remainder 20I 8I = Stdlib.Result.Result.Ok 4I
Stdlib.Int.remainder -20I 8I = Stdlib.Result.Result.Ok -4I
Stdlib.Int.remainder -20I -8I = Stdlib.Result.Result.Ok -4I
Stdlib.Int.remainder -15I 6I = Stdlib.Result.Result.Ok -3I
Stdlib.Int.remainder 5I 0I = Stdlib.Result.Result.Error "Cannot divide by 0"
// arbitrary precision: 2^100 mod 7 == 2, with a dividend well past Int64
Stdlib.Int.remainder (Stdlib.Int.power 2I 100I) 7I = Stdlib.Result.Result.Ok 2I

// --- mod: wraps into [0, b); RTE if b <= 0 ---
Stdlib.Int.mod 15I 5I = 0I
Stdlib.Int.mod 15I 6I = 3I
Stdlib.Int.mod 0I 15I = 0I
Stdlib.Int.mod -1I 2I = 1I
Stdlib.Int.mod -754I 53I = 41I
Stdlib.Int.mod (Stdlib.Int.power 2I 100I) 7I = 2I
Stdlib.Int.mod 5I 0I = error="Cannot evaluate modulus against 0"
Stdlib.Int.mod 5I -5I = error="Cannot evaluate modulus against a negative number"

// the % operator dispatches to mod
15I % 5I = 0I
5I % 0I = error="Cannot evaluate modulus against 0"
5I % -5I = error="Cannot evaluate modulus against a negative number"

// --- shiftLeft / shiftRight: count must fit Int32, else OutOfRange ---
Stdlib.Int.shiftLeft 1I 4I = 16I
Stdlib.Int.shiftLeft 1I 64I = 18446744073709551616I
Stdlib.Int.shiftRight 256I 4I = 16I
Stdlib.Int.shiftLeft 1I (Stdlib.Int.power 2I 40I) =
  error="Encountered out-of-range value for type of Int"
Stdlib.Int.shiftRight 1I (Stdlib.Int.power 2I 40I) =
  error="Encountered out-of-range value for type of Int"

// --- bitwise operations use infinite two's-complement semantics ---
Stdlib.Int.bitwiseAnd 12I 10I = 8I
Stdlib.Int.bitwiseOr 12I 10I = 14I
Stdlib.Int.bitwiseXor 12I 10I = 6I
Stdlib.Int.bitwiseNot 12I = -13I
Stdlib.Int.bitwiseAnd ((Stdlib.Int.power 2I 100I) + 3I) 7I = 3I
Stdlib.Int.bitwiseAnd -5I 3I = 3I
Stdlib.Int.bitwiseOr -5I 3I = -5I
Stdlib.Int.bitwiseXor -5I 3I = -8I
Stdlib.Int.shiftRight -5I 1I = -3I
(12I & 10I) = 8I
(12I ||| 10I) = 14I
~~~12I = -13I
(1I << 100I) = 1267650600228229401496703205376I
(-5I >> 1I) = -3I
let value = Stdlib.Int.power 2I 100I in -value = -1267650600228229401496703205376I

// --- remaining upstream numeric conversions ---
Stdlib.Int.toUInt64 18446744073709551615I =
  Stdlib.Option.Option.Some 18446744073709551615UL
Stdlib.Int.toUInt64 18446744073709551616I = Stdlib.Option.Option.None
Stdlib.Int.toFloat 5I = 5.0
Stdlib.Int.sqrt 81I = 9.0
[1I, 1267650600228229401496703205376I] =
  stdout="[1, 1267650600228229401496703205376]\n" stderr=""
