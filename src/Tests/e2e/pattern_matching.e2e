// Pattern matching tests for Phase 7 Milestone 5

// =====================================================
// Simple Enum Matching - Color type
// =====================================================

type Color = Red | Green | Blue

// Multi-line match expression (testing multi-line syntax support)
(match Red with
    | Red -> 1L
    | Green -> 2L
    | Blue -> 3L) = 1L

// Multi-line with closing paren on separate line
(match Green with
    | Red -> 100L
    | Green -> 200L
    | Blue -> 300L
) = 200L

// A dedented branch bar belongs to the outer match, not to the nested match
// in the preceding branch body.
let nestedBranchBars(value: Bool) : Int64 =
    match value with
    | true ->
        match value with
        | true -> 1
        | false -> 2
    | false -> 3

nestedBranchBars(false) = 3

// Match on simple enum - first variant
match Red with | Red -> 1L | Green -> 2L | Blue -> 3L = 1L

// Match on simple enum - second variant
match Green with | Red -> 1L | Green -> 2L | Blue -> 3L = 2L

// Match on simple enum - third variant
match Blue with | Red -> 1L | Green -> 2L | Blue -> 3L = 3L

// Wildcard pattern matches anything
match Green with | Red -> 1L | _ -> 99L = 99L

// Wildcard at end is catch-all
match Blue with | Red -> 1L | Green -> 2L | _ -> 100L = 100L

// Match on enum stored in variable
let c = Green in match c with | Red -> 10L | Green -> 20L | Blue -> 30L = 20L

// Match with arithmetic in case body
match Red with | Red -> 5L + 10L | _ -> 0L = 15L

// Match with complex body expressions
match Red with | Red -> 2L + 3L | Green -> 10L - 5L | Blue -> 1L * 1L = 5L

// =====================================================
// Other Simple Enums
// =====================================================

// Two variant type (shadowing built-in Bool for testing)
type Bool = True | False

let b = True in match b with | True -> 100L | False -> 0L = 100L
match False with | True -> 1L | False -> 0L = 0L

// Four variant type
type Dir = North | East | South | West

match South with | North -> 0L | East -> 1L | South -> 2L | West -> 3L = 2L

// === Milestone 6: Payload Extraction ===

type MyOption = MyNone | MySome of Int64

// Extract payload from MySome variant
match MySome(42L) with | MySome(x) -> x | MyNone -> 0L = 42L

// Extract and use payload in arithmetic
match MySome(10L) with | MySome(x) -> x + 5L | MyNone -> 0L = 15L

// Match MyNone case (no extraction)
match MyNone with | MySome(x) -> x | MyNone -> 99L = 99L

// Extract and multiply
match MySome(6L) with | MySome(x) -> x * 7L | MyNone -> 0L = 42L

// Extract with wildcard fallback
match MySome(123L) with | MySome(n) -> n | _ -> 0L = 123L

// Variable binding on whole scrutinee (uses Color from above)
match Green with | x -> 1L = 1L

// Extract payload with different variant order
type MyResult = MyOk of Int64 | MyErr

match MyOk(100L) with | MyOk(v) -> v | MyErr -> 0L = 100L
match MyErr with | MyOk(v) -> v | MyErr -> 1L = 1L

// Multiple payload variants
type Either = Left of Int64 | Right of Int64

match Left(5L) with | Left(x) -> x | Right(y) -> y = 5L
match Right(7L) with | Left(x) -> x | Right(y) -> y = 7L

// Guard should use payload type for string equality
type GuardWrap = GuardWrap of String | GuardEmpty
match GuardWrap("a" ++ "b") with | GuardWrap(s) when s == ("a" ++ "b") -> 1L | _ -> 0L = 1L

// === Integer Literal Patterns ===

// Match on integer literal - first case
match 42L with | 42L -> 1L | _ -> 0L = 1L

// Match on integer literal - fallback
match 99L with | 42L -> 1L | _ -> 0L = 0L

// Multiple integer cases
match 2L with | 1L -> 10L | 2L -> 20L | 3L -> 30L | _ -> 0L = 20L

// Integer match with variable binding
match 7L with | 7L -> 100L | x -> x = 100L

// Match on computed integer
let x = 3L + 2L in match x with | 5L -> 1L | _ -> 0L = 1L

// Large integer literal
match 1000000L with | 1000000L -> 1L | _ -> 0L = 1L

// Zero matching
match 0L with | 0L -> 42L | _ -> 0L = 42L

// Negative number matching
match 0L - 5L with | 0L -> 1L | x -> x + 10L = 5L

// === Boolean Patterns ===

// Match on true literal
match true with | true -> 1L | false -> 0L = 1L

// Match on false literal
match false with | true -> 1L | false -> 0L = 0L

// Boolean from comparison
match 5L > 3L with | true -> 100L | false -> 0L = 100L

// Boolean from equality
match 5L == 5L with | true -> 1L | false -> 0L = 1L

// Boolean in variable
let b = true in match b with | true -> 42L | false -> 0L = 42L

// Inverted boolean match
match false with | false -> 99L | true -> 1L = 99L

// === Tuple Patterns ===

// Simple 2-tuple extraction
match (1L, 2L) with | (a, b) -> a + b = 3L

// The interpreter's public match grammar also permits a bare tuple pattern.
match (1, 2) with | a, b -> a + b = 3

// 3-tuple extraction
match (10L, 20L, 30L) with | (a, b, c) -> a + b + c = 60L

// 4-tuple extraction
match (1L, 2L, 3L, 4L) with | (a, b, c, d) -> a + b + c + d = 10L

// Tuple with wildcard elements
match (100L, 200L) with | (x, _) -> x = 100L

// Tuple with second element wildcard
match (100L, 200L) with | (_, y) -> y = 200L

// Nested arithmetic in tuple
match (5L + 5L, 3L * 4L) with | (a, b) -> a * b = 120L

// Tuple from variable
let t = (7L, 8L) in match t with | (x, y) -> x * y = 56L

// Tuple with all wildcards (just structure match)
match (1L, 2L, 3L) with | (_, _, _) -> 42L = 42L

// Mix of binding and wildcard
match (1L, 2L, 3L, 4L, 5L) with | (a, _, c, _, e) -> a + c + e = 9L

// Tuple pattern with guard clause to verify element index ordering (kills mutation #68)
// This tests the extractAndCompileBodyWithGuard.collectFromTuple code path
match (100L, 37L) with | (a, b) when b < a -> b - a | _ -> 999L = -63L

// Three-element tuple with guard to verify all element indices are correct
match (100L, 40L, 7L) with | (a, b, c) when c < b -> a - b - c | _ -> 999L = 53L

// Tuple pattern with constructor payload typing (structural equality)
type PairOption = PairNone | PairSome of (Int64, Int64)
match (PairSome((1L, 2L)), PairSome((1L, 2L))) with | (PairSome(x), PairSome(y)) -> x == y | _ -> false = true

// Tuple literal pattern index increment verification (kills mutation #82)
// Tests that buildTupleComparisons correctly increments index for second element comparison
// If index + 1 were changed to index - 1, the second comparison would re-read index 0
// causing (5, 7) to incorrectly match pattern (5, 5) since it would compare 5==5 twice
match (5L, 7L) with | (5L, 5L) -> 1L | _ -> 0L = 0L

// Three-element tuple literal pattern to verify all indices increment correctly
// Pattern (10, 10, 10) should NOT match (10, 20, 30) - only first element matches
match (10L, 20L, 30L) with | (10L, 10L, 10L) -> 1L | _ -> 0L = 0L

// Verify the positive case still works - pattern should match when all elements are equal
match (5L, 5L) with | (5L, 5L) -> 1L | _ -> 0L = 1L

// === Record Patterns ===

type Point = { x: Int64, y: Int64 }

// Simple record extraction
match Point { x = 10L, y = 20L } with | p -> p.x + p.y = 30L

// Record with one field extracted
match Point { x = 5L, y = 10L } with | p -> p.x = 5L

// Record second field only
match Point { x = 5L, y = 15L } with | p -> p.y = 15L

// Record from variable
let p = Point { x = 3L, y = 4L } in match p with | value -> value.x * value.x + value.y * value.y = 25L

// Three-field record
type Vec3 = { x: Int64, y: Int64, z: Int64 }

match Vec3 { x = 1L, y = 2L, z = 3L } with | v -> v.x + v.y + v.z = 6L

// Record pattern with subtraction to verify correct field index ordering (kills mutation #62)
match Point { x = 100L, y = 37L } with | p -> p.x - p.y = 63L

// Three-field record with subtraction to verify field index ordering
match Vec3 { x = 100L, y = 40L, z = 7L } with | v -> v.x - v.y - v.z = 53L

// Record pattern with guard clause to verify field index ordering (kills mutation #67)
// This tests the extractAndCompileBodyWithGuard.collectFromRecord code path
match Point { x = 100L, y = 37L } with | p when p.y < p.x -> p.y - p.x | _ -> 999L = -63L

// Three-field record with guard to verify all field indices are correct
match Vec3 { x = 100L, y = 40L, z = 7L } with | v when v.z < v.y -> v.x - v.y - v.z | _ -> 999L = 53L

// Record pattern with wildcard followed by field extraction (kills mutation #73)
// Tests that fieldIdx is correctly incremented after wildcard patterns
match Vec3 { x = 100L, y = 40L, z = 7L } with | v -> v.y - v.z = 33L

// Record pattern with field extraction, wildcard, then another extraction (kills mutation #74)
// Tests that fieldIdx is correctly incremented when wildcard appears between extractions
match Vec3 { x = 100L, y = 40L, z = 7L } with | v -> v.x - v.z = 93L

// === Nested ADT Patterns ===

// Nested - testing Wrap type (MyOption already defined above)
type Nested = Empty | Wrap of Int64

match Wrap(42L) with | Wrap(x) -> x | Empty -> 0L = 42L

// Deeply extract from nested variant
type Box = Empty | Full of Int64

match Full(99L) with | Full(n) -> n * 2L | Empty -> 0L = 198L

// === Complex Combinations ===
// Note: Uses MyOption and Point defined above

// Tuple inside match case body
match MySome(5L) with | MySome(x) -> let t = (x, x * 2L) in match t with | (a, b) -> a + b | MyNone -> 0L = 15L

// Record access in match body
match MySome(1L) with | MySome(_) -> let p = Point { x = 10L, y = 20L } in p.x + p.y | MyNone -> 0L = 30L

// Match on tuple element
match (1L, 2L) with | (a, _) -> match a with | 1L -> 100L | _ -> 0L = 100L

// Chained matches (uses Color from above)
match Red with | Red -> match true with | true -> 42L | false -> 0L | _ -> 0L = 42L

// Match with arithmetic in result (avoid match-in-atom-position)
match 5L with | 5L -> 100L + 1L | _ -> 0L = 101L

// Nested matches (avoid let x = match ... in ...)
match 1L with | 1L -> match 2L with | 2L -> 10L + 20L | _ -> 0L | _ -> 0L = 30L

// Arithmetic on extracted values
type Pair = MkPair of Int64

match MkPair(7L) with | MkPair(n) -> n * n + n = 56L

// Boolean from comparison used in match
let x = 42L in match x == 42L with | true -> 1L | false -> 0L = 1L

// Tuple with computed elements
let x = 5L in let y = 10L in match (x * 2L, y / 2L) with | (a, b) -> a + b = 15L

// === Edge Cases ===

// Single element match (just variable)
match 42L with | x -> x = 42L

// Empty-ish patterns with just wildcards
match 999L with | _ -> 1L = 1L

// Order of patterns matters
match 1L with | 1L -> 100L | 2L -> 200L | _ -> 0L = 100L

// Last pattern is fallback
match 99L with | 1L -> 100L | 2L -> 200L | n -> n = 99L

// Multiple wildcards in different positions
type Triple = T of Int64

match T(5L) with | T(x) -> x + 1L = 6L

// Combine enum and payload extraction
type MaybeInt = Nothing | Just of Int64

match Just(10L) with | Nothing -> 0L | Just(n) -> n + n = 20L

// Mix patterns in same match
match 2L with | 1L -> 10L | 2L -> 20L | x -> x * 100L = 20L

// Fallback captures value
match 7L with | 1L -> 10L | 2L -> 20L | x -> x * 100L = 700L

// === Tuple-Returning Functions ===

// Function that returns tuple, matched
let t = (1L + 2L, 3L + 4L) in match t with | (a, b) -> a * b = 21L

// Tuple of booleans
match (true, false) with | (a, _) -> match a with | true -> 1L | false -> 0L = 1L

// === Records with Complex Bodies ===
// Note: Point already defined above

// Complex arithmetic with record fields
let p = Point { x = 3L, y = 4L } in match p with | value -> (value.x + value.y) * (value.x - value.y) = -7L

// Manhattan distance style
match Point { x = 3L, y = 4L } with | p -> if p.x > p.y then p.x else p.y = 4L

// === Wild Nested Combinations ===

// Tuple in ADT payload then extracted
type BoxPair = EmptyPair | Pair of Int64

match Pair(42L) with | Pair(n) -> let t = (n, n + 1L) in match t with | (a, b) -> a + b | EmptyPair -> 0L = 85L

// ADT in tuple (via let)
type Maybe = No | Yes of Int64

let m = Yes(5L) in let t = (m, 10L) in match t with | (_, y) -> y = 10L

// Deeply nested match cascade
match 1L with | 1L -> match 2L with | 2L -> match 3L with | 3L -> 42L | _ -> 0L | _ -> 0L | _ -> 0L = 42L

// Match that returns different types of numbers
match true with | true -> 99L | false -> 0L - 1L = 99L

// Compare result in match
let x = 5L in let y = 5L in match x == y with | true -> 1000L | false -> 0L = 1000L

// Boolean arithmetic in match
match (5L > 3L) && (2L < 4L) with | true -> 1L | false -> 0L = 1L

// Or in match condition
match (1L > 10L) || (10L > 1L) with | true -> 42L | false -> 0L = 42L

// === Non-exhaustive pattern match test ===
// A non-matching exact list pattern is rejected before lowering.
match [1L, 2L, 3L] with | [a, b] -> a + b = error="Non-exhaustive match expression"

// Duplicate bindings in a single pattern should be rejected by type checking.
match (1L, 2L) with | (x, x) -> x | _ -> 0L = error="Duplicate binding 'x' in the same pattern"

// Pattern groups must bind the same names in every alternative.
match (1L, 2L) with | (x, _) | (_, _) -> x | _ -> 0L = error="Pattern matches require all branches to provide the same variables - expected [x], got []"

// Underscore-prefixed names bind locally but do not participate in the
// alternative binding-set check, matching interpreter validation.
match 1 with | _left | _right -> 1 = 1

// Grouped list-pattern alternatives on non-list scrutinees must compile as non-matches.
// Regression: lowering previously hit a TInt64 fallback and crashed during MIR conversion.
match 42L with | 0L | [_] -> 1L | _ -> 99L = 99L

// Nested list pattern inside a grouped tuple alternative must not execute list extraction on non-list tuple fields.
// Regression: default TInt64 element typing let an impossible branch segfault at runtime.
match (1L, 2L) with | (x, 0L) | ([x], _) -> x | _ -> 99L = 99L

// Tuple arity-mismatch alternatives in a grouped pattern must not default bindings to Stdlib.Int64.
// The impossible `(x, _, _)` alternative should contribute no type bindings, so `x` stays Stdlib.String.
(match ("a" ++ "b", 1L) with | (x, _) | (x, _, _) -> x | _ -> "") == "ab" = true

// Integer literal pattern on non-int scrutinee should be rejected
match true with | 1L -> 42L | _ -> 0L = error="Cannot match Bool value true with an Int64 pattern"

// List cons pattern on non-list type should be rejected (prevents TInt64 fallback in AST_to_ANF)
// The type checker prevents this - without this check, the compiler would silently assume
// TInt64 element type which would produce incorrect code
match 42L with | h :: t -> h | _ -> 0L = error="Cannot match Int64 value 42 with a List pattern"

// === Nested pattern tests ===

// Record values use variable matches plus access; record destructuring is not public syntax.
type Point = { x: Int64, y: Int64 } match Point { x = 5L, y = 10L } with | p when p.x == 5L -> p.y | _ -> 0L = 10L

// Nested constructor pattern in list element
type MyOpt = MyNone | MySome of Int64 match [MySome(1L)] with | [MySome(x)] -> x | _ -> 0L = 1L

// Nested literal pattern inside tuple inside list
match [(1L, 2L)] with | [(1L, x)] -> x | _ -> 0L = 2L

// Parenthesized alternatives are recursive patterns in the interpreter grammar.
// The first matching alternative supplies the bindings to the guard and body.
match (2L, 3L) with | ((1L | 2L), x) -> x | _ -> 0L = 3L

// A failed alternative must not leak its partial binding into the guard.
match (0L, 7L) with | ((x, 0L) | (0L, x)) when x == 7L -> x | _ -> 0L = 7L

// Nested constructor pattern in list cons head
type MyOpt = | MyNone | MySome of Int64; match [MySome(1L), MySome(2L)] with | (MySome(x)) :: rest -> x | _ -> 0L = 1L

// Nested literal pattern inside tuple inside list cons
match [(1L, 2L), (3L, 4L)] with | (1L, x) :: rest -> x | _ -> 0L = 2L

// === Literal patterns in lists (now supported) ===
// These test that literal patterns in list elements work correctly

// Literal pattern in list - match
match [1L, 2L, 3L] with | [1L, x, 3L] -> x | _ -> 0L = 2L

// Literal pattern in list - no match (wrong literal)
match [1L, 2L, 4L] with | [1L, x, 3L] -> x | _ -> 0L = 0L

// Literal pattern in list cons - match
match [1L, 2L, 3L] with | 1L :: rest -> 42L | _ -> 0L = 42L

// List cons should preserve string element typing even when scrutinee type comes from an if-expression
// with an unreachable runtime-error branch.
match (if false then Stdlib.Option.Option.None |> Builtin.unwrap else ["a", "b"]) with | h :: t -> if h == "a" then 1L else 0L | _ -> 0L = 1L

// Guarded list cons should preserve string element typing from inferred scrutinee types.
match (if false then Stdlib.Option.Option.None |> Builtin.unwrap else ["a", "b"]) with | h :: t when h == "a" -> 1L | _ -> 0L = 1L

// Literal pattern in list cons - no match
match [2L, 2L, 3L] with | 1L :: rest -> 42L | _ -> 0L = 0L

// Tuple arity mismatch in list-cons head must fall through (regression for TInt64 fallback in tuple element typing)
match [(1L, 2L)] with | (a, b, c) :: rest -> 1L | _ -> 2L = 2L

// List-cons tuple head patterns must preserve unresolved tuple element bindings instead of dropping to TInt64/defaults.
// Regression: when the list element type arrived as TVar from ANF inferType, this failed with `Undefined variable: a`.
let x = match false with | true -> [] | false -> [(("a" ++ ""), ("b" ++ ""))] in match x with | (a, b) :: rest -> match a with | _ -> 1L | _ -> 2L = 1L

// Nested list-cons heads must not default unresolved inner element types to TInt64.
// Regression: this produced 3.0 instead of 4.0 by lowering `a`/`b` as Int64 in ANF.
let x = match false with | true -> [] | false -> [[1.5, 2.5], [3.0]] in match x with | (a :: b :: inner) :: y :: rest -> a + b | _ -> 0.0 = 4.0

// Tuple arity mismatch inside constructor payload list pattern must not default missing tuple slots to Stdlib.Int64.
// Regression: this previously matched and evaluated the branch body instead of surfacing the tuple arity issue.
type TupleListBox = TupleListBox of List<(Int64, Int64)> match TupleListBox([(1L, 2L)]) with | TupleListBox([(a, b, c)]) -> 1L | _ -> 2L = error="Tuple pattern expects 3 elements but got 2"

// Constructor payload tuple pattern on non-tuple payload type must not match in list patterns.
// Regression: this previously matched due nested tuple bindings defaulting to TInt64.
match [Some(5L), Some(6L)] with | [None, _] -> 1L | [Some((x, _)), _] -> 2L | _ -> 3L = 3L

// Generic constructor payload tuple destructuring must preserve unresolved tuple element bindings.
// Regression: lowering dropped tuple bindings for `TVar` payloads and failed with `Undefined variable: x`.
let genericPayloadTupleBinding(v: Stdlib.Option.Option<(String, Int64)>) : String = match v with | Some((x, _)) -> x | _ -> "" genericPayloadTupleBinding(Some(("a" ++ "", 1L))) = "a"

// Generic top-level list patterns should allow unresolved scrutinee TVars.
// Regression: type checking rejected list-pattern bindings on TVar scrutinees before lowering.
let genericTopLevelListMatch<'t>(v: t) : Float = match v with | [a, b] -> 4.0 | _ -> 0.0; genericTopLevelListMatch<List<Float>>([1.5, 2.5]) = 4.0

// Generic tuple/list-cons patterns should preserve unresolved element bindings.
let genericTupleListConsBinding<'t>(v: t) : String = match v with | (x :: _, _) -> x | _ -> ""; genericTupleListConsBinding<(List<String>, Int64)>((["a" ++ ""], 1L)) = "a"

// Single literal pattern
match [13L] with | [13L] -> 1L | _ -> 0L = 1L

// Single literal pattern - no match
match [14L] with | [13L] -> 1L | _ -> 0L = 0L

// === Nested Bool patterns in constructors (regression tests) ===
// These test that Option<Bool> with literal patterns work correctly

// Some(false) should NOT match Some(true)
match Some(false) with | Some(true) -> 100L | Some(false) -> 0L | None -> -1L = 0L

// Some(true) should match Some(true)
match Some(true) with | Some(true) -> 100L | Some(false) -> 0L | None -> -1L = 100L

// Order of patterns doesn't matter for correctness
match Some(false) with | Some(false) -> 0L | Some(true) -> 100L | None -> -1L = 0L

// Wildcard should work as fallback
match Some(false) with | Some(true) -> 100L | _ -> 0L = 0L

// Variable binding in Some still works
match Some(true) with | Some(x) -> match x with | true -> 42L | false -> 0L | None -> -1L = 42L

// === Nested tuple literal patterns in constructor payloads (kills mutation #85) ===
// Tests that buildPatternComparison correctly handles tuple patterns with literals
// inside constructor payloads, specifically testing index incrementing

// Define a type with a tuple payload
type TupleBox = TupleEmpty | TupleHas of (Int64, Int64)

// Tuple literal pattern inside constructor - should NOT match when second element differs
// If index + 1 were changed to index - 1, both comparisons would check the first element
// causing (5, 7) to incorrectly match (5, 5) since it would compare 5==5 twice
match TupleHas((5L, 7L)) with | TupleHas((5L, 5L)) -> 1L | _ -> 0L = 0L

// Verify positive case - should match when all elements are equal
match TupleHas((5L, 5L)) with | TupleHas((5L, 5L)) -> 1L | _ -> 0L = 1L

// Three-element tuple payload to verify all indices increment correctly
type TripleBox = TripleEmpty | TripleHas of (Int64, Int64, Int64)
match TripleHas((10L, 20L, 30L)) with | TripleHas((10L, 10L, 10L)) -> 1L | _ -> 0L = 0L
match TripleHas((10L, 10L, 10L)) with | TripleHas((10L, 10L, 10L)) -> 1L | _ -> 0L = 1L

// === Tuple with list patterns (regression test) ===
// Tests that tuple patterns containing list patterns correctly check each list

// Tuple with empty list pattern - should NOT match when first element is non-empty
let a = [1L, 2L] in let b = [3L, 4L] in match (a, b) with | ([], _) -> 0L | (_, []) -> 1L | _ -> 99L = 99L

// Tuple with empty list pattern - should match when first element IS empty
let a = [] in let b = [3L, 4L] in match (a, b) with | ([], _) -> 0L | (_, []) -> 1L | _ -> 99L = 0L

// Tuple with empty list pattern - should match when second element is empty
let a = [1L, 2L] in let b = [] in match (a, b) with | ([], _) -> 0L | (_, []) -> 1L | _ -> 99L = 1L

// Both empty lists
let a = [] in let b = [] in match (a, b) with | ([], _) -> 0L | (_, []) -> 1L | _ -> 99L = 0L

// Record field access after a variable match preserves the field's String type.
type PersonEq = { name: String } let p = PersonEq { name = "a" ++ "b" } in let extracted = match p with | value -> value.name in extracted == ("a" ++ "b") = true

// Full pattern with list cons
let a = [1L, 2L] in let b = [3L, 4L] in match (a, b) with | ([], _) -> 0L | (_, []) -> 1L | (x :: xs, y :: ys) -> x + y | _ -> 99L = 4L

// === Tuple+cons pattern matching with different body expressions ===
// These tests verify tuple patterns containing list cons patterns work correctly.

// Int64 accumulator - works
let recursiveTupleConsHelper(a: List<Int64>, b: List<Int64>, acc: Int64) : Int64 =
    match (a, b) with
    | ([], _) -> acc
    | (_, []) -> acc
    | (x :: xs, y :: ys) -> recursiveTupleConsHelper(xs, ys, acc + x + y)

recursiveTupleConsHelper([1L, 2L, 3L], [4L, 5L, 6L], 0L) = 21L

// Single list pattern with list cons in body - works
let singleListConsWithAcc(a: List<Int64>, acc: List<Int64>) : List<Int64> =
    match a with
    | [] -> acc
    | x :: xs -> singleListConsWithAcc(xs, Stdlib.List.push<Int64>(acc, x))

Stdlib.List.length<Int64>(singleListConsWithAcc([1L, 2L, 3L], [])) = 3I

// Workaround for tuple+cons+list-accumulator: use nested matches instead of tuple pattern
// This is the pattern used in Stdlib.Crypto.__xorByteLists
let nestedMatchListCons(a: List<Int64>, b: List<Int64>, acc: List<Int64>) : List<Int64> =
    match a with
    | [] -> acc
    | x :: xs ->
        match b with
        | [] -> acc
        | y :: ys -> nestedMatchListCons(xs, ys, Stdlib.List.push<Int64>(acc, x + y))

Stdlib.List.length<Int64>(nestedMatchListCons([1L, 2L, 3L], [4L, 5L, 6L], [])) = 3I

// Tuple+cons pattern with list accumulator body - now fixed with TypedAtom wrapper
let tupleConsListAccum(a: List<Int64>, b: List<Int64>, acc: List<Int64>) : List<Int64> =
    match (a, b) with
    | ([], _) -> acc
    | (_, []) -> acc
    | (x :: xs, y :: ys) -> tupleConsListAccum(xs, ys, Stdlib.List.push<Int64>(acc, x + y))

Stdlib.List.length<Int64>(tupleConsListAccum([1L, 2L, 3L], [4L, 5L, 6L], [])) = 3I

// ===================================================================
// Variable in scrutinee only (kills mutation #140)
// Tests that varOccursInExpr correctly detects variables appearing
// ONLY in the scrutinee (not in case bodies). Mutation #140 changes
// || to && in the Match case, which would incorrectly report that
// a variable doesn't occur if it only appears in the scrutinee.
// ===================================================================

// Variable only appears in scrutinee - literal patterns in cases
let scrutineeOnly = 42L in match scrutineeOnly with | 42L -> 100L | _ -> 0L = 100L

// Variable in scrutinee with complex expression
let computed = 6L * 7L in match computed with | 42L -> 1L | 0L -> 2L | _ -> 3L = 1L

// Int128/UInt128 literal patterns must not use UInt64/Int64 modulo behavior.
match 18446744073709551616Q with | 0Q -> true | _ -> false = false
match 18446744073709551616Z with | 0Z -> true | _ -> false = false

// Regression: list mismatch checks must not treat 64-bit literal patterns as 128-bit.
// These are rejected before lowering rather than emitting a runtime match failure.
match [1L] with | [1L, 2L] -> 0L = error="Non-exhaustive match expression"
match [1UL] with | [1UL, 2UL] -> 0UL = error="Non-exhaustive match expression"

// Int128/UInt128 list literal length mismatch should behave consistently with other int types.
match [1Q] with | [1Q, 2Q] -> 0Q = error="Non-exhaustive match expression"
match [1Z] with | [1Z, 2Z] -> 0Z = error="Non-exhaustive match expression"

// Int128/UInt128 pattern coverage parity with other integer literal patterns.
type I128Wrap = I128Wrap of Int128 | I128None
type U128Wrap = U128Wrap of UInt128 | U128None

match I128Wrap(170141183460469231731687303715884105727Q) with | I128Wrap(170141183460469231731687303715884105727Q) -> true | _ -> false = true
match U128Wrap(340282366920938463463374607431768211455Z) with | U128Wrap(340282366920938463463374607431768211455Z) -> true | _ -> false = true

match [170141183460469231731687303715884105727Q, 1Q] with | 170141183460469231731687303715884105727Q :: tail -> Stdlib.List.length<Int128>(tail) | _ -> 0I = 1I
match [340282366920938463463374607431768211455Z, 1Z] with | 340282366920938463463374607431768211455Z :: tail -> Stdlib.List.length<UInt128>(tail) | _ -> 0I = 1I

match 5Q with | 4Q | 5Q -> 1L | _ -> 0L = 1L
match 5Z with | 4Z | 5Z -> 1L | _ -> 0L = 1L

// A finite scrutinee with an uncovered case must fail during AOT type checking.
match false with | true -> 1L = error="Non-exhaustive match expression"
