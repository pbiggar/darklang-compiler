// Inlining a callee with several returns must not copy the caller's
// continuation into each of them: a derived record equality over Option
// fields is a chain of such calls, and the copies multiplied to tens of
// millions of ANF nodes (WIP.AI.Anthropic.Content.Citation in darklang/dark).

type InlineJoinRecord =
  { a: Stdlib.Option.Option<Int64>
    b: Stdlib.Option.Option<String>
    c: Stdlib.Option.Option<Int64>
    d: Stdlib.Option.Option<Int64>
    e: Stdlib.Option.Option<String>
    f: Stdlib.Option.Option<Int64>
    g: Stdlib.Option.Option<Int64>
    h: Stdlib.Option.Option<String>
    i: Stdlib.Option.Option<Int64>
    j: Stdlib.Option.Option<Int64>
    k: Stdlib.Option.Option<String>
    l: Stdlib.Option.Option<Int64>
    m: Stdlib.Option.Option<Int64>
    n: Stdlib.Option.Option<String> }

let inlineJoinSample (x: Int64) : InlineJoinRecord =
  InlineJoinRecord
    { a = Stdlib.Option.Option.Some x
      b = Stdlib.Option.Option.None
      c = Stdlib.Option.Option.Some 3L
      d = Stdlib.Option.Option.None
      e = Stdlib.Option.Option.Some "e"
      f = Stdlib.Option.Option.Some 6L
      g = Stdlib.Option.Option.None
      h = Stdlib.Option.Option.None
      i = Stdlib.Option.Option.Some 9L
      j = Stdlib.Option.Option.Some 10L
      k = Stdlib.Option.Option.Some "k"
      l = Stdlib.Option.Option.None
      m = Stdlib.Option.Option.Some 13L
      n = Stdlib.Option.Option.None }

inlineJoinSample 1L == inlineJoinSample 1L = true
inlineJoinSample 1L == inlineJoinSample 2L = false
[inlineJoinSample 1L, inlineJoinSample 2L] == [inlineJoinSample 1L, inlineJoinSample 2L] = true

// A lambda whose arms differ only in what a literal leaves open infers: `[]`
// is a List<t> next to a List<Int64> arm (90 fns in darklang/dark had a
// "could not infer return type for lambda body" from this).
let lambdaEmptyListArm (xs: List<Int64>) : List<Int64> =
  let g = (fun ys -> if Stdlib.List.isEmpty ys then [] else Stdlib.List.reverse ys)
  g xs
lambdaEmptyListArm [1L, 2L] = [2L, 1L]
lambdaEmptyListArm [] = []

let lambdaEmptyListMatch (xs: List<String>) : List<String> =
  let g = (fun ys -> match ys with | [] -> [] | y :: rest -> [y])
  g xs
lambdaEmptyListMatch ["a", "b"] = ["a"]
lambdaEmptyListMatch [] = []

// An empty list as the seed of a generic call: the type variable takes the
// list and the element is fixed by the other arguments.
let foldFromEmpty (ids: List<Int64>): List<Int64> =
  Stdlib.List.fold ids [] (fun acc id -> Stdlib.List.append acc [id])
foldFromEmpty [1L, 2L] = [1L, 2L]
foldFromEmpty [] = []

// A callee with several returns whose result is not a Bool is not inlined
// where that would copy a large continuation: the derived JSON serializer of
// a record of Options grew from 66 to 430,000 nodes (WIP.AI.Anthropic.Content
// in darklang/dark, every block constructor hung when called).
type InlineJsonRecord =
  { a: Stdlib.Option.Option<String>
    b: Stdlib.Option.Option<String>
    c: Stdlib.Option.Option<Int64>
    d: Stdlib.Option.Option<String>
    e: Stdlib.Option.Option<Int64>
    f: Stdlib.Option.Option<String>
    g: Stdlib.Option.Option<Int64>
    h: Stdlib.Option.Option<String>
    i: Stdlib.Option.Option<Int64>
    j: Stdlib.Option.Option<String> }
Stdlib.Json.serialize<InlineJsonRecord> (InlineJsonRecord { a = Stdlib.Option.Option.Some "a", b = Stdlib.Option.Option.None, c = Stdlib.Option.Option.Some 3L, d = Stdlib.Option.Option.None, e = Stdlib.Option.Option.None, f = Stdlib.Option.Option.Some "f", g = Stdlib.Option.Option.None, h = Stdlib.Option.Option.None, i = Stdlib.Option.Option.Some 9L, j = Stdlib.Option.Option.None }) = "{\"a\":{\"Some\":[\"a\"]},\"b\":{\"None\":[]},\"c\":{\"Some\":[3]},\"d\":{\"None\":[]},\"e\":{\"None\":[]},\"f\":{\"Some\":[\"f\"]},\"g\":{\"None\":[]},\"h\":{\"None\":[]},\"i\":{\"Some\":[9]},\"j\":{\"None\":[]}}"
