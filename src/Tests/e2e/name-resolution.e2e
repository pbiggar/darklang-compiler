// Canonical name-resolution boundary and interpreter-derived precedence.

// Qualified package/module spellings resolve exactly.
Stdlib.Float.sqrt(4.0) = 2.0

// The compiler no longer inserts an implicit Stdlib qualifier.
Float.sqrt(4.0) = error="Unresolved callable name: Float.sqrt"

// Lexical callable values shadow a same-spelled top-level function.
let shadowed(x: Int64): Int64 = x + 10L let shadowed = fun x -> x + 20L in shadowed(1L) = 21L

// Interpreter overlays are deterministic: the last same-category declaration wins.
let duplicated(x: Int64): Int64 = x + 1L let duplicated(x: Int64): Int64 = x + 2L duplicated(1L) = 3L

// Constructors from distinct user types do not acquire an order-dependent winner.
type FirstChoice = SharedChoice | FirstOnly
type SecondChoice = SharedChoice | SecondOnly
SharedChoice = error="Ambiguous constructor reference 'SharedChoice': constructor FirstChoice.SharedChoice, constructor SecondChoice.SharedChoice"

// Explicit qualification selects the constructor identity uniquely.
type QualifiedFirst = QualifiedShared | QualifiedFirstOnly
type QualifiedSecond = QualifiedShared | QualifiedSecondOnly
QualifiedFirst.QualifiedShared == QualifiedFirst.QualifiedShared = true

// Missing names retain their reference category in the diagnostic.
doesNotExist(1L) = error="Unresolved callable name: doesNotExist"

// A function identity in value position is never coerced into a call.
let nullaryIdentity(): Int64 = 1L let needsInt64(): Int64 = nullaryIdentity; needsInt64() = error="needsInt64's return value expects Int64, but got (Unit) -> Int64"
