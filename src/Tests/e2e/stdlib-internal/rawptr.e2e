// Raw pointer internals (stdlib-only)
// These tests rely on internal runtime helpers.

def __stringRefcount(s: String): Int64 = let len = Stdlib.String.length(s) in let dataSize = ((len + 7) / 8) * 8 in __raw_get<Int64>(__string_to_rawptr(s), 8 + dataSize)
def dynamicString(s: String): String = s ++ "b"

// Raw float load should preserve float type through if-join
let rawPtr = __raw_alloc(8) in let _ = __raw_slot_init<Float>(rawPtr, 0, 1.5) in let rawVal = __raw_get<Float>(rawPtr, 0) in if true then rawVal else 2.5 = 1.5

// __raw_get<T> should preserve T through ANF inferType when lowered to __raw_get_* intrinsics.
// Regression: a fallback to TInt64 made this tuple/list pattern arm get optimized away.
let p = __raw_alloc(8) in let _ = __raw_slot_init<(List<String>, Int64)>(p, 0, (["a"], 1)) in let x = __raw_get<(List<String>, Int64)>(p, 0) in match x with | ([_], _) -> 1 | _ -> 2 = 1

// If lowered via IfValue in atom position, dead branch side effects must remain lazy.
let p = __raw_alloc(8) in let _ = __raw_write_word(p, 0, 1) in let _ = if true then 0 else let _ = __raw_write_word(p, 0, 99) in 0 in __raw_get<Int64>(p, 0) = 1

// Conditional conditions run exactly once, and statement sequences run left-to-right.
let p = __raw_alloc(8) in let _ = __raw_write_word(p, 0, 0) in let _ = if (__raw_write_word(p, 0, __raw_get<Int64>(p, 0) + 1); true) then () else () in __raw_get<Int64>(p, 0) = 1
let p = __raw_alloc(8) in (__raw_write_word(p, 0, 1); __raw_write_word(p, 0, 2); __raw_get<Int64>(p, 0)) = 2

// Allocator should fail gracefully (exit=1) instead of SIGSEGV when bump allocation exceeds heap.
let p1 = __raw_alloc(600000000) in let p2 = __raw_alloc(8) in let _ = __raw_write_word(p2, 0, 1) in 0 = exit=1 stderr="Out of heap memory"

// Raw slot initialization distinguishes typed slot edges from raw metadata writes.
let p = __raw_alloc(8) in let _ = __raw_slot_init<Float>(p, 0, 1.5) in let rawVal = __raw_get<Float>(p, 0) in rawVal = 1.5
let p = __raw_alloc(16) in let s = dynamicString("a") in let _ = __raw_slot_init<String>(p, 0, s) in __stringRefcount(s) = stdout="2\n" // RawSlotInit<String> retains typed slot edge

// Structured values expose RawPtr views without routing through Stdlib.Int64.
let s = "a" ++ "b" in __raw_get<Int64>(__string_to_rawptr(s), 0) = 2
let b = Stdlib.Bytes.create(3) in __raw_get<Int64>(__bytes_to_rawptr(b), 0) = 3
let p = __raw_alloc(24) in let _ = __raw_write_word(p, 0, 1) in let _ = __raw_write_byte(p, 8, 90) in let _ = __raw_write_word(p, 16, 1) in Stdlib.String.getByteAt(__rawptr_to_string(p), 0) = 90
let p = __raw_alloc(24) in let _ = __raw_write_word(p, 0, 1) in let _ = __raw_write_byte(p, 8, 91) in let _ = __raw_write_word(p, 16, 1) in Stdlib.Bytes.get(__rawptr_to_bytes(p), 0) = 91
