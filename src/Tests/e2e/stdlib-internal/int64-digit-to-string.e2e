// Internal stdlib helper tests: Stdlib.Int64.__digitToString
//
// Internal identifiers are only allowed in stdlib-internal test files.

Stdlib.Int64.__digitToString(0L) = "0"
Stdlib.Int64.__digitToString(5L) = "5"
Stdlib.Int64.__digitToString(9L) = "9"
Stdlib.Int64.__digitToString(10L) = error="Uncaught exception: Stdlib.Int64.__digitToString expected a digit from 0 to 9"
