// Refcount internals (stdlib-only)
// These tests call internal refcount helpers and should not be used by user code.

def dynamicString(s: String): String = s ++ "b"

// Leak check detects refcount leaks for heap strings
let s = dynamicString("a") in let _ = __refcount_inc_string(s) in 0 = stdout="0\n" stderr="leaks: 1\n" // leak_check

// Current leak-accounting baseline for memory-managed runtime shapes.
// These tests intentionally record today's behavior so each shape can be
// re-enabled to expect stderr="" as the refcounting implementation reaches it.

// Dynamic strings are counted and decref'd at scope exit.
def __stringRefcount(s: String): Int64 = let len = Stdlib.String.length(s) in let dataSize = ((len + 7) / 8) * 8 in __raw_get<Int64>(__string_to_rawptr(s), 8 + dataSize)
let s = "a" ++ "b" in 0 = stdout="0\n" stderr="" // string concat reclaimed
let src = "a" ++ "bc" in let s = Stdlib.String.slice(src, 0, 1) in 0 = stdout="0\n" stderr="" // unaligned string slice reclaimed
let s = Stdlib.String.fromCodepoints([97]) in 0 = stdout="0\n" stderr="" // unaligned string builder reclaimed
let s = Stdlib.Float.toString(1.25) in 0 = stdout="0\n" stderr="" // float toString result reclaimed
let sign = if false then "-" else "" in let s = sign ++ "1" in 0 = stdout="0\n" stderr="" // branch-selected literal string reclaimed
let s = Stdlib.String.toUpperCase("a" ++ "b") in 0 = stdout="0\n" stderr="" // string toUpperCase result and input reclaimed
let s = Stdlib.String.replace("a,b,c", ",", "|") in 0 = stdout="0\n" stderr="" // string replace result and intermediate splits reclaimed
let s = Stdlib.String.join(["a" ++ "b", "c" ++ "d"], ",") in 0 = stdout="0\n" stderr="" // string join result and list payloads reclaimed
let parts = Stdlib.String.split("a,b,c", ",") in 0 = stdout="0\n" stderr="" // string split list payloads reclaimed
def quoteBranchItem(s: String): String = "\"" ++ s ++ "\"" def branchSelectedString(list: List<String>, first: Bool): String = match list with | [] -> "" | [h] -> let item = quoteBranchItem(h) in if first then item else ", " ++ item | [h, ...t] -> branchSelectedString(t, false) let s = branchSelectedString(["a" ++ "b", "c" ++ "d"], true) in 0 = stdout="0\n" stderr="" // branch-local string intermediate reclaimed
let h = Stdlib.String.head("a" ++ "b") in 0 = stdout="0\n" stderr="" // string head option payload reclaimed
let s = Stdlib.String.padStart("x", 3, "0") in 0 = stdout="0\n" stderr="" // string padStart result and intermediate pads reclaimed
let s = Stdlib.String.trim(" " ++ "ab" ++ " ") in 0 = stdout="0\n" stderr="" // string trim result and intermediate slices reclaimed
let s = Stdlib.List.toDisplayString_i64([1, 2, 3]) in 0 = stdout="0\n" stderr="" // int list display string reclaimed
let s = Stdlib.List.toDisplayString_str(["a" ++ "b"]) in 0 = stdout="0\n" stderr="" // string list display string and input reclaimed
let s = Stdlib.List.toDisplayString_str(["a" ++ "b", "c" ++ "d"]) in 0 = stdout="0\n" stderr="" // multi string list display string and inputs reclaimed
let s = Stdlib.List.toDisplayString_bool([true, false]) in 0 = stdout="0\n" stderr="" // bool list display string reclaimed
let s = Stdlib.List.toDisplayString_f64([1.25, 2.0]) in 0 = stdout="0\n" stderr="" // float list display string reclaimed
let s = Stdlib.Crypto.bytesToHex(Stdlib.Bytes.fromList([1, 2, 255])) in 0 = stdout="0\n" stderr="" // bytes-to-hex display string and input reclaimed
let s = Stdlib.Base64.encode(Stdlib.Bytes.fromList([1, 2, 3])) in 0 = stdout="0\n" stderr="" // base64 encode string and input bytes reclaimed
let result = Stdlib.File.readText("/etc/hosts") in 0 = stdout="0\n" stderr="" // file read success result string reclaimed
let _ = Stdlib.File.writeText("/tmp/dark_refcount_unaligned_read.txt", "abcde") in let result = Stdlib.File.readText("/tmp/dark_refcount_unaligned_read.txt") in 0 = stdout="0\n" stderr="" // unaligned file read result string reclaimed
let result = Stdlib.File.readText("/nonexistent/dark/refcounting/read.txt") in 0 = stdout="0\n" stderr="" // file read error result string reclaimed
let result = Stdlib.File.writeText("/tmp/dark_refcount_write_success.txt", "abcde") in 0 = stdout="0\n" stderr="" // file write success result root reclaimed
let result = Stdlib.File.writeText("/nonexistent/dark/refcounting/write.txt", "test") in 0 = stdout="0\n" stderr="" // file write error result string reclaimed
let result = Stdlib.File.appendText("/nonexistent/dark/refcounting/append.txt", "test") in 0 = stdout="0\n" stderr="" // file append error result string reclaimed
let _ = Stdlib.File.writeText("/tmp/dark_refcount_delete_success.txt", "abcde") in let result = Stdlib.File.delete("/tmp/dark_refcount_delete_success.txt") in 0 = stdout="0\n" stderr="" // file delete success result root reclaimed
let result = Stdlib.File.delete("/nonexistent/dark/refcounting/delete.txt") in 0 = stdout="0\n" stderr="" // file delete error result string reclaimed
let _ = Stdlib.File.writeText("/tmp/dark_refcount_set_executable_success.txt", "abcde") in let result = Stdlib.File.setExecutable("/tmp/dark_refcount_set_executable_success.txt") in 0 = stdout="0\n" stderr="" // file setExecutable success result root reclaimed
let result = Stdlib.File.setExecutable("/nonexistent/dark/refcounting/set-executable.txt") in 0 = stdout="0\n" stderr="" // file setExecutable error result string reclaimed

// Dynamic bytes use the same length-aligned refcount slot as dynamic strings.
let b = Stdlib.Bytes.create(4) in 0 = stdout="0\n" stderr=""
def __bytesRefcount(b: Bytes): Int64 = let len = Stdlib.Bytes.length(b) in let dataSize = ((len + 7) / 8) * 8 in __raw_get<Int64>(__bytes_to_rawptr(b), 8 + dataSize)

// HAMT/dict roots use typed refcounting and reclaim raw nodes when the root dies.
let d = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 1, 2) in 0 = stdout="0\n" stderr="" // dict singleton reclaimed
let d = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 1, 2) in let d2 = Stdlib.Dict.set(d, 1, 3) in 0 = stdout="0\n" stderr="" // dict overwrite reclaimed
let d = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 1, 2) in let d2 = Stdlib.Dict.remove(d, 1) in 0 = stdout="0\n" stderr="" // dict remove reclaimed
let d = Stdlib.Dict.fromList<Int64, Int64>([(1, 2), (3, 4)]) in 0 = stdout="0\n" stderr="" // dict fromList and input tuple list reclaimed
let d = Stdlib.Dict.set(Stdlib.Dict.empty<String, Int64>(), "a" ++ "b", 1) in 0 = stdout="0\n" stderr="" // dict releases dynamic string keys
let s = dynamicString("a") in let d = Stdlib.Dict.set(Stdlib.Dict.empty<String, Int64>(), s, 1) in __stringRefcount(s) = stdout="2\n" stderr="" // dict raw leaf retains dynamic string key edge
let d = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, String>(), 1, "a" ++ "b") in 0 = stdout="0\n" stderr="" // dict releases dynamic string values
let d = Stdlib.Dict.set(Stdlib.Dict.empty<Bytes, Int64>(), Stdlib.Bytes.create(4), 1) in 0 = stdout="0\n" stderr="" // dict releases dynamic bytes keys
let d = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Bytes>(), 1, Stdlib.Bytes.create(4)) in 0 = stdout="0\n" stderr="" // dict releases dynamic bytes values
let d0 = Stdlib.Dict.set(Stdlib.Dict.empty<Bytes, Int64>(), Stdlib.Bytes.fromList([1, 2]), 1) in let d1 = Stdlib.Dict.set(d0, Stdlib.Bytes.fromList([1, 2]), 2) in 0 = stdout="0\n" stderr="" // dict bytes key overwrite releases replaced dynamic payloads
def dictStringKey(): Dict<String, Int64> = Stdlib.Dict.set(Stdlib.Dict.empty<String, Int64>(), "a" ++ "b", 1) let d = dictStringKey() in 0 = stdout="0\n" stderr="" // returned dict owns and releases dynamic string keys
def dictStringValue(): Dict<Int64, String> = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, String>(), 1, "a" ++ "b") let d = dictStringValue() in 0 = stdout="0\n" stderr="" // returned dict owns and releases dynamic string values
type DictSumPayload = DictSumEmpty | DictSumString of String def dictSumValue(): Dict<Int64, DictSumPayload> = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, DictSumPayload>(), 1, DictSumString("a" ++ "b")) let d = dictSumValue() in 0 = stdout="0\n" stderr="" // returned dict releases sum value payload fields
let d1 = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, String>(), 1, "a" ++ "b") in let d2 = Stdlib.Dict.set(d1, 2, "c" ++ "d") in Stdlib.String.length(Stdlib.Dict.getOrDefault<Int64, String>(d1, 1, "")) + Stdlib.String.length(Stdlib.Dict.getOrDefault<Int64, String>(d2, 2, "")) = stdout="4\n" stderr="" // dict update keeps old and new roots live with managed values
let d1 = Stdlib.Dict.set(Stdlib.Dict.set(Stdlib.Dict.empty<Int64, String>(), 1, "a" ++ "b"), 2, "c" ++ "d") in let d2 = Stdlib.Dict.remove(d1, 2) in Stdlib.String.length(Stdlib.Dict.getOrDefault<Int64, String>(d1, 2, "")) + Stdlib.String.length(Stdlib.Dict.getOrDefault<Int64, String>(d2, 1, "")) = stdout="4\n" stderr="" // dict remove keeps old and new roots live with shared managed values
let d1 = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, String>(), 1, "a" ++ "b") in let d2 = Stdlib.Dict.set(d1, 1, "c" ++ "d") in Stdlib.String.length(Stdlib.Dict.getOrDefault<Int64, String>(d1, 1, "")) + Stdlib.String.length(Stdlib.Dict.getOrDefault<Int64, String>(d2, 1, "")) = stdout="4\n" stderr="" // dict overwrite keeps old and new roots live with managed values
let base = Stdlib.Dict.set(Stdlib.Dict.set(Stdlib.Dict.empty<Int64, String>(), 1, "a" ++ "b"), 17, "c" ++ "d") in let left = Stdlib.Dict.set(base, 33, "e" ++ "f") in let right = Stdlib.Dict.set(base, 49, "g" ++ "h") in Stdlib.String.length(Stdlib.Dict.getOrDefault<Int64, String>(base, 1, "")) + Stdlib.String.length(Stdlib.Dict.getOrDefault<Int64, String>(left, 33, "")) + Stdlib.String.length(Stdlib.Dict.getOrDefault<Int64, String>(right, 49, "")) = stdout="6\n" stderr="" // dict branch sharing keeps base and derived roots live with managed values
let d = Stdlib.Dict.set(Stdlib.Dict.empty<String, String>(), "a" ++ "b", "c" ++ "d") in Stdlib.String.length(Stdlib.Dict.getOrDefault<String, String>(d, "a" ++ "b", "")) = stdout="2\n" stderr="" // dict string keys to string values retain and release both sides
let d1 = Stdlib.Dict.set(Stdlib.Dict.empty<Bytes, Int64>(), Stdlib.Bytes.fromList([1, 2]), 1) in let d2 = Stdlib.Dict.set(d1, Stdlib.Bytes.fromList([3, 4]), 2) in Stdlib.Bytes.length(Stdlib.Option.withDefault(Stdlib.List.head<Bytes>(Stdlib.Dict.keys<Bytes, Int64>(d1)), Stdlib.Bytes.create(0))) + Stdlib.Bytes.length(Stdlib.Option.withDefault(Stdlib.List.head<Bytes>(Stdlib.Dict.keys<Bytes, Int64>(d2)), Stdlib.Bytes.create(0))) = stdout="4\n" stderr="" // dict bytes keys stay live across old and new roots
let d = Stdlib.Dict.set(Stdlib.Dict.empty<String, Int64>(), "a" ++ "b", 1) in let keys = Stdlib.Dict.keys<String, Int64>(d) in let head = Stdlib.List.head<String>(keys) in 0 = stdout="0\n" stderr="" // returned option string payload from dict keys is reclaimed
let d1 = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Bytes>(), 1, Stdlib.Bytes.create(4)) in let d2 = Stdlib.Dict.set(d1, 2, Stdlib.Bytes.create(8)) in Stdlib.Bytes.length(Stdlib.Dict.getOrDefault<Int64, Bytes>(d1, 1, Stdlib.Bytes.create(0))) + Stdlib.Bytes.length(Stdlib.Dict.getOrDefault<Int64, Bytes>(d2, 2, Stdlib.Bytes.create(0))) = stdout="12\n" stderr="" // dict bytes values stay live across old and new roots
type DictRecordValue = { dictRecordName: String } let d = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, DictRecordValue>(), 1, DictRecordValue { dictRecordName = "a" ++ "b" }) in Stdlib.String.length(Stdlib.Dict.getOrDefault<Int64, DictRecordValue>(d, 1, DictRecordValue { dictRecordName = "" }).dictRecordName) = stdout="2\n" stderr="" // dict record values release nested string fields
let d = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, List<Int64>>(), 1, [1, 2]) in 0 = stdout="0\n" stderr="" // dict list values release leaf payload roots
let base = 1 in let f = (x: Int64) => x + base in let d = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, (Int64) -> Int64>(), 1, f) in 0 = stdout="0\n" stderr="" // dict closure values release leaf payload roots
let inner = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, String>(), 1, "a" ++ "b") in let d = Stdlib.Dict.set(Stdlib.Dict.empty<String, Dict<Int64, String>>(), "k" ++ "1", inner) in 0 = stdout="0\n" stderr="" // dict nested dict values release leaf payload roots
let d = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, (String, List<Int64>)>(), 1, ("a" ++ "b", [1, 2])) in 0 = stdout="0\n" stderr="" // dict tuple values release nested leaf payload fields
let d = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, (String, List<Int64>, Dict<Int64, Int64>)>(), 1, ("a" ++ "b", [1, 2], Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 2, 3))) in 0 = stdout="0\n" stderr="" // dict tuple3 values release nested leaf payload fields
let d = Stdlib.Dict.set(Stdlib.Dict.empty<String, (String, List<Int64>, Dict<Int64, Int64>)>(), "k" ++ "1", ("a" ++ "b", [1, 2], Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 2, 3))) in 0 = stdout="0\n" stderr="" // dict dynamic string keys and tuple3 values release nested payload fields
type DictRecordManagedValue = { dictRecordManagedName: String, dictRecordManagedXs: List<Int64>, dictRecordManagedItems: Dict<Int64, Int64> } let d = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, DictRecordManagedValue>(), 1, DictRecordManagedValue { dictRecordManagedName = "a" ++ "b", dictRecordManagedXs = [1, 2], dictRecordManagedItems = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 2, 3) }) in 0 = stdout="0\n" stderr="" // dict record values release nested leaf payload fields
type DictManagedKeyRecordValue = { dictManagedKeyRecordBytes: Bytes, dictManagedKeyRecordXs: List<Int64> } let d = Stdlib.Dict.set(Stdlib.Dict.empty<String, DictManagedKeyRecordValue>(), "key" ++ "1", DictManagedKeyRecordValue { dictManagedKeyRecordBytes = Stdlib.Bytes.create(4), dictManagedKeyRecordXs = [1, 2] }) in Stdlib.Bytes.length(Stdlib.Dict.getOrDefault<String, DictManagedKeyRecordValue>(d, "key1", DictManagedKeyRecordValue { dictManagedKeyRecordBytes = Stdlib.Bytes.create(0), dictManagedKeyRecordXs = [] }).dictManagedKeyRecordBytes) = stdout="4\n" stderr="" // dict dynamic string keys and record values release nested bytes/list payload fields
type DictManagedKeySumValue = DictManagedKeySumEmpty | DictManagedKeySumTuple of (String, Bytes, List<Int64>) let d = Stdlib.Dict.set(Stdlib.Dict.empty<Bytes, DictManagedKeySumValue>(), Stdlib.Bytes.create(4), DictManagedKeySumTuple(("a" ++ "b", Stdlib.Bytes.create(8), [1, 2]))) in 0 = stdout="0\n" stderr="" // dict dynamic bytes keys and sum values release nested tuple payload fields

// Tagged list construction is reclaimed even when the list is unused.
let xs = [1, 2, 3] in 0 = stdout="0\n" stderr=""
let base = 1 in let f = (x: Int64) => x + base in let xs = [f] in 0 = stdout="0\n" stderr="" // list of closures current safe baseline
def listClosure(): List<(Int64) -> Int64> = let base = 1 in let f = (x: Int64) => x + base in [f] let xs = listClosure() in 0 = stdout="0\n" stderr="" // returned list releases closure payload roots
def listClosureCapturesString(): List<(Int64) -> String> = let captured = Stdlib.String.append("he", "ap") in let f = (x: Int64) => captured in [f] let xs = listClosureCapturesString() in 0 = stdout="0\n" stderr="" // returned list releases closure payload captures
let fs = Stdlib.List.map<Int64, (Int64) -> Int64>([1, 2], (base: Int64) => (x: Int64) => x + base) in 0 = stdout="0\n" stderr="" // stdlib map-produced list of closures releases closure payload roots
type ListPhantomEnum<a> = ListPhantomA | ListPhantomB let a = ListPhantomA in let xs = [a] in 0 = stdout="0\n" stderr="" // list does not retain generic pure enum variables as heap roots
let xs = ["a" ++ "b"] in 0 = stdout="0\n" stderr="" // list releases dynamic string payload
let s = "a" ++ "b" in let xs = [s] in 0 = stdout="0\n" stderr="" // list retains dynamic string variable payload
let s = dynamicString("a") in let xs = Stdlib.List.pushBack<String>([], s) in __stringRefcount(s) = stdout="2\n" stderr="" // Skew tree node retains its direct dynamic string payload edge
def listBytes(): List<Bytes> = [Stdlib.Bytes.create(4)] let xs = listBytes() in 0 = stdout="0\n" stderr="" // returned list releases dynamic bytes payloads
let xs = [Stdlib.Bytes.create(4), Stdlib.Bytes.create(8)] in 0 = stdout="0\n" stderr="" // list releases multiple dynamic bytes payloads
let b = Stdlib.Bytes.create(4) in let xs = [b] in 0 = stdout="0\n" stderr="" // list retains dynamic bytes variable payload
let b = Stdlib.Bytes.create(0) in 0 = stdout="0\n" stderr="" // zero-length dynamic bytes reclaimed
let b = Stdlib.Bytes.set(Stdlib.Bytes.create(4), 0, 42) in 0 = stdout="0\n" stderr="" // bytes set result reclaimed
let b0 = Stdlib.Bytes.create(4) in let b1 = Stdlib.Bytes.set(b0, 0, 42) in let b2 = Stdlib.Bytes.set(b1, 1, 43) in 0 = stdout="0\n" stderr="" // repeated bytes set results reclaimed
let b = Stdlib.Bytes.fromList([1, 2, 3, 4]) in 0 = stdout="0\n" stderr="" // bytes fromList result reclaimed
let xs = Stdlib.Bytes.toList(Stdlib.Bytes.fromList([1, 2, 3, 4])) in 0 = stdout="0\n" stderr="" // bytes toList result and source reclaimed
let b = Stdlib.Bytes.create(4) in let f = (x: Int64) => Stdlib.Bytes.length(b) + x in 0 = stdout="0\n" stderr="" // closure releases dynamic bytes capture
let xs = [("a" ++ "b", 1)] in 0 = stdout="0\n" stderr="" // list releases tuple payload root
let xs = [(Stdlib.Bytes.create(4), 1)] in 0 = stdout="0\n" stderr="" // list releases tuple bytes payload field
let xs = [([1, 2], 1)] in 0 = stdout="0\n" stderr="" // list releases tuple list payload field
let xs = [(Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 1, 2), 1)] in 0 = stdout="0\n" stderr="" // list releases tuple dict payload field
let base = 1 in let xs = [((x: Int64) => x + base, 1)] in 0 = stdout="0\n" stderr="" // list releases tuple closure payload field
let base = 1 in let xs = [((x: Int64) => x + base, [1, 2], Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 1, 2))] in 0 = stdout="0\n" stderr="" // list releases three-field tuple closure/list/dict payload fields
let xs = [(Stdlib.Bytes.create(4), [1, 2], Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 1, 2))] in 0 = stdout="0\n" stderr="" // list releases three-field tuple bytes/list/dict payload fields
let xs = [("a" ++ "b", [1, 2], Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 1, 2))] in 0 = stdout="0\n" stderr="" // list releases three-field tuple payload fields
let xs = [("a" ++ "b", Stdlib.Bytes.create(4), [1, 2])] in 0 = stdout="0\n" stderr="" // list releases three-field tuple string/bytes/list payload fields
let xs = [("a" ++ "b", Stdlib.Bytes.create(4), Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 1, 2))] in 0 = stdout="0\n" stderr="" // list releases three-field tuple string/bytes/dict payload fields
let base = 1 in let xs = [("a" ++ "b", Stdlib.Bytes.create(4), ((x: Int64) => x + base))] in 0 = stdout="0\n" stderr="" // list releases three-field tuple string/bytes/closure payload fields
type NestedTuple3ListLeafRecord = { nestedTuple3ListLeafXs: List<Int64>, nestedTuple3ListLeafName: String } let xs = [("a" ++ "b", Stdlib.Bytes.create(4), NestedTuple3ListLeafRecord { nestedTuple3ListLeafXs = [1, 2], nestedTuple3ListLeafName = "c" ++ "d" })] in 0 = stdout="0\n" stderr="" // list releases three-field tuple with nested record managed payload fields
type NestedTuple3DictLeafRecord = { nestedTuple3DictLeafXs: Dict<Int64, Int64>, nestedTuple3DictLeafName: String } let xs = [("a" ++ "b", Stdlib.Bytes.create(4), NestedTuple3DictLeafRecord { nestedTuple3DictLeafXs = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 1, 2), nestedTuple3DictLeafName = "c" ++ "d" })] in 0 = stdout="0\n" stderr="" // list releases three-field tuple with nested record dict payload fields
type NestedTuple3ClosureLeafRecord = { nestedTuple3ClosureLeafFn: (Int64) -> Int64, nestedTuple3ClosureLeafName: String } let base = 1 in let xs = [("a" ++ "b", Stdlib.Bytes.create(4), NestedTuple3ClosureLeafRecord { nestedTuple3ClosureLeafFn = ((x: Int64) => x + base), nestedTuple3ClosureLeafName = "c" ++ "d" })] in 0 = stdout="0\n" stderr="" // list releases three-field tuple with nested record closure payload fields
let xs = [("a" ++ "b", Stdlib.Bytes.create(4), ([1, 2], "c" ++ "d"))] in 0 = stdout="0\n" stderr="" // list releases three-field tuple with nested tuple list payload fields
let xs = [("a" ++ "b", Stdlib.Bytes.create(4), (Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 1, 2), "c" ++ "d"))] in 0 = stdout="0\n" stderr="" // list releases three-field tuple with nested tuple dict payload fields
let base = 1 in let xs = [("a" ++ "b", Stdlib.Bytes.create(4), (((x: Int64) => x + base), "c" ++ "d"))] in 0 = stdout="0\n" stderr="" // list releases three-field tuple with nested tuple closure payload fields
let xs = [("a" ++ "b", Stdlib.Bytes.create(4), (1, "c" ++ "d"))] in 0 = stdout="0\n" stderr="" // list releases three-field tuple with nested tuple dynamic payload fields
let xs = [("a" ++ "b", Stdlib.Bytes.create(4), [1, 2], Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 1, 2))] in 0 = stdout="0\n" stderr="" // list releases four-field tuple string/bytes/list/dict payload fields
let base = 1 in let xs = [((x: Int64) => x + base, "a" ++ "b", [1, 2], Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 1, 2))] in 0 = stdout="0\n" stderr="" // list releases four-field tuple closure/string/list/dict payload fields
let base = 1 in let xs = [((x: Int64) => x + base, Stdlib.Bytes.create(4), [1, 2], Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 1, 2))] in 0 = stdout="0\n" stderr="" // list releases four-field tuple closure/bytes/list/dict payload fields
let xs = [("a" ++ "b", Stdlib.Bytes.create(4), (1, "c" ++ "d"), [1, 2])] in 0 = stdout="0\n" stderr="" // list releases four-field tuple with nested tuple dynamic payload fields
let xs = [("a" ++ "b", Stdlib.Bytes.create(4), ([1, 2], "c" ++ "d"), [3, 4])] in 0 = stdout="0\n" stderr="" // list releases four-field tuple with nested tuple list payload fields
let xs = [("a" ++ "b", Stdlib.Bytes.create(4), (Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 1, 2), "c" ++ "d"), [3, 4])] in 0 = stdout="0\n" stderr="" // list releases four-field tuple with nested tuple dict payload fields
