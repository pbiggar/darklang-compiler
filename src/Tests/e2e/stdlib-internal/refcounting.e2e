type ProjectBranchInnerRecord = { projectBranchInnerField: String } type ProjectBranchOuterRecord = { projectBranchOuterField: ProjectBranchInnerRecord } def projectBranchRecord(flag: Bool): ProjectBranchInnerRecord = let left = ProjectBranchOuterRecord { projectBranchOuterField = ProjectBranchInnerRecord { projectBranchInnerField = "a" ++ "b" } } in let right = ProjectBranchOuterRecord { projectBranchOuterField = ProjectBranchInnerRecord { projectBranchInnerField = "c" ++ "d" } } in if flag then left.projectBranchOuterField else right.projectBranchOuterField let r = projectBranchRecord(true) in Stdlib.String.length(r.projectBranchInnerField) = stdout="2\n" stderr="" // returned branch-selected borrowed record projection stays alive
type ProjectSumPayload = ProjectSumEmpty | ProjectSumString of String def projectSumString(): String = let b = ProjectSumString("a" ++ "b") in match b with | ProjectSumString(s) -> s | ProjectSumEmpty -> "" let s = projectSumString() in Stdlib.String.length(s) = stdout="2\n" stderr="" // returned borrowed sum payload projection stays alive
type ProjectSumBytesPayload = ProjectSumBytesEmpty | ProjectSumBytesValue of Bytes def projectSumBytes(): Bytes = let b = ProjectSumBytesValue(Stdlib.Bytes.create(4)) in match b with | ProjectSumBytesValue(bytes) -> bytes | ProjectSumBytesEmpty -> Stdlib.Bytes.create(0) let b = projectSumBytes() in Stdlib.Bytes.length(b) = stdout="4\n" stderr="" // returned borrowed sum bytes payload projection stays alive
type ProjectSumListPayload = ProjectSumListEmpty | ProjectSumListValue of List<Int64> def projectSumList(): List<Int64> = let b = ProjectSumListValue([1, 2, 3]) in match b with | ProjectSumListValue(xs) -> xs | ProjectSumListEmpty -> [] let xs = projectSumList() in Stdlib.List.length<Int64>(xs) = stdout="3\n" stderr="" // returned borrowed sum list payload projection stays alive
type ProjectSumDictPayload = ProjectSumDictEmpty | ProjectSumDictValue of Dict<Int64, Int64> def projectSumDict(): Dict<Int64, Int64> = let d = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 1, 2) in let b = ProjectSumDictValue(d) in match b with | ProjectSumDictValue(dict) -> dict | ProjectSumDictEmpty -> Stdlib.Dict.empty<Int64, Int64>() let d = projectSumDict() in Stdlib.Dict.size<Int64, Int64>(d) = stdout="1\n" stderr="" // returned borrowed sum dict payload projection stays alive
type ProjectSumClosurePayload = ProjectSumClosureEmpty | ProjectSumClosureValue of (Int64) -> Int64 def projectSumClosure(): (Int64) -> Int64 = let base = 2 in let b = ProjectSumClosureValue((x: Int64) => x + base) in match b with | ProjectSumClosureValue(f) -> f | ProjectSumClosureEmpty -> ((x: Int64) => x) let f = projectSumClosure() in f(3) = stdout="5\n" stderr="" // returned borrowed sum closure payload projection stays alive
type ProjectSumTuplePayload = ProjectSumTupleEmpty | ProjectSumTupleValue of (String, Int64) def projectSumTuple(): (String, Int64) = let b = ProjectSumTupleValue(("a" ++ "b", 3)) in match b with | ProjectSumTupleValue(tuple) -> tuple | ProjectSumTupleEmpty -> ("", 0) let t = projectSumTuple() in Stdlib.String.length(t.0) + t.1 = stdout="5\n" stderr="" // returned borrowed sum tuple payload projection stays alive
type ProjectSumRecordPayloadValue = { projectSumRecordField: String } type ProjectSumRecordPayload = ProjectSumRecordEmpty | ProjectSumRecordValue of ProjectSumRecordPayloadValue def projectSumRecord(): ProjectSumRecordPayloadValue = let b = ProjectSumRecordValue(ProjectSumRecordPayloadValue { projectSumRecordField = "a" ++ "b" }) in match b with | ProjectSumRecordValue(record) -> record | ProjectSumRecordEmpty -> ProjectSumRecordPayloadValue { projectSumRecordField = "" } let r = projectSumRecord() in Stdlib.String.length(r.projectSumRecordField) = stdout="2\n" stderr="" // returned borrowed sum record payload projection stays alive
type ProjectNestedSumPayload = ProjectNestedSumEmpty | ProjectNestedSumString of String type ProjectSumNestedPayload = ProjectSumNestedEmpty | ProjectSumNestedValue of ProjectNestedSumPayload def projectSumNested(): ProjectNestedSumPayload = let b = ProjectSumNestedValue(ProjectNestedSumString("a" ++ "b")) in match b with | ProjectSumNestedValue(inner) -> inner | ProjectSumNestedEmpty -> ProjectNestedSumEmpty let inner = projectSumNested() in match inner with | ProjectNestedSumString(s) -> Stdlib.String.length(s) | ProjectNestedSumEmpty -> 0 = stdout="2\n" stderr="" // returned borrowed nested sum payload projection stays alive
type ProjectBranchSumPayload = ProjectBranchSumEmpty | ProjectBranchSumString of String def projectBranchSumString(flag: Bool): String = let left = ProjectBranchSumString("a" ++ "b") in let right = ProjectBranchSumString("c" ++ "d") in if flag then match left with | ProjectBranchSumString(s) -> s | ProjectBranchSumEmpty -> "" else match right with | ProjectBranchSumString(s) -> s | ProjectBranchSumEmpty -> "" let s = projectBranchSumString(false) in Stdlib.String.length(s) = stdout="2\n" stderr="" // returned branch-selected sum payload projection stays alive
type RcBox = RcNone | RcString of String | RcList of List<Int64> let b = RcString("a" ++ "b") in 0 = stdout="0\n" stderr="" // sum releases dynamic string payload
type RcBox2 = RcNone2 | RcString2 of String | RcList2 of List<Int64> let b = RcList2([1, 2]) in 0 = stdout="0\n" stderr="" // sum releases list payload
type RcBoxBytes = RcBytesNone | RcBytesValue of Bytes let b = RcBytesValue(Stdlib.Bytes.create(4)) in 0 = stdout="0\n" stderr="" // sum releases bytes payload
type RcBoxDict = RcDictNone | RcDictValue of Dict<Int64, Int64> let d = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, Int64>(), 1, 2) in let b = RcDictValue(d) in 0 = stdout="0\n" stderr="" // sum releases dict payload
type RcBoxClosure = RcClosureNone | RcClosureValue of (Int64) -> Int64 let base = 2 in let b = RcClosureValue((x: Int64) => x + base) in 0 = stdout="0\n" stderr="" // sum releases closure payload
type RcBoxTuple = RcTupleNone | RcTupleValue of (String, Int64) let b = RcTupleValue(("a" ++ "b", 1)) in 0 = stdout="0\n" stderr="" // sum releases tuple payload fields
type RcBoxRecordPayload = { rcBoxRecordPayloadField: String } type RcBoxRecord = RcRecordNone | RcRecordValue of RcBoxRecordPayload let b = RcRecordValue(RcBoxRecordPayload { rcBoxRecordPayloadField = "a" ++ "b" }) in 0 = stdout="0\n" stderr="" // sum releases record payload fields
type RcMixedPayload = RcMixedEmpty | RcMixedString of String let b = RcMixedEmpty in 0 = stdout="0\n" stderr="" // mixed sum releases no-payload variant
type RcMixedPayloadValue = RcMixedValueEmpty | RcMixedValueString of String let b = RcMixedValueString("a" ++ "b") in 0 = stdout="0\n" stderr="" // mixed sum releases payload variant
type RcPureEnum = RcPureLeft | RcPureRight let b = RcPureLeft in 0 = stdout="0\n" stderr="" // pure enum sum is reclaimed without heap ownership
type RcRecordSumPayload = RcRecordSumNone | RcRecordSumString of String type RcRecordWithSum = { rcRecordSumField: RcRecordSumPayload } let r = RcRecordWithSum { rcRecordSumField = RcRecordSumString("a" ++ "b") } in 0 = stdout="0\n" stderr="" // record releases sum field payload

// Capturing closure roots are fixed-block allocations and are reclaimed.
def makeAddClosure(): (Int64) -> Int64 = (x: Int64) => x + 1 let f = makeAddClosure() in 0 = stdout="0\n" stderr="" // returned closure root reclaimed
let base = 10 in let f = (x: Int64) => x + base in f(5) = stdout="15\n" stderr=""
let s = "a" ++ "b" in let f = (x: Int64) => Stdlib.String.length(s) + x in 0 = stdout="0\n" stderr="" // closure releases dynamic string capture
def closureTupleCapture(): (Int64) -> Int64 = let p = (1, 2) in (x: Int64) => p.0 + x let f = closureTupleCapture() in f(5) = stdout="6\n" stderr="" // returned closure retains fixed-block capture
def closureTupleStringCapture(): (Int64) -> Int64 = let s = "a" ++ "b" in let p = (s, 1) in (x: Int64) => Stdlib.String.length(p.0) + x let f = closureTupleStringCapture() in f(5) = stdout="7\n" stderr="" // returned closure releases fixed-block capture fields
def closureNestedTupleCapture(): (Int64) -> Int64 = let inner = (1, 2) in let outer = (inner, 3) in (x: Int64) => let captured = outer.0 in captured.0 + x let f = closureNestedTupleCapture() in f(5) = stdout="6\n" stderr="" // returned closure releases nested fixed-block capture fields
type ClosureCaptureRecord4 = { closureCaptureName4: String, closureCaptureBytes4: Bytes, closureCaptureXs4: List<Int64>, closureCaptureLookup4: Dict<Int64, List<Int64>> } def closureRecord4Capture(): (Int64) -> Int64 = let r = ClosureCaptureRecord4 { closureCaptureName4 = "a" ++ "b", closureCaptureBytes4 = Stdlib.Bytes.create(4), closureCaptureXs4 = [1, 2], closureCaptureLookup4 = Stdlib.Dict.set(Stdlib.Dict.empty<Int64, List<Int64>>(), 1, [3, 4, 5]) } in (x: Int64) => Stdlib.String.length(r.closureCaptureName4) + Stdlib.Bytes.length(r.closureCaptureBytes4) + Stdlib.List.length<Int64>(r.closureCaptureXs4) + Stdlib.List.length<Int64>(Stdlib.Option.withDefault<List<Int64>>(Stdlib.Dict.get(r.closureCaptureLookup4, 1), [])) + x let f = closureRecord4Capture() in f(5) = stdout="16\n" stderr="" // returned closure uses and releases record string/bytes/list/dict-list capture
