// Blob Module Tests
//
// Tests for Stdlib.Bytes operations

// Create bytes and get length
Stdlib.Bytes.length(Stdlib.Bytes.create(0)) = 0
Stdlib.Bytes.length(Stdlib.Bytes.create(1)) = 1
Stdlib.Bytes.length(Stdlib.Bytes.create(10)) = 10
Stdlib.Bytes.length(Stdlib.Bytes.create(100)) = 100

// Create, set, and get
Stdlib.Bytes.get(Stdlib.Bytes.set(Stdlib.Bytes.create(1), 0, 42), 0) = 42
Stdlib.Bytes.get(Stdlib.Bytes.set(Stdlib.Bytes.create(10), 5, 123), 5) = 123
Stdlib.Bytes.get(Stdlib.Bytes.set(Stdlib.Bytes.create(10), 0, 255), 0) = 255
Stdlib.Bytes.get(Stdlib.Bytes.set(Stdlib.Bytes.create(10), 9, 99), 9) = 99

// Multiple sets
let b = Stdlib.Bytes.create(3) in let b = Stdlib.Bytes.set(b, 0, 10) in let b = Stdlib.Bytes.set(b, 1, 20) in let b = Stdlib.Bytes.set(b, 2, 30) in Stdlib.Bytes.get(b, 0) + Stdlib.Bytes.get(b, 1) + Stdlib.Bytes.get(b, 2) = 60

// fromList and toList
Stdlib.Bytes.toList(Stdlib.Bytes.fromList([1, 2, 3])) = [1, 2, 3]
Stdlib.Bytes.toList(Stdlib.Bytes.fromList([])) = []
Stdlib.Bytes.toList(Stdlib.Bytes.fromList([255])) = [255]
Stdlib.Bytes.toList(Stdlib.Bytes.fromList([0, 128, 255])) = [0, 128, 255]

// hexEncode
Stdlib.Bytes.hexEncode(Stdlib.Bytes.fromList([])) = ""
Stdlib.Bytes.hexEncode(Stdlib.Bytes.fromList([0, 15, 16, 127, 128, 255])) = "000F107F80FF"
// Adapted from upstream interpreter Stdlib.Blob.toHex tests using equivalent UTF-8 bytes
Stdlib.Bytes.hexEncode(Stdlib.Bytes.fromList([216, 167, 216, 174, 216, 170, 216, 168, 216, 167, 216, 177, 32, 216, 167, 217, 132, 217, 134, 216, 181])) = "D8A7D8AED8AAD8A8D8A7D8B120D8A7D984D986D8B5"
Stdlib.Bytes.hexEncode(Stdlib.Bytes.fromList([240, 159, 145, 177, 240, 159, 145, 177, 240, 159, 143, 187, 240, 159, 145, 177, 240, 159, 143, 188, 240, 159, 145, 177, 240, 159, 143, 189, 240, 159, 145, 177, 240, 159, 143, 190, 240, 159, 145, 177, 240, 159, 143, 191])) = "F09F91B1F09F91B1F09F8FBBF09F91B1F09F8FBCF09F91B1F09F8FBDF09F91B1F09F8FBEF09F91B1F09F8FBF"
Stdlib.Bytes.hexEncode(Stdlib.Bytes.fromList([100, 108, 107, 106, 107, 100, 51, 50, 57, 56, 50, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 102, 106, 102, 105, 100, 106, 115, 102, 117, 100, 115, 100, 104, 115, 125, 123, 124, 124, 33, 124, 33, 124, 33, 124, 33, 33, 36, 37, 94, 38, 94, 38, 239, 183, 189, 239, 183, 189, 239, 183, 189, 239, 183, 189, 239, 183, 189, 239, 183, 189, 239, 183, 189, 239, 183, 189, 239, 183, 189, 239, 183, 189, 239, 183, 189, 239, 183, 189, 239, 183, 189, 239, 183, 189, 239, 183, 189, 239, 183, 189])) = "646C6B6A6B64333239383233333333333333333333666A6669646A73667564736468737D7B7C7C217C217C217C212124255E265E26EFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BD"
Stdlib.Bytes.hexEncode(Stdlib.Bytes.fromList([111, 107])) = "6F6B"
Stdlib.Bytes.hexEncode(Stdlib.Bytes.fromList([72, 105])) = "4869"

// Length of fromList result
Stdlib.Bytes.length(Stdlib.Bytes.fromList([1, 2, 3, 4, 5])) = 5
Stdlib.Bytes.length(Stdlib.Bytes.fromList([])) = 0

// Round-trip: create, set values, toList
let b = Stdlib.Bytes.create(3) in let b = Stdlib.Bytes.set(b, 0, 10) in let b = Stdlib.Bytes.set(b, 1, 20) in let b = Stdlib.Bytes.set(b, 2, 30) in Stdlib.Bytes.toList(b) = [10, 20, 30]

// Print a Blob without exposing its payload or process-local identity.
Stdlib.Bytes.toList(Stdlib.Bytes.create(0)) = []
Stdlib.Bytes.length(Stdlib.Bytes.create(10)) = 10
Stdlib.Bytes.length(Stdlib.Bytes.create(100)) = 100
Stdlib.Bytes.toList(Stdlib.Bytes.fromList([1, 2, 3])) = [1, 2, 3]
