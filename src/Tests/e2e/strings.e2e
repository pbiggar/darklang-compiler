// String Literals E2E Tests
//
// Tests for string literal parsing, type checking, and printing

// Basic string literal printing
"hello" = "hello"
"world" = "world"
"test" = "test"

// Empty string (just newline output)
"" = ""

// String with spaces
"hello world" = "hello world"
"a b c" = "a b c"

// Single characters
"a" = "a"
"Z" = "Z"
"0" = "0"

// Escape sequences - newline
"hello\nworld" = "hello\nworld"

// Escape sequences - tab
"a\tb" = "a\tb"

// Escape sequences - quote
"say \"hi\"" = "say \"hi\""

// Escape sequences - backslash
"a\\b" = "a\\b"

// Multiple newlines
"a\nb\nc" = "a\nb\nc"

// =============================================================================
// String Concatenation Tests (++ operator)
// =============================================================================

// Basic concatenation
"hello" ++ " world" = "hello world"
"a" ++ "b" = "ab"
"foo" ++ "bar" = "foobar"

// Empty string concatenation
"" ++ "test" = "test"
"test" ++ "" = "test"
"" ++ "" = ""

// Chained concatenation (left associative)
"a" ++ "b" ++ "c" = "abc"
"hello" ++ " " ++ "world" = "hello world"

// Variables with concatenation
let x = "hello" in x ++ " world" = "hello world"
let x = "a" in let y = "b" in x ++ y = "ab"

// Chained concatenation with multiple variables (regression test for known bug)
let x = "one" in let y = "two" in x ++ " and " ++ y = "one and two"
let a = "hello" in let b = "world" in let c = "!" in a ++ " " ++ b ++ c = "hello world!"

// A nonconstant ASCII concat tree allocates only its final buffer. The unfused
// left-associated form exhausts the fixed heap by copying every prefix.
let concatFusionChunk (n: Int64) (value: String): String = if n == 0L then value else concatFusionChunk (n - 1L) (value ++ value); let chunk = concatFusionChunk 20L "x" in Stdlib.String.getByteAt (chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk ++ chunk) 34603007 = stdout="Stdlib.Option.Option<UInt8>.Some(120)\n" stderr="" isolated=true

// Concatenation in let binding
let result = "foo" ++ "bar" in result = "foobar"

// Longer strings
"this is a" ++ " longer test" = "this is a longer test"

// Single character concatenation
"a" ++ "b" ++ "c" ++ "d" = "abcd"

// =============================================================================
// Stdlib.Int64.toString Tests
// =============================================================================

// Single digit conversion

// Basic integer to string
Stdlib.Int64.toString 1L = "1"
Stdlib.Int64.toString 9L = "9"
Stdlib.Int64.toString 10L = "10"
Stdlib.Int64.toString 100L = "100"
Stdlib.Int64.toString 999L = "999"
Stdlib.Int64.toString 1234L = "1234"
Stdlib.Int64.toString 12345L = "12345"

// Negative numbers
Stdlib.Int64.toString (-1L) = "-1"
Stdlib.Int64.toString (-42L) = "-42"
Stdlib.Int64.toString (-100L) = "-100"
Stdlib.Int64.toString (-12345L) = "-12345"

// Large numbers
Stdlib.Int64.toString 1000000L = "1000000"
Stdlib.Int64.toString 2147483647L = "2147483647"

// Concatenation with toString
"Value: " ++ Stdlib.Int64.toString 42L = "Value: 42"
"Answer is " ++ Stdlib.Int64.toString 42L ++ "!" = "Answer is 42!"

// =============================================================================
// Stdlib.Bool.toString Tests
// =============================================================================

"The answer is " ++ Stdlib.Bool.toString true = "The answer is true"
"Flag: " ++ Stdlib.Bool.toString (1L > 0L) = "Flag: true"

// =============================================================================
// String Interpolation Tests
// =============================================================================

// Basic interpolation with string variable
let name = "Alice" in $"Hello {name}" = "Hello Alice"

// Just interpolation (no literal parts)
let name = "Dave" in $"{name}" = "Dave"

// Escape sequences in interpolated strings
$"Hello\nWorld" = "Hello\nWorld"
$"Tab\there" = "Tab\there"

// No interpolation (just like regular string)
$"plain string" = "plain string"

// Empty interpolated string
$"" = ""

// Interpolation with string literals
$"{"hello"}" = "hello"
$"Say: {"hi"}" = "Say: hi"

// Expression with operators (string concat inside interpolation)
$"{"a" ++ "b"}" = "ab"

// Nested braces in interpolation - record literal inside expression
// Tests depth tracking for matching braces in collectExprChars
// Catches mutations #1 (depth + 1 -> depth - 1) and #7 (depth - 1 -> depth + 1)
type NestedBraceRec = { ``val``: String } $"{NestedBraceRec { ``val`` = "ok" }.``val``}" = "ok"

// Multiple interpolations lower through chained string concatenation.
let x = "one" in let y = "two" in $"{x} and {y}" = "one and two"

// =============================================================================
// Stdlib.String.getByteAt Tests
// =============================================================================

// Get bytes from ASCII string "abc" = 97, 98, 99
Stdlib.String.getByteAt "abc" 0 = Some 97uy
Stdlib.String.getByteAt "abc" 1 = Some 98uy
Stdlib.String.getByteAt "abc" 2 = Some 99uy

// Get bytes from uppercase "ABC" = 65, 66, 67
Stdlib.String.getByteAt "ABC" 0 = Some 65uy
Stdlib.String.getByteAt "ABC" 1 = Some 66uy
Stdlib.String.getByteAt "ABC" 2 = Some 67uy

// Get byte from single character
Stdlib.String.getByteAt "x" 0 = Some 120uy

// Get space character (ASCII 32)
Stdlib.String.getByteAt " " 0 = Some 32uy

// Get digits
Stdlib.String.getByteAt "0" 0 = Some 48uy
Stdlib.String.getByteAt "9" 0 = Some 57uy
Stdlib.String.getByteAt "abc" (-1) = None
Stdlib.String.getByteAt "abc" 3 = None

// =============================================================================
// Stdlib.String.startsWith Tests
// =============================================================================

// Basic startsWith
Stdlib.String.startsWith "hello world" "hello" = true
Stdlib.String.startsWith "hello world" "world" = false
Stdlib.String.startsWith "abc" "a" = true
Stdlib.String.startsWith "abc" "ab" = true
Stdlib.String.startsWith "abc" "abc" = true
Stdlib.String.startsWith "abc" "abcd" = false

// Empty string cases
Stdlib.String.startsWith "hello" "" = true
Stdlib.String.startsWith "" "" = true
Stdlib.String.startsWith "" "a" = false

// =============================================================================
// Stdlib.String.endsWith Tests
// =============================================================================

// Basic endsWith
Stdlib.String.endsWith "hello world" "world" = true
Stdlib.String.endsWith "hello world" "hello" = false
Stdlib.String.endsWith "abc" "c" = true
Stdlib.String.endsWith "abc" "bc" = true
Stdlib.String.endsWith "abc" "abc" = true
Stdlib.String.endsWith "abc" "xabc" = false

// Empty string cases
Stdlib.String.endsWith "hello" "" = true
Stdlib.String.endsWith "" "" = true
Stdlib.String.endsWith "" "a" = false

// =============================================================================
// Stdlib.String.indexOf Tests
// =============================================================================

// Basic indexOf
Stdlib.String.indexOf "hello world" "hello" = Stdlib.Option.Option.Some 0
Stdlib.String.indexOf "hello world" "world" = Stdlib.Option.Option.Some 6
Stdlib.String.indexOf "hello world" "o" = Stdlib.Option.Option.Some 4
Stdlib.String.indexOf "hello world" "o w" = Stdlib.Option.Option.Some 4

// Not found
Stdlib.String.indexOf "hello world" "xyz" = Stdlib.Option.Option.None
Stdlib.String.indexOf "abc" "d" = Stdlib.Option.Option.None

// Empty string search
Stdlib.String.indexOf "hello" "" = Stdlib.Option.Option.Some 0
Stdlib.String.indexOf "" "" = Stdlib.Option.Option.Some 0

// =============================================================================
// Stdlib.String.contains Tests
// =============================================================================

// Basic contains
Stdlib.String.contains "hello world" "hello" = true
Stdlib.String.contains "hello world" "world" = true
Stdlib.String.contains "hello world" "o w" = true
Stdlib.String.contains "hello world" "xyz" = false

// Empty string cases
Stdlib.String.contains "hello" "" = true
Stdlib.String.contains "" "" = true
Stdlib.String.contains "" "a" = false

// =============================================================================
// Stdlib.String.slice Tests
// =============================================================================

// Basic slice (start, end exclusive)
Stdlib.String.slice "hello world" 0 5 = "hello"
Stdlib.String.slice "hello world" 6 11 = "world"
Stdlib.String.slice "hello world" 0 11 = "hello world"

// Slice from middle
Stdlib.String.slice "abcdef" 2 5 = "cde"

// Empty result
Stdlib.String.slice "hello" 0 0 = ""
Stdlib.String.slice "hello" 5 5 = ""

// Clamping behavior
Stdlib.String.slice "hello" 0 100 = "hello"
Stdlib.String.slice "hello" 10 15 = ""
Stdlib.String.slice "hello" 4 2 = ""

// =============================================================================
// Stdlib.String.first and drop Tests
// =============================================================================

// take
Stdlib.String.first "hello world" 5 = "hello"
Stdlib.String.first "hello" 0 = ""
Stdlib.String.first "hello" 100 = "hello"
Stdlib.String.first "hello" (-1) = ""

// drop
Stdlib.String.dropFirst "hello world" 6 = "world"
Stdlib.String.dropFirst "hello" 0 = "hello"
Stdlib.String.dropFirst "hello" 100 = ""
Stdlib.String.dropFirst "hello" (-1) = "hello"

// =============================================================================
// Stdlib.String.slice Tests
// =============================================================================

Stdlib.String.slice "hello world" 0 5 = "hello"
Stdlib.String.slice "hello world" 6 11 = "world"
