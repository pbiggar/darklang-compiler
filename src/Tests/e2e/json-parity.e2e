// Focused executable JSON parity matrix.
// Compared at compiler 8a33ccda12d38e41b6ffa7627363fa8f4ff7b238 and
// darklang/dark 04fbe9dcc995c6188757d583e273cbd30a3e2d3d.

type JsonParityPerson = { Name: String, Age: Int64 }
type JsonParityChoice = JsonParityNo | JsonParityYes of String * Int64
type JsonParityAlias = JsonParityPerson

let jsonParityError<'a> (result: Result<a, Stdlib.Json.ParseError.ParseError>): String =
    match result with
    | Ok _ -> "unexpected success"
    | Error error -> Stdlib.Json.ParseError.toString Darklang.SCM.Branch.mainBranchId error

Darklang.PrettyPrinter.RuntimeTypes.typeReference Darklang.SCM.Branch.mainBranchId Darklang.LanguageTools.RuntimeTypes.TypeReference.TBlob = "Blob"
Stdlib.Json.serialize<Unit> (()) = "null"
Stdlib.Json.parse<Bool> " true " = Ok true
Stdlib.Json.serialize<String> "snowman ☃ and quote \"" = "\"snowman ☃ and quote \\\"\""
Stdlib.Json.parse<Char> "\"👩‍👩‍👧‍👦\"" = Ok '👩‍👩‍👧‍👦'
Stdlib.Json.parse<Int64> "1e2" = Ok 100L
Stdlib.Json.serialize (1e20) = "1E+20"
Stdlib.Json.serialize (1e-5) = "1E-05"
jsonParityError<Int64> (Stdlib.Json.parse<Int64> "1.2") = "Can't parse JSON `1.2` as type `Int64` at path: `root`"
Stdlib.Json.serialize<List<Int64>> ([1L, 2L, 3L]) = "[1,2,3]"
Stdlib.Json.parse<(Int64 * String)> "[42,\"answer\"]" = Ok ((42L, "answer"))
Stdlib.Json.serialize<Dict<String>> (Dict { b = "two", a = "one" }) = "{\"a\":\"one\",\"b\":\"two\"}"
Stdlib.Json.parse<Dict<String>> "{\"a\":\"one\",\"b\":\"two\"}" = Ok (Dict { a = "one", b = "two" })
Stdlib.Json.serialize<List<(Dict<String> * Option<Int64>)>> ([(Stdlib.Dict.singleton "a" "b", Some 1L)]) = "[[{\"a\":\"b\"},{\"Some\":[1]}]]"
Stdlib.Json.serialize<Result<List<(Dict<String> * Option<Int64>)>, String>> (Ok ([(Stdlib.Dict.singleton "a" "b", Some 1L), (Stdlib.Dict.singleton "c" "d", None)])) = "{\"Ok\":[[[{\"a\":\"b\"},{\"Some\":[1]}],[{\"c\":\"d\"},{\"None\":[]}]]]}"
Stdlib.Json.serialize<JsonParityPerson> (JsonParityPerson { Name = "Ada", Age = 36L }) = "{\"Age\":36,\"Name\":\"Ada\"}"
Stdlib.Json.parse<JsonParityPerson> "{\"Name\":\"Ada\",\"Age\":36,\"extra\":true}" = Ok (JsonParityPerson { Name = "Ada", Age = 36L })
Stdlib.Json.parse<JsonParityAlias> "{\"Name\":\"Ada\",\"Age\":36}" = Ok (JsonParityPerson { Name = "Ada", Age = 36L })
Stdlib.Json.parse<List<JsonParityPerson>> "[{\"Name\":\"Ada\",\"Age\":36},{\"Name\":\"Grace\",\"Age\":37}]" = Ok ([JsonParityPerson { Name = "Ada", Age = 36L }, JsonParityPerson { Name = "Grace", Age = 37L }])
jsonParityError<JsonParityPerson> (Stdlib.Json.parse<JsonParityPerson> "{\"Age\":36}") = "Can't parse JSON because `Name` field is not provided at path: `root`"
jsonParityError<JsonParityPerson> (Stdlib.Json.parse<JsonParityPerson> "{\"Name\":\"Ada\",\"Age\":1,\"Age\":2}") = "Can't parse JSON because `Age` is defined more than once at path: `root`"
Stdlib.Json.serialize<JsonParityChoice> (JsonParityChoice.JsonParityYes "because" 7L) = "{\"JsonParityYes\":[\"because\",7]}"
Stdlib.Json.parse<JsonParityChoice> "{\"JsonParityNo\":[]}" = Ok JsonParityChoice.JsonParityNo
Stdlib.Json.parse<JsonParityChoice> "{\"JsonParityYes\":[\"because\",7]}" = Ok (JsonParityChoice.JsonParityYes "because" 7L)
jsonParityError<JsonParityChoice> (Stdlib.Json.parse<JsonParityChoice> "{\"JsonParityYes\":[\"because\"]}") = "Can't parse JSON because argument 1 (`Int64`) is missing at path: `root.JsonParityYes`"
jsonParityError<JsonParityChoice> (Stdlib.Json.parse<JsonParityChoice> "{\"JsonParityYes\":[\"because\",7,2.0]}") = "Can't parse JSON due to an extra argument `2.0` at path: `root.JsonParityYes[2]`"
jsonParityError<JsonParityChoice> (Stdlib.Json.parse<JsonParityChoice> "{\"Wrong\":[]}") = "Can't parse JSON as `Wrong` is not a known case of type `JsonParityChoice` at path: `root`"
jsonParityError<JsonParityChoice> (Stdlib.Json.parse<JsonParityChoice> "{\"JsonParityNo\":[],\"JsonParityYes\":[]}") = "Can't parse JSON with multiple fields (`JsonParityNo`, `JsonParityYes`) as type `JsonParityChoice` at path: `root`"
jsonParityError<List<JsonParityPerson>> (Stdlib.Json.parse<List<JsonParityPerson>> "[{\"Name\":\"Ada\",\"Age\":\"old\"}]") = "Can't parse JSON `\"old\"` as type `Int64` at path: `root[0].Age`"
Stdlib.Json.parse<Int64> "not-json" = Error Stdlib.Json.ParseError.ParseError.NotJson
Stdlib.Json.serialize<Int64 -> Int64> (fun value -> value) = error="Unsupported type in JSON"
Stdlib.Json.serialize (Stdlib.Stream.fromList []) = error="Unsupported type in JSON"
Stdlib.Json.parse<Stream<Int64>> "[]" = error="Unsupported type in JSON"
