// Interpreter-compatible primitive literal syntax and boundary values.
// The source contract is pinned in docs/primitive-literals-parity.md.

// Existing arbitrary-precision Int values retain their suffix spelling.
let identityInt(value: Int) : Int = value identityInt(9223372036854775808I) = 9223372036854775808I

// Interpreter string literals represent non-BMP Unicode scalars as UTF-16 escapes.
"\uD83D\uDE00" = "😀"
"""line\nraw""" = "line\\nraw"

// Raw interpolation preserves escape text while evaluating expressions.
let value = "ok" in $"""raw\n{value}""" = "raw\\nok"
