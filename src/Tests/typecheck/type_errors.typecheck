// Type error tests - expressions that should fail type checking

// Arithmetic with booleans
1 + true : error
false - 5 : error
true * false : error

// Boolean operators with integers
1 && 2 : error
5 || 10 : error
!42 : error

// If with mismatched branch types
if true then 10 else false : error
if false then true else 5 : error

// Comparison of incompatible types
true == 5 : error
10 < false : error
