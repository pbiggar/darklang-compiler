// Boolean type checking tests

// Boolean literals
true : bool
false : bool

// Comparisons
1L == 2L : bool
5L != 3L : bool
10L < 20L : bool
5L > 2L : bool
3L <= 3L : bool
10L >= 5L : bool

// Logical operators
true && false : bool
true || false : bool
!true : bool
!false : bool

// Complex boolean expressions
(1L == 1L) && (2L == 2L) : bool
(1L < 2L) || (3L > 4L) : bool
!(5L < 3L) : bool
!!(true && false) : bool

// Comparisons with arithmetic
2L + 3L == 5L : bool
10L - 5L != 4L : bool
(1L + 2L) < (4L + 5L) : bool
