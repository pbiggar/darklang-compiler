<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test suite tooling -->
    <Compile Include="test-suite-tooling/TestDSL/Common.fs" />
    <Compile Include="test-suite-tooling/TestDSL/ANFParser.fs" />
    <Compile Include="test-suite-tooling/TestDSL/MIRParser.fs" />
    <Compile Include="test-suite-tooling/TestDSL/LIRParser.fs" />
    <Compile Include="test-suite-tooling/TestDSL/ARM64Parser.fs" />
    <Compile Include="test-suite-tooling/TestDSL/ARM64SymbolicParser.fs" />
    <Compile Include="test-suite-tooling/TestDSL/ARM64EncodingFormat.fs" />
    <Compile Include="test-suite-tooling/TestDSL/X86_64Parser.fs" />
    <Compile Include="test-suite-tooling/TestDSL/X86_64EncodingFormat.fs" />
    <Compile Include="test-suite-tooling/TestDSL/GraphColorFormat.fs" />
    <Compile Include="test-suite-tooling/TestDSL/ParallelMoveFormat.fs" />
    <Compile Include="test-suite-tooling/TestDSL/IRFormatSnapshotFormat.fs" />
    <Compile Include="test-suite-tooling/TestDSL/LIRExecutionFormat.fs" />
    <Compile Include="test-suite-tooling/TestDSL/RCReleaseFormat.fs" />
    <Compile Include="test-suite-tooling/TestDSL/E2EFormat.fs" />
    <Compile Include="test-suite-tooling/TestDSL/TypeCheckingFormat.fs" />
    <Compile Include="test-suite-tooling/TestDSL/OptimizationFormat.fs" />
    <Compile Include="test-suite-tooling/TestDSL/FormattingRoundtripFormat.fs" />
    <Compile Include="test-suite-tooling/TestDSL/SyntaxFormat.fs" />
    <Compile Include="test-suite-tooling/Runners/PassTestRunner.fs" />
    <Compile Include="test-suite-tooling/Runners/ARM64EncodingTestRunner.fs" />
    <Compile Include="test-suite-tooling/Runners/X86_64EncodingTestRunner.fs" />
    <Compile Include="test-suite-tooling/Runners/GraphColorTestRunner.fs" />
    <Compile Include="test-suite-tooling/Runners/ParallelMoveTestRunner.fs" />
    <Compile Include="test-suite-tooling/Runners/IRFormatSnapshotTestRunner.fs" />
    <Compile Include="test-suite-tooling/Runners/LIRExecutionTestRunner.fs" />
    <Compile Include="test-suite-tooling/Runners/RCReleaseTestRunner.fs" />
    <Compile Include="test-suite-tooling/Runners/E2ETestRunner.fs" />
    <Compile Include="test-suite-tooling/Runners/TypeCheckingTestRunner.fs" />
    <Compile Include="test-suite-tooling/Runners/OptimizationTestRunner.fs" />
    <Compile Include="test-suite-tooling/Runners/SyntaxTestRunner.fs" />
    <Compile Include="test-suite-tooling/TestRunnerColors.fs" />
    <Compile Include="test-suite-tooling/ProgressBar.fs" />
    <Compile Include="test-suite-tooling/TestFramework.fs" />
    <Compile Include="test-suite-tooling/TestRunnerArgs.fs" />
    <!-- Tests for test suite tooling -->
    <Compile Include="test-suite-tooling-tests/ScriptHelperTests.fs" />
    <Compile Include="test-suite-tooling-tests/StdlibSourceTests.fs" />
    <Compile Include="test-suite-tooling-tests/TestRunnerArgsTests.fs" />
    <Compile Include="test-suite-tooling-tests/TypeCheckingTestRunnerTests.fs" />
    <Compile Include="test-suite-tooling-tests/PassTestRunnerTests.fs" />
    <Compile Include="test-suite-tooling-tests/OptimizationFormatTests.fs" />
    <Compile Include="test-suite-tooling-tests/TypeCheckingFormatTests.fs" />
    <Compile Include="test-suite-tooling-tests/ProgressBarTests.fs" />
    <Compile Include="test-suite-tooling-tests/FormattingRoundtripTests.fs" />
    <Compile Include="test-suite-tooling-tests/SyntaxDSLTests.fs" />
    <Compile Include="test-suite-tooling-tests/EncodingDSLTests.fs" />
    <Compile Include="test-suite-tooling-tests/GraphColorDSLTests.fs" />
    <Compile Include="test-suite-tooling-tests/ParallelMoveDSLTests.fs" />
    <Compile Include="test-suite-tooling-tests/IRFormatSnapshotDSLTests.fs" />
    <Compile Include="test-suite-tooling-tests/LIRExecutionDSLTests.fs" />
    <Compile Include="test-suite-tooling-tests/RCReleaseDSLTests.fs" />
    <Compile Include="test-suite-tooling-tests/E2EFormatTests.fs" />

    <!-- Compiler pass tests (shared) -->
    <Compile Include="compiler-passes/ParserTests.fs" />
    <Compile Include="compiler-passes/PlatformTests.fs" />
    <Compile Include="compiler-passes/ProgramCliTests.fs" />
    <Compile Include="compiler-passes/ValueSearchCatalogTests.fs" />
    <Compile Include="compiler-passes/ProgramStructureTests.fs" />
    <Compile Include="compiler-passes/StdlibOptimizationTests.fs" />
    <Compile Include="compiler-passes/CompilationSessionTests.fs" />
    <Compile Include="compiler-passes/JsonPlanningTests.fs" />
    <Compile Include="compiler-passes/IRSymbolTests.fs" />
    <Compile Include="compiler-passes/IRPrinterTests.fs" />
    <Compile Include="compiler-passes/LIRLayoutTests.fs" />
    <Compile Include="compiler-passes/ANFToMIRTests.fs" />
    <Compile Include="compiler-passes/TypeCheckingTests.fs" />
    <Compile Include="compiler-passes/BitsetTests.fs" />
    <Compile Include="compiler-passes/SSAConstructionTests.fs" />
    <Compile Include="compiler-passes/SSALivenessTests.fs" />
    <Compile Include="compiler-passes/PhiResolutionTests.fs" />
    <Compile Include="compiler-passes/ChordalGraphTests.fs" />
    <Compile Include="compiler-passes/ASTToANFTests.fs" />
    <Compile Include="compiler-passes/ListHIRTests.fs" />
    <Compile Include="compiler-passes/HIRVerificationTests.fs" />
    <Compile Include="compiler-passes/HIRConstructionTests.fs" />
    <Compile Include="compiler-passes/ownership/OwnedFunctionGroupTests.fs" />
    <Compile Include="compiler-passes/ownership/RegionContractTests.fs" />
    <Compile Include="compiler-passes/ownership/OwnershipUniquenessInferenceTests.fs" />
    <Compile Include="compiler-passes/ownership/RecursiveOwnershipInferenceTests.fs" />
    <Compile Include="compiler-passes/ownership/OwnedFunctionGroupInferenceTests.fs" />
    <Compile Include="compiler-passes/ownership/OwnershipVariantSelectionTests.fs" />
    <Compile Include="compiler-passes/ownership/OwnershipVariantMaterializationTests.fs" />
    <Compile Include="compiler-passes/ownership/WholeFunctionOwnershipTests.fs" />
    <Compile Include="compiler-passes/ownership/OwnedHIRVerificationTests.fs" />
    <Compile Include="compiler-passes/ownership/OwnershipCallFactsTests.fs" />
    <Compile Include="compiler-passes/ownership/OwnershipVariantSchedulingTests.fs" />
    <Compile Include="compiler-passes/RuntimeDataLayoutTests.fs" />
    <Compile Include="compiler-passes/MonomorphizationTests.fs" />
    <Compile Include="compiler-passes/ownership/MemoryShapeTests.fs" />
    <Compile Include="compiler-passes/ownership/TypeFactTests.fs" />
    <Compile Include="compiler-passes/ownership/CleanupTests.fs" />
    <Compile Include="compiler-passes/ownership/TransferTests.fs" />
    <Compile Include="compiler-passes/ownership/CallTests.fs" />
    <Compile Include="compiler-passes/ownership/JoinTests.fs" />
    <Compile Include="compiler-passes/RefCountInsertionTests.fs" />
    <Compile Include="compiler-passes/TailCallDetectionTests.fs" />
    <Compile Include="compiler-passes/LambdaLiftingTests.fs" />

    <!-- ARM64 backend tests -->
    <Compile Include="compiler-passes/ARM64EncodingTests.fs" />
    <Compile Include="compiler-passes/ARM64BinaryTests.fs" />
    <Compile Include="compiler-passes/arm64/Fixtures.fs" />
    <Compile Include="compiler-passes/arm64/ReleasePlanningTests.fs" />
    <Compile Include="compiler-passes/arm64/ControlFlowTests.fs" />
    <Compile Include="compiler-passes/arm64/AllocationTests.fs" />
    <Compile Include="compiler-passes/arm64/DestructionTests.fs" />
    <Compile Include="compiler-passes/arm64/PlanningBoundaryTests.fs" />
    <Compile Include="compiler-passes/ARM64CodeGenTests.fs" />

    <!-- x64 backend tests -->
    <Compile Include="compiler-passes/X86_64BinaryTests.fs" />
    <Compile Include="compiler-passes/X86_64ResolveTests.fs" />
    <Compile Include="compiler-passes/X86_64CodeGenTests.fs" />

    <!-- Optimization tests -->
    <Compile Include="optimizations/MIROptimizeTests.fs" />
    <Compile Include="optimizations/LIRPeepholeTests.fs" />
    <Compile Include="optimizations/DeadCodeEliminationTests.fs" />
    <Compile Include="optimizations/ANFOptimizeTests.fs" />
    <Compile Include="optimizations/ANFInliningTests.fs" />
    <Compile Include="optimizations/ANFDirectCallSpecializationTests.fs" />
    <Compile Include="optimizations/ANFHigherOrderSpecializationTests.fs" />
    <Compile Include="optimizations/ANFEscapeAnalysisTests.fs" />

    <!-- Test Runner (must be last) -->
    <Compile Include="test-suite-tooling/TestRunner.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DarkCompiler\DarkCompiler.fsproj" />
  </ItemGroup>

  <!-- Test data files -->
  <ItemGroup>
    <None Include="passes/**/*.mir2lir" />
    <None Include="passes/**/*.anf2mir" />
    <None Include="passes/**/*.lir2arm64" />
    <None Include="passes/**/*.arm64enc" />
    <None Include="passes/**/*.x64enc" />
    <None Include="algorithms/**/*.graphcolor" />
    <None Include="algorithms/**/*.parallelmoves" />
    <None Include="formatting/**/*.irformat" />
    <None Include="backend/**/*.lirexec" />
    <None Include="backend/**/*.rcrelease" />
    <None Include="e2e/**/*.e2e" />
    <None Include="verification/**/*.e2e" />
    <None Include="typecheck/**/*.typecheck" />
    <None Include="optimization/**/*.opt" />
    <None Include="optimization/**/*.liropt" />
    <None Include="optimization/**/*.arm64opt" />
    <None Include="optimization/**/*.lir2x64" />
    <None Include="formatting-roundtrip/**/*.roundtrip" />
    <None Include="syntax/**/*.syntax" />
  </ItemGroup>

</Project>
