// Recursive declaration candidates must survive parsing and formatting.

---NAME---
parenthesized-call self recursion
---SOURCE---
let factorial (n: Int64) : Int64 = if n <= 1 then 1 else n * factorial (n - 1)
factorial (5)
---ROUNDTRIP---

---NAME---
space-application self recursion
---SOURCE---
let factorial (n: Int64) : Int64 = if n <= 1L then 1L else n * factorial (n - 1L)
factorial 5L
---ROUNDTRIP---

---NAME---
named local recursive candidate retains annotations
---SOURCE---
(let factorial (n: Int64) : Int64 = if n <= 1L then 1L else n * factorial (n - 1L)
 factorial 5L)

---NAME---
direct lambda binding recursive candidate
---SOURCE---
let countdown = fun n -> if n <= 0L then 0L else countdown (n - 1L) in countdown 5L
---ROUNDTRIP---

---NAME---
ordinary value annotation is not a recursive declaration
---SOURCE---
let value : Int64 = 1L in value
---EXPECT-ERROR---
Value annotations are not supported
