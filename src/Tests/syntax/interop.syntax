// Focused syntax acceptance, formatting, rejection, and roundtrip regressions.

---NAME---
canonical Int syntax formats explicitly
---SOURCE---
let x = 5 in Stdlib.Int64.add (x) (1)
---EXPECTED---
let x = 5 in Stdlib.Int64.add x 1
---ROUNDTRIP---

---NAME---
formatting parenthesizes nested call arguments
---SOURCE---
Builtin.unwrap (Stdlib.List.head (xs))
---EXPECTED---
Builtin.unwrap (Stdlib.List.head xs)
---ROUNDTRIP---

---NAME---
explicit Int64 syntax remains explicit
---SOURCE---
let x = 5L in Stdlib.Int64.add x 1L
---EXPECTED---
let x = 5L in Stdlib.Int64.add x 1L
---ROUNDTRIP---

---NAME---
constructor application survives pretty-printing
---SOURCE---
3L |> Stdlib.Result.Result.Ok
---ROUNDTRIP---

---NAME---
formatter escapes keyword field names
---SOURCE---
type Sample = { ``true``: Bool; ``false``: Bool }
Sample { ``true`` = true; ``false`` = false }
---ROUNDTRIP---

---NAME---
formatter escapes literal interpolation braces
---SOURCE---
$"literal \{ brace \}"
---ROUNDTRIP---

---NAME---
parser rejects fat-arrow lambda syntax
---SOURCE---
let inc = (x: Int64) => x + 1 in inc 4L
---EXPECT-ERROR---
does not use '=>'

---NAME---
public Dict type accepts key and value type arguments
---SOURCE---
let genericDict (dict: Dict<String, Int64>): Dict<String, Int64> = dict
---ROUNDTRIP---

---NAME---
implicit curried lambda survives roundtrip
---SOURCE---
fun x y -> x
---ROUNDTRIP---

---NAME---
tuple applications inside lists survive roundtrip
---SOURCE---
(Stdlib.Html.link
  [ ("rel", Stdlib.Option.Option.Some "stylesheet")
    ("href", Stdlib.Option.Option.Some "./style.css") ])
|> nodeToString
---ROUNDTRIP---

---NAME---
nested tuple applications inside lists survive roundtrip
---SOURCE---
(Stdlib.Html.input
  [ ("type", Stdlib.Option.Option.Some "text")
    ("name", Stdlib.Option.Option.Some "name")
    ("id", Stdlib.Option.Option.Some "name") ])
|> nodeToString
---ROUNDTRIP---

---NAME---
uncurried lambda application survives roundtrip
---SOURCE---
let v =
    Stdlib.String.map "a string" (fun x ->
      let _ = Builtin.testIncrementSideEffectCounter_v0 false in 'c')
   (v, Builtin.testSideEffectCount_v0 ())
---ROUNDTRIP---

---NAME---
nested function after let binding parses
---SOURCE---
let limit = 10L
let sumUpTo (i: Int64) : Int64 =
  if i > limit then 0L else i + (sumUpTo (i + 1L))
sumUpTo 1L
---ROUNDTRIP---
