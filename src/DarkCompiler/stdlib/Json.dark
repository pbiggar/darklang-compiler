// Stdlib.Json.dark - typed JSON AOT intrinsic declarations and numeric helpers.

module Stdlib.Json

// A view packs a 31-bit source start, a 32-bit source end, and a one-bit
// single-field-object hint into an Int64. Generated codecs pass the source
// separately, so ordinary nested views remain allocation-free.
type InternalValueView = Int64

type InternalObjectField = ObjectField of Stdlib.Json.InternalValueView | DuplicateObjectField

type InternalEnumObject = EnumNotObject | EnumNoFields | EnumOneField of String * Stdlib.Json.InternalValueView | EnumManyFields of List<String>

let __makeView(start: Int64, endIndex: Int64) : Stdlib.Json.InternalValueView =
    (start << 32L) ||| endIndex

let __viewStart(view: Stdlib.Json.InternalValueView) : Int64 =
    (view >> 32L) & 2147483647L

let __viewEnd(view: Stdlib.Json.InternalValueView) : Int64 =
    view & 4294967295L

let __viewHasSingleField(view: Stdlib.Json.InternalValueView) : Bool = view < 0L

let __scanStringChars(source: String, index: Int64, length: Int64) : Int64 =
    if index >= length then -1L
    else
        let byte = Stdlib.String.getByteAt(source, index) in
        if byte == 34L then index + 1L
        else if byte < 32L then -1L
        else if byte != 92L then
            let decoded = Stdlib.String.__decodeUtf8At(source, index) in
            let consumed = Stdlib.Tuple2.second<Int64, Int64>(decoded) in
            Stdlib.Json.__scanStringChars(source, index + consumed, length)
        else if index + 1L >= length then -1L
        else
            let escaped = Stdlib.String.getByteAt(source, index + 1L) in
            if escaped == 34L || escaped == 92L || escaped == 47L
               || escaped == 98L || escaped == 102L || escaped == 110L
               || escaped == 114L || escaped == 116L then
                Stdlib.Json.__scanStringChars(source, index + 2L, length)
            else if escaped == 117L then
                let first = Stdlib.AltJson.__hex4(source, index + 2L, length) in
                if first < 0L then -1L
                else if first >= 55296L && first <= 56319L then
                    if index + 12L > length
                       || Stdlib.String.getByteAt(source, index + 6L) != 92L
                       || Stdlib.String.getByteAt(source, index + 7L) != 117L then -1L
                    else
                        let second = Stdlib.AltJson.__hex4(source, index + 8L, length) in
                        if second < 56320L || second > 57343L then -1L
                        else Stdlib.Json.__scanStringChars(source, index + 12L, length)
                else if first >= 56320L && first <= 57343L then -1L
                else Stdlib.Json.__scanStringChars(source, index + 6L, length)
            else -1L

let __scanString(source: String, index: Int64, length: Int64) : Int64 =
    if index >= length || Stdlib.String.getByteAt(source, index) != 34L then -1L
    else Stdlib.Json.__scanStringChars(source, index + 1L, length)

let __scanArray(source: String, index: Int64, length: Int64) : Int64 =
    let current = Stdlib.AltJson.__skipTrivia(source, index, length) in
    if current < 0L || current >= length then -1L
    else if Stdlib.String.getByteAt(source, current) == 93L then current + 1L
    else
        let scannedValue = Stdlib.Json.__scanValue(source, current, length) in
        if scannedValue < 0L then -1L
        else
            let afterValue = scannedValue & 4294967295L in
            let afterTrivia = Stdlib.AltJson.__skipTrivia(source, afterValue, length) in
            if afterTrivia < 0L || afterTrivia >= length then -1L
            else
                let separator = Stdlib.String.getByteAt(source, afterTrivia) in
                if separator == 93L then afterTrivia + 1L
                else if separator == 44L then
                    let afterComma = Stdlib.AltJson.__skipTrivia(source, afterTrivia + 1L, length) in
                    if afterComma < 0L || afterComma >= length
                       || Stdlib.String.getByteAt(source, afterComma) == 93L then
                        -1L
                    else
                        let rest = Stdlib.Json.__scanArray(source, afterComma, length) in
                        if rest < 0L then -1L else rest & 4294967295L
                else -1L

let __scanObject(source: String, index: Int64, length: Int64) : Int64 =
    let current = Stdlib.AltJson.__skipTrivia(source, index, length) in
    if current < 0L || current >= length then -1L
    else if Stdlib.String.getByteAt(source, current) == 125L then current + 1L
    else
        let afterKey = Stdlib.Json.__scanString(source, current, length) in
        if afterKey < 0L then -1L
        else
            let colon = Stdlib.AltJson.__skipTrivia(source, afterKey, length) in
            if colon < 0L || colon >= length || Stdlib.String.getByteAt(source, colon) != 58L then
                -1L
            else
                let scannedValue = Stdlib.Json.__scanValue(source, colon + 1L, length) in
                if scannedValue < 0L then -1L
                else
                    let afterValue = scannedValue & 4294967295L in
                    let afterTrivia = Stdlib.AltJson.__skipTrivia(source, afterValue, length) in
                    if afterTrivia < 0L || afterTrivia >= length then -1L
                    else
                        let separator = Stdlib.String.getByteAt(source, afterTrivia) in
                        if separator == 125L then (afterTrivia + 1L) ||| 4611686018427387904L
                        else if separator == 44L then
                            let afterComma = Stdlib.AltJson.__skipTrivia(source, afterTrivia + 1L, length) in
                            if afterComma < 0L || afterComma >= length
                               || Stdlib.String.getByteAt(source, afterComma) == 125L then
                                -1L
                            else
                                let rest = Stdlib.Json.__scanObject(source, afterComma, length) in
                                if rest < 0L then -1L else rest & 4294967295L
                        else -1L

let __scanValue(source: String, index: Int64, length: Int64) : Int64 =
    let start = Stdlib.AltJson.__skipTrivia(source, index, length) in
    if start < 0L || start >= length then -1L
    else
        let byte = Stdlib.String.getByteAt(source, start) in
        if byte == 110L && start + 4L <= length
           && Stdlib.String.__byteSlice(source, start, start + 4L) == "null" then
            start + 4L
        else if byte == 116L && start + 4L <= length
                && Stdlib.String.__byteSlice(source, start, start + 4L) == "true" then
            start + 4L
        else if byte == 102L && start + 5L <= length
                && Stdlib.String.__byteSlice(source, start, start + 5L) == "false" then
            start + 5L
        else if byte == 34L then
            Stdlib.Json.__scanString(source, start, length)
        else if byte == 91L then Stdlib.Json.__scanArray(source, start + 1L, length)
        else if byte == 123L then Stdlib.Json.__scanObject(source, start + 1L, length)
        else if byte == 45L || (byte >= 48L && byte <= 57L) then
            Stdlib.AltJson.__scanNumber(source, start, length)
        else -1L

// Typed JSON keeps shallow raw slices rather than building the recursive
// RawJson tree. The shared scanner owns syntax validation; generated decoders
// only select fields and construct values of their statically known target
// types.
let __skipTriviaBackward(source: String, endIndex: Int64) : Int64 =
    if endIndex <= 0L then 0L
    else
        let byte = Stdlib.String.getByteAt(source, endIndex - 1L) in
        if byte == 32L || byte == 9L || byte == 10L || byte == 13L then
            Stdlib.Json.__skipTriviaBackward(source, endIndex - 1L)
        else endIndex

let __parseRoot(source: String) : Stdlib.Result.Result<Stdlib.Json.InternalValueView, Stdlib.Json.ParseError.ParseError> =
    let length = Stdlib.String.__byteLength(source) in
    let start = Stdlib.AltJson.__skipTrivia(source, 0L, length) in
    if start < 0L then Stdlib.Result.Result.Error(Stdlib.Json.ParseError.ParseError.NotJson)
    else
        let scannedValue = Stdlib.Json.__scanValue(source, start, length) in
        if scannedValue < 0L then Stdlib.Result.Result.Error(Stdlib.Json.ParseError.ParseError.NotJson)
        else
            let afterValue = scannedValue & 4294967295L in
            let endIndex = Stdlib.AltJson.__skipTrivia(source, afterValue, length) in
            if endIndex == length then
                let view = (start << 32L) ||| afterValue in
                if (scannedValue & 4611686018427387904L) != 0L then
                    Stdlib.Result.Result.Ok(view ||| -9223372036854775808L)
                else Stdlib.Result.Result.Ok(view)
            else Stdlib.Result.Result.Error(Stdlib.Json.ParseError.ParseError.NotJson)

// Concrete return types at these boundaries keep list projections unambiguous
// for ownership lowering.
let __viewListHead(items: List<Stdlib.Json.InternalValueView>) : Stdlib.Json.InternalValueView =
    Stdlib.Internal.SkewList.headUnsafe<Stdlib.Json.InternalValueView>(items)

let __viewFieldListHead(items: List<(String, Stdlib.Json.InternalValueView)>) : (String, Stdlib.Json.InternalValueView) =
    Stdlib.Internal.SkewList.headUnsafe<(String, Stdlib.Json.InternalValueView)>(items)

let __viewFieldName(field: (String, Stdlib.Json.InternalValueView)) : String =
    Stdlib.Tuple2.first<String, Stdlib.Json.InternalValueView>(field)

let __viewFieldValue(field: (String, Stdlib.Json.InternalValueView)) : Stdlib.Json.InternalValueView =
    Stdlib.Tuple2.second<String, Stdlib.Json.InternalValueView>(field)

let __viewListTail(items: List<Stdlib.Json.InternalValueView>) : List<Stdlib.Json.InternalValueView> =
    Stdlib.Internal.SkewList.tail<Stdlib.Json.InternalValueView>(items)

let __viewListIsEmpty(items: List<Stdlib.Json.InternalValueView>) : Bool =
    Stdlib.List.isEmpty<Stdlib.Json.InternalValueView>(items)

let __viewText(source: String, view: Stdlib.Json.InternalValueView) : String =
    Stdlib.String.__byteSlice(source, Stdlib.Json.__viewStart(view), Stdlib.Json.__viewEnd(view))

let __copyRaw(source: String, view: Stdlib.Json.InternalValueView) : String =
    Stdlib.Json.__viewText(source, view)

let __viewByte(source: String, view: Stdlib.Json.InternalValueView) : Int64 =
    Stdlib.String.getByteAt(source, Stdlib.Json.__viewStart(view))

let __isNull(source: String, view: Stdlib.Json.InternalValueView) : Bool =
    Stdlib.Json.__viewEnd(view) - Stdlib.Json.__viewStart(view) == 4L
    && Stdlib.String.__byteSlice(source, Stdlib.Json.__viewStart(view), Stdlib.Json.__viewEnd(view)) == "null"

let __boolValue(source: String, view: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<Bool> =
    let byte = Stdlib.Json.__viewByte(source, view) in
    let text = Stdlib.Json.__viewText(source, view) in
    if byte == 116L && text == "true" then Stdlib.Option.Option.Some(true)
    else if byte == 102L && text == "false" then Stdlib.Option.Option.Some(false)
    else Stdlib.Option.Option.None

let __stringValue(source: String, view: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<String> =
    if Stdlib.String.getByteAt(source, Stdlib.Json.__viewStart(view)) != 34L then Stdlib.Option.Option.None
    else
        match Stdlib.AltJson.__parseString(source, Stdlib.Json.__viewStart(view), Stdlib.Json.__viewEnd(view)) with
        | ParsedString(decoded, afterString) ->
            if afterString == Stdlib.Json.__viewEnd(view) then Stdlib.Option.Option.Some(decoded)
            else Stdlib.Option.Option.None
        | InvalidString -> Stdlib.Option.Option.None

let __isNumber(source: String, view: Stdlib.Json.InternalValueView) : Bool =
    let byte = Stdlib.Json.__viewByte(source, view) in
    byte == 45L || (byte >= 48L && byte <= 57L)

let __collectArrayItems(source: String, index: Int64, limit: Int64) : Stdlib.Option.Option<List<Stdlib.Json.InternalValueView>> =
    let current = Stdlib.AltJson.__skipTrivia(source, index, limit) in
    if current < 0L || current >= limit then Stdlib.Option.Option.None
    else if Stdlib.String.getByteAt(source, current) == 93L then
        if current + 1L == limit then Stdlib.Option.Option.Some([])
        else Stdlib.Option.Option.None
    else
        let scannedValue = Stdlib.Json.__scanValue(source, current, limit) in
        if scannedValue < 0L then Stdlib.Option.Option.None
        else
            let afterValue = scannedValue & 4294967295L in
            let plainValue = (current << 32L) ||| afterValue in
            let value =
                if (scannedValue & 4611686018427387904L) != 0L then
                    plainValue ||| -9223372036854775808L
                else plainValue in
            let afterTrivia = Stdlib.AltJson.__skipTrivia(source, afterValue, limit) in
            if afterTrivia < 0L || afterTrivia >= limit then Stdlib.Option.Option.None
            else
                let separator = Stdlib.String.getByteAt(source, afterTrivia) in
                if separator == 93L && afterTrivia + 1L == limit then
                    Stdlib.Option.Option.Some([value])
                else if separator == 44L then
                    match Stdlib.Json.__collectArrayItems(source, afterTrivia + 1L, limit) with
                    | Some(rest) ->
                        Stdlib.Option.Option.Some(
                            Stdlib.List.push<Stdlib.Json.InternalValueView>(rest, value))
                    | None -> Stdlib.Option.Option.None
                else Stdlib.Option.Option.None

let __arrayItems(source: String, view: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<List<Stdlib.Json.InternalValueView>> =
    if Stdlib.Json.__viewByte(source, view) != 91L then Stdlib.Option.Option.None
    else Stdlib.Json.__collectArrayItems(source, Stdlib.Json.__viewStart(view) + 1L, Stdlib.Json.__viewEnd(view))

let __arrayStart(source: String, view: Stdlib.Json.InternalValueView) : Int64 =
    if Stdlib.Json.__viewByte(source, view) != 91L then -1L
    else Stdlib.Json.__viewStart(view) + 1L

// Streaming list traversal. Results other than -1 and -2 are packed item
// views; flagged single-field objects intentionally have a negative value.
let __arrayNext(source: String, arrayView: Stdlib.Json.InternalValueView, nextIndex: Int64) : Stdlib.Json.InternalValueView =
    let limit = Stdlib.Json.__viewEnd(arrayView) in
    let current = Stdlib.AltJson.__skipTrivia(source, nextIndex, limit) in
    if current < 0L || current >= limit then -2L
    else if Stdlib.String.getByteAt(source, current) == 93L then
        if current + 1L == limit then -1L else -2L
    else
        let scannedValue = Stdlib.Json.__scanValue(source, current, limit) in
        if scannedValue < 0L then -2L
        else
            let plainView = (current << 32L) ||| (scannedValue & 4294967295L) in
            if (scannedValue & 4611686018427387904L) != 0L then
                plainView ||| -9223372036854775808L
            else plainView

let __arrayAfter(source: String, arrayView: Stdlib.Json.InternalValueView, itemView: Stdlib.Json.InternalValueView) : Int64 =
    let limit = Stdlib.Json.__viewEnd(arrayView) in
    let afterTrivia = Stdlib.AltJson.__skipTrivia(source, Stdlib.Json.__viewEnd(itemView), limit) in
    if afterTrivia < 0L || afterTrivia >= limit then -2L
    else
        let separator = Stdlib.String.getByteAt(source, afterTrivia) in
        if separator == 93L then afterTrivia
        else if separator == 44L then afterTrivia + 1L
        else -2L

let __collectObjectFields(source: String, index: Int64, limit: Int64) : Stdlib.Option.Option<List<(String, Stdlib.Json.InternalValueView)>> =
    let current = Stdlib.AltJson.__skipTrivia(source, index, limit) in
    if current < 0L || current >= limit then Stdlib.Option.Option.None
    else if Stdlib.String.getByteAt(source, current) == 125L then
        if current + 1L == limit then Stdlib.Option.Option.Some([])
        else Stdlib.Option.Option.None
    else
        match Stdlib.AltJson.__parseString(source, current, limit) with
        | InvalidString -> Stdlib.Option.Option.None
        | ParsedString(key, afterKey) ->
            let colon = Stdlib.AltJson.__skipTrivia(source, afterKey, limit) in
            if colon < 0L || colon >= limit || Stdlib.String.getByteAt(source, colon) != 58L then
                Stdlib.Option.Option.None
            else
                let valueStart = Stdlib.AltJson.__skipTrivia(source, colon + 1L, limit) in
                let scannedValue = Stdlib.Json.__scanValue(source, valueStart, limit) in
                if scannedValue < 0L then Stdlib.Option.Option.None
                else
                    let afterValue = scannedValue & 4294967295L in
                    let plainValue = (valueStart << 32L) ||| afterValue in
                    let value =
                        if (scannedValue & 4611686018427387904L) != 0L then
                            plainValue ||| -9223372036854775808L
                        else plainValue in
                    let field =
                        (key, value) in
                    let afterTrivia = Stdlib.AltJson.__skipTrivia(source, afterValue, limit) in
                    if afterTrivia < 0L || afterTrivia >= limit then Stdlib.Option.Option.None
                    else
                        let separator = Stdlib.String.getByteAt(source, afterTrivia) in
                        if separator == 125L && afterTrivia + 1L == limit then
                            Stdlib.Option.Option.Some([field])
                        else if separator == 44L then
                            match Stdlib.Json.__collectObjectFields(source, afterTrivia + 1L, limit) with
                            | Some(rest) ->
                                Stdlib.Option.Option.Some(
                                    Stdlib.List.push<(String, Stdlib.Json.InternalValueView)>(rest, field))
                            | None -> Stdlib.Option.Option.None
                        else Stdlib.Option.Option.None

let __objectFields(source: String, view: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<List<(String, Stdlib.Json.InternalValueView)>> =
    if Stdlib.Json.__viewByte(source, view) != 123L then Stdlib.Option.Option.None
    else Stdlib.Json.__collectObjectFields(source, Stdlib.Json.__viewStart(view) + 1L, Stdlib.Json.__viewEnd(view))

let __collectObjectFieldMap(source: String, index: Int64, limit: Int64, acc: Dict<Stdlib.Json.InternalObjectField>) : Stdlib.Option.Option<Dict<Stdlib.Json.InternalObjectField>> =
    let current = Stdlib.AltJson.__skipTrivia(source, index, limit) in
    if current < 0L || current >= limit then Stdlib.Option.Option.None
    else if Stdlib.String.getByteAt(source, current) == 125L then
        if current + 1L == limit then Stdlib.Option.Option.Some(acc)
        else Stdlib.Option.Option.None
    else
        match Stdlib.AltJson.__parseString(source, current, limit) with
        | InvalidString -> Stdlib.Option.Option.None
        | ParsedString(key, afterKey) ->
            let colon = Stdlib.AltJson.__skipTrivia(source, afterKey, limit) in
            if colon < 0L || colon >= limit || Stdlib.String.getByteAt(source, colon) != 58L then
                Stdlib.Option.Option.None
            else
                let valueStart = Stdlib.AltJson.__skipTrivia(source, colon + 1L, limit) in
                let scannedValue = Stdlib.Json.__scanValue(source, valueStart, limit) in
                if scannedValue < 0L then Stdlib.Option.Option.None
                else
                    let afterValue = scannedValue & 4294967295L in
                    let plainValue = (valueStart << 32L) ||| afterValue in
                    let value =
                        if (scannedValue & 4611686018427387904L) != 0L then
                            plainValue ||| -9223372036854775808L
                        else plainValue in
                    let field =
                        match Stdlib.Dict.get<Stdlib.Json.InternalObjectField>(acc, key) with
                        | None -> Stdlib.Json.InternalObjectField.ObjectField(value)
                        | Some(_) -> Stdlib.Json.InternalObjectField.DuplicateObjectField in
                    let nextAcc =
                        Stdlib.Dict.setOverridingDuplicates<Stdlib.Json.InternalObjectField>(acc, key, field) in
                    let afterTrivia = Stdlib.AltJson.__skipTrivia(source, afterValue, limit) in
                    if afterTrivia < 0L || afterTrivia >= limit then Stdlib.Option.Option.None
                    else
                        let separator = Stdlib.String.getByteAt(source, afterTrivia) in
                        if separator == 125L && afterTrivia + 1L == limit then Stdlib.Option.Option.Some(nextAcc)
                        else if separator == 44L then
                            Stdlib.Json.__collectObjectFieldMap(source, afterTrivia + 1L, limit, nextAcc)
                        else Stdlib.Option.Option.None

let __objectFieldMap(source: String, view: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<Dict<Stdlib.Json.InternalObjectField>> =
    if Stdlib.Json.__viewByte(source, view) != 123L then Stdlib.Option.Option.None
    else
        Stdlib.Json.__collectObjectFieldMap(
            source,
            Stdlib.Json.__viewStart(view) + 1L,
            Stdlib.Json.__viewEnd(view),
            Dict { })

let __fieldNames(fields: List<(String, Stdlib.Json.InternalValueView)>) : List<String> =
    if Stdlib.List.isEmpty<(String, Stdlib.Json.InternalValueView)>(fields) then []
    else
        let head = Stdlib.Internal.SkewList.headUnsafe<(String, Stdlib.Json.InternalValueView)>(fields) in
        let tail = Stdlib.Internal.SkewList.tail<(String, Stdlib.Json.InternalValueView)>(fields) in
        Stdlib.List.push<String>(
            Stdlib.Json.__fieldNames(tail),
            Stdlib.Tuple2.first<String, Stdlib.Json.InternalValueView>(head))

// The root scanner has already validated syntax. Optimistic enum decoding can
// therefore borrow the bytes between the first colon and the final brace
// without rescanning the complete payload. If decoding fails, generated code
// falls back to __enumObject to recover the exact public error classification.
let __enumCandidate(source: String, view: Stdlib.Json.InternalValueView) : Stdlib.Json.InternalEnumObject =
    let start = Stdlib.Json.__viewStart(view) in
    let endIndex = Stdlib.Json.__viewEnd(view) in
    if !Stdlib.Json.__viewHasSingleField(view) then
        Stdlib.Json.__enumObject(source, view)
    else if Stdlib.Json.__viewByte(source, view) != 123L
       || endIndex <= start + 1L
       || Stdlib.String.getByteAt(source, endIndex - 1L) != 125L then
        Stdlib.Json.InternalEnumObject.EnumNotObject
    else
        let current = Stdlib.AltJson.__skipTrivia(source, start + 1L, endIndex - 1L) in
        if current < 0L || current >= endIndex - 1L then
            Stdlib.Json.InternalEnumObject.EnumNoFields
        else
            match Stdlib.AltJson.__parseString(source, current, endIndex - 1L) with
            | InvalidString -> Stdlib.Json.InternalEnumObject.EnumNotObject
            | ParsedString(key, afterKey) ->
                let colon = Stdlib.AltJson.__skipTrivia(source, afterKey, endIndex - 1L) in
                if colon < 0L || colon >= endIndex - 1L
                   || Stdlib.String.getByteAt(source, colon) != 58L then
                    Stdlib.Json.InternalEnumObject.EnumNotObject
                else
                    let valueStart = Stdlib.AltJson.__skipTrivia(source, colon + 1L, endIndex - 1L) in
                    let valueEnd = Stdlib.Json.__skipTriviaBackward(source, endIndex - 1L) in
                    if valueStart < 0L || valueStart >= valueEnd then
                        Stdlib.Json.InternalEnumObject.EnumNotObject
                    else
                        Stdlib.Json.InternalEnumObject.EnumOneField(
                            key,
                            Stdlib.Json.__makeView(valueStart, valueEnd))

let __enumObject(source: String, view: Stdlib.Json.InternalValueView) : Stdlib.Json.InternalEnumObject =
    match Stdlib.Json.__objectFields(source, view) with
    | None -> Stdlib.Json.InternalEnumObject.EnumNotObject
    | Some(fields) ->
        match fields with
        | [] -> Stdlib.Json.InternalEnumObject.EnumNoFields
        | [field] ->
            Stdlib.Json.InternalEnumObject.EnumOneField(
                Stdlib.Tuple2.first<String, Stdlib.Json.InternalValueView>(field),
                Stdlib.Tuple2.second<String, Stdlib.Json.InternalValueView>(field))
        | _ ->
            Stdlib.Json.InternalEnumObject.EnumManyFields(
                Stdlib.Json.__fieldNames(fields))

// Encoders append fragments through a shared writer. Generated codecs only
// choose typed values and framing operations; escaping, punctuation, and final
// assembly stay in this shared writer implementation.
let __writerEmpty(unitArg: Unit) : String = ""

let __writerWriteRaw(writer: String, value: String) : String =
    writer ++ value

let __writerWriteString(writer: String, value: String) : String =
    Stdlib.Json.__writerWriteRaw(writer, Stdlib.AltJson.__quote(value))

let __writerBeginArray(writer: String) : String =
    Stdlib.Json.__writerWriteRaw(writer, "[")

let __writerEndArray(writer: String) : String =
    Stdlib.Json.__writerWriteRaw(writer, "]")

let __writerBeginObject(writer: String) : String =
    Stdlib.Json.__writerWriteRaw(writer, "{")

let __writerEndObject(writer: String) : String =
    Stdlib.Json.__writerWriteRaw(writer, "}")

let __writerSeparator(writer: String) : String =
    Stdlib.Json.__writerWriteRaw(writer, ",")

let __writerFieldName(writer: String, name: String) : String =
    Stdlib.Json.__writerWriteRaw(writer, Stdlib.AltJson.__quote(name) ++ ":")

let __writerFinish(writer: String) : String = writer

let __padNumber(value: String, goalLength: Int64) : String =
    match Stdlib.String.padStart(value, "0", Stdlib.Int.fromInt64(goalLength)) with
    | Ok(padded) -> padded
    | Error(_) -> Builtin.testRuntimeError("JSON numeric padding failed")

let __floatRatio(value: Float) : (Int, Int) =
    let bits = Stdlib.Float.toBits(value) in
    let rawExponent = (bits >> 52UL) & 2047UL in
    let mantissa = bits & 4503599627370495UL in
    let significand =
        if rawExponent == 0UL then Stdlib.Int.fromUInt64(mantissa)
        else Stdlib.Int.add(Stdlib.Int.fromUInt64(mantissa), Stdlib.Int.shiftLeft(1I, 52I)) in
    let binaryExponent =
        if rawExponent == 0UL then -1074L
        else Stdlib.Float.__smallUInt64ToInt64(rawExponent) - 1023L - 52L in
    if binaryExponent >= 0L then
        (Stdlib.Int.shiftLeft(significand, Stdlib.Int.fromInt64(binaryExponent)), 1I)
    else
        (significand, Stdlib.Int.shiftLeft(1I, Stdlib.Int.fromInt64(0L - binaryExponent)))

let __formatFloatPrecision(numerator: Int, denominator: Int, precision: Int64) : String =
    let integerPart = Stdlib.Int.divide(numerator, denominator) in
    let integerText = Stdlib.Int.toString(integerPart) in
    let integerDigits = Stdlib.String.__byteLength(integerText) in
    let fractionDigits0 = precision - integerDigits in
    let fractionDigits = if fractionDigits0 < 1L then 1L else fractionDigits0 in
    let decimalScale = Stdlib.Int.power(10I, Stdlib.Int.fromInt64(fractionDigits)) in
    let rounded = Stdlib.AltJson.__roundRatio(Stdlib.Int.multiply(numerator, decimalScale), denominator) in
    let scaledText0 = Stdlib.Int.toString(rounded) in
    let scaledText = Stdlib.Json.__padNumber(scaledText0, fractionDigits + 1L) in
    let split = Stdlib.String.__byteLength(scaledText) - fractionDigits in
    let whole = Stdlib.String.__byteSlice(scaledText, 0L, split) in
    let fraction = Stdlib.Float.__stripDecimalTrailingZeros(Stdlib.String.__byteDrop(scaledText, split)) in
    whole ++ "." ++ fraction

let __shortestFloat(numerator: Int, denominator: Int, targetBits: UInt64, precision: Int64) : String =
    let candidate = Stdlib.Json.__formatFloatPrecision(numerator, denominator, precision) in
    match Stdlib.AltJson.__numberToFloat(candidate) with
    | Some(parsed) ->
        if Stdlib.Float.toBits(parsed) == targetBits || precision >= 17L then candidate
        else Stdlib.Json.__shortestFloat(numerator, denominator, targetBits, precision + 1L)
    | None ->
        if precision >= 17L then candidate
        else Stdlib.Json.__shortestFloat(numerator, denominator, targetBits, precision + 1L)

let __decimalExponentAboveOne(numerator: Int, denominator: Int, exponent: Int64) : Int64 =
    let tenfold = Stdlib.Int.multiply(denominator, 10I) in
    if Stdlib.Int.lessThan(numerator, tenfold) then exponent
    else Stdlib.Json.__decimalExponentAboveOne(numerator, tenfold, exponent + 1L)

let __decimalExponentBelowOne(numerator: Int, denominator: Int, exponent: Int64) : Int64 =
    if Stdlib.Int.greaterThanOrEqualTo(numerator, denominator) then exponent
    else Stdlib.Json.__decimalExponentBelowOne(Stdlib.Int.multiply(numerator, 10I), denominator, exponent - 1L)

let __decimalExponent(numerator: Int, denominator: Int) : Int64 =
    if Stdlib.Int.greaterThanOrEqualTo(numerator, denominator) then
        Stdlib.Json.__decimalExponentAboveOne(numerator, denominator, 0L)
    else
        Stdlib.Json.__decimalExponentBelowOne(Stdlib.Int.multiply(numerator, 10I), denominator, -1L)

let __scientificExponent(exponent: Int64) : String =
    let sign = if exponent < 0L then "-" else "+" in
    let magnitude = Stdlib.Int64.toString(Stdlib.Int64.absoluteValue(exponent)) in
    "E" ++ sign ++ Stdlib.Json.__padNumber(magnitude, 2L)

let __formatScientificPrecision(numerator: Int, denominator: Int, precision: Int64) : String =
    let exponent = Stdlib.Json.__decimalExponent(numerator, denominator) in
    let scale = precision - 1L - exponent in
    let power = Stdlib.Int.power(10I, Stdlib.Int.fromInt64(Stdlib.Int64.absoluteValue(scale))) in
    let scaleAfterPower = precision - 1L - Stdlib.Json.__decimalExponent(numerator, denominator) in
    let rounded =
        if scaleAfterPower >= 0L then Stdlib.AltJson.__roundRatio(Stdlib.Int.multiply(numerator, power), denominator)
        else Stdlib.AltJson.__roundRatio(numerator, Stdlib.Int.multiply(denominator, power)) in
    let roundedText = Stdlib.Int.toString(rounded) in
    let carried =
        Stdlib.String.__byteLength(roundedText) > 1L
        && Stdlib.String.getByteAt(roundedText, 0L) == 49L
        && Stdlib.Json.__allZero(roundedText, 1L, Stdlib.String.__byteLength(roundedText)) in
    let digits0 =
        if carried then Stdlib.String.__byteSlice(roundedText, 0L, Stdlib.String.__byteLength(roundedText) - 1L)
        else roundedText in
    let digits = Stdlib.Float.__stripDecimalTrailingZeros(digits0) in
    let mantissa =
        if Stdlib.String.__byteLength(digits) == 1L then digits
        else Stdlib.String.__byteTake(digits, 1L) ++ "." ++ Stdlib.String.__byteDrop(digits, 1L) in
    let finalExponent = Stdlib.Json.__decimalExponent(numerator, denominator) + (if carried then 1L else 0L) in
    mantissa ++ Stdlib.Json.__scientificExponent(finalExponent)

let __shortestScientificFloat(numerator: Int, denominator: Int, targetBits: UInt64, precision: Int64) : String =
    let candidate = Stdlib.Json.__formatScientificPrecision(numerator, denominator, precision) in
    match Stdlib.AltJson.__numberToFloat(candidate) with
    | Some(parsed) ->
        if Stdlib.Float.toBits(parsed) == targetBits || precision >= 17L then candidate
        else Stdlib.Json.__shortestScientificFloat(numerator, denominator, targetBits, precision + 1L)
    | None ->
        if precision >= 17L then candidate
        else Stdlib.Json.__shortestScientificFloat(numerator, denominator, targetBits, precision + 1L)

let __serializeFloat(value: Float) : String =
    let bits = Stdlib.Float.toBits(value) in
    let exponent = (bits >> 52UL) & 2047UL in
    let fraction = bits & 4503599627370495UL in
    if exponent == 2047UL then
        if fraction != 0UL then "\"NaN\""
        else if (bits >> 63UL) == 1UL then "\"-Infinity\""
        else "\"Infinity\""
    else
        let absolute = Stdlib.Float.abs(value) in
        if absolute == 0.0 then if (bits >> 63UL) == 1UL then "-0.0" else "0.0"
        else
            let ratio = Stdlib.Json.__floatRatio(absolute) in
            let rendered =
                if absolute >= 10000000000000000.0 || absolute < 0.0001 then
                    Stdlib.Json.__shortestScientificFloat(ratio.0, ratio.1, Stdlib.Float.toBits(absolute), 1L)
                else
                    Stdlib.Json.__shortestFloat(ratio.0, ratio.1, Stdlib.Float.toBits(absolute), 1L) in
            if (bits >> 63UL) == 1UL then "-" ++ rendered else rendered

let __numberHasDecimalSyntax(text: String) : Bool =
    Stdlib.AltJson.__findNumberMarker(text, 0L, 46L, 46L) >= 0L
    || Stdlib.AltJson.__findNumberMarker(text, 0L, 101L, 69L) >= 0L

let __floatIsInteger(value: Float) : Bool =
    let bits = Stdlib.Float.toBits(Stdlib.Float.abs(value)) in
    let rawExponent = (bits >> 52UL) & 2047UL in
    if rawExponent == 2047UL then false
    else if rawExponent >= 1075UL then true
    else if rawExponent < 1023UL then value == 0.0
    else
        let fractionalBits = 1075UL - rawExponent in
        let fractionalMask = (1UL << fractionalBits) - 1UL in
        (bits & fractionalMask) == 0UL

let __floatInteger(text: String) : Stdlib.Option.Option<Int> =
    match Stdlib.AltJson.__numberToFloat(text) with
    | None -> None
    | Some(value) ->
        if Stdlib.Json.__floatIsInteger(value) then Some(Stdlib.Int.fromFloat(value)) else None

let __numberToInt128(text: String) : Stdlib.Option.Option<Int128> =
    let direct =
        if Stdlib.Json.__numberHasDecimalSyntax(text) then None
        else
            match Stdlib.Int.parse(text) with
            | Ok(value) -> Stdlib.Int.toInt128(value)
            | Error(_) -> None in
    match direct with
    | Some(value) -> Some(value)
    | None ->
        match Stdlib.Json.__floatInteger(text) with
        | Some(value) -> Stdlib.Int.toInt128(value)
        | None -> None

let __numberToUInt128(text: String) : Stdlib.Option.Option<UInt128> =
    let direct =
        if Stdlib.Json.__numberHasDecimalSyntax(text) then None
        else
            match Stdlib.Int.parse(text) with
            | Ok(value) -> Stdlib.Int.toUInt128(value)
            | Error(_) -> None in
    match direct with
    | Some(value) -> Some(value)
    | None ->
        match Stdlib.Json.__floatInteger(text) with
        | Some(value) -> Stdlib.Int.toUInt128(value)
        | None -> None

let __allZero(text: String, index: Int64, endIndex: Int64) : Bool =
    if index >= endIndex then true
    else if Stdlib.String.getByteAt(text, index) != 48L then false
    else Stdlib.Json.__allZero(text, index + 1L, endIndex)

let __stripLeadingZeroes(text: String, index: Int64) : String =
    if index + 1L >= Stdlib.String.__byteLength(text) then Stdlib.String.__byteDrop(text, index)
    else if Stdlib.String.getByteAt(text, index) == 48L then Stdlib.Json.__stripLeadingZeroes(text, index + 1L)
    else Stdlib.String.__byteDrop(text, index)

let __mantissaDigits(text: String) : String =
    let dot = Stdlib.AltJson.__findNumberMarker(text, 0L, 46L, 46L) in
    if dot < 0L then text
    else Stdlib.String.__byteSlice(text, 0L, dot) ++ Stdlib.String.__byteDrop(text, dot + 1L)

let __mantissaFractionCount(text: String) : Int64 =
    let dot = Stdlib.AltJson.__findNumberMarker(text, 0L, 46L, 46L) in
    if dot < 0L then 0L else Stdlib.String.__byteLength(text) - dot - 1L

let __shiftIntegerDigits(digits: String, shift: Int64) : Stdlib.Option.Option<String> =
    if Stdlib.Json.__allZero(digits, 0L, Stdlib.String.__byteLength(digits)) then
        Stdlib.Option.Option.Some("0")
    else if shift >= 0L then
        Stdlib.Option.Option.Some(digits ++ Stdlib.String.repeat("0", Stdlib.Int.fromInt64(shift)))
    else
        let remove = 0L - shift in
        let length = Stdlib.String.__byteLength(digits) in
        if remove > length || Stdlib.Json.__allZero(digits, length - remove, length) == false then
            Stdlib.Option.Option.None
        else Stdlib.Option.Option.Some(Stdlib.String.__byteSlice(digits, 0L, length - remove))

let __applyIntegerExponent(digits: String, fractionCount: Int64, exponentText: String) : Stdlib.Option.Option<String> =
    let length = Stdlib.String.__byteLength(exponentText) in
    let first = Stdlib.String.getByteAt(exponentText, 0L) in
    if first == 45L then
        let magnitude = Stdlib.AltJson.__parseSmallExponent(exponentText, 1L, length, 0L) in
        if magnitude > 1000L then Stdlib.Option.Option.None
        else Stdlib.Json.__shiftIntegerDigits(digits, 0L - magnitude - fractionCount)
    else if first == 43L then
        let magnitude = Stdlib.AltJson.__parseSmallExponent(exponentText, 1L, length, 0L) in
        if magnitude > 1000L then Stdlib.Option.Option.None
        else Stdlib.Json.__shiftIntegerDigits(digits, magnitude - fractionCount)
    else
        let magnitude = Stdlib.AltJson.__parseSmallExponent(exponentText, 0L, length, 0L) in
        if magnitude > 1000L then Stdlib.Option.Option.None
        else Stdlib.Json.__shiftIntegerDigits(digits, magnitude - fractionCount)

let __unsignedIntegerLexeme(text: String) : Stdlib.Option.Option<String> =
    let exponentMarker = Stdlib.AltJson.__findNumberMarker(text, 0L, 101L, 69L) in
    let mantissa = if exponentMarker < 0L then text else Stdlib.String.__byteSlice(text, 0L, exponentMarker) in
    let digits = Stdlib.Json.__mantissaDigits(mantissa) in
    // Zero remains exactly zero regardless of exponent magnitude; do this
    // before the expansion bound used to protect non-zero values.
    if Stdlib.Json.__allZero(digits, 0L, Stdlib.String.__byteLength(digits)) then
        Stdlib.Option.Option.Some("0")
    else if exponentMarker < 0L then
        Stdlib.Json.__shiftIntegerDigits(
            digits,
            0L - Stdlib.Json.__mantissaFractionCount(text))
    else
        Stdlib.Json.__applyIntegerExponent(
            digits,
            Stdlib.Json.__mantissaFractionCount(mantissa),
            Stdlib.String.__byteDrop(text, exponentMarker + 1L))

let __normalizeIntegerMagnitude(value: String) : String =
    Stdlib.Json.__stripLeadingZeroes(if value == "" then "0" else value, 0L)

// Convert every integer-valued JSON number spelling to canonical decimal
// without passing through Float. Large exponents are bounded before expansion.
let __integerLexeme(text: String) : Stdlib.Option.Option<String> =
    if Stdlib.String.getByteAt(text, 0L) == 45L then
        (match Stdlib.Json.__unsignedIntegerLexeme(Stdlib.String.__byteDrop(text, 1L)) with
        | None -> Stdlib.Option.Option.None
        | Some(value) -> Stdlib.Option.Option.Some("-" ++ Stdlib.Json.__normalizeIntegerMagnitude(value)))
    else
        (match Stdlib.Json.__unsignedIntegerLexeme(text) with
        | None -> Stdlib.Option.Option.None
        | Some(value) -> Stdlib.Option.Option.Some(Stdlib.Json.__normalizeIntegerMagnitude(value)))

let __viewInt(source: String, value: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<Int> =
    if Stdlib.Json.__isNumber(source, value) then
        let text = Stdlib.Json.__viewText(source, value) in
        match Stdlib.Int.parse(text) with
        | Ok(integer) -> Stdlib.Option.Option.Some(integer)
        | Error(_) ->
            match Stdlib.Json.__integerLexeme(text) with
            | None -> Stdlib.Option.Option.None
            | Some(integerText) ->
                match Stdlib.Int.parse(integerText) with
                | Ok(integer) -> Stdlib.Option.Option.Some(integer)
                | Error(_) -> Stdlib.Option.Option.None
    else Stdlib.Option.Option.None

let __viewInt8(source: String, value: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<Int8> =
    match Stdlib.Json.__viewInt(source, value) with
    | Some(integer) -> Stdlib.Int.toInt8(integer)
    | None -> Stdlib.Option.Option.None

let __viewInt16(source: String, value: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<Int16> =
    match Stdlib.Json.__viewInt(source, value) with
    | Some(integer) -> Stdlib.Int.toInt16(integer)
    | None -> Stdlib.Option.Option.None

let __viewInt32(source: String, value: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<Int32> =
    match Stdlib.Json.__viewInt(source, value) with
    | Some(integer) -> Stdlib.Int.toInt32(integer)
    | None -> Stdlib.Option.Option.None

let __viewInt64(source: String, value: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<Int64> =
    match Stdlib.Json.__viewInt(source, value) with
    | Some(integer) -> Stdlib.Int.toInt64(integer)
    | None -> Stdlib.Option.Option.None

let __viewInt128(source: String, value: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<Int128> =
    if Stdlib.Json.__isNumber(source, value) then Stdlib.Json.__numberToInt128(Stdlib.Json.__viewText(source, value))
    else Stdlib.Option.Option.None

let __viewUInt8(source: String, value: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<UInt8> =
    match Stdlib.Json.__viewInt(source, value) with
    | Some(integer) -> Stdlib.Int.toUInt8(integer)
    | None -> Stdlib.Option.Option.None

let __viewUInt16(source: String, value: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<UInt16> =
    match Stdlib.Json.__viewInt(source, value) with
    | Some(integer) -> Stdlib.Int.toUInt16(integer)
    | None -> Stdlib.Option.Option.None

let __viewUInt32(source: String, value: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<UInt32> =
    match Stdlib.Json.__viewInt(source, value) with
    | Some(integer) -> Stdlib.Int.toUInt32(integer)
    | None -> Stdlib.Option.Option.None

let __viewUInt64(source: String, value: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<UInt64> =
    match Stdlib.Json.__viewInt(source, value) with
    | Some(integer) -> Stdlib.Int.toUInt64(integer)
    | None -> Stdlib.Option.Option.None

let __viewUInt128(source: String, value: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<UInt128> =
    if Stdlib.Json.__isNumber(source, value) then Stdlib.Json.__numberToUInt128(Stdlib.Json.__viewText(source, value))
    else Stdlib.Option.Option.None

let __viewFloat(source: String, value: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<Float> =
    if Stdlib.Json.__isNumber(source, value) then Stdlib.AltJson.__numberToFloat(Stdlib.Json.__viewText(source, value))
    else
        match Stdlib.Json.__stringValue(source, value) with
        | Some(text) ->
            if text == "NaN" then Stdlib.Option.Option.Some(Stdlib.Float.__nan())
            else if text == "Infinity" then Stdlib.Option.Option.Some(Stdlib.Float.__infinity())
            else if text == "-Infinity" then Stdlib.Option.Option.Some(Stdlib.Float.__negativeInfinity())
            else Stdlib.Option.Option.None
        | None -> Stdlib.Option.Option.None

let __viewChar(source: String, value: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<Char> =
    match Stdlib.Json.__stringValue(source, value) with
    | Some(text) ->
        if Stdlib.String.graphemeLength(text) == 1L then
            Stdlib.Option.Option.Some(Stdlib.Char.__asChar(text))
        else Stdlib.Option.Option.None
    | None -> Stdlib.Option.Option.None

let __viewUuid(source: String, value: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<Uuid> =
    match Stdlib.Json.__stringValue(source, value) with
    | Some(text) ->
        match Stdlib.Uuid.parse(text) with
        | Ok(uuid) -> Stdlib.Option.Option.Some(uuid)
        | Error(_) -> Stdlib.Option.Option.None
    | None -> Stdlib.Option.Option.None

let __viewDateTime(source: String, value: Stdlib.Json.InternalValueView) : Stdlib.Option.Option<DateTime> =
    match Stdlib.Json.__stringValue(source, value) with
    | Some(text) ->
        match Stdlib.DateTime.parse(text) with
        | Ok(dateTime) -> Stdlib.Option.Option.Some(dateTime)
        | Error(_) -> Stdlib.Option.Option.None
    | None -> Stdlib.Option.Option.None

// These declarations establish the public generic signatures. JsonPlanning
// replaces every concrete use before ANF lowering; reaching either body means
// specialization failed and is therefore a compiler defect.
let serialize<'a>(value: a) : String =
    Builtin.testRuntimeError("Json.serialize was not specialized")

let parse<'a>(json: String) : Stdlib.Result.Result<a, Stdlib.Json.ParseError.ParseError> =
    Builtin.testRuntimeError("Json.parse was not specialized")
