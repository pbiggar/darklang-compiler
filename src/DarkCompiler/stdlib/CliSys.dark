// Stdlib.Cli.Sys - portable system-information wrappers.

module Darklang.Stdlib.Cli.Sys

let __currentUserFromPasswd (lines: List<String>) (uid: String) : Stdlib.Option.Option<String> =
    match lines with
    | [] -> Stdlib.Option.Option.None
    | line :: rest ->
        let fields = Stdlib.String.split line ":" in
        match (Stdlib.List.getAt fields 0, Stdlib.List.getAt fields 2) with
        | (Some user, Some candidateUid) ->
            if candidateUid == uid then Some user
            else Stdlib.Cli.Sys.__currentUserFromPasswd rest uid
        | _ -> Stdlib.Cli.Sys.__currentUserFromPasswd rest uid

let currentUser () : Stdlib.Option.Option<String> =
    match Stdlib.Cli.Env.get "LOGNAME" with
    | Some user -> Some user
    | _ ->
        match Stdlib.Cli.Env.get "USER" with
        | Some user -> Some user
        | _ ->
            match Stdlib.File.readText "/etc/passwd" with
            | Ok contents ->
                Stdlib.Cli.Sys.__currentUserFromPasswd (Stdlib.String.splitOnNewline contents) (Stdlib.Int64.toString (Stdlib.Cli.__getuid ()))
            | Error _ -> Stdlib.Option.Option.None

let hostname () : Stdlib.Result.Result<String, Stdlib.Cli.Posix.Error> =
    match Stdlib.Cli.__hostname () with
    | Ok value -> Ok value
    | Error error -> Error (Stdlib.Cli.Posix.__error error)
let os () : Stdlib.Result.Result<String, Stdlib.Cli.Posix.Error> =
    match Stdlib.Cli.OS.getOS () with
    | Ok Linux -> Ok "Linux"
    | Ok MacOS -> Ok "Darwin"
    | _ -> Error (Stdlib.Cli.Posix.Error { errno = 0, message = "Unsupported operating system" })
let arch () : Stdlib.Result.Result<String, Stdlib.Cli.Posix.Error> =
    match Stdlib.Cli.Architecture.getArchitecture () with
    | Ok X86_64 -> Ok "x86_64"
    | Ok Aarch64 -> Ok "aarch64"
    | Ok Arm -> Ok "arm"
    | Ok Arm64 -> Ok "arm64"
    | Ok Armv7l -> Ok "armv7l"
    | Error error -> Error (Stdlib.Cli.Posix.Error { errno = 0, message = error })
let cpuCount () : Int = Stdlib.Int.fromInt64 (Stdlib.Cli.__cpuCount ())
let currentPid () : Int = Stdlib.Int.fromInt64 (Stdlib.Cli.__getpid ())
let isRoot () : Bool = Stdlib.Cli.__getuid () == 0L
