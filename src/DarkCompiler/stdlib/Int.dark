// Stdlib.Int.dark - public arbitrary-precision integer API.
//
// The algorithms and canonical decimal representation live in the internal,
// target-neutral __Integer module so fixed 128-bit integers share the exact
// same parsing, arithmetic, bitwise, formatting, and conversion semantics.

module Stdlib.Int

type ParseError = BadFormat

// Representation-view helpers retained as compiler extensions.
let __text(value: Int) : String = Stdlib.Internal.Integer.__text(value)
let __value(value: String) : Int = Stdlib.Internal.Integer.__value(value)
let __normalizeMagnitude(value: String) : String = Stdlib.Internal.Integer.__normalizeMagnitude(value)
let __toInt64Unchecked(value: Int) : Int64 = Stdlib.Internal.Integer.__toInt64Unchecked(value)

let add(a: Int, b: Int) : Int = Stdlib.Internal.Integer.add(a, b)
let subtract(a: Int, b: Int) : Int = Stdlib.Internal.Integer.subtract(a, b)
let multiply(a: Int, b: Int) : Int = Stdlib.Internal.Integer.multiply(a, b)
let divide(a: Int, b: Int) : Int = Stdlib.Internal.Integer.divide(a, b)
let sub(a: Int, b: Int) : Int = Stdlib.Int.subtract(a, b)
let mul(a: Int, b: Int) : Int = Stdlib.Int.multiply(a, b)
let div(a: Int, b: Int) : Int = Stdlib.Int.divide(a, b)
let negate(value: Int) : Int = Stdlib.Internal.Integer.negate(value)
let absoluteValue(value: Int) : Int =
    if Stdlib.Internal.Integer.lessThan(value, __string_to_int("0")) then
        Stdlib.Internal.Integer.negate(value)
    else value

let remainder(value: Int, divisor: Int) : Stdlib.Result.Result<Int, String> =
    Stdlib.Internal.Integer.remainder(value, divisor)

let mod(value: Int, modulus: Int) : Int = Stdlib.Internal.Integer.mod_v0(value, modulus)
let power(base: Int, exponent: Int) : Int = Stdlib.Internal.Integer.power(base, exponent)
let compare(a: Int, b: Int) : Int64 = Stdlib.Internal.Integer.compare(a, b)
let equals(a: Int, b: Int) : Bool = Stdlib.Internal.Integer.equals(a, b)
let lessThan(a: Int, b: Int) : Bool = Stdlib.Internal.Integer.lessThan(a, b)
let lessThanOrEqualTo(a: Int, b: Int) : Bool = Stdlib.Internal.Integer.lessThanOrEqualTo(a, b)
let greaterThan(a: Int, b: Int) : Bool = Stdlib.Internal.Integer.greaterThan(a, b)
let greaterThanOrEqualTo(a: Int, b: Int) : Bool = Stdlib.Internal.Integer.greaterThanOrEqualTo(a, b)

let sqrt(value: Int) : Float = Stdlib.Internal.Integer.sqrt(value)
let toFloat(value: Int) : Float = Stdlib.Internal.Integer.toFloat(value)
let fromFloat(value: Float) : Int = Stdlib.Internal.Integer.fromFloat(value)
let sum(values: List<Int>) : Int =
    Stdlib.List.fold<Int, Int>(values, __string_to_int("0"), fun acc value -> Stdlib.Internal.Integer.add(acc, value))
let max(a: Int, b: Int) : Int = if Stdlib.Internal.Integer.greaterThan(a, b) then a else b
let min(a: Int, b: Int) : Int = if Stdlib.Internal.Integer.lessThan(a, b) then a else b
let clamp(value: Int, limitA: Int, limitB: Int) : Int =
    let lower = Stdlib.Int.min(limitA, limitB) in
    let upper = Stdlib.Int.max(limitA, limitB) in
    Stdlib.Int.max(lower, Stdlib.Int.min(upper, value))
let random(start: Int, finish: Int) : Int = Stdlib.Internal.Integer.random(start, finish)

let toString(value: Int) : String = Stdlib.Internal.Integer.toString(value)
let parse(value: String) : Stdlib.Result.Result<Int, Stdlib.Int.ParseError> =
    match Stdlib.Internal.Integer.parse(value) with
    | Ok(parsed) -> Ok(parsed)
    | Error(_) -> Error(Stdlib.Int.ParseError.BadFormat)

let fromInt8(value: Int8) : Int = Stdlib.Internal.Integer.fromInt8(value)
let fromUInt8(value: UInt8) : Int = Stdlib.Internal.Integer.fromUInt8(value)
let fromInt16(value: Int16) : Int = Stdlib.Internal.Integer.fromInt16(value)
let fromUInt16(value: UInt16) : Int = Stdlib.Internal.Integer.fromUInt16(value)
let fromInt32(value: Int32) : Int = Stdlib.Internal.Integer.fromInt32(value)
let fromUInt32(value: UInt32) : Int = Stdlib.Internal.Integer.fromUInt32(value)
let fromInt64(value: Int64) : Int = Stdlib.Internal.Integer.fromInt64(value)
let fromUInt64(value: UInt64) : Int = Stdlib.Internal.Integer.fromUInt64(value)
let fromInt128(value: Int128) : Int = Stdlib.Internal.Integer.fromInt128(value)
let fromUInt128(value: UInt128) : Int = Stdlib.Internal.Integer.fromUInt128(value)

let toInt8(value: Int) : Stdlib.Option.Option<Int8> = Stdlib.Internal.Integer.toInt8(value)
let toUInt8(value: Int) : Stdlib.Option.Option<UInt8> = Stdlib.Internal.Integer.toUInt8(value)
let toInt16(value: Int) : Stdlib.Option.Option<Int16> = Stdlib.Internal.Integer.toInt16(value)
let toUInt16(value: Int) : Stdlib.Option.Option<UInt16> = Stdlib.Internal.Integer.toUInt16(value)
let toInt32(value: Int) : Stdlib.Option.Option<Int32> = Stdlib.Internal.Integer.toInt32(value)
let toUInt32(value: Int) : Stdlib.Option.Option<UInt32> = Stdlib.Internal.Integer.toUInt32(value)
let toInt64(value: Int) : Stdlib.Option.Option<Int64> = Stdlib.Internal.Integer.toInt64(value)
let toUInt64(value: Int) : Stdlib.Option.Option<UInt64> = Stdlib.Internal.Integer.toUInt64(value)
let toInt128(value: Int) : Stdlib.Option.Option<Int128> = Stdlib.Internal.Integer.toInt128(value)
let toUInt128(value: Int) : Stdlib.Option.Option<UInt128> = Stdlib.Internal.Integer.toUInt128(value)

let bitwiseAnd(a: Int, b: Int) : Int = Stdlib.Internal.Integer.bitwiseAnd(a, b)
let bitwiseOr(a: Int, b: Int) : Int = Stdlib.Internal.Integer.bitwiseOr(a, b)
let bitwiseXor(a: Int, b: Int) : Int = Stdlib.Internal.Integer.bitwiseXor(a, b)
let bitwiseNot(value: Int) : Int = Stdlib.Internal.Integer.bitwiseNot(value)
let shiftLeft(value: Int, count: Int) : Int = Stdlib.Internal.Integer.shiftLeft(value, count)
let shiftRight(value: Int, count: Int) : Int = Stdlib.Internal.Integer.shiftRight(value, count)
