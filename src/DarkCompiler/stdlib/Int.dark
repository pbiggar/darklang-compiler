// Stdlib.Int.dark - public arbitrary-precision integer API.
//
// Target-neutral `Stdlib.Int.__*` helpers hold the canonical decimal
// representation so fixed 128-bit integers share the same semantics.

module Darklang.Stdlib.Int

type ParseError = | BadFormat

let add (a: Int) (b: Int) : Int = Stdlib.Int.__add a b
let subtract (a: Int) (b: Int) : Int = Stdlib.Int.__subtract a b
let multiply (a: Int) (b: Int) : Int = Stdlib.Int.__multiply a b
let divide (a: Int) (b: Int) : Int = Stdlib.Int.__divide a b
let negate (value: Int) : Int = Stdlib.Int.__negate value
let absoluteValue (value: Int) : Int =
    if Stdlib.Int.__lessThan value (__string_to_int "0") then
        Stdlib.Int.__negate value
    else value

let remainder (value: Int) (divisor: Int) : Stdlib.Result.Result<Int, String> =
    Stdlib.Int.__remainder value divisor

let mod (value: Int) (modulus: Int) : Int = Stdlib.Int.__mod value modulus
let power (base: Int) (exponent: Int) : Int = Stdlib.Int.__power base exponent
let lessThan (a: Int) (b: Int) : Bool = Stdlib.Int.__lessThan a b
let lessThanOrEqualTo (a: Int) (b: Int) : Bool = Stdlib.Int.__lessThanOrEqualTo a b
let greaterThan (a: Int) (b: Int) : Bool = Stdlib.Int.__greaterThan a b
let greaterThanOrEqualTo (a: Int) (b: Int) : Bool = Stdlib.Int.__greaterThanOrEqualTo a b

let sqrt (value: Int) : Float = Stdlib.Int.__sqrt value
let toFloat (value: Int) : Float = Stdlib.Int.__toFloat value
let fromFloat (value: Float) : Int = Stdlib.Int.__fromFloat value
let sum (values: List<Int>) : Int =
    Stdlib.List.fold values (__string_to_int "0") (fun acc value -> Stdlib.Int.__add acc value)
let max (a: Int) (b: Int) : Int = if Stdlib.Int.__greaterThan a b then a else b
let min (a: Int) (b: Int) : Int = if Stdlib.Int.__lessThan a b then a else b
let clamp (value: Int) (limitA: Int) (limitB: Int) : Int =
    let lower = Stdlib.Int.min limitA limitB in
    let upper = Stdlib.Int.max limitA limitB in
    Stdlib.Int.max lower (Stdlib.Int.min upper value)
let random (start: Int) (finish: Int) : Int = Stdlib.Int.__random start finish

let toString (value: Int) : String = Stdlib.Int.__toString value
let parse (value: String) : Stdlib.Result.Result<Int, Stdlib.Int.ParseError> =
    match Stdlib.Int.__parse value with
    | Ok parsed -> Ok parsed
    | Error _ -> Error Stdlib.Int.ParseError.BadFormat

let fromInt8 (value: Int8) : Int = Stdlib.Int.__fromInt8 value
let fromUInt8 (value: UInt8) : Int = Stdlib.Int.__fromUInt8 value
let fromInt16 (value: Int16) : Int = Stdlib.Int.__fromInt16 value
let fromUInt16 (value: UInt16) : Int = Stdlib.Int.__fromUInt16 value
let fromInt32 (value: Int32) : Int = Stdlib.Int.__fromInt32 value
let fromUInt32 (value: UInt32) : Int = Stdlib.Int.__fromUInt32 value
let fromInt64 (value: Int64) : Int = Stdlib.Int.__fromInt64 value
let fromUInt64 (value: UInt64) : Int = Stdlib.Int.__fromUInt64 value
let fromInt128 (value: Int128) : Int = Stdlib.Int.__fromInt128 value
let fromUInt128 (value: UInt128) : Int = Stdlib.Int.__fromUInt128 value

let toInt8 (value: Int) : Stdlib.Option.Option<Int8> = Stdlib.Int.__toInt8 value
let toUInt8 (value: Int) : Stdlib.Option.Option<UInt8> = Stdlib.Int.__toUInt8 value
let toInt16 (value: Int) : Stdlib.Option.Option<Int16> = Stdlib.Int.__toInt16 value
let toUInt16 (value: Int) : Stdlib.Option.Option<UInt16> = Stdlib.Int.__toUInt16 value
let toInt32 (value: Int) : Stdlib.Option.Option<Int32> = Stdlib.Int.__toInt32 value
let toUInt32 (value: Int) : Stdlib.Option.Option<UInt32> = Stdlib.Int.__toUInt32 value
let toInt64 (value: Int) : Stdlib.Option.Option<Int64> = Stdlib.Int.__toInt64 value
let toUInt64 (value: Int) : Stdlib.Option.Option<UInt64> = Stdlib.Int.__toUInt64 value
let toInt128 (value: Int) : Stdlib.Option.Option<Int128> = Stdlib.Int.__toInt128 value
let toUInt128 (value: Int) : Stdlib.Option.Option<UInt128> = Stdlib.Int.__toUInt128 value

let bitwiseAnd (a: Int) (b: Int) : Int = Stdlib.Int.__bitwiseAnd a b
let bitwiseOr (a: Int) (b: Int) : Int = Stdlib.Int.__bitwiseOr a b
let bitwiseXor (a: Int) (b: Int) : Int = Stdlib.Int.__bitwiseXor a b
let bitwiseNot (value: Int) : Int = Stdlib.Int.__bitwiseNot value
let shiftLeft (value: Int) (count: Int) : Int = Stdlib.Int.__shiftLeft value count
let shiftRight (value: Int) (count: Int) : Int = Stdlib.Int.__shiftRight value count
