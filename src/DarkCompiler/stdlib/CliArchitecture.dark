// Stdlib.Cli.Architecture - portable public architecture model.

module Darklang.Stdlib.Cli.Architecture

type Architecture = X86_64 | Aarch64 | Arm | Arm64 | Armv7l

let __fromName (arch: String) : Stdlib.Result.Result<Stdlib.Cli.Architecture.Architecture, String> =
    if arch == "x86_64" then Ok Stdlib.Cli.Architecture.Architecture.X86_64
    else if arch == "aarch64" then Ok Stdlib.Cli.Architecture.Architecture.Aarch64
    else if arch == "arm" then Ok Stdlib.Cli.Architecture.Architecture.Arm
    else if arch == "arm64" then Ok Stdlib.Cli.Architecture.Architecture.Arm64
    else if arch == "armv7l" then Ok Stdlib.Cli.Architecture.Architecture.Armv7l
    else Error "Unsupported architecture"

let getArchitecture () : Stdlib.Result.Result<Stdlib.Cli.Architecture.Architecture, String> =
    if Stdlib.Cli.__hostArchitectureCode () == 1L then Ok Stdlib.Cli.Architecture.Architecture.X86_64
    else if Stdlib.Cli.__hostArchitectureCode () == 2L then Ok Stdlib.Cli.Architecture.Architecture.Aarch64
    else if Stdlib.Cli.__hostArchitectureCode () == 3L then Ok Stdlib.Cli.Architecture.Architecture.Arm64
    else Error "Unsupported architecture"
