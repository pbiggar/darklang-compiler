// Stdlib.List.dark - Stdlib.List definitions
//
// Split from stdlib.dark for modular stdlib loading.

module Stdlib.List

// Stdlib.List - List operations
// Lists are direct-payload skew-binary random-access lists internally.

type ChunkBySizeError = | SizeMustBeGreaterThanZero

// Check if list is empty - O(1)
let isEmpty<'t>(list: List<t>) : Bool =
    Stdlib.Internal.SkewList.isEmpty<t>(list)

// Get the public arbitrary-precision length of a list - O(1)
let length<'t>(list: List<t>) : Int =
    Stdlib.Int.fromInt64(Stdlib.Internal.SkewList.length<t>(list))

// Compare two lists for structural equality - O(n)
let equals<'a>(left: List<a>, right: List<a>) : Bool =
    if Stdlib.Internal.SkewList.isEmpty<a>(left) then
        Stdlib.Internal.SkewList.isEmpty<a>(right)
    else if Stdlib.Internal.SkewList.isEmpty<a>(right) then
        false
    else
        match Stdlib.Internal.SkewList.head<a>(left) with
        | None -> false
        | Some(leftHead) ->
            match Stdlib.Internal.SkewList.head<a>(right) with
            | None -> false
            | Some(rightHead) ->
                if leftHead == rightHead then
                    let leftTail = Stdlib.Internal.SkewList.tail<a>(left) in
                    let rightTail = Stdlib.Internal.SkewList.tail<a>(right) in
                    Stdlib.List.equals<a>(leftTail, rightTail)
                else false

// Create a single-element list - O(1)
let singleton<'t>(value: t) : List<t> =
    Stdlib.Internal.SkewList.singleton<t>(value)

// Prepend an element to a list - O(1) worst case
let push<'t>(list: List<t>, value: t) : List<t> =
    Stdlib.Internal.SkewList.push<t>(list, value)

// Internal: force concrete monomorphization of push for compiler-generated list literals
let __pushInt64(list: List<Int64>, value: Int64) : List<Int64> =
    Stdlib.Internal.SkewList.push<Int64>(list, value)

// Apply a function to each element of a list - O(n)
let map<'a, 'b>(list: List<a>, fn: (a) -> b) : List<b> =
    Stdlib.Internal.SkewList.map<a, b>(list, fn)

let __mapHelper<'a, 'b>(list: List<a>, fn: (a) -> b, acc: List<b>) : List<b> =
    if Stdlib.Internal.SkewList.isEmpty<a>(list) then acc
    else
        match Stdlib.Internal.SkewList.head<a>(list) with
        | None -> acc
        | Some(h) ->
            let newAcc = Stdlib.Internal.SkewList.pushBack<b>(acc, fn(h)) in
            Stdlib.List.__mapHelper<a, b>(Stdlib.Internal.SkewList.tail<a>(list), fn, newAcc)

// Flatten a list of lists into a single list - O(n*m)
let flatten<'a>(lists: List<List<a>>) : List<a> =
    Stdlib.List.__flattenHelper<a>(lists, Stdlib.Internal.SkewList.empty<a>())

let __flattenHelper<'a>(lists: List<List<a>>, acc: List<a>) : List<a> =
    if Stdlib.Internal.SkewList.isEmpty<List<a>>(lists) then Stdlib.Internal.SkewList.reverse<a>(acc)
    else
        match Stdlib.Internal.SkewList.head<List<a>>(lists) with
        | None -> Stdlib.Internal.SkewList.reverse<a>(acc)
        | Some(h) ->
            let newAcc = Stdlib.List.__flattenOneToReverse<a>(h, acc) in
            Stdlib.List.__flattenHelper<a>(Stdlib.Internal.SkewList.tail<List<a>>(lists), newAcc)

let __flattenOneToReverse<'a>(list: List<a>, acc: List<a>) : List<a> =
    if Stdlib.Internal.SkewList.isEmpty<a>(list) then acc
    else
        let next = Stdlib.Internal.SkewList.push<a>(acc, Stdlib.Internal.SkewList.headUnsafe<a>(list)) in
        Stdlib.List.__flattenOneToReverse<a>(Stdlib.Internal.SkewList.tail<a>(list), next)

// Apply a function that returns a list and flatten the results
let flatMap<'a, 'b>(list: List<a>, fn: (a) -> List<b>) : List<b> =
    Stdlib.List.flatten<b>(Stdlib.List.map<a, List<b>>(list, fn))

// Keep only elements that satisfy a predicate - O(n)
let filter<'a>(list: List<a>, fn: (a) -> Bool) : List<a> =
    Stdlib.Internal.SkewList.reverse<a>(Stdlib.List.__filterToReverse<a>(list, fn, Stdlib.Internal.SkewList.empty<a>()))

let __filterToReverse<'a>(list: List<a>, fn: (a) -> Bool, acc: List<a>) : List<a> =
    if Stdlib.Internal.SkewList.isEmpty<a>(list) then acc
    else
        let h = Stdlib.Internal.SkewList.headUnsafe<a>(list) in
        let next = if fn(h) then Stdlib.Internal.SkewList.push<a>(acc, h) else acc in
        Stdlib.List.__filterToReverse<a>(Stdlib.Internal.SkewList.tail<a>(list), fn, next)

let __filterHelper<'a>(list: List<a>, fn: (a) -> Bool, acc: List<a>) : List<a> =
    let len = Stdlib.Internal.SkewList.length<a>(list) in
    let filtered = Stdlib.List.__filterByIndexHelper<a>(list, fn, 0, len, Stdlib.Internal.SkewList.empty<a>()) in
    Stdlib.List.append<a>(acc, filtered)

let __filterByIndexHelper<'a>(list: List<a>, fn: (a) -> Bool, index: Int64, len: Int64, accRev: List<a>) : List<a> =
    if index >= len then
        Stdlib.List.reverse<a>(accRev)
    else
        match Stdlib.Internal.SkewList.getAt<a>(list, index) with
        | None -> Stdlib.List.reverse<a>(accRev)
        | Some(v) ->
            let nextAccRev = if fn(v) then [v, ...accRev] else accRev in
            Stdlib.List.__filterByIndexHelper<a>(list, fn, index + 1, len, nextAccRev)

// Append an element to the end of a list - O(n)
let pushBack<'a>(list: List<a>, value: a) : List<a> =
    Stdlib.Internal.SkewList.pushBack<a>(list, value)

// Concatenate two lists - O(length(list1))
let append<'a>(list1: List<a>, list2: List<a>) : List<a> =
    Stdlib.Internal.SkewList.concat<a>(list1, list2)

// Reverse a list - O(n)
let reverse<'a>(list: List<a>) : List<a> =
    Stdlib.Internal.SkewList.reverse<a>(list)

let __reverseHelper<'a>(list: List<a>, acc: List<a>) : List<a> =
    Stdlib.Internal.SkewList.__reverseInto<a>(list, acc)

let __reverseByIndexHelper<'a>(list: List<a>, index: Int64, acc: List<a>) : List<a> =
    if index < 0 then acc
    else
        match Stdlib.Internal.SkewList.getAt<a>(list, index) with
        | None -> acc
        | Some(v) ->
            Stdlib.List.__reverseByIndexHelper<a>(list, index - 1, Stdlib.Internal.SkewList.pushBack<a>(acc, v))

let sortByComparator<'a>(list: List<a>, comparator: (a, a) -> Int) : Stdlib.Result.Result<List<a>, String> =
    Stdlib.List.SortByComparatorHelpers.mergeSort<a>(comparator, list)

// Canonical interpreter ordering is synthesized per concrete AOT type.
let sort<'a>(list: List<a>) : List<a> =
    Stdlib.List.__canonicalSortHelper<a>(list, [])

let __canonicalInsert<'a>(value: a, sorted: List<a>) : List<a> =
    match sorted with
    | [] -> [value]
    | [head, ...tail] ->
        if __compare<a>(value, head) == -1L then [value, ...sorted]
        else [head, ...Stdlib.List.__canonicalInsert<a>(value, tail)]

let __canonicalSortHelper<'a>(remaining: List<a>, sorted: List<a>) : List<a> =
    match remaining with
    | [] -> sorted
    | [head, ...tail] -> Stdlib.List.__canonicalSortHelper<a>(tail, Stdlib.List.__canonicalInsert<a>(head, sorted))

let __sortByValues<'key, 'value>(pairs: List<(key, value)>) : List<value> =
    match pairs with
    | [] -> []
    | [(key, value), ...tail] -> [value, ...Stdlib.List.__sortByValues<key, value>(tail)]

let __sortByPairs<'a, 'b>(list: List<a>, fn: (a) -> b) : List<(b, a)> =
    match list with
    | [] -> []
    | [head, ...tail] -> [(fn(head), head), ...Stdlib.List.__sortByPairs<a, b>(tail, fn)]

let sortBy<'a, 'b>(list: List<a>, fn: (a) -> b) : List<a> =
    Stdlib.List.__sortByValues<b, a>(
        Stdlib.List.sort<(b, a)>(Stdlib.List.__sortByPairs<a, b>(list, fn)))

let unique<'a>(list: List<a>) : List<a> =
    Stdlib.List.sort<a>(Stdlib.List.__uniqueUnsorted<a>(list, []))

let __uniqueUnsorted<'a>(remaining: List<a>, uniqueValues: List<a>) : List<a> =
    match remaining with
    | [] -> uniqueValues
    | [head, ...tail] ->
        let next = if Stdlib.List.member<a>(uniqueValues, head) then uniqueValues else [head, ...uniqueValues] in
        Stdlib.List.__uniqueUnsorted<a>(tail, next)

let uniqueBy<'a, 'b>(list: List<a>, fn: (a) -> b) : List<a> =
    Stdlib.List.sort<a>(Stdlib.List.__uniqueByHelper<a, b>(list, fn, [], []))

let __uniqueByHelper<'a, 'b>(remaining: List<a>, fn: (a) -> b, uniqueValues: List<a>, seen: List<b>) : List<a> =
    match remaining with
    | [] -> uniqueValues
    | [value, ...tail] ->
        let key = fn(value) in
        if Stdlib.List.member<b>(seen, key) then Stdlib.List.__uniqueByHelper<a, b>(tail, fn, uniqueValues, seen)
        else Stdlib.List.__uniqueByHelper<a, b>(tail, fn, [value, ...uniqueValues], [key, ...seen])

// Fold left (reduce) over a list - O(n)
let fold<'a, 'b>(list: List<a>, init: b, fn: (b, a) -> b) : b =
    if Stdlib.Internal.SkewList.isEmpty<a>(list) then init
    else
        match Stdlib.Internal.SkewList.head<a>(list) with
        | None -> init
        | Some(h) ->
            let newInit = fn(init, h) in
            Stdlib.List.fold<a, b>(Stdlib.Internal.SkewList.tail<a>(list), newInit, fn)

// Get head of list or return None - O(1)
let head<'a>(list: List<a>) : Stdlib.Option.Option<a> =
    Stdlib.Internal.SkewList.head<a>(list)

// Internal: get head without option wrapper (caller must ensure non-empty)
// This forces monomorphization of headUnsafe_i64 for pattern matching
let __headUnsafeInt64(list: List<Int64>) : Int64 =
    Stdlib.Internal.SkewList.headUnsafe<Int64>(list)

// Internal: get head without option wrapper for Float lists
let __headUnsafeFloat(list: List<Float>) : Float =
    Stdlib.Internal.SkewList.headUnsafe<Float>(list)

// Internal: get element at index (forces monomorphization for pattern matching)
let __getAtInt64(list: List<Int64>, idx: Int64) : Stdlib.Option.Option<Int64> =
    Stdlib.Internal.SkewList.getAt<Int64>(list, idx)

let __getAtFloat(list: List<Float>, idx: Int64) : Stdlib.Option.Option<Float> =
    Stdlib.Internal.SkewList.getAt<Float>(list, idx)

// Get tail of list or return None - O(1) worst case
let tail<'a>(list: List<a>) : Stdlib.Option.Option<List<a>> =
    if Stdlib.Internal.SkewList.isEmpty<a>(list) then None
    else Some(Stdlib.Internal.SkewList.tail<a>(list))

// Get element at an arbitrary-precision index (0-based) - O(log n)
let getAt<'a>(list: List<a>, index: Int) : Stdlib.Option.Option<a> =
    match Stdlib.Int.toInt64(index) with
    | None -> None
    | Some(machineIndex) -> Stdlib.Internal.SkewList.getAt<a>(list, machineIndex)

// Set element at index (0-based) - O(log n), returns original list if index out of bounds
let setAt<'a>(list: List<a>, index: Int64, value: a) : List<a> =
    Stdlib.Internal.SkewList.setAt<a>(list, index, value)

// Find first element satisfying a predicate - O(n)
let findFirst<'a>(list: List<a>, fn: (a) -> Bool) : Stdlib.Option.Option<a> =
    if Stdlib.Internal.SkewList.isEmpty<a>(list) then None
    else
        match Stdlib.Internal.SkewList.head<a>(list) with
        | None -> None
        | Some(h) ->
            if fn(h) then Some(h)
            else Stdlib.List.findFirst<a>(Stdlib.Internal.SkewList.tail<a>(list), fn)

// Take first n elements - O(n)
let take<'a>(list: List<a>, n: Int) : List<a> =
    Stdlib.List.__takeHelper<a>(list, n, Stdlib.Internal.SkewList.empty<a>())

let __takeHelper<'a>(list: List<a>, n: Int, acc: List<a>) : List<a> =
    if n <= 0I then Stdlib.Internal.SkewList.reverse<a>(acc)
    else if Stdlib.Internal.SkewList.isEmpty<a>(list) then Stdlib.Internal.SkewList.reverse<a>(acc)
    else
        match Stdlib.Internal.SkewList.head<a>(list) with
        | None -> Stdlib.Internal.SkewList.reverse<a>(acc)
        | Some(h) ->
            let newAcc = Stdlib.Internal.SkewList.push<a>(acc, h) in
            Stdlib.List.__takeHelper<a>(Stdlib.Internal.SkewList.tail<a>(list), n - 1I, newAcc)

// Drop first n elements - O(n)
let drop<'a>(list: List<a>, n: Int) : List<a> =
    if n <= 0I then list
    else if Stdlib.Internal.SkewList.isEmpty<a>(list) then list
    else Stdlib.List.drop<a>(Stdlib.Internal.SkewList.tail<a>(list), n - 1I)

// Check if all elements satisfy a predicate - O(n)
let forAll<'a>(list: List<a>, fn: (a) -> Bool) : Bool =
    if Stdlib.Internal.SkewList.isEmpty<a>(list) then true
    else
        match Stdlib.Internal.SkewList.head<a>(list) with
        | None -> true
        | Some(h) ->
            if fn(h) then Stdlib.List.forAll<a>(Stdlib.Internal.SkewList.tail<a>(list), fn)
            else false

// Check if any element satisfies a predicate - O(n)
let any<'a>(list: List<a>, fn: (a) -> Bool) : Bool =
    if Stdlib.Internal.SkewList.isEmpty<a>(list) then false
    else
        match Stdlib.Internal.SkewList.head<a>(list) with
        | None -> false
        | Some(h) ->
            if fn(h) then true
            else Stdlib.List.any<a>(Stdlib.Internal.SkewList.tail<a>(list), fn)

// Get the last element of a list, or None if empty - O(log n)
let last<'a>(list: List<a>) : Stdlib.Option.Option<a> =
    Stdlib.Internal.SkewList.last<a>(list)

// Remove the last element from a list - O(n)
let dropLast<'a>(list: List<a>) : List<a> =
    Stdlib.Internal.SkewList.init<a>(list)

// Generate every Int from the lower through the upper bound, inclusively.
let range(start: Int, end_: Int) : List<Int> =
    Stdlib.List.__rangeHelper(start, end_, Stdlib.Internal.SkewList.empty<Int>())

let __rangeHelper(current: Int, end_: Int, acc: List<Int>) : List<Int> =
    if current > end_ then Stdlib.Internal.SkewList.reverse<Int>(acc)
    else Stdlib.List.__rangeHelper(current + 1I, end_, Stdlib.Internal.SkewList.push<Int>(acc, current))

let repeatUnsafe<'a>(count: Int, value: a) : List<a> =
    Stdlib.List.__repeatHelper<a>(count, value, Stdlib.Internal.SkewList.empty<a>())

let __repeatHelper<'a>(count: Int, value: a, acc: List<a>) : List<a> =
    if count <= 0I then acc
    else Stdlib.List.__repeatHelper<a>(count - 1I, value, Stdlib.Internal.SkewList.push<a>(acc, value))

// Internal machine-sized form for compiler and benchmark workloads whose
// cardinality is already proven to fit the skew-list representation.
let __repeatInt64<'a>(count: Int64, value: a, acc: List<a>) : List<a> =
    if count <= 0 then acc
    else Stdlib.List.__repeatInt64<a>(count - 1, value, Stdlib.Internal.SkewList.push<a>(acc, value))

// Repeat validates negative counts and preserves the interpreter's exact error.
let repeat<'a>(count: Int, value: a) : Stdlib.Result.Result<List<a>, String> =
    if count < 0I then
        Error("Expected `times` to be positive, but it was `" ++ Stdlib.Int.toString(count) ++ "`")
    else Ok(Stdlib.List.repeatUnsafe<a>(count, value))

// Map with index: apply a function to each element along with its index - O(n)
let indexedMap<'a, 'b>(list: List<a>, fn: (Int, a) -> b) : List<b> =
    Stdlib.List.__indexedMapHelper<a, b>(list, fn, 0I, Stdlib.Internal.SkewList.empty<b>())

let __indexedMapHelper<'a, 'b>(list: List<a>, fn: (Int, a) -> b, index: Int, acc: List<b>) : List<b> =
    if Stdlib.Internal.SkewList.isEmpty<a>(list) then Stdlib.Internal.SkewList.reverse<b>(acc)
    else
        match Stdlib.Internal.SkewList.head<a>(list) with
        | None -> Stdlib.Internal.SkewList.reverse<b>(acc)
        | Some(h) ->
            let newAcc = Stdlib.Internal.SkewList.push<b>(acc, fn(index, h)) in
            Stdlib.List.__indexedMapHelper<a, b>(Stdlib.Internal.SkewList.tail<a>(list), fn, index + 1I, newAcc)

// Partition a list into two lists based on a predicate
// Returns (elements where predicate is true, elements where predicate is false)
let partition<'a>(list: List<a>, fn: (a) -> Bool) : (List<a>, List<a>) =
    Stdlib.List.__partitionHelper<a>(list, fn, Stdlib.Internal.SkewList.empty<a>(), Stdlib.Internal.SkewList.empty<a>())

let __partitionHelper<'a>(list: List<a>, fn: (a) -> Bool, trueAcc: List<a>, falseAcc: List<a>) : (List<a>, List<a>) =
    if Stdlib.Internal.SkewList.isEmpty<a>(list) then (Stdlib.Internal.SkewList.reverse<a>(trueAcc), Stdlib.Internal.SkewList.reverse<a>(falseAcc))
    else
        match Stdlib.Internal.SkewList.head<a>(list) with
        | None -> (Stdlib.Internal.SkewList.reverse<a>(trueAcc), Stdlib.Internal.SkewList.reverse<a>(falseAcc))
        | Some(h) ->
            let newTrue = if fn(h) then Stdlib.Internal.SkewList.push<a>(trueAcc, h) else trueAcc in
            let newFalse = if fn(h) then falseAcc else Stdlib.Internal.SkewList.push<a>(falseAcc, h) in
            Stdlib.List.__partitionHelper<a>(Stdlib.Internal.SkewList.tail<a>(list), fn, newTrue, newFalse)

// Alias for forAll (darklang naming convention)
let all<'a>(list: List<a>, fn: (a) -> Bool) : Bool =
    Stdlib.List.forAll<a>(list, fn)

// Collection helpers ported from darklang/dark packages/darklang/stdlib/list.dark.
let findFirstIndex<'a>(list: List<a>, fn: (a) -> Bool) : Stdlib.Option.Option<Int> =
    Stdlib.List.__findFirstIndexHelper<a>(list, fn, 0I)

let __findFirstIndexHelper<'a>(list: List<a>, fn: (a) -> Bool, index: Int) : Stdlib.Option.Option<Int> =
    match list with
    | [] -> None
    | [head, ...tail] -> if fn(head) then Some(index) else Stdlib.List.__findFirstIndexHelper<a>(tail, fn, index + 1I)

let member<'a>(list: List<a>, value: a) : Bool =
    match list with
    | [] -> false
    | [head, ...tail] -> if head == value then true else Stdlib.List.member<a>(tail, value)

let interpose<'a>(list: List<a>, separator: a) : List<a> =
    match list with
    | [] -> []
    | [single] -> [single]
    | [head, ...tail] -> [head, separator, ...Stdlib.List.interpose<a>(tail, separator)]

let interleave<'a>(listA: List<a>, listB: List<a>) : List<a> =
    match listA with
    | [] -> listB
    | [headA, ...tailA] ->
        match listB with
        | [] -> listA
        | [headB, ...tailB] -> [headA, headB, ...Stdlib.List.interleave<a>(tailA, tailB)]

let filterMap<'a, 'b>(list: List<a>, fn: (a) -> Stdlib.Option.Option<b>) : List<b> =
    match list with
    | [] -> []
    | [head, ...tail] ->
        match fn(head) with
        | Some(value) -> [value, ...Stdlib.List.filterMap<a, b>(tail, fn)]
        | None -> Stdlib.List.filterMap<a, b>(tail, fn)

let dropWhile<'a>(list: List<a>, fn: (a) -> Bool) : List<a> =
    match list with
    | [] -> []
    | [head, ...tail] -> if fn(head) then Stdlib.List.dropWhile<a>(tail, fn) else list

let takeWhile<'a>(list: List<a>, fn: (a) -> Bool) : List<a> =
    match list with
    | [] -> []
    | [head, ...tail] -> if fn(head) then [head, ...Stdlib.List.takeWhile<a>(tail, fn)] else []

let map2shortest<'a, 'b, 'c>(listA: List<a>, listB: List<b>, fn: (a, b) -> c) : List<c> =
    Stdlib.List.map2shortestHelper<a, b, c>(listA, listB, fn, [])

let map2shortestHelper<'a, 'b, 'c>(listA: List<a>, listB: List<b>, fn: (a, b) -> c, result: List<c>) : List<c> =
    match (listA, listB) with
    | ([], _) -> result
    | (_, []) -> result
    | ([headA, ...tailA], [headB, ...tailB]) ->
        Stdlib.List.map2shortestHelper<a, b, c>(
            tailA,
            tailB,
            fn,
            Stdlib.List.pushBack<c>(result, fn(headA, headB)))

let map2<'a, 'b, 'c>(listA: List<a>, listB: List<b>, fn: (a, b) -> c) : Stdlib.Option.Option<List<c>> =
    if Stdlib.List.length<a>(listA) != Stdlib.List.length<b>(listB) then None
    else Some(Stdlib.List.map2shortest<a, b, c>(listA, listB, fn))

let zipShortest<'a, 'b>(listA: List<a>, listB: List<b>) : List<(a, b)> =
    match (listA, listB) with
    | ([], _) -> []
    | (_, []) -> []
    | ([headA, ...tailA], [headB, ...tailB]) -> [(headA, headB), ...Stdlib.List.zipShortest<a, b>(tailA, tailB)]

let unzip<'a, 'b>(pairs: List<(a, b)>) : (List<a>, List<b>) =
    match pairs with
    | [] -> ([], [])
    | [(first, second), ...tail] ->
        match Stdlib.List.unzip<a, b>(tail) with
        | (firsts, seconds) -> ([first, ...firsts], [second, ...seconds])

let splitLast<'a>(list: List<a>) : Stdlib.Option.Option<(List<a>, a)> =
    match Stdlib.List.reverse<a>(list) with
    | [] -> None
    | [last, ...reversedInit] -> Some((Stdlib.List.reverse<a>(reversedInit), last))

let groupByWithKey<'a, 'b>(list: List<a>, fn: (a) -> b) : List<(b, List<a>)> =
    Stdlib.List.__groupByWithKeyHelper<a, b>(list, fn, [])

let __groupContainsKey<'a, 'b>(groups: List<(b, List<a>)>, key: b) : Bool =
    match groups with
    | [] -> false
    | [group, ...tail] -> if group.0 == key then true else Stdlib.List.__groupContainsKey<a, b>(tail, key)

let __appendToGroup<'a, 'b>(groups: List<(b, List<a>)>, key: b, element: a) : List<(b, List<a>)> =
    match groups with
    | [] -> []
    | [group, ...tail] ->
        if group.0 == key then [(group.0, Stdlib.List.pushBack<a>(group.1, element)), ...tail]
        else [group, ...Stdlib.List.__appendToGroup<a, b>(tail, key, element)]

let __groupByWithKeyHelper<'a, 'b>(remaining: List<a>, fn: (a) -> b, groups: List<(b, List<a>)>) : List<(b, List<a>)> =
    match remaining with
    | [] -> groups
    | [element, ...tail] ->
        let key = fn(element) in
        let retainedGroups = [groups] in
        let retainedKey = [key] in
        let retainedElement = [element] in
        if Stdlib.List.__groupContainsKey<a, b>(groups, key) then
            match (retainedGroups, retainedKey, retainedElement) with
            | ([rootedGroups], [rootedKey], [rootedElement]) ->
                Stdlib.List.__groupByWithKeyHelper<a, b>(
                    tail,
                    fn,
                    Stdlib.List.__appendToGroup<a, b>(rootedGroups, rootedKey, rootedElement))
            | _ -> Builtin.testRuntimeError("groupByWithKey retained state was empty")
        else
            match (retainedGroups, retainedKey, retainedElement) with
            | ([rootedGroups], [rootedKey], [rootedElement]) ->
                Stdlib.List.__groupByWithKeyHelper<a, b>(
                    tail,
                    fn,
                    Stdlib.List.pushBack<(b, List<a>)>(rootedGroups, (rootedKey, [rootedElement])))
            | _ -> Builtin.testRuntimeError("groupByWithKey retained state was empty")

let iter<'a>(list: List<a>, fn: (a) -> Unit) : Unit =
    match list with
    | [] -> ()
    | [head, ...tail] ->
        let _ = fn(head) in
        Stdlib.List.iter<a>(tail, fn)

let __randomIndex(bound: Int64) : Int64 =
    let sample = Stdlib.Random.int64() & 9223372036854775807L in
    let limit = 9223372036854775807L - (9223372036854775807L % bound) in
    if sample < limit then sample % bound else Stdlib.List.__randomIndex(bound)

let randomElement<'a>(list: List<a>) : Stdlib.Option.Option<a> =
    let length = Stdlib.Internal.SkewList.length<a>(list) in
    if length == 0 then None
    else Stdlib.Internal.SkewList.getAt<a>(list, Stdlib.List.__randomIndex(length))

let chunkBySizeHelper<'a>(size: Int, currentList: List<a>, accum: List<List<a>>) : List<List<a>> =
    match currentList with
    | [] -> Stdlib.List.reverse<List<a>>(accum)
    | _ ->
        let taken = Stdlib.List.take<a>(currentList, size) in
        let rest = Stdlib.List.drop<a>(currentList, size) in
        let next = if Stdlib.List.isEmpty<a>(taken) then accum else [taken, ...accum] in
        Stdlib.List.chunkBySizeHelper<a>(size, rest, next)

let chunkBySize<'a>(list: List<a>, size: Int) : Stdlib.Result.Result<List<List<a>>, Stdlib.List.ChunkBySizeError> =
    if size <= 0I then Error(Stdlib.List.ChunkBySizeError.SizeMustBeGreaterThanZero)
    else Ok(Stdlib.List.chunkBySizeHelper<a>(size, list, []))

// Convert list to display string representation: "[elem1, elem2, ...]"
// Note: Generic version disabled due to function reference bug
// let Stdlib.List.toDisplayString<'a>(list: List<a>, elemToString: (a) -> String) : String =
//     let strs = Stdlib.List.map<a, String>(list, elemToString) in
//     "[" ++ Stdlib.String.join(strs, ", ") ++ "]"

// Type-specific toDisplayString implementations (workaround for function reference bug)

// Helper to build string list from Int64 list
let __int64sToStrings(list: List<Int64>, acc: List<String>) : List<String> =
    if Stdlib.Internal.SkewList.isEmpty<Int64>(list) then Stdlib.Internal.SkewList.reverse<String>(acc)
    else
        match Stdlib.Internal.SkewList.head<Int64>(list) with
        | None -> Stdlib.Internal.SkewList.reverse<String>(acc)
        | Some(h) ->
            let s = Stdlib.Int64.toString(h) in
            let newAcc = Stdlib.Internal.SkewList.push<String>(acc, s) in
            Stdlib.List.__int64sToStrings(Stdlib.Internal.SkewList.tail<Int64>(list), newAcc)

let toDisplayString_i64(list: List<Int64>) : String =
    let strs = Stdlib.List.__int64sToStrings(list, Stdlib.Internal.SkewList.empty<String>()) in
    "[" ++ Stdlib.String.join(strs, ", ") ++ "]"

let __intsToStrings(list: List<Int>, acc: List<String>) : List<String> =
    if Stdlib.Internal.SkewList.isEmpty<Int>(list) then Stdlib.Internal.SkewList.reverse<String>(acc)
    else
        match Stdlib.Internal.SkewList.head<Int>(list) with
        | None -> Stdlib.Internal.SkewList.reverse<String>(acc)
        | Some(h) ->
            let next = Stdlib.Internal.SkewList.push<String>(acc, Stdlib.Int.toString(h)) in
            Stdlib.List.__intsToStrings(Stdlib.Internal.SkewList.tail<Int>(list), next)

let toDisplayString_int(list: List<Int>) : String =
    let strs = Stdlib.List.__intsToStrings(list, Stdlib.Internal.SkewList.empty<String>()) in
    "[" ++ Stdlib.String.join(strs, ", ") ++ "]"

let __i64ListsToStrings(list: List<List<Int64>>, acc: List<String>) : List<String> =
    if Stdlib.Internal.SkewList.isEmpty<List<Int64>>(list) then Stdlib.Internal.SkewList.reverse<String>(acc)
    else
        match Stdlib.Internal.SkewList.head<List<Int64>>(list) with
        | None -> Stdlib.Internal.SkewList.reverse<String>(acc)
        | Some(h) ->
            let s = Stdlib.List.toDisplayString_i64(h) in
            let newAcc = Stdlib.Internal.SkewList.push<String>(acc, s) in
            Stdlib.List.__i64ListsToStrings(Stdlib.Internal.SkewList.tail<List<Int64>>(list), newAcc)

let toDisplayString_list_i64(list: List<List<Int64>>) : String =
    let strs = Stdlib.List.__i64ListsToStrings(list, Stdlib.Internal.SkewList.empty<String>()) in
    "[" ++ Stdlib.String.join(strs, ", ") ++ "]"

// Helper to build string list from String list (with double quotes for display)
let __stringsToStrings(list: List<String>, acc: List<String>) : List<String> =
    if Stdlib.Internal.SkewList.isEmpty<String>(list) then Stdlib.Internal.SkewList.reverse<String>(acc)
    else
        match Stdlib.Internal.SkewList.head<String>(list) with
        | None -> Stdlib.Internal.SkewList.reverse<String>(acc)
        | Some(h) ->
            let quoted = "\"" ++ h ++ "\"" in
            let newAcc = Stdlib.Internal.SkewList.push<String>(acc, quoted) in
            Stdlib.List.__stringsToStrings(Stdlib.Internal.SkewList.tail<String>(list), newAcc)

let __quoteStringForDisplay(s: String) : String =
    "\"" ++ s ++ "\""

let __stringsDisplayItems(list: List<String>, first: Bool) : String =
    match list with
    | [] -> ""
    | [h] ->
        if first then Stdlib.List.__quoteStringForDisplay(h)
        else ", " ++ Stdlib.List.__quoteStringForDisplay(h)
    | [h, ...t] ->
        let item = Stdlib.List.__quoteStringForDisplay(h) in
        let rest = Stdlib.List.__stringsDisplayItems(t, false) in
        if first then item ++ rest else ", " ++ item ++ rest

let toDisplayString_str(list: List<String>) : String =
    "[" ++ Stdlib.List.__stringsDisplayItems(list, true) ++ "]"

let __charsDisplayItems(list: List<Char>, first: Bool) : String =
    match list with
    | [] -> ""
    | [h] ->
        if first then h else ", " ++ h
    | [h, ...t] ->
        let rest = Stdlib.List.__charsDisplayItems(t, false) in
        if first then h ++ rest else ", " ++ h ++ rest

let toDisplayString_char(list: List<Char>) : String =
    "[" ++ Stdlib.List.__charsDisplayItems(list, true) ++ "]"

// Helper to build string list from Bool list
let __boolsToStrings(list: List<Bool>, acc: List<String>) : List<String> =
    if Stdlib.Internal.SkewList.isEmpty<Bool>(list) then Stdlib.Internal.SkewList.reverse<String>(acc)
    else
        match Stdlib.Internal.SkewList.head<Bool>(list) with
        | None -> Stdlib.Internal.SkewList.reverse<String>(acc)
        | Some(h) ->
            let s = Stdlib.Bool.toString(h) in
            let newAcc = Stdlib.Internal.SkewList.push<String>(acc, s) in
            Stdlib.List.__boolsToStrings(Stdlib.Internal.SkewList.tail<Bool>(list), newAcc)

let toDisplayString_bool(list: List<Bool>) : String =
    let strs = Stdlib.List.__boolsToStrings(list, Stdlib.Internal.SkewList.empty<String>()) in
    "[" ++ Stdlib.String.join(strs, ", ") ++ "]"

let __floatsDisplayItems(list: List<Float>, first: Bool) : String =
    if Stdlib.Internal.SkewList.isEmpty<Float>(list) then ""
    else
        match Stdlib.Internal.SkewList.head<Float>(list) with
        | None -> ""
        | Some(h) ->
            let item = Stdlib.Float.toString(h) in
            let tail = Stdlib.Internal.SkewList.tail<Float>(list) in
            let rest = Stdlib.List.__floatsDisplayItems(tail, false) in
            if first then item ++ rest else ", " ++ item ++ rest

let toDisplayString_f64(list: List<Float>) : String =
    "[" ++ Stdlib.List.__floatsDisplayItems(list, true) ++ "]"

let zip<'a, 'b>(list1: List<a>, list2: List<b>) : List<(a, b)> =
    match (list1, list2) with
    | ([], _) -> []
    | (_, []) -> []
    | ([h1, ...t1], [h2, ...t2]) -> [(h1, h2), ...Stdlib.List.zip<a, b>(t1, t2)]
