// Stdlib.Cli.Execution - shell execution and canonical execution outcomes.

type Stdlib.Cli.ExecutionOutcome = { exitCode: Int, stdout: String, stderr: String }
type Stdlib.Cli.NativeOutput = { exitCode: Int64, stdout: String, stderr: String }

// Replaced by the native CLI effect during AST-to-ANF conversion.
def Stdlib.Cli.__execute(command: String) : Stdlib.Cli.NativeOutput =
    Stdlib.Cli.NativeOutput { exitCode = -1, stdout = "", stderr = "native CLI execution unavailable" }

def Stdlib.Cli.execute(command: String) : Stdlib.Cli.ExecutionOutcome =
    let result = Stdlib.Cli.__execute(command) in
    Stdlib.Cli.ExecutionOutcome {
        exitCode = Stdlib.Int.fromInt64(result.exitCode),
        stdout = result.stdout,
        stderr = result.stderr
    }

def Stdlib.Cli.executeWithUnitOrStdErr(command: String) : Stdlib.Result.Result<Unit, String> =
    let result = Stdlib.Cli.execute(command) in
    if result.exitCode == 0I then Ok(()) else Error(result.stderr)

def Stdlib.Cli.executeWithStdOutOrStdErr(command: String) : Stdlib.Result.Result<String, String> =
    let result = Stdlib.Cli.execute(command) in
    if result.exitCode == 0I then Ok(result.stdout) else Error(result.stderr)
