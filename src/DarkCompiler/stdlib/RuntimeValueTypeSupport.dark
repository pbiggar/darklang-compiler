// RuntimeValueTypeSupport.dark - compiler-syntax helper for exact custom-type catalog matching.

module Darklang.LanguageTools.RuntimeTypes

// ValueSearch constructs only an empty-argument custom-type query. Keep that
// boundary explicit so a parameterized catalog type cannot match by hash alone.
let __isCustomTypeWithNoTypeArguments (valueType: Darklang.LanguageTools.RuntimeTypes.ValueType) (expectedHash: String) : Bool =
    match valueType with
    | Known knownType ->
        match knownType with
        | KTCustomType (fqTypeName, typeArguments) ->
            match fqTypeName with
            | Package runtimeHash ->
                Stdlib.List.length typeArguments == 0 &&
                Darklang.LanguageTools.RuntimeTypes.hashToString runtimeHash == expectedHash
    | _ -> false
