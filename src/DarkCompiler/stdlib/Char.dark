// Stdlib.Char.dark - Stdlib.Char definitions
//
// Split from stdlib.dark for modular stdlib loading.

module Stdlib.Char

// Stdlib.Char - Character operations
// =============================================================================
// Note: In Dark, characters are represented as single-character strings.
// These functions operate on the first codepoint of a string.

// Check if character is an ASCII digit (0-9)
let isDigit(c: String) : Bool =
    if Stdlib.String.isEmpty(c) then false
    else
        let cps = Stdlib.String.toCodepoints(c) in
        match Stdlib.List.head<Int64>(cps) with
        | Some(cp) -> cp >= 48 && cp <= 57
        | None -> false

// Check if character is an ASCII letter (a-z, A-Z)
let isLetter(c: String) : Bool =
    if Stdlib.String.isEmpty(c) then false
    else
        let cps = Stdlib.String.toCodepoints(c) in
        match Stdlib.List.head<Int64>(cps) with
        | Some(cp) -> (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122)
        | None -> false

// Check if character is ASCII whitespace (space, tab, newline, carriage return)
let isWhitespace(c: String) : Bool =
    if Stdlib.String.isEmpty(c) then false
    else
        let cps = Stdlib.String.toCodepoints(c) in
        match Stdlib.List.head<Int64>(cps) with
        | Some(cp) -> cp == 32 || cp == 9 || cp == 10 || cp == 13
        | None -> false

// Check if character is uppercase in the supported case-conversion pairs
let isUppercase(c: String) : Bool =
    if Stdlib.String.isEmpty(c) then false
    else
        let cps = Stdlib.String.toCodepoints(c) in
        match Stdlib.List.head<Int64>(cps) with
        | Some(cp) ->
            (cp >= 65 && cp <= 90)
            || cp == 193
            || cp == 379
            || cp == 211
            || cp == 321
            || cp == 7358
        | None -> false

// Check if character is an ASCII lowercase letter (a-z)
let isLowercase(c: String) : Bool =
    if Stdlib.String.isEmpty(c) then false
    else
        let cps = Stdlib.String.toCodepoints(c) in
        match Stdlib.List.head<Int64>(cps) with
        | Some(cp) -> cp >= 97 && cp <= 122
        | None -> false

// Check if character is alphanumeric (a-z, A-Z, 0-9)
let isAlphanumeric(c: String) : Bool =
    Stdlib.Char.isLetter(c) || Stdlib.Char.isDigit(c)

// Check if character is in the ASCII codepoint range
let isASCII(c: String) : Bool =
    if Stdlib.String.isEmpty(c) then false
    else
        let cps = Stdlib.String.toCodepoints(c) in
        match Stdlib.List.head<Int64>(cps) with
        | Some(cp) -> cp >= 0 && cp <= 127
        | None -> false

// Check if character is an ASCII letter (a-z, A-Z)
let isASCIILetter(c: String) : Bool =
    if Stdlib.Char.isASCII(c) then Stdlib.Char.isLetter(c)
    else false

// Compare characters by first codepoint
let isLessThan(left: String, right: String) : Bool =
    Stdlib.Char.toCode(left) < Stdlib.Char.toCode(right)

// Compare characters by first codepoint
let isLessThanOrEqualTo(left: String, right: String) : Bool =
    Stdlib.Char.toCode(left) <= Stdlib.Char.toCode(right)

// Compare characters by first codepoint
let isGreaterThan(left: String, right: String) : Bool =
    Stdlib.Char.toCode(left) > Stdlib.Char.toCode(right)

// Compare characters by first codepoint
let isGreaterThanOrEqualTo(left: String, right: String) : Bool =
    Stdlib.Char.toCode(left) >= Stdlib.Char.toCode(right)

// Convert ASCII character to uppercase
let toUppercase(c: String) : String =
    if Stdlib.String.isEmpty(c) then ""
    else
        let cps = Stdlib.String.toCodepoints(c) in
        match Stdlib.List.head<Int64>(cps) with
        | Some(cp) ->
            if cp >= 97 && cp <= 122 then
                Stdlib.String.fromCodepoints([cp - 32])
            else if cp == 225 then
                "Á"
            else if cp == 380 then
                "Ż"
            else if cp == 243 then
                "Ó"
            else if cp == 322 then
                "Ł"
            else if cp == 4350 then
                "Ჾ"
            else
                Stdlib.String.fromCodepoints([cp])
        | None -> ""

// Convert ASCII character to lowercase
let toLowercase(c: String) : String =
    if Stdlib.String.isEmpty(c) then ""
    else
        let cps = Stdlib.String.toCodepoints(c) in
        match Stdlib.List.head<Int64>(cps) with
        | Some(cp) ->
            if cp >= 65 && cp <= 90 then
                Stdlib.String.fromCodepoints([cp + 32])
            else if cp == 193 then
                "á"
            else if cp == 379 then
                "ż"
            else if cp == 211 then
                "ó"
            else if cp == 321 then
                "ł"
            else if cp == 7358 then
                "ჾ"
            else
                Stdlib.String.fromCodepoints([cp])
        | None -> ""

// Get the Unicode codepoint value of the first character
let toCode(c: String) : Int64 =
    let cps = Stdlib.String.toCodepoints(c) in
    match Stdlib.List.head<Int64>(cps) with
    | Some(cp) -> cp
    | None -> 0

// Get the ASCII code of the first character when representable in 0..255
let toAsciiCode(c: String) : Stdlib.Option.Option<Int64> =
    let cps = Stdlib.String.toCodepoints(c) in
    match Stdlib.List.head<Int64>(cps) with
    | Some(cp) ->
        if cp >= 0 && cp <= 255 then
            Some(cp)
        else
            None
    | None -> None

// Create a single character string from a codepoint
let fromCode(code: Int64) : String =
    Stdlib.String.fromCodepoints([code])

// Convert a Char value to String (identity at runtime representation level)
let toString(c: String) : String =
    c

// =============================================================================
