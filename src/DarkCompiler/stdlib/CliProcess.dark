// Stdlib.Cli.Process - portable process helpers over the native execution boundary.

module Stdlib.Cli.Process

type ProcessHandle = Int
type Output = { exitCode: Int, stdout: String, stderr: String }

let __replaceQuotes(s: String) : String = Stdlib.String.replace(s, "'", "'\\''")
let shellQuote(s: String) : String = "'" ++ Stdlib.Cli.Process.__replaceQuotes(s) ++ "'"

let __quotedArgs(args: List<String>) : String =
    Stdlib.String.join(Stdlib.List.map<String, String>(args, fun arg -> Stdlib.Cli.Process.shellQuote(arg)), " ")

let __output(result: Stdlib.Cli.NativeOutput) : Stdlib.Cli.Process.Output =
    Stdlib.Cli.Process.Output { exitCode = Stdlib.Int.fromInt64(result.exitCode), stdout = result.stdout, stderr = result.stderr }

let run(program: String, args: List<String>) : Stdlib.Result.Result<Stdlib.Cli.Process.Output, Stdlib.Cli.Posix.Error> =
    let command = Stdlib.Cli.Process.shellQuote(program) ++ " " ++ Stdlib.Cli.Process.__quotedArgs(args) in
    let result = Stdlib.Cli.__execute(command) in
    if result.exitCode == 127 && Stdlib.String.contains(result.stderr, "No such file or directory") then
        Error(Stdlib.Cli.Posix.Error { errno = 2I, message = "No such file or directory" })
    else Ok(Stdlib.Cli.Process.__output(result))

let exec(program: String, args: List<String>) : Stdlib.Result.Result<String, String> =
    match Stdlib.Cli.Process.run(program, args) with
    | Error(error) -> Error(error.message)
    | Ok(output) ->
        if output.exitCode == 0I then Ok(Stdlib.String.trimEnd(output.stdout))
        else let error = Stdlib.String.trimEnd(output.stderr) in
             if error == "" then Error("Command failed with exit code " ++ Stdlib.Int.toString(output.exitCode)) else Error(error)

let kill(pid: Int) : Stdlib.Result.Result<Unit, Stdlib.Cli.Posix.Error> = Stdlib.Cli.Posix.kill(pid, Stdlib.Cli.Posix.sigterm())
let forceKill(pid: Int) : Stdlib.Result.Result<Unit, Stdlib.Cli.Posix.Error> = Stdlib.Cli.Posix.kill(pid, Stdlib.Cli.Posix.sigkill())

let runIn(directory: String, program: String, args: List<String>) : Stdlib.Result.Result<Stdlib.Cli.Process.Output, Stdlib.Cli.Posix.Error> =
    Stdlib.Cli.Process.run("/bin/sh", ["-c", "cd " ++ Stdlib.Cli.Process.shellQuote(directory) ++ " && " ++ Stdlib.Cli.Process.shellQuote(program) ++ " " ++ Stdlib.Cli.Process.__quotedArgs(args)])

let runSilent(program: String, args: List<String>) : Stdlib.Result.Result<Int, Stdlib.Cli.Posix.Error> =
    match Stdlib.Cli.Process.run(program, args) with | Ok(output) -> Ok(output.exitCode) | Error(error) -> Error(error)

let __envArgs(env: List<(String, String)>) : List<String> =
    Stdlib.List.map<(String, String), String>(env, fun pair -> let (key, value) = pair in key ++ "=" ++ value)

let __firstInvalidEnv(env: List<(String, String)>) : Stdlib.Option.Option<String> =
    match env with
    | [] -> Stdlib.Option.Option.None
    | [(key, _), ...rest] -> if Stdlib.String.contains(key, "=") || Stdlib.String.contains(key, " ") then Some(key) else Stdlib.Cli.Process.__firstInvalidEnv(rest)

let runWithEnv(program: String, args: List<String>, env: List<(String, String)>) : Stdlib.Result.Result<Stdlib.Cli.Process.Output, String> =
    match Stdlib.Cli.Process.__firstInvalidEnv(env) with
    | Some(name) -> Error("Invalid env var name: '" ++ name ++ "' (must not contain '=' or spaces)")
    | _ ->
        match Stdlib.Cli.Process.run("/usr/bin/env", Stdlib.List.append(Stdlib.Cli.Process.__envArgs(env), Stdlib.List.append([program], args))) with
        | Ok(output) -> Ok(output)
        | Error(error) -> Error(error.message)

let runWithTimeout(timeoutMs: Int, program: String, args: List<String>) : Stdlib.Result.Result<Stdlib.Cli.Process.Output, String> =
    if timeoutMs <= 0I then Error("timeoutMs must be positive")
    else
        let seconds = Stdlib.Float.toString(Stdlib.Int.toFloat(timeoutMs) / 1000.0) ++ "s" in
        match Stdlib.Cli.Process.run("/usr/bin/timeout", Stdlib.List.append(["--kill-after=0.1s", seconds, program], args)) with
        | Error(error) -> Error(error.message)
        | Ok(output) -> if output.exitCode == 124I || output.exitCode == 137I then Error("Process timed out") else Ok(output)

let pipe(program1: String, args1: List<String>, program2: String, args2: List<String>) : Stdlib.Result.Result<Stdlib.Cli.Process.Output, Stdlib.Cli.Posix.Error> =
    Stdlib.Cli.Process.run("/bin/sh", ["-c", Stdlib.Cli.Process.shellQuote(program1) ++ " " ++ Stdlib.Cli.Process.__quotedArgs(args1) ++ " | " ++ Stdlib.Cli.Process.shellQuote(program2) ++ " " ++ Stdlib.Cli.Process.__quotedArgs(args2)])

let shellPipeline(commands: List<String>) : Stdlib.Result.Result<Stdlib.Cli.Process.Output, Stdlib.Cli.Posix.Error> =
    Stdlib.Cli.Process.run("/bin/sh", ["-c", Stdlib.String.join(commands, " | ")])

let isRunning(pid: Int) : Bool = Stdlib.Cli.Posix.isProcessRunning(pid)

let waitFor(pid: Int) : Unit =
    if Stdlib.Cli.Posix.isProcessRunning(pid) then let _ = Stdlib.Cli.Posix.sleep(100.0) in Stdlib.Cli.Process.waitFor(pid) else ()

let spawn(command: String) : Stdlib.Cli.Process.ProcessHandle = Stdlib.Int.fromInt64(Stdlib.Cli.__spawnProcess(command))
let communicate(handle: Stdlib.Cli.Process.ProcessHandle, input: String) : Stdlib.Cli.ExecutionOutcome =
    match Stdlib.Int.toInt64(handle) with
    | _ -> Stdlib.Cli.ExecutionOutcome { exitCode = -1I, stdout = "", stderr = "Invalid process handle" }
    | Some(handle) -> let result = Stdlib.Cli.__processIO(handle, input) in Stdlib.Cli.ExecutionOutcome { exitCode = Stdlib.Int.fromInt64(result.exitCode), stdout = result.stdout, stderr = result.stderr }
let terminate(handle: Stdlib.Cli.Process.ProcessHandle) : Stdlib.Cli.ExecutionOutcome =
    match Stdlib.Int.toInt64(handle) with
    | _ -> Stdlib.Cli.ExecutionOutcome { exitCode = -1I, stdout = "", stderr = "Invalid process handle" }
    | Some(handle) -> let result = Stdlib.Cli.__terminateProcess(handle) in Stdlib.Cli.ExecutionOutcome { exitCode = Stdlib.Int.fromInt64(result.exitCode), stdout = result.stdout, stderr = result.stderr }
