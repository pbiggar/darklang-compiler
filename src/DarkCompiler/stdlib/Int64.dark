// Stdlib.Int64.dark - Stdlib.Int64 definitions
//
// Split from stdlib.dark for modular stdlib loading.

module Stdlib.Int64

type ParseError = BadFormat | OutOfRange

// Stdlib.Int64 - Integer operations

let add(a: Int64, b: Int64) : Int64 = a + b

// Interpreter public names for the existing arithmetic operations.
let subtract(a: Int64, b: Int64) : Int64 = a - b

let multiply(a: Int64, b: Int64) : Int64 = a * b

let divide(a: Int64, b: Int64) : Int64 =
    if b == 0L then Builtin.crash("Cannot divide by 0")
    else if a == -9223372036854775808L && b == -1L then -9223372036854775808L
    else a / b

let max(a: Int64, b: Int64) : Int64 = if a > b then a else b

let min(a: Int64, b: Int64) : Int64 = if a < b then a else b

let mod(a: Int64, b: Int64) : Int64 =
    if b == 0L then Builtin.crash("Cannot evaluate modulus against 0")
    else if b < 0L then Builtin.crash("Cannot evaluate modulus against a negative number")
    else a % b
let remainder(a: Int64, b: Int64) : Stdlib.Result.Result<Int64, String> =
    if b == 0L then Error("Cannot divide by 0")
    else if b == -1L then Ok(0L)
    else Ok(a - ((a / b) * b))

let absoluteValue(a: Int64) : Int64 = if a < 0L then 0L - a else a

let negate(a: Int64) : Int64 = 0L - a

let __powerLoop(base: Int64, exponent: Int64, result: Int64) : Int64 =
    if exponent == 0L then result
    else
        let next = if (exponent % 2L) == 1L then result * base else result in
        Stdlib.Int64.__powerLoop(base * base, exponent / 2L, next)
let power(base: Int64, exponent: Int64) : Int64 =
    if exponent < 0L then Builtin.crash("Cannot raise integer to a negative exponent")
    else Stdlib.Int64.__powerLoop(base, exponent, 1L)

let clamp(value: Int64, limitA: Int64, limitB: Int64) : Int64 =
    let lower = Stdlib.Int64.min(limitA, limitB) in
    let upper = Stdlib.Int64.max(limitA, limitB) in
    Stdlib.Int64.max(lower, Stdlib.Int64.min(upper, value))

let greaterThan(a: Int64, b: Int64) : Bool = a > b

let greaterThanOrEqualTo(a: Int64, b: Int64) : Bool = a >= b

let lessThan(a: Int64, b: Int64) : Bool = a < b

let lessThanOrEqualTo(a: Int64, b: Int64) : Bool = a <= b

// Bitwise operations
let bitwiseAnd(a: Int64, b: Int64) : Int64 = a & b

let bitwiseOr(a: Int64, b: Int64) : Int64 = a ||| b

let bitwiseXor(a: Int64, b: Int64) : Int64 = (a ||| b) & ~~~(a & b)

let shiftLeft(a: Int64, shift: Int64) : Int64 = a << shift

let shiftRight(a: Int64, shift: Int64) : Int64 = a >> shift

let bitwiseNot(a: Int64) : Int64 = ~~~a

// Count number of set bits (population count)
// Uses parallel bit counting algorithm (Brian Kernighan / SWAR)
// Historical compiler extension retained for the existing public bit-count API.
// It is deliberately outside the interpreter parity surface.
let __popcount(x: Int64) : Int64 =
    // Constants (in decimal):
    // 0x5555555555555555 = 6148914691236517205L
    // 0x3333333333333333 = 3689348814741910323L
    // 0x0F0F0F0F0F0F0F0F = 1085102592571150095L
    // 0x0101010101010101 = 72340172838076673L
    let mask1 = 6148914691236517205L in
    let mask2 = 3689348814741910323L in
    let mask3 = 1085102592571150095L in
    let mult = 72340172838076673L in
    let x = x - ((x >> 1L) & mask1) in
    let x = (x & mask2) + ((x >> 2L) & mask2) in
    let x = (x + (x >> 4L)) & mask3 in
    (x * mult) >> 56L

// Convert a single digit (0L-9L) to its string representation
let __digitToString(n: Int64) : String =
    match n with
    | 0L -> "0"
    | 1L -> "1"
    | 2L -> "2"
    | 3L -> "3"
    | 4L -> "4"
    | 5L -> "5"
    | 6L -> "6"
    | 7L -> "7"
    | 8L -> "8"
    | 9L -> "9"
    | _ -> Builtin.crash("Stdlib.Int64.__digitToString expected a digit from 0 to 9")

// Convert an integer to its string representation
let toString(n: Int64) : String =
    if n < 0L then
        if n < -9L then
            let quotient = n / 10L in
            // Decimal fragments are ASCII and therefore already closed under NFC.
            __string_concat_raw(Stdlib.Int64.toString(quotient), Stdlib.Int64.__digitToString(0L - (n - (quotient * 10L))))
        else __string_concat_raw("-", Stdlib.Int64.__digitToString(0L - n))
    else if n < 10L then Stdlib.Int64.__digitToString(n)
    else
        let quotient = n / 10L in
        let remainder = n - (quotient * 10L) in
        __string_concat_raw(Stdlib.Int64.toString(quotient), Stdlib.Int64.__digitToString(remainder))

// Sum all integers in a list
let sum(list: List<Int64>) : Int64 =
    Stdlib.List.fold<Int64, Int64>(list, 0L, fun acc x -> acc + x)

let __fromIntUnchecked(value: Int) : Int64 =
    match Stdlib.Int.toInt64(value) with
    | Some(result) -> result
    | None -> Builtin.crash("Internal Int64 conversion invariant failed")
let random(start: Int64, finish: Int64) : Int64 = Stdlib.Int64.__fromIntUnchecked(Stdlib.Int.random(Stdlib.Int.fromInt64(start), Stdlib.Int.fromInt64(finish)))
let toFloat(value: Int64) : Float = Stdlib.Int.toFloat(Stdlib.Int.fromInt64(value))
let sqrt(value: Int64) : Float = Stdlib.Float.sqrt(Stdlib.Int64.toFloat(value))
let parse(value: String) : Stdlib.Result.Result<Int64, Stdlib.Int64.ParseError> =
    match Stdlib.Int.parse(value) with
    | Error(_) -> Error(Stdlib.Int64.ParseError.BadFormat)
    | Ok(parsed) ->
        match Stdlib.Int.toInt64(parsed) with
        | None -> Error(Stdlib.Int64.ParseError.OutOfRange)
        | Some(result) -> Ok(result)
let fromFloat(value: Float) : Int64 =
    match Stdlib.Int.toInt64(Stdlib.Int.fromFloat(value)) with
    | Some(result) -> result
    | None -> Builtin.crash("Encountered out-of-range value for type of Int64")
let fromInt8(value: Int8) : Int64 = Stdlib.Int64.__fromIntUnchecked(Stdlib.Int.fromInt8(value))
let fromUInt8(value: UInt8) : Int64 = Stdlib.Int64.__fromIntUnchecked(Stdlib.Int.fromUInt8(value))
let fromInt16(value: Int16) : Int64 = Stdlib.Int64.__fromIntUnchecked(Stdlib.Int.fromInt16(value))
let fromUInt16(value: UInt16) : Int64 = Stdlib.Int64.__fromIntUnchecked(Stdlib.Int.fromUInt16(value))
let fromInt32(value: Int32) : Int64 = Stdlib.Int64.__fromIntUnchecked(Stdlib.Int.fromInt32(value))
let fromUInt32(value: UInt32) : Int64 = Stdlib.Int64.__fromIntUnchecked(Stdlib.Int.fromUInt32(value))
let fromUInt64(value: UInt64) : Stdlib.Option.Option<Int64> = Stdlib.Int.toInt64(Stdlib.Int.fromUInt64(value))
let fromInt128(value: Int128) : Stdlib.Option.Option<Int64> = Stdlib.Int.toInt64(Stdlib.Int.fromInt128(value))
let fromUInt128(value: UInt128) : Stdlib.Option.Option<Int64> = Stdlib.Int.toInt64(Stdlib.Int.fromUInt128(value))
