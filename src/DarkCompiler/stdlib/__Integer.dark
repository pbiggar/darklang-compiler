// __Integer.dark - tagged small integers and immutable base-2^31 limb arithmetic.
//
// Odd machine words encode signed 62-bit values. Aligned words point at
// [refcount, payload-bytes, signed-used-count, little-endian Int64 limbs].

module Darklang.Stdlib.Int

let __base () : Int64 = 2147483648L
let __smallMin () : Int64 = -4611686018427387904L
let __smallMax () : Int64 = 4611686018427387903L

let __word (value: Int) : Int64 = __int_to_word value
let __fromWord (value: Int64) : Int = __word_to_int value
let __isSmall (value: Int) : Bool = Stdlib.Int64.bitwiseAnd (Stdlib.Int.__word value) 1L == 1L
let __smallValue (value: Int) : Int64 = Stdlib.Int64.shiftRight (Stdlib.Int.__word value) 1L
let __small (value: Int64) : Int = Stdlib.Int.__fromWord (value * 2L + 1L)
let __zero () : Int = Stdlib.Int.__small 0L
let __one () : Int = Stdlib.Int.__small 1L
let __ptr (value: Int) : RawPtr = __int_to_rawptr value

let __signedCount (value: Int) : Int64 =
    if Stdlib.Int.__isSmall value then
        let n = Stdlib.Int.__smallValue value in
        if n == 0L then 0L
        else
            let magnitude = if n < 0L then 0L - n else n in
            let count = if magnitude < Stdlib.Int.__base () then 1L else 2L in
            if n < 0L then 0L - count else count
    else __raw_get<Int64> (Stdlib.Int.__ptr value) 16L

let __absCount (value: Int) : Int64 =
    let count = Stdlib.Int.__signedCount value in
    if count < 0L then 0L - count else count

let __isNegative (value: Int) : Bool = Stdlib.Int.__signedCount value < 0L
let __smallMagnitude (value: Int64) : Int64 = if value < 0L then 0L - value else value

let __limb (value: Int) (index: Int64) : Int64 =
    if index < 0L || index >= Stdlib.Int.__absCount value then 0L
    else if Stdlib.Int.__isSmall value then
        let magnitude = Stdlib.Int.__smallMagnitude (Stdlib.Int.__smallValue value) in
        if index == 0L then magnitude % Stdlib.Int.__base () else magnitude / Stdlib.Int.__base ()
    else __raw_get<Int64> (Stdlib.Int.__ptr value) (24L + index * 8L)

let __allocate (negative: Bool) (used: Int64) (capacity: Int64) : RawPtr =
    let ptr = __raw_alloc (24L + capacity * 8L) in
    let _ = __raw_write_word ptr 0L 1L in
    let _ = __raw_write_word ptr 8L (8L + capacity * 8L) in
    let _ = __raw_write_word ptr 16L (if negative then 0L - used else used) in
    ptr

let __trimPtr (ptr: RawPtr) (count: Int64) : Int64 =
    if count <= 0L then 0L
    else if __raw_get<Int64> ptr (24L + (count - 1L) * 8L) == 0L then Stdlib.Int.__trimPtr ptr (count - 1L)
    else count

let __adopt (ptr: RawPtr) (negative: Bool) (candidateCount: Int64) : Int =
    let used = Stdlib.Int.__trimPtr ptr candidateCount in
    let _ = __raw_write_word ptr 16L (if negative && used > 0L then 0L - used else used) in
    __rawptr_to_int ptr

let __magnitudeCompareAt (a: Int) (b: Int) (index: Int64) : Int64 =
    if index < 0L then 0L
    else
        let av = Stdlib.Int.__limb a index in
        let bv = Stdlib.Int.__limb b index in
        if av < bv then -1L else if av > bv then 1L else Stdlib.Int.__magnitudeCompareAt a b (index - 1L)

let __compareMagnitude (a: Int) (b: Int) : Int64 =
    let ac = Stdlib.Int.__absCount a in
    let bc = Stdlib.Int.__absCount b in
    if ac < bc then -1L else if ac > bc then 1L else Stdlib.Int.__magnitudeCompareAt a b (ac - 1L)

let __compare (a: Int) (b: Int) : Int64 =
    if Stdlib.Int.__isSmall a && Stdlib.Int.__isSmall b then
        let av = Stdlib.Int.__smallValue a in
        let bv = Stdlib.Int.__smallValue b in
        if av < bv then -1L else if av > bv then 1L else 0L
    else
        let an = Stdlib.Int.__isNegative a in
        let bn = Stdlib.Int.__isNegative b in
        if an && Stdlib.Bool.not bn then -1L
        else if Stdlib.Bool.not an && bn then 1L
        else
            let magnitude = Stdlib.Int.__compareMagnitude a b in
            if an then 0L - magnitude else magnitude

let __equals (a: Int) (b: Int) : Bool = Stdlib.Int.__compare a b == 0L
let __lessThan (a: Int) (b: Int) : Bool = Stdlib.Int.__compare a b < 0L
let __lessThanOrEqualTo (a: Int) (b: Int) : Bool = Stdlib.Int.__compare a b <= 0L
let __greaterThan (a: Int) (b: Int) : Bool = Stdlib.Int.__compare a b > 0L
let __greaterThanOrEqualTo (a: Int) (b: Int) : Bool = Stdlib.Int.__compare a b >= 0L

let __addMagnitudeAt (a: Int) (b: Int) (ptr: RawPtr) (index: Int64) (count: Int64) (carry: Int64) : Int64 =
    if index >= count then carry
    else
        let total = Stdlib.Int.__limb a index + Stdlib.Int.__limb b index + carry in
        let _ = __raw_write_word ptr (24L + index * 8L) (total % Stdlib.Int.__base ()) in
        Stdlib.Int.__addMagnitudeAt a b ptr (index + 1L) count (total / Stdlib.Int.__base ())

let __addMagnitudes (a: Int) (b: Int) (negative: Bool) : Int =
    let count = Stdlib.Int64.max (Stdlib.Int.__absCount a) (Stdlib.Int.__absCount b) in
    let ptr = Stdlib.Int.__allocate negative (count + 1L) (count + 1L) in
    let carry = Stdlib.Int.__addMagnitudeAt a b ptr 0L count 0L in
    let _ = __raw_write_word ptr (24L + count * 8L) carry in
    Stdlib.Int.__adopt ptr negative (count + 1L)

let __subtractMagnitudeAt (a: Int) (b: Int) (ptr: RawPtr) (index: Int64) (count: Int64) (borrow: Int64) : Unit =
    if index >= count then ()
    else
        let raw = Stdlib.Int.__limb a index - Stdlib.Int.__limb b index - borrow in
        let needsBorrow = raw < 0L in
        let _ = __raw_write_word ptr (24L + index * 8L) (if needsBorrow then raw + Stdlib.Int.__base () else raw) in
        Stdlib.Int.__subtractMagnitudeAt a b ptr (index + 1L) count (if needsBorrow then 1L else 0L)

let __subtractMagnitudes (larger: Int) (smaller: Int) (negative: Bool) : Int =
    let count = Stdlib.Int.__absCount larger in
    let ptr = Stdlib.Int.__allocate negative count count in
    let _ = Stdlib.Int.__subtractMagnitudeAt larger smaller ptr 0L count 0L in
    Stdlib.Int.__adopt ptr negative count

let __smallAddFits (a: Int64) (b: Int64) : Bool =
    if b > 0L then a <= Stdlib.Int.__smallMax () - b
    else if b < 0L then a >= Stdlib.Int.__smallMin () - b
    else true

let __add (a: Int) (b: Int) : Int =
    if Stdlib.Int.__isSmall a && Stdlib.Int.__isSmall b && Stdlib.Int.__smallAddFits (Stdlib.Int.__smallValue a) (Stdlib.Int.__smallValue b) then
        Stdlib.Int.__small (Stdlib.Int.__smallValue a + Stdlib.Int.__smallValue b)
    else
        let an = Stdlib.Int.__isNegative a in
        let bn = Stdlib.Int.__isNegative b in
        if an == bn then Stdlib.Int.__addMagnitudes a b an
        else
            let comparison = Stdlib.Int.__compareMagnitude a b in
            if comparison == 0L then Stdlib.Int.__zero ()
            else if comparison > 0L then Stdlib.Int.__subtractMagnitudes a b an
            else Stdlib.Int.__subtractMagnitudes b a bn

let __copyLimbs (value: Int) (ptr: RawPtr) (index: Int64) (count: Int64) : Unit =
    if index >= count then ()
    else
        let _ = __raw_write_word ptr (24L + index * 8L) (Stdlib.Int.__limb value index) in
        Stdlib.Int.__copyLimbs value ptr (index + 1L) count

let __negate (value: Int) : Int =
    if Stdlib.Int.__isSmall value then
        let n = Stdlib.Int.__smallValue value in
        if n != Stdlib.Int.__smallMin () then Stdlib.Int.__small (0L - n)
        else
            let ptr = Stdlib.Int.__allocate false 2L 2L in
            let _ = __raw_write_word ptr 24L 0L in
            let _ = __raw_write_word ptr 32L 2147483648L in
            Stdlib.Int.__adopt ptr false 2L
    else
        let count = Stdlib.Int.__absCount value in
        let negative = Stdlib.Bool.not (Stdlib.Int.__isNegative value) in
        let ptr = Stdlib.Int.__allocate negative count count in
        let _ = Stdlib.Int.__copyLimbs value ptr 0L count in
        Stdlib.Int.__adopt ptr negative count

let __subtract (a: Int) (b: Int) : Int = Stdlib.Int.__add a (Stdlib.Int.__negate b)

let __zeroWords (ptr: RawPtr) (index: Int64) (count: Int64) : Unit =
    if index >= count then ()
    else
        let _ = __raw_write_word ptr (24L + index * 8L) 0L in
        Stdlib.Int.__zeroWords ptr (index + 1L) count

let __multiplyRow (aLimb: Int64) (b: Int) (ptr: RawPtr) (outputOffset: Int64) (index: Int64) (count: Int64) (carry: Int64) : Unit =
    if index >= count then __raw_write_word ptr (24L + (outputOffset + count) * 8L) carry
    else
        let outputIndex = outputOffset + index in
        let total = __raw_get<Int64> ptr (24L + outputIndex * 8L) + aLimb * Stdlib.Int.__limb b index + carry in
        let _ = __raw_write_word ptr (24L + outputIndex * 8L) (total % Stdlib.Int.__base ()) in
        Stdlib.Int.__multiplyRow aLimb b ptr outputOffset (index + 1L) count (total / Stdlib.Int.__base ())

let __multiplyRows (a: Int) (b: Int) (ptr: RawPtr) (index: Int64) (count: Int64) : Unit =
    if index >= count then ()
    else
        let _ = Stdlib.Int.__multiplyRow (Stdlib.Int.__limb a index) b ptr index 0L (Stdlib.Int.__absCount b) 0L in
        Stdlib.Int.__multiplyRows a b ptr (index + 1L) count

let __smallMultiplyFits (a: Int64) (b: Int64) : Bool =
    if a == 0L || b == 0L then true
    else
        let am = Stdlib.Int.__smallMagnitude a in
        let bm = Stdlib.Int.__smallMagnitude b in
        let limit = if (a < 0L) != (b < 0L) then 4611686018427387904L else Stdlib.Int.__smallMax () in
        am <= limit / bm

let __multiply (a: Int) (b: Int) : Int =
    if Stdlib.Int.__equals a (Stdlib.Int.__zero ()) || Stdlib.Int.__equals b (Stdlib.Int.__zero ()) then Stdlib.Int.__zero ()
    else if Stdlib.Int.__isSmall a && Stdlib.Int.__isSmall b && Stdlib.Int.__smallMultiplyFits (Stdlib.Int.__smallValue a) (Stdlib.Int.__smallValue b) then
        Stdlib.Int.__small (Stdlib.Int.__smallValue a * Stdlib.Int.__smallValue b)
    else
        let ac = Stdlib.Int.__absCount a in
        let bc = Stdlib.Int.__absCount b in
        let count = ac + bc in
        let negative = Stdlib.Int.__isNegative a != Stdlib.Int.__isNegative b in
        let ptr = Stdlib.Int.__allocate negative count count in
        let _ = Stdlib.Int.__zeroWords ptr 0L count in
        let _ = Stdlib.Int.__multiplyRows a b ptr 0L ac in
        Stdlib.Int.__adopt ptr negative count

let __pow2Int64 (amount: Int64) : Int64 = Stdlib.Int64.shiftLeft 1L amount

let __shiftLeftWords (value: Int) (ptr: RawPtr) (wordShift: Int64) (bitShift: Int64) (index: Int64) (count: Int64) (carry: Int64) : Unit =
    if index >= count then __raw_write_word ptr (24L + (wordShift + count) * 8L) carry
    else
        let total = Stdlib.Int.__limb value index * Stdlib.Int.__pow2Int64 bitShift + carry in
        let _ = __raw_write_word ptr (24L + (wordShift + index) * 8L) (total % Stdlib.Int.__base ()) in
        Stdlib.Int.__shiftLeftWords value ptr wordShift bitShift (index + 1L) count (total / Stdlib.Int.__base ())

let __shiftLeftByInt64 (value: Int) (count: Int64) : Int =
    if count == 0L || Stdlib.Int.__equals value (Stdlib.Int.__zero ()) then value
    else
        let wordShift = count / 31L in
        let bitShift = count % 31L in
        let sourceCount = Stdlib.Int.__absCount value in
        let resultCount = sourceCount + wordShift + 1L in
        let ptr = Stdlib.Int.__allocate (Stdlib.Int.__isNegative value) resultCount resultCount in
        let _ = Stdlib.Int.__zeroWords ptr 0L wordShift in
        let _ = Stdlib.Int.__shiftLeftWords value ptr wordShift bitShift 0L sourceCount 0L in
        Stdlib.Int.__adopt ptr (Stdlib.Int.__isNegative value) resultCount

let __shiftRightWrite (value: Int) (ptr: RawPtr) (wordShift: Int64) (bitShift: Int64) (index: Int64) (carry: Int64) : Unit =
    if index < 0L then ()
    else
        let divisor = Stdlib.Int.__pow2Int64 bitShift in
        let combined = carry * Stdlib.Int.__base () + Stdlib.Int.__limb value (index + wordShift) in
        let _ = __raw_write_word ptr (24L + index * 8L) (combined / divisor) in
        Stdlib.Int.__shiftRightWrite value ptr wordShift bitShift (index - 1L) (combined % divisor)

let __shiftRightMagnitudeByInt64 (value: Int) (count: Int64) : Int =
    let wordShift = count / 31L in
    let bitShift = count % 31L in
    let sourceCount = Stdlib.Int.__absCount value in
    if wordShift >= sourceCount then Stdlib.Int.__zero ()
    else
        let resultCount = sourceCount - wordShift in
        let ptr = Stdlib.Int.__allocate false resultCount resultCount in
        let _ = Stdlib.Int.__shiftRightWrite value ptr wordShift bitShift (resultCount - 1L) 0L in
        Stdlib.Int.__adopt ptr false resultCount

let __hasDiscardedLimbs (value: Int) (index: Int64) : Bool =
    if index < 0L then false
    else if Stdlib.Int.__limb value index != 0L then true
    else Stdlib.Int.__hasDiscardedLimbs value (index - 1L)

let __hasDiscardedBits (value: Int) (count: Int64) : Bool =
    let words = count / 31L in
    let bits = count % 31L in
    Stdlib.Int.__hasDiscardedLimbs value (words - 1L)
    || (bits > 0L && Stdlib.Int64.bitwiseAnd (Stdlib.Int.__limb value words) (Stdlib.Int.__pow2Int64 bits - 1L) != 0L)

let __shiftRightByInt64 (value: Int) (count: Int64) : Int =
    if count == 0L || Stdlib.Int.__equals value (Stdlib.Int.__zero ()) then value
    else
        let magnitude = Stdlib.Int.__shiftRightMagnitudeByInt64 value count in
        if Stdlib.Int.__isNegative value then
            let rounded = if Stdlib.Int.__hasDiscardedBits value count then Stdlib.Int.__add magnitude (Stdlib.Int.__one ()) else magnitude in
            Stdlib.Int.__negate rounded
        else magnitude

let __bitLengthTop (limb: Int64) (bits: Int64) : Int64 = if limb <= 1L then bits else Stdlib.Int.__bitLengthTop (limb / 2L) (bits + 1L)
let __bitLength (value: Int) : Int64 =
    let count = Stdlib.Int.__absCount value in
    if count == 0L then 0L else (count - 1L) * 31L + Stdlib.Int.__bitLengthTop (Stdlib.Int.__limb value (count - 1L)) 1L

let __dividePositiveLoop (shifted: Int) (shift: Int64) (quotient: Int) (remainder: Int) : (Int * Int) =
    if shift < 0L then (quotient, remainder)
    else
        let take = Stdlib.Int.__compareMagnitude remainder shifted >= 0L in
        let nextRemainder = if take then Stdlib.Int.__subtractMagnitudes remainder shifted false else remainder in
        let nextQuotient = if take then Stdlib.Int.__add quotient (Stdlib.Int.__shiftLeftByInt64 (Stdlib.Int.__one ()) shift) else quotient in
        Stdlib.Int.__dividePositiveLoop (Stdlib.Int.__shiftRightMagnitudeByInt64 shifted 1L) (shift - 1L) nextQuotient nextRemainder

let __dividePositive (dividend: Int) (divisor: Int) : (Int * Int) =
    if Stdlib.Int.__compareMagnitude dividend divisor < 0L then
        let magnitude = if Stdlib.Int.__isNegative dividend then Stdlib.Int.__negate dividend else dividend in
        (Stdlib.Int.__zero (), magnitude)
    else
        let shift = Stdlib.Int.__bitLength dividend - Stdlib.Int.__bitLength divisor in
        Stdlib.Int.__dividePositiveLoop (Stdlib.Int.__shiftLeftByInt64 divisor shift) shift (Stdlib.Int.__zero ()) dividend

let __divide (a: Int) (b: Int) : Int =
    if Stdlib.Int.__equals b (Stdlib.Int.__zero ()) then Builtin.crash "Cannot divide by 0"
    else
        let negative = Stdlib.Int.__isNegative a != Stdlib.Int.__isNegative b in
        let quotient = Stdlib.Tuple2.first (Stdlib.Int.__dividePositive a b) in
        if negative then Stdlib.Int.__negate quotient else quotient

let __remainder (a: Int) (b: Int) : Stdlib.Result.Result<Int, String> =
    if Stdlib.Int.__equals b (Stdlib.Int.__zero ()) then Error "Cannot divide by 0"
    else
        let negative = Stdlib.Int.__isNegative a in
        let result = Stdlib.Tuple2.second (Stdlib.Int.__dividePositive a b) in
        Ok (if negative then Stdlib.Int.__negate result else result)

let __mod (value: Int) (modulus: Int) : Int =
    if Stdlib.Int.__equals modulus (Stdlib.Int.__zero ()) then Builtin.crash "Cannot evaluate modulus against 0"
    else if Stdlib.Int.__isNegative modulus then Builtin.crash "Cannot evaluate modulus against a negative number"
    else
        match Stdlib.Int.__remainder value modulus with
        | Error message -> Builtin.crash message
        | Ok result -> if Stdlib.Int.__isNegative result then Stdlib.Int.__add result modulus else result

let __powerLoop (base: Int) (exponent: Int) (result: Int) : Int =
    if Stdlib.Int.__equals exponent (Stdlib.Int.__zero ()) then result
    else
        let next = if Stdlib.Int64.bitwiseAnd (Stdlib.Int.__limb exponent 0L) 1L == 1L then Stdlib.Int.__multiply result base else result in
        Stdlib.Int.__powerLoop (Stdlib.Int.__multiply base base) (Stdlib.Int.__shiftRightMagnitudeByInt64 exponent 1L) next

let __power (base: Int) (exponent: Int) : Int =
    if Stdlib.Int.__isNegative exponent then Builtin.crash "Cannot raise an Int to a negative exponent"
    else Stdlib.Int.__powerLoop base exponent (Stdlib.Int.__one ())

let __bitwisePositiveAt (op: Int64) (a: Int) (b: Int) (ptr: RawPtr) (index: Int64) (count: Int64) : Unit =
    if index >= count then ()
    else
        let av = Stdlib.Int.__limb a index in
        let bv = Stdlib.Int.__limb b index in
        let result = if op == 0L then Stdlib.Int64.bitwiseAnd av bv else if op == 1L then Stdlib.Int64.bitwiseOr av bv else Stdlib.Int64.bitwiseXor av bv in
        let _ = __raw_write_word ptr (24L + index * 8L) result in
        Stdlib.Int.__bitwisePositiveAt op a b ptr (index + 1L) count

let __bitwisePositive (op: Int64) (a: Int) (b: Int) : Int =
    let count = if op == 0L then Stdlib.Int64.min (Stdlib.Int.__absCount a) (Stdlib.Int.__absCount b) else Stdlib.Int64.max (Stdlib.Int.__absCount a) (Stdlib.Int.__absCount b) in
    if count == 0L then Stdlib.Int.__zero ()
    else
        let ptr = Stdlib.Int.__allocate false count count in
        let _ = Stdlib.Int.__bitwisePositiveAt op a b ptr 0L count in
        Stdlib.Int.__adopt ptr false count

let __bitwiseNot (value: Int) : Int = Stdlib.Int.__negate (Stdlib.Int.__add value (Stdlib.Int.__one ()))
let __bitwiseAnd (a: Int) (b: Int) : Int =
    let an = Stdlib.Int.__isNegative a in
    let bn = Stdlib.Int.__isNegative b in
    let ap = if an then Stdlib.Int.__bitwiseNot a else a in
    let bp = if bn then Stdlib.Int.__bitwiseNot b else b in
    if Stdlib.Bool.not an && Stdlib.Bool.not bn then Stdlib.Int.__bitwisePositive 0L ap bp
    else if an && bn then Stdlib.Int.__bitwiseNot (Stdlib.Int.__bitwisePositive 1L ap bp)
    else if an then Stdlib.Int.__bitwisePositive 2L bp (Stdlib.Int.__bitwisePositive 0L ap bp)
    else Stdlib.Int.__bitwisePositive 2L ap (Stdlib.Int.__bitwisePositive 0L ap bp)

let __bitwiseOr (a: Int) (b: Int) : Int = Stdlib.Int.__bitwiseNot (Stdlib.Int.__bitwiseAnd (Stdlib.Int.__bitwiseNot a) (Stdlib.Int.__bitwiseNot b))
let __bitwiseXor (a: Int) (b: Int) : Int =
    let an = Stdlib.Int.__isNegative a in
    let bn = Stdlib.Int.__isNegative b in
    let ap = if an then Stdlib.Int.__bitwiseNot a else a in
    let bp = if bn then Stdlib.Int.__bitwiseNot b else b in
    let result = Stdlib.Int.__bitwisePositive 2L ap bp in
    if an == bn then result else Stdlib.Int.__bitwiseNot result

let __validateShiftCount (count: Int) : Int64 =
    match Stdlib.Int.__toInt64 count with
    | Some value when value >= 0L && value <= 2147483647L -> value
    | _ -> Builtin.crash "Encountered out-of-range value for type of Int"

let __shiftLeft (value: Int) (count: Int) : Int = Stdlib.Int.__shiftLeftByInt64 value (Stdlib.Int.__validateShiftCount count)
let __shiftRight (value: Int) (count: Int) : Int = Stdlib.Int.__shiftRightByInt64 value (Stdlib.Int.__validateShiftCount count)

let __zeros (count: Int64) (acc: String) : String = if count <= 0L then acc else Stdlib.Int.__zeros (count - 1L) (__string_concat_raw "0" acc)
let __padChunk (value: Int64) : String =
    let text = Stdlib.Int64.toString value in
    __string_concat_raw (Stdlib.Int.__zeros (9L - Stdlib.String.__byteLength text) "") text

let __divideMagnitudeBySmallAt (value: Int) (ptr: RawPtr) (divisor: Int64) (index: Int64) (remainder: Int64) : Int64 =
    if index < 0L then remainder
    else
        let combined = remainder * Stdlib.Int.__base () + Stdlib.Int.__limb value index in
        let _ = __raw_write_word ptr (24L + index * 8L) (combined / divisor) in
        Stdlib.Int.__divideMagnitudeBySmallAt value ptr divisor (index - 1L) (combined % divisor)

let __divideMagnitudeBySmall (value: Int) (divisor: Int64) : (Int * Int64) =
    let count = Stdlib.Int.__absCount value in
    let ptr = Stdlib.Int.__allocate false count count in
    let remainder = Stdlib.Int.__divideMagnitudeBySmallAt value ptr divisor (count - 1L) 0L in
    (Stdlib.Int.__adopt ptr false count, remainder)

let __formatMagnitude (value: Int) (acc: String) : String =
    let step = Stdlib.Int.__divideMagnitudeBySmall value 1000000000L in
    let quotient = Stdlib.Tuple2.first step in
    let remainder = Stdlib.Tuple2.second step in
    if Stdlib.Int.__equals quotient (Stdlib.Int.__zero ()) then __string_concat_raw (Stdlib.Int64.toString remainder) acc
    else Stdlib.Int.__formatMagnitude quotient (__string_concat_raw (Stdlib.Int.__padChunk remainder) acc)

let __toString (value: Int) : String =
    if Stdlib.Int.__isSmall value then Stdlib.Int64.toString (Stdlib.Int.__smallValue value)
    else
        let text = Stdlib.Int.__formatMagnitude value "" in
        if Stdlib.Int.__isNegative value then __string_concat_raw "-" text else text

let __text (value: Int) : String = Stdlib.Int.__toString value
let __dropLeadingZeros (value: String) (index: Int64) : String =
    let length = Stdlib.String.__byteLength value in
    if index >= length then "0"
    else if Stdlib.String.__byteAtUnchecked value index == 48L then Stdlib.Int.__dropLeadingZeros value (index + 1L)
    else Stdlib.String.__byteDrop value index
let __normalizeMagnitude (value: String) : String = Stdlib.Int.__dropLeadingZeros value 0L
let __validDigits (value: String) (index: Int64) : Bool =
    if index >= Stdlib.String.__byteLength value then true
    else
        let digit = Stdlib.String.__byteAtUnchecked value index in
        digit >= 48L && digit <= 57L && Stdlib.Int.__validDigits value (index + 1L)

let __parseDigits (value: String) (index: Int64) (acc: Int) : Int =
    if index >= Stdlib.String.__byteLength value then acc
    else
        let digit = Stdlib.String.__byteAtUnchecked value index - 48L in
        Stdlib.Int.__parseDigits value (index + 1L) (Stdlib.Int.__add (Stdlib.Int.__multiply acc (Stdlib.Int.__small 10L)) (Stdlib.Int.__small digit))

let __parse (value: String) : Stdlib.Result.Result<Int, Bool> =
    let input = Stdlib.String.trim value in
    let length = Stdlib.String.__byteLength input in
    if length == 0L then Error false
    else
        let first = Stdlib.String.__byteAtUnchecked input 0L in
        let negative = first == 45L in
        let hasSign = negative || first == 43L in
        let start = if hasSign then 1L else 0L in
        if start == length || Stdlib.Bool.not (Stdlib.Int.__validDigits input start) then Error false
        else
            let magnitude = Stdlib.Int.__parseDigits input start (Stdlib.Int.__zero ()) in
            Ok (if negative then Stdlib.Int.__negate magnitude else magnitude)

let __value (value: String) : Int =
    match Stdlib.Int.__parse value with
    | Ok parsed -> parsed
    | Error _ -> Builtin.crash "Invalid internal Int literal"

