// Stdlib/Dict.dark - Generic persistent dictionary operations.

module Stdlib.Dict

val empty = Dict { }

let isEmpty<'k, 'v> (dict: Dict<k, v>) : Bool =
    __dict_is_null<k, v> dict

let singleton<'k, 'v> (key: k) (value: v) : Dict<k, v> =
    Stdlib.Dict.__setOverwriting<k, v> (Stdlib.Dict.__empty<k, v> ()) key value

let size<'k, 'v> (dict: Dict<k, v>) : Int =
    Stdlib.Int.fromInt64 (Stdlib.Dict.__size<k, v> dict)

let get<'k, 'v> (dict: Dict<k, v>) (key: k) : Stdlib.Option.Option<v> =
    Stdlib.Dict.__get<k, v> dict key

let set<'k, 'v> (dict: Dict<k, v>) (key: k) (value: v) : Dict<k, v> =
    if Stdlib.Dict.__contains<k, v> dict key then
        Builtin.testRuntimeError "Cannot add two dictionary entries with the same key"
    else
        Stdlib.Dict.__setOverwriting<k, v> dict key value

let setOverridingDuplicates<'k, 'v> (dict: Dict<k, v>) (key: k) (value: v) : Dict<k, v> =
    Stdlib.Dict.__setOverwriting<k, v> dict key value

let remove<'k, 'v> (dict: Dict<k, v>) (key: k) : Dict<k, v> =
    Stdlib.Dict.__remove<k, v> dict key

let __toUtf16Units (codepoints: List<Int64>) : List<Int64> =
    match codepoints with
    | [] -> []
    | codepoint :: tail ->
        let rest = Stdlib.Dict.__toUtf16Units tail in
        if codepoint < 65536L then Stdlib.List.push rest codepoint
        else
            let supplementary = codepoint - 65536L in
            let highSurrogate = 55296L + Stdlib.Int64.shiftRight supplementary 10L in
            let lowSurrogate = 56320L + Stdlib.Int64.bitwiseAnd supplementary 1023L in
            [highSurrogate, lowSurrogate] @ rest

let __compareUtf16Units (left: List<Int64>) (right: List<Int64>) : Int32 =
    match (left, right) with
    | ([], []) -> 0l
    | ([], _) -> -1l
    | (_, []) -> 1l
    | (leftUnit :: leftTail, rightUnit :: rightTail) ->
        if leftUnit < rightUnit then -1l
        else if leftUnit > rightUnit then 1l
        else Stdlib.Dict.__compareUtf16Units leftTail rightTail

let __compareString (left: String) (right: String) : Int32 =
    Stdlib.Dict.__compareUtf16Units (Stdlib.Dict.__toUtf16Units (Stdlib.String.__toCodepoints left)) (Stdlib.Dict.__toUtf16Units (Stdlib.String.__toCodepoints right))

let __isIdentifierStart (byte: Int64) : Bool =
    (byte >= 65L && byte <= 90L) || (byte >= 97L && byte <= 122L) || byte == 95L

let __isIdentifierRest (byte: Int64) : Bool =
    Stdlib.Dict.__isIdentifierStart byte || (byte >= 48L && byte <= 57L) || byte == 39L

let __isIdentifierAt (key: String) (index: Int64) : Bool =
    if index >= Stdlib.String.__byteLength key then true
    else if Stdlib.Dict.__isIdentifierRest (Stdlib.String.__byteAtUnchecked key index) then
        Stdlib.Dict.__isIdentifierAt key (index + 1L)
    else false

let __renderKey (key: String) : String =
    if key == "" then "___"
    else if key != "___" && Stdlib.Dict.__isIdentifierStart (Stdlib.String.__byteAtUnchecked key 0L) && Stdlib.Dict.__isIdentifierAt key 1L then "" ++ key
    else "``" ++ key ++ "``"

let __copyKey (key: String) : String =
    Stdlib.String.__byteSlice key 0L (Stdlib.String.__byteLength key)

let __insertEntry<'k, 'v> (entry: (k * v)) (sorted: List<(k * v)>) : List<(k * v)> =
    match sorted with
    | [] -> [entry]
    | head :: tail ->
        if __compare<k> (entry.0) (head.0) < 0L then Stdlib.List.push sorted entry
        else Stdlib.List.push (Stdlib.Dict.__insertEntry<k, v> entry tail) head

let __sortEntries<'k, 'v> (entries: List<(k * v)>) (sorted: List<(k * v)>) : List<(k * v)> =
    match entries with
    | [] -> sorted
    | head :: tail -> Stdlib.Dict.__sortEntries<k, v> tail (Stdlib.Dict.__insertEntry<k, v> head sorted)

let toList<'k, 'v> (dict: Dict<k, v>) : List<(k * v)> =
    Stdlib.Dict.__sortEntries (Stdlib.Dict.__entries<k, v> dict) []

let __keysFromEntries<'k, 'v> (entries: List<(k * v)>) : List<k> =
    match entries with
    | [] -> []
    | head :: tail -> Stdlib.List.push (Stdlib.Dict.__keysFromEntries<k, v> tail) (head.0)

let keys<'k, 'v> (dict: Dict<k, v>) : List<k> =
    Stdlib.Dict.__keysFromEntries<k, v> (Stdlib.Dict.toList<k, v> dict)

let __valuesFromEntries<'k, 'v> (entries: List<(k * v)>) : List<v> =
    match entries with
    | [] -> []
    | head :: tail -> Stdlib.List.push (Stdlib.Dict.__valuesFromEntries<k, v> tail) (head.1)

let values<'k, 'v> (dict: Dict<k, v>) : List<v> =
    Stdlib.Dict.__valuesFromEntries<k, v> (Stdlib.Dict.toList<k, v> dict)

let __fromListOverwritingPublic<'k, 'v> (entries: List<(k * v)>) (dict: Dict<k, v>) : Dict<k, v> =
    match entries with
    | [] -> dict
    | head :: tail ->
        Stdlib.Dict.__fromListOverwritingPublic<k, v> tail (Stdlib.Dict.__setOverwriting dict (head.0) (head.1))

let fromListOverwritingDuplicates<'k, 'v> (entries: List<(k * v)>) : Dict<k, v> =
    Stdlib.Dict.__fromListOverwritingPublic<k, v> entries (Stdlib.Dict.__empty<k, v> ())

let __fromListRejecting<'k, 'v> (entries: List<(k * v)>) (dict: Dict<k, v>) : Stdlib.Option.Option<Dict<k, v>> =
    match entries with
    | [] -> Some dict
    | head :: tail ->
        if Stdlib.Dict.__contains dict (head.0) then None
        else
            Stdlib.Dict.__fromListRejecting<k, v> tail (Stdlib.Dict.__setOverwriting dict (head.0) (head.1))

let fromList<'k, 'v> (entries: List<(k * v)>) : Stdlib.Option.Option<Dict<k, v>> =
    Stdlib.Dict.__fromListRejecting<k, v> entries (Stdlib.Dict.__empty<k, v> ())

let member<'k, 'v> (dict: Dict<k, v>) (key: k) : Bool =
    Stdlib.Dict.__contains<k, v> dict key

let __mergeEntries<'k, 'v> (entries: List<(k * v)>) (result: Dict<k, v>) : Dict<k, v> =
    match entries with
    | [] -> result
    | head :: tail ->
        Stdlib.Dict.__mergeEntries<k, v> tail (Stdlib.Dict.__setOverwriting result (head.0) (head.1))

let merge<'k, 'v> (left: Dict<k, v>) (right: Dict<k, v>) : Dict<k, v> =
    Stdlib.Dict.__mergeEntries<k, v> (Stdlib.Dict.toList<k, v> right) left

let __mapEntries<'k, 'a, 'b> (entries: List<(k * a)>) (fn: k -> a -> b) (result: Dict<k, b>) : Dict<k, b> =
    match entries with
    | [] -> result
    | head :: tail ->
        Stdlib.Dict.__mapEntries<k, a, b> tail fn (Stdlib.Dict.__setOverwriting result (head.0) (fn (head.0)(head.1)))

let map<'k, 'a, 'b> (dict: Dict<k, a>) (fn: k -> a -> b) : Dict<k, b> =
    Stdlib.Dict.__mapEntries<k, a, b> (Stdlib.Dict.toList<k, a> dict) fn (Stdlib.Dict.__empty<k, b> ())

let __iterEntries<'k, 'a> (entries: List<(k * a)>) (fn: k -> a -> Unit) : Unit =
    match entries with
    | [] -> ()
    | head :: tail ->
        let _ = fn (head.0)(head.1) in
        Stdlib.Dict.__iterEntries<k, a> tail fn

let iter<'k, 'a> (dict: Dict<k, a>) (fn: k -> a -> Unit) : Unit =
    Stdlib.Dict.__iterEntries<k, a> (Stdlib.Dict.toList<k, a> dict) fn

let __filterEntries<'k, 'a> (entries: List<(k * a)>) (fn: k -> a -> Bool) (result: Dict<k, a>) : Dict<k, a> =
    match entries with
    | [] -> result
    | head :: tail ->
        let next =
            if fn (head.0)(head.1) then Stdlib.Dict.__setOverwriting result (head.0) (head.1)
            else result in
        Stdlib.Dict.__filterEntries<k, a> tail fn next

let filter<'k, 'a> (dict: Dict<k, a>) (fn: k -> a -> Bool) : Dict<k, a> =
    Stdlib.Dict.__filterEntries<k, a> (Stdlib.Dict.toList<k, a> dict) fn (Stdlib.Dict.__empty<k, a> ())

let __filterMapEntries<'k, 'a, 'b> (entries: List<(k * a)>) (fn: k -> a -> Stdlib.Option.Option<b>) (result: Dict<k, b>) : Dict<k, b> =
    match entries with
    | [] -> result
    | head :: tail ->
        let next =
            match fn (head.0)(head.1) with
            | None -> result
            | Some value -> Stdlib.Dict.__setOverwriting result (head.0) value in
        Stdlib.Dict.__filterMapEntries<k, a, b> tail fn next

let filterMap<'k, 'a, 'b> (dict: Dict<k, a>) (fn: k -> a -> Stdlib.Option.Option<b>) : Dict<k, b> =
    Stdlib.Dict.__filterMapEntries<k, a, b> (Stdlib.Dict.toList<k, a> dict) fn (Stdlib.Dict.__empty<k, b> ())
