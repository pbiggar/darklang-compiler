// Stdlib.String - NFC-normalized, extended-grapheme-cluster text operations.

module Stdlib.String

let newline() : String = "\n"

// Internal byte primitives. Public text functions never expose these indexes.
let __alignedDataSize(size: Int64) : Int64 = ((size + 7) / 8) * 8

let __byteLength(value: String) : Int64 =
    __raw_get<Int64>(__string_to_rawptr(value), 0)

let getByteAt(value: String, index: Int64) : Int64 =
    __raw_get_byte(__string_to_rawptr(value), index + 8)

let __copyBytesToPtr(source: String, sourceStart: Int64, destination: RawPtr, destinationStart: Int64, count: Int64) : Unit =
    if count <= 0 then ()
    else
        let _ = __raw_write_byte(destination, destinationStart, Stdlib.String.getByteAt(source, sourceStart)) in
        Stdlib.String.__copyBytesToPtr(source, sourceStart + 1, destination, destinationStart + 1, count - 1)

let __byteSlice(value: String, start_: Int64, end_: Int64) : String =
    let length = Stdlib.String.__byteLength(value) in
    let actualStart = if start_ < 0 then 0 else if start_ > length then length else start_ in
    let actualEnd = if end_ < actualStart then actualStart else if end_ > length then length else end_ in
    let resultLength = actualEnd - actualStart in
    if resultLength == 0 then ""
    else
        let dataSize = Stdlib.String.__alignedDataSize(resultLength) in
        let pointer = __raw_alloc(16 + dataSize) in
        let _ = __raw_write_word(pointer, 0, resultLength) in
        let _ = Stdlib.String.__copyBytesToPtr(value, actualStart, pointer, 8, resultLength) in
        let _ = __raw_write_word(pointer, 8 + dataSize, 1) in
        __rawptr_to_string(pointer)

let __byteTake(value: String, count: Int64) : String =
    Stdlib.String.__byteSlice(value, 0, count)

let __byteDrop(value: String, count: Int64) : String =
    Stdlib.String.__byteSlice(value, count, Stdlib.String.__byteLength(value))

let __isUtf8Boundary(value: String, index: Int64) : Bool =
    if index == 0 || index == Stdlib.String.__byteLength(value) then true
    else if index < 0 || index > Stdlib.String.__byteLength(value) then false
    else
        let byte = Stdlib.String.getByteAt(value, index) in
        byte < 128 || byte > 191

let substring(value: String, start_: Int64, end_: Int64) : String =
    let length = Stdlib.String.__byteLength(value) in
    let actualStart = if start_ < 0 then 0 else if start_ > length then length else start_ in
    let actualEnd = if end_ < actualStart then actualStart else if end_ > length then length else end_ in
    if Stdlib.String.__isUtf8Boundary(value, actualStart) && Stdlib.String.__isUtf8Boundary(value, actualEnd) then
        Unicode.normalizeValid(Stdlib.String.__byteSlice(value, actualStart, actualEnd))
    else Builtin.testRuntimeError("String byte index is not a UTF-8 scalar boundary")

let take(value: String, count: Int64) : String = Stdlib.String.substring(value, 0, count)
let drop(value: String, count: Int64) : String = Stdlib.String.substring(value, count, Stdlib.String.__byteLength(value))

let __compareBytes(left: String, leftStart: Int64, right: String, rightStart: Int64, count: Int64) : Bool =
    if count <= 0 then true
    else if Stdlib.String.getByteAt(left, leftStart) != Stdlib.String.getByteAt(right, rightStart) then false
    else Stdlib.String.__compareBytes(left, leftStart + 1, right, rightStart + 1, count - 1)

let __byteIndexOfFrom(value: String, search: String, offset: Int64) : Stdlib.Option.Option<Int64> =
    let valueLength = Stdlib.String.__byteLength(value) in
    let searchLength = Stdlib.String.__byteLength(search) in
    if searchLength == 0 then Some(offset)
    else if offset + searchLength > valueLength then None
    else if Stdlib.String.__compareBytes(value, offset, search, 0, searchLength) then Some(offset)
    else Stdlib.String.__byteIndexOfFrom(value, search, offset + 1)

let __byteIndexOf(value: String, search: String) : Stdlib.Option.Option<Int64> =
    Stdlib.String.__byteIndexOfFrom(value, search, 0)

let __byteLastIndexOfAt(value: String, search: String, offset: Int64) : Stdlib.Option.Option<Int64> =
    if offset < 0 then None
    else if Stdlib.String.__compareBytes(value, offset, search, 0, Stdlib.String.__byteLength(search)) then Some(offset)
    else Stdlib.String.__byteLastIndexOfAt(value, search, offset - 1)

let __byteLastIndexOf(value: String, search: String) : Stdlib.Option.Option<Int64> =
    let searchLength = Stdlib.String.__byteLength(search) in
    if searchLength == 0 then Some(Stdlib.String.__byteLength(value))
    else if searchLength > Stdlib.String.__byteLength(value) then None
    else Stdlib.String.__byteLastIndexOfAt(value, search, Stdlib.String.__byteLength(value) - searchLength)

let __utf8ByteLength(codepoint: Int64) : Int64 =
    if codepoint < 128 then 1 else if codepoint < 2048 then 2 else if codepoint < 65536 then 3 else 4

let __totalUtf8Length(codepoints: List<Int64>) : Int64 =
    match codepoints with
    | [] -> 0
    | codepoint :: rest -> Stdlib.String.__utf8ByteLength(codepoint) + Stdlib.String.__totalUtf8Length(rest)

let __encodeUtf8At(pointer: RawPtr, offset: Int64, codepoint: Int64) : Int64 =
    if codepoint < 128 then
        let _ = __raw_write_byte(pointer, offset, codepoint) in offset + 1
    else if codepoint < 2048 then
        let _ = __raw_write_byte(pointer, offset, 192 ^ (codepoint >> 6)) in
        let _ = __raw_write_byte(pointer, offset + 1, 128 ^ (codepoint & 63)) in offset + 2
    else if codepoint < 65536 then
        let _ = __raw_write_byte(pointer, offset, 224 ^ (codepoint >> 12)) in
        let _ = __raw_write_byte(pointer, offset + 1, 128 ^ ((codepoint >> 6) & 63)) in
        let _ = __raw_write_byte(pointer, offset + 2, 128 ^ (codepoint & 63)) in offset + 3
    else
        let _ = __raw_write_byte(pointer, offset, 240 ^ (codepoint >> 18)) in
        let _ = __raw_write_byte(pointer, offset + 1, 128 ^ ((codepoint >> 12) & 63)) in
        let _ = __raw_write_byte(pointer, offset + 2, 128 ^ ((codepoint >> 6) & 63)) in
        let _ = __raw_write_byte(pointer, offset + 3, 128 ^ (codepoint & 63)) in offset + 4

let __encodeCodepoints(pointer: RawPtr, offset: Int64, codepoints: List<Int64>) : Int64 =
    match codepoints with
    | [] -> offset
    | codepoint :: rest ->
        Stdlib.String.__encodeCodepoints(pointer, Stdlib.String.__encodeUtf8At(pointer, offset, codepoint), rest)

let __fromCodepointsRaw(codepoints: List<Int64>) : String =
    let byteLength = Stdlib.String.__totalUtf8Length(codepoints) in
    if byteLength == 0 then ""
    else
        let dataSize = Stdlib.String.__alignedDataSize(byteLength) in
        let pointer = __raw_alloc(16 + dataSize) in
        let _ = __raw_write_word(pointer, 0, byteLength) in
        let _ = Stdlib.String.__encodeCodepoints(pointer, 8, codepoints) in
        let _ = __raw_write_word(pointer, 8 + dataSize, 1) in
        __rawptr_to_string(pointer)

let __allScalars(codepoints: List<Int64>) : Bool =
    match codepoints with
    | [] -> true
    | codepoint :: rest -> Unicode.isScalar(codepoint) && Stdlib.String.__allScalars(rest)

let fromCodepoints(codepoints: List<Int64>) : String =
    if Stdlib.String.__allScalars(codepoints) then Unicode.normalizeValid(Stdlib.String.__fromCodepointsRaw(codepoints))
    else Builtin.testRuntimeError("Invalid Unicode scalar")

let toCodepoints(value: String) : List<Int64> =
    match Unicode.decode(value) with
    | Ok(codepoints) -> codepoints
    | Error(_) -> Builtin.testRuntimeError("Invalid UTF-8 string")

let codepointLength(value: String) : Int64 =
    Stdlib.Internal.SkewList.length<Int64>(Stdlib.String.toCodepoints(value))

let toGraphemes(value: String) : List<String> =
    Unicode.segmentUtf8(value, 0, [], "", [])

let __asciiGraphemeLengthAt(value: String, index: Int64, count: Int64, previous: Int64) : Int64 =
    if index >= Stdlib.String.__byteLength(value) then count
    else
        let byte = Stdlib.String.getByteAt(value, index) in
        let nextCount = if byte == 10 && previous == 13 then count else count + 1 in
        Stdlib.String.__asciiGraphemeLengthAt(value, index + 1, nextCount, byte)

let graphemeLength(value: String) : Int64 =
    if Stdlib.String.__isAscii(value) then Stdlib.String.__asciiGraphemeLengthAt(value, 0, 0, -1)
    else Unicode.graphemeCountUtf8(value, 0, [], 0)

let length(value: String) : Int =
    Stdlib.Int.fromInt64(Stdlib.String.graphemeLength(value))

let isEmpty(value: String) : Bool = Stdlib.String.__byteLength(value) == 0

let __intToInt64(value: Int) : Int64 =
    match Stdlib.Int.toInt64(value) with
    | Some(converted) -> converted
    | None -> Builtin.testRuntimeError("String index did not fit Int64")

let __asChar(value: String) : Char = value

let toList(value: String) : List<Char> =
    Stdlib.List.map<String, Char>(Stdlib.String.toGraphemes(value), Stdlib.String.__asChar)

let fromList(lst: List<Char>) : String =
    Unicode.normalizeValid(Stdlib.String.__joinChars(lst, ""))

let __isAsciiAt(value: String, index: Int64, length: Int64) : Bool =
    if index >= length then true
    else if Stdlib.String.getByteAt(value, index) >= 128 then false
    else Stdlib.String.__isAsciiAt(value, index + 1, length)

let __isAscii(value: String) : Bool =
    Stdlib.String.__isAsciiAt(value, 0, Stdlib.String.__byteLength(value))

let __appendNormalized(left: String, right: String) : String =
    let combined = __string_concat_raw(left, right) in
    // ASCII is closed under NFC, so avoid decoding and rebuilding the entire
    // accumulated string in the overwhelmingly common concatenation path.
    if Stdlib.String.__isAscii(left) && Stdlib.String.__isAscii(right) then combined
    else Unicode.normalizeValid(combined)

let __joinChars(chars: List<Char>, acc: String) : String =
    match chars with
    | [] -> acc
    | char :: rest -> Stdlib.String.__joinChars(rest, acc ++ Stdlib.Char.toString(char))

let fromChar(char: Char) : String = Stdlib.Char.toString(char)

let append(left: String, right: String) : String = Stdlib.String.__appendNormalized(left, right)
let prepend(right: String, left: String) : String = Stdlib.String.__appendNormalized(left, right)

let __join(strings: List<String>, separator: String, acc: String, first: Bool) : String =
    match strings with
    | [] -> Unicode.normalizeValid(acc)
    | value :: rest ->
        let next = if first then acc ++ value else acc ++ separator ++ value in
        Stdlib.String.__join(rest, separator, next, false)

let join(strings: List<String>, separator: String) : String =
    Stdlib.String.__join(strings, separator, "", true)

let repeat(value: String, count: Int) : String =
    let zero = Stdlib.Int.fromInt64(0) in
    if count <= zero then "" else Stdlib.String.__repeat(value, count, "")

let __repeat(value: String, remaining: Int, acc: String) : String =
    let zero = Stdlib.Int.fromInt64(0) in
    if remaining <= zero then Unicode.normalizeValid(acc)
    else Stdlib.String.__repeat(value, remaining - Stdlib.Int.fromInt64(1), acc ++ value)

let __sliceGraphemes(graphemes: List<String>, start_: Int, end_: Int) : String =
    Stdlib.String.join(
        Stdlib.List.take<String>(Stdlib.List.drop<String>(graphemes, start_), end_ - start_),
        "")

let slice(value: String, start_: Int, end_: Int) : String =
    let zero = Stdlib.Int.fromInt64(0) in
    let count = Stdlib.String.length(value) in
    let normalizedStart = if start_ < zero then count + start_ else start_ in
    let normalizedEnd = if end_ < zero then count + end_ else end_ in
    let actualStart = if normalizedStart < zero then zero else if normalizedStart > count then count else normalizedStart in
    let boundedEnd = if normalizedEnd < zero then zero else if normalizedEnd > count then count else normalizedEnd in
    let actualEnd = if boundedEnd < actualStart then actualStart else boundedEnd in
    Stdlib.String.__sliceGraphemes(Stdlib.String.toGraphemes(value), actualStart, actualEnd)

let first(value: String, count: Int) : String =
    let zero = Stdlib.Int.fromInt64(0) in
    if count < zero then "" else Stdlib.String.slice(value, zero, count)

let last(value: String, count: Int) : String =
    let zero = Stdlib.Int.fromInt64(0) in
    let length = Stdlib.String.length(value) in
    if count < zero then ""
    else if count >= length then value
    else Stdlib.String.slice(value, length - count, length)

let dropFirst(value: String, count: Int) : String =
    let zero = Stdlib.Int.fromInt64(0) in
    if count < zero then value else Stdlib.String.slice(value, count, Stdlib.String.length(value))

let dropLast(value: String, count: Int) : String =
    let zero = Stdlib.Int.fromInt64(0) in
    let length = Stdlib.String.length(value) in
    if count < zero then value
    else if count >= length then ""
    else Stdlib.String.slice(value, zero, length - count)

let head(value: String) : Stdlib.Option.Option<Char> =
    if Stdlib.String.isEmpty(value) then None
    else Some(Stdlib.String.__asChar(Stdlib.String.first(value, Stdlib.Int.fromInt64(1))))

let charAt(value: String, index: Int) : Stdlib.Option.Option<Char> =
    let zero = Stdlib.Int.fromInt64(0) in
    if index < zero || index >= Stdlib.String.length(value) then None
    else Some(Stdlib.String.__asChar(Stdlib.String.slice(value, index, index + Stdlib.Int.fromInt64(1))))

let map(value: String, fn: (Char) -> Char) : String =
    Stdlib.String.fromList(Stdlib.List.map<Char, Char>(Stdlib.String.toList(value), fn))

let reverse(value: String) : String =
    Stdlib.String.join(Stdlib.List.reverse<String>(Stdlib.String.toGraphemes(value)), "")

let toUppercase(value: String) : String = Unicode.uppercase(value)
let toUpperCase(value: String) : String = Unicode.uppercaseFull(value)
let toLowercase(value: String) : String = Unicode.lowercase(value)

let __startsWithList(values: List<String>, prefix: List<String>) : Bool =
    match prefix with
    | [] -> true
    | expected :: expectedRest ->
        match values with
        | [] -> false
        | actual :: actualRest -> actual == expected && Stdlib.String.__startsWithList(actualRest, expectedRest)

let startsWith(value: String, prefix: String) : Bool =
    Stdlib.String.__startsWithList(Stdlib.String.toGraphemes(value), Stdlib.String.toGraphemes(prefix))

let endsWith(value: String, suffix: String) : Bool =
    Stdlib.String.__startsWithList(
        Stdlib.List.reverse<String>(Stdlib.String.toGraphemes(value)),
        Stdlib.List.reverse<String>(Stdlib.String.toGraphemes(suffix)))

let contains(value: String, search: String) : Bool =
    Stdlib.Option.isSome<Int64>(Stdlib.String.__byteIndexOf(value, search))

let __utf16Length(codepoints: List<Int64>) : Int64 =
    match codepoints with
    | [] -> 0
    | codepoint :: rest -> (if codepoint <= 65535 then 1 else 2) + Stdlib.String.__utf16Length(rest)

let __utf16IndexAtByte(value: String, byteIndex: Int64) : Int =
    let prefix = Stdlib.String.__byteSlice(value, 0, byteIndex) in
    Stdlib.Int.fromInt64(Stdlib.String.__utf16Length(Stdlib.String.toCodepoints(prefix)))

let indexOf(value: String, search: String) : Stdlib.Option.Option<Int> =
    match Stdlib.String.__byteIndexOf(value, search) with
    | None -> None
    | Some(index) -> Some(Stdlib.String.__utf16IndexAtByte(value, index))

let lastIndexOf(value: String, search: String) : Stdlib.Option.Option<Int> =
    match Stdlib.String.__byteLastIndexOf(value, search) with
    | None -> None
    | Some(index) -> Some(Stdlib.String.__utf16IndexAtByte(value, index))

let __firstMatch(previous: Stdlib.Option.Option<Int>, index: Int) : Stdlib.Option.Option<Int> =
    match previous with
    | Some(value) -> Some(value)
    | None -> Some(index)

let __egcIndex(values: List<String>, search: List<String>, index: Int, first: Stdlib.Option.Option<Int>, last: Stdlib.Option.Option<Int>) : (Stdlib.Option.Option<Int>, Stdlib.Option.Option<Int>) =
    let matches = Stdlib.String.__startsWithList(values, search) in
    let nextFirst = if matches then Stdlib.String.__firstMatch(first, index) else first in
    let nextLast = if matches then Some(index) else last in
    match values with
    | [] -> (nextFirst, nextLast)
    | _head :: rest ->
        Stdlib.String.__egcIndex(rest, search, index + Stdlib.Int.fromInt64(1), nextFirst, nextLast)

let indexOfEgc(value: String, search: String) : Stdlib.Option.Option<Int> =
    let zero = Stdlib.Int.fromInt64(0) in
    if Stdlib.String.isEmpty(search) then Some(zero)
    else Stdlib.Tuple2.first<Stdlib.Option.Option<Int>, Stdlib.Option.Option<Int>>(
        Stdlib.String.__egcIndex(Stdlib.String.toGraphemes(value), Stdlib.String.toGraphemes(search), zero, None, None))

let lastIndexOfEgc(value: String, search: String) : Stdlib.Option.Option<Int> =
    if Stdlib.String.isEmpty(search) then Some(Stdlib.String.length(value))
    else Stdlib.Tuple2.second<Stdlib.Option.Option<Int>, Stdlib.Option.Option<Int>>(
        Stdlib.String.__egcIndex(
            Stdlib.String.toGraphemes(value),
            Stdlib.String.toGraphemes(search),
            Stdlib.Int.fromInt64(0),
            None,
            None))

let __splitGraphemes(values: List<String>, separator: List<String>, current: List<String>, result: List<String>) : List<String> =
    match values with
    | [] -> Stdlib.List.reverse<String>(Stdlib.List.push<String>(result, Stdlib.String.join(Stdlib.List.reverse<String>(current), "")))
    | head :: rest ->
        if Stdlib.String.__startsWithList(values, separator) then
            Stdlib.String.__splitGraphemes(
                Stdlib.List.drop<String>(values, Stdlib.List.length<String>(separator)),
                separator,
                [],
                Stdlib.List.push<String>(result, Stdlib.String.join(Stdlib.List.reverse<String>(current), "")))
        else Stdlib.String.__splitGraphemes(rest, separator, Stdlib.List.push<String>(current, head), result)

let split(value: String, separator: String) : List<String> =
    if Stdlib.String.isEmpty(separator) then Stdlib.String.toGraphemes(value)
    else Stdlib.String.__splitGraphemes(Stdlib.String.toGraphemes(value), Stdlib.String.toGraphemes(separator), [], [])

let splitFirst(value: String, separator: String) : Stdlib.Option.Option<(String, String)> =
    if Stdlib.String.isEmpty(separator) then None
    else
        match Stdlib.String.indexOfEgc(value, separator) with
        | None -> None
        | Some(index) ->
            Some((Stdlib.String.first(value, index), Stdlib.String.dropFirst(value, index + Stdlib.String.length(separator))))

let splitN(value: String, separator: String, count: Int) : List<String> =
    let one = Stdlib.Int.fromInt64(1) in
    if count <= one || Stdlib.String.isEmpty(separator) then [value]
    else
        match Stdlib.String.splitFirst(value, separator) with
        | None -> [value]
        | Some(parts) ->
            Stdlib.List.push<String>(
                Stdlib.String.splitN(Stdlib.Tuple2.second<String, String>(parts), separator, count - one),
                Stdlib.Tuple2.first<String, String>(parts))

let __replaceEmpty(graphemes: List<String>, replacement: String, acc: String) : String =
    match graphemes with
    | [] -> Unicode.normalizeValid(acc ++ replacement)
    | grapheme :: rest -> Stdlib.String.__replaceEmpty(rest, replacement, acc ++ replacement ++ grapheme)

let replaceAll(value: String, search: String, replacement: String) : String =
    if Stdlib.String.isEmpty(search) then Stdlib.String.__replaceEmpty(Stdlib.String.toGraphemes(value), replacement, "")
    else Stdlib.String.join(Stdlib.String.split(value, search), replacement)

let replace(value: String, search: String, replacement: String) : String =
    Stdlib.String.replaceAll(value, search, replacement)

let equals(left: String, right: String) : Bool =
    Stdlib.String.__byteLength(left) == Stdlib.String.__byteLength(right) &&
    Stdlib.String.__compareBytes(left, 0, right, 0, Stdlib.String.__byteLength(left))

let __egcWhitespace(grapheme: String) : Bool =
    match Stdlib.String.toCodepoints(grapheme) with
    | [codepoint] -> Unicode.isWhitespace(codepoint)
    | _ -> false

let __trimStart(graphemes: List<String>) : List<String> =
    match graphemes with
    | head :: rest -> if Stdlib.String.__egcWhitespace(head) then Stdlib.String.__trimStart(rest) else graphemes
    | [] -> []

let trimStart(value: String) : String =
    Stdlib.String.join(Stdlib.String.__trimStart(Stdlib.String.toGraphemes(value)), "")

let trimEnd(value: String) : String =
    Stdlib.String.join(
        Stdlib.List.reverse<String>(Stdlib.String.__trimStart(Stdlib.List.reverse<String>(Stdlib.String.toGraphemes(value)))),
        "")

let trim(value: String) : String = Stdlib.String.trimEnd(Stdlib.String.trimStart(value))

let padStart(value: String, padWith: String, goalLength: Int) : Stdlib.Result.Result<String, String> =
    if Stdlib.String.length(padWith) != Stdlib.Int.fromInt64(1) then
        Error("Expected `padWith` to be 1 character long, but it was `\"" ++ padWith ++ "\"`")
    else if Stdlib.String.length(value) >= goalLength then Ok(value)
    else Ok(Stdlib.String.repeat(padWith, goalLength - Stdlib.String.length(value)) ++ value)

let padEnd(value: String, padWith: String, goalLength: Int) : Stdlib.Result.Result<String, String> =
    if Stdlib.String.length(padWith) != Stdlib.Int.fromInt64(1) then
        Error("Expected `padWith` to be 1 character long, but it was `\"" ++ padWith ++ "\"`")
    else if Stdlib.String.length(value) >= goalLength then Ok(value)
    else Ok(value ++ Stdlib.String.repeat(padWith, goalLength - Stdlib.String.length(value)))

let ellipsis(value: String, goalLength: Int) : String =
    if Stdlib.String.length(value) > goalLength then Stdlib.String.slice(value, Stdlib.Int.fromInt64(0), goalLength) ++ "..."
    else value

let articleFor(nextWord: String) : String =
    match Stdlib.String.head(nextWord) with
    | None -> ""
    | Some(char) ->
        if Stdlib.String.length(nextWord) > Stdlib.Int.fromInt64(1) && !Stdlib.Char.isASCIILetter(char) then
            Stdlib.String.articleFor(Stdlib.String.dropFirst(nextWord, Stdlib.Int.fromInt64(1)))
        else if char == 'A' || char == 'E' || char == 'I' || char == 'O' || char == 'U' ||
                char == 'a' || char == 'e' || char == 'i' || char == 'o' || char == 'u' then "an"
        else "a"

let pluralize(word: String) : String =
    if Stdlib.String.endsWith(word, "ch") || Stdlib.String.endsWith(word, "sh") ||
       Stdlib.String.endsWith(word, "s") || Stdlib.String.endsWith(word, "x") || Stdlib.String.endsWith(word, "z") then
        word ++ "es"
    else word ++ "s"

let toOrdinal(value: Int) : String =
    let remainder = value % Stdlib.Int.fromInt64(10) in
    let suffix =
        if remainder == Stdlib.Int.fromInt64(1) then "st"
        else if remainder == Stdlib.Int.fromInt64(2) then "nd"
        else if remainder == Stdlib.Int.fromInt64(3) then "rd"
        else "th" in
    Stdlib.Int.toString(value) ++ suffix

let splitOnNewline(value: String) : List<String> =
    if Stdlib.String.isEmpty(value) then [] else Stdlib.String.split(value, "\n")

let htmlEscape(value: String) : String =
    Stdlib.String.join(
        Stdlib.List.map<Char, String>(Stdlib.String.toList(value), fun char ->
            if char == '<' then "&lt;"
            else if char == '>' then "&gt;"
            else if char == '&' then "&amp;"
            else if char == '"' then "&quot;"
            else if char == '\'' then "&#x27;"
            else Stdlib.Char.toString(char)),
        "")

let toBlob(value: String) : Blob = Stdlib.Blob.fromString(value)
let toBytes(value: String) : List<UInt8> = Stdlib.Blob.toList(Stdlib.String.toBlob(value))

let fromBlob(blob: Blob) : Stdlib.Option.Option<String> =
    match Stdlib.Blob.toString(blob) with
    | Ok(value) -> Some(Unicode.normalizeValid(value))
    | Error(_) -> None

let __decodeBlobWithReplacement(blob: Blob, index: Int64, acc: List<Int64>) : List<Int64> =
    let length = Stdlib.Bytes.length(blob) in
    if index >= length then Stdlib.List.reverse<Int64>(acc)
    else
        let b0 = Stdlib.Bytes.get(blob, index) in
        if b0 <= 127 then Stdlib.String.__decodeBlobWithReplacement(blob, index + 1, Stdlib.List.push<Int64>(acc, b0))
        else if b0 >= 194 && b0 <= 223 && index + 1 < length && Stdlib.Blob.__isContinuation(Stdlib.Bytes.get(blob, index + 1)) then
            let b1 = Stdlib.Bytes.get(blob, index + 1) in
            Stdlib.String.__decodeBlobWithReplacement(blob, index + 2, Stdlib.List.push<Int64>(acc, ((b0 & 31) << 6) ^ (b1 & 63)))
        else if b0 >= 224 && b0 <= 239 && index + 2 < length then
            let b1 = Stdlib.Bytes.get(blob, index + 1) in
            let b2 = Stdlib.Bytes.get(blob, index + 2) in
            if Stdlib.Blob.__isContinuation(b1) && Stdlib.Blob.__isContinuation(b2) && !(b0 == 224 && b1 < 160) && !(b0 == 237 && b1 >= 160) then
                Stdlib.String.__decodeBlobWithReplacement(blob, index + 3, Stdlib.List.push<Int64>(acc, ((b0 & 15) << 12) ^ ((b1 & 63) << 6) ^ (b2 & 63)))
            else Stdlib.String.__decodeBlobWithReplacement(blob, index + 1, Stdlib.List.push<Int64>(acc, 65533))
        else if b0 >= 240 && b0 <= 244 && index + 3 < length then
            let b1 = Stdlib.Bytes.get(blob, index + 1) in
            let b2 = Stdlib.Bytes.get(blob, index + 2) in
            let b3 = Stdlib.Bytes.get(blob, index + 3) in
            if Stdlib.Blob.__isContinuation(b1) && Stdlib.Blob.__isContinuation(b2) && Stdlib.Blob.__isContinuation(b3) && !(b0 == 240 && b1 < 144) && !(b0 == 244 && b1 >= 144) then
                Stdlib.String.__decodeBlobWithReplacement(blob, index + 4, Stdlib.List.push<Int64>(acc, ((b0 & 7) << 18) ^ ((b1 & 63) << 12) ^ ((b2 & 63) << 6) ^ (b3 & 63)))
            else Stdlib.String.__decodeBlobWithReplacement(blob, index + 1, Stdlib.List.push<Int64>(acc, 65533))
        else Stdlib.String.__decodeBlobWithReplacement(blob, index + 1, Stdlib.List.push<Int64>(acc, 65533))

let fromBlobWithReplacement(blob: Blob) : String =
    Unicode.normalizeValid(Stdlib.String.__fromCodepointsRaw(Stdlib.String.__decodeBlobWithReplacement(blob, 0, [])))

let fromBytes(bytes: List<UInt8>) : Stdlib.Option.Option<String> =
    Stdlib.String.fromBlob(Stdlib.Blob.fromList(bytes))

let fromBytesWithReplacement(bytes: List<UInt8>) : String =
    Stdlib.String.fromBlobWithReplacement(Stdlib.Blob.fromList(bytes))

let base64Encode(value: String) : String = Stdlib.Base64.encode(Stdlib.String.toBlob(value))

let base64UrlEncode(value: String) : String =
    Stdlib.String.replaceAll(Stdlib.Base64.urlEncode(Stdlib.String.toBlob(value)), "=", "")

let base64Decode(value: String) : Stdlib.Result.Result<String, String> =
    match Stdlib.Base64.decode(value) with
    | Error(error) -> Error(error)
    | Ok(blob) ->
        match Stdlib.String.fromBlob(blob) with
        | Some(decoded) -> Ok(decoded)
        | None -> Error("Invalid UTF-8 string")

let digest(value: String) : String =
    Stdlib.Base64.urlEncode(Stdlib.Crypto.sha384(Stdlib.String.toBlob(value)))

let __random(length: Int, acc: String) : String =
    let zero = Stdlib.Int.fromInt64(0) in
    if length <= zero then acc
    else
        let candidate = Stdlib.Random.int64() & 63 in
        if candidate >= 62 then Stdlib.String.__random(length, acc)
        else
            let alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789" in
            Stdlib.String.__random(
                length - Stdlib.Int.fromInt64(1),
                acc ++ Stdlib.String.__byteSlice(alphabet, candidate, candidate + 1))

let random(length: Int) : Stdlib.Result.Result<String, String> =
    let zero = Stdlib.Int.fromInt64(0) in
    if length < zero then Error("Expected `length` to be positive, but it was `" ++ Stdlib.Int.toString(length) ++ "`")
    else Ok(Stdlib.String.__random(length, ""))
