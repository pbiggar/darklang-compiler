// Stdlib.Base64.dark - Stdlib.Base64 definitions
//
// Split from stdlib.dark for modular stdlib loading.

module Stdlib.Base64

// Stdlib.Base64 - Base64 encoding and decoding
// =============================================================================
// Standard Base64 alphabet: A-Z, a-z, 0-9, +, /
// URL-safe alphabet: A-Z, a-z, 0-9, -, _

// Encoding lookup table (6-bit value -> character)
let __encodeChar(n: Int64) : String =
    match n with
    | 0L -> "A" | 1L -> "B" | 2L -> "C" | 3L -> "D" | 4L -> "E" | 5L -> "F"
    | 6L -> "G" | 7L -> "H" | 8L -> "I" | 9L -> "J" | 10L -> "K" | 11L -> "L"
    | 12L -> "M" | 13L -> "N" | 14L -> "O" | 15L -> "P" | 16L -> "Q" | 17L -> "R"
    | 18L -> "S" | 19L -> "T" | 20L -> "U" | 21L -> "V" | 22L -> "W" | 23L -> "X"
    | 24L -> "Y" | 25L -> "Z" | 26L -> "a" | 27L -> "b" | 28L -> "c" | 29L -> "d"
    | 30L -> "e" | 31L -> "f" | 32L -> "g" | 33L -> "h" | 34L -> "i" | 35L -> "j"
    | 36L -> "k" | 37L -> "l" | 38L -> "m" | 39L -> "n" | 40L -> "o" | 41L -> "p"
    | 42L -> "q" | 43L -> "r" | 44L -> "s" | 45L -> "t" | 46L -> "u" | 47L -> "v"
    | 48L -> "w" | 49L -> "x" | 50L -> "y" | 51L -> "z" | 52L -> "0" | 53L -> "1"
    | 54L -> "2" | 55L -> "3" | 56L -> "4" | 57L -> "5" | 58L -> "6" | 59L -> "7"
    | 60L -> "8" | 61L -> "9" | 62L -> "+" | 63L -> "/"
    | _ -> ""

// URL-safe encoding (uses - and _ instead of + and /)
let __encodeCharUrl(n: Int64) : String =
    if n == 62L then "-"
    else if n == 63L then "_"
    else Stdlib.Base64.__encodeChar(n)

// Decode lookup table (character -> 6-bit value, returns -1 for invalid)
let __decodeChar(c: Int64) : Int64 =
    if c >= 65L && c <= 90L then c - 65L      // A-Z -> 0-25
    else if c >= 97L && c <= 122L then c - 71L  // a-z -> 26-51
    else if c >= 48L && c <= 57L then c + 4L    // 0-9 -> 52-61
    else if c == 43L then 62L                   // + -> 62
    else if c == 47L then 63L                   // / -> 63
    else if c == 45L then 62L                   // - -> 62 (URL-safe)
    else if c == 95L then 63L                   // _ -> 63 (URL-safe)
    else if c == 61L then -2L                   // = -> padding
    else -1L                                   // Invalid

// Encode 3 bytes to 4 base64 characters
let __encode3Bytes(b0: Int64, b1: Int64, b2: Int64, urlSafe: Bool) : String =
    let c0 = (b0 >> 2L) & 63L in
    let c1 = ((b0 & 3L) << 4L) ^ ((b1 >> 4L) & 15L) in
    let c2 = ((b1 & 15L) << 2L) ^ ((b2 >> 6L) & 3L) in
    let c3 = b2 & 63L in
    if urlSafe then
        Stdlib.Base64.__encodeCharUrl(c0) ++
        Stdlib.Base64.__encodeCharUrl(c1) ++
        Stdlib.Base64.__encodeCharUrl(c2) ++
        Stdlib.Base64.__encodeCharUrl(c3)
    else
        Stdlib.Base64.__encodeChar(c0) ++
        Stdlib.Base64.__encodeChar(c1) ++
        Stdlib.Base64.__encodeChar(c2) ++
        Stdlib.Base64.__encodeChar(c3)

// Encode 2 bytes to 3 base64 characters + 1 padding
let __encode2Bytes(b0: Int64, b1: Int64, urlSafe: Bool) : String =
    let c0 = (b0 >> 2L) & 63L in
    let c1 = ((b0 & 3L) << 4L) ^ ((b1 >> 4L) & 15L) in
    let c2 = (b1 & 15L) << 2L in
    if urlSafe then
        Stdlib.Base64.__encodeCharUrl(c0) ++
        Stdlib.Base64.__encodeCharUrl(c1) ++
        Stdlib.Base64.__encodeCharUrl(c2) ++ "="
    else
        Stdlib.Base64.__encodeChar(c0) ++
        Stdlib.Base64.__encodeChar(c1) ++
        Stdlib.Base64.__encodeChar(c2) ++ "="

// Encode 1 byte to 2 base64 characters + 2 padding
let __encode1Byte(b0: Int64, urlSafe: Bool) : String =
    let c0 = (b0 >> 2L) & 63L in
    let c1 = (b0 & 3L) << 4L in
    if urlSafe then
        Stdlib.Base64.__encodeCharUrl(c0) ++
        Stdlib.Base64.__encodeCharUrl(c1) ++ "=="
    else
        Stdlib.Base64.__encodeChar(c0) ++
        Stdlib.Base64.__encodeChar(c1) ++ "=="

// Encode bytes to base64 helper
let __encodeHelper(b: Blob, index: Int64, len: Int64, urlSafe: Bool, acc: String) : String =
    let remaining = len - index in
    if remaining <= 0L then
        acc
    else if remaining >= 3L then
        let b0 = Stdlib.Bytes.get(b, index) in
        let b1 = Stdlib.Bytes.get(b, index + 1L) in
        let b2 = Stdlib.Bytes.get(b, index + 2L) in
        let chunk = Stdlib.Base64.__encode3Bytes(b0, b1, b2, urlSafe) in
        Stdlib.Base64.__encodeHelper(b, index + 3L, len, urlSafe, acc ++ chunk)
    else if remaining == 2L then
        let b0 = Stdlib.Bytes.get(b, index) in
        let b1 = Stdlib.Bytes.get(b, index + 1L) in
        acc ++ Stdlib.Base64.__encode2Bytes(b0, b1, urlSafe)
    else
        let b0 = Stdlib.Bytes.get(b, index) in
        acc ++ Stdlib.Base64.__encode1Byte(b0, urlSafe)

// Encode bytes to standard base64 string
let encode(bytes: Blob) : String =
    Stdlib.Base64.__encodeHelper(bytes, 0L, Stdlib.Bytes.length(bytes), false, "")

// Encode bytes to URL-safe base64 string
let urlEncode(bytes: Blob) : String =
    Stdlib.Base64.__encodeHelper(bytes, 0L, Stdlib.Bytes.length(bytes), true, "")

// Decode 4 base64 characters to up to 3 bytes
// Returns (bytes list, error flag)
let __decode4Chars(c0: Int64, c1: Int64, c2: Int64, c3: Int64) : (List<Int64> * Bool) =
    let v0 = Stdlib.Base64.__decodeChar(c0) in
    let v1 = Stdlib.Base64.__decodeChar(c1) in
    let v2 = Stdlib.Base64.__decodeChar(c2) in
    let v3 = Stdlib.Base64.__decodeChar(c3) in
    // Padding is only valid as the final one or two characters.
    if v0 == -1L || v1 == -1L || v2 == -1L || v3 == -1L ||
       v0 == -2L || v1 == -2L || (v2 == -2L && v3 != -2L) then
        ([], true)
    else if v2 == -2L then
        // Two padding chars - 1 output byte
        let b0 = ((v0 << 2L) ^ (v1 >> 4L)) & 255L in
        ([b0], false)
    else if v3 == -2L then
        // One padding char - 2 output bytes
        let b0 = ((v0 << 2L) ^ (v1 >> 4L)) & 255L in
        let b1 = ((v1 << 4L) ^ (v2 >> 2L)) & 255L in
        ([b0, b1], false)
    else
        // No padding - 3 output bytes
        let b0 = ((v0 << 2L) ^ (v1 >> 4L)) & 255L in
        let b1 = ((v1 << 4L) ^ (v2 >> 2L)) & 255L in
        let b2 = ((v2 << 6L) ^ v3) & 255L in
        ([b0, b1, b2], false)

// Decode base64 helper
let __decodeHelper(s: String, index: Int64, len: Int64, acc: List<Int64>) : Stdlib.Result.Result<List<Int64>, String> =
    if index >= len then
        Ok(Stdlib.List.reverse<Int64>(acc))
    else if index + 4L > len then
        Error("Not a valid base64 string")
    else
        let c0 = Stdlib.String.getByteAt(s, index) in
        let c1 = Stdlib.String.getByteAt(s, index + 1L) in
        let c2 = Stdlib.String.getByteAt(s, index + 2L) in
        let c3 = Stdlib.String.getByteAt(s, index + 3L) in
        if (c2 == 61L || c3 == 61L) && index + 4L != len then
            Error("Not a valid base64 string")
        else
          let result = Stdlib.Base64.__decode4Chars(c0, c1, c2, c3) in
          match result with
          | (bytes, true) -> Error("Not a valid base64 string")
        | (bytes, false) ->
            // Prepend bytes to accumulator (in reverse order since we'll reverse at end)
            let newAcc = Stdlib.Base64.__prependReversed(bytes, acc) in
            Stdlib.Base64.__decodeHelper(s, index + 4L, len, newAcc)

// Helper to prepend a list in reverse order
let __prependReversed(bytes: List<Int64>, acc: List<Int64>) : List<Int64> =
    match bytes with
    | [] -> acc
    | b :: rest -> Stdlib.Base64.__prependReversed(rest, Stdlib.List.push<Int64>(acc, b))

// Decode base64 string to bytes
let decode(s: String) : Stdlib.Result.Result<Blob, String> =
    let len = Stdlib.String.__byteLength(s) in
    let remainder = len % 4L in
    if len == 0L then
        Ok(Stdlib.Bytes.create(0L))
    else if remainder == 1L then
        Error("Not a valid base64 string")
    else
        // Base64 permits the final two- or three-character group to omit padding.
        let padded =
            if remainder == 2L then s ++ "=="
            else if remainder == 3L then s ++ "="
            else s in
        match Stdlib.Base64.__decodeHelper(padded, 0L, Stdlib.String.__byteLength(padded), []) with
        | Ok(byteList) -> Ok(Stdlib.Bytes.fromList(byteList))
        | Error(_) -> Error("Not a valid base64 string")

// Decode URL-safe base64 string to bytes (same decoder handles both)
let urlDecode(s: String) : Stdlib.Result.Result<Blob, String> =
    Stdlib.Base64.decode(s)

// =============================================================================
