// Stdlib.UInt16.dark - Stdlib.UInt16 definitions
//
// Split from stdlib.dark for modular stdlib loading.

module Stdlib.UInt16

// Stdlib.UInt16 - Integer operations

let add(a: UInt16, b: UInt16) : UInt16 = a + b

let subtract(a: UInt16, b: UInt16) : UInt16 = a - b

let multiply(a: UInt16, b: UInt16) : UInt16 = a * b

let divide(a: UInt16, b: UInt16) : UInt16 = a / b

let max(a: UInt16, b: UInt16) : UInt16 = if a > b then a else b

let min(a: UInt16, b: UInt16) : UInt16 = if a < b then a else b

let mod(a: UInt16, b: UInt16) : UInt16 = a % b

let absoluteValue(a: UInt16) : UInt16 = a

let negate(a: UInt16) : UInt16 = 0us - a

let power(base: UInt16, exponent: UInt16) : UInt16 =
    if exponent == 0us then 1us
    else if exponent == 1us then base
    else base * Stdlib.UInt16.power(base, exponent - 1us)

let clamp(value: UInt16, limitA: UInt16, limitB: UInt16) : UInt16 =
    let lower = Stdlib.UInt16.min(limitA, limitB) in
    let upper = Stdlib.UInt16.max(limitA, limitB) in
    Stdlib.UInt16.max(lower, Stdlib.UInt16.min(upper, value))

let greaterThan(a: UInt16, b: UInt16) : Bool = a > b

let greaterThanOrEqualTo(a: UInt16, b: UInt16) : Bool = a >= b

let lessThan(a: UInt16, b: UInt16) : Bool = a < b

let lessThanOrEqualTo(a: UInt16, b: UInt16) : Bool = a <= b

// Bitwise operations
let bitwiseAnd(a: UInt16, b: UInt16) : UInt16 = a & b

let bitwiseOr(a: UInt16, b: UInt16) : UInt16 = a ||| b

let bitwiseXor(a: UInt16, b: UInt16) : UInt16 = a ^ b

let shiftLeft(a: UInt16, shift: UInt16) : UInt16 = a << shift

let shiftRight(a: UInt16, shift: UInt16) : UInt16 = a >> shift

let bitwiseNot(a: UInt16) : UInt16 = a ^ 65535us

// Count number of set bits (population count)
// Uses parallel bit counting algorithm (SWAR)
let popcount(x: UInt16) : UInt16 =
    let mask1 = 21845us in
    let mask2 = 13107us in
    let mask3 = 3855us in
    let mask4 = 31us in
    let x = x - ((x >> 1us) & mask1) in
    let x = (x & mask2) + ((x >> 2us) & mask2) in
    let x = (x + (x >> 4us)) & mask3 in
    let x = x + (x >> 8us) in
    x & mask4

// Convert a single digit (0-9) to its string representation
let __digitToString(n: UInt16) : String =
    match n with
    | 0us -> "0"
    | 1us -> "1"
    | 2us -> "2"
    | 3us -> "3"
    | 4us -> "4"
    | 5us -> "5"
    | 6us -> "6"
    | 7us -> "7"
    | 8us -> "8"
    | 9us -> "9"
    | _ -> "?"

// Convert an integer to its string representation
let toString(n: UInt16) : String =
    if n < 10us then Stdlib.UInt16.__digitToString(n)
    else Stdlib.UInt16.toString(n / 10us) ++ Stdlib.UInt16.__digitToString(n % 10us)

// Check if integer is even
let isEven(n: UInt16) : Bool =
    (n % 2us) == 0us

// Check if integer is odd
let isOdd(n: UInt16) : Bool =
    (n % 2us) != 0us

// Sum all integers in a list
let sum(list: List<UInt16>) : UInt16 =
    Stdlib.List.fold<UInt16, UInt16>(list, 0us, fun acc x -> acc + x)
