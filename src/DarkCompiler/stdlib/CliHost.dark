// Stdlib.Cli.Host - aggregate runtime host discovery.

module Stdlib.Cli.Host

type Host = { os: Stdlib.Cli.OS.OS, arch: Stdlib.Cli.Architecture.Architecture, defaultShell: Stdlib.Cli.Shell.Shell }

let getRuntimeHost() : Stdlib.Result.Result<Stdlib.Cli.Host.Host, String> =
    let os = Stdlib.Cli.OS.getOS() in
    let arch = Stdlib.Cli.Architecture.getArchitecture() in
    let shell = Stdlib.Cli.Shell.getDefaultShell() in
    match (os, arch, shell) with
    | (Ok(os), Ok(arch), Ok(shell)) -> Ok(Stdlib.Cli.Host.Host { os = os, arch = arch, defaultShell = shell })
    | (Error(error), _, _) -> Error("Couldn't determine host OS: " ++ error)
    | (_, Error(error), _) -> Error("Couldn't determine host architecture: " ++ error)
    | (_, _, Error(error)) -> Error("Couldn't determine host default shell " ++ error)
