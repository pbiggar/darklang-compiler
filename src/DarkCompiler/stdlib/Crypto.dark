// Stdlib.Crypto.dark - Stdlib.Crypto definitions
//
// Cryptographic hash functions: MD5, SHA-1, SHA-256, SHA-384, and HMAC variants
// All implemented in pure Darklang without external dependencies.

module Stdlib.Crypto

// =============================================================================
// 32-bit Arithmetic Helpers
// =============================================================================
// Hash algorithms use 32-bit arithmetic with wraparound. Since we have Int64,
// we mask to 32 bits after operations.

let __mask32() : Int64 = 4294967295L

let __add32(a: Int64, b: Int64) : Int64 =
    (a + b) & Stdlib.Crypto.__mask32()

let __rotr32(x: Int64, n: Int64) : Int64 =
    let masked = x & Stdlib.Crypto.__mask32() in
    Stdlib.Int64.bitwiseOr((masked >> n), (masked << (32L - n))) & Stdlib.Crypto.__mask32()

let __rotl32(x: Int64, n: Int64) : Int64 =
    let masked = x & Stdlib.Crypto.__mask32() in
    Stdlib.Int64.bitwiseOr((masked << n), (masked >> (32L - n))) & Stdlib.Crypto.__mask32()

let __not32(x: Int64) : Int64 =
    (~~~x) & Stdlib.Crypto.__mask32()

// =============================================================================
// Byte Packing/Unpacking
// =============================================================================

// Read 32-bit big-endian word from bytes at offset
let __getBE32(b: Blob, offset: Int64) : Int64 =
    let b0 = Stdlib.Bytes.get(b, offset) in
    let b1 = Stdlib.Bytes.get(b, offset + 1L) in
    let b2 = Stdlib.Bytes.get(b, offset + 2L) in
    let b3 = Stdlib.Bytes.get(b, offset + 3L) in
    Stdlib.Int64.bitwiseOr(Stdlib.Int64.bitwiseOr(Stdlib.Int64.bitwiseOr((b0 << 24L), (b1 << 16L)), (b2 << 8L)), b3)

// Read 32-bit little-endian word from bytes at offset
let __getLE32(b: Blob, offset: Int64) : Int64 =
    let b0 = Stdlib.Bytes.get(b, offset) in
    let b1 = Stdlib.Bytes.get(b, offset + 1L) in
    let b2 = Stdlib.Bytes.get(b, offset + 2L) in
    let b3 = Stdlib.Bytes.get(b, offset + 3L) in
    Stdlib.Int64.bitwiseOr(Stdlib.Int64.bitwiseOr(Stdlib.Int64.bitwiseOr(b0, (b1 << 8L)), (b2 << 16L)), (b3 << 24L))

// Read 64-bit big-endian word from bytes at offset
let __getBE64(b: Blob, offset: Int64) : Int64 =
    let hi = Stdlib.Crypto.__getBE32(b, offset) in
    let lo = Stdlib.Crypto.__getBE32(b, offset + 4L) in
    Stdlib.Int64.bitwiseOr((hi << 32L), lo)

// Convert 32-bit value to 4-byte list (big-endian)
let __int32ToBE(v: Int64) : List<Int64> =
    [(v >> 24L) & 255L, (v >> 16L) & 255L, (v >> 8L) & 255L, v & 255L]

// Convert 32-bit value to 4-byte list (little-endian)
let __int32ToLE(v: Int64) : List<Int64> =
    [v & 255L, (v >> 8L) & 255L, (v >> 16L) & 255L, (v >> 24L) & 255L]

// Convert 64-bit value to 8-byte list (big-endian)
let __int64ToBE(v: Int64) : List<Int64> =
    [(v >> 56L) & 255L, (v >> 48L) & 255L, (v >> 40L) & 255L, (v >> 32L) & 255L,
     (v >> 24L) & 255L, (v >> 16L) & 255L, (v >> 8L) & 255L, v & 255L]

// Convert 64-bit value to 8-byte list (little-endian)
let __int64ToLE(v: Int64) : List<Int64> =
    [v & 255L, (v >> 8L) & 255L, (v >> 16L) & 255L, (v >> 24L) & 255L,
     (v >> 32L) & 255L, (v >> 40L) & 255L, (v >> 48L) & 255L, (v >> 56L) & 255L]

// =============================================================================
// Hex Encoding (for test output)
// =============================================================================

let __nibbleToHex(n: Int64) : String =
    match n with
    | 0L -> "0" | 1L -> "1" | 2L -> "2" | 3L -> "3"
    | 4L -> "4" | 5L -> "5" | 6L -> "6" | 7L -> "7"
    | 8L -> "8" | 9L -> "9" | 10L -> "A" | 11L -> "B"
    | 12L -> "C" | 13L -> "D" | 14L -> "E" | 15L -> "F"
    | _ -> "?"

let __byteToHex(b: Int64) : String =
    Stdlib.Crypto.__nibbleToHex((b >> 4L) & 15L) ++ Stdlib.Crypto.__nibbleToHex(b & 15L)

let __bytesToHexHelper(b: Blob, index: Int64, len: Int64, acc: String) : String =
    if index >= len then
        acc
    else
        let byte = Stdlib.Bytes.get(b, index) in
        Stdlib.Crypto.__bytesToHexHelper(b, index + 1L, len, acc ++ Stdlib.Crypto.__byteToHex(byte))

// Convert bytes to uppercase hex string (public API for testing)
let bytesToHex(b: Blob) : String =
    Stdlib.Crypto.__bytesToHexHelper(b, 0L, Stdlib.Bytes.length(b), "")

// Debug function: test rotl32
let debugRotl32(x: Int64, n: Int64) : Int64 =
    Stdlib.Crypto.__rotl32(x, n)

// Debug: components of rotl32 calculation
let debugRotl32Parts(x: Int64, n: Int64) : (Int64, Int64, Int64) =
    let masked = x & Stdlib.Crypto.__mask32() in
    let leftPart = masked << n in
    let rightPart = masked >> (32L - n) in
    (leftPart, rightPart, leftPart & Stdlib.Crypto.__mask32())

// Debug: full rotl32 trace showing all intermediate values
// Returns (masked, leftPart, rightPart, orResult, finalResult)
let debugRotl32Full(x: Int64, n: Int64) : (Int64, Int64, Int64, Int64, Int64) =
    let masked = x & Stdlib.Crypto.__mask32() in
    let leftPart = masked << n in
    let rightPart = masked >> (32L - n) in
    let orResult = Stdlib.Int64.bitwiseOr(leftPart, rightPart) in
    let finalResult = orResult & Stdlib.Crypto.__mask32() in
    (masked, leftPart, rightPart, orResult, finalResult)

// Debug function: test rotr32
let debugRotr32(x: Int64, n: Int64) : Int64 =
    Stdlib.Crypto.__rotr32(x, n)

// Debug function: test add32
let debugAdd32(a: Int64, b: Int64) : Int64 =
    Stdlib.Crypto.__add32(a, b)

// Debug function: test getLE32 on bytes
let debugGetLE32(b: Blob, offset: Int64) : Int64 =
    Stdlib.Crypto.__getLE32(b, offset)

// Debug function: test getBE32 on bytes
let debugGetBE32(b: Blob, offset: Int64) : Int64 =
    Stdlib.Crypto.__getBE32(b, offset)

// Debug function: show first 4 message words from padded data
let debugMd5Words(padded: Blob) : (Int64, Int64, Int64, Int64) =
    let m0 = Stdlib.Crypto.__md5GetWord(padded, 0L, 0L) in
    let m1 = Stdlib.Crypto.__md5GetWord(padded, 0L, 1L) in
    let m2 = Stdlib.Crypto.__md5GetWord(padded, 0L, 2L) in
    let m3 = Stdlib.Crypto.__md5GetWord(padded, 0L, 3L) in
    (m0, m1, m2, m3)

// Debug function: show message words 11-14 from padded data
let debugMd5Words11to14(padded: Blob) : (Int64, Int64, Int64, Int64) =
    let m11 = Stdlib.Crypto.__md5GetWord(padded, 0L, 11L) in
    let m12 = Stdlib.Crypto.__md5GetWord(padded, 0L, 12L) in
    let m13 = Stdlib.Crypto.__md5GetWord(padded, 0L, 13L) in
    let m14 = Stdlib.Crypto.__md5GetWord(padded, 0L, 14L) in
    (m11, m12, m13, m14)

// Debug function: return the padded message that MD5 would process
let debugMd5Padded(data: Blob) : Blob =
    let dataLen = Stdlib.Bytes.length(data) in
    let dataList = Stdlib.Crypto.__copyDataToList(data, 0L, dataLen, []) in
    let padding = Stdlib.Crypto.__md5BuildPadding(dataLen) in
    // Use Stdlib.List.append instead of Stdlib.List.flatten to avoid compiler bug with list-of-lists
    let paddedList = Stdlib.List.append<Int64>(dataList, padding) in
    Stdlib.Bytes.fromList(paddedList)

// Debug function: return the length of the padded message
let debugMd5PaddedLen(data: Blob) : Int64 =
    Stdlib.Bytes.length(Stdlib.Crypto.debugMd5Padded(data))

// Debug function: copy first 4 bytes from Blob to List
let debugCopyFirst4(data: Blob) : List<Int64> =
    let dataLen = Stdlib.Bytes.length(data) in
    let dataList = Stdlib.Crypto.__copyDataToList(data, 0L, dataLen, []) in
    Stdlib.List.take<Int64>(dataList, 4I)

// Debug function: copy data and flatten with empty list, take first 4
let debugFlattenFirst4(data: Blob) : List<Int64> =
    let dataLen = Stdlib.Bytes.length(data) in
    let dataList = Stdlib.Crypto.__copyDataToList(data, 0L, dataLen, []) in
    let paddedList = Stdlib.List.flatten<Int64>([dataList, []]) in
    Stdlib.List.take<Int64>(paddedList, 4I)

// Debug: just wrap in list-of-lists and access first element, no flatten
let debugListOfLists(data: Blob) : List<Int64> =
    let dataLen = Stdlib.Bytes.length(data) in
    let dataList = Stdlib.Crypto.__copyDataToList(data, 0L, dataLen, []) in
    let listOfLists = [dataList, []] in
    match Stdlib.List.getAt<List<Int64>>(listOfLists, 0I) with
    | Some(first) -> Stdlib.List.take<Int64>(first, 4I)
    | None -> []

// Debug: use ++ instead of flatten
let debugAppendFirst4(data: Blob) : List<Int64> =
    let dataLen = Stdlib.Bytes.length(data) in
    let dataList = Stdlib.Crypto.__copyDataToList(data, 0L, dataLen, []) in
    let combined = Stdlib.List.append<Int64>(dataList, []) in
    Stdlib.List.take<Int64>(combined, 4I)

// Debug: wrap in single-element list-of-lists
let debugSingleListOfLists(data: Blob) : List<Int64> =
    let dataLen = Stdlib.Bytes.length(data) in
    let dataList = Stdlib.Crypto.__copyDataToList(data, 0L, dataLen, []) in
    let listOfLists = [dataList] in
    match Stdlib.List.getAt<List<Int64>>(listOfLists, 0I) with
    | Some(first) -> Stdlib.List.take<Int64>(first, 4I)
    | None -> []

// Debug: what if we just read back the list after assigning to a variable?
let debugJustAssign(data: Blob) : List<Int64> =
    let dataLen = Stdlib.Bytes.length(data) in
    let dataList = Stdlib.Crypto.__copyDataToList(data, 0L, dataLen, []) in
    let same = dataList in
    Stdlib.List.take<Int64>(same, 4I)

// Debug function: convert data to list, flatten, convert to bytes, read back first 4 bytes
let debugRoundtrip4(data: Blob) : (Int64, Int64, Int64, Int64) =
    let dataLen = Stdlib.Bytes.length(data) in
    let dataList = Stdlib.Crypto.__copyDataToList(data, 0L, dataLen, []) in
    let paddedList = Stdlib.List.flatten<Int64>([dataList, []]) in
    let result = Stdlib.Bytes.fromList(paddedList) in
    (Stdlib.Bytes.get(result, 0L), Stdlib.Bytes.get(result, 1L), Stdlib.Bytes.get(result, 2L), Stdlib.Bytes.get(result, 3L))

// Debug function: compute MD5 F function for round 0
let debugMd5F(b: Int64, c: Int64, d: Int64) : Int64 =
    Stdlib.Crypto.__md5F(0L, b, c, d)

// Debug: trace through F function components for specific inputs
// Returns (b_and_c, not_b, not_b_and_d, result)
let debugMd5FTrace(b: Int64, c: Int64, d: Int64) : (Int64, Int64, Int64, Int64) =
    let b_and_c = b & c in
    let not_b = Stdlib.Crypto.__not32(b) in
    let not_b_and_d = not_b & d in
    let result = Stdlib.Int64.bitwiseOr(b_and_c, not_b_and_d) & Stdlib.Crypto.__mask32() in
    (b_and_c, not_b, not_b_and_d, result)

// Debug: test not32 function
let debugNot32(x: Int64) : Int64 =
    Stdlib.Crypto.__not32(x)

// Debug: test raw bitwise NOT before masking
let debugRawNot(x: Int64) : Int64 =
    ~~~x

// Debug function: compute one MD5 step and return new B value
let debugMd5OneStep(a: Int64, b: Int64, c: Int64, d: Int64, m: Int64) : Int64 =
    // Round 0: F = (B & C) | (~B & D), g=0, K[0]=3614090360, s=7
    let f = Stdlib.Crypto.__md5F(0L, b, c, d) in
    let k = 3614090360L in
    let temp = Stdlib.Crypto.__add32(Stdlib.Crypto.__add32(Stdlib.Crypto.__add32(a, f), k), m) in
    Stdlib.Crypto.__add32(b, Stdlib.Crypto.__rotl32(temp, 7L))

// Debug: run 64 MD5 rounds and return the state as a tuple
let debugMd5AllRounds(padded: Blob) : (Int64, Int64, Int64, Int64) =
    let h0 = 1732584193L in
    let h1 = 4023233417L in
    let h2 = 2562383102L in
    let h3 = 271733878L in
    Stdlib.Crypto.__md5Rounds(h0, h1, h2, h3, 0L, padded, 0L)

// Debug: run full MD5 block processing (64 rounds + add back to h0-h3)
let debugMd5ProcessBlock(padded: Blob) : (Int64, Int64, Int64, Int64) =
    let h0 = 1732584193L in
    let h1 = 4023233417L in
    let h2 = 2562383102L in
    let h3 = 271733878L in
    Stdlib.Crypto.__md5ProcessBlock(h0, h1, h2, h3, padded, 0L)

// Debug: run just 1 MD5 round (round 0) and return the state
let debugMd5Round0(padded: Blob) : (Int64, Int64, Int64, Int64) =
    let h0 = 1732584193L in
    let h1 = 4023233417L in
    let h2 = 2562383102L in
    let h3 = 271733878L in
    Stdlib.Crypto.__md5Step(h0, h1, h2, h3, 0L, padded, 0L)

// Debug: helper to run N rounds
let __debugMd5NRounds(a: Int64, b: Int64, c: Int64, d: Int64, i: Int64, n: Int64, block: Blob) : (Int64, Int64, Int64, Int64) =
    if i >= n then
        (a, b, c, d)
    else
        let result = Stdlib.Crypto.__md5Step(a, b, c, d, i, block, 0L) in
        match result with
        | (na, nb, nc, nd) -> Stdlib.Crypto.__debugMd5NRounds(na, nb, nc, nd, i + 1L, n, block)

