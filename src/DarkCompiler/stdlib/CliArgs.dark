// Stdlib.Cli.Args - typed process-argument access for compiled CLI programs.
//
// The public API deliberately returns Result: callers must distinguish a
// missing positional argument from an invalid numeric argument.

module Stdlib.Cli.Args

let get(index: Int) : Stdlib.Result.Result<String, String> =
    if index < 0I then Error("argument index must not be negative")
    else
        match Stdlib.Int.toInt64(index) with
        | None -> Error("command-line argument index is out of range")
        | Some(nativeIndex) ->
            match Stdlib.Cli.__argv(nativeIndex) with
            | Some(value) -> Ok(value)
            | None -> Error("missing command-line argument at index " ++ Stdlib.Int.toString(index))

let int64(index: Int) : Stdlib.Result.Result<Int64, String> =
    match Stdlib.Cli.Args.get(index) with
    | Error(message) -> Error(message)
    | Ok(value) ->
        match Stdlib.Int.parse(value) with
        | Ok(number) ->
            match Stdlib.Int.toInt64(number) with
            | Some(value) -> Ok(value)
            | None -> Error("Int64 command-line argument is out of range at index " ++ Stdlib.Int.toString(index))
        | Error(_) -> Error("invalid Int64 command-line argument at index " ++ Stdlib.Int.toString(index) ++ ": " ++ value)
