// Stdlib.Print.dark - Explicit String-only stdout helpers shared with Darklang.

module Darklang.Stdlib

let print (str: String) : Unit =
    let _ = Builtin.print str in
    ()

let printLine (str: String) : Unit =
    let _ = Builtin.printLine str in
    ()

let printLines (lines: List<String>) : Unit =
    let _ = Stdlib.List.iter lines Stdlib.printLine in
    ()
