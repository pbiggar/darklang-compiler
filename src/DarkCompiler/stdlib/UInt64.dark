// Stdlib.UInt64.dark - Stdlib.UInt64 definitions
//
// Split from stdlib.dark for modular stdlib loading.

module Stdlib.UInt64

// Stdlib.UInt64 - Integer operations

let add(a: UInt64, b: UInt64) : UInt64 = a + b

let sub(a: UInt64, b: UInt64) : UInt64 = a - b

let mul(a: UInt64, b: UInt64) : UInt64 = a * b

let div(a: UInt64, b: UInt64) : UInt64 = a / b

let max(a: UInt64, b: UInt64) : UInt64 = if a > b then a else b

let min(a: UInt64, b: UInt64) : UInt64 = if a < b then a else b

let mod(a: UInt64, b: UInt64) : UInt64 = a % b

let absoluteValue(a: UInt64) : UInt64 = a

let negate(a: UInt64) : UInt64 = 0UL - a

let power(base: UInt64, exponent: UInt64) : UInt64 =
    if exponent == 0UL then 1UL
    else if exponent == 1UL then base
    else base * Stdlib.UInt64.power(base, exponent - 1UL)

let clamp(value: UInt64, limitA: UInt64, limitB: UInt64) : UInt64 =
    let lower = Stdlib.UInt64.min(limitA, limitB) in
    let upper = Stdlib.UInt64.max(limitA, limitB) in
    Stdlib.UInt64.max(lower, Stdlib.UInt64.min(upper, value))

let greaterThan(a: UInt64, b: UInt64) : Bool = a > b

let greaterThanOrEqualTo(a: UInt64, b: UInt64) : Bool = a >= b

let lessThan(a: UInt64, b: UInt64) : Bool = a < b

let lessThanOrEqualTo(a: UInt64, b: UInt64) : Bool = a <= b

// Bitwise operations
let bitwiseAnd(a: UInt64, b: UInt64) : UInt64 = a & b

let bitwiseOr(a: UInt64, b: UInt64) : UInt64 = a ||| b

let bitwiseXor(a: UInt64, b: UInt64) : UInt64 = a ^ b

let shiftLeft(a: UInt64, shift: UInt64) : UInt64 = a << shift

let shiftRight(a: UInt64, shift: UInt64) : UInt64 = a >> shift

let bitwiseNot(a: UInt64) : UInt64 = ~~~a

// Count number of set bits (population count)
// Uses parallel bit counting algorithm (SWAR)
let popcount(x: UInt64) : UInt64 =
    let mask1 = 6148914691236517205UL in
    let mask2 = 3689348814741910323UL in
    let mask3 = 1085102592571150095UL in
    let mult = 72340172838076673UL in
    let x = x - ((x >> 1UL) & mask1) in
    let x = (x & mask2) + ((x >> 2UL) & mask2) in
    let x = (x + (x >> 4UL)) & mask3 in
    (x * mult) >> 56UL

// Convert a single digit (0-9) to its string representation
let __digitToString(n: UInt64) : String =
    match n with
    | 0UL -> "0"
    | 1UL -> "1"
    | 2UL -> "2"
    | 3UL -> "3"
    | 4UL -> "4"
    | 5UL -> "5"
    | 6UL -> "6"
    | 7UL -> "7"
    | 8UL -> "8"
    | 9UL -> "9"
    | _ -> "?"

// Convert an integer to its string representation
let toString(n: UInt64) : String =
    if (n >> 63UL) == 1UL then
        let quotient = (n >> 1UL) / 5UL in
        let remainder = n - (quotient * 10UL) in
        Stdlib.UInt64.toString(quotient) ++ Stdlib.UInt64.__digitToString(remainder)
    else if n < 10UL then Stdlib.UInt64.__digitToString(n)
    else Stdlib.UInt64.toString(n / 10UL) ++ Stdlib.UInt64.__digitToString(n % 10UL)

// Check if integer is even
let isEven(n: UInt64) : Bool =
    (n % 2UL) == 0UL

// Check if integer is odd
let isOdd(n: UInt64) : Bool =
    (n % 2UL) != 0UL

// Sum all integers in a list
let sum(list: List<UInt64>) : UInt64 =
    Stdlib.List.fold<UInt64, UInt64>(list, 0UL, fun acc x -> acc + x)
