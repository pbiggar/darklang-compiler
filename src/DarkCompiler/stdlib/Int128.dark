// Stdlib.Int128.dark - signed 128-bit integer operations.
//
// Values are immutable fixed blocks containing a two's-complement low/high
// UInt64 pair followed by their reference count.

module Darklang.Stdlib.Int128

type ParseError = BadFormat | OutOfRange

let __low (value: Int128) : UInt64 = __raw_get<UInt64> (__int128_to_rawptr value) 0L
let __high (value: Int128) : UInt64 = __raw_get<UInt64> (__int128_to_rawptr value) 8L
let __fromWords (low: UInt64) (high: UInt64) : Int128 =
    let ptr = __raw_alloc 24L in
    let _ = __raw_slot_init<UInt64> ptr 0L low in
    let _ = __raw_slot_init<UInt64> ptr 8L high in
    let _ = __raw_write_word ptr 16L 1L in
    __rawptr_to_int128 ptr

let __unsignedInt (value: Int128) : Int =
    Stdlib.Int.__add (Stdlib.Int.__multiply (Stdlib.Int.__fromUInt64 (Stdlib.Int128.__high value)) (Stdlib.Int.__value "18446744073709551616")) (Stdlib.Int.__fromUInt64 (Stdlib.Int128.__low value))

let __toInt (value: Int128) : Int =
    let unsigned = Stdlib.Int128.__unsignedInt value in
    if Stdlib.UInt64.shiftRight (Stdlib.Int128.__high value) 63UL == 1UL then
        Stdlib.Int.__subtract unsigned (Stdlib.Int.__value "340282366920938463463374607431768211456")
    else unsigned

let __fromInt (value: Int) : Int128 =
    let unsigned = Stdlib.UInt128.__fromInt value in
    Stdlib.Int128.__fromWords (Stdlib.UInt128.__low unsigned) (Stdlib.UInt128.__high unsigned)

let __equalsWords (value: Int128) (low: UInt64) (high: UInt64) : Bool =
    Stdlib.Int128.__low value == low && Stdlib.Int128.__high value == high

let add (a: Int128) (b: Int128) : Int128 =
    let aLow = Stdlib.Int128.__low a in
    let bLow = Stdlib.Int128.__low b in
    let low = aLow + bLow in
    let carry = if low < aLow then 1UL else 0UL in
    Stdlib.Int128.__fromWords low (Stdlib.Int128.__high a + Stdlib.Int128.__high b + carry)

let subtract (a: Int128) (b: Int128) : Int128 =
    let aLow = Stdlib.Int128.__low a in
    let bLow = Stdlib.Int128.__low b in
    let low = aLow - bLow in
    let borrow = if aLow < bLow then 1UL else 0UL in
    Stdlib.Int128.__fromWords low (Stdlib.Int128.__high a - Stdlib.Int128.__high b - borrow)

let multiply (a: Int128) (b: Int128) : Int128 =
    let aLow = Stdlib.Int128.__low a in
    let bLow = Stdlib.Int128.__low b in
    let high = Stdlib.UInt128.__multiplyHigh64 aLow bLow + Stdlib.Int128.__high a * bLow + aLow * Stdlib.Int128.__high b in
    Stdlib.Int128.__fromWords (aLow * bLow) high

let divide (a: Int128) (b: Int128) : Int128 = Stdlib.Int128.__fromInt (Stdlib.Int.__divide (Stdlib.Int128.__toInt a) (Stdlib.Int128.__toInt b))
let remainder (value: Int128) (divisor: Int128) : Stdlib.Result.Result<Int128, String> =
    match Stdlib.Int.__remainder (Stdlib.Int128.__toInt value) (Stdlib.Int128.__toInt divisor) with
    | Error message -> Error message
    | Ok result -> Ok (Stdlib.Int128.__fromInt result)
let mod (value: Int128) (modulus: Int128) : Int128 = Stdlib.Int128.__fromInt (Stdlib.Int.__mod (Stdlib.Int128.__toInt value) (Stdlib.Int128.__toInt modulus))
let negate (value: Int128) : Int128 = Stdlib.Int128.subtract (Stdlib.Int128.__fromWords 0UL 0UL) value
let absoluteValue (value: Int128) : Int128 = if Stdlib.UInt64.shiftRight (Stdlib.Int128.__high value) 63UL == 1UL then Stdlib.Int128.negate value else value

let lessThan (a: Int128) (b: Int128) : Bool =
    let aHigh = Stdlib.Int128.__high a in
    let bHigh = Stdlib.Int128.__high b in
    let aNegative = Stdlib.UInt64.shiftRight aHigh 63UL == 1UL in
    let bNegative = Stdlib.UInt64.shiftRight bHigh 63UL == 1UL in
    if aNegative != bNegative then aNegative
    else aHigh < bHigh || (aHigh == bHigh && Stdlib.Int128.__low a < Stdlib.Int128.__low b)
let __equals (a: Int128) (b: Int128) : Bool = Stdlib.Int128.__equalsWords a (Stdlib.Int128.__low b) (Stdlib.Int128.__high b)
let lessThanOrEqualTo (a: Int128) (b: Int128) : Bool = Stdlib.Int128.lessThan a b || Stdlib.Int128.__equals a b
let greaterThan (a: Int128) (b: Int128) : Bool = Stdlib.Int128.lessThan b a
let greaterThanOrEqualTo (a: Int128) (b: Int128) : Bool = Stdlib.Int128.lessThanOrEqualTo b a

let sqrt (value: Int128) : Float = Stdlib.Int.__sqrt (Stdlib.Int128.__toInt value)
let toFloat (value: Int128) : Float = Stdlib.Int.__toFloat (Stdlib.Int128.__toInt value)
let sum (values: List<Int128>) : Int128 = Stdlib.List.fold values (0Q) (fun acc value -> Stdlib.Int128.add acc value)
let max (a: Int128) (b: Int128) : Int128 = if Stdlib.Int128.greaterThan a b then a else b
let min (a: Int128) (b: Int128) : Int128 = if Stdlib.Int128.lessThan a b then a else b
let clamp (value: Int128) (limitA: Int128) (limitB: Int128) : Int128 =
    let lower = Stdlib.Int128.min limitA limitB in
    let upper = Stdlib.Int128.max limitA limitB in
    Stdlib.Int128.max lower (Stdlib.Int128.min upper value)

let toString (value: Int128) : String =
    let low = Stdlib.Int128.__low value in
    let high = Stdlib.Int128.__high value in
    if Stdlib.UInt64.shiftRight high 63UL == 0UL then Stdlib.UInt128.__toStringWords low high
    else
        let magnitudeLow = 0UL - low in
        let magnitudeHigh = 18446744073709551615UL - high + (if magnitudeLow == 0UL then 1UL else 0UL) in
        __string_concat_raw "-" (Stdlib.UInt128.__toStringWords magnitudeLow magnitudeHigh)

let parse (value: String) : Stdlib.Result.Result<Int128, Stdlib.Int128.ParseError> =
    let trimmed = Stdlib.String.trim value in
    let length = Stdlib.String.__byteLength trimmed in
    if length == 0L then Error Stdlib.Int128.ParseError.BadFormat
    else
        let first = Stdlib.String.__byteAtUnchecked trimmed 0L in
        let negative = first == 45L in
        let start = if negative || first == 43L then 1L else 0L in
        if start == length then Error Stdlib.Int128.ParseError.BadFormat
        else
            match Stdlib.UInt128.__parseDigits trimmed start length 0UL 0UL with
            | Error error ->
                if error == Stdlib.UInt128.ParseError.BadFormat then Error Stdlib.Int128.ParseError.BadFormat
                else Error Stdlib.Int128.ParseError.OutOfRange
            | Ok magnitude ->
                let low = Stdlib.UInt128.__low magnitude in
                let high = Stdlib.UInt128.__high magnitude in
                let beyondSignedRange = high > 9223372036854775808UL || (high == 9223372036854775808UL && (negative == false || low != 0UL)) in
                if beyondSignedRange then Error Stdlib.Int128.ParseError.OutOfRange
                else if negative then
                    let resultLow = 0UL - low in
                    let resultHigh = 18446744073709551615UL - high + (if resultLow == 0UL then 1UL else 0UL) in
                    Ok (Stdlib.Int128.__fromWords resultLow resultHigh)
                else Ok (Stdlib.Int128.__fromWords low high)

let fromInt8 (value: Int8) : Int128 = Stdlib.Int128.__fromInt (Stdlib.Int.__fromInt8 value)
let fromUInt8 (value: UInt8) : Int128 = Stdlib.Int128.__fromInt (Stdlib.Int.__fromUInt8 value)
let fromInt16 (value: Int16) : Int128 = Stdlib.Int128.__fromInt (Stdlib.Int.__fromInt16 value)
let fromUInt16 (value: UInt16) : Int128 = Stdlib.Int128.__fromInt (Stdlib.Int.__fromUInt16 value)
let fromInt32 (value: Int32) : Int128 = Stdlib.Int128.__fromInt (Stdlib.Int.__fromInt32 value)
let fromUInt32 (value: UInt32) : Int128 = Stdlib.Int128.__fromInt (Stdlib.Int.__fromUInt32 value)
let fromInt64 (value: Int64) : Int128 = Stdlib.Int128.__fromInt (Stdlib.Int.__fromInt64 value)
let fromUInt64 (value: UInt64) : Int128 = Stdlib.Int128.__fromWords value 0UL
let bitwiseAnd (a: Int128) (b: Int128) : Int128 = Stdlib.Int128.__fromWords (Stdlib.UInt64.bitwiseAnd (Stdlib.Int128.__low a) (Stdlib.Int128.__low b)) (Stdlib.UInt64.bitwiseAnd (Stdlib.Int128.__high a) (Stdlib.Int128.__high b))
let bitwiseOr (a: Int128) (b: Int128) : Int128 = Stdlib.Int128.__fromWords (Stdlib.UInt64.bitwiseOr (Stdlib.Int128.__low a) (Stdlib.Int128.__low b)) (Stdlib.UInt64.bitwiseOr (Stdlib.Int128.__high a) (Stdlib.Int128.__high b))
let bitwiseXor (a: Int128) (b: Int128) : Int128 = Stdlib.Int128.__fromWords (Stdlib.UInt64.bitwiseXor (Stdlib.Int128.__low a) (Stdlib.Int128.__low b)) (Stdlib.UInt64.bitwiseXor (Stdlib.Int128.__high a) (Stdlib.Int128.__high b))
let bitwiseNot (value: Int128) : Int128 = Stdlib.Int128.__fromWords (18446744073709551615UL - Stdlib.Int128.__low value) (18446744073709551615UL - Stdlib.Int128.__high value)

let shiftLeft (value: Int128) (count: Int128) : Int128 =
    let shifted = Stdlib.UInt128.shiftLeft (Stdlib.UInt128.__fromWords (Stdlib.Int128.__low value) (Stdlib.Int128.__high value)) (Stdlib.UInt128.__fromWords (Stdlib.Int128.__low count) (Stdlib.Int128.__high count)) in
    Stdlib.Int128.__fromWords (Stdlib.UInt128.__low shifted) (Stdlib.UInt128.__high shifted)

let shiftRight (value: Int128) (count: Int128) : Int128 =
    let amount = Stdlib.UInt64.bitwiseAnd (Stdlib.Int128.__low count) 127UL in
    let low = Stdlib.Int128.__low value in
    let high = Stdlib.Int128.__high value in
    let negative = Stdlib.UInt64.shiftRight high 63UL == 1UL in
    let fill = if negative then 18446744073709551615UL else 0UL in
    if amount == 0UL then value
    else if amount < 64UL then Stdlib.Int128.__fromWords (Stdlib.UInt64.bitwiseOr (Stdlib.UInt64.shiftRight low amount) (Stdlib.UInt64.shiftLeft high (64UL - amount))) (Stdlib.UInt64.bitwiseOr (Stdlib.UInt64.shiftRight high amount) (Stdlib.UInt64.shiftLeft fill (64UL - amount)))
    else Stdlib.Int128.__fromWords (Stdlib.UInt64.bitwiseOr (Stdlib.UInt64.shiftRight high (amount - 64UL)) (Stdlib.UInt64.shiftLeft fill (128UL - amount))) fill
