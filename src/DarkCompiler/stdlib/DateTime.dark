// Stdlib.DateTime.dark - UTC DateTime values and operations
//
// DateTime uses Unix epoch milliseconds internally, which is precise enough for
// the upstream API while keeping arithmetic and comparison cheap in native code.

module Stdlib.DateTime

let __millisecondsPerSecond() : Int64 = 1000
let __millisecondsPerMinute() : Int64 = 60000
let __millisecondsPerHour() : Int64 = 3600000
let __millisecondsPerDay() : Int64 = 86400000

// These are the bounds of the four-digit ISO-8601 years accepted upstream.
let __minimumMilliseconds() : Int64 = -62135596800000
let __maximumMilliseconds() : Int64 = 253402300799999
let __maximumDeltaMilliseconds() : Int64 = 315537897599999

// Integer division in Dark truncates toward zero. DateTime component extraction
// needs Euclidean division so that the day containing -1ms is still 1969-12-31.
let __floorDiv(value: Int64, divisor: Int64) : Int64 =
    let quotient = value / divisor in
    if value < 0 && value % divisor != 0 then quotient - 1 else quotient

let __floorMod(value: Int64, divisor: Int64) : Int64 =
    let remainder = value % divisor in
    if remainder < 0 then remainder + divisor else remainder

let __isLeapYear(year: Int64) : Bool =
    if year % 4 != 0 then false
    else if year % 100 != 0 then true
    else year % 400 == 0

let __daysInYear(year: Int64) : Int64 =
    if Stdlib.DateTime.__isLeapYear(year) then 366 else 365

let __daysInMonth(month: Int64, year: Int64) : Int64 =
    match month with
    | 1 -> 31
    | 2 -> if Stdlib.DateTime.__isLeapYear(year) then 29 else 28
    | 3 -> 31
    | 4 -> 30
    | 5 -> 31
    | 6 -> 30
    | 7 -> 31
    | 8 -> 31
    | 9 -> 30
    | 10 -> 31
    | 11 -> 30
    | 12 -> 31
    | _ -> Builtin.testRuntimeError("DateTime month must be between 1 and 12")

let __daysBeforeYearFrom(year: Int64, cursor: Int64, days: Int64) : Int64 =
    if cursor == year then days
    else if cursor < year then
        Stdlib.DateTime.__daysBeforeYearFrom(
            year,
            cursor + 1,
            days + Stdlib.DateTime.__daysInYear(cursor))
    else
        let previousYear = cursor - 1 in
        Stdlib.DateTime.__daysBeforeYearFrom(
            year,
            previousYear,
            days - Stdlib.DateTime.__daysInYear(previousYear))

let __daysBeforeYear(year: Int64) : Int64 =
    Stdlib.DateTime.__daysBeforeYearFrom(year, 1970, 0)

let __yearFromDays(days: Int64, year: Int64) : Int64 =
    if days >= 0 then
        let daysInYear = Stdlib.DateTime.__daysInYear(year) in
        if days < daysInYear then year
        else Stdlib.DateTime.__yearFromDays(days - daysInYear, year + 1)
    else
        let previousYear = year - 1 in
        let daysInPreviousYear = Stdlib.DateTime.__daysInYear(previousYear) in
        if days >= 0 - daysInPreviousYear then previousYear
        else Stdlib.DateTime.__yearFromDays(days + daysInPreviousYear, previousYear)

let __daysBeforeMonthFrom(month: Int64, year: Int64, cursor: Int64, days: Int64) : Int64 =
    if cursor >= month then days
    else
        Stdlib.DateTime.__daysBeforeMonthFrom(
            month,
            year,
            cursor + 1,
            days + Stdlib.DateTime.__daysInMonth(cursor, year))

let __daysBeforeMonth(month: Int64, year: Int64) : Int64 =
    Stdlib.DateTime.__daysBeforeMonthFrom(month, year, 1, 0)

let __monthFromDayOfYear(dayOfYear: Int64, month: Int64, year: Int64) : Int64 =
    let daysInMonth = Stdlib.DateTime.__daysInMonth(month, year) in
    if dayOfYear < daysInMonth then month
    else Stdlib.DateTime.__monthFromDayOfYear(dayOfYear - daysInMonth, month + 1, year)

let __milliseconds(d: DateTime) : Int64 =
    d

let __fromValidMilliseconds(milliseconds: Int64) : DateTime =
    milliseconds

let fromMilliseconds(milliseconds: Int64) : DateTime =
    if milliseconds < Stdlib.DateTime.__minimumMilliseconds() ||
       milliseconds > Stdlib.DateTime.__maximumMilliseconds() then
        Builtin.testRuntimeError("Encountered out-of-range value for type of Int")
    else
        Stdlib.DateTime.__fromValidMilliseconds(milliseconds)

let toMilliseconds(date: DateTime) : Int64 =
    Stdlib.DateTime.__milliseconds(date)

let fromSeconds_v0(seconds: Int64) : DateTime =
    let minimumSeconds = Stdlib.DateTime.__minimumMilliseconds() / 1000 in
    let maximumSeconds = Stdlib.DateTime.__maximumMilliseconds() / 1000 in
    if seconds < minimumSeconds || seconds > maximumSeconds then
        Builtin.testRuntimeError("Encountered out-of-range value for type of Int")
    else
        Stdlib.DateTime.__fromValidMilliseconds(seconds * 1000)

let fromSeconds(seconds: Int64) : DateTime =
    Stdlib.DateTime.fromSeconds_v0(seconds)

let toSeconds_v0(date: DateTime) : Int64 =
    Stdlib.DateTime.__floorDiv(Stdlib.DateTime.__milliseconds(date), 1000)

let toSeconds(date: DateTime) : Int64 =
    Stdlib.DateTime.toSeconds_v0(date)

let __addMilliseconds(date: DateTime, milliseconds: Int64) : DateTime =
    if milliseconds < 0 - Stdlib.DateTime.__maximumDeltaMilliseconds() ||
       milliseconds > Stdlib.DateTime.__maximumDeltaMilliseconds() then
        Builtin.testRuntimeError("Encountered out-of-range value for type of Int")
    else
        let result = Stdlib.DateTime.__milliseconds(date) + milliseconds in
        Stdlib.DateTime.fromMilliseconds(result)

let addMilliseconds(date: DateTime, milliseconds: Int64) : DateTime =
    Stdlib.DateTime.__addMilliseconds(date, milliseconds)

let subtractMilliseconds(date: DateTime, milliseconds: Int64) : DateTime =
    if milliseconds < 0 - Stdlib.DateTime.__maximumDeltaMilliseconds() ||
       milliseconds > Stdlib.DateTime.__maximumDeltaMilliseconds() then
        Builtin.testRuntimeError("Encountered out-of-range value for type of Int")
    else
        Stdlib.DateTime.fromMilliseconds(Stdlib.DateTime.__milliseconds(date) - milliseconds)

let addSeconds_v0(date: DateTime, seconds: Int64) : DateTime =
    let maximumDeltaSeconds = Stdlib.DateTime.__maximumDeltaMilliseconds() / 1000 in
    if seconds < 0 - maximumDeltaSeconds || seconds > maximumDeltaSeconds then
        Builtin.testRuntimeError("Encountered out-of-range value for type of Int")
    else
        Stdlib.DateTime.__addMilliseconds(date, seconds * 1000)

let addSeconds(date: DateTime, seconds: Int64) : DateTime =
    Stdlib.DateTime.addSeconds_v0(date, seconds)

let subtractSeconds(date: DateTime, seconds: Int64) : DateTime =
    let maximumDeltaSeconds = Stdlib.DateTime.__maximumDeltaMilliseconds() / 1000 in
    if seconds < 0 - maximumDeltaSeconds || seconds > maximumDeltaSeconds then
        Builtin.testRuntimeError("Encountered out-of-range value for type of Int")
    else
        Stdlib.DateTime.subtractMilliseconds(date, seconds * 1000)

let lessThan(left: DateTime, right: DateTime) : Bool =
    Stdlib.DateTime.__milliseconds(left) < Stdlib.DateTime.__milliseconds(right)

let lessThanOrEqualTo(left: DateTime, right: DateTime) : Bool =
    Stdlib.DateTime.__milliseconds(left) <= Stdlib.DateTime.__milliseconds(right)

let greaterThan(left: DateTime, right: DateTime) : Bool =
    Stdlib.DateTime.__milliseconds(left) > Stdlib.DateTime.__milliseconds(right)

let greaterThanOrEqualTo(left: DateTime, right: DateTime) : Bool =
    Stdlib.DateTime.__milliseconds(left) >= Stdlib.DateTime.__milliseconds(right)

let __roundMillisecondsToSeconds(milliseconds: Int64) : Int64 =
    let seconds = milliseconds / 1000 in
    let remainder = milliseconds % 1000 in
    let absoluteRemainder = if remainder < 0 then 0 - remainder else remainder in
    if absoluteRemainder < 500 then seconds
    else if absoluteRemainder > 500 then
        if milliseconds < 0 then seconds - 1 else seconds + 1
    else if seconds % 2 == 0 then seconds
    else if milliseconds < 0 then seconds - 1
    else seconds + 1

let subtract(endDate: DateTime, startDate: DateTime) : Int64 =
    Stdlib.DateTime.__roundMillisecondsToSeconds(
        Stdlib.DateTime.__milliseconds(endDate) - Stdlib.DateTime.__milliseconds(startDate))

let subtractMs(endDate: DateTime, startDate: DateTime) : Int64 =
    Stdlib.DateTime.__milliseconds(endDate) - Stdlib.DateTime.__milliseconds(startDate)

let __daysSinceEpoch(date: DateTime) : Int64 =
    Stdlib.DateTime.__floorDiv(
        Stdlib.DateTime.__milliseconds(date),
        Stdlib.DateTime.__millisecondsPerDay())

let year_v0(date: DateTime) : Int64 =
    Stdlib.DateTime.__yearFromDays(Stdlib.DateTime.__daysSinceEpoch(date), 1970)

let year(date: DateTime) : Int64 = Stdlib.DateTime.year_v0(date)

let month_v0(date: DateTime) : Int64 =
    let days = Stdlib.DateTime.__daysSinceEpoch(date) in
    let year = Stdlib.DateTime.year_v0(date) in
    let dayOfYear = days - Stdlib.DateTime.__daysBeforeYear(year) in
    Stdlib.DateTime.__monthFromDayOfYear(dayOfYear, 1, year)

let month(date: DateTime) : Int64 = Stdlib.DateTime.month_v0(date)

let day_v0(date: DateTime) : Int64 =
    let days = Stdlib.DateTime.__daysSinceEpoch(date) in
    let year = Stdlib.DateTime.year_v0(date) in
    let month = Stdlib.DateTime.month_v0(date) in
    let dayOfYear = days - Stdlib.DateTime.__daysBeforeYear(year) in
    dayOfYear - Stdlib.DateTime.__daysBeforeMonth(month, year) + 1

let day(date: DateTime) : Int64 = Stdlib.DateTime.day_v0(date)

let weekday_v0(date: DateTime) : Int64 =
    Stdlib.DateTime.__floorMod(Stdlib.DateTime.__daysSinceEpoch(date) + 3, 7) + 1

let weekday(date: DateTime) : Int64 = Stdlib.DateTime.weekday_v0(date)

let __millisecondsWithinDay(date: DateTime) : Int64 =
    Stdlib.DateTime.__floorMod(
        Stdlib.DateTime.__milliseconds(date),
        Stdlib.DateTime.__millisecondsPerDay())

let hour(date: DateTime) : Int64 =
    Stdlib.DateTime.__millisecondsWithinDay(date) / Stdlib.DateTime.__millisecondsPerHour()

let minute(date: DateTime) : Int64 =
    (Stdlib.DateTime.__millisecondsWithinDay(date) / Stdlib.DateTime.__millisecondsPerMinute()) % 60

let second(date: DateTime) : Int64 =
    (Stdlib.DateTime.__millisecondsWithinDay(date) / Stdlib.DateTime.__millisecondsPerSecond()) % 60

let millisecond(date: DateTime) : Int64 =
    Stdlib.DateTime.__millisecondsWithinDay(date) % 1000

let atStartOfDay_v0(date: DateTime) : DateTime =
    Stdlib.DateTime.__fromValidMilliseconds(
        Stdlib.DateTime.__daysSinceEpoch(date) * Stdlib.DateTime.__millisecondsPerDay())

let atStartOfDay(date: DateTime) : DateTime =
    Stdlib.DateTime.atStartOfDay_v0(date)

let now() : DateTime =
    Stdlib.DateTime.__fromValidMilliseconds(Stdlib.DateTime.__nowMilliseconds())

let now_v0() : DateTime = Stdlib.DateTime.now()

let today_v0() : DateTime =
    Stdlib.DateTime.atStartOfDay_v0(Stdlib.DateTime.now())

let today() : DateTime = Stdlib.DateTime.today_v0()

let __padZero2(value: Int64) : String =
    if value < 10 then "0" ++ Stdlib.Int64.toString(value)
    else Stdlib.Int64.toString(value)

let __padZero3(value: Int64) : String =
    if value < 10 then "00" ++ Stdlib.Int64.toString(value)
    else if value < 100 then "0" ++ Stdlib.Int64.toString(value)
    else Stdlib.Int64.toString(value)

let __padZero4(value: Int64) : String =
    if value < 10 then "000" ++ Stdlib.Int64.toString(value)
    else if value < 100 then "00" ++ Stdlib.Int64.toString(value)
    else if value < 1000 then "0" ++ Stdlib.Int64.toString(value)
    else Stdlib.Int64.toString(value)

let toString_v0(date: DateTime) : String =
    let dateAndTime =
        Stdlib.DateTime.__padZero4(Stdlib.DateTime.year_v0(date)) ++ "-" ++
        Stdlib.DateTime.__padZero2(Stdlib.DateTime.month_v0(date)) ++ "-" ++
        Stdlib.DateTime.__padZero2(Stdlib.DateTime.day_v0(date)) ++ "T" ++
        Stdlib.DateTime.__padZero2(Stdlib.DateTime.hour(date)) ++ ":" ++
        Stdlib.DateTime.__padZero2(Stdlib.DateTime.minute(date)) ++ ":" ++
        Stdlib.DateTime.__padZero2(Stdlib.DateTime.second(date)) in
    let millisecond = Stdlib.DateTime.millisecond(date) in
    if millisecond == 0 then dateAndTime ++ "Z"
    else dateAndTime ++ "." ++ Stdlib.DateTime.__padZero3(millisecond) ++ "Z"

let toString(date: DateTime) : String = Stdlib.DateTime.toString_v0(date)

let toStringISO8601BasicDate_v0(date: DateTime) : String =
    Stdlib.DateTime.__padZero4(Stdlib.DateTime.year_v0(date)) ++
    Stdlib.DateTime.__padZero2(Stdlib.DateTime.month_v0(date)) ++
    Stdlib.DateTime.__padZero2(Stdlib.DateTime.day_v0(date))

let toStringISO8601BasicDate(date: DateTime) : String =
    Stdlib.DateTime.toStringISO8601BasicDate_v0(date)

let toStringISO8601BasicDateTime_v0(date: DateTime) : String =
    Stdlib.DateTime.toStringISO8601BasicDate_v0(date) ++ "T" ++
    Stdlib.DateTime.__padZero2(Stdlib.DateTime.hour(date)) ++
    Stdlib.DateTime.__padZero2(Stdlib.DateTime.minute(date)) ++
    Stdlib.DateTime.__padZero2(Stdlib.DateTime.second(date)) ++ "Z"

let toStringISO8601BasicDateTime(date: DateTime) : String =
    Stdlib.DateTime.toStringISO8601BasicDateTime_v0(date)

let __digitAt(value: String, index: Int64) : Stdlib.Result.Result<Int64, String> =
    if index >= Stdlib.String.length(value) then Error("Invalid date format")
    else
        let byte = Stdlib.String.getByteAt(value, index) in
        if byte >= 48 && byte <= 57 then Ok(byte - 48)
        else Error("Invalid date format")

let __parseDigits(value: String, index: Int64, remaining: Int64, total: Int64) : Stdlib.Result.Result<(Int64, Int64), String> =
    if remaining == 0 then Ok((total, index))
    else
        match Stdlib.DateTime.__digitAt(value, index) with
        | Error(message) -> Error(message)
        | Ok(digit) -> Stdlib.DateTime.__parseDigits(value, index + 1, remaining - 1, total * 10 + digit)

let __hasByte(value: String, index: Int64, expected: Int64) : Bool =
    index < Stdlib.String.length(value) && Stdlib.String.getByteAt(value, index) == expected

let __toMilliseconds(year: Int64, month: Int64, day: Int64, hour: Int64, minute: Int64, second: Int64, millisecond: Int64) : Int64 =
    let days =
        Stdlib.DateTime.__daysBeforeYear(year) +
        Stdlib.DateTime.__daysBeforeMonth(month, year) +
        day - 1 in
    days * Stdlib.DateTime.__millisecondsPerDay() +
    hour * Stdlib.DateTime.__millisecondsPerHour() +
    minute * Stdlib.DateTime.__millisecondsPerMinute() +
    second * Stdlib.DateTime.__millisecondsPerSecond() +
    millisecond

let __parseParts(value: String, hasMilliseconds: Bool) : Stdlib.Result.Result<DateTime, String> =
    match Stdlib.DateTime.__parseDigits(value, 0, 4, 0) with
    | Error(message) -> Error(message)
    | Ok(yearPart) ->
        let (year, afterYear) = yearPart in
        match Stdlib.DateTime.__parseDigits(value, 5, 2, 0) with
        | Error(message) -> Error(message)
        | Ok(monthPart) ->
            let (month, afterMonth) = monthPart in
            match Stdlib.DateTime.__parseDigits(value, 8, 2, 0) with
            | Error(message) -> Error(message)
            | Ok(dayPart) ->
                let (day, afterDay) = dayPart in
                match Stdlib.DateTime.__parseDigits(value, 11, 2, 0) with
                | Error(message) -> Error(message)
                | Ok(hourPart) ->
                    let (hour, afterHour) = hourPart in
                    match Stdlib.DateTime.__parseDigits(value, 14, 2, 0) with
                    | Error(message) -> Error(message)
                    | Ok(minutePart) ->
                        let (minute, afterMinute) = minutePart in
                        match Stdlib.DateTime.__parseDigits(value, 17, 2, 0) with
                        | Error(message) -> Error(message)
                        | Ok(secondPart) ->
                            let (second, afterSecond) = secondPart in
                            let millisecondResult =
                                if hasMilliseconds then Stdlib.DateTime.__parseDigits(value, 20, 3, 0)
                                else Ok((0, 19)) in
                            match millisecondResult with
                            | Error(message) -> Error(message)
                            | Ok(millisecondPart) ->
                                let (millisecond, afterMillisecond) = millisecondPart in
                                let separatorsAreValid =
                                    afterYear == 4 && Stdlib.DateTime.__hasByte(value, 4, 45) &&
                                    afterMonth == 7 && Stdlib.DateTime.__hasByte(value, 7, 45) &&
                                    afterDay == 10 && Stdlib.DateTime.__hasByte(value, 10, 84) &&
                                    afterHour == 13 && Stdlib.DateTime.__hasByte(value, 13, 58) &&
                                    afterMinute == 16 && Stdlib.DateTime.__hasByte(value, 16, 58) &&
                                    afterSecond == 19 &&
                                    ((hasMilliseconds &&
                                      Stdlib.DateTime.__hasByte(value, 19, 46) &&
                                      afterMillisecond == 23 &&
                                      Stdlib.DateTime.__hasByte(value, 23, 90)) ||
                                     ((!hasMilliseconds) && Stdlib.DateTime.__hasByte(value, 19, 90))) in
                                let fieldsAreValid =
                                    year >= 1 &&
                                    month >= 1 && month <= 12 &&
                                    day >= 1 && day <= Stdlib.DateTime.__daysInMonth(month, year) &&
                                    hour >= 0 && hour <= 23 &&
                                    minute >= 0 && minute <= 59 &&
                                    second >= 0 && second <= 59 in
                                if separatorsAreValid && fieldsAreValid then
                                    Ok(Stdlib.DateTime.__fromValidMilliseconds(
                                        Stdlib.DateTime.__toMilliseconds(
                                            year, month, day, hour, minute, second, millisecond)))
                                else Error("Invalid date format")

let parse(value: String) : Stdlib.Result.Result<DateTime, String> =
    let length = Stdlib.String.length(value) in
    if length == 20 then Stdlib.DateTime.__parseParts(value, false)
    else if length == 24 then Stdlib.DateTime.__parseParts(value, true)
    else Error("Invalid date format")
