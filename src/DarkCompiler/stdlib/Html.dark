let document(nodes: List<Stdlib.Html.Node>) : String =
    "<!DOCTYPE html>" ++
    Stdlib.String.join(
        Stdlib.List.map<Stdlib.Html.Node, String>(nodes, Stdlib.Html.nodeToString),
        "")
