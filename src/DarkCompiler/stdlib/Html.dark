// Stdlib.Html - canonical, portable HTML node construction and serialization.

module Stdlib.Html

type Attribute = List<(String, Stdlib.Option.Option<String>)>
type Attributes = List<(String, Stdlib.Option.Option<String>)>

type HtmlTag = {
    name: String,
    attrs: Stdlib.Html.Attributes,
    children: List<Stdlib.Html.Node>
}

type Node = String of String | HtmlTag of Stdlib.Html.HtmlTag

let escapeHtml(str: String) : String =
    Stdlib.String.replace(
        Stdlib.String.replace(
            Stdlib.String.replace(
                Stdlib.String.replace(
                    Stdlib.String.replace(str, "&", "&amp;"),
                    "<",
                    "&lt;"),
                ">",
                "&gt;"),
            "\"",
            "&quot;"),
        "'",
        "&#x27;")

let text(str: String) : Stdlib.Html.Node =
    Stdlib.Html.Node.String(Stdlib.Html.escapeHtml(str))

let stringNode(str: String) : Stdlib.Html.Node =
    Stdlib.Html.Node.String(str)

let htmlTagNode(
    name: String,
    attrs: Stdlib.Html.Attributes,
    children: List<Stdlib.Html.Node>
) : Stdlib.Html.Node =
    Stdlib.Html.Node.HtmlTag(
        Stdlib.Html.HtmlTag {
            name = name,
            attrs = attrs,
            children = children
        })

let __attributeToString(attr: (String, Stdlib.Option.Option<String>)) : String =
    match attr with
    | (key, Some(value)) -> key ++ "=\"" ++ value ++ "\""
    | (key, None) -> key

let __attributesToString(attrs: Stdlib.Html.Attributes) : String =
    Stdlib.String.join(
        Stdlib.List.map<(String, Stdlib.Option.Option<String>), String>(
            attrs,
            Stdlib.Html.__attributeToString),
        " ")

let __isVoidElement(name: String) : Bool =
    Stdlib.List.member<String>(
        [ "area"; "base"; "br"; "col"; "command"; "embed"; "hr"; "img"
          "input"; "keygen"; "link"; "meta"; "param"; "source"; "track"; "wbr" ],
        name)

let nodeToString(node: Stdlib.Html.Node) : String =
    match node with
    | String(str) -> str
    | HtmlTag(tag) ->
        let attributesText = Stdlib.Html.__attributesToString(tag.attrs) in
        let startTag =
            if attributesText == "" then "<" ++ tag.name ++ ">"
            else "<" ++ tag.name ++ " " ++ attributesText ++ ">" in
        if Stdlib.Html.__isVoidElement(tag.name) then
            startTag
        else
            let childHtml =
                Stdlib.String.join(
                    Stdlib.List.map<Stdlib.Html.Node, String>(
                        tag.children,
                        Stdlib.Html.nodeToString),
                    "") in
            startTag ++ childHtml ++ "</" ++ tag.name ++ ">"

let comment(value: String) : Stdlib.Html.Node =
    Stdlib.Html.stringNode("<!-- " ++ value ++ " -->")

let classes(classList: List<String>) : (String, Stdlib.Option.Option<String>) =
    ("class", Some(Stdlib.String.join(classList, " ")))

let __styleProperty(property: (String, String)) : String =
    property.0 ++ ": " ++ property.1

let style(properties: List<(String, String)>) : (String, Stdlib.Option.Option<String>) =
    let rendered =
        Stdlib.List.map<(String, String), String>(
            properties,
            Stdlib.Html.__styleProperty) in
    ("style", Some(Stdlib.String.join(rendered, "; ")))

let dataAttr(name: String, value: String) : (String, Stdlib.Option.Option<String>) =
    ("data-" ++ name, Some(value))

let __emptyAttributes() : Stdlib.Html.Attributes = []

let br() : Stdlib.Html.Node = Stdlib.Html.htmlTagNode("br", Stdlib.Html.__emptyAttributes(), [])
let html(attrs: Stdlib.Html.Attributes, children: List<Stdlib.Html.Node>) : Stdlib.Html.Node = Stdlib.Html.htmlTagNode("html", attrs, children)
let body(attrs: Stdlib.Html.Attributes, children: List<Stdlib.Html.Node>) : Stdlib.Html.Node = Stdlib.Html.htmlTagNode("body", attrs, children)
