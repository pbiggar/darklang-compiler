// Stdlib.Math.dark - Stdlib.Math definitions
//
// Split from stdlib.dark for modular stdlib loading.

module Stdlib.Math

// Stdlib.Math - Mathematical operations
// =============================================================================

// Pi constant (approximation to 15 decimal places)
// 3.141592653589793
let pi() : Float = 3.141592653589793

// Tau constant, exactly twice pi
let tau() : Float = 2.0 * Stdlib.Math.pi()

// Euler's number e (approximation to 15 decimal places)
// 2.718281828459045
let e() : Float = 2.718281828459045

// Absolute value of a float
let abs(x: Float) : Float =
    Stdlib.Float.abs(x)

// Square root (delegating to existing Stdlib.Float.sqrt)
let sqrt(x: Float) : Float =
    Stdlib.Float.sqrt(x)

// Convert float to integer, truncating toward zero
let truncate(x: Float) : Int64 =
    Stdlib.Float.toInt(x)

// Floor: largest integer less than or equal to x
let floor(x: Float) : Int64 =
    let truncated = Stdlib.Float.toInt(x) in
    if x < Stdlib.Int64.toFloat(truncated) then truncated - 1 else truncated

// Ceiling: smallest integer greater than or equal to x
let ceiling(x: Float) : Int64 =
    let truncated = Stdlib.Float.toInt(x) in
    if x > Stdlib.Int64.toFloat(truncated) then truncated + 1 else truncated

// Round to nearest integer, with half values rounded to the nearest even integer
let round(x: Float) : Int64 =
    let lower = Stdlib.Math.floor(x) in
    let upper = Stdlib.Math.ceiling(x) in
    let distanceFromLower = x - Stdlib.Int64.toFloat(lower) in
    if distanceFromLower < 0.5 then lower
    else if distanceFromLower > 0.5 then upper
    else if lower % 2 == 0 then lower
    else upper

// Angle-unit helpers ported from darklang/dark packages/darklang/stdlib/math.dark.
let degrees(angleInDegrees: Float) : Float =
    (angleInDegrees * Stdlib.Math.pi()) / 180.0

let turns(angleInTurns: Float) : Float =
    Stdlib.Math.tau() * angleInTurns

let radians(angleInRadians: Float) : Float =
    angleInRadians

// NOTE: The following functions still require compiler/runtime support:
// - Stdlib.Math.pow (needs float multiplication)
// - Trigonometric functions (sin, cos, tan) require intrinsics


// =============================================================================
