// Stdlib.Int16.dark - Stdlib.Int16 definitions
//
// Split from stdlib.dark for modular stdlib loading.

module Stdlib.Int16

type ParseError = BadFormat | OutOfRange

// Stdlib.Int16 - Integer operations

let add(a: Int16, b: Int16) : Int16 = a + b

let subtract(a: Int16, b: Int16) : Int16 = a - b

let multiply(a: Int16, b: Int16) : Int16 = a * b

let divide(a: Int16, b: Int16) : Int16 =
    if b == 0s then Builtin.crash("Cannot divide by 0")
    else if a == -32768s && b == -1s then -32768s
    else a / b

let max(a: Int16, b: Int16) : Int16 = if a > b then a else b

let min(a: Int16, b: Int16) : Int16 = if a < b then a else b

let mod(a: Int16, b: Int16) : Int16 =
    if b == 0s then Builtin.crash("Cannot evaluate modulus against 0")
    else if b < 0s then Builtin.crash("Cannot evaluate modulus against a negative number")
    else a % b

let remainder(a: Int16, b: Int16) : Stdlib.Result.Result<Int16, String> =
    if b == 0s then Error("Cannot divide by 0")
    else if b == -1s then Ok(0s)
    else Ok(a - ((a / b) * b))

let absoluteValue(a: Int16) : Int16 = if a < 0s then 0s - a else a

let negate(a: Int16) : Int16 = 0s - a

let __powerLoop(base: Int16, exponent: Int16, result: Int16) : Int16 =
    if exponent == 0s then result
    else
        let next = if (exponent % 2s) == 1s then result * base else result in
        Stdlib.Int16.__powerLoop(base * base, exponent / 2s, next)

let power(base: Int16, exponent: Int16) : Int16 =
    if exponent < 0s then Builtin.crash("Cannot raise integer to a negative exponent")
    else Stdlib.Int16.__powerLoop(base, exponent, 1s)

let clamp(value: Int16, limitA: Int16, limitB: Int16) : Int16 =
    let lower = Stdlib.Int16.min(limitA, limitB) in
    let upper = Stdlib.Int16.max(limitA, limitB) in
    Stdlib.Int16.max(lower, Stdlib.Int16.min(upper, value))

let greaterThan(a: Int16, b: Int16) : Bool = a > b

let greaterThanOrEqualTo(a: Int16, b: Int16) : Bool = a >= b

let lessThan(a: Int16, b: Int16) : Bool = a < b

let lessThanOrEqualTo(a: Int16, b: Int16) : Bool = a <= b

// Bitwise operations
let bitwiseAnd(a: Int16, b: Int16) : Int16 = a & b

let bitwiseOr(a: Int16, b: Int16) : Int16 = a ||| b

let bitwiseXor(a: Int16, b: Int16) : Int16 = (a ||| b) & ~~~(a & b)

let shiftLeft(a: Int16, shift: Int16) : Int16 = a << shift

let shiftRight(a: Int16, shift: Int16) : Int16 = a >> shift

let bitwiseNot(a: Int16) : Int16 = ~~~a

// Count number of set bits (population count)
// Uses parallel bit counting algorithm (SWAR)
let popcount(x: Int16) : Int16 =
    let mask1 = 21845s in
    let mask2 = 13107s in
    let mask3 = 3855s in
    let mask4 = 31s in
    let x = x - ((x >> 1s) & mask1) in
    let x = (x & mask2) + ((x >> 2s) & mask2) in
    let x = (x + (x >> 4s)) & mask3 in
    let x = x + (x >> 8s) in
    x & mask4

// Convert a single digit (0-9) to its string representation
let __digitToString(n: Int16) : String =
    match n with
    | 0s -> "0"
    | 1s -> "1"
    | 2s -> "2"
    | 3s -> "3"
    | 4s -> "4"
    | 5s -> "5"
    | 6s -> "6"
    | 7s -> "7"
    | 8s -> "8"
    | 9s -> "9"
    | _ -> "?"

// Convert an integer to its string representation
let toString(n: Int16) : String =
    if n < 0s then
        if n < -9s then
            let quotient = n / 10s in
            Stdlib.Int16.toString(quotient) ++ Stdlib.Int16.__digitToString(0s - (n - (quotient * 10s)))
        else "-" ++ Stdlib.Int16.__digitToString(0s - n)
    else if n < 10s then Stdlib.Int16.__digitToString(n)
    else Stdlib.Int16.toString(n / 10s) ++ Stdlib.Int16.__digitToString(n % 10s)

// Check if integer is even
let isEven(n: Int16) : Bool =
    (n % 2s) == 0s

// Check if integer is odd
let isOdd(n: Int16) : Bool =
    (n % 2s) != 0s

// Sum all integers in a list
let sum(list: List<Int16>) : Int16 =
    Stdlib.List.fold<Int16, Int16>(list, 0s, fun acc x -> acc + x)

let __fromIntUnchecked(value: Int) : Int16 =
    match Stdlib.Int.toInt16(value) with
    | Some(result) -> result
    | None -> Builtin.crash("Internal Int16 conversion invariant failed")
let random(start: Int16, finish: Int16) : Int16 = Stdlib.Int16.__fromIntUnchecked(Stdlib.Int.random(Stdlib.Int.fromInt16(start), Stdlib.Int.fromInt16(finish)))
let toFloat(value: Int16) : Float = Stdlib.Int.toFloat(Stdlib.Int.fromInt16(value))
let sqrt(value: Int16) : Float = Stdlib.Float.sqrt(Stdlib.Int16.toFloat(value))
let parse(value: String) : Stdlib.Result.Result<Int16, Stdlib.Int16.ParseError> =
    match Stdlib.Int.parse(value) with
    | Error(_) -> Error(Stdlib.Int16.ParseError.BadFormat)
    | Ok(parsed) ->
        match Stdlib.Int.toInt16(parsed) with
        | None -> Error(Stdlib.Int16.ParseError.OutOfRange)
        | Some(result) -> Ok(result)
let fromInt8(value: Int8) : Int16 = Stdlib.Int16.__fromIntUnchecked(Stdlib.Int.fromInt8(value))
let fromUInt8(value: UInt8) : Int16 = Stdlib.Int16.__fromIntUnchecked(Stdlib.Int.fromUInt8(value))
let fromUInt16(value: UInt16) : Stdlib.Option.Option<Int16> = Stdlib.Int.toInt16(Stdlib.Int.fromUInt16(value))
let fromInt32(value: Int32) : Stdlib.Option.Option<Int16> = Stdlib.Int.toInt16(Stdlib.Int.fromInt32(value))
let fromUInt32(value: UInt32) : Stdlib.Option.Option<Int16> = Stdlib.Int.toInt16(Stdlib.Int.fromUInt32(value))
let fromInt64(value: Int64) : Stdlib.Option.Option<Int16> = Stdlib.Int.toInt16(Stdlib.Int.fromInt64(value))
let fromUInt64(value: UInt64) : Stdlib.Option.Option<Int16> = Stdlib.Int.toInt16(Stdlib.Int.fromUInt64(value))
let fromInt128(value: Int128) : Stdlib.Option.Option<Int16> = Stdlib.Int.toInt16(Stdlib.Int.fromInt128(value))
let fromUInt128(value: UInt128) : Stdlib.Option.Option<Int16> = Stdlib.Int.toInt16(Stdlib.Int.fromUInt128(value))
