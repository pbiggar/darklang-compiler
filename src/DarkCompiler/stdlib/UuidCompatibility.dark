// UuidCompatibility.dark - explicitly isolated compiler compatibility surface.
//
// This is not part of the canonical interpreter-compatible Stdlib.Uuid API.
// It preserves the historic String parser solely for source compatibility.

module Stdlib.Uuid.Compatibility

type ParseError = | BadFormat | UnsupportedUuidParseError

let __isHexByte(byte: Int64) : Bool =
    (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 70) || (byte >= 97 && byte <= 102)

let __hasValidFormatAt(s: String, index: Int64) : Bool =
    if index == 36 then true
    else
        let byte = Stdlib.String.getByteAt(s, index) in
        if index == 8 || index == 13 || index == 18 || index == 23 then byte == 45 && Stdlib.Uuid.Compatibility.__hasValidFormatAt(s, index + 1)
        else Stdlib.Uuid.Compatibility.__isHexByte(byte) && Stdlib.Uuid.Compatibility.__hasValidFormatAt(s, index + 1)

let parse_v0(s: String) : Stdlib.Result.Result<String, Stdlib.Uuid.Compatibility.ParseError> =
    if Stdlib.String.__byteLength(s) == 36 && Stdlib.Uuid.Compatibility.__hasValidFormatAt(s, 0) then Ok(s)
    else Error(Stdlib.Uuid.Compatibility.ParseError.BadFormat)
