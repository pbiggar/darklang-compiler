// Stdlib.Int32.dark - Stdlib.Int32 definitions
//
// Split from stdlib.dark for modular stdlib loading.

module Stdlib.Int32

// Stdlib.Int32 - Integer operations

let add(a: Int32, b: Int32) : Int32 = a + b

let sub(a: Int32, b: Int32) : Int32 = a - b

let mul(a: Int32, b: Int32) : Int32 = a * b

let div(a: Int32, b: Int32) : Int32 = a / b

let max(a: Int32, b: Int32) : Int32 = if a > b then a else b

let min(a: Int32, b: Int32) : Int32 = if a < b then a else b

let mod(a: Int32, b: Int32) : Int32 = a % b

let absoluteValue(a: Int32) : Int32 = if a < 0l then 0l - a else a

let negate(a: Int32) : Int32 = 0l - a

let power(base: Int32, exponent: Int32) : Int32 =
    if exponent < 0l then Builtin.testRuntimeError("Cannot raise integer to a negative exponent")
    else if exponent == 0l then 1l
    else if exponent == 1l then base
    else base * Stdlib.Int32.power(base, exponent - 1l)

let clamp(value: Int32, limitA: Int32, limitB: Int32) : Int32 =
    let lower = Stdlib.Int32.min(limitA, limitB) in
    let upper = Stdlib.Int32.max(limitA, limitB) in
    Stdlib.Int32.max(lower, Stdlib.Int32.min(upper, value))

let greaterThan(a: Int32, b: Int32) : Bool = a > b

let greaterThanOrEqualTo(a: Int32, b: Int32) : Bool = a >= b

let lessThan(a: Int32, b: Int32) : Bool = a < b

let lessThanOrEqualTo(a: Int32, b: Int32) : Bool = a <= b

// Bitwise operations
let bitwiseAnd(a: Int32, b: Int32) : Int32 = a & b

let bitwiseOr(a: Int32, b: Int32) : Int32 = a ||| b

let bitwiseXor(a: Int32, b: Int32) : Int32 = a ^ b

let shiftLeft(a: Int32, shift: Int32) : Int32 = a << shift

let shiftRight(a: Int32, shift: Int32) : Int32 = a >> shift

let bitwiseNot(a: Int32) : Int32 = ~~~a

// Count number of set bits (population count)
// Uses parallel bit counting algorithm (SWAR)
let popcount(x: Int32) : Int32 =
    let mask1 = 1431655765l in
    let mask2 = 858993459l in
    let mask3 = 252645135l in
    let mask4 = 63l in
    let x = x - ((x >> 1l) & mask1) in
    let x = (x & mask2) + ((x >> 2l) & mask2) in
    let x = (x + (x >> 4l)) & mask3 in
    let x = x + (x >> 8l) in
    let x = x + (x >> 16l) in
    x & mask4

// Convert a single digit (0-9) to its string representation
let __digitToString(n: Int32) : String =
    match n with
    | 0l -> "0"
    | 1l -> "1"
    | 2l -> "2"
    | 3l -> "3"
    | 4l -> "4"
    | 5l -> "5"
    | 6l -> "6"
    | 7l -> "7"
    | 8l -> "8"
    | 9l -> "9"
    | _ -> Builtin.testRuntimeError("Stdlib.Int32.__digitToString expected a digit from 0 to 9")

// Convert an integer to its string representation
let toString(n: Int32) : String =
    if n < 0l then
        if n < -9l then
            let quotient = n / 10l in
            Stdlib.Int32.toString(quotient) ++ Stdlib.Int32.__digitToString(0l - (n - (quotient * 10l)))
        else "-" ++ Stdlib.Int32.__digitToString(0l - n)
    else if n < 10l then Stdlib.Int32.__digitToString(n)
    else Stdlib.Int32.toString(n / 10l) ++ Stdlib.Int32.__digitToString(n % 10l)

// Check if integer is even
let isEven(n: Int32) : Bool =
    (n % 2l) == 0l

// Check if integer is odd
let isOdd(n: Int32) : Bool =
    (n % 2l) != 0l

// Sum all integers in a list
let sum(list: List<Int32>) : Int32 =
    Stdlib.List.fold<Int32, Int32>(list, 0l, fun acc x -> acc + x)
