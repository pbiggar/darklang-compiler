// __SkewList.dark - Direct-payload skew-binary random-access lists.
//
// The public List type is represented as a short spine of complete binary trees.
// Every owned pointer slot participates in the compiler's normal typed reference
// counting; read-only accessors return borrowed values.

module Stdlib.Internal.SkewList

// Low pointer tags. Empty is the null pointer rather than an allocation.
let __TAG_EMPTY() : Int64 = 0
let __TAG_DIGIT() : Int64 = 1
let __TAG_LEAF() : Int64 = 2
let __TAG_NODE() : Int64 = 3

// Digit layout: [weight][suffix length][tree][rest][refcount].
let __DIGIT_WEIGHT_OFF() : Int64 = 0
let __DIGIT_LENGTH_OFF() : Int64 = 8
let __DIGIT_TREE_OFF() : Int64 = 16
let __DIGIT_REST_OFF() : Int64 = 24
let __DIGIT_RC_OFF() : Int64 = 32

// Leaf layout: [value][refcount].
let __LEAF_VALUE_OFF() : Int64 = 0
let __LEAF_RC_OFF() : Int64 = 8

// Internal tree layout: [value][left][right][refcount].
let __NODE_VALUE_OFF() : Int64 = 0
let __NODE_LEFT_OFF() : Int64 = 8
let __NODE_RIGHT_OFF() : Int64 = 16
let __NODE_RC_OFF() : Int64 = 24

let __getTag<'a>(value: List<a>) : Int64 =
    __list_get_tag<a>(value)

let __toRawPtr<'a>(value: List<a>) : RawPtr =
    __list_to_rawptr<a>(value)

let __fromRawPtr<'a>(ptr: RawPtr, tag: Int64) : List<a> =
    __rawptr_to_list<a>(ptr, tag)

let __isNull<'a>(value: List<a>) : Bool =
    __list_is_null<a>(value)

let __allocLeaf<'a>(value: a) : List<a> =
    let ptr = __raw_alloc(16) in
    let _ = __raw_slot_init<a>(ptr, Stdlib.Internal.SkewList.__LEAF_VALUE_OFF(), value) in
    let _ = __raw_write_word(ptr, Stdlib.Internal.SkewList.__LEAF_RC_OFF(), 1) in
    Stdlib.Internal.SkewList.__fromRawPtr<a>(ptr, Stdlib.Internal.SkewList.__TAG_LEAF())

let __allocNode<'a>(value: a, left: List<a>, right: List<a>) : List<a> =
    let ptr = __raw_alloc(32) in
    let _ = __raw_slot_init<a>(ptr, Stdlib.Internal.SkewList.__NODE_VALUE_OFF(), value) in
    let _ = __raw_slot_init<List<a>>(ptr, Stdlib.Internal.SkewList.__NODE_LEFT_OFF(), left) in
    let _ = __raw_slot_init<List<a>>(ptr, Stdlib.Internal.SkewList.__NODE_RIGHT_OFF(), right) in
    let _ = __raw_write_word(ptr, Stdlib.Internal.SkewList.__NODE_RC_OFF(), 1) in
    Stdlib.Internal.SkewList.__fromRawPtr<a>(ptr, Stdlib.Internal.SkewList.__TAG_NODE())

let __allocDigit<'a>(weight: Int64, length: Int64, tree: List<a>, rest: List<a>) : List<a> =
    let ptr = __raw_alloc(40) in
    let _ = __raw_write_word(ptr, Stdlib.Internal.SkewList.__DIGIT_WEIGHT_OFF(), weight) in
    let _ = __raw_write_word(ptr, Stdlib.Internal.SkewList.__DIGIT_LENGTH_OFF(), length) in
    let _ = __raw_slot_init<List<a>>(ptr, Stdlib.Internal.SkewList.__DIGIT_TREE_OFF(), tree) in
    let _ = __raw_slot_init<List<a>>(ptr, Stdlib.Internal.SkewList.__DIGIT_REST_OFF(), rest) in
    let _ = __raw_write_word(ptr, Stdlib.Internal.SkewList.__DIGIT_RC_OFF(), 1) in
    Stdlib.Internal.SkewList.__fromRawPtr<a>(ptr, Stdlib.Internal.SkewList.__TAG_DIGIT())

let __digitWeight<'a>(digit: List<a>) : Int64 =
    __raw_get<Int64>(Stdlib.Internal.SkewList.__toRawPtr<a>(digit), Stdlib.Internal.SkewList.__DIGIT_WEIGHT_OFF())

let __digitLength<'a>(digit: List<a>) : Int64 =
    __raw_get<Int64>(Stdlib.Internal.SkewList.__toRawPtr<a>(digit), Stdlib.Internal.SkewList.__DIGIT_LENGTH_OFF())

let __digitTree<'a>(digit: List<a>) : List<a> =
    __raw_get<List<a>>(Stdlib.Internal.SkewList.__toRawPtr<a>(digit), Stdlib.Internal.SkewList.__DIGIT_TREE_OFF())

let __digitRest<'a>(digit: List<a>) : List<a> =
    __raw_get<List<a>>(Stdlib.Internal.SkewList.__toRawPtr<a>(digit), Stdlib.Internal.SkewList.__DIGIT_REST_OFF())

let __treeValue<'a>(tree: List<a>) : a =
    __raw_get<a>(Stdlib.Internal.SkewList.__toRawPtr<a>(tree), 0)

let __nodeLeft<'a>(tree: List<a>) : List<a> =
    __raw_get<List<a>>(Stdlib.Internal.SkewList.__toRawPtr<a>(tree), Stdlib.Internal.SkewList.__NODE_LEFT_OFF())

let __nodeRight<'a>(tree: List<a>) : List<a> =
    __raw_get<List<a>>(Stdlib.Internal.SkewList.__toRawPtr<a>(tree), Stdlib.Internal.SkewList.__NODE_RIGHT_OFF())

let empty<'a>() : List<a> =
    __list_empty<a>()

let isEmpty<'a>(list: List<a>) : Bool =
    Stdlib.Internal.SkewList.__isNull<a>(list)

let length<'a>(list: List<a>) : Int64 =
    if Stdlib.Internal.SkewList.__isNull<a>(list) then 0
    else Stdlib.Internal.SkewList.__digitLength<a>(list)

let __lengthFloat(list: List<Float>) : Int64 =
    Stdlib.Internal.SkewList.length<Float>(list)

let singleton<'a>(value: a) : List<a> =
    let tree = Stdlib.Internal.SkewList.__allocLeaf<a>(value) in
    Stdlib.Internal.SkewList.__allocDigit<a>(1, 1, tree, Stdlib.Internal.SkewList.empty<a>())

// Prepend in worst-case O(1). Equal leading weights perform one skew carry.
let push<'a>(list: List<a>, value: a) : List<a> =
    if Stdlib.Internal.SkewList.__isNull<a>(list) then
        Stdlib.Internal.SkewList.singleton<a>(value)
    else
        let firstRest = Stdlib.Internal.SkewList.__digitRest<a>(list) in
        if Stdlib.Internal.SkewList.__isNull<a>(firstRest) then
            let tree = Stdlib.Internal.SkewList.__allocLeaf<a>(value) in
            Stdlib.Internal.SkewList.__allocDigit<a>(1, Stdlib.Internal.SkewList.__digitLength<a>(list) + 1, tree, list)
        else
            let firstWeight = Stdlib.Internal.SkewList.__digitWeight<a>(list) in
            let secondWeight = Stdlib.Internal.SkewList.__digitWeight<a>(firstRest) in
            if firstWeight == secondWeight then
                let tree = Stdlib.Internal.SkewList.__allocNode<a>(value, Stdlib.Internal.SkewList.__digitTree<a>(list), Stdlib.Internal.SkewList.__digitTree<a>(firstRest)) in
                Stdlib.Internal.SkewList.__allocDigit<a>(firstWeight + firstWeight + 1, Stdlib.Internal.SkewList.__digitLength<a>(list) + 1, tree, Stdlib.Internal.SkewList.__digitRest<a>(firstRest))
            else
                let tree = Stdlib.Internal.SkewList.__allocLeaf<a>(value) in
                Stdlib.Internal.SkewList.__allocDigit<a>(1, Stdlib.Internal.SkewList.__digitLength<a>(list) + 1, tree, list)

let headUnsafe<'a>(list: List<a>) : a =
    Stdlib.Internal.SkewList.__treeValue<a>(Stdlib.Internal.SkewList.__digitTree<a>(list))

let head<'a>(list: List<a>) : Stdlib.Option.Option<a> =
    if Stdlib.Internal.SkewList.__isNull<a>(list) then None
    else Some(Stdlib.Internal.SkewList.headUnsafe<a>(list))

// Remove the first element in worst-case O(1), splitting one complete tree.
let tail<'a>(list: List<a>) : List<a> =
    if Stdlib.Internal.SkewList.__isNull<a>(list) then
        Stdlib.Internal.SkewList.empty<a>()
    else
        let weight = Stdlib.Internal.SkewList.__digitWeight<a>(list) in
        if weight == 1 then
            Stdlib.Internal.SkewList.__digitRest<a>(list)
        else
            let tree = Stdlib.Internal.SkewList.__digitTree<a>(list) in
            let childWeight = (weight - 1) / 2 in
            let newLength = Stdlib.Internal.SkewList.__digitLength<a>(list) - 1 in
            let rightDigit = Stdlib.Internal.SkewList.__allocDigit<a>(childWeight, newLength - childWeight, Stdlib.Internal.SkewList.__nodeRight<a>(tree), Stdlib.Internal.SkewList.__digitRest<a>(list)) in
            Stdlib.Internal.SkewList.__allocDigit<a>(childWeight, newLength, Stdlib.Internal.SkewList.__nodeLeft<a>(tree), rightDigit)

let __treeGetAt<'a>(tree: List<a>, weight: Int64, index: Int64) : a =
    if index == 0 then
        Stdlib.Internal.SkewList.__treeValue<a>(tree)
    else
        let childWeight = (weight - 1) / 2 in
        if index <= childWeight then
            Stdlib.Internal.SkewList.__treeGetAt<a>(Stdlib.Internal.SkewList.__nodeLeft<a>(tree), childWeight, index - 1)
        else
            Stdlib.Internal.SkewList.__treeGetAt<a>(Stdlib.Internal.SkewList.__nodeRight<a>(tree), childWeight, index - childWeight - 1)

let __digitsGetAt<'a>(digits: List<a>, index: Int64) : a =
    let weight = Stdlib.Internal.SkewList.__digitWeight<a>(digits) in
    if index < weight then
        Stdlib.Internal.SkewList.__treeGetAt<a>(Stdlib.Internal.SkewList.__digitTree<a>(digits), weight, index)
    else
        Stdlib.Internal.SkewList.__digitsGetAt<a>(Stdlib.Internal.SkewList.__digitRest<a>(digits), index - weight)

let getAt<'a>(list: List<a>, index: Int64) : Stdlib.Option.Option<a> =
    if index < 0 then None
    else if index >= Stdlib.Internal.SkewList.length<a>(list) then None
    else Some(Stdlib.Internal.SkewList.__digitsGetAt<a>(list, index))

let __treeSetAt<'a>(tree: List<a>, weight: Int64, index: Int64, replacement: a) : List<a> =
    if weight == 1 then
        Stdlib.Internal.SkewList.__allocLeaf<a>(replacement)
    else if index == 0 then
        Stdlib.Internal.SkewList.__allocNode<a>(replacement, Stdlib.Internal.SkewList.__nodeLeft<a>(tree), Stdlib.Internal.SkewList.__nodeRight<a>(tree))
    else
        let childWeight = (weight - 1) / 2 in
        if index <= childWeight then
            let newLeft = Stdlib.Internal.SkewList.__treeSetAt<a>(Stdlib.Internal.SkewList.__nodeLeft<a>(tree), childWeight, index - 1, replacement) in
            Stdlib.Internal.SkewList.__allocNode<a>(Stdlib.Internal.SkewList.__treeValue<a>(tree), newLeft, Stdlib.Internal.SkewList.__nodeRight<a>(tree))
        else
            let newRight = Stdlib.Internal.SkewList.__treeSetAt<a>(Stdlib.Internal.SkewList.__nodeRight<a>(tree), childWeight, index - childWeight - 1, replacement) in
            Stdlib.Internal.SkewList.__allocNode<a>(Stdlib.Internal.SkewList.__treeValue<a>(tree), Stdlib.Internal.SkewList.__nodeLeft<a>(tree), newRight)

let __digitsSetAt<'a>(digits: List<a>, index: Int64, replacement: a) : List<a> =
    let weight = Stdlib.Internal.SkewList.__digitWeight<a>(digits) in
    if index < weight then
        let newTree = Stdlib.Internal.SkewList.__treeSetAt<a>(Stdlib.Internal.SkewList.__digitTree<a>(digits), weight, index, replacement) in
        Stdlib.Internal.SkewList.__allocDigit<a>(weight, Stdlib.Internal.SkewList.__digitLength<a>(digits), newTree, Stdlib.Internal.SkewList.__digitRest<a>(digits))
    else
        let newRest = Stdlib.Internal.SkewList.__digitsSetAt<a>(Stdlib.Internal.SkewList.__digitRest<a>(digits), index - weight, replacement) in
        Stdlib.Internal.SkewList.__allocDigit<a>(weight, Stdlib.Internal.SkewList.__digitLength<a>(digits), Stdlib.Internal.SkewList.__digitTree<a>(digits), newRest)

let setAt<'a>(list: List<a>, index: Int64, replacement: a) : List<a> =
    if index < 0 then list
    else if index >= Stdlib.Internal.SkewList.length<a>(list) then list
    else Stdlib.Internal.SkewList.__digitsSetAt<a>(list, index, replacement)

// Preserve the forest shape so map allocates exactly one output tree node per
// element and one output digit per source digit.
let __mapTree<'a, 'b>(tree: List<a>, fn: (a) -> b) : List<b> =
    if Stdlib.Internal.SkewList.__getTag<a>(tree) == Stdlib.Internal.SkewList.__TAG_LEAF() then
        Stdlib.Internal.SkewList.__allocLeaf<b>(fn(Stdlib.Internal.SkewList.__treeValue<a>(tree)))
    else
        let mappedValue = fn(Stdlib.Internal.SkewList.__treeValue<a>(tree)) in
        let mappedLeft = Stdlib.Internal.SkewList.__mapTree<a, b>(Stdlib.Internal.SkewList.__nodeLeft<a>(tree), fn) in
        let mappedRight = Stdlib.Internal.SkewList.__mapTree<a, b>(Stdlib.Internal.SkewList.__nodeRight<a>(tree), fn) in
        Stdlib.Internal.SkewList.__allocNode<b>(mappedValue, mappedLeft, mappedRight)

let map<'a, 'b>(list: List<a>, fn: (a) -> b) : List<b> =
    if Stdlib.Internal.SkewList.__isNull<a>(list) then
        Stdlib.Internal.SkewList.empty<b>()
    else
        let mappedTree = Stdlib.Internal.SkewList.__mapTree<a, b>(Stdlib.Internal.SkewList.__digitTree<a>(list), fn) in
        let mappedRest = Stdlib.Internal.SkewList.map<a, b>(Stdlib.Internal.SkewList.__digitRest<a>(list), fn) in
        Stdlib.Internal.SkewList.__allocDigit<b>(Stdlib.Internal.SkewList.__digitWeight<a>(list), Stdlib.Internal.SkewList.__digitLength<a>(list), mappedTree, mappedRest)

let __reverseInto<'a>(source: List<a>, acc: List<a>) : List<a> =
    if Stdlib.Internal.SkewList.__isNull<a>(source) then acc
    else Stdlib.Internal.SkewList.__reverseInto<a>(Stdlib.Internal.SkewList.tail<a>(source), Stdlib.Internal.SkewList.push<a>(acc, Stdlib.Internal.SkewList.headUnsafe<a>(source)))

let reverse<'a>(list: List<a>) : List<a> =
    Stdlib.Internal.SkewList.__reverseInto<a>(list, Stdlib.Internal.SkewList.empty<a>())

let pushBack<'a>(list: List<a>, value: a) : List<a> =
    Stdlib.Internal.SkewList.reverse<a>(Stdlib.Internal.SkewList.push<a>(Stdlib.Internal.SkewList.reverse<a>(list), value))

let __prependReversed<'a>(reversed: List<a>, suffix: List<a>) : List<a> =
    if Stdlib.Internal.SkewList.__isNull<a>(reversed) then suffix
    else Stdlib.Internal.SkewList.__prependReversed<a>(Stdlib.Internal.SkewList.tail<a>(reversed), Stdlib.Internal.SkewList.push<a>(suffix, Stdlib.Internal.SkewList.headUnsafe<a>(reversed)))

let concat<'a>(left: List<a>, right: List<a>) : List<a> =
    Stdlib.Internal.SkewList.__prependReversed<a>(Stdlib.Internal.SkewList.reverse<a>(left), right)

let last<'a>(list: List<a>) : Stdlib.Option.Option<a> =
    Stdlib.Internal.SkewList.getAt<a>(list, Stdlib.Internal.SkewList.length<a>(list) - 1)

let init<'a>(list: List<a>) : List<a> =
    if Stdlib.Internal.SkewList.__isNull<a>(list) then Stdlib.Internal.SkewList.empty<a>()
    else Stdlib.Internal.SkewList.reverse<a>(Stdlib.Internal.SkewList.tail<a>(Stdlib.Internal.SkewList.reverse<a>(list)))
