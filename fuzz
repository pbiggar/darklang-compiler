#!/bin/bash
# fuzz - Find compiler discrepancies and coordinate approved, landed fixes.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"
ORIGINAL_ARGS=("$@")

usage() {
    echo "Usage: ./fuzz [--seed N] [--timeout-ms N] [--depth N]"
    echo ""
    echo "Continuously fuzzes the compiler and minimizes every finding."
    echo "Each compiler fix and its landing require separate approval. Stop with Ctrl-C."
    echo ""
    echo "Options:"
    echo "  --seed N        Start with this signed 32-bit seed."
    echo "                  Otherwise a seed is chosen and printed."
    echo "  --timeout-ms N  Per-process timeout in milliseconds (default: 2000)."
    echo "  --depth N       Maximum generated AST depth (default: 6)."
    echo "  --help, -h      Show this help."
}

parse_int32() {
    local flag="$1"
    local value="$2"
    if [[ ! "$value" =~ ^-?[0-9]+$ ]]; then
        echo "Error: $flag requires a signed 32-bit integer, got '$value'." >&2
        return 1
    fi

    local sign=1
    local digits="$value"
    if [[ "$digits" == -* ]]; then
        sign=-1
        digits="${digits#-}"
    fi
    while [[ ${#digits} -gt 1 && "${digits:0:1}" == 0 ]]; do
        digits="${digits:1}"
    done
    if [[ ${#digits} -gt 10 ]]; then
        echo "Error: $flag requires a signed 32-bit integer, got '$value'." >&2
        return 1
    fi

    local parsed=$((sign * 10#$digits))
    if (( parsed < -2147483648 || parsed > 2147483647 )); then
        echo "Error: $flag requires a signed 32-bit integer, got '$value'." >&2
        return 1
    fi
    printf '%s\n' "$parsed"
}

parse_positive_int32() {
    local flag="$1"
    local value="$2"
    if [[ ! "$value" =~ ^[1-9][0-9]*$ || ${#value} -gt 10 ]]; then
        echo "Error: $flag requires a positive 32-bit integer, got '$value'." >&2
        return 1
    fi

    local parsed=$((10#$value))
    if (( parsed > 2147483647 )); then
        echo "Error: $flag requires a positive 32-bit integer, got '$value'." >&2
        return 1
    fi
    printf '%s\n' "$parsed"
}

SEED_SET=false
NEXT_SEED=0
TIMEOUT_MS=2000
DEPTH=6

while [[ $# -gt 0 ]]; do
    case "$1" in
        --seed)
            if [[ $# -lt 2 || "$SEED_SET" == true ]]; then
                echo "Error: --seed requires exactly one integer." >&2
                exit 2
            fi
            if ! NEXT_SEED="$(parse_int32 --seed "$2")"; then
                exit 2
            fi
            SEED_SET=true
            shift 2
            ;;
        --timeout-ms)
            if [[ $# -lt 2 ]]; then
                echo "Error: --timeout-ms requires a value." >&2
                exit 2
            fi
            if ! TIMEOUT_MS="$(parse_positive_int32 --timeout-ms "$2")"; then
                exit 2
            fi
            shift 2
            ;;
        --depth)
            if [[ $# -lt 2 ]]; then
                echo "Error: --depth requires a value." >&2
                exit 2
            fi
            if ! DEPTH="$(parse_positive_int32 --depth "$2")"; then
                exit 2
            fi
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            echo "Error: unknown option '$1'." >&2
            usage >&2
            exit 2
            ;;
    esac
done

if ! command -v darklang-interpreter >/dev/null 2>&1; then
    echo "Error: darklang-interpreter is not on PATH." >&2
    echo "Install it with './scripts/install-darklang-interpreter.sh'." >&2
    exit 1
fi

trap 'echo; echo "Fuzzer stopped."; exit 130' INT

FUZZER_PROJECT="src/Fuzzer/Fuzzer.fsproj"
PENDING_FIX_SHA=""
PENDING_FIX_BASE=""

INTEGRATION_REF="$(python3 - <<'PY'
from pathlib import Path
import re

lines = Path('.mergetrain.yaml').read_text(encoding='utf-8').splitlines()
git_lines = []
inside_git = False
for raw in lines:
    line = raw.split('#', 1)[0].rstrip()
    if line == 'git:':
        inside_git = True
    elif inside_git and line and not line.startswith(' '):
        inside_git = False
    elif inside_git:
        git_lines.append(line)

fields = {}
for line in git_lines:
    match = re.fullmatch(r'\s+(remote|integration_branch):\s*(\S+)\s*', line)
    if match:
        fields[match.group(1)] = match.group(2)
if 'remote' not in fields or 'integration_branch' not in fields:
    raise SystemExit('Missing configured integration ref in .mergetrain.yaml')
print(f"{fields['remote']}/{fields['integration_branch']}")
PY
)"
git rev-parse --verify --quiet "$INTEGRATION_REF^{commit}" >/dev/null || {
    echo "Error: local integration ref is unavailable: $INTEGRATION_REF" >&2
    exit 1
}

if [[ "$SCRIPT_DIR" == /Users/paulbiggar/projects/c4d-for-dcb ]]; then
    # This checkout coordinates integration and must stay read-only.
    campaign="/tmp/dark-fuzzer-campaign-$(date -u +%Y%m%dT%H%M%S)-$$"
    branch="fuzz/campaign-$(date -u +%Y%m%dT%H%M%S)-$$"
    git worktree add -b "$branch" "$campaign" "$INTEGRATION_REF"
    git -C "$campaign" branch --set-upstream-to="$INTEGRATION_REF" "$branch"
    echo "Fuzz campaign worktree: $campaign"
    exec "$campaign/fuzz" "${ORIGINAL_ARGS[@]}"
fi

approve() {
    local answer
    printf '%s [y/N] ' "$1"
    if ! IFS= read -r answer; then
        echo "Error: no interactive approval response was available." >&2
        exit 1
    fi
    [[ "${answer,,}" == y || "${answer,,}" == yes ]]
}

wait_for_previous_fix() {
    if [[ -z "$PENDING_FIX_SHA" ]]; then
        return 0
    fi
    echo "Waiting for the previous fix to reach $INTEGRATION_REF before creating another fix branch."
    while true; do
        if git merge-base --is-ancestor "$PENDING_FIX_SHA" "$INTEGRATION_REF"; then
            break
        fi
        # The train may replay a commit onto a newer parent, changing its SHA.
        local cherry
        cherry="$(git cherry "$INTEGRATION_REF" "$PENDING_FIX_SHA" "$PENDING_FIX_BASE")"
        if [[ -n "$cherry" && "$cherry" != *'+ '* ]]; then
            break
        fi
        sleep 10
    done
    echo "Previous fix is present on $INTEGRATION_REF."
    PENDING_FIX_SHA=""
    PENDING_FIX_BASE=""
}

run_gate() {
    local worktree="$1"
    local log="$2"
    shift 2
    echo "Validating: $*"
    if ! (cd "$worktree" && "$@") >"$log" 2>&1; then
        tail -n 18 "$log" >&2
        echo "Error: validation failed; full output: $log" >&2
        return 1
    fi
}

ask_codex_to_fix() {
    local source="$1"
    local expected="$2"
    local actual="$3"
    local minimized="$4"
    local run_dir="$5"

    if ! command -v codex >/dev/null 2>&1; then
        echo "Error: codex is not on PATH." >&2
        return 1
    fi

    wait_for_previous_fix

    local base branch worktree runtime_dir
    base="$(git rev-parse "$INTEGRATION_REF^{commit}")"
    branch="fuzz/fix-$(date -u +%Y%m%dT%H%M%S)-$$-$CAMPAIGN"
    mkdir -p "$SCRIPT_DIR/fuzz-results/worktrees"
    worktree="$SCRIPT_DIR/fuzz-results/worktrees/fix-$(date -u +%Y%m%dT%H%M%S)-$$-$CAMPAIGN"
    git worktree add -b "$branch" "$worktree" "$base"
    git -C "$worktree" branch --set-upstream-to="$INTEGRATION_REF" "$branch"
    runtime_dir="$(mktemp -d "$SCRIPT_DIR/fuzz-results/codex-runtime.XXXXXX")"

    local prompt
    prompt="$(printf '%s\n' \
        'The compiler fuzzer found the discrepancy below.' \
        'Fix the compiler bug completely. Do not merely diagnose it.' \
        'Follow AGENTS.md, including creating the focused failing E2E test before the fix.' \
        'Use the compiler AST and darklang-interpreter as the semantic oracle.' \
        'Run all required tests and the parent-relative benchmark gate.' \
        'When the fix is ready, review and commit it. Do not run ./land.' \
        'The fuzzer controller will verify the commit and request human approval before landing.' \
        'Report the exact tests, benchmark result, commit, and any unresolved risk.' \
        '' \
        'Reduced Dark case:' \
        "$source" \
        '' \
        'Expected result from darklang-interpreter:' \
        "$expected" \
        '' \
        'Actual compiler result:' \
        "$actual")"

    if ! printf '%s\n' "$prompt" | codex exec \
        --approve-for-me -C "$worktree" \
        --output-last-message "$run_dir/codex-final.txt" - \
        >"$run_dir/codex.log" 2>&1; then
        tail -n 18 "$run_dir/codex.log" >&2
        echo "Error: Codex failed; worktree: $worktree; log: $run_dir/codex.log" >&2
        return 1
    fi
    cat "$run_dir/codex-final.txt"

    local head
    head="$(git -C "$worktree" rev-parse HEAD)"
    if [[ "$head" == "$base" || "$(git -C "$worktree" branch --show-current)" != "$branch" || \
          -n "$(git -C "$worktree" status --porcelain)" ]]; then
        echo "Error: Codex did not leave a new clean commit on $branch; worktree: $worktree" >&2
        return 1
    fi
    if ! git -C "$worktree" merge-base --is-ancestor "$base" "$head"; then
        echo "Error: the fix no longer descends from its integration base; worktree: $worktree" >&2
        return 1
    fi

    run_gate "$worktree" "$run_dir/build.log" ./build --ai
    run_gate "$worktree" "$run_dir/tests.log" ./run-tests --ai
    run_gate "$worktree" "$run_dir/benchmarks.log" ./benchmarks/run_benchmarks.sh --verify-parent full
    run_gate "$worktree" "$run_dir/fuzzer-build.log" ./build --ai -- "$FUZZER_PROJECT"
    run_gate "$worktree" "$run_dir/publish.log" dotnet publish --no-build --configuration Debug "$FUZZER_PROJECT" --output "$runtime_dir"
    if [[ ! -f "$runtime_dir/Fuzzer.dll" ]]; then
        echo "Error: fixed fuzzer runtime was not published: $runtime_dir" >&2
        return 1
    fi
    run_gate "$worktree" "$run_dir/replay.log" ./scripts/dotnet-host "$runtime_dir/Fuzzer.dll" --timeout-ms "$TIMEOUT_MS" --replay "$minimized"
    if [[ -n "$(git -C "$worktree" status --porcelain)" || "$(git -C "$worktree" rev-parse HEAD)" != "$head" ]]; then
        echo "Error: verification changed the committed fix; worktree: $worktree" >&2
        return 1
    fi

    echo "Fix worktree: $worktree"
    echo "Commit: $head"
    git -C "$worktree" log -1 --format='%s'
    git -C "$worktree" diff --stat "$base..$head"
    rg -m 1 'success: .* passed' "$run_dir/tests.log" || true
    rg -m 1 'current/parent geometric ratio' "$run_dir/benchmarks.log" || true
    printf 'Review full patch: git -C %q diff %q\n' "$worktree" "$base..$head"
    echo "Validation logs: $run_dir"
    if ! approve "Land this exact fix commit and continue fuzzing?"; then
        echo "Fix retained without landing: $worktree ($head)" >&2
        return 1
    fi
    if ! (cd "$worktree" && ./land --task "Fix compiler discrepancy from fuzzer campaign $CAMPAIGN") >"$run_dir/land.log" 2>&1; then
        if rg --fixed-strings --quiet 'Landing handoff is pending' "$run_dir/land.log"; then
            echo 'Merge train: ⏳ handoff pending' >&2
        else
            cat "$run_dir/land.log" >&2
            echo "Error: landing handoff did not queue; worktree: $worktree" >&2
        fi
        return 1
    fi
    if [[ "$(<"$run_dir/land.log")" != queued ]]; then
        echo "Error: landing handoff returned an unexpected result; log: $run_dir/land.log" >&2
        return 1
    fi

    FUZZER_COMMAND=("$worktree/scripts/dotnet-host" "$runtime_dir/Fuzzer.dll")
    PENDING_FIX_SHA="$head"
    PENDING_FIX_BASE="$base"
    echo "Fix queued at $head; continuing with its published compiler."
}

./build --ai -- "$FUZZER_PROJECT"
FUZZER_COMMAND=(dotnet run --no-build --project "$FUZZER_PROJECT" --)
mkdir -p fuzz-results
CAMPAIGN=1

while true; do
    RUN_DIR="$(mktemp -d "$SCRIPT_DIR/fuzz-results/run.XXXXXX")"
    CAMPAIGN_ARGS=(--timeout-ms "$TIMEOUT_MS" --max-depth "$DEPTH" --artifacts "$RUN_DIR")
    if [[ "$SEED_SET" == true ]]; then
        CAMPAIGN_ARGS+=(--seed "$NEXT_SEED")
    fi

    echo "Campaign $CAMPAIGN: artifacts $RUN_DIR"
    set +e
    "${FUZZER_COMMAND[@]}" "${CAMPAIGN_ARGS[@]}"
    FUZZ_STATUS=$?
    set -e

    shopt -s nullglob
    FINDINGS=("$RUN_DIR"/seed-*-case-*.dark)
    shopt -u nullglob
    if [[ $FUZZ_STATUS -eq 0 || ${#FINDINGS[@]} -ne 1 ]]; then
        echo "Error: unbounded fuzzer stopped without producing exactly one finding in $RUN_DIR." >&2
        exit 1
    fi

    FINDING="${FINDINGS[0]}"
    "${FUZZER_COMMAND[@]}" --timeout-ms "$TIMEOUT_MS" --minimize "$FINDING"
    MINIMIZED="${FINDING%.dark}.min.dark"
    SOURCE="$(<"$MINIMIZED")"
    EXPECTED="$(darklang-interpreter eval "$SOURCE")"

    set +e
    ACTUAL="$(
        "${FUZZER_COMMAND[@]}" \
            --timeout-ms "$TIMEOUT_MS" \
            --replay "$MINIMIZED" 2>&1
    )"
    REPLAY_STATUS=$?
    set -e
    if [[ $REPLAY_STATUS -eq 0 ]]; then
        echo "Error: minimized finding no longer reproduces: $MINIMIZED" >&2
        exit 1
    fi
    ACTUAL="${ACTUAL#Replay reproduced: }"

    echo ""
    echo "Reduced case:"
    printf '%s\n' "$SOURCE"
    echo ""
    echo "Expected (darklang-interpreter):"
    printf '%s\n' "$EXPECTED"
    echo ""
    echo "Actual (compiler):"
    printf '%s\n' "$ACTUAL"
    echo ""

    if approve "Should Codex start a compiler fix for this finding?"; then
        ask_codex_to_fix "$SOURCE" "$EXPECTED" "$ACTUAL" "$MINIMIZED" "$RUN_DIR"
    else
        echo "Finding preserved without a compiler fix; continuing."
    fi

    echo "Finding: $FINDING"
    echo "Minimized: $MINIMIZED"

    if [[ "$SEED_SET" == true ]]; then
        if (( NEXT_SEED == 2147483647 )); then
            NEXT_SEED=-2147483648
        else
            NEXT_SEED=$((NEXT_SEED + 1))
        fi
    fi
    ((CAMPAIGN += 1))
done
