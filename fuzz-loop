#!/bin/bash
# fuzz-loop - Continuously find, minimize, and promote compiler discrepancies to E2E tests.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

if ! command -v darklang-interpreter >/dev/null 2>&1; then
    echo "Error: darklang-interpreter is not on PATH." >&2
    echo "Install it with './scripts/install-darklang-interpreter.sh'." >&2
    exit 1
fi

E2E_FILE="src/Tests/e2e/fuzzer-found.e2e"
MINIMIZED_SOURCE=""
CAMPAIGN_LIMIT=0
CAMPAIGN_LIMIT_SET=false
SEED_SET=false
NEXT_SEED=0
FUZZ_ARGS=()

usage() {
    echo "Usage: ./fuzz-loop [FUZZ_ARGS...] [--campaigns N] [--e2e-file PATH]"
    echo "       ./fuzz-loop --promote MINIMIZED.dark [--e2e-file PATH]"
    echo ""
    echo "Runs fuzzer campaigns continuously, minimizing and promoting each"
    echo "discrepancy. Use --campaigns N to stop after N campaigns."
}

parse_int32() {
    local flag="$1"
    local value="$2"
    if [[ ! "$value" =~ ^-?[0-9]+$ ]]; then
        echo "Error: $flag requires a 32-bit integer, got '$value'." >&2
        return 1
    fi

    local sign=1
    local digits="$value"
    if [[ "$digits" == -* ]]; then
        sign=-1
        digits="${digits#-}"
    fi
    while [[ ${#digits} -gt 1 && "${digits:0:1}" == 0 ]]; do
        digits="${digits:1}"
    done
    if [[ ${#digits} -gt 10 ]]; then
        echo "Error: $flag requires a 32-bit integer, got '$value'." >&2
        return 1
    fi

    local parsed=$((sign * 10#$digits))
    if (( parsed < -2147483648 || parsed > 2147483647 )); then
        echo "Error: $flag requires a 32-bit integer, got '$value'." >&2
        return 1
    fi
    printf '%s\n' "$parsed"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --e2e-file)
            if [[ $# -lt 2 ]]; then
                echo "Error: --e2e-file requires a path." >&2
                exit 2
            fi
            E2E_FILE="$2"
            shift 2
            ;;
        --promote)
            if [[ $# -lt 2 || -n "$MINIMIZED_SOURCE" ]]; then
                echo "Error: --promote requires exactly one source path." >&2
                exit 2
            fi
            MINIMIZED_SOURCE="$2"
            shift 2
            ;;
        --campaigns)
            if [[ $# -lt 2 || "$CAMPAIGN_LIMIT_SET" == true ]]; then
                echo "Error: --campaigns requires exactly one positive integer." >&2
                exit 2
            fi
            CAMPAIGN_TEXT="$2"
            if [[ ! "$CAMPAIGN_TEXT" =~ ^[1-9][0-9]*$ || ${#CAMPAIGN_TEXT} -gt 10 ]]; then
                echo "Error: --campaigns requires a positive integer." >&2
                exit 2
            fi
            CAMPAIGN_LIMIT=$((10#$CAMPAIGN_TEXT))
            if (( CAMPAIGN_LIMIT > 2147483647 )); then
                echo "Error: --campaigns requires a positive 32-bit integer." >&2
                exit 2
            fi
            CAMPAIGN_LIMIT_SET=true
            shift 2
            ;;
        --seed)
            if [[ $# -lt 2 || "$SEED_SET" == true ]]; then
                echo "Error: --seed requires exactly one integer." >&2
                exit 2
            fi
            if ! NEXT_SEED="$(parse_int32 --seed "$2")"; then
                exit 2
            fi
            SEED_SET=true
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --artifacts|--replay|--minimize)
            echo "Error: $1 is managed by fuzz-loop and cannot be passed through." >&2
            exit 2
            ;;
        *)
            FUZZ_ARGS+=("$1")
            shift
            ;;
    esac
done

promote() {
    local source_path="$1"
    if [[ ! -f "$source_path" ]]; then
        echo "Error: minimized source does not exist: $source_path" >&2
        return 1
    fi

    local source
    source="$(<"$source_path")"
    if [[ "$source" == *$'\n'* ]]; then
        echo "Error: E2E promotion currently requires a single-line expression." >&2
        return 1
    fi

    local interpreted
    interpreted="$(darklang-interpreter eval "$source")"

    local expected
    case "$interpreted" in
        true|false)
            expected="$interpreted"
            ;;
        -[0-9]*|[0-9]*)
            if [[ ! "$interpreted" =~ ^-?[0-9]+$ ]]; then
                echo "Error: unsupported interpreter result: $interpreted" >&2
                return 1
            fi
            expected="${interpreted}L"
            ;;
        *)
            echo "Error: unsupported interpreter result: $interpreted" >&2
            return 1
            ;;
    esac

    local test_case="$source = $expected"
    if [[ ! -f "$E2E_FILE" ]]; then
        echo "Error: E2E destination does not exist: $E2E_FILE" >&2
        return 1
    fi

    if rg --fixed-strings --line-regexp --quiet -- "$test_case" "$E2E_FILE"; then
        echo "E2E case already present: $E2E_FILE"
    else
        printf '%s\n' "$test_case" >> "$E2E_FILE"
        echo "Added failing E2E case: $E2E_FILE"
    fi
}

if [[ -n "$MINIMIZED_SOURCE" ]]; then
    if [[ ${#FUZZ_ARGS[@]} -ne 0 || "$CAMPAIGN_LIMIT_SET" == true || "$SEED_SET" == true ]]; then
        echo "Error: fuzzer and campaign arguments cannot be combined with --promote." >&2
        exit 2
    fi
    promote "$MINIMIZED_SOURCE"
    exit 0
fi

mkdir -p fuzz-results
CAMPAIGN=1

while (( CAMPAIGN_LIMIT == 0 || CAMPAIGN <= CAMPAIGN_LIMIT )); do
    RUN_DIR="$(mktemp -d "$SCRIPT_DIR/fuzz-results/run.XXXXXX")"
    CAMPAIGN_ARGS=("${FUZZ_ARGS[@]}")
    if [[ "$SEED_SET" == true ]]; then
        CAMPAIGN_ARGS+=(--seed "$NEXT_SEED")
    fi

    if (( CAMPAIGN_LIMIT == 0 )); then
        echo "Campaign $CAMPAIGN: artifacts $RUN_DIR"
    else
        echo "Campaign $CAMPAIGN/$CAMPAIGN_LIMIT: artifacts $RUN_DIR"
    fi
    set +e
    ./fuzz "${CAMPAIGN_ARGS[@]}" --artifacts "$RUN_DIR"
    FUZZ_STATUS=$?
    set -e

    if [[ $FUZZ_STATUS -eq 0 ]]; then
        echo "Campaign $CAMPAIGN found no discrepancy; continuing."
    else
        shopt -s nullglob
        FINDINGS=("$RUN_DIR"/seed-*-case-*.dark)
        shopt -u nullglob
        if [[ ${#FINDINGS[@]} -ne 1 ]]; then
            echo "Error: fuzzer failed without producing exactly one finding in $RUN_DIR." >&2
            exit 1
        fi

        FINDING="${FINDINGS[0]}"
        ./fuzz --minimize "$FINDING"
        MINIMIZED="${FINDING%.dark}.min.dark"
        promote "$MINIMIZED"

        echo "Finding: $FINDING"
        echo "Minimized: $MINIMIZED"
        echo "Promoted: $E2E_FILE"
    fi

    if [[ "$SEED_SET" == true ]]; then
        if (( NEXT_SEED == 2147483647 )); then
            NEXT_SEED=-2147483648
        else
            NEXT_SEED=$((NEXT_SEED + 1))
        fi
    fi
    ((CAMPAIGN += 1))
done

echo "Completed $CAMPAIGN_LIMIT campaigns."
echo "Next: ./build --ai && ./run-tests --ai --filter=fuzzer-found"
