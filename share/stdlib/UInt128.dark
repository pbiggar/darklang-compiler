// Stdlib.UInt128.dark - unsigned 128-bit integer operations.
//
// Values are immutable fixed blocks containing low and high UInt64 limbs,
// followed by their reference count. Decimal buffers exist only at textual
// and arbitrary-precision conversion boundaries.

module Darklang.Stdlib.UInt128

type ParseError = BadFormat | OutOfRange

let __low (value: UInt128) : UInt64 = __raw_get<UInt64> (__uint128_to_rawptr value) 0L
let __high (value: UInt128) : UInt64 = __raw_get<UInt64> (__uint128_to_rawptr value) 8L

let __fromWords (low: UInt64) (high: UInt64) : UInt128 =
    let ptr = __raw_alloc 24L in
    let _ = __raw_slot_init<UInt64> ptr 0L low in
    let _ = __raw_slot_init<UInt64> ptr 8L high in
    let _ = __raw_write_word ptr 16L 1L in
    __rawptr_to_uint128 ptr

let __base () : Int = Stdlib.Int.__value "18446744073709551616"
let __modulus () : Int = Stdlib.Int.__value "340282366920938463463374607431768211456"

let __uint64FromInt (value: Int) : UInt64 =
    match Stdlib.Int.__toUInt64 value with
    | Some result -> result
    | None -> Builtin.crash "Internal UInt128 limb conversion invariant failed"

let __toInt (value: UInt128) : Int =
    Stdlib.Int.__add (Stdlib.Int.__multiply (Stdlib.Int.__fromUInt64 (Stdlib.UInt128.__high value)) (Stdlib.UInt128.__base ())) (Stdlib.Int.__fromUInt64 (Stdlib.UInt128.__low value))

let __fromInt (value: Int) : UInt128 =
    let residue = Stdlib.Int.__mod value (Stdlib.UInt128.__modulus ()) in
    let division = Stdlib.Int.__dividePositive residue (Stdlib.UInt128.__base ()) in
    let high = Stdlib.Tuple2.first division in
    let low = Stdlib.Tuple2.second division in
    Stdlib.UInt128.__fromWords (Stdlib.UInt128.__uint64FromInt low) (Stdlib.UInt128.__uint64FromInt high)

let __equalsWords (value: UInt128) (low: UInt64) (high: UInt64) : Bool =
    Stdlib.UInt128.__low value == low && Stdlib.UInt128.__high value == high

let __multiplyHigh64 (x: UInt64) (y: UInt64) : UInt64 =
    let mask = 4294967295UL in
    let xLow = Stdlib.UInt64.bitwiseAnd x mask in
    let xHigh = Stdlib.UInt64.shiftRight x 32UL in
    let yLow = Stdlib.UInt64.bitwiseAnd y mask in
    let yHigh = Stdlib.UInt64.shiftRight y 32UL in
    let word0 = xLow * yLow in
    let partial = xHigh * yLow + Stdlib.UInt64.shiftRight word0 32UL in
    let word1 = Stdlib.UInt64.bitwiseAnd partial mask in
    let word2 = Stdlib.UInt64.shiftRight partial 32UL in
    let word1WithCross = xLow * yHigh + word1 in
    xHigh * yHigh + word2 + Stdlib.UInt64.shiftRight word1WithCross 32UL

let add (a: UInt128) (b: UInt128) : UInt128 =
    let aLow = Stdlib.UInt128.__low a in
    let bLow = Stdlib.UInt128.__low b in
    let low = aLow + bLow in
    let carry = if low < aLow then 1UL else 0UL in
    Stdlib.UInt128.__fromWords low (Stdlib.UInt128.__high a + Stdlib.UInt128.__high b + carry)

let subtract (a: UInt128) (b: UInt128) : UInt128 =
    let aLow = Stdlib.UInt128.__low a in
    let bLow = Stdlib.UInt128.__low b in
    let low = aLow - bLow in
    let borrow = if aLow < bLow then 1UL else 0UL in
    Stdlib.UInt128.__fromWords low (Stdlib.UInt128.__high a - Stdlib.UInt128.__high b - borrow)

let multiply (a: UInt128) (b: UInt128) : UInt128 =
    let aLow = Stdlib.UInt128.__low a in
    let bLow = Stdlib.UInt128.__low b in
    let high = Stdlib.UInt128.__multiplyHigh64 aLow bLow + Stdlib.UInt128.__high a * bLow + aLow * Stdlib.UInt128.__high b in
    Stdlib.UInt128.__fromWords (aLow * bLow) high

let divide (a: UInt128) (b: UInt128) : UInt128 =
    Stdlib.UInt128.__fromInt (Stdlib.Int.__divide (Stdlib.UInt128.__toInt a) (Stdlib.UInt128.__toInt b))
let mod (value: UInt128) (modulus: UInt128) : UInt128 =
    Stdlib.UInt128.__fromInt (Stdlib.Int.__mod (Stdlib.UInt128.__toInt value) (Stdlib.UInt128.__toInt modulus))

let lessThan (a: UInt128) (b: UInt128) : Bool =
    let aHigh = Stdlib.UInt128.__high a in
    let bHigh = Stdlib.UInt128.__high b in
    aHigh < bHigh || (aHigh == bHigh && Stdlib.UInt128.__low a < Stdlib.UInt128.__low b)
let __equals (a: UInt128) (b: UInt128) : Bool = Stdlib.UInt128.__equalsWords a (Stdlib.UInt128.__low b) (Stdlib.UInt128.__high b)
let lessThanOrEqualTo (a: UInt128) (b: UInt128) : Bool = Stdlib.UInt128.lessThan a b || Stdlib.UInt128.__equals a b
let greaterThan (a: UInt128) (b: UInt128) : Bool = Stdlib.UInt128.lessThan b a
let greaterThanOrEqualTo (a: UInt128) (b: UInt128) : Bool = Stdlib.UInt128.lessThanOrEqualTo b a

let sqrt (value: UInt128) : Float = Stdlib.Int.__sqrt (Stdlib.UInt128.__toInt value)
let toFloat (value: UInt128) : Float = Stdlib.Int.__toFloat (Stdlib.UInt128.__toInt value)
let sum (values: List<UInt128>) : UInt128 = Stdlib.List.fold values (0Z) (fun acc value -> Stdlib.UInt128.add acc value)
let max (a: UInt128) (b: UInt128) : UInt128 = if Stdlib.UInt128.greaterThan a b then a else b
let min (a: UInt128) (b: UInt128) : UInt128 = if Stdlib.UInt128.lessThan a b then a else b
let clamp (value: UInt128) (limitA: UInt128) (limitB: UInt128) : UInt128 =
    let lower = Stdlib.UInt128.min limitA limitB in
    let upper = Stdlib.UInt128.max limitA limitB in
    Stdlib.UInt128.max lower (Stdlib.UInt128.min upper value)

let __toStringWords (low: UInt64) (high: UInt64) : String =
    if high == 0UL then Stdlib.UInt64.toString low
    else
        let highQuotient = high / 10UL in
        let highRemainder = high % 10UL in
        let lowUpper = Stdlib.UInt64.shiftRight low 32UL in
        let upperDividend = Stdlib.UInt64.shiftLeft highRemainder 32UL + lowUpper in
        let quotientUpper = upperDividend / 10UL in
        let upperRemainder = upperDividend % 10UL in
        let lowLower = Stdlib.UInt64.bitwiseAnd low 4294967295UL in
        let lowerDividend = Stdlib.UInt64.shiftLeft upperRemainder 32UL + lowLower in
        let quotientLow = Stdlib.UInt64.shiftLeft quotientUpper 32UL + (lowerDividend / 10UL) in
        __string_concat_raw (Stdlib.UInt128.__toStringWords quotientLow highQuotient) (Stdlib.UInt64.__digitToString (lowerDividend % 10UL))

let toString (value: UInt128) : String =
    Stdlib.UInt128.__toStringWords (Stdlib.UInt128.__low value) (Stdlib.UInt128.__high value)

let __digitByteToUInt64 (byte: Int64) : UInt64 =
    match byte with
    | 48L -> 0UL
    | 49L -> 1UL
    | 50L -> 2UL
    | 51L -> 3UL
    | 52L -> 4UL
    | 53L -> 5UL
    | 54L -> 6UL
    | 55L -> 7UL
    | 56L -> 8UL
    | 57L -> 9UL
    | _ -> Builtin.crash "Internal UInt128 decimal digit invariant failed"

let __parseDigits (value: String) (index: Int64) (length: Int64) (low: UInt64) (high: UInt64) : Stdlib.Result.Result<UInt128, Stdlib.UInt128.ParseError> =
    if index >= length then Ok (Stdlib.UInt128.__fromWords low high)
    else
        let byte = Stdlib.String.__byteAtUnchecked value index in
        if byte < 48L || byte > 57L then Error Stdlib.UInt128.ParseError.BadFormat
        else
            let highTimesTen = high * 10UL in
            let carry = Stdlib.UInt128.__multiplyHigh64 low 10UL in
            let highWithCarry = highTimesTen + carry in
            if Stdlib.UInt128.__multiplyHigh64 high 10UL != 0UL || highWithCarry < highTimesTen then
                Error Stdlib.UInt128.ParseError.OutOfRange
            else
                let lowTimesTen = low * 10UL in
                let nextLow = lowTimesTen + Stdlib.UInt128.__digitByteToUInt64 byte in
                let digitCarry = if nextLow < lowTimesTen then 1UL else 0UL in
                let nextHigh = highWithCarry + digitCarry in
                if nextHigh < highWithCarry then Error Stdlib.UInt128.ParseError.OutOfRange
                else Stdlib.UInt128.__parseDigits value (index + 1L) length nextLow nextHigh

let parse (value: String) : Stdlib.Result.Result<UInt128, Stdlib.UInt128.ParseError> =
    let trimmed = Stdlib.String.trim value in
    let length = Stdlib.String.__byteLength trimmed in
    if length == 0L then Error Stdlib.UInt128.ParseError.BadFormat
    else
        let first = Stdlib.String.__byteAtUnchecked trimmed 0L in
        let start = if first == 43L || first == 45L then 1L else 0L in
        if start == length then Error Stdlib.UInt128.ParseError.BadFormat
        else
            match Stdlib.UInt128.__parseDigits trimmed start length 0UL 0UL with
            | Error error -> Error error
            | Ok result ->
                if first != 45L || Stdlib.UInt128.__equalsWords result 0UL 0UL then Ok result
                else Error Stdlib.UInt128.ParseError.OutOfRange

let fromUInt8 (value: UInt8) : UInt128 = Stdlib.UInt128.__fromInt (Stdlib.Int.__fromUInt8 value)
let fromUInt16 (value: UInt16) : UInt128 = Stdlib.UInt128.__fromInt (Stdlib.Int.__fromUInt16 value)
let fromUInt32 (value: UInt32) : UInt128 = Stdlib.UInt128.__fromInt (Stdlib.Int.__fromUInt32 value)
let fromUInt64 (value: UInt64) : UInt128 = Stdlib.UInt128.__fromWords value 0UL
let bitwiseAnd (a: UInt128) (b: UInt128) : UInt128 = Stdlib.UInt128.__fromWords (Stdlib.UInt64.bitwiseAnd (Stdlib.UInt128.__low a) (Stdlib.UInt128.__low b)) (Stdlib.UInt64.bitwiseAnd (Stdlib.UInt128.__high a) (Stdlib.UInt128.__high b))
let bitwiseOr (a: UInt128) (b: UInt128) : UInt128 = Stdlib.UInt128.__fromWords (Stdlib.UInt64.bitwiseOr (Stdlib.UInt128.__low a) (Stdlib.UInt128.__low b)) (Stdlib.UInt64.bitwiseOr (Stdlib.UInt128.__high a) (Stdlib.UInt128.__high b))
let bitwiseXor (a: UInt128) (b: UInt128) : UInt128 = Stdlib.UInt128.__fromWords (Stdlib.UInt64.bitwiseXor (Stdlib.UInt128.__low a) (Stdlib.UInt128.__low b)) (Stdlib.UInt64.bitwiseXor (Stdlib.UInt128.__high a) (Stdlib.UInt128.__high b))
let bitwiseNot (value: UInt128) : UInt128 = Stdlib.UInt128.__fromWords (18446744073709551615UL - Stdlib.UInt128.__low value) (18446744073709551615UL - Stdlib.UInt128.__high value)

let shiftLeft (value: UInt128) (count: UInt128) : UInt128 =
    let amount = Stdlib.UInt64.bitwiseAnd (Stdlib.UInt128.__low count) 127UL in
    let low = Stdlib.UInt128.__low value in
    let high = Stdlib.UInt128.__high value in
    if amount == 0UL then value
    else if amount < 64UL then Stdlib.UInt128.__fromWords (Stdlib.UInt64.shiftLeft low amount) (Stdlib.UInt64.bitwiseOr (Stdlib.UInt64.shiftLeft high amount) (Stdlib.UInt64.shiftRight low (64UL - amount)))
    else Stdlib.UInt128.__fromWords 0UL (Stdlib.UInt64.shiftLeft low (amount - 64UL))

let shiftRight (value: UInt128) (count: UInt128) : UInt128 =
    let amount = Stdlib.UInt64.bitwiseAnd (Stdlib.UInt128.__low count) 127UL in
    let low = Stdlib.UInt128.__low value in
    let high = Stdlib.UInt128.__high value in
    if amount == 0UL then value
    else if amount < 64UL then Stdlib.UInt128.__fromWords (Stdlib.UInt64.bitwiseOr (Stdlib.UInt64.shiftRight low amount) (Stdlib.UInt64.shiftLeft high (64UL - amount))) (Stdlib.UInt64.shiftRight high amount)
    else Stdlib.UInt128.__fromWords (Stdlib.UInt64.shiftRight high (amount - 64UL)) 0UL
