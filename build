#!/usr/bin/env bash
# build - Build the native compiler and tests with bounded automated output.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"
MODE=normal
BUILD_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --ai) MODE=ai; shift ;;
        --quiet) MODE=quiet; shift ;;
        --help|-h)
            echo "Usage: ./build [--ai|--quiet] [-- DUNE_BUILD_ARGS...]"
            echo "  --ai     Print bounded diagnostics and retain the full failed log"
            echo "  --quiet  Print only a failure status"
            exit 0 ;;
        --) shift; BUILD_ARGS+=("$@"); break ;;
        *) BUILD_ARGS+=("$1"); shift ;;
    esac
done
run_build() {
    if ! command -v dune >/dev/null || ! command -v ocamlc >/dev/null; then
        echo "OCaml 5.5.1 and Dune 3.24.2 are required; activate the pinned opam switch." >&2
        return 1
    fi
    if [[ $(ocamlc -version) != 5.5.1 || $(dune --version) != 3.24.2 ]]; then
        echo "Toolchain differs from the pinned OCaml 5.5.1 / Dune 3.24.2 versions." >&2
        return 1
    fi
    dune build --root "$SCRIPT_DIR/ocaml" "${BUILD_ARGS[@]}"
}
if [[ "$MODE" == normal ]]; then
    run_build
else
    mkdir -p TestResults/ai
    BUILD_OUTPUT="TestResults/ai/build-$(date -u +%Y%m%dT%H%M%SZ)-$$.log"
    [[ "$MODE" != ai ]] || echo building
    if run_build >"$BUILD_OUTPUT" 2>&1; then
        rm -f "$BUILD_OUTPUT"
        [[ "$MODE" != ai ]] || echo "build success"
        exit 0
    fi
    echo "build failed"
    if [[ "$MODE" == ai ]]; then
        tail -n 16 "$BUILD_OUTPUT" | cut -c1-512
        echo "full output: $BUILD_OUTPUT"
        printf 'reproduce: ./build --ai'
        if [[ ${#BUILD_ARGS[@]} -gt 0 ]]; then printf ' --'; printf ' %q' "${BUILD_ARGS[@]}"; fi
        printf '\n'
    fi
    exit 1
fi
