// http-fetch.dark - Fetch an HTTP or HTTPS page and indent its HTML for inspection.

let byteLength (value: String) : Int64 = Stdlib.String.byteLength value
let byteAt (value: String) (index: Int64) : Int64 =
    match Stdlib.String.getByteAt value (Stdlib.Int.fromInt64 index) with
    | Some byte -> Stdlib.Int64.fromUInt8 byte
    | None -> -1L
let slice (value: String) (start: Int64) (end_: Int64) : String =
    let bytes = Stdlib.Blob.slice (Stdlib.String.toBlob value)
                    (Stdlib.Int.fromInt64 start) (Stdlib.Int.fromInt64 (end_ - start)) in
    match Stdlib.Blob.toString bytes with
    | Ok text -> text
    | Error _ -> "[invalid UTF-8 boundary]"

let nextTag (html: String) (index: Int64) : Int64 =
    if index >= byteLength html || byteAt html index == 60L then index
    else nextTag html (index + 1L)

// Attribute values may contain '>', so only an unquoted '>' ends a tag.
let tagEnd (html: String) (index: Int64) (quote: Int64) : Int64 =
    if index >= byteLength html then byteLength html
    else
        let current = byteAt html index in
        if quote != 0L then
            tagEnd html (index + 1L) (if current == quote then 0L else quote)
        else if current == 34L || current == 39L then tagEnd html (index + 1L) current
        else if current == 62L then index + 1L
        else tagEnd html (index + 1L) 0L

let commentEnd (html: String) (index: Int64) : Int64 =
    let length = byteLength html in
    if index + 2L >= length then length
    else if byteAt html index == 45L && byteAt html (index + 1L) == 45L &&
            byteAt html (index + 2L) == 62L then index + 3L
    else commentEnd html (index + 1L)

let nameEnd (tag: String) (index: Int64) : Int64 =
    if index >= byteLength tag then index
    else
        let current = byteAt tag index in
        if current <= 32L || current == 47L || current == 62L then index
        else nameEnd tag (index + 1L)

let tagName (tag: String) : String =
    let start = if Stdlib.String.startsWith tag "</" then 2L else 1L in
    Stdlib.String.toLowercase (slice tag start (nameEnd tag start))

let voidTag (name: String) : Bool =
    name == "area" || name == "base" || name == "br" || name == "col" ||
    name == "embed" || name == "hr" || name == "img" || name == "input" ||
    name == "link" || name == "meta" || name == "param" || name == "source" ||
    name == "track" || name == "wbr"

let rawTag (name: String) : Bool =
    name == "script" || name == "style" || name == "pre" || name == "textarea"

let indent (depth: Int64) : String =
    Stdlib.String.repeat "  " (Stdlib.Int.fromInt64 depth)

let emitTextLines (parts: List<String>) (depth: Int64) (lines: List<String>) : List<String> =
    match parts with
    | [] -> lines
    | part :: rest ->
        let trimmed = Stdlib.String.trim part in
        let next =
            if trimmed == "" then lines
            else Stdlib.List.push lines (indent depth ++ trimmed) in
        emitTextLines rest depth next

let emitRawLines (parts: List<String>) (depth: Int64) (lines: List<String>) : List<String> =
    match parts with
    | [] -> lines
    | part :: rest ->
        let next =
            if part == "" then lines
            else Stdlib.List.push lines (indent depth ++ part) in
        emitRawLines rest depth next

let rawClose (html: String) (position: Int64) (name: String) : Int64 =
    let found = nextTag html position in
    let length = byteLength html in
    let afterName = found + 2L + byteLength name in
    if found >= length || afterName > length then length
    else if Stdlib.String.toLowercase (slice html found afterName) == "</" ++ name &&
            (afterName == length || byteAt html afterName <= 32L ||
             byteAt html afterName == 47L || byteAt html afterName == 62L) then found
    else rawClose html (found + 1L) name

let formatFrom (html: String) (position: Int64) (depth: Int64)
    (insideRaw: String) (lines: List<String>) : List<String> =
    let length = byteLength html in
    if position >= length then lines
    else if insideRaw != "" then
        let closeAt = rawClose html position insideRaw in
        let content = slice html position closeAt in
        let next = emitRawLines (Stdlib.String.splitOnNewline content) depth lines in
        if closeAt >= length then next
        else formatFrom html closeAt depth "" next
    else if byteAt html position != 60L then
        let end_ = nextTag html position in
        let next = emitTextLines (Stdlib.String.splitOnNewline (slice html position end_)) depth lines in
        formatFrom html end_ depth "" next
    else
        let isComment = Stdlib.String.startsWith (slice html position length) "<!--" in
        let end_ =
            if isComment then commentEnd html (position + 4L)
            else tagEnd html (position + 1L) 0L in
        let tag = slice html position end_ in
        if end_ == length && byteAt html (length - 1L) != 62L then
            emitTextLines (Stdlib.String.splitOnNewline tag) depth lines
        else
            let name = tagName tag in
            let closing = Stdlib.String.startsWith tag "</" in
            let declaration = Stdlib.String.startsWith tag "<!" ||
                              Stdlib.String.startsWith tag "<?" || name == "" in
            let selfClosing = Stdlib.String.endsWith tag "/>" || voidTag name in
            let lineDepth = if closing && depth > 0L then depth - 1L else depth in
            let next = Stdlib.List.push lines (indent lineDepth ++ tag) in
            let nextDepth =
                if closing then lineDepth
                else if declaration || selfClosing || depth >= 64L then depth
                else depth + 1L in
            let nextRaw =
                if closing || declaration || selfClosing || Stdlib.Bool.not (rawTag name) then ""
                else name in
            formatFrom html end_ nextDepth nextRaw next

let formatHtml (html: String) : String =
    Stdlib.String.join (Stdlib.List.reverse (formatFrom html 0L 0L "" [])) "\n"

let log (message: String) : Unit = Stdlib.printLine ("[http-fetch] " ++ message)

let addressText (bytes: List<Int64>) : String =
    Stdlib.String.join (Stdlib.List.map bytes Stdlib.Int64.toString) "."

let dnsError (error: Stdlib.DnsWire.ResolveError) : String =
    match error with
    | InvalidQuery message -> "invalid query: " ++ message
    | NetworkError code -> "network errno " ++ Stdlib.Int64.toString code
    | InvalidResponse message -> "invalid response: " ++ message
    | ResolverConfig message -> "resolver configuration: " ++ message

let printAddresses (family: String) (addresses: List<List<Int64>>) : Unit =
    let _ = log (family ++ " answers: " ++ Stdlib.Int.toString (Stdlib.List.length addresses)) in
    Stdlib.List.iter addresses (fun address -> log ("  " ++ addressText address))

let connect4 (addresses: List<List<Int64>>) (port: Int64) : Stdlib.Result.Result<Stdlib.Network.TcpConnection, String> =
    match addresses with
    | [] -> Error "No IPv4 address connected"
    | address :: rest ->
        let _ = log ("Connecting IPv4 " ++ addressText address ++ ":" ++ Stdlib.Int64.toString port) in
        match Stdlib.Network.connectTcp4 address port 1000L with
        | Ok connection -> Ok connection
        | Error code ->
            let _ = log ("IPv4 connect failed: errno " ++ Stdlib.Int64.toString code) in
            connect4 rest port

let connect6 (addresses: List<List<Int64>>) (port: Int64) : Stdlib.Result.Result<Stdlib.Network.TcpConnection, String> =
    match addresses with
    | [] -> Error "No IPv6 address connected"
    | address :: rest ->
        let _ = log ("Connecting IPv6 bytes " ++ addressText address ++ ":" ++ Stdlib.Int64.toString port) in
        match Stdlib.Network.connectTcp6 address port 1000L with
        | Ok connection -> Ok connection
        | Error code ->
            let _ = log ("IPv6 connect failed: errno " ++ Stdlib.Int64.toString code) in
            connect6 rest port

let connectHost (host: String) (port: Int64) : Stdlib.Result.Result<Stdlib.Network.TcpConnection, String> =
    match Stdlib.DnsWire.resolve host 1L with
    | Ok addresses ->
        let _ = printAddresses "A" addresses in
        match connect4 addresses port with
        | Ok connection -> Ok connection
        | Error ipv4Error ->
            match Stdlib.DnsWire.resolve host 28L with
            | Ok addresses6 ->
                let _ = printAddresses "AAAA" addresses6 in
                match connect6 addresses6 port with
                | Ok connection -> Ok connection
                | Error ipv6Error -> Error (ipv4Error ++ "; " ++ ipv6Error)
            | Error error -> Error (ipv4Error ++ "; AAAA lookup failed: " ++ dnsError error)
    | Error error ->
        let _ = log ("A lookup failed: " ++ dnsError error) in
        match Stdlib.DnsWire.resolve host 28L with
        | Ok addresses6 ->
            let _ = printAddresses "AAAA" addresses6 in
            connect6 addresses6 port
        | Error error6 -> Error ("AAAA lookup failed: " ++ dnsError error6)

let readResponse (connection: Stdlib.Network.TcpConnection) (buffer: Blob)
    : Stdlib.Result.Result<Stdlib.HttpWire.ParsedResponse, String> =
    if Stdlib.Blob.length buffer > 104923136 then Error "HTTP response exceeded the buffer limit"
    else
        match Stdlib.HttpWire.parseResponse "GET" false buffer with
        | Ok response -> Ok response
        | Error error ->
            match error with
            | Invalid message -> Error ("HTTP framing error: " ++ message)
            | Incomplete ->
                match Stdlib.Network.readTcp connection 4096L with
                | Error code -> Error ("TCP read failed: errno " ++ Stdlib.Int64.toString code)
                | Ok chunk ->
                    let length = Stdlib.Blob.length chunk in
                    let _ = log ("Received " ++ Stdlib.Int.toString length ++ " bytes") in
                    if length == 0 then
                        match Stdlib.HttpWire.parseResponse "GET" true buffer with
                        | Ok response -> Ok response
                        | Error errorAtEof ->
                            match errorAtEof with
                            | Invalid message -> Error ("HTTP framing error at EOF: " ++ message)
                            | Incomplete -> Error "Response ended before the HTTP message was complete"
                    else readResponse connection (Stdlib.Blob.concat [buffer, chunk])

let sendRequest (connectHostName: String) (connectPort: Int64)
    (target: String) (origin: Stdlib.HttpWire.Url)
    : Stdlib.Result.Result<Stdlib.HttpWire.ParsedResponse, String> =
    let _ = log ("Resolving connection host " ++ connectHostName) in
    match connectHost connectHostName connectPort with
    | Error message -> Error message
    | Ok connection ->
        let request = "GET " ++ target ++ " HTTP/1.1\r\n" ++
                      "Host: " ++ origin.authority ++ "\r\n" ++
                      "Accept: text/html\r\n" ++
                      "Connection: close\r\n\r\n" in
        let _ = log ("Request line: GET " ++ target ++ " HTTP/1.1") in
        let _ = log ("Host header: " ++ origin.authority) in
        let _ = log "Accept header: text/html" in
        let _ = log "Connection header: close" in
        let _ = log ("Sending " ++ Stdlib.Int64.toString (Stdlib.String.byteLength request) ++ " bytes") in
        let result =
            match Stdlib.Network.writeTcp connection (Stdlib.String.toBlob request) with
            | Error code -> Error ("TCP write failed: errno " ++ Stdlib.Int64.toString code)
            | Ok () -> readResponse connection Stdlib.Blob.empty in
        let _ = Stdlib.Network.closeTcp connection in
        let _ = log "Connection closed" in
        result

let sendSecureRequest (origin: Stdlib.HttpWire.Url)
    : Stdlib.Result.Result<Stdlib.HttpWire.ParsedResponse, String> =
    let _ = log ("Resolving connection host " ++ origin.host) in
    match connectHost origin.host origin.port with
    | Error message -> Error message
    | Ok connection ->
        let request = "GET " ++ origin.target ++ " HTTP/1.1\r\n" ++
                      "Host: " ++ origin.authority ++ "\r\n" ++
                      "Accept: text/html\r\n" ++
                      "Connection: close\r\n\r\n" in
        let _ = log ("Request line: GET " ++ origin.target ++ " HTTP/1.1") in
        let _ = log ("Host header: " ++ origin.authority) in
        let _ = log ("Sending " ++ Stdlib.Int64.toString (Stdlib.String.byteLength request) ++ " encrypted HTTP bytes") in
        let result =
            match Stdlib.Tls13Client.loadSystemRoots () with
            | Error message -> Error ("Trust store: " ++ message)
            | Ok roots ->
                let _ = log ("Loaded " ++ Stdlib.Int.toString (Stdlib.List.length roots) ++ " system CA certificates") in
                let _ = log ("Starting TLS 1.3 for " ++ origin.host) in
                match Stdlib.Tls13Client.exchange connection origin.host "GET"
                        roots (Stdlib.String.toBlob request) with
                | Error message -> Error ("TLS: " ++ message)
                | Ok response ->
                    let _ = log ("Authenticated response bytes: " ++ Stdlib.Int.toString (Stdlib.Blob.length response)) in
                    match Stdlib.HttpWire.parseResponse "GET" true response with
                    | Ok parsed -> Ok parsed
                    | Error (Invalid message) -> Error ("HTTP framing: " ++ message)
                    | Error Incomplete -> Error "HTTP response is incomplete" in
        let _ = Stdlib.Network.closeTcp connection in
        let _ = log "Connection closed" in
        result

let proxyRequest (origin: Stdlib.HttpWire.Url) (proxyText: String)
    : Stdlib.Result.Result<Stdlib.HttpWire.ParsedResponse, String> =
    match Stdlib.HttpWire.parseUrl proxyText with
    | Error message -> Error ("Invalid HTTP_PROXY URL: " ++ message)
    | Ok proxy ->
        if proxy.scheme != "http" then Error "HTTP_PROXY must use plain http://"
        else
            let _ = log ("Proxy: " ++ proxy.authority) in
            let _ = log ("Proxy resolves the origin host " ++ origin.host) in
            let absoluteTarget = origin.scheme ++ "://" ++ origin.authority ++ origin.target in
            sendRequest proxy.host proxy.port absoluteTarget origin

let noProxyMatches (host: String) (entries: List<String>) : Bool =
    match entries with
    | [] -> false
    | entry :: rest ->
        let pattern = Stdlib.String.toLowercase (Stdlib.String.trim entry) in
        if pattern == "*" || pattern == host ||
           (Stdlib.String.startsWith pattern "." && Stdlib.String.endsWith host pattern) then true
        else noProxyMatches host rest

let proxyFor (host: String) : Stdlib.Option.Option<String> =
    let noProxy =
        match Stdlib.Cli.Env.get "NO_PROXY" with
        | Some value -> value
        | None -> Stdlib.Cli.Env.getOr "no_proxy" "" in
    if noProxyMatches (Stdlib.String.toLowercase host) (Stdlib.String.split noProxy ",") then None
    else
        match Stdlib.Cli.Env.get "HTTP_PROXY" with
        | Some value -> Some value
        | None -> Stdlib.Cli.Env.get "http_proxy"

let printHeaders (headers: List<(String * String)>) : Unit =
    Stdlib.List.iter headers (fun (name, value) -> log ("Header: " ++ name ++ ": " ++ value))

let display (status: String) (headers: List<(String * String)>) (body: Blob) : Unit =
    let _ = log ("Response status: " ++ status) in
    let _ = printHeaders headers in
    let _ = log ("Body bytes: " ++ Stdlib.Int.toString (Stdlib.Blob.length body)) in
    match Stdlib.Blob.toString body with
    | Error message -> log ("Body is not UTF-8: " ++ message)
    | Ok html ->
        let _ = log "Body follows (HTML indented):" in
        Stdlib.printLine (formatHtml html)

match Stdlib.Cli.Args.get 0 with
| Error _ -> Stdlib.printLine "Usage: http-fetch <http://url|https://url>"
| Ok url ->
    let _ = log ("URL: " ++ url) in
    match Stdlib.HttpWire.parseUrl url with
    | Error message -> log ("URL parse failed: " ++ message)
    | Ok parsed ->
        let _ = log ("Scheme: " ++ parsed.scheme) in
        let _ = log ("Host: " ++ parsed.host) in
        let _ = log ("Port: " ++ Stdlib.Int64.toString parsed.port) in
        let _ = log ("Request target: " ++ parsed.target) in
        if parsed.scheme == "https" then
            let _ = log "Mode: direct Dark DNS/TCP/TLS 1.3 with system CA verification" in
            match sendSecureRequest parsed with
            | Error message -> log ("FAILED: " ++ message)
            | Ok response -> display (Stdlib.Int64.toString response.statusCode) response.headers response.body
        else
            match proxyFor parsed.host with
            | Some proxy ->
                let _ = log "Mode: HTTP proxy" in
                match proxyRequest parsed proxy with
                | Error message -> log ("FAILED: " ++ message)
                | Ok response -> display (Stdlib.Int64.toString response.statusCode) response.headers response.body
            | None ->
                let _ = log "Mode: direct Dark DNS/TCP" in
                match sendRequest parsed.host parsed.port parsed.target parsed with
                | Error message -> log ("FAILED: " ++ message)
                | Ok response -> display (Stdlib.Int64.toString response.statusCode) response.headers response.body
