module Darklang.Cli.Tests.PermissionsGrammar

// The CLI rule grammar (`LanguageTools.Permissions`): every rule shape the
// CLI accepts, and the round trip between `renderRule` and `parseRule`.
//
// Two contracts are pinned here. `permissions list`/`show` print rules with
// `renderRule`, and an operator pastes them back into `permissions allow`, so
// each Rule case must round-trip. And the F# denial hint (`To allow:
// permissions allow <rule>`, from `Request.suggestRule`) is text this parser
// must accept, so each shape it emits is parsed below.
//

module PermissionsGrammar =
  // @compiler blocked: upstream-dependency
  let only (value: String) : Darklang.LanguageTools.Permissions.Scope<String> =
    Darklang.LanguageTools.Permissions.Scope.Only value

  /// True when rendering the rule and parsing that text gives the rule back.

  // @compiler blocked: upstream-dependency
  let roundTrips (rule: Darklang.LanguageTools.Permissions.Rule) : Bool =
    (Darklang.LanguageTools.Permissions.parseRuleText
      (Darklang.LanguageTools.Permissions.renderRule rule))
    == Stdlib.Option.Option.Some [ rule ]

  // @compiler blocked: upstream-dependency
  let exactHttp () : Darklang.LanguageTools.Permissions.Rule =
    Darklang.LanguageTools.Permissions.Rule.Http(
      Darklang.LanguageTools.Permissions.HttpRule
        { method = only "GET"
          scheme = only "https"
          host = Darklang.LanguageTools.Permissions.HostRule.Exact "h"
          port = Darklang.LanguageTools.Permissions.Scope.Only 443
          pathPrefix = only "/p"
          query = only "?q" })

  // @compiler blocked: upstream-dependency
  let broadHttp () : Darklang.LanguageTools.Permissions.Rule =
    Darklang.LanguageTools.Permissions.Rule.Http(
      Darklang.LanguageTools.Permissions.HttpRule
        { method = Darklang.LanguageTools.Permissions.Scope.All
          scheme = only "https"
          host = Darklang.LanguageTools.Permissions.HostRule.Any
          port = Darklang.LanguageTools.Permissions.Scope.All
          pathPrefix = Darklang.LanguageTools.Permissions.Scope.All
          query = Darklang.LanguageTools.Permissions.Scope.All })

  // @compiler blocked: upstream-dependency
  let process (exe: String) (args: List<String>) : Darklang.LanguageTools.Permissions.Rule =
    Darklang.LanguageTools.Permissions.Rule.Process(
      Darklang.LanguageTools.Permissions.ProcessRule
        { executable = only exe
          args =
            if Stdlib.List.isEmpty args then
              Darklang.LanguageTools.Permissions.Scope.All
            else
              Darklang.LanguageTools.Permissions.Scope.Only args })

  // Basic rule forms accepted by `permissions allow`.
  // @compiler blocked: pending-validation
  test basicRules =
    Stdlib.Test.all
      [ Darklang.LanguageTools.Permissions.parseRule [ "file", "read", "/tmp/x" ]
        |> Stdlib.Test.equal
          (Stdlib.Option.Option.Some
             [ Darklang.LanguageTools.Permissions.Rule.FileRead(only "/tmp/x") ])
        Darklang.LanguageTools.Permissions.parseRule [ "file", "write", "/tmp/x" ]
        |> Stdlib.Test.equal
          (Stdlib.Option.Option.Some
             [ Darklang.LanguageTools.Permissions.Rule.FileWrite(only "/tmp/x") ])
        Darklang.LanguageTools.Permissions.parseRule [ "file", "read+write", "/tmp/x" ]
        |> Stdlib.Test.equal
          (Stdlib.Option.Option.Some
             [ Darklang.LanguageTools.Permissions.Rule.FileRead(only "/tmp/x")
               Darklang.LanguageTools.Permissions.Rule.FileWrite(only "/tmp/x") ]) ]

  // No target means every target.
  // @compiler blocked: pending-validation
  test noTargetMeansAll =
    Stdlib.Test.all
      [ Darklang.LanguageTools.Permissions.parseRule [ "file", "read" ]
        |> Stdlib.Test.equal
          (Stdlib.Option.Option.Some
             [ Darklang.LanguageTools.Permissions.Rule.FileRead
                 Darklang.LanguageTools.Permissions.Scope.All ])
        Darklang.LanguageTools.Permissions.parseRule [ "env", "read", "HOME" ]
        |> Stdlib.Test.equal
          (Stdlib.Option.Option.Some
             [ Darklang.LanguageTools.Permissions.Rule.EnvRead(only "HOME") ])
        Darklang.LanguageTools.Permissions.parseRule [ "env", "write", "PATH" ]
        |> Stdlib.Test.equal
          (Stdlib.Option.Option.Some
             [ Darklang.LanguageTools.Permissions.Rule.EnvWrite(only "PATH") ])
        Darklang.LanguageTools.Permissions.parseRule [ "db", "read", "t" ]
        |> Stdlib.Test.equal
          (Stdlib.Option.Option.Some
             [ Darklang.LanguageTools.Permissions.Rule.DbRead(only "t") ]) ]

  // The store effects are not resource-scoped: bare effect names only.
  // @compiler blocked: pending-validation
  test storeEffectsBare =
    Stdlib.Test.all
      [ Darklang.LanguageTools.Permissions.parseRule [ "package-read" ]
        |> Stdlib.Test.equal
          (Stdlib.Option.Option.Some
             [ Darklang.LanguageTools.Permissions.Rule.Effect Darklang.LanguageTools.Permissions.Effect.PackageRead ])
        Darklang.LanguageTools.Permissions.parseRule [ "package", "read", "p" ]
        |> Stdlib.Test.equal Stdlib.Option.Option.None
        Darklang.LanguageTools.Permissions.parseRule [ "trace", "read", "t" ]
        |> Stdlib.Test.equal Stdlib.Option.Option.None ]

  // Unknown access, unknown kind, unknown effect: never a wildcard.
  // @compiler blocked: pending-validation
  test unknownNeverWildcard =
    Stdlib.Test.all
      [ Darklang.LanguageTools.Permissions.parseRule [ "file", "execute", "/x" ]
        |> Stdlib.Test.equal Stdlib.Option.Option.None
        Darklang.LanguageTools.Permissions.parseRule [ "disk", "read", "/x" ]
        |> Stdlib.Test.equal Stdlib.Option.Option.None
        Darklang.LanguageTools.Permissions.parseRule [ "teleport" ]
        |> Stdlib.Test.equal Stdlib.Option.Option.None
        Darklang.LanguageTools.Permissions.parseRule [ "http", "GET", "ftp://h/p" ]
        |> Stdlib.Test.equal Stdlib.Option.Option.None
        Darklang.LanguageTools.Permissions.parseRuleText "http GET https://h:65536/p"
        |> Stdlib.Test.equal Stdlib.Option.Option.None ]

  // Representative forms emitted by the F# denial hint (`Request.suggestRule`).
  // @compiler blocked: pending-validation
  test denialHintForms =
    Darklang.LanguageTools.Permissions.parseRuleText "http GET https://h:443/p?q"
    |> Stdlib.Test.equal
      (Stdlib.Option.Option.Some
         [ exactHttp () ])

  // A query with no path: the host must not swallow the query.
  // @compiler blocked: pending-validation
  test queryWithoutPath =
    Stdlib.Test.all
      [ Darklang.LanguageTools.Permissions.parseRuleText "http GET https://h?x=1"
        |> Stdlib.Test.equal
          (Stdlib.Option.Option.Some
             [ Darklang.LanguageTools.Permissions.Rule.Http(
                 Darklang.LanguageTools.Permissions.HttpRule
                   { method = only "GET"
                     scheme = only "https"
                     host = Darklang.LanguageTools.Permissions.HostRule.Exact "h"
                     port = Darklang.LanguageTools.Permissions.Scope.Only 443
                     pathPrefix = Darklang.LanguageTools.Permissions.Scope.All
                     query = only "?x=1" }) ])
        Darklang.LanguageTools.Permissions.parseRuleText "process /bin/x"
        |> Stdlib.Test.equal
          (Stdlib.Option.Option.Some
             [ process "/bin/x" [] ]) ]

  // A relative executable would name a different program per working
  // directory; only `*` or an absolute path is a rule.
  // @compiler blocked: pending-validation
  test relativeExecutableRejected =
    Stdlib.Test.all
      [ Darklang.LanguageTools.Permissions.parseRuleText "process ./tool"
        |> Stdlib.Test.equal Stdlib.Option.Option.None
        Darklang.LanguageTools.Permissions.parseRuleText "process tool --x"
        |> Stdlib.Test.equal Stdlib.Option.Option.None
        Darklang.LanguageTools.Permissions.parseRuleText "env read"
        |> Stdlib.Test.equal
          (Stdlib.Option.Option.Some
             [ Darklang.LanguageTools.Permissions.Rule.EnvRead
                 Darklang.LanguageTools.Permissions.Scope.All ])
        Darklang.LanguageTools.Permissions.parseRuleText "db read"
        |> Stdlib.Test.equal
          (Stdlib.Option.Option.Some
             [ Darklang.LanguageTools.Permissions.Rule.DbRead
                 Darklang.LanguageTools.Permissions.Scope.All ])
        Darklang.LanguageTools.Permissions.parseRuleText "file read /tmp/x"
        |> Stdlib.Test.equal
          (Stdlib.Option.Option.Some
             [ Darklang.LanguageTools.Permissions.Rule.FileRead(only "/tmp/x") ])
        Darklang.LanguageTools.Permissions.parseRuleText "http-server 8080"
        |> Stdlib.Test.equal
          (Stdlib.Option.Option.Some
             [ Darklang.LanguageTools.Permissions.Rule.HttpServer(
                 Darklang.LanguageTools.Permissions.Scope.Only 8080) ])
        ([ "stdin", "stdout", "clock", "random"
           "package-read", "package-write", "trace-read", "trace-write" ]
         |> Stdlib.List.all (fun name ->
           (Darklang.LanguageTools.Permissions.parseRuleText name)
           == (Darklang.LanguageTools.Permissions.effectOfName name
               |> Stdlib.Option.map (fun effect ->
                 [ Darklang.LanguageTools.Permissions.Rule.Effect effect ]))))
        |> Stdlib.Test.equal true ]

  // A bare `http`, `http-server` or `process` is the whole effect, never the
  // scoped rule's broad spelling: each text names exactly one Rule.
  // @compiler blocked: pending-validation
  test bareEffectNames =
    ([ "http", "http-server", "process" ]
     |> Stdlib.List.all (fun name ->
       (Darklang.LanguageTools.Permissions.parseRuleText name)
       == (Darklang.LanguageTools.Permissions.effectOfName name
           |> Stdlib.Option.map (fun effect ->
             [ Darklang.LanguageTools.Permissions.Rule.Effect effect ]))))
    |> Stdlib.Test.equal true

  // `*` is the wildcard executable, not an executable literally named `*`.
  // @compiler blocked: pending-validation
  test wildcardExecutable =
    Stdlib.Test.all
      [ Darklang.LanguageTools.Permissions.parseRuleText "process *"
        |> Stdlib.Test.equal
          (Stdlib.Option.Option.Some
             [ Darklang.LanguageTools.Permissions.Rule.Process(
                 Darklang.LanguageTools.Permissions.ProcessRule
                   { executable = Darklang.LanguageTools.Permissions.Scope.All
                     args = Darklang.LanguageTools.Permissions.Scope.All }) ])
        Darklang.LanguageTools.Permissions.parseRuleText "http-server *"
        |> Stdlib.Test.equal
          (Stdlib.Option.Option.Some
             [ Darklang.LanguageTools.Permissions.Rule.HttpServer
                 Darklang.LanguageTools.Permissions.Scope.All ])
        Darklang.LanguageTools.Permissions.parseRuleText "effect clock"
        |> Stdlib.Test.equal Stdlib.Option.Option.None ]

  // Render/parse round trips.
  // @compiler blocked: pending-validation
  test exactRuleRoundTrips =
    Stdlib.Test.all
      [ roundTrips Darklang.LanguageTools.Permissions.Rule.All
        |> Stdlib.Test.equal true
        roundTrips (Darklang.LanguageTools.Permissions.Rule.Effect Darklang.LanguageTools.Permissions.Effect.Clock)
        |> Stdlib.Test.equal true ]

  // The three effects that also have scoped rule forms.
  // @compiler blocked: pending-validation
  test scopedEffectRoundTrips =
    Stdlib.Test.all
      [ roundTrips (Darklang.LanguageTools.Permissions.Rule.Effect Darklang.LanguageTools.Permissions.Effect.Http)
        |> Stdlib.Test.equal true
        roundTrips (Darklang.LanguageTools.Permissions.Rule.Effect Darklang.LanguageTools.Permissions.Effect.HttpServer)
        |> Stdlib.Test.equal true
        roundTrips (Darklang.LanguageTools.Permissions.Rule.Effect Darklang.LanguageTools.Permissions.Effect.Process)
        |> Stdlib.Test.equal true
        roundTrips
          (Darklang.LanguageTools.Permissions.Rule.Process(
            Darklang.LanguageTools.Permissions.ProcessRule
              { executable = Darklang.LanguageTools.Permissions.Scope.All
                args = Darklang.LanguageTools.Permissions.Scope.All }))
        |> Stdlib.Test.equal true
        roundTrips
          (Darklang.LanguageTools.Permissions.Rule.Process(
            Darklang.LanguageTools.Permissions.ProcessRule
              { executable = Darklang.LanguageTools.Permissions.Scope.All
                args = Darklang.LanguageTools.Permissions.Scope.Only [ "a" ] }))
        |> Stdlib.Test.equal true
        roundTrips (exactHttp ()) |> Stdlib.Test.equal true
        roundTrips (broadHttp ()) |> Stdlib.Test.equal true ]

  // A query must not be dropped when rendering a broad HTTP rule.
  // @compiler blocked: pending-validation
  test queryKeptAndRuleRoundTrips =
    Stdlib.Test.all
      [ Stdlib.String.contains
          (Darklang.LanguageTools.Permissions.renderRule
            (Darklang.LanguageTools.Permissions.Rule.Http(
              Darklang.LanguageTools.Permissions.HttpRule
                { method = only "GET"
                  scheme = Darklang.LanguageTools.Permissions.Scope.All
                  host = Darklang.LanguageTools.Permissions.HostRule.Any
                  port = Darklang.LanguageTools.Permissions.Scope.All
                  pathPrefix = Darklang.LanguageTools.Permissions.Scope.All
                  query = only "?token=secret" })))
          "?token=secret"
        |> Stdlib.Test.equal true
        roundTrips
          (Darklang.LanguageTools.Permissions.Rule.HttpServer
            Darklang.LanguageTools.Permissions.Scope.All)
        |> Stdlib.Test.equal true
        roundTrips
          (Darklang.LanguageTools.Permissions.Rule.HttpServer(
            Darklang.LanguageTools.Permissions.Scope.Only 8080))
        |> Stdlib.Test.equal true
        roundTrips (Darklang.LanguageTools.Permissions.Rule.FileRead(only "/tmp/x"))
        |> Stdlib.Test.equal true
        roundTrips (Darklang.LanguageTools.Permissions.Rule.FileWrite(only "/tmp/x"))
        |> Stdlib.Test.equal true
        roundTrips (Darklang.LanguageTools.Permissions.Rule.EnvRead(only "HOME"))
        |> Stdlib.Test.equal true
        roundTrips (Darklang.LanguageTools.Permissions.Rule.EnvWrite(only "PATH"))
        |> Stdlib.Test.equal true
        roundTrips (Darklang.LanguageTools.Permissions.Rule.DbRead(only "t"))
        |> Stdlib.Test.equal true
        roundTrips (Darklang.LanguageTools.Permissions.Rule.DbWrite(only "t"))
        |> Stdlib.Test.equal true
        roundTrips (process "/bin/x" []) |> Stdlib.Test.equal true
        roundTrips (process "/bin/x" [ "a", "b" ]) |> Stdlib.Test.equal true ]

  // Rendered guest-controlled fields are quoted: spaces, apostrophes and
  // shell metacharacters survive the round trip as data, never syntax.
  // @compiler blocked: pending-validation
  test quotedFieldsRoundTrip =
    Stdlib.Test.all
      [ roundTrips
          (Darklang.LanguageTools.Permissions.Rule.FileRead(
            only "/tmp/O'Brien files/$HOME"))
        |> Stdlib.Test.equal true
        roundTrips
          (process "/opt/My Tool/bin/run" [ "two words", "'quoted'", "$HOME" ])
        |> Stdlib.Test.equal true ]

  // IPv6 hosts use brackets in text but the typed rule stores the host itself.
  // @compiler blocked: pending-validation
  test ipv6Hosts =
    roundTrips
      (Darklang.LanguageTools.Permissions.Rule.Http(
        Darklang.LanguageTools.Permissions.HttpRule
          { method = only "GET"
            scheme = only "http"
            host = Darklang.LanguageTools.Permissions.HostRule.Exact "::1"
            port = Darklang.LanguageTools.Permissions.Scope.Only 8080
            pathPrefix = only "/health"
            query = Darklang.LanguageTools.Permissions.Scope.All }))
    |> Stdlib.Test.equal true

  // The whole policy renders and parses back, deny rules included.
  // @compiler blocked: pending-validation
  test policyRoundTrip =
    Darklang.LanguageTools.Permissions.parse
      (Darklang.LanguageTools.Permissions.render
        (Darklang.LanguageTools.Permissions.Policy
          { allow = [ Darklang.LanguageTools.Permissions.Rule.Effect Darklang.LanguageTools.Permissions.Effect.Clock, exactHttp () ]
            deny = [ Darklang.LanguageTools.Permissions.Rule.FileWrite(only "/etc") ] }))
    |> Stdlib.Test.equal
      (Stdlib.Result.Result.Ok(
         Darklang.LanguageTools.Permissions.Policy
           { allow = [ Darklang.LanguageTools.Permissions.Rule.Effect Darklang.LanguageTools.Permissions.Effect.Clock, exactHttp () ]
             deny = [ Darklang.LanguageTools.Permissions.Rule.FileWrite(only "/etc") ] }))
