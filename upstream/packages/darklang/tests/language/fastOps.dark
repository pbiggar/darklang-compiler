/// Operator fast-path checks. Ported from a by-hand perf check, which this replaced.
/// Run without tracing, as in the original check.
module Darklang.Language.Tests.FastOps

// @compiler blocked: missing-implementation
val d = Stdlib.Dict.fromListOverwritingDuplicates [ ("a", 1), ("b", 2) ]

let check (label: String) (actual: String) (expected: String) : Stdlib.Test.Result =
  Stdlib.Test.expect (actual == expected) $"{label}: expected {expected}, got {actual}"

// @compiler blocked: pending-validation
test dictGet =
  Stdlib.Test.all
    [ check "dict get hit" (Stdlib.toString (Stdlib.Option.withDefault (Stdlib.Dict.get d "a") 0)) "1"
      check "dict get miss" (Stdlib.toString (Stdlib.Option.withDefault (Stdlib.Dict.get d "zz") (-1))) "-1" ]

// @compiler blocked: pending-validation
test dictSetOverridingDuplicates =
  Stdlib.Test.all
    [ check "dict setOD new key" (Stdlib.toString (Stdlib.List.length (Stdlib.Dict.keys (Stdlib.Dict.setOverridingDuplicates d "c" 3)))) "3"
      check "dict setOD overwrite" (Stdlib.toString (Stdlib.Option.withDefault (Stdlib.Dict.get (Stdlib.Dict.setOverridingDuplicates d "a" 9) "a") 0)) "9"
      check "dict setOD does not mutate" (Stdlib.toString (Stdlib.List.length (Stdlib.Dict.keys d))) "2" ]

// @compiler blocked: pending-validation
test dictSet =
  check "dict set new key" (Stdlib.toString (Stdlib.List.length (Stdlib.Dict.keys (Stdlib.Dict.set d "c" 3)))) "3"

// @compiler blocked: pending-validation
test intToString =
  Stdlib.Test.all
    [ check "int toString" (Stdlib.toString 42) "42"
      check "int toString negative" (Stdlib.toString (-7)) "-7" ]

// @compiler blocked: pending-validation
test boolNot =
  check "bool not" (if Stdlib.Bool.not true then "y" else "n") "n"

// @compiler blocked: pending-validation
test listLength =
  check "list length" (Stdlib.toString (Stdlib.List.length [ 1, 2, 3 ])) "3"

// @compiler blocked: pending-validation
test listAppend =
  check "list append" (Stdlib.toString (Stdlib.List.length (Stdlib.List.append [ 1, 2 ] [ 3 ]))) "3"

// @compiler blocked: pending-validation
test stringAppend =
  check "string append" ("a" + "b") "ab"

// @compiler blocked: pending-validation
test stringEquals =
  check "string equals" (if "x" == "x" then "y" else "n") "y"

// @compiler blocked: pending-validation
test stringRepeat =
  Stdlib.Test.all
    [ check "repeat one char" (Stdlib.String.repeat "-" 3) "---"
      check "repeat multi char" (Stdlib.String.repeat "ab" 2) "abab"
      check "repeat zero" (Stdlib.String.repeat "x" 0) ""
      check "repeat negative" (Stdlib.String.repeat "x" (-2)) ""
      check "repeat empty" (Stdlib.String.repeat "" 5) "" ]

// @compiler blocked: pending-validation
test dictSetStrict =
  Stdlib.Test.all
    [ check "dict set strict new" (Stdlib.toString (Stdlib.List.length (Stdlib.Dict.keys (Stdlib.Dict.set d "c" 3)))) "3"
      check "dict set strict value" (Stdlib.toString (Stdlib.Option.withDefault (Stdlib.Dict.get (Stdlib.Dict.set d "c" 3) "c") 0)) "3" ]

// @compiler blocked: pending-validation
test stringIsEmpty =
  Stdlib.Test.all
    [ check "string isEmpty yes" (if Stdlib.String.isEmpty "" then "y" else "n") "y"
      check "string isEmpty no" (if Stdlib.String.isEmpty "a" then "y" else "n") "n" ]

// @compiler blocked: pending-validation
test listIsEmpty =
  Stdlib.Test.all
    [ check "list isEmpty yes" (if Stdlib.List.isEmpty [] then "y" else "n") "y"
      check "list isEmpty no" (if Stdlib.List.isEmpty [ 1 ] then "y" else "n") "n" ]
