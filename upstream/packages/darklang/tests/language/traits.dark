module Darklang.Language.Tests.Traits

// Traits: a trait and an impl are package items of their own kinds; an impl's
// method fns are ordinary fns under it, found at runtime by the self type; bounds
// (`'a: Show`) are checked when a fn is entered.

module Shapes =
  type Point = { x: Int, y: Int }

  // @compiler blocked: container-adaptation
  trait Show<'a> =
    // @compiler blocked: container-adaptation
    let show (value: 'a) : String

  // @compiler blocked: container-adaptation
  impl Show for Point =
    // @compiler blocked: container-adaptation
    let show (p: Point) : String =
      $"({Stdlib.toString p.x}, {Stdlib.toString p.y})"

  // @compiler blocked: container-adaptation
  impl Show for Int =
    // @compiler blocked: container-adaptation
    let show (n: Int) : String = Stdlib.toString n

  // @compiler blocked: container-adaptation
  impl Show for Bool =
    // @compiler blocked: container-adaptation
    let show (b: Bool) : String = if b then "yes" else "no"

  // @compiler blocked: container-adaptation
  impl<'a: Show> Show for List<'a> =
    // @compiler blocked: container-adaptation
    let show (xs: List<'a>) : String =
      "[" + (xs |> Stdlib.List.map (fun x -> Show.show x) |> Stdlib.String.join ", ") + "]"

  // @compiler blocked: upstream-dependency
  let display<'a: Show> (v: 'a) : String = "value: " + Show.show v

  // @compiler blocked: upstream-dependency
  let neverCalls<'a: Show> (v: 'a) : String = if false then Show.show v else "never"

  // The impl's method is an ordinary fn under <Type>.<Trait>
  // @compiler xfail compile: "Unknown function or value 'Shapes.Point.Show.show'" reason=upstream-dependency
  test implMethodIsFn =
    Shapes.Point.Show.show (Shapes.Point { x = 1, y = 2 })
    |> Stdlib.Test.equal "(1, 2)"

  // The impl is its own item, named `Shapes.Point.Show`; its methods are the fns
  // beneath it
  //
  // Dispatch by the argument's type
  // @compiler xfail compile: "Unknown function or value 'Shapes.Show.show'" reason=upstream-dependency
  test dispatchByArgType =
    Stdlib.Test.all
      [ Shapes.Show.show (Shapes.Point { x = 5, y = 6 })
        |> Stdlib.Test.equal "(5, 6)"
        Shapes.Show.show 7 |> Stdlib.Test.equal "7"
        Shapes.Show.show true |> Stdlib.Test.equal "yes" ]

  // Inside a bounded generic fn
  // @compiler xfail compile: "Unknown function or value 'Shapes.display'" reason=upstream-dependency
  test boundedGenericFn =
    Stdlib.Test.all
      [ Shapes.display (Shapes.Point { x = 1, y = 2 })
        |> Stdlib.Test.equal "value: (1, 2)"
        Shapes.display 5 |> Stdlib.Test.equal "value: 5" ]

  // Conditional impls dispatch on the head, then on the elements lazily
  // @compiler xfail compile: "Unknown function or value 'Shapes.display'" reason=upstream-dependency
  test conditionalImpls =
    Stdlib.Test.all
      [ Shapes.display [ 1, 2, 3 ] |> Stdlib.Test.equal "value: [1, 2, 3]"
        Shapes.Show.show [ [ true ], [] ] |> Stdlib.Test.equal "[[yes], []]"
        Shapes.display [ Shapes.Point { x = 1, y = 2 } ]
        |> Stdlib.Test.equal "value: [(1, 2)]" ]

  // As a function value, and piped
  // @compiler xfail compile: "Unknown function or value 'Shapes.Show.show'" reason=upstream-dependency
  test functionValueAndPipe =
    Stdlib.Test.all
      [ ([ 1, 2 ] |> Stdlib.List.map Shapes.Show.show)
        |> Stdlib.Test.equal [ "1", "2" ]
        ((Shapes.Point { x = 7, y = 8 }) |> Shapes.Show.show)
        |> Stdlib.Test.equal "(7, 8)" ]

  // Receiver calls: `x.method` is the whole call for a one-argument method
  // @compiler xfail compile: "Unknown field 'show' on Darklang.Language.Tests.Traits.Shapes.Point" reason=compiler-gap
  test receiverCalls =
    Stdlib.Test.all
      [ (Shapes.Point { x = 1, y = 2 }).show |> Stdlib.Test.equal "(1, 2)"
        (9).show |> Stdlib.Test.equal "9" ]

  // A real field always wins over a method of the same name
  test fieldBeatsMethod =
    (Shapes.Point { x = 1, y = 2 }).x |> Stdlib.Test.equal 1

  // A direct call reports the missing implementation at the method call.
  // @compiler xfail compile: "Unknown function or value 'Shapes.Show.show'" reason=upstream-dependency
  test noImplForDirectCallRaises =
    Shapes.Show.show 3.5
    => raises
      "Float has no implementation of Darklang.Language.Tests.Traits.Shapes.Show. Write `impl Show for Float = ...`, or run `dark impls Show` to see which types do"

  // No impl: at the CALL of a bounded fn, before its body runs
  // @compiler xfail compile: "Unknown function or value 'Shapes.neverCalls'" reason=upstream-dependency
  test boundedCallWithImpl =
    Shapes.neverCalls 5 |> Stdlib.Test.equal "never"

  // @compiler xfail compile: "Unknown function or value 'Shapes.neverCalls'" reason=upstream-dependency
  test noImplForBoundedCallRaises =
    Shapes.neverCalls 3.5
    => raises
      "Float has no implementation of Darklang.Language.Tests.Traits.Shapes.Show. Write `impl Show for Float = ...`, or run `dark impls Show` to see which types do"

module Multi =
  type Vec = { dx: Int, dy: Int }

  // The operators are the stdlib traits: `+` is `Stdlib.Add.add`. A user impl
  // makes `Vec + Vec` an ordinary expression.
  // @compiler blocked: container-adaptation
  impl Stdlib.Add for Vec =
    // @compiler blocked: container-adaptation
    let add (a: Vec) (b: Vec) : Vec = Vec { dx = a.dx + b.dx, dy = a.dy + b.dy }

  let sum<'a: Stdlib.Add> (a: 'a) (b: 'a) (c: 'a) : 'a = a + b + c

  // @compiler xfail compile: "No implementation of trait 'Darklang.Stdlib.Add'" reason=compiler-gap
  test operatorTraits =
    Stdlib.Test.all
      [ (Multi.Vec { dx = 1, dy = 2 } + Multi.Vec { dx = 10, dy = 20 })
        |> Stdlib.Test.equal (Multi.Vec { dx = 11, dy = 22 })
        Stdlib.Add.add
          (Multi.Vec { dx = 1, dy = 2 })
          (Multi.Vec { dx = 10, dy = 20 })
        |> Stdlib.Test.equal (Multi.Vec { dx = 11, dy = 22 })
        Multi.sum 1 2 3 |> Stdlib.Test.equal 6
        Multi.sum 1.5 2.5 3.0 |> Stdlib.Test.equal 7.0
        Multi.sum
          (Multi.Vec { dx = 1, dy = 1 })
          (Multi.Vec { dx = 2, dy = 2 })
          (Multi.Vec { dx = 3, dy = 3 })
        |> Stdlib.Test.equal (Multi.Vec { dx = 6, dy = 6 })
        Multi.sum "a" "b" "c" |> Stdlib.Test.equal "abc" ]

  // @compiler xfail compile: "No implementation of trait 'Darklang.Stdlib.Add'" reason=compiler-gap
  test boolHasNoAddRaises =
    Multi.sum true false true
    => raises
      "Bool has no implementation of Darklang.Stdlib.Add. Write `impl Add for Bool = ...`, or run `dark impls Add` to see which types do"

  // Worth knowing: a trait declared here with the same shape as `Stdlib.Add`
  // IS `Stdlib.Add` (content addressing), so `impl Add for Int` next to it
  // would be a second impl for Int and every `1 + 2` an ambiguity.
  //
  // Receiver call on a two-argument method is a partial application
  // @compiler xfail compile: "Unknown field 'add' on Darklang.Language.Tests.Traits.Multi.Vec" reason=compiler-gap
  test receiverPartialApplication =
    Stdlib.Test.all
      [ ((Multi.Vec { dx = 1, dy = 2 }).add (Multi.Vec { dx = 1, dy = 1 }))
        |> Stdlib.Test.equal (Multi.Vec { dx = 2, dy = 3 })
        (Multi.Vec { dx = 1, dy = 2 }).add (Multi.Vec { dx = 1, dy = 1 })
        |> Stdlib.Test.equal (Multi.Vec { dx = 2, dy = 3 }) ]

module Ambiguity =
  // Two traits with the same method name. Their SHAPES differ (Describe has a
  // second method): a trait is content-addressed, so two identically shaped
  // traits are one trait, however they are named.
  // @compiler blocked: container-adaptation
  trait Describe<'a> =
    // @compiler blocked: container-adaptation
    let describe (v: 'a) : String
    // @compiler blocked: container-adaptation
    let short (v: 'a) : String

  // @compiler blocked: container-adaptation
  trait Label<'a> =
    // @compiler blocked: container-adaptation
    let describe (v: 'a) : String

  // @compiler blocked: container-adaptation
  impl Describe for Int =
    // @compiler blocked: container-adaptation
    let describe (n: Int) : String = "described"
    // @compiler blocked: container-adaptation
    let short (n: Int) : String = "d"

  // @compiler blocked: container-adaptation
  impl Label for Int =
    // @compiler blocked: container-adaptation
    let describe (n: Int) : String = "labelled"

  // Naming the trait disambiguates
  // @compiler xfail compile: "Unknown function or value 'Ambiguity.Describe.describe'" reason=upstream-dependency
  test namedTraitDisambiguates =
    Stdlib.Test.all
      [ Ambiguity.Describe.describe 1 |> Stdlib.Test.equal "described"
        Ambiguity.Label.describe 1 |> Stdlib.Test.equal "labelled" ]

  // A receiver call cannot pick between two traits with the same method name
  // @compiler xfail compile: "Field access requires a record value" reason=compiler-gap
  test ambiguousReceiverRaises =
    (1).describe
    => raises
      "Int has more than one `describe`: 2 traits declare it. Say which one you mean, as `SomeTrait.describe value`"

module MethodBounds =
  // A method may declare its own type params and bounds, on top of the trait's bound
  // on the self type. They are discharged where the method is CALLED, since a method
  // has no body of its own to check them in.
  type Box = { n: Int64 }

  // @compiler blocked: container-adaptation
  trait Pair<'a> =
    // @compiler blocked: container-adaptation
    let pair<'b: Stdlib.Compare> (v: 'a) (w: 'b) (x: 'b) : Bool

  // @compiler blocked: container-adaptation
  impl Pair for Box =
    // @compiler blocked: container-adaptation
    let pair<'b: Stdlib.Compare> (v: Box) (w: 'b) (x: 'b) : Bool = w < x

  // Two values rather than one compared with itself, and both polarities asserted.
  // `w < w` is false for any total ordering, for a swapped argument order and for a
  // constant `false`, so a test built on it passes whether or not the bound is
  // discharged against the right trait. These four cannot: a swap turns the first
  // two red, and no constant satisfies both.
  // @compiler xfail compile: "Unknown function or value 'MethodBounds.Pair.pair'" reason=upstream-dependency
  test methodBounds =
    Stdlib.Test.all
      [ MethodBounds.Pair.pair (MethodBounds.Box { n = 1L }) 1L 2L
        |> Stdlib.Test.equal true
        MethodBounds.Pair.pair (MethodBounds.Box { n = 1L }) 2L 1L
        |> Stdlib.Test.equal false
        MethodBounds.Pair.pair (MethodBounds.Box { n = 1L }) "a" "b"
        |> Stdlib.Test.equal true ]

  // @compiler xfail compile: "Unknown function or value 'MethodBounds.Pair.pair'" reason=upstream-dependency
  test methodBoundOnBoolRaises =
    MethodBounds.Pair.pair (MethodBounds.Box { n = 1L }) true true
    => raises
      "Bool has no implementation of Darklang.Stdlib.Compare. Write `impl Compare for Bool = ...`, or run `dark impls Compare` to see which types do"

  // A METHOD's own bound is owed against ITS trait, not the enclosing one. `Bool`
  // has no `Compare`, and the error says `Compare`: if the method's bound were
  // discharged against the trait it is declared in, this would ask for a `Pair` impl
  // for Bool instead.

module SortOrder =
  // `List.sort` orders a type that has its own `Compare` the way `<` does. This
  // one's order is the reverse of its structural order, and the tag is ignored by
  // `Compare`.
  type Desc = { descKey: Int64, descTag: String }

  // @compiler blocked: container-adaptation
  impl Compare for Desc =
    // @compiler blocked: container-adaptation
    let lessThan (a: Desc) (b: Desc) : Bool = a.descKey > b.descKey
    // @compiler blocked: container-adaptation
    let lessThanOrEqualTo (a: Desc) (b: Desc) : Bool = a.descKey >= b.descKey
    // @compiler blocked: container-adaptation
    let greaterThan (a: Desc) (b: Desc) : Bool = a.descKey < b.descKey
    // @compiler blocked: container-adaptation
    let greaterThanOrEqualTo (a: Desc) (b: Desc) : Bool = a.descKey <= b.descKey

  // @compiler xfail compile: "No implementation of trait 'Darklang.Stdlib.Compare'" reason=compiler-gap
  test customCompareOrder =
    Stdlib.Test.all
      [ (SortOrder.Desc { descKey = 1L, descTag = "" }
         < SortOrder.Desc { descKey = 2L, descTag = "" })
        |> Stdlib.Test.equal false
        Stdlib.List.sort
          [ SortOrder.Desc { descKey = 1L, descTag = "" }
            SortOrder.Desc { descKey = 3L, descTag = "" }
            SortOrder.Desc { descKey = 2L, descTag = "" } ]
        |> Stdlib.Test.equal
          [ SortOrder.Desc { descKey = 3L, descTag = "" }
            SortOrder.Desc { descKey = 2L, descTag = "" }
            SortOrder.Desc { descKey = 1L, descTag = "" } ] ]

  // Stable: values equal under `Compare` keep the order they came in, whatever their
  // structure.
  // @compiler xfail runtime: "Values differ" reason=compiler-gap
  test stableSort =
    Stdlib.List.sort
      [ SortOrder.Desc { descKey = 1L, descTag = "b" }
        SortOrder.Desc { descKey = 2L, descTag = "x" }
        SortOrder.Desc { descKey = 1L, descTag = "a" } ]
    |> Stdlib.Test.equal
      [ SortOrder.Desc { descKey = 2L, descTag = "x" }
        SortOrder.Desc { descKey = 1L, descTag = "b" }
        SortOrder.Desc { descKey = 1L, descTag = "a" } ]

  // A type with no `Compare` of its own sorts structurally, as before.
  type Plain = { plainKey: Int64 }

  test structuralSort =
    Stdlib.List.sort
      [ SortOrder.Plain { plainKey = 2L }
        SortOrder.Plain { plainKey = 1L } ]
    |> Stdlib.Test.equal
      [ SortOrder.Plain { plainKey = 1L }
        SortOrder.Plain { plainKey = 2L } ]

module Equality =
  // `==` is NOT a trait: equality is structural, for every value, always. A type
  // cannot say what equal means for it, which is what keeps `List.contains`,
  // `List.unique`, `List.sort` and dict keys meaning the same thing as `==`.
  type User = { id: Int64, name: String }

  type Holder = { user: User }

  // Every field counts, including the one a custom equality would have ignored.
  test structuralEquality =
    Stdlib.Test.all
      [ (Equality.User { id = 1L, name = "a" }
         == Equality.User { id = 1L, name = "a" })
        |> Stdlib.Test.equal true
        (Equality.User { id = 1L, name = "a" }
         == Equality.User { id = 1L, name = "b" })
        |> Stdlib.Test.equal false
        (Equality.User { id = 1L, name = "a" }
         != Equality.User { id = 1L, name = "b" })
        |> Stdlib.Test.equal true
        (1 == 1) |> Stdlib.Test.equal true
        1 != 1 |> Stdlib.Test.equal false
        ("a" == "a") |> Stdlib.Test.equal true
        ([ 1, 2 ] == [ 1, 2 ]) |> Stdlib.Test.equal true
        (Stdlib.Option.Option.Some 1 == Stdlib.Option.Option.Some 1)
        |> Stdlib.Test.equal true ]

  // @compiler xfail compile: "Operator is unavailable for this type" reason=compiler-gap
  test intVsStringEqualityRaises =
    (1 == "a")
    => raises "Cannot perform equality check on Int and String"

  // Containers compare element by element, structurally, and agree with the
  // elements.
  test containerEquality =
    Stdlib.Test.all
      [ ([ Equality.User { id = 1L, name = "a" } ]
         == [ Equality.User { id = 1L, name = "a" } ])
        |> Stdlib.Test.equal true
        ([ Equality.User { id = 1L, name = "a" } ]
         == [ Equality.User { id = 1L, name = "b" } ])
        |> Stdlib.Test.equal false
        ([ Equality.User { id = 1L, name = "a" } ]
         != [ Equality.User { id = 1L, name = "b" } ])
        |> Stdlib.Test.equal true ]

  // lengths first
  test lengthsFirst =
    ([ Equality.User { id = 1L, name = "a" } ] == []) |> Stdlib.Test.equal false

  // the same one level down: a tuple slot, a dict value, an Option payload, a record
  // field
  test nestedEquality =
    Stdlib.Test.all
      [ ((1L, Equality.User { id = 1L, name = "a" })
         == (1L, Equality.User { id = 1L, name = "a" }))
        |> Stdlib.Test.equal true
        ((1L, Equality.User { id = 1L, name = "a" })
         == (1L, Equality.User { id = 1L, name = "b" }))
        |> Stdlib.Test.equal false
        ((Stdlib.Dict.fromListOverwritingDuplicates
            [ ("k", Equality.User { id = 1L, name = "a" }) ])
         == (Stdlib.Dict.fromListOverwritingDuplicates
               [ ("k", Equality.User { id = 1L, name = "a" }) ]))
        |> Stdlib.Test.equal true
        (Stdlib.Option.Option.Some(Equality.User { id = 1L, name = "a" })
         == Stdlib.Option.Option.None)
        |> Stdlib.Test.equal false
        ([ [ Equality.User { id = 1L, name = "a" } ] ]
         == [ [ Equality.User { id = 1L, name = "b" } ] ])
        |> Stdlib.Test.equal false
        (Equality.Holder { user = Equality.User { id = 1L, name = "a" } }
         == Equality.Holder { user = Equality.User { id = 1L, name = "a" } })
        |> Stdlib.Test.equal true
        (Equality.Holder { user = Equality.User { id = 1L, name = "a" } }
         == Equality.Holder { user = Equality.User { id = 1L, name = "b" } })
        |> Stdlib.Test.equal false ]

  // a list of builtin values, unchanged throughout
  test builtinListEquality =
    Stdlib.Test.all
      [ ([ 1L, 2L ] == [ 1L, 2L ]) |> Stdlib.Test.equal true
        ([ 1L, 2L ] == [ 1L, 3L ]) |> Stdlib.Test.equal false
        ([] == []) |> Stdlib.Test.equal true ]

module Identities =
  // `Zero`/`One` dispatch from an explicit type arg or a caller's bound: there is
  // no argument to read the type from.
  test explicitTypeArg =
    Stdlib.Test.all
      [ Stdlib.Zero.zero<Int64> () |> Stdlib.Test.equal 0L
        Stdlib.One.one<Float> () |> Stdlib.Test.equal 1.0 ]

  // @compiler xfail compile: "No implementation of trait 'Darklang.Stdlib.Zero'" reason=compiler-gap
  test zeroWithoutTypeRaises =
    Stdlib.Zero.zero ()
    => raises
      "Zero.zero has no argument to read a type from, so it cannot tell which type you mean. Name it: `Zero.zero<Int64> ...`"

  let zeroOf<'a: Stdlib.Zero + Stdlib.Add> (x: 'a) : 'a = Stdlib.Zero.zero () + x

  test boundedZero =
    Stdlib.Test.all
      [ Identities.zeroOf 5L |> Stdlib.Test.equal 5L
        Identities.zeroOf 2.5 |> Stdlib.Test.equal 2.5 ]

  // `sum` and `product` take a seed, so `[]` never has to ask
  // @compiler xfail compile: "No implementation of trait 'Darklang.Stdlib.Add'" reason=compiler-gap
  test seededSumAndProduct =
    Stdlib.Test.all
      [ Stdlib.sum 0L [ 1L, 2L, 3L ] |> Stdlib.Test.equal 6L
        Stdlib.sum 0.0 [] |> Stdlib.Test.equal 0.0
        Stdlib.product 1 [ 2, 3, 4 ] |> Stdlib.Test.equal 24
        Stdlib.sum (Multi.Vec { dx = 0, dy = 0 })
          [ Multi.Vec { dx = 1, dy = 2 }
            Multi.Vec { dx = 3, dy = 4 } ]
        |> Stdlib.Test.equal (Multi.Vec { dx = 4, dy = 6 }) ]

module Rendering =
  // `ToString` is the trait behind every builtin type's `toString`
  type Point = { x: Int64, y: Int64 }

  // @compiler blocked: container-adaptation
  impl Stdlib.ToString for Point =
    // @compiler blocked: container-adaptation
    let toString (p: Point) : String =
      $"({Stdlib.toString p.x}, {Stdlib.toString p.y})"

  // @compiler xfail compile: "Unknown field 'toString' on Darklang.Language.Tests.Traits.Rendering.Point" reason=compiler-gap
  test toStringTrait =
    Stdlib.Test.all
      [ (Rendering.Point { x = 1L, y = 2L }).toString |> Stdlib.Test.equal "(1, 2)"
        Stdlib.toString (Rendering.Point { x = 1L, y = 2L })
        |> Stdlib.Test.equal "(1, 2)"
        Stdlib.toString 42L |> Stdlib.Test.equal "42"
        Stdlib.toString true |> Stdlib.Test.equal "true"
        Stdlib.toString 2.5 |> Stdlib.Test.equal "2.5"
        (7).toString |> Stdlib.Test.equal "7"
        Stdlib.max 3L 9L |> Stdlib.Test.equal 9L ]

  // String, Char and DateTime implement Compare, so the generics cover them too
  test compareOnStringsAndChars =
    Stdlib.Test.all
      [ Stdlib.min "apple" "banana" |> Stdlib.Test.equal "apple"
        Stdlib.max 'a' 'z' |> Stdlib.Test.equal 'z' ]

  // Limits in either order; a value outside them comes back as the nearer one
  test clamp =
    Stdlib.Test.all
      [ Stdlib.clamp 15 20 10 |> Stdlib.Test.equal 15
        Stdlib.clamp 25 20 10 |> Stdlib.Test.equal 20
        Stdlib.clamp 5 10 20 |> Stdlib.Test.equal 10 ]

  // A type with no Compare implementation is what the bound refuses
  // @compiler xfail compile: "No implementation of trait 'Darklang.Stdlib.Compare'" reason=compiler-gap
  test minOnBoolRaises =
    Stdlib.min true false
    => raises
      "Bool has no implementation of Darklang.Stdlib.Compare. Write `impl Compare for Bool = ...`, or run `dark impls Compare` to see which types do"

  // `abs` needs three traits at once: compare, negate, and a zero to compare against
  test abs =
    Stdlib.Test.all
      [ Stdlib.abs -5L |> Stdlib.Test.equal 5L
        Stdlib.abs 2.5 |> Stdlib.Test.equal 2.5
        Stdlib.abs 0 |> Stdlib.Test.equal 0 ]

  // an unsigned type has no Negate implementation, so it has no abs either
  // @compiler xfail compile: "No implementation of trait 'Darklang.Stdlib.Negate'" reason=compiler-gap
  test absOfUnsignedRaises =
    Stdlib.abs 5uy
    => raises
      "UInt8 has no implementation of Darklang.Stdlib.Negate. Write `impl Negate for UInt8 = ...`, or run `dark impls Negate` to see which types do"
