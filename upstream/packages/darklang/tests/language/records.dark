module Darklang.Language.Tests.Records

type Cols1 = { col1: Int64 }
type Cols2 = { col1: Int64, col2: Int64 }

// Distinct case names keep this type separate from other enums with the same shape,
// so the runtime error has a stable type name.
type AnEnum = | RecordTestA | RecordTestB | RecordTestC

test construction =
  Cols2 { col1 = 1L, col2 = 3L }
  |> Stdlib.Test.equal (Cols2 { col1 = 1L, col2 = 3L })

test fieldErrorRaises =
  Cols2 { col1 = 2L, col2 = Stdlib.Test.raiseRuntimeError "test" }
  => raises "Uncaught exception: test"

module WithTypeArgs =
  type Owner<'a> = { item: 'a }
  type CoOwner<'a> = Owner<'a>

  test aliasWithTypeArg =
    Owner { item = 5L } |> Stdlib.Test.equal (CoOwner { item = 5L })

  type C<'c> = { v: 'c }
  type B<'b> = { c: C<'b> }
  type A<'a> = { b: B<'a> }

  let getC (a: A<Int64>) : Int64 = a.b.c.v

  test nestedTypeArgs =
    getC (A { b = B { c = C { v = 5L } } }) |> Stdlib.Test.equal 5L

module InvalidCols =
  // @compiler xfail compile: "Duplicate record field 'col1'" class=aot-rejection reason=aot-invalid-field
  test duplicateFieldRaises =
    Cols1 { col1 = 1L, col1 = 2L } => raises "Duplicate field `col1`"

  // @compiler xfail compile: "Unknown field '' on Darklang.Language.Tests.Records.Cols2" class=aot-rejection reason=aot-invalid-field
  test emptyKeyRaises =
    Cols2 { col1 = 2L, ___ = 3L } => raises "Empty key in record creation"

  // @compiler xfail compile: "record literal does not contain exactly the declared field slots" class=aot-rejection reason=aot-invalid-field
  test missingFieldRaises =
    Cols2 { col1 = 2L } => raises "Missing field `col2`"

  // @compiler xfail compile: "Unknown field 'other' on Darklang.Language.Tests.Records.Cols2" class=aot-rejection reason=aot-invalid-field
  test unknownFieldRaises =
    Cols2 { col1 = 2L, other = 3L } => raises "No field named `other`"

  // @compiler xfail compile: "Unknown field 'col3' on Darklang.Language.Tests.Records.Cols2" class=aot-rejection reason=aot-invalid-field
  test extraFieldRaises =
    Cols2 { col1 = 2L, col2 = 3L, col3 = 4L } => raises "No field named `col3`"

  // @compiler xfail compile: "Expected TInt64, got TString" class=aot-rejection reason=aot-type-error
  test wrongFieldTypeRaises =
    Cols1 { col1 = "" }
    => raises
      "Failed to create record. Expected Int64 for field `col1`, but got \"\" (a String)"

module InvalidType =
  // Evaluate the unresolved name from source at run time so it does not prevent
  // the package from loading. Check both the error branch and its message.
  // @compiler xfail compile: "Unknown function or value 'Darklang.SCM.PackageOps.currentBranch'" class=missing-support reason=upstream-dependency
  test unknownTypeRaises =
    let branch = Darklang.SCM.PackageOps.currentBranch ()
    let source = "MyNonExistantType { col1 = 2L }"
    match Darklang.Cli.Eval.evaluateRaw None branch source [] false with
    | Error(Runtime error) ->
      Darklang.PrettyPrinter.RuntimeTypes.RuntimeError.toString branch error
      |> Stdlib.Test.equal "MyNonExistantType not found"
    | _ -> Stdlib.Test.fail "expected a runtime error for an unknown record type"

  // @compiler xfail compile: "Expected a record type" class=aot-rejection reason=aot-type-error
  test enumIsNotRecordRaises =
    AnEnum { col1 = 2L }
    => raises
      "Expected a record, but Darklang.Language.Tests.Records.AnEnum is not one"

module Polymorphism =
  type MyRecord<'a> = { col1: 'a, col2: Int64 }

  test typeArgFields =
    Stdlib.Test.all
      [ (MyRecord { col1 = (), col2 = 1L }).col2 |> Stdlib.Test.equal 1L
        (MyRecord
          { col1 = Stdlib.Option.Option.Some(Stdlib.Result.Result.Ok 1L)
            col2 = 1L })
          .col1
        |> Stdlib.Test.equal
          (Stdlib.Option.Option.Some(Stdlib.Result.Result.Ok 1L)) ]

module Nested =
  type NestedRecordA = { col1: Int64 }
  type NestedRecordB = { col1: NestedRecordA }

  test nestedFieldAccess =
    (NestedRecordB { col1 = NestedRecordA { col1 = 1L } }).col1.col1
    |> Stdlib.Test.equal 1L

module Update =
  type RecordForUpdate = { x: Int64, y: Int64 }
  type RecordForUpdateMultiple = { x: Int64, y: Int64, z: Int64 }

  // @compiler xfail compile: "Duplicate record field 'y'" class=missing-support reason=compiler-gap
  test updates =
    Stdlib.Test.all
      [ ({ RecordForUpdate { x = 4L, y = 1L } with y = 2L })
        |> Stdlib.Test.equal (RecordForUpdate { x = 4L, y = 2L })
        (let myRec = RecordForUpdate { x = 4L, y = 1L }
         { myRec with y = 2L })
        |> Stdlib.Test.equal (RecordForUpdate { x = 4L, y = 2L })
        (let myRec = RecordForUpdate { x = 4L, y = 1L }
         { myRec with y = 22L, y = 42L })
        |> Stdlib.Test.equal (RecordForUpdate { x = 4L, y = 42L })
        (let myRec = RecordForUpdateMultiple { x = 4L, y = 1L, z = 0L }
         { myRec with y = 2L, z = 42L })
        |> Stdlib.Test.equal (RecordForUpdateMultiple { x = 4L, y = 2L, z = 42L })
        (let myRec = RecordForUpdateMultiple { x = 4L, y = 1L, z = 0L }
         { myRec with z = 3L, x = 42L })
        |> Stdlib.Test.equal (RecordForUpdateMultiple { x = 42L, y = 1L, z = 3L })
        (let myRec = RecordForUpdateMultiple { x = 4L, y = 1L, z = 0L }
         { myRec with z = 3L, x = 42L, y = 11L })
        |> Stdlib.Test.equal (RecordForUpdateMultiple { x = 42L, y = 11L, z = 3L }) ]

  // An update of a record whose type argument is still unknown, inside a fn with
  // no type parameters, called from a fn whose type parameter has the record's
  // parameter's name. The caller's `'a` must not fill the record's.
  module UnderAGenericCaller =
    type UpdBox<'a> = { updItems: List<'a> }

    let emptyUpdBox () : UpdBox<String> =
      let b = UpdBox { updItems = [] }
      { b with updItems = [] }

    let viaGeneric<'a> (xs: List<'a>) : UpdBox<String> = emptyUpdBox ()

    test genericCallerKeepsOwnTypeArg =
      Stdlib.List.length (viaGeneric [ 1L ]).updItems |> Stdlib.Test.equal 0

  module Invalid =
    // @compiler xfail compile: "Unknown field 'p' on Darklang.Language.Tests.Records.Update.RecordForUpdateMultiple" class=aot-rejection reason=aot-invalid-field
    test unknownFieldRaises =
      (let myRec = RecordForUpdateMultiple { x = 4L, y = 1L, z = 0L }
       { myRec with z = 3L, x = 42L, y = 11L, p = 10L })
      => raises "No field named `p`"

    // @compiler xfail compile: "Unknown field 'other' on Darklang.Language.Tests.Records.Update.RecordForUpdate" class=aot-rejection reason=aot-invalid-field
    test otherFieldRaises =
      (let myRec = RecordForUpdate { x = 4L, y = 1L }
       { myRec with other = 2L })
      => raises "No field named `other`"

    // @compiler xfail compile: "Expected TInt64, got TString" class=aot-rejection reason=aot-type-error
    test wrongFieldTypeRaises =
      (let myRec = RecordForUpdate { x = 4L, y = 1L }
       { myRec with y = "2" })
      => raises
        "Failed to create updated record. Expected Int64 for field `y`, but got \"2\" (a String)"

module FieldAccess =
  type MyRecord = { col1: Int64 }

  test fieldAccess =
    (let x = MyRecord { col1 = 1L } in x.col1) |> Stdlib.Test.equal 1L

  module Errors =
    // @compiler xfail compile: "Unknown field '' on Darklang.Language.Tests.Records.FieldAccess.MyRecord" class=aot-rejection reason=aot-invalid-field
    test emptyFieldNameRaises =
      (let x = MyRecord { col1 = 1L } in x.___) => raises "Field name is empty"

    // @compiler xfail compile: "Unknown field 'fieldName' on Darklang.Language.Tests.Records.FieldAccess.MyRecord" class=aot-rejection reason=aot-invalid-field
    test missingFieldRaises =
      (let x = MyRecord { col1 = 1L } in x.fieldName)
      => raises "Tried to access field `fieldName`, but it doesn't exist"

    // `(Builtin.testRuntimeError "error").fieldName` is in errorPropagation.dark.

    // @compiler xfail compile: "Field access requires a record value" class=aot-rejection reason=aot-invalid-field
    test accessOnInt64Raises =
      (let x = 6L in x.fieldName)
      => raises
        "Attempting to perform field access of an Int64, but this only works with records and tuples"
