module Darklang.SCM.Tests.CommitHash

// A commit id is derived from what the commit holds and where it sits: the same inputs give the same id
// on two machines, and each input moved gives a different id. The ORDER of `opIds` is the caller's job
// (`draftOpIdsFor` sorts), and the last row records that `mintHash` itself does not sort, so if that ever
// becomes true the sort has moved and `draftOpIdsFor`'s ORDER BY is dead.
//
// The branch is deliberately not an input. A commit is its message, stamp, ops and parent;
// where it happens to sit is a property of the branch, not of the commit, so the same work committed
// on two branches is the same commit.

module MintHash =
  // @compiler blocked: missing-implementation
  val ts = "2026-01-01T00:00:00.000Z"

  // @compiler blocked: upstream-dependency
  let h (message: String) (stamp: String) (ops: List<String>) (parent: String) : String =
    Darklang.SCM.Commits.mintHash message stamp ops parent

  // Deterministic.
  // @compiler blocked: pending-validation
  test deterministic =
    MintHash.h "m" MintHash.ts [ "aabb", "ccdd" ] "0011"
    |> Stdlib.Test.equal (MintHash.h "m" MintHash.ts [ "aabb", "ccdd" ] "0011")

  // Sixteen hex characters.
  // @compiler blocked: pending-validation
  test sixteenHex =
    Stdlib.String.length (MintHash.h "m" MintHash.ts [ "aabb" ] "0011")
    |> Stdlib.Test.equal 16

  // Each input moved: a different id.
  // @compiler blocked: pending-validation
  test eachInputChangesId =
    Stdlib.Test.all
      [ ((MintHash.h "m" MintHash.ts [ "aabb" ] "0011") == (MintHash.h "m" MintHash.ts [ "aabb" ] "0022"))
        |> Stdlib.Test.equal false
        ((MintHash.h "m" MintHash.ts [ "aabb" ] "0011") == (MintHash.h "n" MintHash.ts [ "aabb" ] "0011"))
        |> Stdlib.Test.equal false
        ((MintHash.h "m" MintHash.ts [ "aabb" ] "0011") == (MintHash.h "m" "2026-01-01T00:00:00.001Z" [ "aabb" ] "0011"))
        |> Stdlib.Test.equal false
        ((MintHash.h "m" MintHash.ts [ "aabb" ] "0011") == (MintHash.h "m" MintHash.ts [ "aabb", "ccdd" ] "0011"))
        |> Stdlib.Test.equal false ]

  // An empty commit is still deterministic.
  // @compiler blocked: pending-validation
  test emptyCommitDeterministic =
    MintHash.h "m" MintHash.ts [] "0011"
    |> Stdlib.Test.equal (MintHash.h "m" MintHash.ts [] "0011")

  // Not sorted here.
  // @compiler blocked: pending-validation
  test notSorted =
    ((MintHash.h "m" MintHash.ts [ "aabb", "ccdd" ] "0011") == (MintHash.h "m" MintHash.ts [ "ccdd", "aabb" ] "0011"))
    |> Stdlib.Test.equal false
