// Duration.parse: suffix-based short-duration parsing ("30s"/"5m"/"1h"/"2d")
// into a number of seconds (arbitrary-precision Int).
module Darklang.Stdlib.Duration.Tests

// --- units ---
// @compiler blocked: pending-validation
test parseUnits =
  Stdlib.Test.all
    [ Stdlib.Duration.parse "30s" |> Stdlib.Test.equal (Ok 30)
      Stdlib.Duration.parse "5m" |> Stdlib.Test.equal (Ok 300)
      Stdlib.Duration.parse "1h" |> Stdlib.Test.equal (Ok 3600)
      Stdlib.Duration.parse "2d" |> Stdlib.Test.equal (Ok 172800)
      Stdlib.Duration.parse "0s" |> Stdlib.Test.equal (Ok 0) ]

// --- arbitrary precision: a value past Int64 range now parses (Int64.parse
// would have rejected it as out-of-range) ---
// @compiler blocked: pending-validation
test parseBeyondInt64 =
  Stdlib.Duration.parse "9223372036854775808s"
  |> Stdlib.Test.equal (Ok 9223372036854775808)

// --- errors ---
// too short (no unit)
// @compiler blocked: pending-validation
test parseRejectsMissingUnit =
  Stdlib.Test.all
    [ Stdlib.Duration.parse "5"
      |> Stdlib.Test.equal
        (Error "Duration too short: '5'; need a number + unit (s/m/h/d), e.g. 5m")
      Stdlib.Duration.parse "s"
      |> Stdlib.Test.equal
        (Error "Duration too short: 's'; need a number + unit (s/m/h/d), e.g. 5m") ]

// non-numeric number part
// @compiler blocked: pending-validation
test parseRejectsNonNumeric =
  Stdlib.Duration.parse "xm"
  |> Stdlib.Test.equal
    (Error "Invalid duration 'xm'; need a number + unit (s/m/h/d), e.g. 5m")

// unknown unit
// @compiler blocked: pending-validation
test parseRejectsUnknownUnit =
  Stdlib.Duration.parse "5x"
  |> Stdlib.Test.equal (Error "Unknown unit 'x' in '5x'; use s, m, h, or d")
