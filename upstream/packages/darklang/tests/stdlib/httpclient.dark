// Additional HTTP client cases. Raw protocol tests live in backend/testfiles/httpclient.
module Darklang.Stdlib.HttpClient.Tests

// Tests that don't use the internet
// @compiler blocked: pending-validation
test contentTypes =
  Stdlib.Test.all
    [ Stdlib.HttpClient.ContentType.form
      |> Stdlib.Test.equal ("content-type", "application/x-www-form-urlencoded")
      Stdlib.HttpClient.ContentType.json
      |> Stdlib.Test.equal ("content-type", "application/json")
      Stdlib.HttpClient.ContentType.plainText
      |> Stdlib.Test.equal ("content-type", "text/plain; charset=utf-8")
      Stdlib.HttpClient.ContentType.html
      |> Stdlib.Test.equal ("content-type", "text/html; charset=utf-8") ]

// @compiler blocked: pending-validation
test bearerToken =
  Stdlib.HttpClient.bearerToken "YWxhZGRpbjpvcGVuc2VzYW1l"
  |> Stdlib.Test.equal ("authorization", "bearer YWxhZGRpbjpvcGVuc2VzYW1l")

// @compiler blocked: pending-validation
test basicAuth =
  Stdlib.Test.all
    [ Stdlib.HttpClient.basicAuth "username" "password"
      |> Stdlib.Test.equal (Ok(("authorization", "basic dXNlcm5hbWU6cGFzc3dvcmQ=")))
      Stdlib.HttpClient.basicAuth "" ""
      |> Stdlib.Test.equal (Ok(("authorization", "basic Og==")))
      Stdlib.HttpClient.basicAuth "" "-"
      |> Stdlib.Test.equal (Ok(("authorization", "basic Oi0=")))
      Stdlib.HttpClient.basicAuth ":" ""
      |> Stdlib.Test.equal (Ok(("authorization", "basic Ojo=")))
      Stdlib.HttpClient.basicAuth "" ":"
      |> Stdlib.Test.equal (Ok(("authorization", "basic Ojo=")))
      Stdlib.HttpClient.basicAuth "hello>" "world"
      |> Stdlib.Test.equal (Ok(("authorization", "basic aGVsbG8+Ondvcmxk")))
      Stdlib.HttpClient.basicAuth "hello" "world?"
      |> Stdlib.Test.equal (Ok(("authorization", "basic aGVsbG86d29ybGQ/"))) ]

// @compiler blocked: pending-validation
test basicAuthRejectsHyphenInUsername =
  Stdlib.HttpClient.basicAuth "-" ""
  |> Stdlib.Test.equal (Error "Username cannot contain a hyphen")

// Tests that try to make requests to the internet

// ... but first, some helpers
// @compiler blocked: missing-implementation
type GetResult =
  Stdlib.Result.Result<Stdlib.HttpClient.Response, Stdlib.HttpClient.RequestError>

// @compiler blocked: upstream-dependency
let get (url: String) (headers: List<String * String>) : GetResult =
  Stdlib.HttpClient.get url headers

// Build custom values in functions so their types stay current across package reloads.
// @compiler blocked: upstream-dependency
let errInvalidHost () : GetResult =
  Error(
    Stdlib.HttpClient.RequestError.BadUrl(Stdlib.HttpClient.BadUrlDetails.InvalidHost)
  )

// @compiler blocked: upstream-dependency
let errInvalidUri () : GetResult =
  Error(
    Stdlib.HttpClient.RequestError.BadUrl(Stdlib.HttpClient.BadUrlDetails.InvalidUri)
  )

// @compiler blocked: upstream-dependency
let errInvalidRequest () : GetResult =
  Error(
    Stdlib.HttpClient.RequestError.BadUrl(
      Stdlib.HttpClient.BadUrlDetails.InvalidRequest
    )
  )

// @compiler blocked: upstream-dependency
let errNetworkError () : GetResult =
  Error(Stdlib.HttpClient.RequestError.NetworkError)

// @compiler blocked: upstream-dependency
let errBadHeaderEmptyKey () : GetResult =
  Error(
    Stdlib.HttpClient.RequestError.BadHeader(Stdlib.HttpClient.BadHeader.EmptyKey)
  )

// @compiler blocked: upstream-dependency
let errBadMethod () : GetResult = Error(Stdlib.HttpClient.RequestError.BadMethod)

// @compiler blocked: upstream-dependency
let errUnsupportedProtocol () : GetResult =
  Error(
    Stdlib.HttpClient.RequestError.BadUrl(
      Stdlib.HttpClient.BadUrlDetails.UnsupportedProtocol
    )
  )

