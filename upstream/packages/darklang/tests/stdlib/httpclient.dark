// @compiler blocked: pending-validation
test rejectsWrongHeaderType =
  Stdlib.HttpClient.request "get" "https://darklang.com" [1L] Stdlib.Blob.empty
  => raises "Darklang.Stdlib.HttpClient.request's 3rd parameter `headers` expects List<(String * String)>, but got List<Int64> ([1])"

// @compiler blocked: pending-validation
test rejectsEmptyHeaderKey =
  get "https://darklang.com" [ ("", "") ]
  |> Stdlib.Test.equal (errBadHeaderEmptyKey ())

// type errors for bad `method` are OK
// @compiler blocked: pending-validation
test rejectsBadMethods =
  Stdlib.Test.all
    [ Stdlib.HttpClient.request "" "https://darklang.com" [] Stdlib.Blob.empty
      |> Stdlib.Test.equal (errBadMethod ())
      Stdlib.HttpClient.request " get " "https://darklang.com" [] Stdlib.Blob.empty
      |> Stdlib.Test.equal (errBadMethod ())
      Stdlib.HttpClient.request "🇵🇷" "https://darklang.com" [] Stdlib.Blob.empty
      |> Stdlib.Test.equal (errBadMethod ()) ]

// unsupported protocols
// @compiler blocked: pending-validation
test rejectsUnsupportedProtocols =
  Stdlib.Test.all
    [ Stdlib.HttpClient.request "get" "ftp://darklang.com" [] Stdlib.Blob.empty
      |> Stdlib.Test.equal (errUnsupportedProtocol ())
      Stdlib.HttpClient.request "put" "file:///etc/passwd" [] Stdlib.Blob.empty
      |> Stdlib.Test.equal (errUnsupportedProtocol ())
      Stdlib.HttpClient.request "put" "/just-a-path" [] Stdlib.Blob.empty
      |> Stdlib.Test.equal (errUnsupportedProtocol ()) ]

// totally bogus URLs
// @compiler blocked: pending-validation
test rejectsBogusUrls =
  Stdlib.Test.all
    [ Stdlib.HttpClient.request "get" "" [] Stdlib.Blob.empty
      |> Stdlib.Test.equal
        (Error(
          Stdlib.HttpClient.RequestError.BadUrl(Stdlib.HttpClient.BadUrlDetails.InvalidUri)
        ))
      Stdlib.HttpClient.request "post" "{ ] nonsense ^#( :" [] Stdlib.Blob.empty
      |> Stdlib.Test.equal
        (Error(
          Stdlib.HttpClient.RequestError.BadUrl(Stdlib.HttpClient.BadUrlDetails.InvalidUri)
        )) ]

// Timeout coverage lives in Tests.HttpClient.TimeoutTests: a controlled transport
// waits for the real request deadline. An external unreachable port may instead
// fail with NetworkError, and package HTTP deliberately blocks local fixtures.
// The backend fixture asserts Timeout for both GET and POST without internet access.

// Check for banned urls in the host name
// SSRF guard tests for the strict HTTP client config
// (see Builtins.Http.Client.Libs.HttpClient.LocalAccess + strictConfig).

// invalid host
// @compiler blocked: pending-validation
test disallowedHosts =
  Stdlib.Test.all
    [ get "http://0.0.0.0" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://0" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://localhost" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://127.0.0.1" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://[::1]" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://[0:0:0:0:0:0:0:1]" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://[0000:0000:0000:0000:0000:0000:0000:0001]" []
      |> Stdlib.Test.equal (errInvalidHost ())
      get "http://127.0.0.17" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://[::ffff:7f00:11]" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://[0:0:0:0:0:ffff:7f00:0011]" []
      |> Stdlib.Test.equal (errInvalidHost ())
      get "http://[0000:0000:0000:0000:0000:ffff:7f00:0011]" []
      |> Stdlib.Test.equal (errInvalidHost ())
      get "http://127.255.174.17" [] |> Stdlib.Test.equal (errInvalidHost ())
      // The ranges `http.private` widens, in their default state.
      get "http://10.0.0.5" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://172.16.0.5" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://192.168.1.5" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://100.64.0.5" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://[fd00::1]" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://metadata.google.internal" []
      |> Stdlib.Test.equal (errInvalidHost ())
      get "http://metadata" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://169.254.169.254" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://[::ffff:a9fe:a9fe]" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://[0:0:0:0:0:ffff:a9fe:a9fe]" []
      |> Stdlib.Test.equal (errInvalidHost ())
      get "http://[0000:0000:0000:0000:0000:ffff:a9fe:a9fe]" []
      |> Stdlib.Test.equal (errInvalidHost ())
      get "http://169.254.0.0" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://172.16.0.1" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://[::ffff:ac10:1]" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://[0:0:0:0:0:ffff:ac10:0001]" []
      |> Stdlib.Test.equal (errInvalidHost ())
      get "http://[0000:0000:0000:0000:0000:ffff:ac10:0001]" []
      |> Stdlib.Test.equal (errInvalidHost ())
      get "http://192.168.1.1" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://[::ffff:c0a8:101]" [] |> Stdlib.Test.equal (errInvalidHost ())
      get "http://[0:0:0:0:0:ffff:c0a8:0101]" []
      |> Stdlib.Test.equal (errInvalidHost ())
      get "http://[0000:0000:0000:0000:0000:ffff:c0a8:0101]" []
      |> Stdlib.Test.equal (errInvalidHost ()) ]

// invalid uri
// @compiler blocked: pending-validation
test disallowedUri =
  get "localhost" [] |> Stdlib.Test.equal (errInvalidUri ())

// network error
// @compiler blocked: pending-validation
test unspecifiedAddressIsNetworkError =
  get "http://[0:0:0:0:0:0:0:0]" [] |> Stdlib.Test.equal (errNetworkError ())

// Sneaky banned urls: a hostname that looks fine but resolves somewhere banned.
// Blocked in the connect callback, after resolution, rather than by the URL
// validation above. This is the case that actually matters for SSRF.
//
// These names are in the container's /etc/hosts (scripts/devcontainer/_setup-hosts).
// They used to be borrowed third-party domains, localtest.me and c.cx, until c.cx
// stopped resolving to 0.0.0.0 and started answering for real.
//
// Caveat: a name that doesn't resolve at all also gives NetworkError, so without
// those /etc/hosts entries these three pass without testing anything. That was
// true of the third-party version too. Nothing in the public API distinguishes
// "blocked at connect" from "never resolved".
// @compiler blocked: pending-validation
test sneakyBannedHosts =
  Stdlib.Test.all
    [ // 127.0.0.1
      get "http://banned-loopback.dark.test" []
      |> Stdlib.Test.equal (errNetworkError ())
      // 0.0.0.0
      get "http://banned-zero.dark.test" [] |> Stdlib.Test.equal (errNetworkError ())
      // 10.0.0.1
      get "http://banned-private.dark.test" []
      |> Stdlib.Test.equal (errNetworkError ()) ]

// invalid headers (we just happen to know that google will fail this way if we
// provide these headers..)
// @compiler blocked: pending-validation
test disallowedHeaders =
  Stdlib.Test.all
    [ get "http://google.com" [ ("Metadata-Flavor", "Google") ]
      |> Stdlib.Test.equal (errInvalidRequest ())
      get "http://google.com" [ ("metadata-flavor", "Google") ]
      |> Stdlib.Test.equal (errInvalidRequest ())
      get "http://google.com" [ ("Metadata-Flavor", " Google ") ]
      |> Stdlib.Test.equal (errInvalidRequest ())
      get "http://google.com" [ ("X-Google-Metadata-Request", " True ") ]
      |> Stdlib.Test.equal (errInvalidRequest ())
      get "http://google.com" [ (" x-Google-metaData-Request", " True ") ]
      |> Stdlib.Test.equal (errInvalidRequest ()) ]

// `.test` cannot resolve publicly. Depending on the DNS environment, that is
// reported immediately as NetworkError or when the request times out.
// @compiler blocked: pending-validation
test missingHostFails =
  (match get "http://no-such-host.dark.test" [] with
   | Error NetworkError -> true
   | Error Timeout -> true
   | _ -> false)
  |> Stdlib.Test.equal true

