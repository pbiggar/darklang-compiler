module Darklang.Stdlib.Int16.Tests

// @compiler blocked: pending-validation
test abs =
  Stdlib.Test.all
    [ Stdlib.abs -5s |> Stdlib.Test.equal 5s
      Stdlib.abs 5s |> Stdlib.Test.equal 5s
      Stdlib.abs -32768s |> Stdlib.Test.equal -32768s ]

// `Stdlib.max`, `min` and `clamp` are one generic over `Compare`; these check
// that it reaches this type and that the type's own comparison holds at its
// extremes.

// @compiler blocked: pending-validation
test max =
  Stdlib.max 32767s -32768s |> Stdlib.Test.equal 32767s

// @compiler blocked: pending-validation
test min =
  Stdlib.min 32767s -32768s |> Stdlib.Test.equal -32768s

// @compiler blocked: pending-validation
test clamp =
  Stdlib.clamp -100s 0s -1s |> Stdlib.Test.equal -1s

/// Wraps on overflow.
// @compiler blocked: pending-validation
test add =
  Stdlib.Test.all
    [ (10s + 9s) |> Stdlib.Test.equal 19s
      (88s + 9s) |> Stdlib.Test.equal 97s
      (-1s + 2s) |> Stdlib.Test.equal 1s
      (1s + 0s) |> Stdlib.Test.equal 1s
      (-55s + 55s) |> Stdlib.Test.equal 0s
      (30000s + 2767s) |> Stdlib.Test.equal 32767s
      (-30000s + -2768s) |> Stdlib.Test.equal -32768s
      (-30000s + -2769s) |> Stdlib.Test.equal 32767s
      (30000s + 2768s) |> Stdlib.Test.equal -32768s ]

/// Wraps on overflow.
// @compiler blocked: pending-validation
test subtract =
  Stdlib.Test.all
    [ (10s - 9s) |> Stdlib.Test.equal 1s
      (88s - 9s) |> Stdlib.Test.equal 79s
      (0s - 1s) |> Stdlib.Test.equal -1s
      (1s - 0s) |> Stdlib.Test.equal 1s
      (-55s - -55s) |> Stdlib.Test.equal 0s
      (-2769s - 30000s) |> Stdlib.Test.equal 32767s ]

/// Wraps on overflow.
// @compiler blocked: pending-validation
test multiply =
  Stdlib.Test.all
    [ (8s * 8s) |> Stdlib.Test.equal 64s
      (1s * 0s) |> Stdlib.Test.equal 0s
      (5145s * 5145s) |> Stdlib.Test.equal -5519s ]

/// Wraps on overflow.
// @compiler blocked: pending-validation
test power =
  Stdlib.Test.all
    [ (2s ** 3s) |> Stdlib.Test.equal 8s
      (0s ** 1s) |> Stdlib.Test.equal 0s
      (1s ** 0s) |> Stdlib.Test.equal 1s
      (0s ** 0s) |> Stdlib.Test.equal 1s
      (-2s ** 5s) |> Stdlib.Test.equal -32s
      (-1s ** 5s) |> Stdlib.Test.equal -1s
      (-1s ** 6s) |> Stdlib.Test.equal 1s
      (1s ** 32767s) |> Stdlib.Test.equal 1s
      (2s ** 15s) |> Stdlib.Test.equal -32768s
      (120s ** 20s) |> Stdlib.Test.equal 0s ]

// @compiler blocked: pending-validation
test powerRejectsNegativeExponent =
  (2s ** -3s)
  => raises "Cannot raise integer to a negative exponent"

// @compiler blocked: pending-validation
test powerOfZeroRejectsNegativeExponent =
  (0s ** -1s)
  => raises "Cannot raise integer to a negative exponent"

// @compiler blocked: pending-validation
test powerOfOneRejectsNegativeExponent =
  (1s ** -5s)
  => raises "Cannot raise integer to a negative exponent"

// @compiler blocked: pending-validation
test powerOfMinusOneRejectsNegativeExponent =
  (-1s ** -3s)
  => raises "Cannot raise integer to a negative exponent"

// @compiler blocked: pending-validation
test divide =
  Stdlib.Test.all
    [ (10s / 5s) |> Stdlib.Test.equal 2s
      (17s / 3s) |> Stdlib.Test.equal 5s
      (-8s / 5s) |> Stdlib.Test.equal -1s
      (0s / 1s) |> Stdlib.Test.equal 0s
      (-32768s / -1s) |> Stdlib.Test.equal -32768s
      (-32768s / 1s) |> Stdlib.Test.equal -32768s ]

// @compiler blocked: pending-validation
test divideOfOneRejectsZero =
  (1s / 0s)
  => raises "Cannot divide by 0"

// @compiler blocked: pending-validation
test negate =
  Stdlib.Test.all
    [ (--5s) |> Stdlib.Test.equal 5s
      (-(5s)) |> Stdlib.Test.equal -5s
      (-0s) |> Stdlib.Test.equal 0s
      (--0s) |> Stdlib.Test.equal 0s
      (--32768s) |> Stdlib.Test.equal -32768s ]

/// A Result: the sign follows the dividend, and it is an Error only when the
/// divisor is 0.
// @compiler blocked: pending-validation
test remainder =
  Stdlib.Test.all
    [ Stdlib.Int16.remainder 15s 6s |> Stdlib.Test.equal (Ok 3s)
      Stdlib.Int16.remainder -20s 8s |> Stdlib.Test.equal (Ok -4s)
      Stdlib.Int16.remainder -20s -8s |> Stdlib.Test.equal (Ok -4s)
      Stdlib.Int16.remainder -32768s -1s |> Stdlib.Test.equal (Ok 0s)
      Stdlib.Int16.remainder 5s 0s
      |> Stdlib.Test.equal (Error "Cannot divide by 0") ]

// @compiler blocked: pending-validation
test greaterThan =
  Stdlib.Test.all
    [ (20s > 1s) |> Stdlib.Test.equal true
      (20s > 130s) |> Stdlib.Test.equal false ]

// @compiler blocked: pending-validation
test greaterThanOrEqualTo =
  Stdlib.Test.all
    [ (0s >= 1s) |> Stdlib.Test.equal false
      (1s >= 0s) |> Stdlib.Test.equal true
      (6s >= 1s) |> Stdlib.Test.equal true
      (6s >= 8s) |> Stdlib.Test.equal false
      (-5s >= -20s) |> Stdlib.Test.equal true
      (-20s >= -1s) |> Stdlib.Test.equal false
      (-20s >= -20s) |> Stdlib.Test.equal true
      (-130s >= -20s) |> Stdlib.Test.equal false ]

// @compiler blocked: pending-validation
test lessThan =
  Stdlib.Test.all
    [ (6s < 8s) |> Stdlib.Test.equal true
      (10s < 1s) |> Stdlib.Test.equal false
      (0s < 1s) |> Stdlib.Test.equal true
      (1s < 0s) |> Stdlib.Test.equal false
      (-100s < 22544s) |> Stdlib.Test.equal true
      (-999s < -9999s) |> Stdlib.Test.equal false
      (-8888s < -8888s) |> Stdlib.Test.equal false ]

// @compiler blocked: pending-validation
test lessThanOrEqualTo =
  Stdlib.Test.all
    [ (6s <= 8s) |> Stdlib.Test.equal true
      (10s <= 1s) |> Stdlib.Test.equal false
      (0s <= 1s) |> Stdlib.Test.equal true
      (1s <= 0s) |> Stdlib.Test.equal false
      (-100s <= 22544s) |> Stdlib.Test.equal true
      (-999s <= -9999s) |> Stdlib.Test.equal false
      (-8888s <= -8888s) |> Stdlib.Test.equal true ]

// @compiler blocked: pending-validation
test toString =
  Stdlib.Test.all
    [ Stdlib.toString 0s |> Stdlib.Test.equal "0"
      Stdlib.toString 1s |> Stdlib.Test.equal "1"
      Stdlib.toString -1s |> Stdlib.Test.equal "-1"
      // Int16 lower limit
      Stdlib.toString -32768s |> Stdlib.Test.equal "-32768"
      // Int16 upper limit
      Stdlib.toString 32767s |> Stdlib.Test.equal "32767" ]

// @compiler blocked: pending-validation
test toFloat =
  Stdlib.Test.all
    [ Stdlib.Int16.toFloat 2s |> Stdlib.Test.equal 2.0
      Stdlib.Int16.toFloat -10s |> Stdlib.Test.equal -10.0 ]

/// Every result lands inside the bounds, whichever order they are given in.
// @compiler blocked: pending-validation
test randomStaysWithinBounds =
  Stdlib.Test.all
    [ ((Stdlib.List.range 1 5)
       |> Stdlib.List.map (fun x -> Stdlib.Int16.random 1s 2s)
       |> Stdlib.List.map (fun x -> (x >= 1s) && (x <= 2s)))
      |> Stdlib.Test.equal ([ true, true, true, true, true ])
      ((Stdlib.List.range 1 5)
       |> Stdlib.List.map (fun x -> Stdlib.Int16.random 10s 20s)
       |> Stdlib.List.map (fun x -> (x >= 10s) && (x <= 20s)))
      |> Stdlib.Test.equal ([ true, true, true, true, true ])
      ((Stdlib.List.range 1 5)
       |> Stdlib.List.map (fun x -> Stdlib.Int16.random 2s 1s)
       |> Stdlib.List.map (fun x -> (x >= 1s) && (x <= 2s)))
      |> Stdlib.Test.equal ([ true, true, true, true, true ])
      ((Stdlib.List.range 1 5)
       |> Stdlib.List.map (fun x -> Stdlib.Int16.random 20s 10s)
       |> Stdlib.List.map (fun x -> (x >= 10s) && (x <= 20s)))
      |> Stdlib.Test.equal ([ true, true, true, true, true ]) ]

/// Both ends of the range are reachable.
// @compiler blocked: pending-validation
test randomReachesEveryValue =
  Stdlib.Test.all
    [ (((Stdlib.List.range 1 100)
       |> Stdlib.List.map (fun x -> Stdlib.Int16.random 0s 1s)
       |> Stdlib.List.unique))
      |> Stdlib.Test.equal ([ 0s, 1s ])
      (((Stdlib.List.range 1 100)
       |> Stdlib.List.map (fun x -> Stdlib.Int16.random 0s 2s)
       |> Stdlib.List.unique))
      |> Stdlib.Test.equal ([ 0s, 1s, 2s ]) ]

// @compiler blocked: pending-validation
test parse =
  Stdlib.Test.all
    [ Stdlib.Int16.parse "0" |> Stdlib.Test.equal (Ok 0s)
      Stdlib.Int16.parse "1" |> Stdlib.Test.equal (Ok 1s)
      Stdlib.Int16.parse " 1" |> Stdlib.Test.equal (Ok 1s)
      Stdlib.Int16.parse "1 " |> Stdlib.Test.equal (Ok 1s)
      Stdlib.Int16.parse "+1" |> Stdlib.Test.equal (Ok 1s)
      Stdlib.Int16.parse " +1 " |> Stdlib.Test.equal (Ok 1s)
      Stdlib.Int16.parse "-1" |> Stdlib.Test.equal (Ok -1s)
      // "octal" format ignored
      Stdlib.Int16.parse "078" |> Stdlib.Test.equal (Ok 78s)
      Stdlib.Int16.parse "-00001" |> Stdlib.Test.equal (Ok -1s)
      Stdlib.Int16.parse "32767" |> Stdlib.Test.equal (Ok 32767s)
      Stdlib.Int16.parse "-32768" |> Stdlib.Test.equal (Ok -32768s) ]

// @compiler blocked: pending-validation
test parseOutOfRange =
  Stdlib.Test.all
    [ // out of range
      Stdlib.Int16.parse "32768"
      |> Stdlib.Test.equal (Error Stdlib.Int16.ParseError.OutOfRange)
      Stdlib.Int16.parse "-32769"
      |> Stdlib.Test.equal (Error Stdlib.Int16.ParseError.OutOfRange) ]

// @compiler blocked: pending-validation
test parseBadFormat =
  Stdlib.Test.all
    [ Stdlib.Int16.parse "1 2 3"
      |> Stdlib.Test.equal (Error Stdlib.Int16.ParseError.BadFormat)
      Stdlib.Int16.parse "+ 1"
      |> Stdlib.Test.equal (Error Stdlib.Int16.ParseError.BadFormat)
      Stdlib.Int16.parse "- 1"
      |> Stdlib.Test.equal (Error Stdlib.Int16.ParseError.BadFormat)
      Stdlib.Int16.parse "0xA"
      |> Stdlib.Test.equal (Error Stdlib.Int16.ParseError.BadFormat)
      Stdlib.Int16.parse "0x123"
      |> Stdlib.Test.equal (Error Stdlib.Int16.ParseError.BadFormat)
      Stdlib.Int16.parse "0b0100"
      |> Stdlib.Test.equal (Error Stdlib.Int16.ParseError.BadFormat)
      Stdlib.Int16.parse "pi"
      |> Stdlib.Test.equal (Error Stdlib.Int16.ParseError.BadFormat)
      Stdlib.Int16.parse "Darklang.Stdlib.Math.pi"
      |> Stdlib.Test.equal (Error Stdlib.Int16.ParseError.BadFormat)
      Stdlib.Int16.parse "1.23E+04"
      |> Stdlib.Test.equal (Error Stdlib.Int16.ParseError.BadFormat)
      Stdlib.Int16.parse ""
      |> Stdlib.Test.equal (Error Stdlib.Int16.ParseError.BadFormat)
      Stdlib.Int16.parse "1I"
      |> Stdlib.Test.equal (Error Stdlib.Int16.ParseError.BadFormat)
      Stdlib.Int16.parse "one"
      |> Stdlib.Test.equal (Error Stdlib.Int16.ParseError.BadFormat)
      Stdlib.Int16.parse "XIV"
      |> Stdlib.Test.equal (Error Stdlib.Int16.ParseError.BadFormat) ]

