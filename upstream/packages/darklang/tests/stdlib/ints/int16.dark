// @compiler blocked: pending-validation
test bitwiseAnd =
  Stdlib.Test.all
    [ (12s & 10s) |> Stdlib.Test.equal 8s
      (0s & 0s) |> Stdlib.Test.equal 0s
      ((-1s) & 0s) |> Stdlib.Test.equal 0s
      (32767s & 32767s) |> Stdlib.Test.equal 32767s
      ((-32768s) & (-1s)) |> Stdlib.Test.equal -32768s
      (32767s & (-32768s)) |> Stdlib.Test.equal 0s
      ((-1s) & (-1s)) |> Stdlib.Test.equal -1s ]

// @compiler blocked: pending-validation
test bitwiseOr =
  Stdlib.Test.all
    [ (12s | 10s) |> Stdlib.Test.equal 14s
      (0s | 0s) |> Stdlib.Test.equal 0s
      ((-1s) | 0s) |> Stdlib.Test.equal -1s
      (32767s | 0s) |> Stdlib.Test.equal 32767s
      ((-32768s) | 0s) |> Stdlib.Test.equal -32768s
      (32767s | (-32768s)) |> Stdlib.Test.equal -1s ]

// @compiler blocked: pending-validation
test bitwiseXor =
  Stdlib.Test.all
    [ (12s ^ 10s) |> Stdlib.Test.equal 6s
      (0s ^ 0s) |> Stdlib.Test.equal 0s
      ((-1s) ^ (-1s)) |> Stdlib.Test.equal 0s
      (32767s ^ (-1s)) |> Stdlib.Test.equal -32768s
      ((-32768s) ^ (-1s)) |> Stdlib.Test.equal 32767s
      (32767s ^ 32767s) |> Stdlib.Test.equal 0s ]

// @compiler blocked: pending-validation
test bitwiseNot =
  Stdlib.Test.all
    [ (~0s) |> Stdlib.Test.equal -1s
      (~(-1s)) |> Stdlib.Test.equal 0s
      (~32767s) |> Stdlib.Test.equal -32768s
      (~(-32768s)) |> Stdlib.Test.equal 32767s
      (~1s) |> Stdlib.Test.equal -2s ]

// @compiler blocked: pending-validation
test shiftLeft =
  Stdlib.Test.all
    [ (1s << 2s) |> Stdlib.Test.equal 4s
      (0s << 5s) |> Stdlib.Test.equal 0s
      (1s << 0s) |> Stdlib.Test.equal 1s
      (1s << 14s) |> Stdlib.Test.equal 16384s
      (5s << 3s) |> Stdlib.Test.equal 40s ]

// @compiler blocked: pending-validation
test shiftRight =
  Stdlib.Test.all
    [ (8s >> 2s) |> Stdlib.Test.equal 2s
      (0s >> 5s) |> Stdlib.Test.equal 0s
      (1s >> 0s) |> Stdlib.Test.equal 1s
      (16384s >> 14s) |> Stdlib.Test.equal 1s
      ((-1s) >> 1s) |> Stdlib.Test.equal -1s
      (40s >> 3s) |> Stdlib.Test.equal 5s ]
