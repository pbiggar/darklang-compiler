// Helper functions for applying colors
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.colorize reason=compiler-implementation
let colorize (color: String) (text: String) : String =
  $"{color}{text}{reset}"

/// Leave text as it is. For picking a styling function conditionally without a special case.
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.plain reason=compiler-implementation
let plain (text: String) : String = text

// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.boldText reason=compiler-implementation
let boldText (text: String) : String = colorize bold text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.dimText reason=compiler-implementation
let dimText (text: String) : String = colorize dim text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.mutedText reason=compiler-implementation
let mutedText (text: String) : String = colorize muted text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.command reason=compiler-implementation
let command (text: String) : String = colorize commandColor text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.argument reason=compiler-implementation
let argument (text: String) : String = colorize argumentColor text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.keyword reason=compiler-implementation
let keyword (text: String) : String = colorize keywordColor text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.string reason=compiler-implementation
let string (text: String) : String = colorize stringColor text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.number reason=compiler-implementation
let number (text: String) : String = colorize numberColor text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.comment reason=compiler-implementation
let comment (text: String) : String = colorize commentColor text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.error reason=compiler-implementation
let error (text: String) : String = colorize errorColor text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.warning reason=compiler-implementation
let warning (text: String) : String = colorize warningColor text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.success reason=compiler-implementation
let success (text: String) : String = colorize successColor text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.info reason=compiler-implementation
let info (text: String) : String = colorize infoColor text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.hint reason=compiler-implementation
let hint (text: String) : String = colorize hintColor text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.prompt reason=compiler-implementation
let prompt (text: String) : String = colorize promptColor text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.logo reason=compiler-implementation
let logo (text: String) : String = colorize logoColor text
// One-shot colourisers, for the times you want a coloured string rather than a code to compose with.
// These were a second module (`Stdlib.Cli.UI.Color`) with the same names as the codes above, which meant
// `Color.red` and `Colors.red` were different things one letter apart.
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.redText reason=compiler-implementation
let redText (text: String) : String = colorize red text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.greenText reason=compiler-implementation
let greenText (text: String) : String = colorize green text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.yellowText reason=compiler-implementation
let yellowText (text: String) : String = colorize yellow text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.blueText reason=compiler-implementation
let blueText (text: String) : String = colorize blue text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.magentaText reason=compiler-implementation
let magentaText (text: String) : String = colorize magenta text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.cyanText reason=compiler-implementation
let cyanText (text: String) : String = colorize cyan text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.whiteText reason=compiler-implementation
let whiteText (text: String) : String = colorize white text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.grayText reason=compiler-implementation
let grayText (text: String) : String = colorize brightBlack text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.italicText reason=compiler-implementation
let italicText (text: String) : String = colorize italic text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.underlineText reason=compiler-implementation
let underlineText (text: String) : String = colorize underline text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.strikethroughText reason=compiler-implementation
let strikethroughText (text: String) : String = colorize "\u001b[9m" text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.onRed reason=compiler-implementation
let onRed (text: String) : String = colorize bgRed text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.onGreen reason=compiler-implementation
let onGreen (text: String) : String = colorize bgGreen text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.onYellow reason=compiler-implementation
let onYellow (text: String) : String = colorize bgYellow text
// @compiler replace: packages/darklang/stdlib/cli/ui/colors.dark#Darklang.Stdlib.Cli.UI.Colors.onBlue reason=compiler-implementation
let onBlue (text: String) : String = colorize bgBlue text
