/// <type Int64> range).
// @compiler replace: packages/darklang/stdlib/int64.dark#Darklang.Stdlib.Int64.parse reason=compiler-implementation
let parse (s: String) : Stdlib.Result.Result<Int64, Stdlib.Int64.ParseError> =
  Builtin.int64Parse s


