// @compiler blocked: container-adaptation diagnostic="Already selected from packages/darklang/stdlib/uint32.dark; importing another declaration of Darklang.Stdlib.UInt32.impl Power for UInt32 requires an explicit replacement contract"
impl Power for UInt32 =
  /// Raise <param base> to the power of <param exponent>.
  /// Overflow wraps around.
  // @compiler blocked: container-adaptation diagnostic="Containing implementation Darklang.Stdlib.UInt32.impl Power for UInt32: Already selected from packages/darklang/stdlib/uint32.dark; importing another declaration of Darklang.Stdlib.UInt32.impl Power for UInt32 requires an explicit replacement contract"
  let power (``base``: UInt32) (exponent: UInt32) : UInt32 =
    // The signed types push this into the builtin; here the ladder stays, because an
    // unsigned exponent is never negative, so there is no error case to push.
    if ``base`` == 0ul && exponent == 0ul then 1ul
    else if ``base`` == 0ul then 0ul
    else if ``base`` == 1ul then 1ul
    else Builtin.uint32Power ``base`` exponent


