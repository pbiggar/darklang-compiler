module Darklang.Stdlib.Blob

// TODO no Blob literal syntax — embedding small binary data in source
// today requires `Blob.fromHex "..."` or `Blob.fromString "..."`. A
// `b"\x00\x01..."` form would be the natural fix, plus tokenizer +
// parser + runtime literal handling. Cross-cutting language change.


/// The empty Blob.
// @compiler replace: packages/darklang/stdlib/blob.dark#Darklang.Stdlib.Blob.empty reason=compiler-implementation
val empty = Builtin.blobEmpty


/// Returns the length of <param blob> in bytes.
// @compiler replace: packages/darklang/stdlib/blob.dark#Darklang.Stdlib.Blob.length reason=compiler-implementation
let length (blob: Blob) : Int = Builtin.blobLength blob


/// Concatenates a list of Blobs into a single Blob.
// @compiler replace: packages/darklang/stdlib/blob.dark#Darklang.Stdlib.Blob.concat reason=compiler-implementation
let concat (blobs: List<Blob>) : Blob = Builtin.blobConcat blobs


/// Copies <param length> bytes starting at <param start> into a new
/// Blob. Out-of-range slices are clamped.
// @compiler replace: packages/darklang/stdlib/blob.dark#Darklang.Stdlib.Blob.slice reason=compiler-implementation
let slice (blob: Blob) (start: Int) (length: Int) : Blob =
  Builtin.blobSlice blob start length


/// Hex (Base16) encodes <param blob> using an uppercase alphabet.
/// Complies with RFC 4648 section 8.
// @compiler replace: packages/darklang/stdlib/blob.dark#Darklang.Stdlib.Blob.toHex reason=compiler-implementation
let toHex (blob: Blob) : String = Builtin.blobToHex blob


/// Parses <param s> as an uppercase or lowercase hex string into a Blob.
// @compiler replace: packages/darklang/stdlib/blob.dark#Darklang.Stdlib.Blob.fromHex reason=compiler-implementation
let fromHex (s: String) : Stdlib.Result.Result<Blob, String> =
  Builtin.blobFromHex s


/// Base64 encodes <param blob> with standard alphabet + {{=}} padding.
// @compiler replace: packages/darklang/stdlib/blob.dark#Darklang.Stdlib.Blob.toBase64 reason=compiler-implementation
let toBase64 (blob: Blob) : String = Builtin.blobToBase64 blob


/// Parses <param s> as a Base64 string (standard or URL-safe alphabet;
/// padding optional) into a Blob.
// @compiler replace: packages/darklang/stdlib/blob.dark#Darklang.Stdlib.Blob.fromBase64 reason=compiler-implementation
let fromBase64 (s: String) : Stdlib.Result.Result<Blob, String> =
  Builtin.blobFromBase64 s


/// Decodes <param blob> as UTF-8. Returns Error with a message if the
/// bytes aren't valid UTF-8.
// @compiler replace: packages/darklang/stdlib/blob.dark#Darklang.Stdlib.Blob.toString reason=compiler-implementation
let toString (blob: Blob) : Stdlib.Result.Result<String, String> =
  Builtin.blobToString blob


/// Encodes <param s> as UTF-8 bytes in a Blob.
// @compiler replace: packages/darklang/stdlib/blob.dark#Darklang.Stdlib.Blob.fromString reason=compiler-implementation
let fromString (s: String) : Blob = Builtin.blobFromString s


/// Escape hatch: expand a Blob into a List<UInt8>. Prefer the Blob
/// module over this for new code.
// @compiler replace: packages/darklang/stdlib/blob.dark#Darklang.Stdlib.Blob.toList reason=compiler-implementation
let toList (blob: Blob) : List<UInt8> = Builtin.blobToBytes blob


/// Escape hatch: collect a List<UInt8> into a Blob.
// @compiler replace: packages/darklang/stdlib/blob.dark#Darklang.Stdlib.Blob.fromList reason=compiler-implementation
let fromList (bytes: List<UInt8>) : Blob = Builtin.blobFromBytes bytes
