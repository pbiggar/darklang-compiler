/// Startup environment access. The interpreter enforces per-key permissions.
module Darklang.Stdlib.Env

/// Get an environment variable by name, returns None if not set
// @compiler replace: packages/darklang/stdlib/env.dark#Darklang.Stdlib.Env.get reason=compiler-implementation
let get (name: String) : Stdlib.Option.Option<String> =
  Builtin.runtimeEnvironmentGet name

/// Get all environment variables as a dictionary
// @compiler replace: packages/darklang/stdlib/env.dark#Darklang.Stdlib.Env.getAll reason=compiler-implementation
let getAll () : Dict<String, String> =
  Builtin.runtimeEnvironmentGetAll ()
