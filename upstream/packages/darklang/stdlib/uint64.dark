module Darklang.Stdlib.UInt64


// @compiler replace: packages/darklang/stdlib/uint64.dark#Darklang.Stdlib.UInt64.ParseError reason=compiler-implementation
type ParseError =
  | BadFormat
  | OutOfRange


// @compiler blocked: container-adaptation
impl Modulo for UInt64 =
  /// Returns the result of wrapping <param a> around so that {{0 <= res < b}}.
  /// The modulus <param b> must be greater than 0
  // @compiler blocked: container-adaptation
  let modulo (a: UInt64) (b: UInt64) : UInt64 = Builtin.uint64Mod a b


// @compiler blocked: container-adaptation
impl Add for UInt64 =
  /// Adds 64-bit unsigned integers together (wraps on overflow)
  // @compiler blocked: container-adaptation
  let add (a: UInt64) (b: UInt64) : UInt64 = Builtin.uint64Add a b


// @compiler blocked: container-adaptation
impl Subtract for UInt64 =
  /// Subtracts 64-bit unsigned integers (wraps on overflow)
  // @compiler blocked: container-adaptation
  let subtract (a: UInt64) (b: UInt64) : UInt64 = Builtin.uint64Subtract a b


// @compiler blocked: container-adaptation
impl Multiply for UInt64 =
  /// Multiplies 64-bit unsigned integers (wraps on overflow)
  // @compiler blocked: container-adaptation
  let multiply (a: UInt64) (b: UInt64) : UInt64 = Builtin.uint64Multiply a b


// @compiler blocked: container-adaptation
impl Divide for UInt64 =
  /// Divides 64-bit unsigned integers
  // @compiler blocked: container-adaptation
  let divide (a: UInt64) (b: UInt64) : UInt64 = Builtin.uint64Divide a b


// @compiler blocked: container-adaptation
impl Power for UInt64 =
  /// Raise <param base> to the power of <param exponent>.
  /// Overflow wraps around.
  // @compiler blocked: container-adaptation
  let power (``base``: UInt64) (exponent: UInt64) : UInt64 =
    // The signed types push this into the builtin; here the ladder stays, because an
    // unsigned exponent is never negative, so there is no error case to push.
    if ``base`` == 0UL && exponent == 0UL then 1UL
    else if ``base`` == 0UL then 0UL
    else if ``base`` == 1UL then 1UL
    else Builtin.uint64Power ``base`` exponent


// @compiler blocked: container-adaptation
impl Compare for UInt64 =
  /// Returns {{true}} if <param a> is less than <param b>
  // @compiler blocked: container-adaptation
  let lessThan (a: UInt64) (b: UInt64) : Bool = Builtin.uint64LessThan a b
  /// Returns {{true}} if <param a> is less than or equal to <param b>
  // @compiler blocked: container-adaptation
  let lessThanOrEqualTo (a: UInt64) (b: UInt64) : Bool =
    Builtin.uint64LessThanOrEqualTo a b
  /// Returns {{true}} if <param a> is greater than <param b>
  // @compiler blocked: container-adaptation
  let greaterThan (a: UInt64) (b: UInt64) : Bool = Builtin.uint64GreaterThan a b
  /// Returns {{true}} if <param a> is greater than or equal to <param b>
  // @compiler blocked: container-adaptation
  let greaterThanOrEqualTo (a: UInt64) (b: UInt64) : Bool =
    Builtin.uint64GreaterThanOrEqualTo a b


/// Returns a random integer between <param start> and <param end> (inclusive)
// @compiler replace: packages/darklang/stdlib/uint64.dark#Darklang.Stdlib.UInt64.random reason=compiler-implementation
let random (start: UInt64) (``end``: UInt64) : UInt64 =
  Builtin.uint64Random start ``end``


/// Get the square root of an <type UInt64>
// @compiler replace: packages/darklang/stdlib/uint64.dark#Darklang.Stdlib.UInt64.sqrt reason=compiler-implementation
let sqrt (a: UInt64) : Float = Builtin.uint64Sqrt a


/// Converts an <type UInt64> to a <type Float>
// @compiler replace: packages/darklang/stdlib/uint64.dark#Darklang.Stdlib.UInt64.toFloat reason=compiler-implementation
let toFloat (a: UInt64) : Float = Builtin.uint64ToFloat a

/// Converts a <type Float> to an <type UInt64>, truncating toward zero like
/// <fn Int.fromFloat>. Returns {{None}} for NaN, infinity, or a result that
/// doesn't fit.
// @compiler replace: packages/darklang/stdlib/uint64.dark#Darklang.Stdlib.UInt64.fromFloat reason=compiler-implementation
let fromFloat (a: Float) : Stdlib.Option.Option<UInt64> =
  if Float.isFinite a then
    a |> Stdlib.Int.fromFloat |> Stdlib.Int.toUInt64
  else
    Stdlib.Option.Option.None


/// Converts a <type Float> to an <type UInt64>, rounding to the nearest integer
/// (ties to even). Returns {{None}} for NaN, infinity, or a result that
/// doesn't fit.
// @compiler replace: packages/darklang/stdlib/uint64.dark#Darklang.Stdlib.UInt64.fromFloatRounded reason=compiler-implementation
let fromFloatRounded (a: Float) : Stdlib.Option.Option<UInt64> =
  if Float.isFinite a then
    a |> Float.round |> Stdlib.Int.toUInt64
  else
    Stdlib.Option.Option.None


/// Parses a <type String> into a <type UInt64>, returning {{Ok}} with the
/// parsed value on success, or {{Error}} with a <type ParseError> ({{BadFormat}}
/// if the string isn't a valid integer, {{OutOfRange}} if it's outside the
/// <type UInt64> range).
// @compiler replace: packages/darklang/stdlib/uint64.dark#Darklang.Stdlib.UInt64.parse reason=compiler-implementation
let parse
  (s: String)
  : Stdlib.Result.Result<UInt64, Stdlib.UInt64.ParseError> =
  Builtin.uint64Parse s


