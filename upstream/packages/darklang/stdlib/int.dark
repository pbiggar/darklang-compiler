module Darklang.Stdlib.Int

// `Int` is the default, arbitrary-precision integer (a bare literal like `1`).
// The operators (`+`, `-`, `<`, ...) work on it; this
// module provides the same operations as named functions, plus parse/stringify
// and conversions to/from the fixed-width integer types.
//
// Note: because this file is parsed by the F# host parser, every `Int` literal
// below needs the `I` suffix (a bare `1` would be an `Int32` here).

// @compiler replace: packages/darklang/stdlib/int.dark#Darklang.Stdlib.Int.ParseError reason=compiler-implementation
type ParseError = | BadFormat


// @compiler blocked: container-adaptation
impl Modulo for Int =
  /// Returns the result of wrapping <param a> around so that {{0 <= res < b}}.
  /// The modulus <param b> must be greater than 0.
  /// Use <fn Int.remainder> if you want the remainder after division, which has
  /// a different behavior for negative numbers.
  // @compiler blocked: container-adaptation
  let modulo (a: Int) (b: Int) : Int = Builtin.intMod a b


/// Returns the integer remainder left over after dividing <param value> by
/// <param divisor>, as a <type Result>.
/// For example, {{Int.remainder 15 6 == Ok 3}}. The remainder will be
/// negative only if {{<var value> < 0}}.
/// The sign of <param divisor> doesn't influence the outcome.
/// Returns an {{Error}} if <param divisor> is {{0}}.
// @compiler replace: packages/darklang/stdlib/int.dark#Darklang.Stdlib.Int.remainder reason=compiler-implementation
let remainder (value: Int) (divisor: Int) : Stdlib.Result.Result<Int, String> =
  Builtin.intRemainder value divisor


// @compiler blocked: container-adaptation
impl Add for Int =
  /// Adds two integers together
  // @compiler blocked: container-adaptation
  let add (a: Int) (b: Int) : Int = Builtin.intAdd a b


// @compiler blocked: container-adaptation
impl Subtract for Int =
  /// Subtracts two integers
  // @compiler blocked: container-adaptation
  let subtract (a: Int) (b: Int) : Int = Builtin.intSubtract a b


// @compiler blocked: container-adaptation
impl Multiply for Int =
  /// Multiplies two integers
  // @compiler blocked: container-adaptation
  let multiply (a: Int) (b: Int) : Int = Builtin.intMultiply a b


// @compiler blocked: container-adaptation
impl Divide for Int =
  /// Divides two integers, rounding towards zero
  // @compiler blocked: container-adaptation
  let divide (a: Int) (b: Int) : Int = Builtin.intDivide a b


// @compiler blocked: container-adaptation
impl Power for Int =
  /// Raise <param base> to the power of <param exponent>.
  /// Raises an error if <param exponent> is negative.
  // @compiler blocked: container-adaptation
  let power (``base``: Int) (exponent: Int) : Int =
    Builtin.intPower ``base`` exponent


// @compiler blocked: container-adaptation
impl Negate for Int =
  /// Returns the negation of <param a>, {{-a}}
  // @compiler blocked: container-adaptation
  let negate (a: Int) : Int = Builtin.intNegate a


// @compiler blocked: container-adaptation
impl Compare for Int =
  /// Returns {{true}} if <param a> is less than <param b>
  // @compiler blocked: container-adaptation
  let lessThan (a: Int) (b: Int) : Bool = Builtin.intLessThan a b
  /// Returns {{true}} if <param a> is less than or equal to <param b>
  // @compiler blocked: container-adaptation
  let lessThanOrEqualTo (a: Int) (b: Int) : Bool = Builtin.intLessThanOrEqualTo a b
  /// Returns {{true}} if <param a> is greater than <param b>
  // @compiler blocked: container-adaptation
  let greaterThan (a: Int) (b: Int) : Bool = Builtin.intGreaterThan a b
  /// Returns {{true}} if <param a> is greater than or equal to <param b>
  // @compiler blocked: container-adaptation
  let greaterThanOrEqualTo (a: Int) (b: Int) : Bool =
    Builtin.intGreaterThanOrEqualTo a b


/// Get the square root of an <type Int>
// @compiler replace: packages/darklang/stdlib/int.dark#Darklang.Stdlib.Int.sqrt reason=compiler-implementation
let sqrt (a: Int) : Float = Builtin.intSqrt a


/// Converts an <type Int> to a <type Float>
// @compiler replace: packages/darklang/stdlib/int.dark#Darklang.Stdlib.Int.toFloat reason=compiler-implementation
let toFloat (a: Int) : Float = Builtin.intToFloat a


/// Converts a <type Float> to an <type Int>, truncating toward zero.
// @compiler replace: packages/darklang/stdlib/int.dark#Darklang.Stdlib.Int.fromFloat reason=compiler-implementation
let fromFloat (a: Float) : Int = Builtin.intFromFloat a


/// Returns the <type Int> value of a <type String>. Because <type Int> is
/// arbitrary-precision, the only failure is a badly-formatted string.
// @compiler replace: packages/darklang/stdlib/int.dark#Darklang.Stdlib.Int.parse reason=compiler-implementation
let parse (s: String) : Stdlib.Result.Result<Int, ParseError> =
  Builtin.intParse s


