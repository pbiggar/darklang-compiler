module Darklang.Stdlib.Int128


// @compiler replace: packages/darklang/stdlib/int128.dark#Darklang.Stdlib.Int128.ParseError reason=compiler-implementation
type ParseError =
  | BadFormat
  | OutOfRange


// @compiler blocked: container-adaptation
impl Modulo for Int128 =
  /// Returns the result of wrapping <param a> around so that {{0 <= res < b}}.
  /// The modulus <param b> must be greater than 0.
  /// Use <fn Int128.remainder> if you want the remainder after division, which has
  /// a different behavior for negative numbers.
  // @compiler blocked: container-adaptation
  let modulo (a: Int128) (b: Int128) : Int128 = Builtin.int128Mod a b


/// Returns the integer remainder left over after dividing <param value> by
/// <param divisor>, as a <type Result>.
/// For example, {{Int128.remainder 15 6 == Ok 3}}. The remainder will be
/// negative only if {{<var value> < 0}}.
/// The sign of <param divisor> doesn't influence the outcome.
/// Returns an {{Error}} if <param divisor> is {{0}}.
// @compiler replace: packages/darklang/stdlib/int128.dark#Darklang.Stdlib.Int128.remainder reason=compiler-implementation
let remainder
  (value: Int128)
  (divisor: Int128)
  : Stdlib.Result.Result<Int128, String> =
  Builtin.int128Remainder value divisor


// @compiler blocked: container-adaptation
impl Add for Int128 =
  /// Adds two 128-bit signed integers together (wraps on overflow)
  // @compiler blocked: container-adaptation
  let add (a: Int128) (b: Int128) : Int128 = Builtin.int128Add a b


// @compiler blocked: container-adaptation
impl Subtract for Int128 =
  /// Subtracts two 128-bit signed integers (wraps on overflow)
