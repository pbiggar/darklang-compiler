module Darklang.Stdlib.UInt8


// @compiler replace: packages/darklang/stdlib/uint8.dark#Darklang.Stdlib.UInt8.ParseError reason=compiler-implementation
type ParseError =
  | BadFormat
  | OutOfRange


// @compiler blocked: container-adaptation
impl Modulo for UInt8 =
  /// Returns the result of wrapping <param a> around so that {{0 <= res < b}}.
  /// The modulus <param b> must be greater than 0.
  /// Use <fn UInt8.remainder> if you want the remainder after division, which has
  /// a different behavior for negative numbers.
  // @compiler blocked: container-adaptation
  let modulo (a: UInt8) (b: UInt8) : UInt8 = Builtin.uint8Mod a b


// @compiler blocked: container-adaptation
impl Add for UInt8 =
  /// Adds two 8-bit unsigned integers together (wraps on overflow)
  // @compiler blocked: container-adaptation
  let add (a: UInt8) (b: UInt8) : UInt8 = Builtin.uint8Add a b


// @compiler blocked: container-adaptation
impl Subtract for UInt8 =
  /// Subtracts two 8-bit unsigned  integers (wraps on overflow)
  // @compiler blocked: container-adaptation
  let subtract (a: UInt8) (b: UInt8) : UInt8 = Builtin.uint8Subtract a b


// @compiler blocked: container-adaptation
impl Multiply for UInt8 =
  /// Multiplies two 8-bit unsigned  integers (wraps on overflow)
  // @compiler blocked: container-adaptation
  let multiply (a: UInt8) (b: UInt8) : UInt8 = Builtin.uint8Multiply a b


// @compiler blocked: container-adaptation
impl Power for UInt8 =
  /// Raise <param base> to the power of <param exponent>.
  /// Overflow wraps around.
  // @compiler blocked: container-adaptation
  let power (``base``: UInt8) (exponent: UInt8) : UInt8 =
    // The signed types push this into the builtin; here the ladder stays, because an
    // unsigned exponent is never negative, so there is no error case to push.
    if ``base`` == 0uy && exponent == 0uy then 1uy
    else if ``base`` == 0uy then 0uy
    else if ``base`` == 1uy then 1uy
    else Builtin.uint8Power ``base`` exponent


// @compiler blocked: container-adaptation
impl Divide for UInt8 =
  /// Divides two 8-bit unsigned  integers
  // @compiler blocked: container-adaptation
  let divide (a: UInt8) (b: UInt8) : UInt8 = Builtin.uint8Divide a b


// @compiler blocked: container-adaptation
impl Compare for UInt8 =
  /// Returns {{true}} if <param a> is less than <param b>
  // @compiler blocked: container-adaptation
  let lessThan (a: UInt8) (b: UInt8) : Bool = Builtin.uint8LessThan a b
  /// Returns {{true}} if <param a> is less than or equal to <param b>
  // @compiler blocked: container-adaptation
  let lessThanOrEqualTo (a: UInt8) (b: UInt8) : Bool =
    Builtin.uint8LessThanOrEqualTo a b
  /// Returns {{true}} if <param a> is greater than <param b>
  // @compiler blocked: container-adaptation
  let greaterThan (a: UInt8) (b: UInt8) : Bool = Builtin.uint8GreaterThan a b
  /// Returns {{true}} if <param a> is greater than or equal to <param b>
  // @compiler blocked: container-adaptation
  let greaterThanOrEqualTo (a: UInt8) (b: UInt8) : Bool =
    Builtin.uint8GreaterThanOrEqualTo a b


/// Returns a random 8 bit unsigned integer between <param start> and <param end> (inclusive)
// @compiler replace: packages/darklang/stdlib/uint8.dark#Darklang.Stdlib.UInt8.random reason=compiler-implementation
let random (start: UInt8) (``end``: UInt8) : UInt8 =
  Builtin.uint8Random start ``end``


/// Get the square root of an <type UInt8>
// @compiler replace: packages/darklang/stdlib/uint8.dark#Darklang.Stdlib.UInt8.sqrt reason=compiler-implementation
let sqrt (a: UInt8) : Float = Builtin.uint8Sqrt a


/// Converts a <type UInt8> to a <type Float>
// @compiler replace: packages/darklang/stdlib/uint8.dark#Darklang.Stdlib.UInt8.toFloat reason=compiler-implementation
let toFloat (a: UInt8) : Float = Builtin.uint8ToFloat a


/// Parses a <type String> into a <type UInt8>, returning {{Ok}} with the
/// parsed value on success, or {{Error}} with a <type ParseError> ({{BadFormat}}
/// if the string isn't a valid integer, {{OutOfRange}} if it's outside the
/// <type UInt8> range).
// @compiler replace: packages/darklang/stdlib/uint8.dark#Darklang.Stdlib.UInt8.parse reason=compiler-implementation
let parse (s: String) : Stdlib.Result.Result<UInt8, Stdlib.UInt8.ParseError> =
  Builtin.uint8Parse s


