module Darklang.Stdlib.UInt16


// @compiler replace: packages/darklang/stdlib/uint16.dark#Darklang.Stdlib.UInt16.ParseError reason=compiler-implementation
type ParseError =
  | BadFormat
  | OutOfRange


// @compiler blocked: container-adaptation
impl Modulo for UInt16 =
  /// Returns the result of wrapping <param a> around so that {{0 <= res < b}}.
  /// The modulus <param b> must be greater than 0.
  /// Use <fn UInt16.remainder> if you want the remainder after division, which has
  /// a different behavior for negative numbers.
  // @compiler blocked: container-adaptation
  let modulo (a: UInt16) (b: UInt16) : UInt16 = Builtin.uint16Mod a b


// @compiler blocked: container-adaptation
impl Add for UInt16 =
  /// Adds two 16-bit unsigned integers together (wraps on overflow)
  // @compiler blocked: container-adaptation
  let add (a: UInt16) (b: UInt16) : UInt16 = Builtin.uint16Add a b


// @compiler blocked: container-adaptation
impl Subtract for UInt16 =
  /// Subtracts two 16-bit unsigned  integers (wraps on overflow)
  // @compiler blocked: container-adaptation
  let subtract (a: UInt16) (b: UInt16) : UInt16 = Builtin.uint16Subtract a b


// @compiler blocked: container-adaptation
impl Multiply for UInt16 =
  /// Multiplies two 16-bit unsigned  integers (wraps on overflow)
  // @compiler blocked: container-adaptation
  let multiply (a: UInt16) (b: UInt16) : UInt16 = Builtin.uint16Multiply a b


// @compiler blocked: container-adaptation
impl Power for UInt16 =
  /// Raise <param base> to the power of <param exponent>.
  /// Overflow wraps around.
  // @compiler blocked: container-adaptation
  let power (``base``: UInt16) (exponent: UInt16) : UInt16 =
    // The signed types push this into the builtin; here the ladder stays, because an
    // unsigned exponent is never negative, so there is no error case to push.
    if ``base`` == 0us && exponent == 0us then 1us
    else if ``base`` == 0us then 0us
    else if ``base`` == 1us then 1us
    else Builtin.uint16Power ``base`` exponent


// @compiler blocked: container-adaptation
impl Divide for UInt16 =
  /// Divides two 16-bit unsigned integers
  // @compiler blocked: container-adaptation
  let divide (a: UInt16) (b: UInt16) : UInt16 = Builtin.uint16Divide a b


// @compiler blocked: container-adaptation
impl Compare for UInt16 =
  /// Returns {{true}} if <param a> is less than <param b>
  // @compiler blocked: container-adaptation
  let lessThan (a: UInt16) (b: UInt16) : Bool = Builtin.uint16LessThan a b
  /// Returns {{true}} if <param a> is less than or equal to <param b>
  // @compiler blocked: container-adaptation
  let lessThanOrEqualTo (a: UInt16) (b: UInt16) : Bool =
    Builtin.uint16LessThanOrEqualTo a b
  /// Returns {{true}} if <param a> is greater than <param b>
  // @compiler blocked: container-adaptation
  let greaterThan (a: UInt16) (b: UInt16) : Bool = Builtin.uint16GreaterThan a b
  /// Returns {{true}} if <param a> is greater than or equal to <param b>
  // @compiler blocked: container-adaptation
  let greaterThanOrEqualTo (a: UInt16) (b: UInt16) : Bool =
    Builtin.uint16GreaterThanOrEqualTo a b


/// Returns a random 16-bit unsigned integer between <param start> and <param end> (inclusive)
// @compiler replace: packages/darklang/stdlib/uint16.dark#Darklang.Stdlib.UInt16.random reason=compiler-implementation
let random (start: UInt16) (``end``: UInt16) : UInt16 =
  Builtin.uint16Random start ``end``


/// Get the square root of an <type UInt16>
// @compiler replace: packages/darklang/stdlib/uint16.dark#Darklang.Stdlib.UInt16.sqrt reason=compiler-implementation
let sqrt (a: UInt16) : Float = Builtin.uint16Sqrt a


/// Converts an <type UInt16> to a <type Float>
// @compiler replace: packages/darklang/stdlib/uint16.dark#Darklang.Stdlib.UInt16.toFloat reason=compiler-implementation
let toFloat (a: UInt16) : Float = Builtin.uint16ToFloat a


/// Parses a <type String> into a <type UInt16>, returning {{Ok}} with the
/// parsed value on success, or {{Error}} with a <type ParseError> ({{BadFormat}}
/// if the string isn't a valid integer, {{OutOfRange}} if it's outside the
/// <type UInt16> range).
// @compiler replace: packages/darklang/stdlib/uint16.dark#Darklang.Stdlib.UInt16.parse reason=compiler-implementation
let parse
  (s: String)
  : Stdlib.Result.Result<UInt16, Stdlib.UInt16.ParseError> =
  Builtin.uint16Parse s


