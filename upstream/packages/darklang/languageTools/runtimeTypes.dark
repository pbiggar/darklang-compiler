module Darklang.LanguageTools.RuntimeTypes


// <aliases>
type Option<'a> = Stdlib.Option.Option<'a>
// </aliases>

// @compiler replace: packages/darklang/languageTools/runtimeTypes.dark#Darklang.LanguageTools.RuntimeTypes.Hash reason=compiler-implementation
type Hash = | Hash of String

// @compiler replace: packages/darklang/languageTools/runtimeTypes.dark#Darklang.LanguageTools.RuntimeTypes.hashToString reason=compiler-implementation
let hashToString (hash: Hash) : String =
  match hash with
  | Hash h -> h

module FQTypeName =
  type Package = Hash
  // @compiler blocked: compiler-contract
  type FQTypeName = Package of Package

module FQTraitName =
  type Package = Hash
  type FQTraitName = Package of Package

module FQValueName =
  // @compiler replace: packages/darklang/languageTools/runtimeTypes/fqValueName.dark#Darklang.LanguageTools.RuntimeTypes.FQValueName.Builtin reason=compiler-implementation
  type Builtin = { name: String, version: Int32 }
  type Package = Hash

  // @compiler blocked: compiler-contract
  type FQValueName =
    | Builtin of Builtin
    | Package of Package

module FQFnName =
  // @compiler replace: packages/darklang/languageTools/runtimeTypes/fqFnName.dark#Darklang.LanguageTools.RuntimeTypes.FQFnName.Builtin reason=compiler-implementation
  type Builtin = { name: String, version: Int32 }
  type Package = Hash

  /// How much of a trait call's implementation is decided; the runtime's half of
  /// `ProgramTypes.FQFnName.ImplChoice`.
  type ImplChoice =
    /// That fn runs
    | Chosen of Package
    /// Read from the frame the caller filled, rather than asked of the store
    | FromTypeParam of String
    /// Resolve at the call; the only path that asks the store
    | Unknown

  /// A trait method call: the trait, the method name (`ToString.toString`), and how
  /// much the save could say about which implementation runs.
  type TraitMethod =
    { trait_: FQTraitName.Package
      method_: String
      implFn: ImplChoice }

  // @compiler blocked: compiler-contract
  type FQFnName =
    | Builtin of Builtin
    | Package of Package
    | TraitMethod of TraitMethod

// @compiler replace: packages/darklang/languageTools/runtimeTypes/base.dark#Darklang.LanguageTools.RuntimeTypes.NameResolutionError reason=compiler-implementation
type NameResolutionError =
  | NotFound
  | InvalidName

// @compiler replace: packages/darklang/languageTools/runtimeTypes/base.dark#Darklang.LanguageTools.RuntimeTypes.NameResolution reason=compiler-implementation
type NameResolution<'a> =
  { originalName: List<String>
    resolved: Stdlib.Result.Result<'a, NameResolutionError> }


// @compiler blocked: compiler-contract
type TypeReference =
  | TUnit
  | TBool
  | TInt8
  | TUInt8
  | TInt16
  | TUInt16
  | TInt32
  | TUInt32
  | TInt64
  | TUInt64
  | TInt128
  | TUInt128
  | TInt
  | TFloat
  | TChar
  | TString
  | TUuid
  | TDateTime
  | TBlob
  | TStream of TypeReference
  | TTuple of TypeReference * TypeReference * List<TypeReference>
  | TList of TypeReference
  | TDict of key: TypeReference * value: TypeReference
  | TCustomType of
    NameResolution<FQTypeName.FQTypeName> *
    typeArgs: List<TypeReference>
  | TFn of List<TypeReference> * TypeReference
  | TVariable of String

type TypeSymbolTable = Dict<String, TypeReference>


// @compiler blocked: compiler-contract
type KnownType =
  | KTUnit
  | KTBool
  | KTInt8
  | KTUInt8
  | KTInt16
  | KTUInt16
  | KTInt32
  | KTUInt32
  | KTInt64
  | KTUInt64
  | KTInt128
  | KTUInt128
  | KTInt
  | KTFloat
  | KTChar
  | KTString
  | KTUuid
  | KTDateTime
  | KTBlob
  | KTStream of ValueType
  | KTTuple of ValueType * ValueType * List<ValueType>
  | KTList of ValueType
  | KTDict of key: ValueType * value: ValueType

  | KTFn of List<ValueType> * ValueType

  | KTCustomType of FQTypeName.FQTypeName * typeArgs: List<ValueType>


// @compiler replace: packages/darklang/languageTools/runtimeTypes/valueType.dark#Darklang.LanguageTools.RuntimeTypes.ValueType reason=compiler-implementation
type ValueType =
  | Unknown
  | Known of KnownType


// @compiler blocked: compiler-contract
type LetPattern =
  | LPVariable of reg: Register
  | LPWildcard
  | LPUnit
  | LPTuple of
    first: LetPattern *
    second: LetPattern *
    theRest: List<LetPattern>

// @compiler blocked: constructor-identity diagnostic="Constructor identity collision 1941: Darklang.Language.Tests.Equality.EEnumInt8.E3, Darklang.LanguageTools.RuntimeTypes.MatchPattern.MPInt16"
type MatchPattern =
  | MPUnit
  | MPBool of Bool
  | MPInt8 of Int8
  | MPUInt8 of UInt8
  | MPInt16 of Int16
  | MPUInt16 of UInt16
  | MPInt32 of Int32
  | MPUInt32 of UInt32
  | MPInt64 of Int64
  | MPUInt64 of UInt64
  | MPInt128 of Int128
  | MPUInt128 of UInt128
  | MPInt of Int
  | MPFloat of Float
  | MPChar of String
  | MPString of String
  | MPTuple of MatchPattern * MatchPattern * List<MatchPattern>
  | MPList of List<MatchPattern>
  | MPListCons of head: MatchPattern * tail: MatchPattern
  | MPEnum of caseName: String * fieldPatterns: List<MatchPattern>
  | MPVariable of Register
  | MPOr of List<MatchPattern>

type Register = Int32

type DvalMap = Dict<String, Dval>

type DictMap = Dict<Dval, Dval>

type StringSegment =
  | Text of String
  | Interpolated of Register


/// The register-machine instruction set the interpreter actually runs.
///
/// Mirrors `LibExecution.RuntimeTypes.Instruction`. Dark code compiles to this, so it's what a
/// disassembly view shows; see `PrettyPrinter.RuntimeTypes.instructions`.
///
/// Jump offsets are relative to the jumping instruction, so a listing has to add the index back to make
/// them readable.
// @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.RuntimeTypes.Instruction: Unknown type 'MatchPattern'"
type Instruction =
  | LoadVal of loadTo: Register * value: Dval
  | CopyVal of copyTo: Register * copyFrom: Register
  | Or of createTo: Register * lhs: Register * rhs: Register
  | And of createTo: Register * lhs: Register * rhs: Register
  | CreateString of createTo: Register * segments: List<StringSegment>
  | CheckLetPatternAndExtractVars of valueReg: Register * pat: LetPattern
  | JumpByIfFalse of instrsToJump: Int32 * conditionReg: Register
  | JumpBy of instrsToJump: Int32
  | Unwrap of
    extractTo: Register *
    valueReg: Register *
    returns: Stdlib.Option.Option<FQTypeName.FQTypeName>
  | CheckMatchPatternAndExtractVars of
    valueReg: Register *
    pat: MatchPattern *
    failJump: Int32
  | MatchUnmatched of valueReg: Register
  | CreateTuple of
    createTo: Register *
    first: Register *
    second: Register *
    theRest: List<Register>
  | CreateList of createTo: Register * itemsToAdd: List<Register>
  | CreateDict of createTo: Register * entries: List<(Register * Register)>
  | CreateRecord of
    createTo: Register *
    typeName: FQTypeName.FQTypeName *
    typeArgs: List<TypeReference> *
    fields: List<(String * Register)>
  | CloneRecordWithUpdates of
    createTo: Register *
    originalRecordReg: Register *
    updates: List<(String * Register)>
  | GetRecordField of
    targetReg: Register *
    recordReg: Register *
    fieldName: String
  | CreateEnum of
    createTo: Register *
    typeName: FQTypeName.FQTypeName *
    typeArgs: List<TypeReference> *
    caseName: String *
    fields: List<Register>
  | LoadValue of createTo: Register * value: FQValueName.FQValueName
  | CreateLambda of createTo: Register * lambda: LambdaImpl
  | Apply of
    createTo: Register *
    thingToApply: Register *
    typeArgs: List<TypeReference> *
    args: List<Register>
  | RaiseNRE of names: List<String> * error: NameResolutionError
  | VarNotFound of targetRegIfDB: Register * name: String
  | CheckIfFirstExprIsUnit of reg: Register
  /// The value in `valueReg` is the result of the source expression `exprId`, for live values.
  | TraceExpr of exprId: UInt64 * valueReg: Register


// @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.RuntimeTypes.Instructions: Unknown type 'Instruction'"
type Instructions =
  { registerCount: Int32
    instructions: List<Instruction>
    resultIn: Register }


// @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.RuntimeTypes.LambdaImpl: Unknown type 'Instructions'"
type LambdaImpl =
  { exprId: UInt64
    patterns: List<LetPattern>
    registersToCloseOver: List<(Register * Register)>
    selfRegister: Option<Register>
    instructions: Instructions }

// @compiler replace: packages/darklang/languageTools/runtimeTypes/dval.dark#Darklang.LanguageTools.RuntimeTypes.ApplicableNamedFn reason=compiler-implementation
type ApplicableNamedFn =
  { name: FQFnName.FQFnName
    typeArgs: List<TypeReference>
    argsSoFar: List<Dval> }

// @compiler blocked: compiler-contract
type ApplicableLambda =
  { exprId: UInt64
    closedRegisters: List<(Register * Dval)>
    typeSymbolTable: TypeSymbolTable
    argsSoFar: List<Dval> }

// @compiler replace: packages/darklang/languageTools/runtimeTypes/dval.dark#Darklang.LanguageTools.RuntimeTypes.Applicable reason=compiler-implementation
type Applicable =
  | AppLambda of ApplicableLambda
  | AppNamedFn of ApplicableNamedFn


/// One impl of a trait as dispatch sees it: what it is for, and the fn behind each method
type ImplCandidate =
  { trait_: FQTraitName.Package
    self: TypeReference
    methods: Dict<String, Hash>
    source: Hash
    /// When the op that added this implementation was written. Two implementations of
    /// one trait for one type are ordered by it: the newer one runs. Empty for an
    /// implementation that never came from an op, and then neither one wins.
    stamp: String }

// @compiler blocked: compiler-contract
type Dval =
  | DUnit
  | DBool of Bool
  | DInt8 of Int8
  | DUInt8 of UInt8
  | DInt16 of Int16
  | DUInt16 of UInt16
  | DInt32 of Int32
  | DUInt32 of UInt32
  | DInt64 of Int64
  | DUInt64 of UInt64
  | DInt128 of Int128
  | DUInt128 of UInt128
  | DInt of Int
  | DFloat of Float
  | DChar of Char
  | DString of String
  | DDateTime of DateTime
  | DUuid of Uuid

  | DTuple of Dval * Dval * List<Dval>
  | DList of ValueType * List<Dval>
  | DDict of keyType: ValueType * valueType: ValueType * entries: DictMap

  | DRecord of
    runtimeTypeName: FQTypeName.FQTypeName *
    sourceTypeName: FQTypeName.FQTypeName *
    typeArgs: List<ValueType> *
    fields: DvalMap

  | DEnum of
    runtimeTypeName: FQTypeName.FQTypeName *
    sourceTypeName: FQTypeName.FQTypeName *
    typeArgs: List<ValueType> *
    caseName: String *
    fields: List<Dval>

  | DApplicable of Applicable

  // References

  | DBlobPersistent of hash: String * length: Int
  | DBlobEphemeral of id: Uuid

  | DStreamStub of elemType: ValueType

type BuiltInParam =
  { name: String
    typ: TypeReference
    blockArgs: List<String>
    description: String }


/// Convert a value into a Dval that Dark code can inspect.
/// For records and enums, the result includes the package type's hash.
// @compiler excluded: runtime-reflection
let reflect (value: 'a) : Dval = Builtin.reflect value
